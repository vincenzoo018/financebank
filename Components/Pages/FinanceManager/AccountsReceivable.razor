                    </div>

                    @if (reviewStep == 1)
                    {
                        <!-- Step 1: Verify Payment Details -->
                        <div
                            style="background: linear-gradient(135deg, #fdf4ff, #f5d0fe); padding: 24px; border-radius: 16px; border: 1px solid #e879f9; margin-bottom: 24px;">
                            <h5 style="margin: 0 0 16px 0; color: #7c3aed; font-size: 16px; font-weight: 700;">📋 Step 1: Verify
                                Payment Details</h5>

                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                                <div style="background: white; padding: 16px; border-radius: 10px;">
                                    <span
                                        style="font-size: 12px; color: #6b7280; text-transform: uppercase; font-weight: 600;">Customer
                                        Name</span>
                                    <p style="margin: 4px 0 0 0; font-weight: 700; color: #1e293b; font-size: 16px;">
                                        @selectedPaymentForReview.CustomerName</p>
                                </div>
                                <div style="background: white; padding: 16px; border-radius: 10px;">
                                    <span
                                        style="font-size: 12px; color: #6b7280; text-transform: uppercase; font-weight: 600;">Invoice
                                        Number</span>
                                    <p style="margin: 4px 0 0 0; font-weight: 700; color: #1e293b; font-size: 16px;">
                                        @selectedPaymentForReview.InvoiceNumber</p>
                                </div>
                                <div style="background: white; padding: 16px; border-radius: 10px;">
                                    <span
                                        style="font-size: 12px; color: #6b7280; text-transform: uppercase; font-weight: 600;">Payment
                                        Amount</span>
                                    <p style="margin: 4px 0 0 0; font-weight: 700; color: #059669; font-size: 20px;">
                                        ₱@selectedPaymentForReview.Amount.ToString("N2")</p>
                                </div>
                                <div style="background: white; padding: 16px; border-radius: 10px;">
                                    <span
                                        style="font-size: 12px; color: #6b7280; text-transform: uppercase; font-weight: 600;">Due
                                        Date</span>
                                    <p style="margin: 4px 0 0 0; font-weight: 600; color: #1e293b; font-size: 15px;">
                                        @selectedPaymentForReview.DueDate.ToString("MMM dd, yyyy")</p>
                                </div>
                            </div>

                            <div style="background: white; padding: 16px; border-radius: 10px; margin-top: 16px;">
                                <span
                                    style="font-size: 12px; color: #6b7280; text-transform: uppercase; font-weight: 600;">Description
                                    / Reference</span>
                                <p style="margin: 4px 0 0 0; color: #4b5563; font-size: 14px;">
                                    @(selectedPaymentForReview.Description ?? "Loan Payment")</p>
                            </div>
                        </div>

                        <div style="margin-bottom: 24px;">
                            <label
                                style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 8px;">FM
                                Verification Notes</label>
                            <textarea @bind="reviewNotes" rows="3"
                                placeholder="Enter any notes about this payment verification..."
                                style="width: 100%; padding: 14px 16px; border: 2px solid #e5e7eb; border-radius: 10px; font-size: 15px; resize: vertical;"></textarea>
                        </div>

                        <div style="display: flex; gap: 12px; justify-content: flex-end;">
                            <button @onclick="CloseReviewModal"
                                style="background: #f1f5f9; color: #475569; border: none; padding: 12px 24px; border-radius: 10px; cursor: pointer; font-weight: 600;">
                                Cancel
                            </button>
                            <button @onclick="ProceedToStep2"
                                style="background: linear-gradient(135deg, #a855f7, #9333ea); color: white; border: none; padding: 12px 28px; border-radius: 10px; cursor: pointer; font-weight: 700; display: flex; align-items: center; gap: 8px;">
                                Proceed to Step 2
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path d="M5 12h14M12 5l7 7-7 7"></path>
                                </svg>
                            </button>
                        </div>
                    }
                    else if (reviewStep == 2)
                    {
                        <!-- Step 2: Tax Calculation & Final Approval -->
                        <div
                            style="background: linear-gradient(135deg, #f0fdf4, #dcfce7); padding: 24px; border-radius: 16px; border: 1px solid #bbf7d0; margin-bottom: 24px;">
                            <h5 style="margin: 0 0 16px 0; color: #065f46; font-size: 16px; font-weight: 700;">💰 Step 2: Tax
                                Calculation & Approval</h5>

                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px;">
                                <div style="background: white; padding: 16px; border-radius: 10px;">
                                    <span
                                        style="font-size: 12px; color: #6b7280; text-transform: uppercase; font-weight: 600;">Base
                                        Payment</span>
                                    <p style="margin: 4px 0 0 0; font-weight: 700; color: #1e293b; font-size: 18px;">
                                        ₱@selectedPaymentForReview.Amount.ToString("N2")</p>
                                </div>
                                <div style="background: white; padding: 16px; border-radius: 10px;">
                                    <label
                                        style="font-size: 12px; color: #6b7280; text-transform: uppercase; font-weight: 600; display: block;">Tax
                                        Rate (%)</label>
                                    <input type="number" step="0.01" @bind="taxRate" @bind:event="oninput"
                                        style="width: 100%; padding: 10px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 16px; font-weight: 600; margin-top: 6px;">
                                </div>
                            </div>

                            <div
                                style="background: linear-gradient(135deg, #fef3c7, #fde68a); padding: 20px; border-radius: 12px; border: 1px solid #fcd34d;">
                                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; text-align: center;">
                                    <div>
                                        <span
                                            style="font-size: 11px; color: #92400e; text-transform: uppercase; font-weight: 600;">Tax
                                            Amount</span>
                                        <p style="margin: 4px 0 0 0; font-weight: 700; color: #78350f; font-size: 18px;">
                                            ₱@CalculateTax().ToString("N2")</p>
                                    </div>
                                    <div>
                                        <span
                                            style="font-size: 11px; color: #92400e; text-transform: uppercase; font-weight: 600;">Net
                                            Amount</span>
                                        <p style="margin: 4px 0 0 0; font-weight: 700; color: #78350f; font-size: 18px;">
                                            ₱@CalculateNetAmount().ToString("N2")</p>
                                    </div>
                                    <div>
                                        <span
                                            style="font-size: 11px; color: #92400e; text-transform: uppercase; font-weight: 600;">Total
                                            with Tax</span>
                                        <p style="margin: 4px 0 0 0; font-weight: 800; color: #059669; font-size: 22px;">
                                            ₱@CalculateTotalWithTax().ToString("N2")</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div
                            style="background: #fef2f2; padding: 16px; border-radius: 10px; margin-bottom: 24px; border: 1px solid #fecaca;">
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <input type="checkbox" @bind="confirmSendToAccountant" id="confirmSend"
                                    style="width: 20px; height: 20px; accent-color: #a855f7;">
                                <label for="confirmSend" style="font-size: 14px; color: #991b1b; font-weight: 600;">
                                    ✓ I confirm the details are correct and approve sending to Accountant for final approval
                                </label>
                            </div>
                        </div>

                        <div style="display: flex; gap: 12px; justify-content: flex-end;">
                            <button @onclick="() => reviewStep = 1"
                                style="background: #f1f5f9; color: #475569; border: none; padding: 12px 24px; border-radius: 10px; cursor: pointer; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path d="M19 12H5M12 19l-7-7 7-7"></path>
                                </svg>
                                Back to Step 1
                            </button>
                            <button @onclick="ApproveAndSendToAccountant" disabled="@(!confirmSendToAccountant || isProcessing)"
                                style="background: linear-gradient(135deg, #059669, #10b981); color: white; border: none; padding: 12px 28px; border-radius: 10px; cursor: pointer; font-weight: 700; opacity: @(!confirmSendToAccountant || isProcessing ? "0.6" : "1"); display: flex; align-items: center; gap: 8px;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                                </svg>
                                @(isProcessing ? "Processing..." : "✓ Approve & Send to Accountant")
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <style>
        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .table-row-hover:hover {
            background: #f8fafc !important;
        }

        input:focus,
        textarea:focus {
            outline: none;
            border-color: #059669 !important;
            box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.1);
        }

        button:hover:not(:disabled) {
            transform: translateY(-1px);
        }

        button:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }
    </style>
</div>

@code {
    private List<Models.AccountsReceivable> invoices = new();
    private List<Models.AccountsReceivable>? collectionHistory;
    private List<Models.AccountsReceivable> pendingLoanPayments = new();
    private decimal totalOutstanding = 0;
    private decimal dueThisMonth = 0;
    private decimal collectedThisMonth = 0;
    private int pendingInvoices = 0;
    private int dueSoonCount = 0;
    private int collectedCount = 0;
    private int pendingReviewCount = 0;

    // Tab state: 0 = All Invoices, 1 = Pending FM Review
    private int activeTab = 0;

    private bool isLoading = true;
    private bool isProcessing = false;
    private string successMessage = "";
    private string errorMessage = "";

    // Modal states
    private bool showInvoiceModal = false;
    private bool showPaymentModal = false;
    private bool showHistoryModal = false;
    private bool showInvoiceDetailModal = false;
    private bool showReviewModal = false;
    private bool isEditingInvoice = false;
    private Models.AccountsReceivable newInvoice = new();
    private Models.AccountsReceivable? selectedInvoice = null;
    private Models.AccountsReceivable? selectedInvoiceForView = null;
    private Models.AccountsReceivable? selectedPaymentForReview = null;
    private decimal paymentAmount = 0;
    private DateTime paymentDate = DateTime.Today;
    private string receivableType = "";
    private string referenceNumber = "";

    // FM Review fields
    private int reviewStep = 1;
    private string reviewNotes = "";
    private decimal taxRate = 12.0m; // Default 12% VAT
    private bool confirmSendToAccountant = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadInvoices();
    }

    private async Task LoadInvoices()
    {
        isLoading = true;
        try
        {
            invoices = await AccountsReceivableService.GetAllAsync();
            CalculateStats();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading invoices: {ex.Message}";
            invoices = new List<Models.AccountsReceivable>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task FetchPendingLoanPayments()
    {
        isLoading = true;
        try
        {
            // Get all invoices that are pending review (loan payments awaiting FM approval)
            pendingLoanPayments = invoices.Where(i =>
            i.Status == "Pending Review" ||
            (i.Description != null && i.Description.Contains("Loan#") && i.Status == "Pending")).ToList();

            pendingReviewCount = pendingLoanPayments.Count;
            successMessage = pendingLoanPayments.Any()
            ? $"✓ Found {pendingLoanPayments.Count} loan payment(s) pending FM review"
            : "No pending loan payments found";

            // Switch to pending review tab when data is found
            if (pendingLoanPayments.Any())
            {
                activeTab = 1;
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error fetching loan payments: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void CalculateStats()
    {
        var today = DateTime.Today;
        var monthStart = new DateTime(today.Year, today.Month, 1);
        var monthEnd = monthStart.AddMonths(1).AddDays(-1);

        totalOutstanding = invoices.Where(i => i.Status != "Paid" && i.Status != "FM Approved - Pending Accountant").Sum(i =>
        i.OutstandingAmount);
        pendingInvoices = invoices.Count(i => i.Status != "Paid" && i.Status != "FM Approved - Pending Accountant");
        dueThisMonth = invoices.Where(i => i.DueDate >= monthStart && i.DueDate <= monthEnd && i.Status != "Paid").Sum(i =>
        i.Amount);
        dueSoonCount = invoices.Count(i => i.DueDate >= today && i.DueDate <= today.AddDays(7) && i.Status != "Paid");
        collectedThisMonth = invoices.Where(i => i.Status == "Paid" && i.CreatedAt >= monthStart && i.CreatedAt <=
        monthEnd).Sum(i => i.ReceivedAmount);
        collectedCount = invoices.Count(i => i.Status == "Paid");
        pendingReviewCount = invoices.Count(i => i.Status == "Pending Review" ||
        (i.Description != null && i.Description.Contains("Loan#") && i.Status == "Pending"));
    }

    // FM Review Methods
    private void StartFMReview(Models.AccountsReceivable payment)
    {
        selectedPaymentForReview = payment;
        reviewStep = 1;
        reviewNotes = "";
        taxRate = 12.0m;
        confirmSendToAccountant = false;
        showReviewModal = true;
    }

    private void ProceedToStep2()
    {
        reviewStep = 2;
    }

    private decimal CalculateTax()
    {
        if (selectedPaymentForReview == null) return 0;
        return selectedPaymentForReview.Amount * (taxRate / 100);
    }

    private decimal CalculateNetAmount()
    {
        if (selectedPaymentForReview == null) return 0;
        return selectedPaymentForReview.Amount - CalculateTax();
    }

    private decimal CalculateTotalWithTax()
    {
        if (selectedPaymentForReview == null) return 0;
        return selectedPaymentForReview.Amount + CalculateTax();
    }

    private async Task ApproveAndSendToAccountant()
    {
        if (selectedPaymentForReview == null || !confirmSendToAccountant) return;

        isProcessing = true;
        try
        {
            // Update the receivable with tax info and change status
            selectedPaymentForReview.TaxAmount = CalculateTax();
            selectedPaymentForReview.Status = "FM Approved - Pending Accountant";
            selectedPaymentForReview.Description = $"{selectedPaymentForReview.Description} | FM Notes: {reviewNotes} | Tax: ₱{CalculateTax():N2}";

            await AccountsReceivableService.UpdateAsync(selectedPaymentForReview);

            // Create Journal Entry for the AR
            await CreateARJournalEntry(selectedPaymentForReview, "Loan Payment");

            successMessage = $"✓ Payment approved and sent to Accountant! Invoice: {selectedPaymentForReview.InvoiceNumber}";

            // Remove from pending list and reload
            pendingLoanPayments.Remove(selectedPaymentForReview);
            await LoadInvoices();
            CloseReviewModal();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void CloseReviewModal()
    {
        showReviewModal = false;
        selectedPaymentForReview = null;
        reviewStep = 1;
        reviewNotes = "";
        confirmSendToAccountant = false;
    }

    private string GetStatusBg(string status)
    {
        return status switch
        {
            "Paid" => "#d1fae5",
            "Pending" => "#ecfdf5",
            "Overdue" => "#fee2e2",
            "Partial" => "#d1fae5",
            _ => "#f3f4f6"
        };
    }

    private string GetStatusColor(string status)
    {
        return status switch
        {
            "Paid" => "#065f46",
            "Pending" => "#047857",
            "Overdue" => "#b91c1c",
            "Partial" => "#047857",
            _ => "#4b5563"
        };
    }

    private void ShowNewInvoiceModal()
    {
        newInvoice = new Models.AccountsReceivable
        {
            DueDate = DateTime.Today.AddDays(30),
            CreatedAt = DateTime.Now,
            InvoiceNumber = $"AR-{DateTime.Now:yyyyMMdd}-{Random.Shared.Next(1000, 9999)}"
        };
        receivableType = "";
        referenceNumber = "";
        isEditingInvoice = false;
        showInvoiceModal = true;
    }

    private void EditInvoice(Models.AccountsReceivable invoice)
    {
        newInvoice = new Models.AccountsReceivable
        {
            ReceivableId = invoice.ReceivableId,
            CustomerName = invoice.CustomerName,
            InvoiceNumber = invoice.InvoiceNumber,
            Amount = invoice.Amount,
            DueDate = invoice.DueDate,
            Description = invoice.Description,
            Status = invoice.Status
        };
        isEditingInvoice = true;
        showInvoiceModal = true;
    }

    private async Task SaveInvoice()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(receivableType) || string.IsNullOrWhiteSpace(newInvoice.CustomerName) || newInvoice.Amount
            <= 0)
            {
                errorMessage = "Please fill all required fields (Type, Customer, Amount)";
                return;
            }

            if (isEditingInvoice && newInvoice.ReceivableId > 0)
            {
                newInvoice.Status = invoices.First(i => i.ReceivableId == newInvoice.ReceivableId).Status;
                await AccountsReceivableService.UpdateAsync(newInvoice);
                successMessage = "Invoice updated successfully!";
            }
            else
            {
                // Set description based on type
                newInvoice.Description = $"{receivableType} - {newInvoice.Description ?? ""} | Ref: {referenceNumber ?? "N/A"}";
                newInvoice.Status = "Pending";
                newInvoice.OutstandingAmount = newInvoice.Amount;
                newInvoice.ReceivedAmount = 0;
                newInvoice.CreatedBy = "Finance Manager";

                var created = await AccountsReceivableService.CreateAsync(newInvoice);

                // Create Journal Entry for AR Creation
                await CreateARJournalEntry(created, receivableType);

                successMessage = $"{receivableType} receivable created with auto-journal entry! Invoice: {created.InvoiceNumber}";
            }

            await LoadInvoices();
            CloseInvoiceModal();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving invoice: {ex.Message}";
        }
    }

    private void CloseInvoiceModal()
    {
        showInvoiceModal = false;
        newInvoice = new();
        isEditingInvoice = false;
    }

    private void RecordPayment(Models.AccountsReceivable invoice)
    {
        selectedInvoice = invoice;
        // Autofill with outstanding amount, or full amount if outstanding is 0
        paymentAmount = invoice.OutstandingAmount > 0 ? invoice.OutstandingAmount : invoice.Amount;
        paymentDate = DateTime.Today;
        showPaymentModal = true;
    }

    private async Task ConfirmPayment()
    {
        if (selectedInvoice == null) return;

        isProcessing = true;
        try
        {
            // Calculate the effective outstanding amount (use Amount if OutstandingAmount is 0)
            decimal effectiveOutstanding = selectedInvoice.OutstandingAmount > 0
                            ? selectedInvoice.OutstandingAmount
            : selectedInvoice.Amount;

            if (paymentAmount <= 0 || paymentAmount > effectiveOutstanding)
            {
                errorMessage = $"Invalid payment amount. Must be between ₱0.01 and ₱{effectiveOutstanding:N2}";
                isProcessing = false;
                return;
            }

            // Initialize OutstandingAmount if it was 0
            if (selectedInvoice.OutstandingAmount == 0)
            {
                selectedInvoice.OutstandingAmount = selectedInvoice.Amount;
            }

            selectedInvoice.ReceivedAmount += paymentAmount;
            selectedInvoice.OutstandingAmount -= paymentAmount;

            if (selectedInvoice.OutstandingAmount <= 0)
            {
                selectedInvoice.Status = "Paid";
                selectedInvoice.OutstandingAmount = 0;
            }
            else
            {
                selectedInvoice.Status = "Partially Paid";
            }

            await AccountsReceivableService.UpdateAsync(selectedInvoice);

            // Create Journal Entry for Payment Receipt
            await CreateARPaymentJournalEntry(selectedInvoice, paymentAmount);

            successMessage = $"✅ Payment of ₱{paymentAmount:N2} received successfully! Journal entry auto-posted.";

            // Also remove from pending list if it was there
            if (pendingLoanPayments.Contains(selectedInvoice))
            {
                pendingLoanPayments.Remove(selectedInvoice);
                pendingReviewCount = pendingLoanPayments.Count;
            }

            await LoadInvoices();
            ClosePaymentModal();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error recording payment: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void ClosePaymentModal()
    {
        showPaymentModal = false;
        selectedInvoice = null;
        paymentAmount = 0;
    }

    private void OpenHistoryModal()
    {
        collectionHistory = invoices.Where(i => i.ReceivedAmount > 0).OrderByDescending(i => i.CreatedAt).ToList();
        showHistoryModal = true;
    }

    private void CloseHistoryModal()
    {
        showHistoryModal = false;
        collectionHistory = null;
    }

    private void ViewInvoiceDetails(Models.AccountsReceivable invoice)
    {
        selectedInvoiceForView = invoice;
        showInvoiceDetailModal = true;
    }

    private void CloseInvoiceDetailModal()
    {
        showInvoiceDetailModal = false;
        selectedInvoiceForView = null;
    }

    // ========== JOURNAL ENTRY METHODS ==========
    private async Task CreateARJournalEntry(Models.AccountsReceivable receivable, string type)
    {
        try
        {
            var journalEntry = new JournalEntry
            {
                TransactionDate = DateTime.Now,
                Description = $"AR Creation - {type}: {receivable.CustomerName}",
                Reference = receivable.InvoiceNumber,
                Status = "Posted",
                CreatedBy = "Finance Manager",
                PostedBy = "System",
                PostedAt = DateTime.Now,
                Lines = new List<JournalEntryLine>()
            };

            // Debit: Accounts Receivable (Asset increases)
            journalEntry.Lines.Add(new JournalEntryLine
            {
                AccountCode = "1120",
                AccountName = "Accounts Receivable",
                Description = $"{type} - {receivable.CustomerName}",
                DebitAmount = receivable.Amount,
                CreditAmount = 0
            });

            // Credit: Revenue/Income based on type
            var (creditAccount, creditName) = type switch
            {
                "Loan Principal" => ("2100", "Loans Payable"),
                "Interest Income" => ("4100", "Interest Income"),
                "Penalty" => ("4200", "Penalty Income"),
                "Service Fee" => ("4300", "Service Fee Income"),
                _ => ("4000", "Other Revenue")
            };

            journalEntry.Lines.Add(new JournalEntryLine
            {
                AccountCode = creditAccount,
                AccountName = creditName,
                Description = $"{type} - {receivable.CustomerName}",
                DebitAmount = 0,
                CreditAmount = receivable.Amount
            });

            journalEntry.TotalDebit = receivable.Amount;
            journalEntry.TotalCredit = receivable.Amount;

            await JournalEntryService.CreateAsync(journalEntry);
        }
        catch (Exception ex)
        {
            // Log error but don't fail the receivable creation
            Console.WriteLine($"Journal Entry Error: {ex.Message}");
        }
    }

    private async Task CreateARPaymentJournalEntry(Models.AccountsReceivable receivable, decimal paidAmount)
    {
        try
        {
            var journalEntry = new JournalEntry
            {
                TransactionDate = DateTime.Now,
                Description = $"AR Payment Receipt - {receivable.CustomerName}",
                Reference = receivable.InvoiceNumber,
                Status = "Posted",
                CreatedBy = "Finance Manager",
                PostedBy = "System",
                PostedAt = DateTime.Now,
                Lines = new List<JournalEntryLine>()
            };

            // Debit: Cash/Bank (Asset increases)
            journalEntry.Lines.Add(new JournalEntryLine
            {
                AccountCode = "1010",
                AccountName = "Cash in Bank",
                Description = $"Payment from {receivable.CustomerName}",
                DebitAmount = paidAmount,
                CreditAmount = 0
            });

            // Credit: Accounts Receivable (Asset decreases)
            journalEntry.Lines.Add(new JournalEntryLine
            {
                AccountCode = "1120",
                AccountName = "Accounts Receivable",
                Description = $"Payment from {receivable.CustomerName}",
                DebitAmount = 0,
                CreditAmount = paidAmount
            });

            journalEntry.TotalDebit = paidAmount;
            journalEntry.TotalCredit = paidAmount;

            await JournalEntryService.CreateAsync(journalEntry);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Payment Journal Entry Error: {ex.Message}");
        }
    }
}