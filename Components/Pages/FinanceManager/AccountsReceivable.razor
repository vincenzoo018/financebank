                                <span style="font-size: 12px; color: #6b7280;">Customer Name</span>
                                <p style="margin: 2px 0 0 0; font-weight: 600; color: #1e293b;">
                                    @selectedInvoiceForView.CustomerName</p>
                            </div>
                            <div>
                                <span style="font-size: 12px; color: #6b7280;">Status</span>
                                <p
                                    style="margin: 2px 0 0 0; font-weight: 600; color: @GetStatusColor(selectedInvoiceForView.Status);">
                                    @selectedInvoiceForView.Status</p>
                            </div>
                        </div>
                    </div>

                    <div style="border: 2px solid #e2e8f0; border-radius: 12px; overflow: hidden; margin-bottom: 24px;">
                        <div style="background: #f8fafc; padding: 12px 18px; border-bottom: 1px solid #e2e8f0;">
                            <h6
                                style="margin: 0; color: #475569; font-size: 12px; text-transform: uppercase; font-weight: 700;">
                                Collection Details</h6>
                        </div>
                        <div style="padding: 18px;">
                            <table style="width: 100%; font-size: 14px;">
                                <tr>
                                    <td style="padding: 8px 0; color: #64748b;">Original Amount</td>
                                    <td style="text-align: right; font-weight: 600; color: #1e293b;">
                                        ₱@selectedInvoiceForView.Amount.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <td style="padding: 8px 0; color: #64748b;">Amount Collected</td>
                                    <td style="text-align: right; font-weight: 600; color: #059669;">
