                                </tr>
                                <tr style="border-top: 2px solid #e2e8f0;">
                                    <td style="padding: 12px 0; font-weight: 700; color: #1e293b; font-size: 16px;">
                                        Outstanding
                                        Balance</td>
                                    <td
                                        style="text-align: right; font-weight: 800; color: @(selectedInvoiceForView.OutstandingAmount > 0 ? "#059669" : "#10b981"); font-size: 20px;">
                                        ₱@selectedInvoiceForView.OutstandingAmount.ToString("N2")</td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(selectedInvoiceForView.Description))
                    {
                        <div
                            style="background: #fef3c7; padding: 16px 20px; border-radius: 10px; margin-bottom: 24px; border: 1px solid #fde68a;">
                            <h6
                                style="margin: 0 0 8px 0; color: #92400e; font-size: 12px; text-transform: uppercase; font-weight: 700;">
                                Description</h6>
                            <p style="margin: 0; color: #78350f; font-size: 14px;">@selectedInvoiceForView.Description</p>
