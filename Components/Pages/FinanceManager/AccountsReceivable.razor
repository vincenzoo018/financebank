                        <div style="background: #f8fafc; padding: 14px 18px; border-radius: 10px;">
                            <span style="font-size: 11px; color: #64748b; text-transform: uppercase; font-weight: 600;">Due
                                Date</span>
                            <p style="margin: 4px 0 0 0; font-weight: 600; color: #1e293b; font-size: 15px;">
                                @selectedInvoiceForView.DueDate.ToString("MMMM dd, yyyy")</p>
                        </div>
                    </div>

                    <div
                        style="background: linear-gradient(135deg, #ecfdf5, #d1fae5); padding: 18px 20px; border-radius: 12px; margin-bottom: 24px; border: 1px solid #6ee7b7;">
