@page "/finance/receivables"
@layout FinanceManagerLayout
@using FinanceBank.Services
@using FinanceBank.Models
@inject AuthService AuthService
@inject AccountsReceivableService AccountsReceivableService
@inject JournalEntryService JournalEntryService
@inject LoanService LoanService

<div class="page-container" style="padding: 24px;">
    <!-- Page Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <div>
            <h2 style="margin: 0; color: #1f2937; font-weight: 700; font-size: 24px;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2"
                    style="margin-right: 10px; vertical-align: middle;">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                </svg>
                Accounts Receivable
            </h2>
            <p style="margin: 4px 0 0 0; color: #6b7280; font-size: 14px;">Review and approve loan payments before
                sending to Accountant</p>
        </div>
        <div style="display: flex; gap: 12px;">
            <button @onclick="FetchPendingLoanPayments"
                style="display: flex; align-items: center; gap: 8px; background: linear-gradient(135deg, #f59e0b, #d97706); color: white; border: none; padding: 12px 20px; border-radius: 10px; cursor: pointer; font-weight: 600; font-size: 14px; box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3); transition: all 0.2s;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path
                        d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                </svg>
                Fetch Pending Payments
            </button>
            <button @onclick="LoadInvoices"
                style="display: flex; align-items: center; gap: 8px; background: linear-gradient(135deg, #059669, #10b981); color: white; border: none; padding: 12px 20px; border-radius: 10px; cursor: pointer; font-weight: 600; font-size: 14px; box-shadow: 0 4px 12px rgba(5, 150, 105, 0.3); transition: all 0.2s;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M23 4v6h-6M1 20v-6h6M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15" />
                </svg>
                Refresh
            </button>
            <button @onclick="OpenHistoryModal"
                style="display: flex; align-items: center; gap: 8px; background: linear-gradient(135deg, #3b82f6, #2563eb); color: white; border: none; padding: 12px 20px; border-radius: 10px; cursor: pointer; font-weight: 600; font-size: 14px; box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3); transition: all 0.2s;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                Collection History
            </button>
        </div>
    </div>

    <!-- Stats Cards -->
    <div
        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">
        <div
            style="background: linear-gradient(135deg, #eff6ff, #dbeafe); border-radius: 12px; padding: 20px; border: 1px solid #bfdbfe;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div
                    style="width: 48px; height: 48px; background: #3b82f6; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                        <path d="M12 2v20M2 12h20"></path>
                    </svg>
                </div>
                <div>
                    <p style="margin: 0; color: #3b82f6; font-size: 12px; font-weight: 600; text-transform: uppercase;">
                        Total Outstanding</p>
                    <p style="margin: 4px 0 0 0; font-size: 24px; font-weight: 700; color: #1e40af;">
                        ₱@totalOutstanding.ToString("N2")</p>
                </div>
            </div>
            <p style="margin: 12px 0 0 0; font-size: 12px; color: #2563eb;">@pendingInvoices invoices pending</p>
        </div>
        <div
            style="background: linear-gradient(135deg, #fefce8, #fef9c3); border-radius: 12px; padding: 20px; border: 1px solid #fde047;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div
                    style="width: 48px; height: 48px; background: #eab308; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                </div>
                <div>
                    <p style="margin: 0; color: #ca8a04; font-size: 12px; font-weight: 600; text-transform: uppercase;">
                        Due This Month</p>
                    <p style="margin: 4px 0 0 0; font-size: 24px; font-weight: 700; color: #854d0e;">
                        ₱@dueThisMonth.ToString("N2")</p>
                </div>
            </div>
            <p style="margin: 12px 0 0 0; font-size: 12px; color: #a16207;">@dueSoonCount invoices due soon</p>
        </div>
        <div
            style="background: linear-gradient(135deg, #f0fdf4, #dcfce7); border-radius: 12px; padding: 20px; border: 1px solid #bbf7d0;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div
                    style="width: 48px; height: 48px; background: #059669; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                </div>
                <div>
                    <p style="margin: 0; color: #059669; font-size: 12px; font-weight: 600; text-transform: uppercase;">
                        Collected This Month</p>
                    <p style="margin: 4px 0 0 0; font-size: 24px; font-weight: 700; color: #065f46;">
                        ₱@collectedThisMonth.ToString("N2")</p>
                </div>
            </div>
            <p style="margin: 12px 0 0 0; font-size: 12px; color: #047857;">@collectedCount payments received</p>
        </div>
        <div
            style="background: linear-gradient(135deg, #fdf4ff, #f5d0fe); border-radius: 12px; padding: 20px; border: 1px solid #e879f9;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div
                    style="width: 48px; height: 48px; background: #a855f7; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                        <path d="M9 11l3 3L22 4"></path>
                        <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"></path>
                    </svg>
                </div>
                <div>
                    <p style="margin: 0; color: #a855f7; font-size: 12px; font-weight: 600; text-transform: uppercase;">
                        Pending FM Review</p>
                    <p style="margin: 4px 0 0 0; font-size: 24px; font-weight: 700; color: #7c3aed;">@pendingReviewCount
                    </p>
                </div>
            </div>
            <p style="margin: 12px 0 0 0; font-size: 12px; color: #9333ea;">Loan payments to review</p>
        </div>
    </div>

    <!-- Alerts -->
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div
            style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); border: 1px solid #6ee7b7; color: #065f46; padding: 16px 20px; border-radius: 12px; margin-bottom: 20px; display: flex; align-items: center; gap: 12px; box-shadow: 0 2px 8px rgba(16, 185, 129, 0.15);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <span style="font-weight: 500;">@successMessage</span>
            <button @onclick="() => successMessage = string.Empty"
                style="margin-left: auto; background: none; border: none; color: #065f46; cursor: pointer; font-size: 18px;">×</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div
            style="background: #fee2e2; border: 1px solid #fecaca; color: #991b1b; padding: 16px 20px; border-radius: 12px; margin-bottom: 20px; display: flex; align-items: center; gap: 12px;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="15" y1="9" x2="9" y2="15"></line>
                <line x1="9" y1="9" x2="15" y2="15"></line>
            </svg>
            <span style="font-weight: 500;">@errorMessage</span>
            <button @onclick="() => errorMessage = string.Empty"
                style="margin-left: auto; background: none; border: none; color: #991b1b; cursor: pointer; font-size: 18px;">×</button>
        </div>
    }

    <!-- Pending Loan Payments for FM Review -->
    @if (pendingLoanPayments.Any())
    {
        <div
            style="background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden; margin-bottom: 24px; border: 2px solid #a855f7;">
            <div style="background: linear-gradient(135deg, #a855f7, #9333ea); color: white; padding: 20px 24px;">
                <h4 style="margin: 0; font-weight: 600; font-size: 18px;">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        style="margin-right: 8px; vertical-align: middle;">
                        <path d="M9 11l3 3L22 4"></path>
                        <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"></path>
                    </svg>
                    🔍 Pending Loan Payments - FM Review Required
                </h4>
                <p style="margin: 6px 0 0 0; opacity: 0.9; font-size: 13px;">Review loan payments before sending to
                    Accountant for final approval</p>
            </div>

            <div style="padding: 24px;">
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: separate; border-spacing: 0;">
                        <thead>
                            <tr style="background: linear-gradient(135deg, #fdf4ff, #f5d0fe);">
                                <th
                                    style="padding: 14px 16px; text-align: left; font-weight: 600; color: #7c3aed; font-size: 13px; text-transform: uppercase;">
                                    Invoice #</th>
                                <th
                                    style="padding: 14px 16px; text-align: left; font-weight: 600; color: #7c3aed; font-size: 13px; text-transform: uppercase;">
                                    Customer</th>
                                <th
                                    style="padding: 14px 16px; text-align: right; font-weight: 600; color: #7c3aed; font-size: 13px; text-transform: uppercase;">
                                    Amount</th>
                                <th
                                    style="padding: 14px 16px; text-align: center; font-weight: 600; color: #7c3aed; font-size: 13px; text-transform: uppercase;">
                                    Due Date</th>
                                <th
                                    style="padding: 14px 16px; text-align: center; font-weight: 600; color: #7c3aed; font-size: 13px; text-transform: uppercase;">
                                    Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var payment in pendingLoanPayments)
                            {
                                <tr style="border-bottom: 1px solid #f3e8ff;">
                                    <td style="padding: 16px;">
                                        <span
                                            style="background: linear-gradient(135deg, #f3e8ff, #e9d5ff); color: #7c3aed; padding: 6px 14px; border-radius: 20px; font-weight: 600; font-size: 13px;">
                                            @payment.InvoiceNumber
                                        </span>
                                    </td>
                                    <td style="padding: 16px;">
                                        <div style="font-weight: 600; color: #1e293b;">@payment.CustomerName</div>
                                        <div style="font-size: 12px; color: #64748b;">@(payment.Description ?? "Loan Payment")
                                        </div>
                                    </td>
                                    <td style="padding: 16px; text-align: right;">
                                        <span
                                            style="font-weight: 700; color: #059669; font-size: 16px;">₱@payment.Amount.ToString("N2")</span>
                                    </td>
                                    <td style="padding: 16px; text-align: center; color: #475569;">
                                        @payment.DueDate.ToString("MMM dd, yyyy")
                                    </td>
                                    <td style="padding: 16px; text-align: center;">
                                        <button @onclick="() => StartFMReview(payment)"
                                            style="background: linear-gradient(135deg, #a855f7, #9333ea); color: white; border: none; padding: 10px 20px; border-radius: 10px; cursor: pointer; font-weight: 700; font-size: 13px; box-shadow: 0 4px 12px rgba(168, 85, 247, 0.3);">
                                            🔍 Review & Approve
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- Main Content Card -->
    <div style="background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden;">
        <div style="background: linear-gradient(135deg, #059669, #10b981); color: white; padding: 20px 24px;">
            <h4 style="margin: 0; font-weight: 600; font-size: 18px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    style="margin-right: 8px; vertical-align: middle;">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                </svg>
                Outstanding Invoices
            </h4>
            <p style="margin: 6px 0 0 0; opacity: 0.9; font-size: 13px;">Track and manage customer invoices and
                collections</p>
        </div>

        <div style="padding: 24px;">
            @if (isLoading)
            {
                <div style="text-align: center; padding: 60px;">
                    <div
                        style="width: 48px; height: 48px; border: 4px solid #e5e7eb; border-top-color: #059669; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto;">
                    </div>
                    <p style="margin-top: 16px; color: #6b7280; font-size: 15px;">Loading invoices...</p>
                </div>
            }
            else if (invoices == null || !invoices.Any())
            {
                <div
                    style="text-align: center; padding: 80px 20px; background: linear-gradient(135deg, #f9fafb, #f3f4f6); border-radius: 16px;">
                    <div
                        style="width: 80px; height: 80px; background: #e5e7eb; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        </svg>
                    </div>
                    <h5 style="color: #4b5563; margin-top: 20px; font-size: 18px; font-weight: 600;">No Invoices Found</h5>
                    <p style="color: #9ca3af; font-size: 14px; margin-top: 8px;">Create your first invoice to get started.
                    </p>
                </div>
            }
            else
            {
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: separate; border-spacing: 0;">
                        <thead>
                            <tr style="background: linear-gradient(135deg, #f8fafc, #f1f5f9);">
                                <th
                                    style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">
                                    Invoice #</th>
                                <th
                                    style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">
                                    Customer</th>
                                <th
                                    style="padding: 14px 16px; text-align: right; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">
                                    Amount</th>
                                <th
                                    style="padding: 14px 16px; text-align: right; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">
                                    Outstanding</th>
                                <th
                                    style="padding: 14px 16px; text-align: center; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">
                                    Due Date</th>
                                <th
                                    style="padding: 14px 16px; text-align: center; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">
                                    Status</th>
                                <th
                                    style="padding: 14px 16px; text-align: center; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">
                                    Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var invoice in invoices)
                            {
                                <tr style="border-bottom: 1px solid #f1f5f9; transition: all 0.2s;" class="table-row-hover">
                                    <td style="padding: 16px;">
                                        <span
                                            style="background: linear-gradient(135deg, #dbeafe, #bfdbfe); color: #1e40af; padding: 6px 14px; border-radius: 20px; font-weight: 600; font-size: 13px; display: inline-block;">
                                            @invoice.InvoiceNumber
                                        </span>
                                    </td>
                                    <td style="padding: 16px;">
                                        <div style="font-weight: 600; color: #1e293b; font-size: 15px;">@invoice.CustomerName
                                        </div>
                                        <div style="font-size: 12px; color: #64748b; margin-top: 2px;">@(invoice.Description ??
                                                                                "No description")</div>
                                    </td>
                                    <td style="padding: 16px; text-align: right;">
                                        <span
                                            style="font-weight: 700; color: #1e293b; font-size: 15px;">₱@invoice.Amount.ToString("N2")</span>
                                    </td>
                                    <td style="padding: 16px; text-align: right;">
                                        <span
                                            style="font-weight: 700; color: @(invoice.OutstandingAmount > 0 ? "#3b82f6" : "#059669"); font-size: 15px;">₱@invoice.OutstandingAmount.ToString("N2")</span>
                                    </td>
                                    <td style="padding: 16px; text-align: center; color: #475569; font-weight: 500;">
                                        @invoice.DueDate.ToString("MMM dd, yyyy")
                                    </td>
                                    <td style="padding: 16px; text-align: center;">
                                        <span
                                            style="display: inline-flex; align-items: center; padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 600; background: @GetStatusBg(invoice.Status); color: @GetStatusColor(invoice.Status);">
                                            @invoice.Status
                                        </span>
                                    </td>
                                    <td style="padding: 16px; text-align: center;">
                                        <div style="display: flex; gap: 8px; justify-content: center;">
                                            @if (invoice.Status != "Paid")
                                            {
                                                <button
                                                    style="background: linear-gradient(135deg, #059669, #10b981); color: white; border: none; padding: 8px 14px; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 12px; box-shadow: 0 2px 8px rgba(5, 150, 105, 0.25); transition: all 0.2s;"
                                                    @onclick="() => RecordPayment(invoice)">
                                                    Receive
                                                </button>
                                            }
                                            <button
                                                style="background: linear-gradient(135deg, #3b82f6, #2563eb); color: white; border: none; padding: 8px 14px; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 12px; box-shadow: 0 2px 8px rgba(59, 130, 246, 0.25); transition: all 0.2s;"
                                                @onclick="() => ViewInvoiceDetails(invoice)">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                                    stroke="currentColor" stroke-width="2" style="vertical-align: middle;">
                                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                                </svg>
                                            </button>
                                            <button
                                                style="background: #f1f5f9; color: #475569; border: none; padding: 8px 14px; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 12px; transition: all 0.2s;"
                                                @onclick="() => EditInvoice(invoice)">
                                                Edit
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- New/Edit Invoice Modal -->
@if (showInvoiceModal)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.6); display: flex; align-items: center; justify-content: center; z-index: 1000; backdrop-filter: blur(4px);"
        @onclick="CloseInvoiceModal">
        <div style="background: white; border-radius: 20px; width: 90%; max-width: 550px; max-height: 90vh; overflow-y: auto; box-shadow: 0 25px 60px rgba(0,0,0,0.3);"
            @onclick:stopPropagation>
            <div
                style="background: linear-gradient(135deg, #059669, #10b981); color: white; padding: 24px 28px; border-radius: 20px 20px 0 0;">
                <h4 style="margin: 0; font-weight: 700; font-size: 20px;">@(isEditingInvoice ? "Edit Invoice" : "Create New Invoice")</h4>
                <p style="margin: 6px 0 0 0; opacity: 0.9; font-size: 14px;">Enter invoice details below</p>
            </div>

            <div style="padding: 28px;">
                <div style="margin-bottom: 20px;">
                    <label
                        style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 8px;">Receivable
                        Type <span style="color: #ef4444;">*</span></label>
                    <select @bind="receivableType"
                        style="width: 100%; padding: 14px 16px; border: 2px solid #e5e7eb; border-radius: 10px; font-size: 15px; transition: border-color 0.2s; background: white;">
                        <option value="">-- Select Receivable Type --</option>
                        <option value="Loan Principal">💰 Loan Principal Receivable</option>
                        <option value="Interest Income">📈 Interest Income</option>
                        <option value="Penalty">⚠️ Penalty for Late Payment</option>
                        <option value="Service Fee">🏦 Service Fee / Bank Charges</option>
                        <option value="Underpayment">📉 Customer Underpayment</option>
                    </select>
                </div>

                <div style="margin-bottom: 20px;">
                    <label
                        style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 8px;">Customer
                        Name <span style="color: #ef4444;">*</span></label>
                    <input type="text" @bind="newInvoice.CustomerName" placeholder="Enter customer name"
                        style="width: 100%; padding: 14px 16px; border: 2px solid #e5e7eb; border-radius: 10px; font-size: 15px; transition: border-color 0.2s;">
                </div>

                <div style="margin-bottom: 20px;">
                    <label
                        style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 8px;">Invoice
                        Number <span style="color: #ef4444;">*</span></label>
                    <input type="text" @bind="newInvoice.InvoiceNumber" placeholder="Auto-generated"
                        style="width: 100%; padding: 14px 16px; border: 2px solid #e5e7eb; border-radius: 10px; font-size: 15px;">
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px;">
                    <div>
                        <label
                            style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 8px;">Amount
                            <span style="color: #ef4444;">*</span></label>
                        <input type="number" step="0.01" @bind="newInvoice.Amount" placeholder="0.00"
                            style="width: 100%; padding: 14px 16px; border: 2px solid #e5e7eb; border-radius: 10px; font-size: 15px;">
                    </div>
                    <div>
                        <label
                            style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 8px;">Due
                            Date <span style="color: #ef4444;">*</span></label>
                        <input type="date" @bind="newInvoice.DueDate"
                            style="width: 100%; padding: 14px 16px; border: 2px solid #e5e7eb; border-radius: 10px; font-size: 15px;">
                    </div>
                </div>

                <div style="margin-bottom: 20px;">
                    <label
                        style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 8px;">Reference
                        / Loan Number</label>
                    <input type="text" @bind="referenceNumber" placeholder="e.g., LOAN-2024-001"
                        style="width: 100%; padding: 14px 16px; border: 2px solid #e5e7eb; border-radius: 10px; font-size: 15px;">
                </div>

                <div style="margin-bottom: 24px;">
                    <label
                        style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 8px;">Description</label>
                    <textarea @bind="newInvoice.Description" placeholder="Enter receivable details"
                        style="width: 100%; padding: 14px 16px; border: 2px solid #e5e7eb; border-radius: 10px; font-size: 15px; min-height: 100px; resize: vertical;"></textarea>
                </div>

                <div
                    style="display: flex; gap: 12px; justify-content: flex-end; padding-top: 20px; border-top: 1px solid #e5e7eb;">
                    <button
                        style="background: #f1f5f9; color: #475569; border: none; padding: 12px 24px; border-radius: 10px; cursor: pointer; font-weight: 600; font-size: 14px;"
                        @onclick="CloseInvoiceModal">Cancel</button>
                    <button
                        style="background: linear-gradient(135deg, #059669, #10b981); color: white; border: none; padding: 12px 28px; border-radius: 10px; cursor: pointer; font-weight: 700; font-size: 14px; box-shadow: 0 4px 12px rgba(5, 150, 105, 0.3);"
                        @onclick="SaveInvoice">@(isEditingInvoice ? "Update Invoice" : "Create Invoice")</button>
                </div>
            </div>
        </div>
    </div>
}

