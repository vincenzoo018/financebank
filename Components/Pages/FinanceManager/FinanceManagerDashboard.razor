@page "/finance-manager/dashboard"
@layout FinanceManagerLayout

<div style="padding: 24px; max-width: 1400px; margin: 0 auto;">
    <!-- Header with Filter -->
    <div style="background: linear-gradient(135deg, #3b82f6, #1e40af); border-radius: 16px; padding: 24px; margin-bottom: 24px; color: white;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h1 style="font-size: 24px; font-weight: 700; margin: 0;">Finance Manager Dashboard</h1>
                <p style="margin: 8px 0 0; font-size: 14px; opacity: 0.9;">Financial operations & approvals overview</p>
            </div>
            <div style="display: flex; gap: 8px;">
                <button @onclick='() => selectedPeriod = "day"' style="padding: 8px 16px; background: @(selectedPeriod == "day" ? "white" : "rgba(255,255,255,0.2)"); color: @(selectedPeriod == "day" ? "#1e40af" : "white"); border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer;">Day</button>
                <button @onclick='() => selectedPeriod = "week"' style="padding: 8px 16px; background: @(selectedPeriod == "week" ? "white" : "rgba(255,255,255,0.2)"); color: @(selectedPeriod == "week" ? "#1e40af" : "white"); border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer;">Week</button>
                <button @onclick='() => selectedPeriod = "month"' style="padding: 8px 16px; background: @(selectedPeriod == "month" ? "white" : "rgba(255,255,255,0.2)"); color: @(selectedPeriod == "month" ? "#1e40af" : "white"); border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer;">Month</button>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 24px;">
        <div style="background: white; border-radius: 12px; padding: 20px; border: 2px solid #dbeafe;">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                <div style="width: 40px; height: 40px; background: #dbeafe; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                    <svg width="20" height="20" fill="none" stroke="#1e40af" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2v20m10-10H2"></path>
                    </svg>
                </div>
                <div>
                    <div style="font-size: 12px; color: #6b7280;">Pending Approvals</div>
                    <div style="font-size: 24px; font-weight: 700; color: #1e40af;">24</div>
                </div>
            </div>
            <div style="font-size: 11px; color: #1e40af;">8 high priority</div>
        </div>

        <div style="background: white; border-radius: 12px; padding: 20px; border: 2px solid #dbeafe;">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                <div style="width: 40px; height: 40px; background: #dbeafe; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                    <svg width="20" height="20" fill="none" stroke="#1e40af" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <div>
                    <div style="font-size: 12px; color: #6b7280;">Approved This Period</div>
                    <div style="font-size: 24px; font-weight: 700; color: #1e40af;">₱8.5M</div>
                </div>
            </div>
            <div style="font-size: 11px; color: #1e40af;">42 transactions</div>
        </div>

        <div style="background: white; border-radius: 12px; padding: 20px; border: 2px solid #dbeafe;">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                <div style="width: 40px; height: 40px; background: #dbeafe; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                    <svg width="20" height="20" fill="none" stroke="#1e40af" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 13l4 4L19 7"></path>
                    </svg>
                </div>
                <div>
                    <div style="font-size: 12px; color: #6b7280;">Total Budget</div>
                    <div style="font-size: 24px; font-weight: 700; color: #1e40af;">₱25.0M</div>
                </div>
            </div>
            <div style="font-size: 11px; color: #1e40af;">68% utilized</div>
        </div>

        <div style="background: white; border-radius: 12px; padding: 20px; border: 2px solid #fee2e2;">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                <div style="width: 40px; height: 40px; background: #fee2e2; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                    <svg width="20" height="20" fill="none" stroke="#dc2626" stroke-width="2">
                        <path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <div>
                    <div style="font-size: 12px; color: #6b7280;">Exceptions</div>
                    <div style="font-size: 24px; font-weight: 700; color: #dc2626;">2</div>
                </div>
            </div>
            <div style="font-size: 11px; color: #dc2626;">Requires action</div>
        </div>
    </div>

    <!-- Charts Row -->
    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 20px; margin-bottom: 24px;">
        <!-- Approval Trend -->
        <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
            <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 20px;">Approvals This Week</h3>
            <div style="display: flex; align-items: flex-end; gap: 12px; height: 200px;">
                @foreach (var data in weeklyData)
                {
                    <div style="flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8px;">
                        <div style="width: 100%; background: linear-gradient(180deg, #3b82f6, #1e40af); border-radius: 8px 8px 0 0; height: @(data.Value * 7)%; min-height: 10px; transition: all 0.3s;"></div>
                        <div style="font-size: 11px; color: #6b7280; font-weight: 600;">@data.Label</div>
                        <div style="font-size: 12px; font-weight: 700; color: #1e40af;">@data.Value</div>
                    </div>
                }
            </div>
        </div>

        <!-- Finance Performance -->
        <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
            <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 20px;">Performance Metrics</h3>
            <div style="display: flex; flex-direction: column; gap: 16px;">
                <div style="padding: 12px; background: #f9fafb; border-radius: 8px;">
                    <div style="font-size: 12px; color: #6b7280;">Approval Rate</div>
                    <div style="display: flex; align-items: center; gap: 8px; margin-top: 4px;">
                        <div style="flex: 1; height: 8px; background: #e5e7eb; border-radius: 4px; overflow: hidden;">
                            <div style="width: 87%; height: 100%; background: #1e40af;"></div>
                        </div>
                        <span style="font-size: 14px; font-weight: 700;">87%</span>
                    </div>
                </div>
                <div style="padding: 12px; background: #f9fafb; border-radius: 8px;">
                    <div style="font-size: 12px; color: #6b7280;">Avg. Approval Time</div>
                    <div style="font-size: 20px; font-weight: 700; margin-top: 4px; color: #1e40af;">4.2h</div>
                </div>
                <div style="padding: 12px; background: #f9fafb; border-radius: 8px;">
                    <div style="font-size: 12px; color: #6b7280;">Budget Compliance</div>
                    <div style="font-size: 14px; font-weight: 700; color: #10b981; margin-top: 4px;">Excellent</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Approvals -->
    <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
        <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 16px;">Recent Finance Operations</h3>
        <div style="display: flex; flex-direction: column; gap: 12px;">
            @foreach (var activity in recentActivities)
            {
                <div style="display: flex; align-items: center; gap: 12px; padding: 12px; background: #f9fafb; border-radius: 8px;">
                    <div style="width: 32px; height: 32px; background: @activity.Color; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <svg width="16" height="16" fill="none" stroke="white" stroke-width="2">
                            <path d="@activity.Icon"/>
                        </svg>
                    </div>
                    <div style="flex: 1;">
                        <div style="font-weight: 600; font-size: 14px;">@activity.Title</div>
                        <div style="font-size: 12px; color: #6b7280;">@activity.Description</div>
                    </div>
                    <div style="font-size: 11px; color: #9ca3af;">@activity.Time</div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string selectedPeriod = "week";
    
    private List<ChartData> weeklyData = new()
    {
        new() { Label = "Mon", Value = 8 },
        new() { Label = "Tue", Value = 12 },
        new() { Label = "Wed", Value = 6 },
        new() { Label = "Thu", Value = 15 },
        new() { Label = "Fri", Value = 10 },
        new() { Label = "Sat", Value = 2 },
        new() { Label = "Sun", Value = 1 }
    };

    private List<Activity> recentActivities = new()
    {
        new() { Title = "Loan Approved", Description = "₱500,000 Personal Loan - Juan Dela Cruz", Time = "10 min ago", Color = "#3b82f6", Icon = "M9 12l2 2 4-4" },
        new() { Title = "Payment Processed", Description = "₱250,000 Installment Collection", Time = "25 min ago", Color = "#10b981", Icon = "M5 13l4 4L19 7" },
        new() { Title = "Finance Report Approved", Description = "Monthly Financial Statement Validated", Time = "1 hour ago", Color = "#f59e0b", Icon = "M9 12h6m-6 4h6" },
        new() { Title = "Budget Allocation", Description = "Q1 Operating Expenses - ₱3.2M", Time = "2 hours ago", Color = "#6366f1", Icon = "M7 7h10M7 12h10M7 17h10" }
    };

    private class ChartData
    {
        public string Label { get; set; } = "";
        public int Value { get; set; }
    }

    private class Activity
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string Time { get; set; } = "";
        public string Color { get; set; } = "";
        public string Icon { get; set; } = "";
    }
}
