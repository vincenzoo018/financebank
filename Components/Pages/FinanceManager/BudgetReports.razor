@page "/finance/budget-reports"
@layout FinanceManagerLayout
@using FinanceBank.Services
@using FinanceBank.Models
@using FinanceBank.Data
@using System.Text
@inject FinanceService FinanceService
@inject AuthService AuthService
@inject IJSRuntime JS

<!-- Page Header -->
<div
    style="background: linear-gradient(135deg, #059669 0%, #047857 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
            </div>
            <div>
                <h1 style="font-size: 28px; font-weight: 700; color: white; margin: 0;">Budget Reports</h1>
                <p style="color: rgba(255,255,255,0.8); margin: 4px 0 0 0;">Generate and download budget vs actual
                    analysis reports</p>
            </div>
        </div>
    </div>
</div>

<!-- Report Configuration -->
<div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb; margin-bottom: 24px;">
    <h2 style="font-size: 18px; font-weight: 700; color: #111827; margin: 0 0 20px 0;">📊 Report Configuration</h2>

    <div
        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 24px;">
        <div>
            <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Report
                Period</label>
            <select @bind="reportPeriod" class="form-control">
                <option value="month">Current Month</option>
                <option value="quarter">Current Quarter</option>
                <option value="year">Current Year</option>
                <option value="custom">Custom Range</option>
            </select>
        </div>

        @if (reportPeriod == "custom")
        {
            <div>
                <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Start
                    Date</label>
                <input type="date" @bind="startDate" class="form-control" />
            </div>
            <div>
                <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">End
                    Date</label>
                <input type="date" @bind="endDate" class="form-control" />
            </div>
        }

        <div>
            <label
                style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Department
                Filter</label>
            <select @bind="filterDepartment" class="form-control">
                <option value="">All Departments</option>
                @foreach (var dept in departments)
                {
                    <option value="@dept">@dept</option>
                }
            </select>
        </div>

        <div>
            <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Report
                Format</label>
            <select @bind="reportFormat" class="form-control">
                <option value="pdf">PDF Document</option>
                <option value="csv">Excel (CSV)</option>
            </select>
        </div>
    </div>

    <div style="display: flex; gap: 12px;">
        <button @onclick="GenerateReport" disabled="@isGenerating"
            style="padding: 12px 24px; background: linear-gradient(135deg, #059669, #047857); color: white; border: none; border-radius: 10px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px;">
            @if (isGenerating)
            {
                <div class="spinner"></div>
                <span>Generating...</span>
            }
            else
            {
                <span>📥 Generate & Download Report</span>
            }
        </button>
        <button @onclick="PreviewReport"
            style="padding: 12px 24px; background: #f3f4f6; color: #374151; border: none; border-radius: 10px; font-weight: 600; cursor: pointer;">
            👁️ Preview Report
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div
        style="background: #d1fae5; border: 2px solid #6ee7b7; border-radius: 12px; padding: 16px; margin-bottom: 20px; color: #047857;">
        ✅ @successMessage
    </div>
}

<!-- Report Preview -->
@if (showPreview)
{
    <div
        style="background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden; margin-bottom: 24px;">
        <div
            style="background: linear-gradient(135deg, #059669, #047857); color: white; padding: 20px 24px; display: flex; justify-content: space-between; align-items: center;">
            <h2 style="margin: 0; font-size: 18px; font-weight: 600;">Budget vs Actual Report</h2>
            <span style="font-size: 14px; opacity: 0.9;">@GetPeriodLabel()</span>
        </div>

        <div style="padding: 24px;">
            <!-- Summary Cards -->
            <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px;">
                <div style="background: #f0fdf4; border-radius: 12px; padding: 16px; text-align: center;">
                    <div style="font-size: 12px; color: #047857; font-weight: 600; margin-bottom: 4px;">Total Allocated
                    </div>
                    <div style="font-size: 20px; font-weight: 700; color: #047857;">₱@reportBudgets.Sum(b =>
                                            b.AllocatedAmount).ToString("N2")</div>
            </div>
            <div style="background: #dbeafe; border-radius: 12px; padding: 16px; text-align: center;">
                <div style="font-size: 12px; color: #1e40af; font-weight: 600; margin-bottom: 4px;">Total Spent</div>
                <div style="font-size: 20px; font-weight: 700; color: #1e40af;">₱@reportBudgets.Sum(b =>
                                        b.SpentAmount).ToString("N2")</div>
            </div>
            <div style="background: #fef3c7; border-radius: 12px; padding: 16px; text-align: center;">
                <div style="font-size: 12px; color: #92400e; font-weight: 600; margin-bottom: 4px;">Total Remaining
                </div>
                <div style="font-size: 20px; font-weight: 700; color: #92400e;">₱@reportBudgets.Sum(b =>
                                        b.RemainingAmount).ToString("N2")</div>
            </div>
            <div
                style="background: @(overallUtilization > 100 ? "#fee2e2" : "#f0fdf4"); border-radius: 12px; padding: 16px; text-align: center;">
                <div
                    style="font-size: 12px; color: @(overallUtilization > 100 ? "#dc2626" : "#047857"); font-weight: 600; margin-bottom: 4px;">
                    Utilization</div>
                <div
                    style="font-size: 20px; font-weight: 700; color: @(overallUtilization > 100 ? "#dc2626" : "#047857");">
                    @overallUtilization.ToString("N1")%</div>
            </div>
        </div>

            <!-- Budget Table -->
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background: #f9fafb;">
                            <th
                                style="padding: 12px; text-align: left; font-weight: 600; color: #374151; border-bottom: 2px solid #e5e7eb;">
                                Budget Name</th>
                            <th
                                style="padding: 12px; text-align: left; font-weight: 600; color: #374151; border-bottom: 2px solid #e5e7eb;">
                                Department</th>
                            <th
                                style="padding: 12px; text-align: right; font-weight: 600; color: #374151; border-bottom: 2px solid #e5e7eb;">
                                Allocated</th>
                            <th
                                style="padding: 12px; text-align: right; font-weight: 600; color: #374151; border-bottom: 2px solid #e5e7eb;">
                                Spent</th>
                            <th
                                style="padding: 12px; text-align: right; font-weight: 600; color: #374151; border-bottom: 2px solid #e5e7eb;">
                                Variance</th>
                            <th
                                style="padding: 12px; text-align: center; font-weight: 600; color: #374151; border-bottom: 2px solid #e5e7eb;">
                                Status</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var budget in reportBudgets)
                        {
                            var utilization = budget.AllocatedAmount > 0 ? (budget.SpentAmount / budget.AllocatedAmount * 100) :
                            0;
                            var variance = budget.AllocatedAmount - budget.SpentAmount;
                            var isOverBudget = variance < 0;
                            <tr style="border-bottom: 1px solid #e5e7eb;">
                                <td style="padding: 12px; font-weight: 500;">@budget.BudgetName</td>
                                <td style="padding: 12px;">@budget.Department</td>
                                <td style="padding: 12px; text-align: right;">₱@budget.AllocatedAmount.ToString("N2")</td>
                                <td style="padding: 12px; text-align: right; color: @(isOverBudget ? "#dc2626" : "#111");">
                                    ₱@budget.SpentAmount.ToString("N2")</td>
                                <td
                                    style="padding: 12px; text-align: right; color: @(variance >= 0 ? "#047857" : "#dc2626"); font-weight: 600;">
                                    @(variance >= 0 ? "+" : "")₱@variance.ToString("N2")
                                </td>
                                <td style="padding: 12px; text-align: center;">
                                    @if (isOverBudget)
                                    {
                                        <span
                                            style="padding: 4px 12px; background: #fee2e2; color: #dc2626; border-radius: 20px; font-size: 12px; font-weight: 600;">Over
                                            Budget</span>
                                    }
                                    else if (utilization > 80)
                                    {
                                        <span
                                            style="padding: 4px 12px; background: #fef3c7; color: #92400e; border-radius: 20px; font-size: 12px; font-weight: 600;">At
                                            Risk</span>
                                    }
                                    else
                                    {
                                        <span
                                            style="padding: 4px 12px; background: #d1fae5; color: #047857; border-radius: 20px; font-size: 12px; font-weight: 600;">On
                                            Track</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Department Summary -->
            <div style="margin-top: 24px;">
                <h3 style="font-size: 16px; font-weight: 600; color: #111827; margin: 0 0 16px 0;">Department Summary</h3>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px;">
                    @foreach (var dept in reportBudgets.GroupBy(b => b.Department))
                    {
                        var deptAllocated = dept.Sum(b => b.AllocatedAmount);
                        var deptSpent = dept.Sum(b => b.SpentAmount);
                        var deptUtil = deptAllocated > 0 ? (deptSpent / deptAllocated * 100) : 0;

                        <div style="background: #f9fafb; border-radius: 12px; padding: 16px;">
                            <div style="font-size: 14px; font-weight: 600; color: #111827; margin-bottom: 8px;">@dept.Key</div>
                            <div style="font-size: 12px; color: #6b7280; margin-bottom: 4px;">Allocated:
                                ₱@deptAllocated.ToString("N2")</div>
                            <div style="font-size: 12px; color: #6b7280; margin-bottom: 8px;">Spent: ₱@deptSpent.ToString("N2")
                            </div>
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <div style="flex: 1; height: 6px; background: #e5e7eb; border-radius: 3px; overflow: hidden;">
                                    <div
                                        style="width: @(Math.Min(deptUtil, 100))%; height: 100%; background: @(deptUtil > 100 ? "#dc2626" : "#10b981");">
                                    </div>
                                </div>
                                <span style="font-size: 12px; font-weight: 600;">@deptUtil.ToString("N0")%</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- Report Tips -->
<div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
    <h2 style="font-size: 18px; font-weight: 700; color: #111827; margin: 0 0 20px 0;">📁 Report Tips</h2>

    <div style="display: grid; gap: 12px;">
        <div
            style="display: flex; align-items: flex-start; gap: 12px; padding: 16px; background: #f0fdf4; border-radius: 12px;">
            <span style="font-size: 20px;">💡</span>
            <div>
                <div style="font-weight: 600; color: #047857; margin-bottom: 4px;">Budget Variance Analysis</div>
                <div style="font-size: 13px; color: #065f46;">Review budgets with utilization above 80% to prevent
                    overspending before month-end.</div>
            </div>
        </div>
        <div
            style="display: flex; align-items: flex-start; gap: 12px; padding: 16px; background: #dbeafe; border-radius: 12px;">
            <span style="font-size: 20px;">📊</span>
            <div>
                <div style="font-weight: 600; color: #1e40af; margin-bottom: 4px;">Export Options</div>
                <div style="font-size: 13px; color: #1e3a8a;">PDF format is ideal for presentations. CSV/Excel format is
                    best for further data analysis.</div>
            </div>
        </div>
        <div
            style="display: flex; align-items: flex-start; gap: 12px; padding: 16px; background: #fef3c7; border-radius: 12px;">
            <span style="font-size: 20px;">🔔</span>
            <div>
                <div style="font-weight: 600; color: #92400e; margin-bottom: 4px;">Regular Monitoring</div>
                <div style="font-size: 13px; color: #78350f;">Generate weekly reports to catch budget issues early and
                    make timely adjustments.</div>
            </div>
        </div>
    </div>
</div>

<style>
    .spinner {
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

@code {
    private List<Budget> allBudgets = new();
    private List<Budget> reportBudgets = new();

    private string reportPeriod = "month";
    private DateTime startDate = DateTime.Today.AddMonths(-1);
    private DateTime endDate = DateTime.Today;
    private string filterDepartment = "";
    private string reportFormat = "pdf";

    private bool isGenerating = false;
    private bool showPreview = false;
    private string successMessage = "";

    private decimal overallUtilization => reportBudgets.Any() && reportBudgets.Sum(b => b.AllocatedAmount) > 0
            ? (reportBudgets.Sum(b => b.SpentAmount) / reportBudgets.Sum(b => b.AllocatedAmount) * 100)
    : 0;

    private List<string> departments => allBudgets.Select(b => b.Department).Distinct().OrderBy(d => d).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadBudgets();
    }

    private async Task LoadBudgets()
    {
        try
        {
            allBudgets = await FinanceService.GetAllBudgetsAsync();
            FilterBudgets();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading budgets: " + ex.Message);
        }
    }

    private void FilterBudgets()
    {
        var (start, end) = GetDateRange();

        reportBudgets = allBudgets
        .Where(b => b.Status == "Active" || (b.StartDate <= end && b.EndDate >= start))
        .Where(b => string.IsNullOrEmpty(filterDepartment) || b.Department == filterDepartment)
        .OrderBy(b => b.Department)
        .ThenBy(b => b.BudgetName)
        .ToList();
    }

    private (DateTime start, DateTime end) GetDateRange()
    {
        var today = DateTime.Today;
        return reportPeriod switch
        {
            "month" => (new DateTime(today.Year, today.Month, 1), today),
            "quarter" => (new DateTime(today.Year, ((today.Month - 1) / 3) * 3 + 1, 1), today),
            "year" => (new DateTime(today.Year, 1, 1), today),
            "custom" => (startDate, endDate),
            _ => (today.AddMonths(-1), today)
        };
    }

    private string GetPeriodLabel()
    {
        var (start, end) = GetDateRange();
        return start.ToString("MMM dd, yyyy") + " - " + end.ToString("MMM dd, yyyy");
    }

    private async Task PreviewReport()
    {
        FilterBudgets();
        showPreview = true;
        await Task.CompletedTask;
    }

    private async Task GenerateReport()
    {
        try
        {
            isGenerating = true;
            StateHasChanged();

            FilterBudgets();

            if (reportFormat == "csv")
            {
                await GenerateCsvReport();
            }
            else
            {
                await GeneratePdfReport();
            }

            successMessage = "Report generated and downloaded successfully!";
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error generating report: " + ex.Message);
        }
        finally
        {
            isGenerating = false;
            StateHasChanged();
        }
    }

    private async Task GenerateCsvReport()
    {
        var sb = new StringBuilder();

        sb.AppendLine("Budget vs Actual Report");
        sb.AppendLine("Period: " + GetPeriodLabel());
        sb.AppendLine("Generated: " + DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"));
        sb.AppendLine("Generated By: " + AuthService.CurrentUser);
        sb.AppendLine();

        sb.AppendLine("SUMMARY");
        sb.AppendLine("Total Allocated," + reportBudgets.Sum(b => b.AllocatedAmount).ToString("N2"));
        sb.AppendLine("Total Spent," + reportBudgets.Sum(b => b.SpentAmount).ToString("N2"));
        sb.AppendLine("Total Remaining," + reportBudgets.Sum(b => b.RemainingAmount).ToString("N2"));
        sb.AppendLine("Overall Utilization," + overallUtilization.ToString("N1") + "%");
        sb.AppendLine();

        sb.AppendLine("BUDGET DETAILS");
        sb.AppendLine("Budget Name,Department,Category,Allocated,Spent,Remaining,Utilization %,Status");

        foreach (var budget in reportBudgets)
        {
            var utilization = budget.AllocatedAmount > 0 ? (budget.SpentAmount / budget.AllocatedAmount * 100) : 0;
            var status = budget.SpentAmount > budget.AllocatedAmount ? "Over Budget" : utilization > 80 ? "At Risk" : "On Track";

            sb.AppendLine(string.Format("\"{0}\",\"{1}\",\"{2}\",{3},{4},{5},{6},{7}",
            budget.BudgetName,
            budget.Department,
            budget.Category,
            budget.AllocatedAmount.ToString("N2"),
            budget.SpentAmount.ToString("N2"),
            budget.RemainingAmount.ToString("N2"),
            utilization.ToString("N1"),
            status));
        }

        var content = sb.ToString();
        var fileName = "Budget_Report_" + DateTime.Now.ToString("yyyyMMdd_HHmmss") + ".csv";

        await DownloadFile(content, fileName, "text/csv");
    }

    private async Task GeneratePdfReport()
    {
        var sb = new StringBuilder();

        sb.Append("<!DOCTYPE html><html><head><meta charset='utf-8'><title>Budget Report</title>");
        sb.Append("<style>");
        sb.Append("body{font-family:'Segoe UI',Arial,sans-serif;margin:0;padding:40px;background:#fff;color:#111;}");
        sb.Append(".header{text-align:center;margin-bottom:40px;padding-bottom:20px;border-bottom:3px solid #f59e0b;}");
        sb.Append(".header h1{color:#d97706;margin:0 0 8px 0;font-size:28px;}");
        sb.Append(".header p{color:#6b7280;margin:0;font-size:14px;}");
        sb.Append(".summary{display:flex;justify-content:space-around;margin-bottom:40px;}");
        sb.Append(".summary-card{text-align:center;padding:20px;background:#f9fafb;border-radius:12px;min-width:150px;}");
        sb.Append(".summary-card .label{font-size:12px;color:#6b7280;margin-bottom:4px;}");
        sb.Append(".summary-card .value{font-size:24px;font-weight:700;}");
        sb.Append(".green{color:#047857;}.blue{color:#1e40af;}.orange{color:#d97706;}.red{color:#dc2626;}");
        sb.Append("table{width:100%;border-collapse:collapse;margin-top:20px;}");
        sb.Append("th{background:#f59e0b;color:white;padding:12px;text-align:left;font-size:12px;}");
        sb.Append("td{padding:10px 12px;border-bottom:1px solid #e5e7eb;font-size:13px;}");
        sb.Append("tr:nth-child(even){background:#f9fafb;}");
        sb.Append(".right{text-align:right;}.center{text-align:center;}");
        sb.Append(".footer{margin-top:40px;padding-top:20px;border-top:1px solid #e5e7eb;text-align:center;color:#6b7280;font-size:12px;}");
        sb.Append(".status{padding:4px 10px;border-radius:20px;font-size:11px;font-weight:600;}");
        sb.Append(".on-track{background:#d1fae5;color:#047857;}");
        sb.Append(".at-risk{background:#fef3c7;color:#92400e;}");
        sb.Append(".over{background:#fee2e2;color:#dc2626;}");
        sb.Append("</style></head><body>");

        sb.Append("<div class='header'>");
        sb.Append("<h1>Budget vs Actual Report</h1>");
        sb.Append("<p>Period: " + GetPeriodLabel() + "</p>");
        sb.Append("</div>");

        sb.Append("<div class='summary'>");
        sb.Append("<div class='summary-card'><div class='label'>Total Allocated</div><div class='value green'>P" +
        reportBudgets.Sum(b => b.AllocatedAmount).ToString("N2") + "</div></div>");
        sb.Append("<div class='summary-card'><div class='label'>Total Spent</div><div class='value blue'>P" +
        reportBudgets.Sum(b => b.SpentAmount).ToString("N2") + "</div></div>");
        sb.Append("<div class='summary-card'><div class='label'>Total Remaining</div><div class='value orange'>P" +
        reportBudgets.Sum(b => b.RemainingAmount).ToString("N2") + "</div></div>");
        var utilClass = overallUtilization > 100 ? "red" : "green";
        sb.Append("<div class='summary-card'><div class='label'>Utilization</div><div class='value " + utilClass + "'>" +
        overallUtilization.ToString("N1") + "%</div></div>");
        sb.Append("</div>");

        sb.Append("<h2>Budget Details</h2>");
        sb.Append("<table><thead><tr>");
        sb.Append("<th>Budget Name</th><th>Department</th><th>Category</th>");
        sb.Append("<th class='right'>Allocated</th><th class='right'>Spent</th><th class='right'>Variance</th>");
        sb.Append("<th class='center'>Utilization</th><th class='center'>Status</th>");
        sb.Append("</tr></thead><tbody>");

        foreach (var budget in reportBudgets)
        {
            var utilization = budget.AllocatedAmount > 0 ? (budget.SpentAmount / budget.AllocatedAmount * 100) : 0;
            var variance = budget.AllocatedAmount - budget.SpentAmount;
            var isOverBudget = variance < 0;
            var statusClass = isOverBudget ? "over" : utilization > 80 ? "at-risk" : "on-track";
            var statusText = isOverBudget ? "Over Budget" : utilization > 80 ? "At Risk" : "On Track";
            var spentColor = isOverBudget ? "#dc2626" : "#111";
            var varianceColor = variance >= 0 ? "#047857" : "#dc2626";
            var varianceSign = variance >= 0 ? "+" : "";

            sb.Append("<tr>");
            sb.Append("<td>" + budget.BudgetName + "</td>");
            sb.Append("<td>" + budget.Department + "</td>");
            sb.Append("<td>" + budget.Category + "</td>");
            sb.Append("<td class='right'>P" + budget.AllocatedAmount.ToString("N2") + "</td>");
            sb.Append("<td class='right' style='color:" + spentColor + ";'>P" + budget.SpentAmount.ToString("N2") + "</td>");
            sb.Append("<td class='right' style='color:" + varianceColor + ";'>" + varianceSign + "P" + variance.ToString("N2") +
            "</td>");
            sb.Append("<td class='center'>" + utilization.ToString("N0") + "%</td>");
            sb.Append("<td class='center'><span class='status " + statusClass + "'>" + statusText + "</span></td>");
            sb.Append("</tr>");
        }

        sb.Append("</tbody></table>");

        sb.Append("<div class='footer'>");
        sb.Append("<p>Generated on " + DateTime.Now.ToString("MMMM dd, yyyy") + " at " + DateTime.Now.ToString("hh:mm tt") + " by " + AuthService.CurrentUser + "</p>");
        sb.Append("<p>FinanceBank Budget Management System</p>");
        sb.Append("</div>");

        sb.Append("</body></html>");

        var content = sb.ToString();
        var fileName = "Budget_Report_" + DateTime.Now.ToString("yyyyMMdd_HHmmss") + ".html";

        await DownloadFile(content, fileName, "text/html");
    }

    private async Task DownloadFile(string content, string fileName, string mimeType)
    {
        var bytes = System.Text.Encoding.UTF8.GetBytes(content);
        var base64 = Convert.ToBase64String(bytes);

        await JS.InvokeVoidAsync("eval",
        "var link = document.createElement('a');" +
        "link.href = 'data:" + mimeType + ";base64," + base64 + "';" +
        "link.download = '" + fileName + "';" +
        "document.body.appendChild(link);" +
        "link.click();" +
        "document.body.removeChild(link);");
    }
}