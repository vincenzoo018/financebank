@page "/admin/finance/expenses"
@layout FinanceManagerLayout
@using FinanceBank.Services
@using FinanceBank.Models
@inject AuthService AuthService

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #059669 0%, #047857 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
            <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="1"/>
                <path d="M19.07 4.93l-2.58 2.58A8 8 0 1 0 20.5 12z"/>
            </svg>
        </div>
        <div>
            <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Expenses</h1>
            <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Track and manage business expenses</p>
        </div>
    </div>
</div>

<!-- Summary Cards -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 24px;">
    <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb;">
        <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 8px;">Total This Month</div>
        <div style="font-size: 32px; font-weight: 700; color: #f59e0b; margin-bottom: 4px;">₱@totalThisMonth.ToString("N2")</div>
        <div style="font-size: 12px; color: #6b7280;">@expenseCount expenses</div>
    </div>
    <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb;">
        <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 8px;">Pending Approval</div>
        <div style="font-size: 32px; font-weight: 700; color: #dc2626; margin-bottom: 4px;">₱@pendingAmount.ToString("N2")</div>
        <div style="font-size: 12px; color: #6b7280;">@pendingCount awaiting approval</div>
    </div>
    <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb;">
        <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 8px;">Approved</div>
        <div style="font-size: 32px; font-weight: 700; color: #10b981; margin-bottom: 4px;">₱@approvedAmount.ToString("N2")</div>
        <div style="font-size: 12px; color: #6b7280;">@approvedCount approved</div>
    </div>
</div>

<!-- Expenses Table -->
<div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h2 style="font-size: 18px; font-weight: 600; color: #111827; margin: 0;">Expense Records</h2>
        <button class="btn" style="background: #059669; color: white; padding: 10px 18px; border-radius: 8px; font-size: 14px; font-weight: 600;" @onclick="ShowNewExpenseModal">+ New Expense</button>
    </div>

    <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background: #f9fafb; border-bottom: 1px solid #e5e7eb;">
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">DATE</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">CATEGORY</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">DESCRIPTION</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">AMOUNT</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">STATUS</th>
                    <th style="padding: 12px; text-align: center; font-size: 12px; color: #6b7280;">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @if (expenses.Any())
                {
                    @foreach (var expense in expenses.OrderByDescending(e => e.Date))
                    {
                        <tr style="border-bottom: 1px solid #e5e7eb;">
                            <td style="padding: 12px; font-size: 13px; color: #111827;">@expense.Date.ToString("yyyy-MM-dd")</td>
                            <td style="padding: 12px; font-size: 13px; color: #4b5563;">@expense.Category</td>
                            <td style="padding: 12px; font-size: 13px; color: #4b5563;">@expense.Description</td>
                            <td style="padding: 12px; font-size: 13px; color: #111827; font-weight: 600;">₱@expense.Amount.ToString("N2")</td>
                            <td style="padding: 12px;">
                                <span style="display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; background: @GetStatusBg(expense.Status); color: @GetStatusColor(expense.Status);">
                                    @expense.Status
                                </span>
                            </td>
                            <td style="padding: 12px; text-align: center;">
                                @if (expense.Status == "Pending")
                                {
                                    <button class="btn" style="background: #059669; color: white; padding: 6px 12px; font-size: 12px; border-radius: 6px; font-weight: 600;" @onclick="() => EditExpense(expense)">Edit</button>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="padding: 24px; text-align: center; font-size: 14px; color: #6b7280;">No expenses found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<Expense> expenses = new();
    private decimal totalThisMonth = 0;
    private decimal pendingAmount = 0;
    private decimal approvedAmount = 0;
    private int expenseCount = 0;
    private int pendingCount = 0;
    private int approvedCount = 0;

    protected override void OnInitialized()
    {
        LoadExpenses();
    }

    private void LoadExpenses()
    {
        // TODO: Load from service
        expenses = new List<Expense>();
        CalculateStats();
    }

    private void CalculateStats()
    {
        var today = DateTime.Today;
        var monthStart = new DateTime(today.Year, today.Month, 1);
        var monthEnd = monthStart.AddMonths(1).AddDays(-1);

        totalThisMonth = expenses.Where(e => e.Date >= monthStart && e.Date <= monthEnd).Sum(e => e.Amount);
        expenseCount = expenses.Count(e => e.Date >= monthStart && e.Date <= monthEnd);
        pendingAmount = expenses.Where(e => e.Status == "Pending").Sum(e => e.Amount);
        pendingCount = expenses.Count(e => e.Status == "Pending");
        approvedAmount = expenses.Where(e => e.Status == "Approved").Sum(e => e.Amount);
        approvedCount = expenses.Count(e => e.Status == "Approved");
    }

    private string GetStatusBg(string status)
    {
        return status switch
        {
            "Approved" => "#d1fae5",
            "Pending" => "#fef3c7",
            "Rejected" => "#fee2e2",
            _ => "#f3f4f6"
        };
    }

    private string GetStatusColor(string status)
    {
        return status switch
        {
            "Approved" => "#065f46",
            "Pending" => "#92400e",
            "Rejected" => "#b91c1c",
            _ => "#4b5563"
        };
    }

    private void ShowNewExpenseModal()
    {
        // TODO: Implement new expense modal
    }

    private void EditExpense(Expense expense)
    {
        // TODO: Implement edit expense modal
    }

    private class Expense
    {
        public int Id { get; set; }
        public DateTime Date { get; set; }
        public string Category { get; set; } = "";
        public string Description { get; set; } = "";
        public decimal Amount { get; set; }
        public string Status { get; set; } = "Pending";
    }
}
