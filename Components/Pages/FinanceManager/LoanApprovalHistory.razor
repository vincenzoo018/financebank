@page "/financemanager/loan-history"
@layout FinanceManagerLayout
@using FinanceBank.Models
@using FinanceBank.Services
@using Microsoft.EntityFrameworkCore
@inject LoanProcessService LoanService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="sidebar-content">
    <div class="card">
        <div class="card-header">
            <h1 class="modal-title">Loan Approval History</h1>
            <p class="modal-subtitle">Review of all approved and declined loan applications</p>
        </div>

        <div class="card-body" style="padding: 24px;">
            <!-- Filter Tabs -->
            <div style="display: flex; gap: 12px; margin-bottom: 24px;">
                <button class="btn @(filterStatus == "ALL" ? "btn-primary" : "btn-outline")" 
                        @onclick="@(() => SetFilter(@"ALL"))">
                    All History
                </button>
                <button class="btn @(filterStatus == "APPROVED" ? "btn-success" : "btn-outline")" 
                        @onclick="@(() => SetFilter(@"APPROVED"))">
                    ✓ Approved
                </button>
                <button class="btn @(filterStatus == "DECLINED" ? "btn-danger" : "btn-outline")" 
                        @onclick="@(() => SetFilter(@"DECLINED"))">
                    ✗ Declined
                </button>
            </div>

            @if (isLoading)
            {
                <div style="text-align: center; padding: 40px;">
                    <div class="loading-spinner"></div>
                    <p>Loading approval history...</p>
                </div>
            }
            else if (!filteredApprovals.Any())
            {
                <div style="text-align: center; padding: 40px;">
                    <p style="color: var(--text-gray);">No approval history found.</p>
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    @foreach (var approval in filteredApprovals)
                    {
                        var customer = approval.Assessment?.Application?.Account?.Customer;
                        var customerName = customer?.FullName ?? "N/A";
                        var accountNumber = approval.Assessment?.Application?.Account?.AccountNumber ?? "N/A";
                        var loanType = approval.Assessment?.Application?.LoanType ?? "N/A";
                        var isApproved = approval.ApprovalStatus == "APPROVED";

                        <div class="card" style="border: 2px solid @(isApproved ? "#22c55e" : "#ef4444");">
                            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                                <div style="flex: 1;">
                                    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                                        <span style="background: @(isApproved ? "#dcfce7" : "#fee2e2"); 
                                                     color: @(isApproved ? "#166534" : "#dc2626");
                                                     padding: 4px 12px; border-radius: 20px; 
                                                     font-size: 12px; font-weight: 700;">
                                            @(isApproved ? "✓ APPROVED" : "✗ DECLINED")
                                        </span>
                                        <span style="font-size: 13px; color: var(--text-gray);">
                                            @approval.ApprovalDate.ToString("MMMM dd, yyyy hh:mm tt")
                                        </span>
                                    </div>

                                    <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 8px;">
                                        @customerName
                                    </h3>
                                    
                                    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 12px;">
                                        <div>
                                            <span style="font-size: 12px; color: var(--text-gray); display: block;">Account</span>
                                            <span style="font-size: 14px; font-weight: 600;">@accountNumber</span>
                                        </div>
                                        <div>
                                            <span style="font-size: 12px; color: var(--text-gray); display: block;">Loan Type</span>
                                            <span style="font-size: 14px; font-weight: 600;">@loanType</span>
                                        </div>
                                        <div>
                                            <span style="font-size: 12px; color: var(--text-gray); display: block;">
                                                @(isApproved ? "Approved Amount" : "Requested Amount")
                                            </span>
                                            <span style="font-size: 14px; font-weight: 600; color: var(--primary-green-start);">
                                                ₱@((approval.ApprovedAmount ?? approval.Assessment?.LoanAmount ?? 0).ToString("N2"))
                                            </span>
                                        </div>
                                        <div>
                                            <span style="font-size: 12px; color: var(--text-gray); display: block;">Processed By</span>
                                            <span style="font-size: 14px; font-weight: 600;">@approval.ApprovedBy</span>
                                        </div>
                                    </div>

                                    @if (isApproved)
                                    {
                                        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;">
                                            <div>
                                                <span style="font-size: 12px; color: var(--text-gray); display: block;">Interest Rate</span>
                                                <span style="font-size: 14px; font-weight: 600;">@(approval.ApprovedInterestRate?.ToString("F2") ?? "N/A")%</span>
                                            </div>
                                            <div>
                                                <span style="font-size: 12px; color: var(--text-gray); display: block;">Term</span>
                                                <span style="font-size: 14px; font-weight: 600;">@(approval.ApprovedTermMonths ?? 0) months</span>
                                            </div>
                                            <div>
                                                <span style="font-size: 12px; color: var(--text-gray); display: block;">Monthly Payment</span>
                                                <span style="font-size: 14px; font-weight: 600;">
                                                    @if (approval.Assessment != null)
                                                    {
                                                        <text>₱@approval.Assessment.ComputedMonthlyPayment.ToString("N2")</text>
                                                    }
                                                    else
                                                    {
                                                        <text>N/A</text>
                                                    }
                                                </span>
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(approval.SpecialConditions))
                                        {
                                            <div style="background: #dbeafe; border-radius: 6px; padding: 12px; margin-top: 12px;">
                                                <span style="font-size: 12px; color: #1e40af; font-weight: 600;">Special Conditions:</span>
                                                <p style="margin: 4px 0 0; font-size: 14px; color: #1e40af;">@approval.SpecialConditions</p>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div style="background: #fee2e2; border-radius: 6px; padding: 12px; margin-top: 12px;">
                                            <span style="font-size: 12px; color: #dc2626; font-weight: 600;">Reason for Declination:</span>
                                            <p style="margin: 4px 0 0; font-size: 14px; color: #dc2626;">
                                                @(approval.DeclinationReason ?? "No reason provided")
                                            </p>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<style>
    .btn-success {
        background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
        color: white;
        border: none;
    }
    
    .btn-danger {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: white;
        border: none;
    }
    
    .btn-outline {
        background: transparent;
        border: 2px solid var(--border);
        color: var(--text-dark);
    }
    
    .btn-outline:hover {
        border-color: var(--primary-green-start);
        color: var(--primary-green-start);
    }
</style>

@code {
    private List<LoanApproval> allApprovals = new();
    private List<LoanApproval> filteredApprovals = new();
    private string filterStatus = "ALL";
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadApprovalHistory();
    }

    private async Task LoadApprovalHistory()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            allApprovals = await LoanService.GetApprovalHistoryAsync();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error loading history: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void SetFilter(string status)
    {
        filterStatus = status;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        filteredApprovals = filterStatus switch
        {
            "APPROVED" => allApprovals.Where(a => a.ApprovalStatus == "APPROVED").ToList(),
            "DECLINED" => allApprovals.Where(a => a.ApprovalStatus == "DECLINED").ToList(),
            _ => allApprovals
        };
    }
}
