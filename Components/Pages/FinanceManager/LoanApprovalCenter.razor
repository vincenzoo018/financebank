    private string GetCreditScoreColor(int score)
    {
        return score switch
        {
            >= 750 => "#5F6F52", // Excellent - Green
            >= 700 => "#5F6F52", // Good - Light Green
            >= 650 => "#8B5A2B", // Fair - Brown
            >= 600 => "#A67C4A", // Poor - Light Brown
            _ => "#9B3A3A"       // Very Poor - Olive Red
        };
    }

    private string GetDTIColor(decimal dti)
    {
        return dti switch
        {
            <= 20 => "#5F6F52",  // Excellent
            <= 35 => "#5F6F52",  // Good
            <= 43 => "#8B5A2B",  // Acceptable
            <= 50 => "#A67C4A",  // High
            _ => "#9B3A3A"       // Very High
        };
    }

    private string GetRiskColor(string riskCategory)
    {
        return riskCategory?.ToUpper() switch
        {
            "LOW" => "#5F6F52",
            "MEDIUM" => "#8B5A2B",
            "HIGH" => "#A67C4A",
            "VERY_HIGH" => "#9B3A3A",
            _ => "#6b7280"
        };
    }

    private string GetRecommendationColor(string recommendation)
    {
        return recommendation?.ToUpper() switch
        {
            "STRONGLY_RECOMMEND" => "#5F6F52",
            "RECOMMEND" => "#5F6F52",
            "CONDITIONAL" => "#8B5A2B",
            "NOT_RECOMMEND" => "#9B3A3A",
            _ => "#6b7280"
        };
    }

    private void ShowToast(string message, string type)
    {
        toastMessage = message;
        toastType = type;
        showToast = true;
        _ = HideToastAfterDelay();
    }

    private async Task HideToastAfterDelay()
    {
        await Task.Delay(4000);
        showToast = false;
        await InvokeAsync(StateHasChanged);
    }
}
