@page "/finance/budget-management"
@layout FinanceManagerLayout
@using FinanceBank.Services
@using FinanceBank.Models
@using Microsoft.EntityFrameworkCore
@inject FinanceService FinanceService
@inject AuthService AuthService
@inject BFASDbContext DbContext

<div style="padding: 24px; max-width: 1400px; margin: 0 auto;">
    <!-- Page Header -->
    <div style="background: linear-gradient(135deg, #059669 0%, #047857 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                <rect x="2" y="3" width="20" height="18" rx="2" ry="2"></rect>
                <line x1="2" y1="9" x2="22" y2="9"></line>
                <line x1="9" y1="21" x2="9" y2="9"></line>
            </svg>
        </div>
        <div>
            <h1 style="font-size: 28px; font-weight: 700; color: white; margin: 0;">Budget Management</h1>
            <p style="color: rgba(255,255,255,0.8); margin: 4px 0 0 0;">Create, allocate, and track departmental budgets
            </p>
        </div>
    </div>
</div>

<!-- Summary Cards -->
<div
    style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 24px;">
    <div
        style="background: linear-gradient(135deg, #ecfdf5, #d1fae5); border-radius: 16px; padding: 24px; border: 2px solid #6ee7b7;">
        <div style="font-size: 13px; color: #047857; font-weight: 600; margin-bottom: 8px; text-transform: uppercase;">
            💰 Total Allocated</div>
        <div style="font-size: 28px; font-weight: 700; color: #047857;">₱@totalAllocated.ToString("N2")</div>
        <div style="font-size: 12px; color: #059669; margin-top: 4px;">@activeBudgets.Count active budgets</div>
    </div>
    <div
        style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); border-radius: 16px; padding: 24px; border: 2px solid #6ee7b7;">
        <div style="font-size: 13px; color: #047857; font-weight: 600; margin-bottom: 8px; text-transform: uppercase;">
            📊 Total Spent</div>
        <div style="font-size: 28px; font-weight: 700; color: #047857;">₱@totalSpent.ToString("N2")</div>
        <div style="font-size: 12px; color: #059669; margin-top: 4px;">@((totalAllocated > 0 ? (totalSpent /
                        totalAllocated * 100) : 0).ToString("N1"))% utilized</div>
    </div>
    <div
        style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); border-radius: 16px; padding: 24px; border: 2px solid #6ee7b7;">
        <div style="font-size: 13px; color: #047857; font-weight: 600; margin-bottom: 8px; text-transform: uppercase;">
            💵 Remaining</div>
        <div style="font-size: 28px; font-weight: 700; color: #047857;">₱@totalRemaining.ToString("N2")</div>
        <div style="font-size: 12px; color: #059669; margin-top: 4px;">Available for spending</div>
    </div>
    <div
        style="background: linear-gradient(135deg, #f0fdf4, #dcfce7); border-radius: 16px; padding: 24px; border: 2px solid #86efac;">
        <div style="font-size: 13px; color: #047857; font-weight: 600; margin-bottom: 8px; text-transform: uppercase;">
            ⚠️ Over Budget</div>
        <div style="font-size: 28px; font-weight: 700; color: #047857;">@overBudgetCount</div>
        <div style="font-size: 12px; color: #059669; margin-top: 4px;">Budgets exceeded</div>
    </div>
</div>

<!-- Action Bar -->
<div
    style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 12px;">
    <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <select @bind="filterDepartment" class="form-control" style="width: 180px;">
            <option value="">All Departments</option>
            @foreach (var dept in departments)
            {
                <option value="@dept">@dept</option>
            }
        </select>
        <select @bind="filterCategory" class="form-control" style="width: 180px;">
            <option value="">All Categories</option>
            @foreach (var cat in categories)
            {
                <option value="@cat">@cat</option>
            }
        </select>
        <select @bind="filterStatus" class="form-control" style="width: 150px;">
            <option value="">All Status</option>
            <option value="Active">Active</option>
            <option value="Closed">Closed</option>
            <option value="Draft">Draft</option>
        </select>
    </div>
    <button class="btn btn-primary"
        style="background: linear-gradient(135deg, #059669, #047857); border: none; padding: 12px 24px; border-radius: 10px; font-weight: 600;"
        @onclick="ShowAddModal">
        + Create Budget
    </button>
</div>

<!-- Alerts -->
@if (!string.IsNullOrEmpty(successMessage))
{
    <div
        style="background: #d1fae5; border: 2px solid #6ee7b7; border-radius: 12px; padding: 16px; margin-bottom: 20px; color: #047857;">
        ✅ @successMessage
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div
        style="background: #fee2e2; border: 2px solid #fca5a5; border-radius: 12px; padding: 16px; margin-bottom: 20px; color: #b91c1c;">
        ❌ @errorMessage
    </div>
}

<!-- Budgets Table -->
<div style="background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden;">
    <div style="background: linear-gradient(135deg, #059669, #10b981); color: white; padding: 20px 24px;">
        <h2 style="margin: 0; font-size: 18px; font-weight: 600;">Budget Allocations</h2>
    </div>

    <div style="padding: 24px;">
        @if (isLoading)
        {
            <div style="display: flex; justify-content: center; padding: 40px;">
                <div
                    style="width: 40px; height: 40px; border: 4px solid #e5e7eb; border-top-color: #059669; border-radius: 50%; animation: spin 1s linear infinite;">
                </div>
            </div>
        }
        else if (!FilteredBudgets.Any())
        {
            <div style="text-align: center; padding: 40px; color: #6b7280;">
                <p>No budgets found. Create your first budget to get started.</p>
            </div>
        }
        else
        {
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background: #f3f4f6;">
                            <th
                                style="padding: 14px; text-align: left; font-weight: 600; color: #374151; border-bottom: 2px solid #e5e7eb;">
                                Budget Name</th>
                            <th
                                style="padding: 14px; text-align: left; font-weight: 600; color: #374151; border-bottom: 2px solid #e5e7eb;">
                                Department</th>
                            <th
                                style="padding: 14px; text-align: left; font-weight: 600; color: #374151; border-bottom: 2px solid #e5e7eb;">
                                Category</th>
                            <th
                                style="padding: 14px; text-align: right; font-weight: 600; color: #374151; border-bottom: 2px solid #e5e7eb;">
                                Allocated</th>
                            <th
                                style="padding: 14px; text-align: right; font-weight: 600; color: #374151; border-bottom: 2px solid #e5e7eb;">
                                Spent</th>
                            <th
                                style="padding: 14px; text-align: right; font-weight: 600; color: #374151; border-bottom: 2px solid #e5e7eb;">
                                Remaining</th>
                            <th
                                style="padding: 14px; text-align: center; font-weight: 600; color: #374151; border-bottom: 2px solid #e5e7eb;">
                                Utilization</th>
                            <th
                                style="padding: 14px; text-align: center; font-weight: 600; color: #374151; border-bottom: 2px solid #e5e7eb;">
                                Period</th>
                            <th
                                style="padding: 14px; text-align: center; font-weight: 600; color: #374151; border-bottom: 2px solid #e5e7eb;">
                                Status</th>
                            <th
                                style="padding: 14px; text-align: center; font-weight: 600; color: #374151; border-bottom: 2px solid #e5e7eb;">
                                Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var budget in FilteredBudgets)
                        {
                            var utilization = budget.AllocatedAmount > 0 ? (budget.SpentAmount / budget.AllocatedAmount * 100) :
                            0;
                            var isOverBudget = budget.SpentAmount > budget.AllocatedAmount;
                            <tr style="border-bottom: 1px solid #e5e7eb;">
                                <td style="padding: 14px;">
                                    <div style="font-weight: 600; color: #111827;">@budget.BudgetName</div>
                                    @if (!string.IsNullOrEmpty(budget.Description))
                                    {
                                        <div style="font-size: 12px; color: #6b7280; margin-top: 2px;">@(budget.Description.Length >
                                                                            50 ? budget.Description.Substring(0, 50) + "..." : budget.Description)</div>
                                    }
                                </td>
                                <td style="padding: 14px;">
                                    <span
                                        style="background: #dbeafe; color: #1e40af; padding: 4px 10px; border-radius: 6px; font-size: 12px; font-weight: 600;">@budget.Department</span>
                                </td>
                                <td style="padding: 14px; color: #374151;">@budget.Category</td>
                                <td style="padding: 14px; text-align: right; font-weight: 600; color: #047857;">
                                    ₱@budget.AllocatedAmount.ToString("N2")</td>
                                <td
                                    style="padding: 14px; text-align: right; font-weight: 600; color: @(isOverBudget ? "#dc2626" : "#374151");">
                                    ₱@budget.SpentAmount.ToString("N2")</td>
                                <td
                                    style="padding: 14px; text-align: right; font-weight: 600; color: @(budget.RemainingAmount < 0 ? "#dc2626" : "#047857");">
                                    ₱@budget.RemainingAmount.ToString("N2")</td>
                                <td style="padding: 14px; text-align: center;">
                                    <div style="display: flex; flex-direction: column; align-items: center; gap: 4px;">
                                        <div
                                            style="width: 80px; height: 8px; background: #e5e7eb; border-radius: 4px; overflow: hidden;">
                                            <div
                                                style="width: @(Math.Min(utilization, 100))%; height: 100%; background: @(utilization > 100 ? "#dc2626" : utilization > 80 ? "#f59e0b" : "#059669"); border-radius: 4px;">
                                            </div>
                                        </div>
                                        <span
                                            style="font-size: 11px; font-weight: 600; color: @(utilization > 100 ? "#dc2626" : utilization > 80 ? "#b45309" : "#047857");">@utilization.ToString("N1")%</span>
                                    </div>
                                </td>
                                <td style="padding: 14px; text-align: center; font-size: 12px; color: #6b7280;">
                                    @budget.StartDate.ToString("MMM dd") - @budget.EndDate.ToString("MMM dd, yyyy")
                                </td>
                                <td style="padding: 14px; text-align: center;">
                                    <span
                                        style="padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; @GetStatusStyle(budget.Status)">@budget.Status</span>
                                </td>
                                <td style="padding: 14px; text-align: center;">
                                    <div style="display: flex; gap: 8px; justify-content: center;">
                                        <button @onclick="() => EditBudget(budget)"
                                            style="padding: 6px 12px; background: #f3f4f6; border: none; border-radius: 6px; cursor: pointer; font-size: 12px;">Edit</button>
                                        <button @onclick="() => ShowRecordSpendingModal(budget)"
                                            style="padding: 6px 12px; background: #dbeafe; color: #1e40af; border: none; border-radius: 6px; cursor: pointer; font-size: 12px;">Record</button>
                                        <button @onclick="() => DeleteBudget(budget.BudgetId)"
                                            style="padding: 6px 12px; background: #fee2e2; color: #dc2626; border: none; border-radius: 6px; cursor: pointer; font-size: 12px;">Delete</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Add/Edit Budget Modal -->
@if (showModal)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.6); display: flex; align-items: center; justify-content: center; z-index: 1000; backdrop-filter: blur(4px);"
        @onclick="CloseModal">
        <div style="background: white; border-radius: 20px; width: 90%; max-width: 600px; max-height: 90vh; overflow-y: auto; box-shadow: 0 25px 50px rgba(0,0,0,0.25);"
            @onclick:stopPropagation>
            <div style="background: linear-gradient(135deg, #059669, #047857); padding: 24px; color: white;">
                <h2 style="margin: 0; font-size: 20px; font-weight: 700;">@(isEditing ? "Edit Budget" : "Create New Budget")
                </h2>
            </div>

            <div style="padding: 24px;">
                <div style="display: grid; gap: 20px;">
                    <div>
                        <label
                            style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Budget
                            Name *</label>
                        <input type="text" @bind="editBudget.BudgetName" class="form-control"
                            placeholder="e.g., Q1 Marketing Budget" />
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                        <div>
                            <label
                                style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Department
                                *</label>
                            <select @bind="editBudget.Department" class="form-control">
                                <option value="">Select Department</option>
                                <option value="Operations">Operations</option>
                                <option value="IT">IT</option>
                                <option value="Marketing">Marketing</option>
                                <option value="Human Resources">Human Resources</option>
                                <option value="Finance">Finance</option>
                                <option value="Administration">Administration</option>
                                <option value="Loan Department">Loan Department</option>
                            </select>
                        </div>
                        <div>
                            <label
                                style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Category
                                *</label>
                            <select @bind="editBudget.Category" class="form-control">
                                <option value="">Select Category</option>
                                <option value="Salaries">Salaries</option>
                                <option value="Utilities">Utilities</option>
                                <option value="Equipment">Equipment</option>
                                <option value="Supplies">Supplies</option>
                                <option value="Maintenance">Maintenance</option>
                                <option value="Training">Training</option>
                                <option value="Travel">Travel</option>
                                <option value="Marketing">Marketing</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label
                            style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Allocated
                            Amount *</label>
                        <div style="position: relative;">
                            <span
                                style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #6b7280;">₱</span>
                            <input type="number" @bind="editBudget.AllocatedAmount" class="form-control"
                                style="padding-left: 30px;" placeholder="0.00" step="0.01" />
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                        <div>
                            <label
                                style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Start
                                Date *</label>
                            <input type="date" @bind="editBudget.StartDate" class="form-control" />
                        </div>
                        <div>
                            <label
                                style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">End
                                Date *</label>
                            <input type="date" @bind="editBudget.EndDate" class="form-control" />
                        </div>
                    </div>

                    <div>
                        <label
                            style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Status</label>
                        <select @bind="editBudget.Status" class="form-control">
                            <option value="Active">Active</option>
                            <option value="Draft">Draft</option>
                            <option value="Closed">Closed</option>
                        </select>
                    </div>

                    <div>
                        <label
                            style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Description</label>
                        <textarea @bind="editBudget.Description" class="form-control" rows="3"
                            placeholder="Budget description or notes..."></textarea>
                    </div>
                </div>

                <div style="display: flex; gap: 12px; margin-top: 24px;">
                    <button @onclick="SaveBudget"
                        style="flex: 1; padding: 14px; background: linear-gradient(135deg, #059669, #047857); color: white; border: none; border-radius: 10px; font-weight: 600; cursor: pointer;">
                        @(isEditing ? "Update Budget" : "Create Budget")
                    </button>
                    <button @onclick="CloseModal"
                        style="padding: 14px 24px; background: #f3f4f6; color: #374151; border: none; border-radius: 10px; font-weight: 600; cursor: pointer;">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Record Spending Modal -->
@if (showRecordModal && selectedBudget != null)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.6); display: flex; align-items: center; justify-content: center; z-index: 1000; backdrop-filter: blur(4px);"
        @onclick="CloseRecordModal">
        <div style="background: white; border-radius: 20px; width: 90%; max-width: 500px; box-shadow: 0 25px 50px rgba(0,0,0,0.25);"
            @onclick:stopPropagation>
            <div style="background: linear-gradient(135deg, #059669, #047857); padding: 24px; color: white;">
                <h2 style="margin: 0; font-size: 20px; font-weight: 700;">Record Spending</h2>
                <p style="margin: 4px 0 0 0; opacity: 0.9; font-size: 14px;">@selectedBudget.BudgetName</p>
            </div>

            <div style="padding: 24px;">
                <div style="background: #f3f4f6; border-radius: 12px; padding: 16px; margin-bottom: 20px;">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                        <span style="color: #6b7280;">Allocated:</span>
                        <span style="font-weight: 600;">₱@selectedBudget.AllocatedAmount.ToString("N2")</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                        <span style="color: #6b7280;">Already Spent:</span>
                        <span style="font-weight: 600;">₱@selectedBudget.SpentAmount.ToString("N2")</span>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: #6b7280;">Available:</span>
                        <span
                            style="font-weight: 600; color: #047857;">₱@selectedBudget.RemainingAmount.ToString("N2")</span>
                    </div>
                </div>

                <div style="margin-bottom: 20px;">
                    <label
                        style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Spending
                        Amount *</label>
                    <div style="position: relative;">
                        <span
                            style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #6b7280;">₱</span>
                        <input type="number" @bind="spendingAmount" class="form-control" style="padding-left: 30px;"
                            placeholder="0.00" step="0.01" />
                    </div>
                </div>

                <div style="margin-bottom: 20px;">
                    <label
                        style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Description</label>
                    <input type="text" @bind="spendingDescription" class="form-control"
                        placeholder="What was this spending for?" />
                </div>

                <div style="display: flex; gap: 12px;">
                    <button @onclick="RecordSpending"
                        style="flex: 1; padding: 14px; background: linear-gradient(135deg, #059669, #047857); color: white; border: none; border-radius: 10px; font-weight: 600; cursor: pointer;">
                        Record Spending
                    </button>
                    <button @onclick="CloseRecordModal"
                        style="padding: 14px 24px; background: #f3f4f6; color: #374151; border: none; border-radius: 10px; font-weight: 600; cursor: pointer;">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>
</div>

@code {
    private List<Budget> budgets = new();
    private List<Budget> activeBudgets => budgets.Where(b => b.Status == "Active").ToList();
    private Budget editBudget = new();
    private Budget? selectedBudget;

    private bool showModal = false;
    private bool showRecordModal = false;
    private bool isEditing = false;
    private bool isLoading = true;

    private string successMessage = "";
    private string errorMessage = "";

    private string filterDepartment = "";
    private string filterCategory = "";
    private string filterStatus = "";

    private decimal spendingAmount = 0;
    private string spendingDescription = "";

    private decimal totalAllocated => activeBudgets.Sum(b => b.AllocatedAmount);
    private decimal totalSpent => activeBudgets.Sum(b => b.SpentAmount);
    private decimal totalRemaining => activeBudgets.Sum(b => b.RemainingAmount);
    private int overBudgetCount => activeBudgets.Count(b => b.SpentAmount > b.AllocatedAmount);

    private List<string> departments => budgets.Select(b => b.Department).Distinct().OrderBy(d => d).ToList();
    private List<string> categories => budgets.Select(b => b.Category).Distinct().OrderBy(c => c).ToList();

    private IEnumerable<Budget> FilteredBudgets => budgets
    .Where(b => string.IsNullOrEmpty(filterDepartment) || b.Department == filterDepartment)
    .Where(b => string.IsNullOrEmpty(filterCategory) || b.Category == filterCategory)
    .Where(b => string.IsNullOrEmpty(filterStatus) || b.Status == filterStatus)
    .OrderByDescending(b => b.CreatedAt);

    protected override async Task OnInitializedAsync()
    {
        await LoadBudgets();
    }

    private async Task LoadBudgets()
    {
        try
        {
            isLoading = true;
            budgets = await FinanceService.GetAllBudgetsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading budgets: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowAddModal()
    {
        editBudget = new Budget
        {
            StartDate = DateTime.Today,
            EndDate = DateTime.Today.AddMonths(1),
            Status = "Active",
            CreatedBy = AuthService.CurrentUser
        };
        isEditing = false;
        showModal = true;
        ClearMessages();
    }

    private void EditBudget(Budget budget)
    {
        editBudget = new Budget
        {
            BudgetId = budget.BudgetId,
            BudgetName = budget.BudgetName,
            Department = budget.Department,
            Category = budget.Category,
            AllocatedAmount = budget.AllocatedAmount,
            SpentAmount = budget.SpentAmount,
            RemainingAmount = budget.RemainingAmount,
            StartDate = budget.StartDate,
            EndDate = budget.EndDate,
            Status = budget.Status,
            Description = budget.Description,
            CreatedAt = budget.CreatedAt,
            CreatedBy = budget.CreatedBy
        };
        isEditing = true;
        showModal = true;
        ClearMessages();
    }

    private async Task SaveBudget()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(editBudget.BudgetName) ||
            string.IsNullOrWhiteSpace(editBudget.Department) ||
            string.IsNullOrWhiteSpace(editBudget.Category) ||
            editBudget.AllocatedAmount <= 0)
            {
                errorMessage = "Please fill in all required fields.";
                return;
            }

            editBudget.RemainingAmount = editBudget.AllocatedAmount - editBudget.SpentAmount;

            if (isEditing)
            {
                await FinanceService.UpdateBudgetAsync(editBudget);
                successMessage = "Budget updated successfully!";
            }
            else
            {
                editBudget.CreatedAt = DateTime.Now;
                await FinanceService.CreateBudgetAsync(editBudget);
                successMessage = "Budget created successfully!";
            }

            await LoadBudgets();
            CloseModal();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving budget: {ex.Message}";
        }
    }

    private async Task DeleteBudget(int budgetId)
    {
        try
        {
            await FinanceService.DeleteBudgetAsync(budgetId);
            successMessage = "Budget deleted successfully!";
            await LoadBudgets();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting budget: {ex.Message}";
        }
    }

    private void ShowRecordSpendingModal(Budget budget)
    {
        selectedBudget = budget;
        spendingAmount = 0;
        spendingDescription = "";
        showRecordModal = true;
        ClearMessages();
    }

    private async Task RecordSpending()
    {
        if (selectedBudget == null || spendingAmount <= 0)
        {
            errorMessage = "Please enter a valid spending amount.";
            return;
        }

        try
        {
            var budget = await FinanceService.GetBudgetByIdAsync(selectedBudget.BudgetId);
            if (budget != null)
            {
                budget.SpentAmount += spendingAmount;
                budget.RemainingAmount = budget.AllocatedAmount - budget.SpentAmount;
                await FinanceService.UpdateBudgetAsync(budget);

                // Also create a cashflow entry for this spending
                var cashflowEntry = new CashflowEntry
                {
                    EntryType = "Outflow",
                    Category = $"Budget: {budget.Category}",
                    Amount = spendingAmount,
                    Description = $"{budget.BudgetName} - {spendingDescription}",
                    TransactionDate = DateTime.Now,
                    CreatedAt = DateTime.Now,
                    CreatedBy = AuthService.CurrentUser
                };
                await FinanceService.CreateCashflowEntryAsync(cashflowEntry);

                successMessage = $"Recorded ₱{spendingAmount:N2} spending for {budget.BudgetName}";
                await LoadBudgets();
                CloseRecordModal();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error recording spending: {ex.Message}";
        }
    }

    private void CloseModal()
    {
        showModal = false;
        editBudget = new();
    }

    private void CloseRecordModal()
    {
        showRecordModal = false;
        selectedBudget = null;
    }

    private void ClearMessages()
    {
        successMessage = "";
        errorMessage = "";
    }

    private string GetStatusStyle(string status)
    {
        return status switch
        {
            "Active" => "background: #d1fae5; color: #047857;",
            "Closed" => "background: #f3f4f6; color: #6b7280;",
            "Draft" => "background: #fef3c7; color: #92400e;",
            _ => "background: #f3f4f6; color: #374151;"
        };
    }
}