    private string GetTypeColor(string type)
    {
        return type switch
        {
            "Revenue" => "#047857",
            "Expense" => "#dc2626",
            "Cashflow" => "#1e40af",
            "Loan Portfolio" => "#047857",
            "Deposits" => "#6d28d9",
