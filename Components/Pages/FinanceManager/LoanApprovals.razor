@page "/finance-manager/loan-approvals"
@layout FinanceManagerLayout
@using FinanceBank.Models
@using FinanceBank.Services
@using Microsoft.EntityFrameworkCore
@using FinanceBank.Components.Shared
@inject LoanProcessService LoanService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="sidebar-content">
    <div class="card">
        <div class="card-header">
            <h1 class="modal-title">Pending Loan Approvals</h1>
            <p class="modal-subtitle">Review and approve or decline loan assessments</p>
        </div>

        <div class="card-body" style="padding: 24px;">
            @if (isLoading)
            {
                <div class="text-center" style="padding: 40px;">
                    <p style="color: var(--text-gray);">Loading pending assessments...</p>
                </div>
            }
            else if (!pendingAssessments.Any())
            {
                <div class="text-center" style="padding: 40px;">
                    <p style="color: var(--text-gray); font-size: 16px;">No pending assessments to review</p>
                </div>
            }
            else
            {
                <div style="display: grid; gap: 16px;">
                    @foreach (var assessment in pendingAssessments)
                    {
                        <div class="card" style="border: 2px solid var(--border); cursor: pointer;" @onclick="() => OpenApprovalModal(assessment)">
                            <div style="display: flex; justify-content: space-between; align-items: start; gap: 20px;">
                                <div style="flex: 1;">
                                    <h3 style="font-size: 18px; font-weight: 700; color: var(--text-dark); margin-bottom: 8px;">
                                        @assessment.Application?.ApplicationNumber
                                    </h3>
                                    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-top: 12px;">
                                        <div>
                                            <span style="font-size: 13px; color: var(--text-gray); display: block;">Customer</span>
                                            <span style="font-size: 15px; font-weight: 600; color: var(--text-dark);">@assessment.Account?.Customer?.FullName</span>
                                        </div>
                                        <div>
                                            <span style="font-size: 13px; color: var(--text-gray); display: block;">Loan Type</span>
                                            <span style="font-size: 15px; font-weight: 600; color: var(--text-dark);">@assessment.Application?.LoanType</span>
                                        </div>
                                        <div>
                                            <span style="font-size: 13px; color: var(--text-gray); display: block;">Requested Amount</span>
                                            <span style="font-size: 15px; font-weight: 600; color: var(--primary-green-start);">₱@assessment.LoanAmount.ToString("N2")</span>
                                        </div>
                                        <div>
                                            <span style="font-size: 13px; color: var(--text-gray); display: block;">Monthly Payment</span>
                                            <span style="font-size: 15px; font-weight: 600; color: var(--text-dark);">₱@assessment.ComputedMonthlyPayment.ToString("N2")</span>
                                        </div>
                                    </div>
                                </div>
                                <button class="btn btn-primary btn-sm">
                                    Review →
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@if (showApprovalModal && selectedAssessment != null)
{
    <StepModal Title="@modalTitle" 
               Subtitle="@modalSubtitle"
               CurrentStep="currentStep"
               ShowSteps="true"
               IsVisible="showApprovalModal"
               OnClose="CloseModal"
               OnConfirm="SubmitApproval"
               OnStepChanged="HandleStepChanged"
               Step1Label="Review Details"
               Step2Label="Confirmation"
               ConfirmButtonText="@GetConfirmButtonText()"
               Step1Valid="true"
               Step2Valid="true">
        
        <Step1Content>
            <div class="step-section">
                <h3 class="step-section-title">Loan Assessment Details</h3>
                
                <div style="background: var(--bg-lighter); border-radius: var(--radius-md); padding: 20px; margin-bottom: 20px;">
                    <div class="summary-row">
                        <span class="summary-label">Application Number</span>
                        <span class="summary-value">@selectedAssessment.Application?.ApplicationNumber</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">Customer Name</span>
                        <span class="summary-value">@selectedAssessment.Account?.Customer?.FullName</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">Account Number</span>
                        <span class="summary-value">@selectedAssessment.Account?.AccountNumber</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">Loan Type</span>
                        <span class="summary-value">@selectedAssessment.Application?.LoanType</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">Assessed Amount</span>
                        <span class="summary-value highlight">₱@selectedAssessment.LoanAmount.ToString("N2")</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">Interest Rate</span>
                        <span class="summary-value">@selectedAssessment.InterestRate%</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">Term</span>
                        <span class="summary-value">@selectedAssessment.TermMonths months</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">Monthly Payment</span>
                        <span class="summary-value">₱@selectedAssessment.ComputedMonthlyPayment.ToString("N2")</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">Total Payable</span>
                        <span class="summary-value">₱@selectedAssessment.TotalPayable.ToString("N2")</span>
                    </div>
                </div>

                <h3 class="step-section-title">Approval Decision</h3>
                
                <div class="form-group">
                    <label class="form-label required">Decision</label>
                    <select class="form-control" @bind="approvalStatus">
                        <option value="">-- Select Decision --</option>
                        <option value="APPROVED">Approve Loan</option>
                        <option value="DECLINED">Decline Loan</option>
                    </select>
                </div>

                @if (approvalStatus == "APPROVED")
                {
                    <div class="form-group">
                        <label class="form-label required">Approved Amount</label>
                        <input type="number" class="form-control" @bind="approvedAmount" step="0.01" 
                               placeholder="Enter approved amount" />
                        <span class="form-help">Assessed: ₱@selectedAssessment.LoanAmount.ToString("N2")</span>
                    </div>

                    <div class="form-group">
                        <label class="form-label required">Approved Interest Rate (%)</label>
                        <input type="number" class="form-control" @bind="approvedInterestRate" step="0.01" 
                               placeholder="Enter interest rate" />
                        <span class="form-help">Assessed: @selectedAssessment.InterestRate%</span>
                    </div>

                    <div class="form-group">
                        <label class="form-label required">Approved Term (months)</label>
                        <input type="number" class="form-control" @bind="approvedTermMonths" 
                               placeholder="Enter term in months" />
                        <span class="form-help">Assessed: @selectedAssessment.TermMonths months</span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Special Conditions</label>
                        <textarea class="form-control" @bind="specialConditions" rows="3" 
                                  placeholder="Enter any special conditions or requirements..."></textarea>
                        <span class="form-help">Optional: Additional terms or conditions for this loan</span>
                    </div>
                }
                else if (approvalStatus == "DECLINED")
                {
                    <div class="form-group">
                        <label class="form-label required">Declination Reason</label>
                        <textarea class="form-control" @bind="declinationReason" rows="4" 
                                  placeholder="Explain why this loan is being declined..." required></textarea>
                        <span class="form-help">Provide detailed reason for declination</span>
                    </div>
                }
            </div>
        </Step1Content>

        <Step2Content>
            <div class="confirmation-summary">
                <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 16px; color: var(--text-dark);">
                    @(approvalStatus == "APPROVED" ? "✓ Approval Confirmation" : "✗ Declination Confirmation")
                </h3>
                
                <div class="summary-row">
                    <span class="summary-label">Decision</span>
                    <span class="summary-value" style="color: @(approvalStatus == "APPROVED" ? "var(--success)" : "var(--danger)");">
                        @approvalStatus
                    </span>
                </div>
                <div class="summary-row">
                    <span class="summary-label">Application Number</span>
                    <span class="summary-value">@selectedAssessment.Application?.ApplicationNumber</span>
                </div>
                <div class="summary-row">
                    <span class="summary-label">Customer</span>
                    <span class="summary-value">@selectedAssessment.Account?.Customer?.FullName</span>
                </div>

                @if (approvalStatus == "APPROVED")
                {
                    <div class="summary-row">
                        <span class="summary-label">Approved Amount</span>
                        <span class="summary-value highlight">₱@approvedAmount?.ToString("N2")</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">Interest Rate</span>
                        <span class="summary-value">@approvedInterestRate%</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">Term</span>
                        <span class="summary-value">@approvedTermMonths months</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(specialConditions))
                    {
                        <div class="summary-row">
                            <span class="summary-label">Special Conditions</span>
                            <span class="summary-value">@specialConditions</span>
                        </div>
                    }
                }
                else
                {
                    <div class="summary-row">
                        <span class="summary-label">Reason</span>
                        <span class="summary-value">@declinationReason</span>
                    </div>
                }
            </div>

            <div style="background: #fff3cd; border: 2px solid #ffc107; border-radius: var(--radius-md); padding: 16px; margin-bottom: 20px;">
                <p style="margin: 0; color: #856404; font-weight: 600;">
                    ⚠️ This action cannot be undone. Please verify all information before confirming.
                </p>
            </div>
        </Step2Content>
    </StepModal>
}

@code {
    private List<LoanAssessment> pendingAssessments = new();
    private LoanAssessment? selectedAssessment;
    private bool showApprovalModal = false;
    private bool isLoading = true;
    private int currentStep = 1;

    // Form fields
    private string approvalStatus = "";
    private decimal? approvedAmount;
    private decimal? approvedInterestRate;
    private int? approvedTermMonths;
    private string specialConditions = "";
    private string declinationReason = "";

    private string modalTitle => approvalStatus == "APPROVED" ? "Approve Loan Application" : 
                                  approvalStatus == "DECLINED" ? "Decline Loan Application" : "Review Loan Application";
    private string modalSubtitle => currentStep == 1 ? "Step 1: Review details and make decision" : "Step 2: Confirm your decision";

    private string GetConfirmButtonText()
    {
        return approvalStatus == "APPROVED" ? "Approve Loan" : "Decline Loan";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadPendingAssessments();
    }

    private async Task LoadPendingAssessments()
    {
        isLoading = true;
        try
        {
            pendingAssessments = await LoanService.GetPendingAssessmentsAsync();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error loading assessments: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenApprovalModal(LoanAssessment assessment)
    {
        selectedAssessment = assessment;
        currentStep = 1;
        approvalStatus = "";
        approvedAmount = assessment.LoanAmount;
        approvedInterestRate = assessment.InterestRate;
        approvedTermMonths = assessment.TermMonths;
        specialConditions = "";
        declinationReason = "";
        showApprovalModal = true;
    }

    private void CloseModal()
    {
        showApprovalModal = false;
        selectedAssessment = null;
        currentStep = 1;
    }

    private void HandleStepChanged(int step)
    {
        currentStep = step;
        StateHasChanged();
    }

    private bool ValidateCurrentStep()
    {
        if (currentStep == 1)
        {
            if (string.IsNullOrWhiteSpace(approvalStatus))
            {
                JS.InvokeVoidAsync("alert", "Please select a decision");
                return false;
            }

            if (approvalStatus == "APPROVED")
            {
                if (!approvedAmount.HasValue || approvedAmount <= 0)
                {
                    JS.InvokeVoidAsync("alert", "Please enter a valid approved amount");
                    return false;
                }
                if (!approvedInterestRate.HasValue || approvedInterestRate <= 0)
                {
                    JS.InvokeVoidAsync("alert", "Please enter a valid interest rate");
                    return false;
                }
                if (!approvedTermMonths.HasValue || approvedTermMonths <= 0)
                {
                    JS.InvokeVoidAsync("alert", "Please enter a valid term");
                    return false;
                }
            }
            else if (string.IsNullOrWhiteSpace(declinationReason))
            {
                JS.InvokeVoidAsync("alert", "Please provide a declination reason");
                return false;
            }
        }
        return true;
    }

    private async Task SubmitApproval()
    {
        if (selectedAssessment == null) return;

        try
        {
            if (approvalStatus == "APPROVED")
            {
                await LoanService.ApproveLoanAsync(
                    selectedAssessment.AssessmentId,
                    selectedAssessment.ApplicationId,
                    selectedAssessment.AccountId,
                    approvedAmount!.Value,
                    approvedInterestRate!.Value,
                    approvedTermMonths!.Value,
                    "Finance Manager", // Replace with actual user
                    specialConditions
                );
                await JS.InvokeVoidAsync("alert", "Loan approved successfully!");
            }
            else
            {
                await LoanService.DeclineLoanAsync(
                    selectedAssessment.AssessmentId,
                    selectedAssessment.ApplicationId,
                    selectedAssessment.AccountId,
                    declinationReason,
                    "Finance Manager" // Replace with actual user
                );
                await JS.InvokeVoidAsync("alert", "Loan declined successfully!");
            }

            CloseModal();
            await LoadPendingAssessments();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error processing approval: {ex.Message}");
        }
    }
}
