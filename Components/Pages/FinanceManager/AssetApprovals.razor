@page "/finance-manager/asset-approvals"
@layout FinanceManagerLayout
@using FinanceBank.Models
@using FinanceBank.Services
@using FinanceBank.Data
@using Microsoft.EntityFrameworkCore
@inject AuthService AuthService
@inject IDbContextFactory<BFASDbContext> DbContextFactory

<div class="sidebar-content">
    <div class="card">
        <div class="card-header" style="background: linear-gradient(135deg, #5F6F52, #2F3E2A); color: white; padding: 20px;">
            <h4 style="margin: 0; font-weight: 600;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px; vertical-align: middle;">
                    <path d="M9 11l3 3L22 4"></path>
                    <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"></path>
                </svg>
                Asset Purchase Approvals
            </h4>
            <p style="margin: 8px 0 0 0; opacity: 0.9; font-size: 14px;">Final approval for asset purchase/loan applications</p>
        </div>

        <div class="card-body" style="padding: 24px;">
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div style="background: #D4E6D4; border: 1px solid #A9B388; color: #2F3E2A; padding: 16px; border-radius: 8px; margin-bottom: 20px;">
                    ✅ @successMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div style="background: #F5E6E6; border: 1px solid #D4A9A9; color: #9B3A3A; padding: 16px; border-radius: 8px; margin-bottom: 20px;">
                    ❌ @errorMessage
                </div>
            }

            @if (isLoading)
            {
                <div style="text-align: center; padding: 40px;">
                    <div style="width: 40px; height: 40px; border: 3px solid #e5e7eb; border-top-color: #5F6F52; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto;"></div>
                    <p style="margin-top: 16px; color: #6b7280;">Loading applications...</p>
                </div>
            }
            else if (pendingApplications == null || pendingApplications.Count == 0)
            {
                <div style="text-align: center; padding: 60px 20px; background: #f9fafb; border-radius: 12px;">
                    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5" style="margin: 0 auto;">
                        <path d="M9 11l3 3L22 4"></path>
                        <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"></path>
                    </svg>
                    <h5 style="color: #6b7280; margin-top: 16px;">No Pending Approvals</h5>
                    <p style="color: #9ca3af; font-size: 14px;">All asset applications have been processed.</p>
                </div>
            }
            else
            {
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="background: #f9fafb; border-bottom: 2px solid #e5e7eb;">
                                <th style="padding: 12px; text-align: left; font-weight: 600; color: #374151;">Application #</th>
                                <th style="padding: 12px; text-align: left; font-weight: 600; color: #374151;">Customer</th>
                                <th style="padding: 12px; text-align: left; font-weight: 600; color: #374151;">Asset</th>
                                <th style="padding: 12px; text-align: right; font-weight: 600; color: #374151;">Loan Amount</th>
                                <th style="padding: 12px; text-align: center; font-weight: 600; color: #374151;">Risk Level</th>
                                <th style="padding: 12px; text-align: center; font-weight: 600; color: #374151;">Recommendation</th>
                                <th style="padding: 12px; text-align: center; font-weight: 600; color: #374151;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var app in pendingApplications)
                            {
                                <tr style="border-bottom: 1px solid #e5e7eb;">
                                    <td style="padding: 16px 12px;">
                                        <span style="background: #E8F0E8; color: #2F3E2A; padding: 4px 12px; border-radius: 20px; font-weight: 600; font-size: 13px;">
                                            @app.ApplicationNumber
                                        </span>
                                    </td>
                                    <td style="padding: 16px 12px;">
                                        <div style="font-weight: 500; color: #1f2937;">@app.CustomerName</div>
                                        <div style="font-size: 12px; color: #6b7280;">DTI: @((app.DebtToIncomeRatio ?? 0).ToString("N2"))%</div>
                                    </td>
                                    <td style="padding: 16px 12px;">
                                        <div style="font-weight: 500; color: #374151;">@(app.Asset?.AssetName ?? "N/A")</div>
                                        <div style="font-size: 12px; color: #6b7280;">@app.PurchaseType</div>
                                    </td>
                                    <td style="padding: 16px 12px; text-align: right; font-weight: 600; color: #5F6F52;">
                                        ₱@app.LoanAmount.ToString("N2")
                                    </td>
                                    <td style="padding: 16px 12px; text-align: center;">
                                        @{
                                            var (riskBg, riskColor) = GetRiskStyle(app.CreditRiskLevel ?? "");
                                        }
                                        <span style="background: @riskBg; color: @riskColor; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600;">
                                            @(app.CreditRiskLevel ?? "N/A")
                                        </span>
                                    </td>
                                    <td style="padding: 16px 12px; text-align: center;">
                                        @if (app.AccountantRecommendation == "APPROVE")
                                        {
                                            <span style="background: #D4E6D4; color: #2F3E2A; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600;">
                                                ✅ Approve
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="background: #F5E6E6; color: #9B3A3A; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600;">
                                                ❌ Decline
                                            </span>
                                        }
                                    </td>
                                    <td style="padding: 16px 12px; text-align: center;">
                                        <button style="background: #5F6F52; color: white; border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-weight: 500;"
                                                @onclick="() => OpenApprovalModal(app)">
                                            Review
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Approval Modal -->
@if (showModal && selectedApplication != null)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000; padding: 20px;">
        <div style="background: white; border-radius: 16px; width: 100%; max-width: 1000px; max-height: 90vh; overflow-y: auto;">
            <div style="background: linear-gradient(135deg, #5F6F52, #2F3E2A); color: white; padding: 20px; border-radius: 16px 16px 0 0;">
                <h4 style="margin: 0;">🎯 Final Approval Decision</h4>
                <p style="margin: 8px 0 0 0; opacity: 0.9; font-size: 14px;">Application #: @selectedApplication.ApplicationNumber</p>
            </div>

            <div style="padding: 24px;">
                <!-- Summary Cards -->
                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; margin-bottom: 24px;">
                    <!-- Customer Summary -->
                    <div style="background: #f9fafb; border-radius: 12px; padding: 16px;">
                        <h5 style="margin: 0 0 12px 0; color: #374151; font-weight: 700;">👤 Customer</h5>
                        <div style="font-size: 14px;">
                            <p><strong>@selectedApplication.CustomerName</strong></p>
                            <p>@selectedApplication.EmploymentStatus</p>
                            <p>Income: ₱@(selectedApplication.MonthlyIncome?.ToString("N2") ?? "N/A")</p>
                        </div>
                    </div>

                    <!-- Financial Summary -->
                    <div style="background: #F0F2EC; border-radius: 12px; padding: 16px; border: 1px solid #BCC9A6;">
                        <h5 style="margin: 0 0 12px 0; color: #5F6F52; font-weight: 700;">💰 Financial</h5>
                        <div style="font-size: 14px;">
                            <p><strong>Loan:</strong> ₱@selectedApplication.LoanAmount.ToString("N2")</p>
                            <p><strong>Monthly:</strong> ₱@selectedApplication.MonthlyPayment.ToString("N2")</p>
                            <p><strong>Term:</strong> @selectedApplication.TermMonths months</p>
                            <p><strong>Interest:</strong> @(selectedApplication.AssessedInterestRate ?? selectedApplication.InterestRate)%</p>
                        </div>
                    </div>

                    <!-- Assessment Summary -->
                    <div style="background: #F0F2EC; border-radius: 12px; padding: 16px; border: 1px solid #BCC9A6;">
                        <h5 style="margin: 0 0 12px 0; color: #5F6F52; font-weight: 700;">📊 Assessment</h5>
                        <div style="font-size: 14px;">
                            <p><strong>DTI:</strong> @((selectedApplication.DebtToIncomeRatio ?? 0).ToString("N2"))%</p>
                            <p><strong>Risk:</strong> @(selectedApplication.CreditRiskLevel ?? "N/A")</p>
                            <p><strong>Recommendation:</strong> @(selectedApplication.AccountantRecommendation ?? "N/A")</p>
                            <p><strong>Assessed By:</strong> @selectedApplication.AccountantAssessedBy</p>
                        </div>
                    </div>
                </div>

                <!-- Workflow Timeline -->
                <div style="background: #f9fafb; border-radius: 12px; padding: 20px; margin-bottom: 24px;">
                    <h5 style="margin: 0 0 16px 0; color: #374151; font-weight: 700;">📋 Workflow History</h5>
                    <div style="display: flex; gap: 20px;">
                        <div style="flex: 1; padding: 12px; background: white; border-radius: 8px; border-left: 4px solid #5F6F52;">
                            <div style="font-weight: 600; color: #5F6F52;">1. Submitted</div>
                            <div style="font-size: 13px; color: #6b7280;">@selectedApplication.SubmittedAt.ToString("MMM dd, yyyy HH:mm")</div>
                            <div style="font-size: 12px; color: #9ca3af;">By: @selectedApplication.SubmittedBy</div>
                        </div>
                        <div style="flex: 1; padding: 12px; background: white; border-radius: 8px; border-left: 4px solid #5F6F52;">
                            <div style="font-weight: 600; color: #5F6F52;">2. Verified</div>
                            <div style="font-size: 13px; color: #6b7280;">@(selectedApplication.TellerReviewedAt?.ToString("MMM dd, yyyy HH:mm") ?? "Pending")</div>
                            <div style="font-size: 12px; color: #9ca3af;">By: @selectedApplication.TellerReviewedBy</div>
                        </div>
                        <div style="flex: 1; padding: 12px; background: white; border-radius: 8px; border-left: 4px solid #6B7B5E;">
                            <div style="font-weight: 600; color: #6B7B5E;">3. Assessed</div>
                            <div style="font-size: 13px; color: #6b7280;">@(selectedApplication.AccountantAssessedAt?.ToString("MMM dd, yyyy HH:mm") ?? "Pending")</div>
                            <div style="font-size: 12px; color: #9ca3af;">By: @selectedApplication.AccountantAssessedBy</div>
                        </div>
                        <div style="flex: 1; padding: 12px; background: #F5EFE0; border-radius: 8px; border-left: 4px solid #8B5A2B;">
                            <div style="font-weight: 600; color: #8B5A2B;">4. Approval</div>
                            <div style="font-size: 13px; color: #6b7280;">Awaiting Decision</div>
                        </div>
                    </div>
                </div>

                <!-- Previous Remarks -->
                @if (!string.IsNullOrEmpty(selectedApplication.TellerRemarks) || !string.IsNullOrEmpty(selectedApplication.AccountantRemarks))
                {
                    <div style="background: #fefce8; border-radius: 12px; padding: 16px; margin-bottom: 24px; border: 1px solid #fde047;">
                        <h5 style="margin: 0 0 12px 0; color: #ca8a04; font-weight: 700;">💬 Previous Remarks</h5>
                        @if (!string.IsNullOrEmpty(selectedApplication.TellerRemarks))
                        {
                            <div style="padding: 12px; background: white; border-radius: 8px; margin-bottom: 8px;">
                                <strong>Teller:</strong> @selectedApplication.TellerRemarks
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(selectedApplication.AccountantRemarks))
                        {
                            <div style="padding: 12px; background: white; border-radius: 8px;">
                                <strong>Accountant:</strong> @selectedApplication.AccountantRemarks
                            </div>
                        }
                    </div>
                }

                <!-- Document Verification Status -->
                <div style="background: #F0F2EC; border-radius: 12px; padding: 16px; margin-bottom: 24px; border: 1px solid #BCC9A6;">
                    <h5 style="margin: 0 0 12px 0; color: #5F6F52; font-weight: 700;">📄 Document Status</h5>
                    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; font-size: 13px;">
                        <div style="padding: 8px; background: white; border-radius: 6px;">
                            @(selectedApplication.ValidIdSubmitted ? "✅" : "❌") Valid ID
                        </div>
                        <div style="padding: 8px; background: white; border-radius: 6px;">
                            @(selectedApplication.ProofOfIncomeSubmitted ? "✅" : "❌") Proof of Income
                        </div>
                        <div style="padding: 8px; background: white; border-radius: 6px;">
                            @(selectedApplication.BankStatementSubmitted ? "✅" : "❌") Bank Statement
                        </div>
                        <div style="padding: 8px; background: white; border-radius: 6px;">
                            @(selectedApplication.TellerVerifiedEmployment ? "✅" : "❌") Employment
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(selectedApplication.UploadedDocuments))
                    {
                        <div style="margin-top: 12px; padding: 8px; background: white; border-radius: 6px; color: #5F6F52;">
                            📁 Documents have been uploaded and verified
                        </div>
                    }
                </div>

                <!-- Asset Images Slideshow -->
                @if (selectedApplication.Asset?.Images != null && selectedApplication.Asset.Images.Any())
                {
                    <div style="background: #f3f4f6; border-radius: 12px; padding: 16px; margin-bottom: 24px;">
                        <h5 style="margin: 0 0 12px 0; color: #374151; font-weight: 700;">🖼️ Asset Images</h5>
                        <div style="position: relative;">
                            <div style="display: flex; align-items: center; justify-content: center; min-height: 180px;">
                                @{
                                    var images = selectedApplication.Asset.Images.OrderBy(i => i.DisplayOrder).ToList();
                                    var currentImage = images.ElementAtOrDefault(currentImageIndex);
                                }
                                @if (currentImage != null && currentImage.ImageData != null)
                                {
                                    <img src="data:@currentImage.ContentType;base64,@Convert.ToBase64String(currentImage.ImageData)" 
                                         style="max-width: 100%; max-height: 180px; border-radius: 8px; object-fit: contain;" />
                                }
                            </div>
                            @if (images.Count > 1)
                            {
                                <button @onclick="PrevImage" style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); background: rgba(0,0,0,0.5); color: white; border: none; border-radius: 50%; width: 32px; height: 32px; cursor: pointer;">
                                    ◀
                                </button>
                                <button @onclick="NextImage" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: rgba(0,0,0,0.5); color: white; border: none; border-radius: 50%; width: 32px; height: 32px; cursor: pointer;">
                                    ▶
                                </button>
                                <div style="text-align: center; margin-top: 8px;">
                                    <span style="font-size: 12px; color: #6b7280;">Image @(currentImageIndex + 1) of @images.Count</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Final Decision -->
                <div style="margin-bottom: 24px;">
                    <label style="display: block; margin-bottom: 8px; color: #374151; font-weight: 700;">📝 Finance Manager Remarks</label>
                    <textarea @bind="fmRemarks" rows="3" placeholder="Enter your final decision remarks..."
                        style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px;"></textarea>
                </div>

                <!-- Action Buttons -->
                <div style="display: flex; gap: 12px; justify-content: flex-end;">
                    <button @onclick="CloseModal" style="background: white; border: 2px solid #e5e7eb; color: #374151; padding: 12px 24px; border-radius: 8px; cursor: pointer; font-weight: 600;">
                        Cancel
                    </button>
                    <button @onclick="RejectApplication" disabled="@isProcessing" style="background: #9B3A3A; color: white; border: none; padding: 12px 24px; border-radius: 8px; cursor: pointer; font-weight: 600;">
                        ❌ Reject Application
                    </button>
                    <button @onclick="ApproveApplication" disabled="@isProcessing"
                        style="background: linear-gradient(135deg, #5F6F52, #5F6F52); color: white; border: none; padding: 12px 32px; border-radius: 8px; cursor: pointer; font-weight: 600;">
                        @(isProcessing ? "Processing..." : "✅ Approve Application")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

@code {
    private List<AssetApplication>? pendingApplications;
    private AssetApplication? selectedApplication;
    private bool isLoading = true;
    private bool isProcessing = false;
    private bool showModal = false;
    private string successMessage = "";
    private string errorMessage = "";
    private string fmRemarks = "";
    
    // Image slideshow
    private int currentImageIndex = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadApplications();
    }

    private async Task LoadApplications()
    {
        isLoading = true;
        try
        {
            using var db = await DbContextFactory.CreateDbContextAsync();
            pendingApplications = await db.AssetApplications
                .Include(a => a.Asset)
                    .ThenInclude(asset => asset!.Images)
                .Where(a => a.Status == "ASSESSED")
                .OrderByDescending(a => a.AccountantAssessedAt)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading applications: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenApprovalModal(AssetApplication app)
    {
        selectedApplication = app;
        fmRemarks = "";
        currentImageIndex = 0;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        selectedApplication = null;
    }

    private async Task ApproveApplication()
    {
        if (selectedApplication == null) return;

        isProcessing = true;
        errorMessage = "";
        try
        {
            using var db = await DbContextFactory.CreateDbContextAsync();
            var app = await db.AssetApplications.FindAsync(selectedApplication.ApplicationId);
            if (app == null) throw new Exception("Application not found");

            var currentUser = AuthService.CurrentUser;
            app.Status = "APPROVED";
            app.FinanceManagerApprovedBy = currentUser ?? "Finance Manager";
            app.FinanceManagerApprovedAt = DateTime.Now;
            app.FinanceManagerRemarks = fmRemarks;

            await db.SaveChangesAsync();

            successMessage = $"Application {app.ApplicationNumber} approved! Ready for release by Teller.";
            CloseModal();
            await LoadApplications();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task RejectApplication()
    {
        if (selectedApplication == null) return;

        isProcessing = true;
        try
        {
            using var db = await DbContextFactory.CreateDbContextAsync();
            var app = await db.AssetApplications.FindAsync(selectedApplication.ApplicationId);
            if (app == null) throw new Exception("Application not found");

            var currentUser = AuthService.CurrentUser;
            app.Status = "REJECTED";
            app.FinanceManagerApprovedBy = currentUser ?? "Finance Manager";
            app.FinanceManagerApprovedAt = DateTime.Now;
            app.FinanceManagerRemarks = string.IsNullOrEmpty(fmRemarks) ? "Application rejected by Finance Manager" : fmRemarks;

            await db.SaveChangesAsync();

            successMessage = $"Application {app.ApplicationNumber} has been rejected.";
            CloseModal();
            await LoadApplications();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private (string bg, string color) GetRiskStyle(string risk)
    {
        return risk switch
        {
            "Low" => ("#D4E6D4", "#2F3E2A"),
            "Medium" => ("#F5EFE0", "#8B5A2B"),
            "High" => ("#F5E6E6", "#9B3A3A"),
            _ => ("#f3f4f6", "#6b7280")
        };
    }

    // Image navigation methods
    private void PrevImage()
    {
        if (selectedApplication?.Asset?.Images != null)
        {
            var imageCount = selectedApplication.Asset.Images.Count;
            currentImageIndex = (currentImageIndex - 1 + imageCount) % imageCount;
        }
    }

    private void NextImage()
    {
        if (selectedApplication?.Asset?.Images != null)
        {
            var imageCount = selectedApplication.Asset.Images.Count;
            currentImageIndex = (currentImageIndex + 1) % imageCount;
        }
    }

    private void SetImageIndex(int index)
    {
        currentImageIndex = index;
    }
}
