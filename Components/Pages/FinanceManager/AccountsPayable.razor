<!-- Interest Review Modal (Step 1 & Step 2) -->
@if (showInterestReviewModal && selectedInterestForReview != null)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.7); display: flex; align-items: center; justify-content: center; z-index: 1000; backdrop-filter: blur(4px);" @onclick="CloseInterestReviewModal">
        <div style="background: white; border-radius: 20px; width: 95%; max-width: 700px; max-height: 90vh; overflow-y: auto; box-shadow: 0 25px 60px rgba(0,0,0,0.3);" @onclick:stopPropagation>
            <div style="background: linear-gradient(135deg, #a855f7, #9333ea); color: white; padding: 24px 28px; border-radius: 20px 20px 0 0;">
                <h4 style="margin: 0; font-weight: 700; font-size: 20px;">💰 FM Review - Savings Interest Payout</h4>
                <p style="margin: 6px 0 0 0; opacity: 0.9; font-size: 14px;">Bill: @selectedInterestForReview.InvoiceNumber</p>
            </div>

            <div style="padding: 28px;">
                <!-- Progress Steps -->
                <div style="display: flex; justify-content: center; gap: 8px; margin-bottom: 28px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <div style="width: 40px; height: 40px; background: @(interestReviewStep >= 1 ? "linear-gradient(135deg, #a855f7, #9333ea)" : "#e5e7eb"); color: @(interestReviewStep >= 1 ? "white" : "#6b7280"); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700;">1</div>
                        <span style="font-weight: 600; color: @(interestReviewStep >= 1 ? "#a855f7" : "#6b7280");">Verify Interest</span>
                    </div>
                    <div style="width: 60px; height: 3px; background: @(interestReviewStep >= 2 ? "#a855f7" : "#e5e7eb"); border-radius: 2px; margin-top: 18px;"></div>
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <div style="width: 40px; height: 40px; background: @(interestReviewStep >= 2 ? "linear-gradient(135deg, #a855f7, #9333ea)" : "#e5e7eb"); color: @(interestReviewStep >= 2 ? "white" : "#6b7280"); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700;">2</div>
                        <span style="font-weight: 600; color: @(interestReviewStep >= 2 ? "#a855f7" : "#6b7280");">Approve Payout</span>
                    </div>
                </div>

                @if (interestReviewStep == 1)
                {
                    <!-- Step 1: Verify Interest Details -->
                    <div style="background: linear-gradient(135deg, #fdf4ff, #f5d0fe); padding: 24px; border-radius: 16px; border: 1px solid #e879f9; margin-bottom: 24px;">
                        <h5 style="margin: 0 0 16px 0; color: #7c3aed; font-size: 16px; font-weight: 700;">📋 Step 1: Verify Interest Details</h5>
                        
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                            <div style="background: white; padding: 16px; border-radius: 10px;">
                                <span style="font-size: 12px; color: #6b7280; text-transform: uppercase; font-weight: 600;">Customer Name</span>
                                <p style="margin: 4px 0 0 0; font-weight: 700; color: #1e293b; font-size: 16px;">@selectedInterestForReview.VendorName</p>
                            </div>
                            <div style="background: white; padding: 16px; border-radius: 10px;">
                                <span style="font-size: 12px; color: #6b7280; text-transform: uppercase; font-weight: 600;">Bill Number</span>
                                <p style="margin: 4px 0 0 0; font-weight: 700; color: #1e293b; font-size: 16px;">@selectedInterestForReview.InvoiceNumber</p>
                            </div>
                            <div style="background: white; padding: 16px; border-radius: 10px;">
                                <span style="font-size: 12px; color: #6b7280; text-transform: uppercase; font-weight: 600;">Interest Amount</span>
                                <p style="margin: 4px 0 0 0; font-weight: 700; color: #dc2626; font-size: 20px;">₱@selectedInterestForReview.Amount.ToString("N2")</p>
                            </div>
                            <div style="background: white; padding: 16px; border-radius: 10px;">
                                <span style="font-size: 12px; color: #6b7280; text-transform: uppercase; font-weight: 600;">Due Date</span>
                                <p style="margin: 4px 0 0 0; font-weight: 600; color: #1e293b; font-size: 15px;">@selectedInterestForReview.DueDate.ToString("MMM dd, yyyy")</p>
                            </div>
                        </div>

                        <div style="background: white; padding: 16px; border-radius: 10px; margin-top: 16px;">
                            <span style="font-size: 12px; color: #6b7280; text-transform: uppercase; font-weight: 600;">Savings Details</span>
                            <p style="margin: 4px 0 0 0; color: #4b5563; font-size: 14px;">@(selectedInterestForReview.Description ?? "Monthly Savings Interest")</p>
                        </div>
                    </div>

                    <div style="margin-bottom: 24px;">
                        <label style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 8px;">FM Review Notes</label>
                        <textarea @bind="interestReviewNotes" rows="3" placeholder="Enter any notes about this interest calculation..." 
                                  style="width: 100%; padding: 14px 16px; border: 2px solid #e5e7eb; border-radius: 10px; font-size: 15px; resize: vertical;"></textarea>
                    </div>

                    <div style="display: flex; gap: 12px; justify-content: flex-end;">
                        <button @onclick="CloseInterestReviewModal" style="background: #f1f5f9; color: #475569; border: none; padding: 12px 24px; border-radius: 10px; cursor: pointer; font-weight: 600;">
                            Cancel
                        </button>
                        <button @onclick="ProceedToInterestStep2" style="background: linear-gradient(135deg, #a855f7, #9333ea); color: white; border: none; padding: 12px 28px; border-radius: 10px; cursor: pointer; font-weight: 700; display: flex; align-items: center; gap: 8px;">
                            Proceed to Step 2
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M5 12h14M12 5l7 7-7 7"></path>
                            </svg>
                        </button>
                    </div>
                }
                else if (interestReviewStep == 2)
                {
                    <!-- Step 2: Final Approval -->
                    <div style="background: linear-gradient(135deg, #fef3c7, #fde68a); padding: 24px; border-radius: 16px; border: 1px solid #fcd34d; margin-bottom: 24px;">
                        <h5 style="margin: 0 0 16px 0; color: #92400e; font-size: 16px; font-weight: 700;">💳 Step 2: Approve Interest Payout</h5>
                        
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                            <div style="background: white; padding: 20px; border-radius: 12px; text-align: center;">
                                <span style="font-size: 12px; color: #6b7280; text-transform: uppercase; font-weight: 600;">Customer</span>
                                <p style="margin: 8px 0 0 0; font-weight: 700; color: #1e293b; font-size: 18px;">@selectedInterestForReview.VendorName</p>
                            </div>
                            <div style="background: white; padding: 20px; border-radius: 12px; text-align: center;">
                                <span style="font-size: 12px; color: #6b7280; text-transform: uppercase; font-weight: 600;">Interest to Pay</span>
                                <p style="margin: 8px 0 0 0; font-weight: 800; color: #dc2626; font-size: 24px;">₱@selectedInterestForReview.Amount.ToString("N2")</p>
                            </div>
                        </div>

                        <div style="background: linear-gradient(135deg, #f0fdf4, #dcfce7); padding: 16px; border-radius: 10px; margin-top: 16px; text-align: center; border: 1px solid #bbf7d0;">
                            <p style="margin: 0; font-size: 14px; color: #065f46;">
                                <strong>✓ This amount will be credited to the customer's savings account as monthly interest.</strong>
                            </p>
                        </div>
                    </div>

                    <div style="background: #fef2f2; padding: 16px; border-radius: 10px; margin-bottom: 24px; border: 1px solid #fecaca;">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <input type="checkbox" @bind="confirmInterestPayout" id="confirmPayout" style="width: 20px; height: 20px; accent-color: #a855f7;">
                            <label for="confirmPayout" style="font-size: 14px; color: #991b1b; font-weight: 600;">
                                ✓ I confirm the interest calculation is correct and approve the payout
                            </label>
                        </div>
                    </div>

                    <div style="display: flex; gap: 12px; justify-content: flex-end;">
                        <button @onclick="() => interestReviewStep = 1" style="background: #f1f5f9; color: #475569; border: none; padding: 12px 24px; border-radius: 10px; cursor: pointer; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M19 12H5M12 19l-7-7 7-7"></path>
                            </svg>
                            Back to Step 1
                        </button>
                        <button @onclick="ApproveInterestPayout" disabled="@(!confirmInterestPayout || isProcessing)"
                                style="background: linear-gradient(135deg, #059669, #10b981); color: white; border: none; padding: 12px 28px; border-radius: 10px; cursor: pointer; font-weight: 700; opacity: @(!confirmInterestPayout || isProcessing ? "0.6" : "1"); display: flex; align-items: center; gap: 8px;">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                <polyline points="22 4 12 14.01 9 11.01"></polyline>
                            </svg>
                            @(isProcessing ? "Processing..." : "✓ Approve Interest Payout")
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
}

<style>
    @@keyframes spin { to { transform: rotate(360deg); } }
    .table-row-hover:hover { background: #f8fafc !important; }
    input:focus, textarea:focus { outline: none; border-color: #059669 !important; box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.1); }
    button:hover:not(:disabled) { transform: translateY(-1px); }
    button:disabled { opacity: 0.6; cursor: not-allowed; }
</style>

@code {
    private List<Models.AccountsPayable> bills = new();
    private List<Models.AccountsPayable>? paymentHistory;
    private List<Models.AccountsPayable> pendingInterestPayments = new();
    private decimal totalOutstanding = 0;
    private decimal dueThisMonth = 0;
    private decimal paidThisMonth = 0;
    private int pendingBills = 0;
    private int dueSoonCount = 0;
    private int paidCount = 0;
    private int pendingSavingsInterest = 0;
    
    // Tab state: 0 = All Bills, 1 = Pending Interest Review
    private int activeTab = 0;
    
    private bool isLoading = true;
    private bool isProcessing = false;
    private string successMessage = "";
    private string errorMessage = "";

    // Modal states
    private bool showBillModal = false;
    private bool showPaymentModal = false;
    private bool showHistoryModal = false;
    private bool showInvoiceModal = false;
    private bool showInterestReviewModal = false;
    private bool isEditingBill = false;
    private Models.AccountsPayable newBill = new();
    private Models.AccountsPayable? selectedBill = null;
    private Models.AccountsPayable? selectedBillForInvoice = null;
    private Models.AccountsPayable? selectedInterestForReview = null;
    private decimal paymentAmount = 0;
    private DateTime paymentDate = DateTime.Today;
    private string payableType = "";
    private string referenceNumber = "";
    
    // Interest review fields
    private int interestReviewStep = 1;
    private string interestReviewNotes = "";
    private bool confirmInterestPayout = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadBills();
    }

    private async Task LoadBills()
    {
        isLoading = true;
        try
        {
            bills = await AccountsPayableService.GetAllAsync();
            CalculateStats();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading bills: {ex.Message}";
            bills = new List<Models.AccountsPayable>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task FetchSavingsInterest()
    {
        isLoading = true;
        try
        {
            // Sync customer savings interest to AP entries
            var (created, skipped, message) = await AccountsPayableService.SyncSavingsInterestToAPAsync(AuthService.CurrentUser ?? "Finance Manager");
            
            // Reload bills to get the newly created entries
            await LoadBills();
            
            // Get current month pending interest payments
            var currentMonth = DateTime.Now.Month;
            var currentYear = DateTime.Now.Year;
            
            pendingInterestPayments = bills.Where(b => 
                b.Status == "Pending Review" && 
                b.Description != null && 
                b.Description.Contains("Savings Interest Payout") &&
                b.DueDate.Month == currentMonth && 
                b.DueDate.Year == currentYear).ToList();
            
            successMessage = message;
            
            if (pendingInterestPayments.Any())
            {
                successMessage = $"✓ {message}. Found {pendingInterestPayments.Count} interest payment(s) pending FM review.";
                // Switch to pending interest tab when data is found
                activeTab = 1;
            }
            
            pendingSavingsInterest = pendingInterestPayments.Count;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error fetching savings interest: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void CalculateStats()
    {
        var today = DateTime.Today;
        var monthStart = new DateTime(today.Year, today.Month, 1);
        var monthEnd = monthStart.AddMonths(1).AddDays(-1);

        totalOutstanding = bills.Where(b => b.Status != "Paid" && b.Status != "FM Approved").Sum(b => b.OutstandingAmount);
        pendingBills = bills.Count(b => b.Status != "Paid" && b.Status != "FM Approved");
        dueThisMonth = bills.Where(b => b.DueDate >= monthStart && b.DueDate <= monthEnd && b.Status != "Paid").Sum(b => b.Amount);
        dueSoonCount = bills.Count(b => b.DueDate >= today && b.DueDate <= today.AddDays(7) && b.Status != "Paid");
        paidThisMonth = bills.Where(b => b.Status == "Paid" && b.CreatedAt >= monthStart && b.CreatedAt <= monthEnd).Sum(b => b.PaidAmount);
        paidCount = bills.Count(b => b.Status == "Paid");
        pendingSavingsInterest = bills.Count(b => b.Status == "Pending Review" && b.Description != null && b.Description.Contains("Savings Interest Payout"));
    }

    // Interest Review Methods
    private void StartInterestReview(Models.AccountsPayable interest)
    {
        selectedInterestForReview = interest;
        interestReviewStep = 1;
        interestReviewNotes = "";
        confirmInterestPayout = false;
        showInterestReviewModal = true;
    }

    private void ProceedToInterestStep2()
    {
        interestReviewStep = 2;
    }

    private async Task ApproveInterestPayout()
    {
        if (selectedInterestForReview == null || !confirmInterestPayout) return;
        
        isProcessing = true;
        try
        {
            // Update status and add FM notes
            selectedInterestForReview.Status = "FM Approved";
            selectedInterestForReview.Description = $"{selectedInterestForReview.Description} | FM Approved: {interestReviewNotes}";
            
            await AccountsPayableService.UpdateAsync(selectedInterestForReview);
            
            // Create Journal Entry for interest expense
            await CreateInterestExpenseJournalEntry(selectedInterestForReview);
            
            successMessage = $"✓ Interest payout approved! Bill: {selectedInterestForReview.InvoiceNumber}";
            
            pendingInterestPayments.Remove(selectedInterestForReview);
            await LoadBills();
            CloseInterestReviewModal();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void CloseInterestReviewModal()
    {
        showInterestReviewModal = false;
        selectedInterestForReview = null;
        interestReviewStep = 1;
        interestReviewNotes = "";
        confirmInterestPayout = false;
    }

    private async Task CreateInterestExpenseJournalEntry(Models.AccountsPayable payable)
    {
        try
        {
            var journalEntry = new JournalEntry
            {
                TransactionDate = DateTime.Now,
                Description = $"Interest Expense - {payable.VendorName}",
                Reference = payable.InvoiceNumber,
                Status = "Posted",
                CreatedBy = "Finance Manager",
                PostedBy = "System",
                PostedAt = DateTime.Now,
                Lines = new List<JournalEntryLine>()
            };

            // Debit: Interest Expense
            journalEntry.Lines.Add(new JournalEntryLine
            {
                AccountCode = "5100",
                AccountName = "Interest Expense",
                Description = $"Savings Interest - {payable.VendorName}",
                DebitAmount = payable.Amount,
                CreditAmount = 0
            });

            // Credit: Interest Payable
            journalEntry.Lines.Add(new JournalEntryLine
            {
                AccountCode = "2200",
                AccountName = "Interest Payable",
                Description = $"Savings Interest - {payable.VendorName}",
                DebitAmount = 0,
                CreditAmount = payable.Amount
            });

            journalEntry.TotalDebit = payable.Amount;
            journalEntry.TotalCredit = payable.Amount;

            await JournalEntryService.CreateAsync(journalEntry);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Interest Journal Entry Error: {ex.Message}");
        }
    }

    private string GetStatusBg(string status)
    {
        return status switch
        {
            "Paid" => "#d1fae5",
            "Pending" => "#fef3c7",
            "Overdue" => "#fee2e2",
            "Partial" => "#dbeafe",
            _ => "#f3f4f6"
        };
    }

    private string GetStatusColor(string status)
    {
        return status switch
        {
            "Paid" => "#065f46",
            "Pending" => "#92400e",
            "Overdue" => "#b91c1c",
            "Partial" => "#1e40af",
            _ => "#4b5563"
        };
    }

    private void ShowNewBillModal()
    {
        newBill = new Models.AccountsPayable 
        { 
            DueDate = DateTime.Today.AddDays(30),
            CreatedAt = DateTime.Now,
            InvoiceNumber = $"AP-{DateTime.Now:yyyyMMdd}-{Random.Shared.Next(1000, 9999)}"
        };
        payableType = "";
        referenceNumber = "";
        isEditingBill = false;
        showBillModal = true;
    }

    private void EditBill(Models.AccountsPayable bill)
    {
        newBill = new Models.AccountsPayable
        {
            PayableId = bill.PayableId,
            VendorName = bill.VendorName,
            InvoiceNumber = bill.InvoiceNumber,
            Amount = bill.Amount,
            DueDate = bill.DueDate,
            Description = bill.Description,
            Status = bill.Status
        };
        isEditingBill = true;
        showBillModal = true;
    }

    private async Task SaveBill()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(payableType) || string.IsNullOrWhiteSpace(newBill.VendorName) || newBill.Amount <= 0)
            {
                errorMessage = "Please fill all required fields (Type, Customer, Amount)";
                return;
            }

            if (isEditingBill && newBill.PayableId > 0)
            {
                newBill.Status = bills.First(b => b.PayableId == newBill.PayableId).Status;
                await AccountsPayableService.UpdateAsync(newBill);
                successMessage = "Bill updated successfully!";
            }
            else
            {
                // Set description based on type
                newBill.Description = $"{payableType} - {newBill.Description ?? ""} | Ref: {referenceNumber ?? "N/A"}";
                newBill.Status = "Pending";
                newBill.OutstandingAmount = newBill.Amount;
                newBill.PaidAmount = 0;
                newBill.CreatedBy = "Finance Manager";
                
                var created = await AccountsPayableService.CreateAsync(newBill);
                
                // Create Journal Entry for AP Creation
                await CreateAPJournalEntry(created, payableType);
                
                successMessage = $"{payableType} liability created with auto-journal entry! Invoice: {created.InvoiceNumber}";
            }

            await LoadBills();
            CloseBillModal();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving bill: {ex.Message}";
        }
    }

    private void CloseBillModal()
    {
        showBillModal = false;
        newBill = new();
        isEditingBill = false;
    }

    private void RecordPayment(Models.AccountsPayable bill)
    {
        selectedBill = bill;
        paymentAmount = bill.OutstandingAmount;
        paymentDate = DateTime.Today;
        showPaymentModal = true;
    }

    private async Task ConfirmPayment()
    {
        if (selectedBill == null) return;
        
        isProcessing = true;
        try
        {
            if (paymentAmount <= 0 || paymentAmount > selectedBill.OutstandingAmount)
            {
                errorMessage = "Invalid payment amount";
                return;
            }

            selectedBill.PaidAmount += paymentAmount;
            selectedBill.OutstandingAmount -= paymentAmount;

            if (selectedBill.OutstandingAmount <= 0)
            {
                selectedBill.Status = "Paid";
                selectedBill.OutstandingAmount = 0;
            }
            else
            {
                selectedBill.Status = "Partially Paid";
            }

            await AccountsPayableService.UpdateAsync(selectedBill);
            
            // Create Journal Entry for Payment
            await CreateAPPaymentJournalEntry(selectedBill, paymentAmount);
            
            successMessage = $"Payment of ₱{paymentAmount:N2} recorded! Journal entry auto-posted.";
            await LoadBills();
            ClosePaymentModal();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error recording payment: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void ClosePaymentModal()
    {
        showPaymentModal = false;
        selectedBill = null;
        paymentAmount = 0;
    }

    private void OpenHistoryModal()
    {
        paymentHistory = bills.Where(b => b.PaidAmount > 0).OrderByDescending(b => b.CreatedAt).ToList();
        showHistoryModal = true;
    }

    private void CloseHistoryModal()
    {
        showHistoryModal = false;
        paymentHistory = null;
    }

    private void ViewInvoice(Models.AccountsPayable bill)
    {
        selectedBillForInvoice = bill;
        showInvoiceModal = true;
    }

    private void CloseInvoiceModal()
    {
        showInvoiceModal = false;
        selectedBillForInvoice = null;
    }

    // ========== JOURNAL ENTRY METHODS ==========
    private async Task CreateAPJournalEntry(Models.AccountsPayable payable, string type)
    {
        try
        {
            var journalEntry = new JournalEntry
            {
                TransactionDate = DateTime.Now,
                Description = $"AP Creation - {type}: {payable.VendorName}",
                Reference = payable.InvoiceNumber,
                Status = "Posted",
                CreatedBy = "Finance Manager",
                PostedBy = "System",
                PostedAt = DateTime.Now,
                Lines = new List<JournalEntryLine>()
            };

            // Debit: Cash/Expense based on type
            var (debitAccount, debitName, debitType) = type switch
            {
                "Customer Deposit" => ("1010", "Cash in Bank", "Asset"),
                "Interest Payable" => ("5100", "Interest Expense", "Expense"),
                "Refund" => ("5200", "Refund Expense", "Expense"),
                "Withdrawal" => ("1010", "Cash in Bank", "Asset"),
                _ => ("5000", "Other Expense", "Expense")
            };

            journalEntry.Lines.Add(new JournalEntryLine
            {
                AccountCode = debitAccount,
                AccountName = debitName,
                Description = $"{type} - {payable.VendorName}",
                DebitAmount = payable.Amount,
                CreditAmount = 0
            });

            // Credit: Accounts Payable (Liability increases)
            journalEntry.Lines.Add(new JournalEntryLine
            {
                AccountCode = "2110",
                AccountName = "Accounts Payable",
                Description = $"{type} - {payable.VendorName}",
                DebitAmount = 0,
                CreditAmount = payable.Amount
            });

            journalEntry.TotalDebit = payable.Amount;
            journalEntry.TotalCredit = payable.Amount;

            await JournalEntryService.CreateAsync(journalEntry);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Journal Entry Error: {ex.Message}");
        }
    }

    private async Task CreateAPPaymentJournalEntry(Models.AccountsPayable payable, decimal paidAmount)
    {
        try
        {
            var journalEntry = new JournalEntry
            {
                TransactionDate = DateTime.Now,
                Description = $"AP Payment - {payable.VendorName}",
                Reference = payable.InvoiceNumber,
                Status = "Posted",
                CreatedBy = "Finance Manager",
                PostedBy = "System",
                PostedAt = DateTime.Now,
                Lines = new List<JournalEntryLine>()
            };

            // Debit: Accounts Payable (Liability decreases)
            journalEntry.Lines.Add(new JournalEntryLine
            {
                AccountCode = "2110",
                AccountName = "Accounts Payable",
                Description = $"Payment to {payable.VendorName}",
                DebitAmount = paidAmount,
                CreditAmount = 0
            });

            // Credit: Cash (Asset decreases)
            journalEntry.Lines.Add(new JournalEntryLine
            {
                AccountCode = "1010",
                AccountName = "Cash in Bank",
                Description = $"Payment to {payable.VendorName}",
                DebitAmount = 0,
                CreditAmount = paidAmount
            });

            journalEntry.TotalDebit = paidAmount;
            journalEntry.TotalCredit = paidAmount;

            await JournalEntryService.CreateAsync(journalEntry);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Payment Journal Entry Error: {ex.Message}");
        }
    }
}
