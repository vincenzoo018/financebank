@page "/finance/payables"
@layout FinanceManagerLayout
@using FinanceBank.Services
@using FinanceBank.Models
@inject AuthService AuthService
@inject AccountsPayableService AccountsPayableService
@inject JournalEntryService JournalEntryService
@inject CustomerBankingService CustomerBankingService
@inject LoanService LoanService

<div style="padding: 24px; max-width: 1400px; margin: 0 auto;">
    <!-- Page Header -->
    <div style="background: linear-gradient(135deg, #059669 0%, #047857 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
            <div style="display: flex; align-items: center; gap: 16px;">
                <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                        <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                        <path d="M12 9v6"></path>
                        <path d="M9 12h6"></path>
                    </svg>
                </div>
                <div>
                    <h1 style="font-size: 28px; font-weight: 700; color: white; margin: 0;">Accounts Payable</h1>
                    <p style="color: rgba(255,255,255,0.8); margin: 4px 0 0 0;">Manage bank liabilities: Savings Interest Payable, Refunds, Customer Payouts</p>
                </div>
            </div>
            <div style="display: flex; gap: 12px;">
                <button @onclick="FetchSavingsInterest"
                    style="display: flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.2); border: 2px solid rgba(255,255,255,0.3); color: white; border-radius: 10px; padding: 10px 20px; cursor: pointer; font-weight: 600; font-size: 14px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6" />
                </svg>
                Fetch Savings Interest
            </button>
            <button @onclick="LoadBills"
                style="display: flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.2); border: 2px solid rgba(255,255,255,0.3); color: white; border-radius: 10px; padding: 10px 20px; cursor: pointer; font-weight: 600; font-size: 14px;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M23 4v6h-6M1 20v-6h6M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15" />
                </svg>
                Refresh
            </button>
            <button @onclick="OpenHistoryModal"
                style="display: flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.2); border: 2px solid rgba(255,255,255,0.3); color: white; border-radius: 10px; padding: 10px 20px; cursor: pointer; font-weight: 600; font-size: 14px;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                Payment History
            </button>
        </div>
    </div>
    </div>

    <!-- Summary Cards -->
    <div
        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 24px;">
        <div
            style="background: linear-gradient(135deg, #ecfdf5, #d1fae5); border-radius: 16px; padding: 24px; border: 2px solid #6ee7b7;">
            <div style="font-size: 13px; color: #047857; font-weight: 600; margin-bottom: 8px; text-transform: uppercase;">
                💰 Total Outstanding</div>
            <div style="font-size: 28px; font-weight: 700; color: #047857;">₱@totalOutstanding.ToString("N2")</div>
            <div style="font-size: 12px; color: #059669; margin-top: 4px;">@pendingBills bills pending</div>
        </div>
        <div
            style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); border-radius: 16px; padding: 24px; border: 2px solid #6ee7b7;">
            <div style="font-size: 13px; color: #047857; font-weight: 600; margin-bottom: 8px; text-transform: uppercase;">
                📅 Due This Month</div>
            <div style="font-size: 28px; font-weight: 700; color: #047857;">₱@dueThisMonth.ToString("N2")</div>
            <div style="font-size: 12px; color: #059669; margin-top: 4px;">@dueSoonCount bills due soon</div>
        </div>
        <div
            style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); border-radius: 16px; padding: 24px; border: 2px solid #6ee7b7;">
            <div style="font-size: 13px; color: #047857; font-weight: 600; margin-bottom: 8px; text-transform: uppercase;">
                ✅ Paid This Month</div>
            <div style="font-size: 28px; font-weight: 700; color: #047857;">₱@paidThisMonth.ToString("N2")</div>
            <div style="font-size: 12px; color: #059669; margin-top: 4px;">@paidCount payments made</div>
        </div>
        <div
            style="background: linear-gradient(135deg, #f0fdf4, #dcfce7); border-radius: 16px; padding: 24px; border: 2px solid #86efac;">
            <div style="font-size: 13px; color: #047857; font-weight: 600; margin-bottom: 8px; text-transform: uppercase;">
                💰 Interest Payable</div>
            <div style="font-size: 28px; font-weight: 700; color: #047857;">@pendingSavingsInterest</div>
            <div style="font-size: 12px; color: #059669; margin-top: 4px;">Savings interest pending</div>
        </div>
    </div>

    <!-- Alerts -->
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div
            style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); border: 1px solid #6ee7b7; color: #065f46; padding: 16px 20px; border-radius: 12px; margin-bottom: 20px; display: flex; align-items: center; gap: 12px; box-shadow: 0 2px 8px rgba(16, 185, 129, 0.15);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <span style="font-weight: 500;">@successMessage</span>
            <button @onclick="() => successMessage = string.Empty"
                style="margin-left: auto; background: none; border: none; color: #065f46; cursor: pointer; font-size: 18px;">×</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div
            style="background: #ecfdf5; border: 1px solid #6ee7b7; color: #047857; padding: 16px 20px; border-radius: 12px; margin-bottom: 20px; display: flex; align-items: center; gap: 12px;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="15" y1="9" x2="9" y2="15"></line>
                <line x1="9" y1="9" x2="15" y2="15"></line>
            </svg>
            <span style="font-weight: 500;">@errorMessage</span>
            <button @onclick="() => errorMessage = string.Empty"
                style="margin-left: auto; background: none; border: none; color: #047857; cursor: pointer; font-size: 18px;">×</button>
        </div>
    }

    <!-- Tab Navigation -->
    <div style="display: flex; gap: 4px; margin-bottom: 24px; background: #f1f5f9; padding: 4px; border-radius: 12px;">
        <button @onclick="() => activeTab = 0"
            style="flex: 1; padding: 12px 20px; border: none; border-radius: 10px; cursor: pointer; font-weight: 600; font-size: 14px; transition: all 0.2s; background: @(activeTab == 0 ? "white" : "transparent"); color: @(activeTab == 0 ? "#059669" : "#64748b"); box-shadow: @(activeTab == 0 ? "0 2px 8px rgba(0,0,0,0.1)" : "none");">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                style="margin-right: 8px; vertical-align: middle;">
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <path d="M12 9v6"></path>
                <path d="M9 12h6"></path>
            </svg>
            All Bills (@bills.Count)
        </button>
        <button @onclick="() => activeTab = 1"
            style="flex: 1; padding: 12px 20px; border: none; border-radius: 10px; cursor: pointer; font-weight: 600; font-size: 14px; transition: all 0.2s; background: @(activeTab == 1 ? "white" : "transparent"); color: @(activeTab == 1 ? "#059669" : "#64748b"); box-shadow: @(activeTab == 1 ? "0 2px 8px rgba(0,0,0,0.1)" : "none");">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                style="margin-right: 8px; vertical-align: middle;">
                <path d="M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6" />
            </svg>
            Pending Interest Review (@pendingInterestPayments.Count)
        </button>
    </div>

    <!-- Pending Savings Interest Payments Tab -->
    @if (activeTab == 1)
    {
        <div
            style="background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden; border: 2px solid #6ee7b7;">
            <div style="background: linear-gradient(135deg, #059669, #047857); color: white; padding: 20px 24px;">
                <h4 style="margin: 0; font-weight: 600; font-size: 18px;">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        style="margin-right: 8px; vertical-align: middle;">
                        <path d="M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6" />
                    </svg>
                    💰 Savings Interest Payable - FM Review Required
                </h4>
                <p style="margin: 6px 0 0 0; opacity: 0.9; font-size: 13px;">Review and approve monthly interest payouts to
                    customers</p>
            </div>

            <div style="padding: 24px;">
                @if (!pendingInterestPayments.Any())
                {
                    <div
                        style="text-align: center; padding: 60px 20px; background: linear-gradient(135deg, #ecfdf5, #d1fae5); border-radius: 16px;">
                        <div
                            style="width: 80px; height: 80px; background: #a7f3d0; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="1.5">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                <polyline points="22 4 12 14.01 9 11.01"></polyline>
                            </svg>
                        </div>
                        <h5 style="color: #047857; margin-top: 20px; font-size: 18px; font-weight: 600;">No Pending Interest
                            Payments</h5>
                        <p style="color: #059669; font-size: 14px; margin-top: 8px;">Click "Fetch Savings Interest" to sync
                            pending interest payouts.</p>
                    </div>
                }
                else
                {
                    <div style="overflow-x: auto;">
                        <table style="width: 100%; border-collapse: separate; border-spacing: 0;">
                            <thead>
                                <tr style="background: #f3f4f6;">
                                    <th
                                        style="padding: 14px 16px; text-align: left; font-weight: 600; color: #374151; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e5e7eb;">
                                        Bill #</th>
                                    <th
                                        style="padding: 14px 16px; text-align: left; font-weight: 600; color: #374151; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e5e7eb;">
                                        Customer</th>
                                    <th
                                        style="padding: 14px 16px; text-align: right; font-weight: 600; color: #374151; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e5e7eb;">
                                        Interest Amount</th>
                                    <th
                                        style="padding: 14px 16px; text-align: center; font-weight: 600; color: #374151; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e5e7eb;">
                                        Due Date</th>
                                    <th
                                        style="padding: 14px 16px; text-align: center; font-weight: 600; color: #374151; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e5e7eb;">
                                        Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var interest in pendingInterestPayments)
                                {
                                    <tr style="border-bottom: 1px solid #e5e7eb;">
                                        <td style="padding: 16px;">
                                            <span
                                                style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); color: #047857; padding: 6px 14px; border-radius: 20px; font-weight: 600; font-size: 13px;">
                                                @interest.InvoiceNumber
                                            </span>
                                        </td>
                                        <td style="padding: 16px;">
                                            <div style="font-weight: 600; color: #1e293b;">@interest.VendorName</div>
                                            <div style="font-size: 12px; color: #64748b;">@(interest.Description ?? "Savings Interest")</div>
                                        </td>
                                        <td style="padding: 16px; text-align: right;">
                                            <span
                                                style="font-weight: 700; color: #047857; font-size: 16px;">₱@interest.Amount.ToString("N2")</span>
                                        </td>
                                        <td style="padding: 16px; text-align: center; color: #475569;">
                                            @interest.DueDate.ToString("MMM dd, yyyy")
                                        </td>
                                        <td style="padding: 16px; text-align: center;">
                                            <button @onclick="() => StartInterestReview(interest)"
                                                style="background: linear-gradient(135deg, #059669, #047857); color: white; border: none; padding: 10px 20px; border-radius: 10px; cursor: pointer; font-weight: 700; font-size: 13px; box-shadow: 0 4px 12px rgba(5, 150, 105, 0.3);">
                                                🔍 Review & Approve
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Main Content Card (All Bills Tab) -->
    @if (activeTab == 0)
    {
        <div style="background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden;">
            <div style="background: linear-gradient(135deg, #059669, #10b981); color: white; padding: 20px 24px;">
                <h4 style="margin: 0; font-weight: 600; font-size: 18px;">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        style="margin-right: 8px; vertical-align: middle;">
                        <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                        <path d="M12 12v4"></path>
                        <path d="M12 8h.01"></path>
                    </svg>
                    Outstanding Bills
                </h4>
                <p style="margin: 6px 0 0 0; opacity: 0.9; font-size: 13px;">Review and manage vendor bills and payments</p>
            </div>

            <div style="padding: 24px;">
                @if (isLoading)
                {
                    <div style="text-align: center; padding: 60px;">
                        <div
                            style="width: 48px; height: 48px; border: 4px solid #e5e7eb; border-top-color: #059669; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto;">
                        </div>
                        <p style="margin-top: 16px; color: #6b7280; font-size: 15px;">Loading bills...</p>
                    </div>
                }
                else if (bills == null || !bills.Any())
                {
                    <div
                        style="text-align: center; padding: 80px 20px; background: linear-gradient(135deg, #f9fafb, #f3f4f6); border-radius: 16px;">
                        <div
                            style="width: 80px; height: 80px; background: #e5e7eb; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5">
                                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                                <path d="M12 9v6"></path>
                                <path d="M9 12h6"></path>
                            </svg>
                        </div>
                        <h5 style="color: #4b5563; margin-top: 20px; font-size: 18px; font-weight: 600;">No Bills Found</h5>
                        <p style="color: #9ca3af; font-size: 14px; margin-top: 8px;">Create your first bill to get started.</p>
                    </div>
                }
                else
                {
                    <div style="overflow-x: auto;">
                        <table style="width: 100%; border-collapse: separate; border-spacing: 0;">
                            <thead>
                                <tr style="background: linear-gradient(135deg, #f8fafc, #f1f5f9);">
                                    <th
                                        style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">
                                        Invoice #</th>
                                    <th
                                        style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">
                                        Vendor</th>
                                    <th
                                        style="padding: 14px 16px; text-align: right; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">
                                        Amount</th>
                                    <th
                                        style="padding: 14px 16px; text-align: right; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">
                                        Outstanding</th>
                                    <th
                                        style="padding: 14px 16px; text-align: center; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">
                                        Due Date</th>
                                    <th
                                        style="padding: 14px 16px; text-align: center; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">
                                        Status</th>
                                    <th
                                        style="padding: 14px 16px; text-align: center; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">
                                        Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var bill in bills)
                                {
                                    <tr style="border-bottom: 1px solid #f1f5f9; transition: all 0.2s;" class="table-row-hover">
                                        <td style="padding: 16px;">
                                            <span
                                                style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); color: #047857; padding: 6px 14px; border-radius: 20px; font-weight: 600; font-size: 13px; display: inline-block;">
                                                @bill.InvoiceNumber
                                            </span>
                                        </td>
                                        <td style="padding: 16px;">
                                            <div style="font-weight: 600; color: #1e293b; font-size: 15px;">@bill.VendorName</div>
                                            <div style="font-size: 12px; color: #64748b; margin-top: 2px;">@(bill.Description ?? "No description")</div>
                                        </td>
                                        <td style="padding: 16px; text-align: right;">
                                            <span
                                                style="font-weight: 700; color: #1e293b; font-size: 15px;">₱@bill.Amount.ToString("N2")</span>
                                        </td>
                                        <td style="padding: 16px; text-align: right;">
                                            <span
                                                style="font-weight: 700; color: @(bill.OutstandingAmount > 0 ? "#047857" : "#059669"); font-size: 15px;">₱@bill.OutstandingAmount.ToString("N2")</span>
                                        </td>
                                        <td style="padding: 16px; text-align: center; color: #475569; font-weight: 500;">
                                            @bill.DueDate.ToString("MMM dd, yyyy")
                                        </td>
                                        <td style="padding: 16px; text-align: center;">
                                            <span
                                                style="display: inline-flex; align-items: center; padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 600; background: @GetStatusBg(bill.Status); color: @GetStatusColor(bill.Status);">
                                                @bill.Status
                                            </span>
                                        </td>
                                        <td style="padding: 16px; text-align: center;">
                                            <div style="display: flex; gap: 8px; justify-content: center;">
                                                @if (bill.Status != "Paid")
                                                {
                                                    <button
                                                        style="background: linear-gradient(135deg, #059669, #10b981); color: white; border: none; padding: 8px 14px; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 12px; box-shadow: 0 2px 8px rgba(5, 150, 105, 0.25); transition: all 0.2s;"
                                                        @onclick="() => RecordPayment(bill)">
                                                        Pay
                                                    </button>
                                                }
                                                <button
                                                    style="background: linear-gradient(135deg, #059669, #047857); color: white; border: none; padding: 8px 14px; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 12px; box-shadow: 0 2px 8px rgba(5, 150, 105, 0.25); transition: all 0.2s;"
                                                    @onclick="() => ViewInvoice(bill)">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                                        stroke="currentColor" stroke-width="2" style="vertical-align: middle;">
                                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                                    </svg>
                                                </button>
                                                <button
                                                    style="background: #f1f5f9; color: #475569; border: none; padding: 8px 14px; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 12px; transition: all 0.2s;"
                                                    @onclick="() => EditBill(bill)">
                                                    Edit
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <!-- Outstanding Loans Section -->
                @if (outstandingLoans.Any())
                {
                    <div style="margin-top: 32px;">
                        <div
                            style="background: linear-gradient(135deg, #ecfdf5, #d1fae5); border-radius: 16px; overflow: hidden; border: 2px solid #6ee7b7;">
                            <div
                                style="background: linear-gradient(135deg, #059669, #047857); color: white; padding: 16px 24px;">
                                <h4
                                    style="margin: 0; font-weight: 600; font-size: 18px; display: flex; align-items: center; gap: 10px;">
                                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2">
                                        <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                                        <path d="M7 10h10M7 14h7"></path>
                                    </svg>
                                    🏦 Outstanding Customer Loans
                                </h4>
                                <p style="margin: 6px 0 0 0; opacity: 0.9; font-size: 13px;">Customers with active loans
                                    requiring payment tracking</p>
                            </div>

                            <div style="padding: 20px;">
                                <div style="overflow-x: auto;">
                                    <table style="width: 100%; border-collapse: separate; border-spacing: 0;">
                                        <thead>
                                            <tr style="background: #f3f4f6;">
                                                <th
                                                    style="padding: 14px 16px; text-align: left; font-weight: 600; color: #374151; font-size: 12px; text-transform: uppercase; border-bottom: 2px solid #e5e7eb;">
                                                    Loan Number</th>
                                                <th
                                                    style="padding: 14px 16px; text-align: left; font-weight: 600; color: #374151; font-size: 12px; text-transform: uppercase; border-bottom: 2px solid #e5e7eb;">
                                                    Customer Name</th>
                                                <th
                                                    style="padding: 14px 16px; text-align: left; font-weight: 600; color: #374151; font-size: 12px; text-transform: uppercase; border-bottom: 2px solid #e5e7eb;">
                                                    Loan Type</th>
                                                <th
                                                    style="padding: 14px 16px; text-align: right; font-weight: 600; color: #374151; font-size: 12px; text-transform: uppercase; border-bottom: 2px solid #e5e7eb;">
                                                    Loan Amount</th>
                                                <th
                                                    style="padding: 14px 16px; text-align: right; font-weight: 600; color: #374151; font-size: 12px; text-transform: uppercase; border-bottom: 2px solid #e5e7eb;">
                                                    Outstanding Balance</th>
                                                <th
                                                    style="padding: 14px 16px; text-align: center; font-weight: 600; color: #374151; font-size: 12px; text-transform: uppercase; border-bottom: 2px solid #e5e7eb;">
                                                    Next Due Date</th>
                                                <th
                                                    style="padding: 14px 16px; text-align: right; font-weight: 600; color: #374151; font-size: 12px; text-transform: uppercase; border-bottom: 2px solid #e5e7eb;">
                                                    Monthly Payment</th>
                                                <th
                                                    style="padding: 14px 16px; text-align: center; font-weight: 600; color: #374151; font-size: 12px; text-transform: uppercase; border-bottom: 2px solid #e5e7eb;">
                                                    Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var loan in outstandingLoans)
                                            {
                                                var isOverdue = loan.NextDueDate.HasValue && loan.NextDueDate.Value <
                                                DateTime.Today;
                                                <tr style="border-bottom: 1px solid #e5e7eb; transition: all 0.2s; background: @(isOverdue ? "#fef2f2" : "white");"
                                                    class="table-row-hover">
                                                    <td style="padding: 16px;">
                                                        <span
                                                            style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); color: #047857; padding: 6px 14px; border-radius: 20px; font-weight: 600; font-size: 13px; display: inline-block;">
                                                            @loan.LoanNumber
                                                        </span>
                                                    </td>
                                                    <td style="padding: 16px;">
                                                        <div style="font-weight: 600; color: #1e293b; font-size: 15px;">
                                                            @(loan.Account?.Customer?.FullName ?? "Unknown Customer")
                                                        </div>
                                                        <div style="font-size: 12px; color: #64748b; margin-top: 2px;">
                                                            Account #@loan.AccountId
                                                        </div>
                                                    </td>
                                                    <td style="padding: 16px;">
                                                        <span
                                                            style="background: #d1fae5; color: #047857; padding: 4px 10px; border-radius: 6px; font-weight: 500; font-size: 12px;">
                                                            @loan.LoanType
                                                        </span>
                                                    </td>
                                                    <td style="padding: 16px; text-align: right;">
                                                        <span style="font-weight: 600; color: #475569; font-size: 14px;">
                                                            ₱@loan.LoanAmount.ToString("N2")
                                                        </span>
                                                    </td>
                                                    <td style="padding: 16px; text-align: right;">
                                                        <span style="font-weight: 700; color: #047857; font-size: 15px;">
                                                            ₱@loan.OutstandingBalance.ToString("N2")
                                                        </span>
                                                    </td>
                                                    <td style="padding: 16px; text-align: center;">
                                                        @if (loan.NextDueDate.HasValue)
                                                        {
                                                            <span
                                                                style="color: @(isOverdue ? "#dc2626" : "#475569"); font-weight: @(isOverdue ? "700" : "500");">
                                                                @loan.NextDueDate.Value.ToString("MMM dd, yyyy")
                                                                @if (isOverdue)
                                                                {
                                                                    <span
                                                                        style="display: block; font-size: 10px; color: #dc2626; font-weight: 600;">⚠️
                                                                        OVERDUE</span>
                                                                }
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span style="color: #9ca3af;">N/A</span>
                                                        }
                                                    </td>
                                                    <td style="padding: 16px; text-align: right;">
                                                        <span style="font-weight: 600; color: #059669; font-size: 14px;">
                                                            ₱@loan.MonthlyPayment.ToString("N2")
                                                        </span>
                                                    </td>
                                                    <td style="padding: 16px; text-align: center;">
                                                        <span
                                                            style="display: inline-flex; align-items: center; padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 600; background: @(isOverdue ? "#fee2e2" : "#d1fae5"); color: @(isOverdue ? "#b91c1c" : "#065f46");">
                                                            @(isOverdue ? "Overdue" : loan.Status)
                                                        </span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <!-- Loan Summary -->
                                <div
                                    style="display: flex; gap: 16px; margin-top: 16px; padding-top: 16px; border-top: 2px dashed #6ee7b7;">
                                    <div
                                        style="flex: 1; background: linear-gradient(135deg, #ecfdf5, #d1fae5); padding: 16px; border-radius: 10px; text-align: center;">
                                        <span
                                            style="font-size: 12px; color: #047857; font-weight: 600; text-transform: uppercase;">Total
                                            Outstanding Loans</span>
                                        <p style="margin: 8px 0 0 0; font-size: 24px; font-weight: 800; color: #059669;">
                                            @outstandingLoans.Count</p>
                                    </div>
                                    <div
                                        style="flex: 1; background: linear-gradient(135deg, #d1fae5, #a7f3d0); padding: 16px; border-radius: 10px; text-align: center;">
                                        <span
                                            style="font-size: 12px; color: #047857; font-weight: 600; text-transform: uppercase;">Total
                                            Outstanding Balance</span>
                                        <p style="margin: 8px 0 0 0; font-size: 24px; font-weight: 800; color: #059669;">
                                            ₱@outstandingLoans.Sum(l => l.OutstandingBalance).ToString("N2")</p>
                                    </div>
                                    <div
                                        style="flex: 1; background: linear-gradient(135deg, #ecfdf5, #d1fae5); padding: 16px; border-radius: 10px; text-align: center;">
                                        <span
                                            style="font-size: 12px; color: #065f46; font-weight: 600; text-transform: uppercase;">Expected
                                            Monthly Collection</span>
                                        <p style="margin: 8px 0 0 0; font-size: 24px; font-weight: 800; color: #059669;">
                                            ₱@outstandingLoans.Sum(l => l.MonthlyPayment).ToString("N2")</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- New/Edit Bill Modal -->
@if (showBillModal)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.6); display: flex; align-items: center; justify-content: center; z-index: 1000; backdrop-filter: blur(4px);"
        @onclick="CloseBillModal">
        <div style="background: white; border-radius: 20px; width: 90%; max-width: 550px; max-height: 90vh; overflow-y: auto; box-shadow: 0 25px 60px rgba(0,0,0,0.3);"
            @onclick:stopPropagation>
            <div
                style="background: linear-gradient(135deg, #059669, #10b981); color: white; padding: 24px 28px; border-radius: 20px 20px 0 0;">
                <h4 style="margin: 0; font-weight: 700; font-size: 20px;">@(isEditingBill ? "Edit Bill" : "Create New Bill")
                </h4>
                <p style="margin: 6px 0 0 0; opacity: 0.9; font-size: 14px;">Enter bill details below</p>
            </div>

            <div style="padding: 28px;">
                <div style="margin-bottom: 20px;">
                    <label
                        style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 8px;">Payable
                        Type <span style="color: #ef4444;">*</span></label>
                    <select @bind="payableType"
                        style="width: 100%; padding: 14px 16px; border: 2px solid #e5e7eb; border-radius: 10px; font-size: 15px; transition: border-color 0.2s; background: white;">
                        <option value="">-- Select Payable Type --</option>
                        <option value="Customer Deposit">💵 Customer Deposit Liability</option>
                        <option value="Interest Payable">📊 Interest Payable to Customer</option>
                        <option value="Refund">🔄 Customer Refund</option>
                        <option value="Withdrawal">💸 Pending Customer Withdrawal</option>
                        <option value="Overpayment">💳 Customer Overpayment</option>
                    </select>
                </div>

                <div style="margin-bottom: 20px;">
                    <label
                        style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 8px;">Customer
                        Name <span style="color: #ef4444;">*</span></label>
                    <input type="text" @bind="newBill.VendorName" placeholder="Enter customer name"
                        style="width: 100%; padding: 14px 16px; border: 2px solid #e5e7eb; border-radius: 10px; font-size: 15px; transition: border-color 0.2s;">
                </div>

                <div style="margin-bottom: 20px;">
                    <label
                        style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 8px;">Invoice
                        Number <span style="color: #ef4444;">*</span></label>
                    <input type="text" @bind="newBill.InvoiceNumber" placeholder="Auto-generated"
                        style="width: 100%; padding: 14px 16px; border: 2px solid #e5e7eb; border-radius: 10px; font-size: 15px;">
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px;">
                    <div>
                        <label
                            style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 8px;">Amount
                            <span style="color: #ef4444;">*</span></label>
                        <input type="number" step="0.01" @bind="newBill.Amount" placeholder="0.00"
                            style="width: 100%; padding: 14px 16px; border: 2px solid #e5e7eb; border-radius: 10px; font-size: 15px;">
                    </div>
                    <div>
                        <label
                            style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 8px;">Due
                            Date <span style="color: #ef4444;">*</span></label>
                        <input type="date" @bind="newBill.DueDate"
                            style="width: 100%; padding: 14px 16px; border: 2px solid #e5e7eb; border-radius: 10px; font-size: 15px;">
                    </div>
                </div>

                <div style="margin-bottom: 20px;">
                    <label
                        style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 8px;">Reference
                        / Account Number</label>
                    <input type="text" @bind="referenceNumber" placeholder="e.g., ACC-123456"
                        style="width: 100%; padding: 14px 16px; border: 2px solid #e5e7eb; border-radius: 10px; font-size: 15px;">
                </div>

                <div style="margin-bottom: 24px;">
                    <label
                        style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 8px;">Description</label>
                    <textarea @bind="newBill.Description" placeholder="Enter payable details"
                        style="width: 100%; padding: 14px 16px; border: 2px solid #e5e7eb; border-radius: 10px; font-size: 15px; min-height: 100px; resize: vertical;"></textarea>
                </div>

                <div
                    style="display: flex; gap: 12px; justify-content: flex-end; padding-top: 20px; border-top: 1px solid #e5e7eb;">
                    <button
                        style="background: #f1f5f9; color: #475569; border: none; padding: 12px 24px; border-radius: 10px; cursor: pointer; font-weight: 600; font-size: 14px;"
                        @onclick="CloseBillModal">Cancel</button>
                    <button
                        style="background: linear-gradient(135deg, #059669, #10b981); color: white; border: none; padding: 12px 28px; border-radius: 10px; cursor: pointer; font-weight: 700; font-size: 14px; box-shadow: 0 4px 12px rgba(5, 150, 105, 0.3);"
                        @onclick="SaveBill">@(isEditingBill ? "Update Bill" : "Create Bill")</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Payment Modal -->
@if (showPaymentModal && selectedBill != null)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.6); display: flex; align-items: center; justify-content: center; z-index: 1000; backdrop-filter: blur(4px);"
        @onclick="ClosePaymentModal">
        <div style="background: white; border-radius: 20px; width: 90%; max-width: 500px; box-shadow: 0 25px 60px rgba(0,0,0,0.3);"
            @onclick:stopPropagation>
            <div
                style="background: linear-gradient(135deg, #059669, #10b981); color: white; padding: 24px 28px; border-radius: 20px 20px 0 0;">
                <h4 style="margin: 0; font-weight: 700; font-size: 20px;">Record Payment</h4>
                <p style="margin: 6px 0 0 0; opacity: 0.9; font-size: 14px;">Invoice: @selectedBill?.InvoiceNumber</p>
            </div>

            <div style="padding: 28px;">
                <div
                    style="background: linear-gradient(135deg, #f0fdf4, #dcfce7); padding: 20px; border-radius: 12px; margin-bottom: 24px; border: 1px solid #bbf7d0;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                        <div>
                            <span
                                style="font-size: 12px; color: #059669; text-transform: uppercase; font-weight: 600;">Vendor</span>
                            <p style="margin: 4px 0 0 0; font-weight: 600; color: #1e293b;">@selectedBill?.VendorName</p>
                        </div>
                        <div>
                            <span
                                style="font-size: 12px; color: #059669; text-transform: uppercase; font-weight: 600;">Outstanding</span>
                            <p style="margin: 4px 0 0 0; font-weight: 700; color: #dc2626; font-size: 18px;">
                                ₱@selectedBill?.OutstandingAmount.ToString("N2")</p>
                        </div>
                    </div>
                </div>

                <div style="margin-bottom: 20px;">
                    <label
                        style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 8px;">Payment
                        Amount <span style="color: #ef4444;">*</span></label>
                    <input type="number" step="0.01" @bind="paymentAmount" placeholder="0.00"
                        style="width: 100%; padding: 14px 16px; border: 2px solid #e5e7eb; border-radius: 10px; font-size: 15px;">
                </div>

                <div style="margin-bottom: 24px;">
                    <label
                        style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 8px;">Payment
                        Date <span style="color: #ef4444;">*</span></label>
                    <input type="date" @bind="paymentDate"
                        style="width: 100%; padding: 14px 16px; border: 2px solid #e5e7eb; border-radius: 10px; font-size: 15px;">
                </div>

                <div
                    style="display: flex; gap: 12px; justify-content: flex-end; padding-top: 20px; border-top: 1px solid #e5e7eb;">
                    <button
                        style="background: #f1f5f9; color: #475569; border: none; padding: 12px 24px; border-radius: 10px; cursor: pointer; font-weight: 600; font-size: 14px;"
                        @onclick="ClosePaymentModal">Cancel</button>
                    <button
                        style="background: linear-gradient(135deg, #059669, #10b981); color: white; border: none; padding: 12px 28px; border-radius: 10px; cursor: pointer; font-weight: 700; font-size: 14px; box-shadow: 0 4px 12px rgba(5, 150, 105, 0.3);"
                        @onclick="ConfirmPayment" disabled="@isProcessing">@(isProcessing ? "Processing..." : "✓ Confirm Payment")</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- History Modal -->
@if (showHistoryModal)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.6); display: flex; align-items: center; justify-content: center; z-index: 1000; backdrop-filter: blur(4px);"
        @onclick="CloseHistoryModal">
        <div style="background: white; border-radius: 20px; width: 95%; max-width: 1100px; max-height: 90vh; overflow: hidden; box-shadow: 0 25px 60px rgba(0,0,0,0.3); display: flex; flex-direction: column;"
            @onclick:stopPropagation>
            <div
                style="background: linear-gradient(135deg, #059669, #10b981); color: white; padding: 24px 28px; display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h4 style="margin: 0; font-weight: 700; font-size: 20px;">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                            style="margin-right: 10px; vertical-align: middle;">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                        Payment History
                    </h4>
                    <p style="margin: 6px 0 0 0; opacity: 0.9; font-size: 14px;">View all payments and invoices</p>
                </div>
                <button @onclick="CloseHistoryModal"
                    style="background: rgba(255,255,255,0.2); border: none; color: white; width: 36px; height: 36px; border-radius: 50%; cursor: pointer; font-size: 20px;">×</button>
            </div>

            <!-- Filter Section -->
            <div style="padding: 20px 24px; background: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                <div style="display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-end;">
                    <!-- Customer Name Search -->
                    <div style="flex: 1; min-width: 200px;">
                        <label
                            style="display: block; font-size: 12px; font-weight: 600; color: #475569; margin-bottom: 6px; text-transform: uppercase;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" style="vertical-align: middle; margin-right: 4px;">
                                <circle cx="11" cy="11" r="8"></circle>
                                <path d="M21 21l-4.35-4.35"></path>
                            </svg>
                            Search Customer
                        </label>
                        <input type="text" @bind="historySearchCustomer" @bind:event="oninput"
                            placeholder="Enter customer name..."
                            style="width: 100%; padding: 10px 14px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px; background: white;" />
                    </div>

                    <!-- Date Range From -->
                    <div style="min-width: 160px;">
                        <label
                            style="display: block; font-size: 12px; font-weight: 600; color: #475569; margin-bottom: 6px; text-transform: uppercase;">
                            From Date
                        </label>
                        <input type="date" @bind="historyDateFrom"
                            style="width: 100%; padding: 10px 14px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px; background: white;" />
                    </div>

                    <!-- Date Range To -->
                    <div style="min-width: 160px;">
                        <label
                            style="display: block; font-size: 12px; font-weight: 600; color: #475569; margin-bottom: 6px; text-transform: uppercase;">
                            To Date
                        </label>
                        <input type="date" @bind="historyDateTo"
                            style="width: 100%; padding: 10px 14px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px; background: white;" />
                    </div>

                    <!-- Payment Status Filter -->
                    <div style="min-width: 150px;">
                        <label
                            style="display: block; font-size: 12px; font-weight: 600; color: #475569; margin-bottom: 6px; text-transform: uppercase;">
                            Payment Status
                        </label>
                        <select @bind="historyStatusFilter"
                            style="width: 100%; padding: 10px 14px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px; background: white; cursor: pointer;">
                            <option value="">All Statuses</option>
                            <option value="Paid">Paid</option>
                            <option value="Partially Paid">Partially Paid</option>
                            <option value="FM Approved">FM Approved</option>
                        </select>
                    </div>

                    <!-- Clear Filters Button -->
                    <div>
                        <button @onclick="ClearHistoryFilters"
                            style="background: #f1f5f9; color: #475569; border: 1px solid #d1d5db; padding: 10px 16px; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 13px; display: flex; align-items: center; gap: 6px;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2">
                                </path>
                            </svg>
                            Clear Filters
                        </button>
                    </div>
                </div>

                <!-- Filter Summary -->
                @if (!string.IsNullOrEmpty(historySearchCustomer) || historyDateFrom.HasValue || historyDateTo.HasValue ||
                            !string.IsNullOrEmpty(historyStatusFilter))
                {
                    <div style="margin-top: 12px; display: flex; flex-wrap: wrap; gap: 8px; align-items: center;">
                        <span style="font-size: 12px; color: #6b7280;">Active Filters:</span>
                        @if (!string.IsNullOrEmpty(historySearchCustomer))
                        {
                            <span
                                style="background: #d1fae5; color: #047857; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 500;">
                                Customer: @historySearchCustomer
                            </span>
                        }
                        @if (historyDateFrom.HasValue)
                        {
                            <span
                                style="background: #dcfce7; color: #166534; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 500;">
                                From: @historyDateFrom.Value.ToString("MMM dd, yyyy")
                            </span>
                        }
                        @if (historyDateTo.HasValue)
                        {
                            <span
                                style="background: #dcfce7; color: #166534; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 500;">
                                To: @historyDateTo.Value.ToString("MMM dd, yyyy")
                            </span>
                        }
                        @if (!string.IsNullOrEmpty(historyStatusFilter))
                        {
                            <span
                                style="background: #d1fae5; color: #047857; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 500;">
                                Status: @historyStatusFilter
                            </span>
                        }
                        <span style="font-size: 12px; color: #6b7280; margin-left: 8px;">
                            (@GetFilteredPaymentHistory().Count results)
                        </span>
                    </div>
                }
            </div>

            <div style="padding: 24px; overflow-y: auto; flex: 1;">
                @{
                    var filteredHistory = GetFilteredPaymentHistory();
                }
                @if (filteredHistory == null || !filteredHistory.Any())
                {
                    <div style="text-align: center; padding: 60px;">
                        <div
                            style="width: 80px; height: 80px; background: #f1f5f9; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            </svg>
                        </div>
                        <h5 style="color: #475569; margin-top: 20px; font-weight: 600;">No Payment History</h5>
                        <p style="color: #94a3b8; font-size: 14px;">No payments have been recorded yet.</p>
                    </div>
                }
                else
                {
                    <div style="overflow-x: auto;">
                        <table style="width: 100%; border-collapse: separate; border-spacing: 0; font-size: 14px;">
                            <thead>
                                <tr style="background: linear-gradient(135deg, #f8fafc, #f1f5f9);">
                                    <th
                                        style="padding: 14px 12px; text-align: left; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">
                                        Invoice #</th>
                                    <th
                                        style="padding: 14px 12px; text-align: left; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">
                                        Vendor</th>
                                    <th
                                        style="padding: 14px 12px; text-align: right; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">
                                        Original Amount</th>
                                    <th
                                        style="padding: 14px 12px; text-align: right; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">
                                        Paid Amount</th>
                                    <th
