    // ========== PAYMENT HISTORY FILTER METHODS ==========
    private List<Models.AccountsPayable> GetFilteredPaymentHistory()
    {
        if (paymentHistory == null) return new List<Models.AccountsPayable>();

        var filtered = paymentHistory.AsEnumerable();

        // Filter by customer name
        if (!string.IsNullOrWhiteSpace(historySearchCustomer))
        {
            filtered = filtered.Where(p =>
            p.VendorName != null &&
            p.VendorName.Contains(historySearchCustomer, StringComparison.OrdinalIgnoreCase));
        }

        // Filter by date range (From)
        if (historyDateFrom.HasValue)
        {
            filtered = filtered.Where(p => p.CreatedAt.Date >= historyDateFrom.Value.Date);
        }

        // Filter by date range (To)
        if (historyDateTo.HasValue)
        {
            filtered = filtered.Where(p => p.CreatedAt.Date <= historyDateTo.Value.Date);
        }

        // Filter by payment status
        if (!string.IsNullOrWhiteSpace(historyStatusFilter))
        {
            filtered = filtered.Where(p => p.Status == historyStatusFilter);
        }

        return filtered.OrderByDescending(p => p.CreatedAt).ToList();
    }

    private void ClearHistoryFilters()
    {
        historySearchCustomer = "";
        historyDateFrom = null;
        historyDateTo = null;
        historyStatusFilter = "";
    }

