                    </div>
                </div>

                <div style="margin-bottom: 20px;">
                    <label style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 8px;">Payment Amount <span style="color: #ef4444;">*</span></label>
                    <input type="number" step="0.01" @bind="paymentAmount" placeholder="0.00" 
                           style="width: 100%; padding: 14px 16px; border: 2px solid #e5e7eb; border-radius: 10px; font-size: 15px;">
                </div>

                <div style="margin-bottom: 24px;">
                    <label style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 8px;">Payment Date <span style="color: #ef4444;">*</span></label>
                    <input type="date" @bind="paymentDate" 
                           style="width: 100%; padding: 14px 16px; border: 2px solid #e5e7eb; border-radius: 10px; font-size: 15px;">
