    private async Task SaveBill()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(payableType) || string.IsNullOrWhiteSpace(newBill.VendorName) || newBill.Amount <= 0)
            {
                errorMessage = "Please fill all required fields (Type, Customer, Amount)";
                return;
            }

            if (isEditingBill && newBill.PayableId > 0)
            {
                newBill.Status = bills.First(b => b.PayableId == newBill.PayableId).Status;
                await AccountsPayableService.UpdateAsync(newBill);
                successMessage = "Bill updated successfully!";
            }
            else
            {
                // Set description based on type
                newBill.Description = $"{payableType} - {newBill.Description ?? ""} | Ref: {referenceNumber ?? "N/A"}";
                newBill.Status = "Pending";
                newBill.OutstandingAmount = newBill.Amount;
                newBill.PaidAmount = 0;
                newBill.CreatedBy = "Finance Manager";

                var created = await AccountsPayableService.CreateAsync(newBill);

                // Create Journal Entry for AP Creation
                await CreateAPJournalEntry(created, payableType);

                successMessage = $"{payableType} liability created with auto-journal entry! Invoice: {created.InvoiceNumber}";
            }

            await LoadBills();
            CloseBillModal();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving bill: {ex.Message}";
        }
    }

