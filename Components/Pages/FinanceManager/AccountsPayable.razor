                        <span style="font-size: 11px; color: #64748b; text-transform: uppercase; font-weight: 600;">Invoice Number</span>
                        <p style="margin: 4px 0 0 0; font-weight: 700; color: #1e293b; font-size: 16px;">@selectedBillForInvoice.InvoiceNumber</p>
