                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                        <div>
                            <span style="font-size: 12px; color: #059669; text-transform: uppercase; font-weight: 600;">Vendor</span>
                            <p style="margin: 4px 0 0 0; font-weight: 600; color: #1e293b;">@selectedBill?.VendorName</p>
                        </div>
                        <div>
                            <span style="font-size: 12px; color: #059669; text-transform: uppercase; font-weight: 600;">Outstanding</span>
