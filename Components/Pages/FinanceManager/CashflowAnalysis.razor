@page "/finance/cashflow-analysis"
@layout FinanceManagerLayout
@using FinanceBank.Services
@using FinanceBank.Models
@using Microsoft.EntityFrameworkCore
@inject FinanceService FinanceService
@inject AuthService AuthService
@inject BFASDbContext DbContext
@inject IJSRuntime JS

<div style="padding: 24px; max-width: 1400px; margin: 0 auto;">
    <!-- Page Header -->
    <div style="background: linear-gradient(135deg, #059669 0%, #047857 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                    <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                </svg>
            </div>
            <div>
                <h1 style="font-size: 28px; font-weight: 700; color: white; margin: 0;">Cashflow Analysis</h1>
                <p style="color: rgba(255,255,255,0.8); margin: 4px 0 0 0;">Track money inflows and outflows from all
                    banking operations</p>
            </div>
        </div>
        <div style="display: flex; gap: 12px;">
            <select @bind="selectedPeriod" @bind:after="LoadCashflowData"
                style="padding: 10px 16px; border-radius: 8px; border: none; background: rgba(255,255,255,0.2); color: white; font-weight: 500;">
                <option value="today" style="color: #111;">Today</option>
                <option value="week" style="color: #111;">This Week</option>
                <option value="month" style="color: #111;">This Month</option>
                <option value="quarter" style="color: #111;">This Quarter</option>
                <option value="year" style="color: #111;">This Year</option>
            </select>
            <button @onclick="ExportCashflow" style="padding: 10px 20px; background: rgba(255,255,255,0.2); border: 2px solid rgba(255,255,255,0.3); border-radius: 8px; color: white; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                Export
            </button>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div style="display: flex; justify-content: center; padding: 60px;">
        <div
            style="width: 50px; height: 50px; border: 4px solid #e5e7eb; border-top-color: #059669; border-radius: 50%; animation: spin 1s linear infinite;">
        </div>
    </div>
}
else
{
    <!-- Summary Cards -->
    <div
        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 24px;">
        <div
            style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); border-radius: 16px; padding: 24px; border: 2px solid #6ee7b7;">
            <div style="font-size: 13px; color: #047857; font-weight: 600; margin-bottom: 8px; text-transform: uppercase;">
                📈 Total Inflows</div>
            <div style="font-size: 32px; font-weight: 700; color: #047857;">₱@totalInflows.ToString("N2")</div>
            <div style="font-size: 12px; color: #059669; margin-top: 4px;">Deposits + Loan Payments</div>
        </div>
        <div
            style="background: linear-gradient(135deg, #f0fdf4, #dcfce7); border-radius: 16px; padding: 24px; border: 2px solid #86efac;">
            <div style="font-size: 13px; color: #047857; font-weight: 600; margin-bottom: 8px; text-transform: uppercase;">
                📉 Total Outflows</div>
            <div style="font-size: 32px; font-weight: 700; color: #047857;">₱@totalOutflows.ToString("N2")</div>
            <div style="font-size: 12px; color: #059669; margin-top: 4px;">Withdrawals + Loan Disbursements</div>
        </div>
        <div
            style="background: linear-gradient(135deg, #ecfdf5, #d1fae5); border-radius: 16px; padding: 24px; border: 2px solid #6ee7b7;">
            <div
                style="font-size: 13px; color: #047857; font-weight: 600; margin-bottom: 8px; text-transform: uppercase;">
                💰 Net Cashflow</div>
            <div style="font-size: 32px; font-weight: 700; color: #047857;">
                @(netCashflow >= 0 ? "+" : "")₱@netCashflow.ToString("N2")</div>
            <div style="font-size: 12px; color: #059669; margin-top: 4px;">@(netCashflow >= 0 ? "Positive cash position" : "Negative cash position")</div>
        </div>
        <div
            style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); border-radius: 16px; padding: 24px; border: 2px solid #6ee7b7;">
            <div style="font-size: 13px; color: #047857; font-weight: 600; margin-bottom: 8px; text-transform: uppercase;">
                📊 Total Transactions</div>
            <div style="font-size: 32px; font-weight: 700; color: #047857;">@totalTransactions</div>
            <div style="font-size: 12px; color: #059669; margin-top: 4px;">All banking operations</div>
        </div>
    </div>

    <!-- Cashflow Breakdown -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px;">
        <!-- Inflows Breakdown -->
        <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
            <h2
                style="font-size: 18px; font-weight: 700; color: #047857; margin: 0 0 20px 0; display: flex; align-items: center; gap: 8px;">
                <span style="width: 10px; height: 10px; background: #10b981; border-radius: 50%;"></span>
                Inflows Breakdown
            </h2>

            <div style="display: flex; flex-direction: column; gap: 16px;">
                <div
                    style="display: flex; justify-content: space-between; align-items: center; padding: 16px; background: #f0fdf4; border-radius: 12px; border-left: 4px solid #10b981;">
                    <div>
                        <div style="font-size: 14px; font-weight: 600; color: #111827;">Customer Deposits</div>
                        <div style="font-size: 12px; color: #6b7280;">@depositCount transactions</div>
                    </div>
                    <div style="font-size: 20px; font-weight: 700; color: #047857;">₱@totalDeposits.ToString("N2")</div>
                </div>

                <div
                    style="display: flex; justify-content: space-between; align-items: center; padding: 16px; background: #f0fdf4; border-radius: 12px; border-left: 4px solid #059669;">
                    <div>
                        <div style="font-size: 14px; font-weight: 600; color: #111827;">Loan Payments Received</div>
                        <div style="font-size: 12px; color: #6b7280;">@loanPaymentCount transactions</div>
                    </div>
                    <div style="font-size: 20px; font-weight: 700; color: #047857;">₱@totalLoanPayments.ToString("N2")</div>
                </div>

                <div
                    style="display: flex; justify-content: space-between; align-items: center; padding: 16px; background: #ecfdf5; border-radius: 12px; border-left: 4px solid #34d399;">
                    <div>
                        <div style="font-size: 14px; font-weight: 600; color: #111827;">Fees & Penalties Collected</div>
                        <div style="font-size: 12px; color: #6b7280;">From all transactions</div>
                    </div>
                    <div style="font-size: 20px; font-weight: 700; color: #047857;">₱@totalFees.ToString("N2")</div>
                </div>
            </div>
        </div>

        <!-- Outflows Breakdown -->
        <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
            <h2
                style="font-size: 18px; font-weight: 700; color: #059669; margin: 0 0 20px 0; display: flex; align-items: center; gap: 8px;">
                <span style="width: 10px; height: 10px; background: #10b981; border-radius: 50%;"></span>
                Outflows Breakdown
            </h2>

            <div style="display: flex; flex-direction: column; gap: 16px;">
                <div
                    style="display: flex; justify-content: space-between; align-items: center; padding: 16px; background: #f0fdf4; border-radius: 12px; border-left: 4px solid #10b981;">
                    <div>
                        <div style="font-size: 14px; font-weight: 600; color: #111827;">Customer Withdrawals</div>
                        <div style="font-size: 12px; color: #6b7280;">@withdrawalCount transactions</div>
                    </div>
                    <div style="font-size: 20px; font-weight: 700; color: #059669;">₱@totalWithdrawals.ToString("N2")</div>
                </div>

                <div
                    style="display: flex; justify-content: space-between; align-items: center; padding: 16px; background: #f0fdf4; border-radius: 12px; border-left: 4px solid #059669;">
                    <div>
                        <div style="font-size: 14px; font-weight: 600; color: #111827;">Loan Disbursements</div>
                        <div style="font-size: 12px; color: #6b7280;">@loanDisbursementCount loans released</div>
                    </div>
                    <div style="font-size: 20px; font-weight: 700; color: #059669;">₱@totalLoanDisbursements.ToString("N2")
                    </div>
                </div>

                <div
                    style="display: flex; justify-content: space-between; align-items: center; padding: 16px; background: #ecfdf5; border-radius: 12px; border-left: 4px solid #047857;">
                    <div>
                        <div style="font-size: 14px; font-weight: 600; color: #111827;">Operating Expenses</div>
                        <div style="font-size: 12px; color: #6b7280;">From budget spending</div>
                    </div>
                    <div style="font-size: 20px; font-weight: 700; color: #047857;">₱@totalOperatingExpenses.ToString("N2")
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Daily Cashflow Chart (Visual) -->
    <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb; margin-bottom: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h2 style="font-size: 18px; font-weight: 700; color: #111827; margin: 0;">Daily Cashflow Trend</h2>
            <div style="display: flex; gap: 16px;">
                <div style="display: flex; align-items: center; gap: 6px;">
                    <span style="width: 12px; height: 12px; background: #10b981; border-radius: 3px;"></span>
                    <span style="font-size: 12px; color: #6b7280;">Inflows</span>
                </div>
                <div style="display: flex; align-items: center; gap: 6px;">
                    <span style="width: 12px; height: 12px; background: #047857; border-radius: 3px;"></span>
                    <span style="font-size: 12px; color: #6b7280;">Outflows</span>
                </div>
            </div>
        </div>

        <div
            style="display: flex; align-items: flex-end; gap: 12px; height: 200px; padding-bottom: 30px; position: relative;">
            @if (dailyCashflow.Any())
            {
                var maxValue = dailyCashflow.Max(d => Math.Max(d.Inflow, d.Outflow));
                @foreach (var day in dailyCashflow)
                {
                    var inflowHeight = maxValue > 0 ? (day.Inflow / maxValue * 160) : 0;
                    var outflowHeight = maxValue > 0 ? (day.Outflow / maxValue * 160) : 0;
                    <div style="flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4px;">
                        <div style="display: flex; gap: 3px; align-items: flex-end; height: 160px;">
                            <div
                                style="width: 20px; background: linear-gradient(180deg, #10b981, #059669); border-radius: 4px 4px 0 0; height: @(inflowHeight)px; transition: height 0.3s;">
                            </div>
                            <div
                                style="width: 20px; background: linear-gradient(180deg, #047857, #059669); border-radius: 4px 4px 0 0; height: @(outflowHeight)px; transition: height 0.3s;">
                            </div>
                        </div>
                        <span
                            style="font-size: 11px; color: #6b7280; position: absolute; bottom: 0;">@day.Date.ToString("MM/dd")</span>
                    </div>
                }
            }
            else
            {
                <div style="flex: 1; display: flex; align-items: center; justify-content: center; color: #6b7280;">
                    No data available for the selected period
                </div>
            }
        </div>
    </div>

    <!-- Recent Cashflow Entries -->
    <div style="background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden;">
        <div
            style="background: linear-gradient(135deg, #059669, #047857); color: white; padding: 20px 24px; display: flex; justify-content: space-between; align-items: center;">
            <h2 style="margin: 0; font-size: 18px; font-weight: 600;">Recent Cash Movements</h2>
            <button @onclick="ShowAddEntryModal"
                style="padding: 8px 16px; background: rgba(255,255,255,0.2); border: 2px solid rgba(255,255,255,0.3); border-radius: 8px; color: white; font-weight: 500; cursor: pointer;">
                + Add Manual Entry
            </button>
        </div>

        <div style="padding: 24px; max-height: 500px; overflow-y: auto;">
            @if (!recentCashflows.Any())
            {
                <div style="text-align: center; padding: 40px; color: #6b7280;">
                    No cash movements recorded yet.
                </div>
            }
            else
            {
                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background: #f3f4f6;">
                            <th style="padding: 12px; text-align: left; font-weight: 600; color: #374151;">Date</th>
                            <th style="padding: 12px; text-align: left; font-weight: 600; color: #374151;">Type</th>
                            <th style="padding: 12px; text-align: left; font-weight: 600; color: #374151;">Category</th>
                            <th style="padding: 12px; text-align: left; font-weight: 600; color: #374151;">Description</th>
                            <th style="padding: 12px; text-align: right; font-weight: 600; color: #374151;">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in recentCashflows.Take(20))
                        {
                            var isInflow = entry.EntryType == "Inflow";
                            <tr style="border-bottom: 1px solid #e5e7eb;">
                                <td style="padding: 12px; color: #6b7280;">@entry.TransactionDate.ToString("MMM dd, yyyy HH:mm")
                                </td>
                                <td style="padding: 12px;">
                                    <span
                                        style="padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; @(isInflow ? "background: #d1fae5; color: #047857;" : "background: #ecfdf5; color: #047857;")">
                                        @(isInflow ? "↑ Inflow" : "↓ Outflow")
                                    </span>
                                </td>
                                <td style="padding: 12px; color: #374151; font-weight: 500;">@entry.Category</td>
                                <td style="padding: 12px; color: #6b7280;">@(entry.Description ?? "-")</td>
                                <td
                                    style="padding: 12px; text-align: right; font-weight: 600; color: @(isInflow ? "#047857" : "#047857");">
                                    @(isInflow ? "+" : "-")₱@entry.Amount.ToString("N2")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

<!-- Add Manual Entry Modal -->
@if (showAddModal)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.6); display: flex; align-items: center; justify-content: center; z-index: 1000; backdrop-filter: blur(4px);"
        @onclick="CloseAddModal">
        <div style="background: white; border-radius: 20px; width: 90%; max-width: 500px; box-shadow: 0 25px 50px rgba(0,0,0,0.25);"
            @onclick:stopPropagation>
            <div style="background: linear-gradient(135deg, #059669, #047857); padding: 24px; color: white;">
                <h2 style="margin: 0; font-size: 20px; font-weight: 700;">Add Manual Cashflow Entry</h2>
            </div>

            <div style="padding: 24px;">
                <div style="display: grid; gap: 20px;">
                    <div>
                        <label
                            style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Entry
                            Type *</label>
                        <select @bind="newEntry.EntryType" class="form-control">
                            <option value="Inflow">Inflow (Money In)</option>
                            <option value="Outflow">Outflow (Money Out)</option>
                        </select>
                    </div>

                    <div>
                        <label
                            style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Category
                            *</label>
                        <select @bind="newEntry.Category" class="form-control">
                            <option value="">Select Category</option>
                            <option value="Customer Deposit">Customer Deposit</option>
                            <option value="Customer Withdrawal">Customer Withdrawal</option>
                            <option value="Loan Payment">Loan Payment</option>
                            <option value="Loan Disbursement">Loan Disbursement</option>
                            <option value="Operating Expense">Operating Expense</option>
                            <option value="Salary Payment">Salary Payment</option>
                            <option value="Utility Payment">Utility Payment</option>
                            <option value="Maintenance">Maintenance</option>
                            <option value="Interest Income">Interest Income</option>
                            <option value="Fee Income">Fee Income</option>
                            <option value="Other Income">Other Income</option>
                            <option value="Other Expense">Other Expense</option>
                        </select>
                    </div>

                    <div>
                        <label
                            style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Amount
                            *</label>
                        <div style="position: relative;">
                            <span
                                style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #6b7280;">₱</span>
                            <input type="number" @bind="newEntry.Amount" class="form-control" style="padding-left: 30px;"
                                placeholder="0.00" step="0.01" />
                        </div>
                    </div>

                    <div>
                        <label
                            style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Transaction
                            Date</label>
                        <input type="datetime-local" @bind="newEntry.TransactionDate" class="form-control" />
                    </div>

                    <div>
                        <label
                            style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Description</label>
                        <textarea @bind="newEntry.Description" class="form-control" rows="2"
                            placeholder="Optional notes..."></textarea>
                    </div>
                </div>

                <div style="display: flex; gap: 12px; margin-top: 24px;">
                    <button @onclick="SaveEntry"
                        style="flex: 1; padding: 14px; background: linear-gradient(135deg, #059669, #047857); color: white; border: none; border-radius: 10px; font-weight: 600; cursor: pointer;">
                        Save Entry
                    </button>
                    <button @onclick="CloseAddModal"
                        style="padding: 14px 24px; background: #f3f4f6; color: #374151; border: none; border-radius: 10px; font-weight: 600; cursor: pointer;">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>
</div>

@code {
    private bool isLoading = true;
    private string selectedPeriod = "month";
    private bool showAddModal = false;
    private CashflowEntry newEntry = new();

    // Summary metrics
    private decimal totalInflows = 0;
    private decimal totalOutflows = 0;
    private decimal netCashflow => totalInflows - totalOutflows;
    private int totalTransactions = 0;

    // Inflows breakdown
    private decimal totalDeposits = 0;
    private int depositCount = 0;
    private decimal totalLoanPayments = 0;
    private int loanPaymentCount = 0;
    private decimal totalFees = 0;

    // Outflows breakdown
    private decimal totalWithdrawals = 0;
    private int withdrawalCount = 0;
    private decimal totalLoanDisbursements = 0;
    private int loanDisbursementCount = 0;
    private decimal totalOperatingExpenses = 0;

    // Data lists
    private List<CashflowEntry> recentCashflows = new();
    private List<DailyCashflow> dailyCashflow = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCashflowData();
    }

    private async Task LoadCashflowData()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var (startDate, endDate) = GetDateRange();

            // Load actual banking transactions
            var transactions = await DbContext.CustomerTransactions
            .Where(t => t.CreatedAt >= startDate && t.CreatedAt <= endDate)
            .ToListAsync();

            // Load loan payments
            var loanPayments = await DbContext.LoanPayments
            .Where(p => p.PaymentDate >= startDate && p.PaymentDate <= endDate)
            .ToListAsync();

            // Load loan disbursements
            var loanDisbursements = await DbContext.LoanDisbursals
            .Where(d => d.DisbursalDate >= startDate && d.DisbursalDate <= endDate)
            .ToListAsync();

            // Load manual cashflow entries
            var manualEntries = await DbContext.CashflowEntries
            .Where(e => e.TransactionDate >= startDate && e.TransactionDate <= endDate)
            .OrderByDescending(e => e.TransactionDate)
            .ToListAsync();

            // Calculate inflows
            var deposits = transactions.Where(t => t.TransactionType == "Deposit").ToList();
            totalDeposits = deposits.Sum(t => t.Amount);
            depositCount = deposits.Count;

            totalLoanPayments = loanPayments.Sum(p => p.PaymentAmount);
            loanPaymentCount = loanPayments.Count;

            totalFees = transactions.Sum(t => t.Fee) + loanPayments.Sum(p => p.PenaltyPaid);

            // Calculate outflows
            var withdrawals = transactions.Where(t => t.TransactionType == "Withdrawal").ToList();
            totalWithdrawals = withdrawals.Sum(t => t.Amount);
            withdrawalCount = withdrawals.Count;

            totalLoanDisbursements = loanDisbursements.Sum(d => d.DisbursalAmount);
            loanDisbursementCount = loanDisbursements.Count;

            // Operating expenses from manual entries
            totalOperatingExpenses = manualEntries.Where(e => e.EntryType == "Outflow").Sum(e => e.Amount);

            // Totals
            totalInflows = totalDeposits + totalLoanPayments + totalFees + manualEntries.Where(e => e.EntryType == "Inflow").Sum(e
            => e.Amount);
            totalOutflows = totalWithdrawals + totalLoanDisbursements + totalOperatingExpenses;
            totalTransactions = depositCount + withdrawalCount + loanPaymentCount + loanDisbursementCount + manualEntries.Count;

            // Build combined recent cashflows list
            recentCashflows = new List<CashflowEntry>();

            // Add deposits as inflows
            foreach (var deposit in deposits)
            {
                recentCashflows.Add(new CashflowEntry
                {
                    EntryType = "Inflow",
                    Category = "Customer Deposit",
                    Amount = deposit.Amount,
                    Description = $"Deposit - {deposit.TransactionNumber}",
                    TransactionDate = deposit.CreatedAt
                });
            }

            // Add withdrawals as outflows
            foreach (var withdrawal in withdrawals)
            {
                recentCashflows.Add(new CashflowEntry
                {
                    EntryType = "Outflow",
                    Category = "Customer Withdrawal",
                    Amount = withdrawal.Amount,
                    Description = $"Withdrawal - {withdrawal.TransactionNumber}",
                    TransactionDate = withdrawal.CreatedAt
                });
            }

            // Add loan payments as inflows
            foreach (var payment in loanPayments)
            {
                recentCashflows.Add(new CashflowEntry
                {
                    EntryType = "Inflow",
                    Category = "Loan Payment",
                    Amount = payment.PaymentAmount,
                    Description = $"Loan Payment - Reference: {payment.Reference ?? "N/A"}",
                    TransactionDate = payment.PaymentDate
                });
            }

            // Add loan disbursements as outflows
            foreach (var disbursal in loanDisbursements)
            {
                recentCashflows.Add(new CashflowEntry
                {
                    EntryType = "Outflow",
                    Category = "Loan Disbursement",
                    Amount = disbursal.DisbursalAmount,
                    Description = $"Loan Release - {disbursal.Reference ?? "N/A"}",
                    TransactionDate = disbursal.DisbursalDate
                });
            }

            // Add manual entries
            recentCashflows.AddRange(manualEntries);

            // Sort by date descending
            recentCashflows = recentCashflows.OrderByDescending(e => e.TransactionDate).ToList();

            // Calculate daily cashflow for chart
            var allDates = Enumerable.Range(0, (endDate - startDate).Days + 1)
            .Select(d => startDate.AddDays(d).Date)
            .ToList();

            dailyCashflow = allDates.Select(date => new DailyCashflow
            {
                Date = date,
                Inflow = recentCashflows.Where(e => e.TransactionDate.Date == date && e.EntryType == "Inflow").Sum(e => e.Amount),
                Outflow = recentCashflows.Where(e => e.TransactionDate.Date == date && e.EntryType == "Outflow").Sum(e => e.Amount)
            }).TakeLast(14).ToList(); // Last 14 days for chart
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading cashflow data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private (DateTime startDate, DateTime endDate) GetDateRange()
    {
        var today = DateTime.Today;
        return selectedPeriod switch
        {
            "today" => (today, today.AddDays(1).AddSeconds(-1)),
            "week" => (today.AddDays(-7), today.AddDays(1).AddSeconds(-1)),
            "month" => (today.AddMonths(-1), today.AddDays(1).AddSeconds(-1)),
            "quarter" => (today.AddMonths(-3), today.AddDays(1).AddSeconds(-1)),
            "year" => (today.AddYears(-1), today.AddDays(1).AddSeconds(-1)),
            _ => (today.AddMonths(-1), today.AddDays(1).AddSeconds(-1))
        };
    }

    private void ShowAddEntryModal()
    {
        newEntry = new CashflowEntry
        {
            EntryType = "Outflow",
            TransactionDate = DateTime.Now,
            CreatedBy = AuthService.CurrentUser
        };
        showAddModal = true;
    }

    private async Task SaveEntry()
    {
        if (string.IsNullOrWhiteSpace(newEntry.Category) || newEntry.Amount <= 0)
        {
            return;
        }

        try
        {
            newEntry.CreatedAt = DateTime.Now;
            await FinanceService.CreateCashflowEntryAsync(newEntry);
            await LoadCashflowData();
            CloseAddModal();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving entry: {ex.Message}");
        }
    }

    private void CloseAddModal()
    {
        showAddModal = false;
        newEntry = new();
    }

    private async Task ExportCashflow()
    {
        try
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine("CASHFLOW ANALYSIS REPORT");
            sb.AppendLine($"Period: {selectedPeriod}");
            sb.AppendLine($"Generated: {DateTime.Now:yyyy-MM-dd HH:mm:ss}");
            sb.AppendLine();
            sb.AppendLine("SUMMARY");
            sb.AppendLine($"Total Inflows,{totalInflows:N2}");
            sb.AppendLine($"Total Outflows,{totalOutflows:N2}");
            sb.AppendLine($"Net Cashflow,{netCashflow:N2}");
            sb.AppendLine($"Total Transactions,{totalTransactions}");
            sb.AppendLine();
            sb.AppendLine("TRANSACTIONS");
            sb.AppendLine("Date,Type,Category,Description,Amount");

            foreach (var entry in recentCashflows)
            {
                var sign = entry.EntryType == "Inflow" ? "+" : "-";
                sb.AppendLine($"{entry.TransactionDate:yyyy-MM-dd HH:mm},{entry.EntryType},{entry.Category},\"{entry.Description}\",{sign}{entry.Amount:N2}");
            }

            var content = sb.ToString();
            var fileName = $"Cashflow_Analysis_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
            var bytes = System.Text.Encoding.UTF8.GetBytes(content);
            var base64 = Convert.ToBase64String(bytes);

            await JS.InvokeVoidAsync("downloadFile", fileName, "text/csv", base64);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error exporting cashflow: {ex.Message}");
        }
    }

    private class DailyCashflow
    {
        public DateTime Date { get; set; }
        public decimal Inflow { get; set; }
        public decimal Outflow { get; set; }
    }
}