@page "/customer/accounts"
@layout CustomerLayout
@using FinanceBank.Services
@using FinanceBank.Models
@inject CustomerAccountService Service
@inject AuthService Auth

<div class="section-header">
    <h2 class="section-title">My Accounts</h2>
</div>

<div style="display:grid; gap:16px;">
    @foreach (var a in accounts)
    {
        <div style="background:white; border-radius:16px; padding:24px; border:1px solid var(--border);">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <div>
                    <div style="font-size:14px; color:var(--text-light);">@a.AccountType</div>
                    <div style="font-size:24px; font-weight:700;">₱@a.Balance.ToString("N2")</div>
                    <div style="font-size:12px; color:var(--text-light);">@a.AccountNumber</div>
                </div>
                <a class="btn" style="background:#3b82f6; color:white; padding:8px 16px;" href="/customer/transactions?accountId=@a.AccountId">View Transactions</a>
            </div>
        </div>
    }
</div>

@code {
    private List<CustomerAccount> accounts = new();

    protected override async Task OnInitializedAsync()
    {
        var userId = Auth.CurrentUserId ?? 0;
        accounts = await Service.GetByCustomerIdAsync(userId);
    }
}

