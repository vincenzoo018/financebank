@page "/customer/savings-withdrawal"
@layout CustomerLayout
@using FinanceBank.Services
@using FinanceBank.Models
@inject AuthService AuthService
@inject SavingsAccountService SavingsService

<div style="padding: 24px; max-width: 1200px; margin: 0 auto;">
    <!-- Header -->
    <div style="background: #2F3E2A; border-radius: 14px; padding: 24px; margin-bottom: 24px; color: #FFFFFF;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div
                style="width: 56px; height: 56px; background: rgba(255,255,255,0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                <svg width="28" height="28" fill="none" stroke="#FFFFFF" stroke-width="2">
                    <path
                        d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <div style="flex: 1;">
                <h1 style="font-size: 26px; font-weight: 600; margin: 0;">Request Savings Withdrawal</h1>
                <p style="margin: 6px 0 0; opacity: 0.9;">Submit withdrawal request for approval</p>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div
            style="background: rgba(95, 111, 82, 0.2); border: 1px solid #A9B388; color: #2F3E2A; padding: 20px; border-radius: 12px; margin-bottom: 20px; white-space: pre-line;">
            @successMessage
            <div style="margin-top: 16px;">
                <button @onclick="ResetForm"
                    style="background: #5F6F52; color: #FFFFFF; border: none; padding: 10px 20px; border-radius: 10px; cursor: pointer; font-weight: 600;">Request
                    Another Withdrawal</button>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div
            style="background: rgba(155, 58, 58, 0.1); border: 1px solid #E2E2DC; color: #9B3A3A; padding: 20px; border-radius: 12px; margin-bottom: 20px; white-space: pre-line;">
            @errorMessage
        </div>
    }

    <!-- My Savings Accounts -->
    <div
        style="background: #FFFFFF; border-radius: 14px; padding: 24px; margin-bottom: 24px; border: 1px solid #E2E2DC;">
        <h3 style="margin: 0 0 16px; font-weight: 600; color: #2B2B2B;">Select Savings Account</h3>

        @if (isLoadingAccounts)
        {
            <div style="text-align: center; padding: 40px;">
                <div
                    style="width: 40px; height: 40px; border: 3px solid #E2E2DC; border-top-color: #5F6F52; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto;">
                </div>
            </div>
        }
        else if (!myAccounts.Any())
        {
            <div style="text-align: center; padding: 40px; color: #6B6B6B;">
                <p>You don't have any active savings accounts</p>
            </div>
        }
        else
        {
            <div style="display: grid; gap: 16px;">
                @foreach (var account in myAccounts)
                {
                    var isSelected = selectedAccountId == account.SavingsAccountId;
                    <div @onclick="() => SelectAccount(account)"
                        style="padding: 20px; border: 2px solid @(isSelected ? "#5F6F52" : "#E2E2DC"); border-radius: 12px; cursor: pointer; transition: all 0.3s; background: @(isSelected ? "rgba(95, 111, 82, 0.1)" : "#FFFFFF");">
                        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 12px;">
                            <div>
                                <div style="font-weight: 600; font-size: 18px; color: #2B2B2B;">@account.AccountNumber</div>
                                <div style="font-size: 13px; color: #6B6B6B; margin-top: 4px;">@account.AccountTypeName</div>
                            </div>
                            <div style="text-align: right;">
                                <div style="font-size: 24px; font-weight: 600; color: #5F6F52;">₱@account.Balance.ToString("N2")
                                </div>
                                <div style="font-size: 11px; color: #6B6B6B;">Available Balance</div>
                            </div>
                        </div>
                        <div
                            style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; padding-top: 12px; border-top: 1px solid #E2E2DC;">
                            <div>
                                <div style="font-size: 11px; color: #6B6B6B;">Interest Rate</div>
                                <div style="font-weight: 600; color: #2B2B2B;">@account.CurrentInterestRate%</div>
                            </div>
                            <div>
                                <div style="font-size: 11px; color: #6B6B6B;">Lock-In Days</div>
                                <div style="font-weight: 600; color: #2B2B2B;">@account.LockInPeriodDays days</div>
                            </div>
                            <div>
                                <div style="font-size: 11px; color: #6B6B6B;">Maturity Date</div>
                                <div style="font-weight: 600; color: #2B2B2B;">@(account.MaturityDate?.ToString("MMM dd, yyyy")
                                                                ?? "None")</div>
                            </div>
                        </div>
                        @if (account.IsBeforeMaturity)
                        {
                            <div style="margin-top: 12px; padding: 10px; background: rgba(95, 111, 82, 0.15); border-radius: 10px;">
                                <span style="color: #5F6F52; font-size: 12px; font-weight: 600;">⚠️ Early withdrawal penalty may
                                    apply</span>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <!-- Withdrawal Request Form -->
    @if (selectedAccountId > 0)
    {
        <div style="background: #FFFFFF; border-radius: 14px; padding: 32px; border: 1px solid #E2E2DC;">
            <h3 style="margin: 0 0 24px; font-weight: 600; color: #2B2B2B;">Withdrawal Details</h3>

            <div style="margin-bottom: 24px;">
                <label style="display: block; font-weight: 600; color: #2B2B2B; margin-bottom: 8px;">Withdrawal Amount
                    (₱)</label>
                <input type="number" step="0.01" min="0" @bind="requestedAmount" @bind:event="oninput"
                    @onkeyup="CalculateWithdrawal"
                    style="width: 100%; padding: 14px; border: 2px solid #E2E2DC; border-radius: 10px; font-size: 16px; font-weight: 600;"
                    placeholder="0.00" />
                @if (requestedAmount > 0 && requestedAmount > selectedAccount!.Balance)
                {
                    <div style="margin-top: 8px; color: #9B3A3A; font-size: 13px;">⚠️ Amount exceeds available balance</div>
                }
            </div>

            <div style="margin-bottom: 24px;">
                <label style="display: block; font-weight: 600; color: #2B2B2B; margin-bottom: 8px;">Reason for Withdrawal
                    (Optional)</label>
                <textarea @bind="withdrawalReason" rows="3"
                    style="width: 100%; padding: 12px; border: 2px solid #E2E2DC; border-radius: 10px; font-size: 14px; resize: vertical;"
                    placeholder="Provide a reason for this withdrawal request..."></textarea>
            </div>

            @if (requestedAmount > 0)
            {
                <div
                    style="background: rgba(95, 111, 82, 0.1); border: 2px solid #5F6F52; border-radius: 12px; padding: 20px; margin-bottom: 24px;">
                    <h4 style="margin: 0 0 16px; font-weight: 600; color: #5F6F52;">Withdrawal Summary</h4>

                    <div style="display: grid; gap: 12px;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="color: #6B6B6B;">Requested Amount:</span>
                            <span
                                style="font-size: 18px; font-weight: 600; color: #2B2B2B;">₱@requestedAmount.ToString("N2")</span>
                        </div>

                        @if (isEarlyWithdrawal)
                        {
                            <div
                                style="display: flex; justify-content: space-between; align-items: center; padding-top: 12px; border-top: 1px solid #5F6F52;">
                                <span style="color: #9B3A3A; font-weight: 600;">⚠️ Early Withdrawal Penalty (@penaltyRate%):</span>
                                <span
                                    style="font-size: 16px; font-weight: 600; color: #9B3A3A;">-₱@penaltyAmount.ToString("N2")</span>
                            </div>

                            @if (interestForfeited > 0)
                            {
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <span style="color: #9B3A3A; font-weight: 600;">Interest Forfeited:</span>
                                    <span
                                        style="font-size: 16px; font-weight: 600; color: #9B3A3A;">-₱@interestForfeited.ToString("N2")</span>
                                </div>
                            }
                        }

                        <div
                            style="display: flex; justify-content: space-between; align-items: center; padding-top: 12px; border-top: 2px solid #5F6F52;">
                            <span style="font-weight: 600; color: #2B2B2B; font-size: 16px;">Net Withdrawal Amount:</span>
                            <span
                                style="font-size: 22px; font-weight: 600; color: #5F6F52;">₱@netWithdrawalAmount.ToString("N2")</span>
                        </div>

                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="color: #6B6B6B;">Remaining Balance:</span>
                            <span style="font-weight: 600; color: #2B2B2B;">₱@(selectedAccount!.Balance -
                                                        requestedAmount).ToString("N2")</span>
                        </div>
                    </div>

                    @if (isEarlyWithdrawal)
                    {
                        <div style="margin-top: 16px; padding: 12px; background: rgba(155, 58, 58, 0.1); border-radius: 10px;">
                            <p style="margin: 0; color: #9B3A3A; font-size: 13px; font-weight: 600;">
                                ⚠️ This is an early withdrawal before maturity date. Penalty charges will apply.
                            </p>
                        </div>
                    }
                </div>
            }

            <div style="display: flex; gap: 12px; justify-content: flex-end;">
                <button @onclick="ResetForm"
                    style="background: #F7F7F4; color: #6B6B6B; border: 2px solid #E2E2DC; padding: 14px 28px; border-radius: 10px; font-weight: 600; cursor: pointer;">
                    Cancel
                </button>
                <button @onclick="SubmitWithdrawalRequest" disabled="@(!CanSubmit())"
                    style="background: @(CanSubmit() ? "#2F3E2A" : "#E2E2DC"); color: @(CanSubmit() ? "#FFFFFF" : "#9ca3af"); border: none; padding: 14px 28px; border-radius: 10px; font-weight: 600; cursor: @(CanSubmit() ? "pointer" : "not-allowed");">
                    @if (isSubmitting)
                    {
                        <span>⏳ Submitting...</span>
                    }
                    else
                    {
                        <span>💳 Submit Withdrawal Request</span>
                    }
                </button>
            </div>
        </div>
    }
</div>

<style>
    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

@code {
    private List<SavingsAccountInfo> myAccounts = new();
    private SavingsAccountInfo? selectedAccount = null;
    private int selectedAccountId = 0;
    private decimal requestedAmount = 0;
    private string withdrawalReason = "";

    private bool isEarlyWithdrawal = false;
    private decimal penaltyAmount = 0;
    private decimal penaltyRate = 0;
    private decimal interestForfeited = 0;
    private decimal netWithdrawalAmount = 0;

    private bool isLoadingAccounts = true;
    private bool isSubmitting = false;
    private string successMessage = "";
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadMyAccounts();
    }

    private async Task LoadMyAccounts()
    {
        isLoadingAccounts = true;
        try
        {
            var customerId = AuthService.CurrentUserId ?? 0;
            if (customerId == 0)
            {
                errorMessage = "User not authenticated";
                return;
            }
            var accounts = await SavingsService.GetSavingsAccountsByCustomerAsync(customerId);

            myAccounts = accounts.Where(a => a.Status == "ACTIVE")
            .Select(a => new SavingsAccountInfo
            {
                SavingsAccountId = a.SavingsAccountId,
                AccountNumber = a.AccountNumber,
                AccountTypeName = a.AccountType?.TypeName ?? "Unknown",
                Balance = a.Balance,
                CurrentInterestRate = a.CurrentInterestRate,
                LockInPeriodDays = a.LockInPeriodDays,
                MaturityDate = a.MaturityDate,
                OpenedDate = a.OpenedDate,
                IsBeforeMaturity = a.MaturityDate.HasValue && DateTime.Now < a.MaturityDate.Value
            })
            .ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading accounts: {ex.Message}";
        }
        finally
        {
            isLoadingAccounts = false;
        }
    }

    private void SelectAccount(SavingsAccountInfo account)
    {
        selectedAccount = account;
        selectedAccountId = account.SavingsAccountId;
        requestedAmount = 0;
        errorMessage = "";
        CalculateWithdrawal();
    }

    private void CalculateWithdrawal()
    {
        if (selectedAccount == null || requestedAmount <= 0)
        {
            penaltyAmount = 0;
            interestForfeited = 0;
            netWithdrawalAmount = 0;
            isEarlyWithdrawal = false;
            return;
        }

        isEarlyWithdrawal = selectedAccount.IsBeforeMaturity;

        if (isEarlyWithdrawal)
        {
            // Calculate penalty (typically 2% of withdrawal amount)
            penaltyRate = 2.00m; // Get from account type settings
            penaltyAmount = requestedAmount * (penaltyRate / 100);

            // Forfeited interest (could be calculated from accrued interest)
            interestForfeited = 0; // Simplified - should query actual accrued interest

            netWithdrawalAmount = requestedAmount - penaltyAmount - interestForfeited;
        }
        else
        {
            penaltyAmount = 0;
            interestForfeited = 0;
            netWithdrawalAmount = requestedAmount;
        }
    }

    private bool CanSubmit()
    {
        return selectedAccountId > 0 &&
        requestedAmount > 0 &&
        requestedAmount <= selectedAccount!.Balance &&
        !isSubmitting;
    }

    private async Task SubmitWithdrawalRequest()
    {
        if (!CanSubmit()) return;

        isSubmitting = true;
        errorMessage = "";
        successMessage = "";

        try
        {
            var customerId = AuthService.CurrentUserId ?? 0;
            if (customerId == 0)
            {
                errorMessage = "User not authenticated";
                return;
            }
            var result = await SavingsService.CreateWithdrawalRequestAsync(
            selectedAccountId,
            customerId,
            requestedAmount,
            withdrawalReason
            );
            var success = result.success;
            var message = result.message;
            var request = result.request;

            if (success && request != null)
            {
                successMessage = $"✅ SUCCESS: Withdrawal Request Submitted!\n\n" +
                $"Request ID: #{request.RequestId}\n" +
                $"Account: {selectedAccount!.AccountNumber}\n" +
                $"Requested Amount: ₱{requestedAmount:N2}\n" +
                (isEarlyWithdrawal ? $"Penalty: ₱{penaltyAmount:N2}\n" : "") +
                $"Net Withdrawal: ₱{netWithdrawalAmount:N2}\n\n" +
                $"Status: Pending Finance Manager Approval\n" +
                $"Your request will be reviewed by the Finance Manager. You will be notified once approved.";

                // Reset form
                selectedAccountId = 0;
                selectedAccount = null;
                requestedAmount = 0;
                withdrawalReason = "";
                await LoadMyAccounts();
            }
            else
            {
                errorMessage = $"❌ REQUEST FAILED: {message}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"❌ SYSTEM ERROR: Unable to submit withdrawal request.\n\nDetails: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ResetForm()
    {
        selectedAccountId = 0;
        selectedAccount = null;
        requestedAmount = 0;
        withdrawalReason = "";
        errorMessage = "";
        successMessage = "";
        isEarlyWithdrawal = false;
        penaltyAmount = 0;
        interestForfeited = 0;
        netWithdrawalAmount = 0;
    }

    private class SavingsAccountInfo
    {
        public int SavingsAccountId { get; set; }
        public string AccountNumber { get; set; } = "";
        public string AccountTypeName { get; set; } = "";
        public decimal Balance { get; set; }
        public decimal CurrentInterestRate { get; set; }
        public int LockInPeriodDays { get; set; }
        public DateTime? MaturityDate { get; set; }
        public DateTime OpenedDate { get; set; }
        public bool IsBeforeMaturity { get; set; }
    }
}