    private void OpenPaymentModal(LoanViewModel loan)
    {
        selectedLoanForPayment = loan;
        paymentAmountInput = loan.MonthlyPayment;
        showPaymentModal = true;
    }

    private void ClosePaymentModal()
    {
        showPaymentModal = false;
        selectedLoanForPayment = null;
        paymentAmountInput = 0;
    }

    private async Task SubmitPayment()
    {
        if (selectedLoanForPayment == null || paymentAmountInput <= 0)
        {
            ShowAlert("Invalid payment amount", true);
            return;
        }

        if (paymentAmountInput > selectedLoanForPayment.Outstanding)
        {
            ShowAlert("Payment amount cannot exceed outstanding balance", true);
            return;
        }

        isSubmitting = true;
        try
        {
            var account = await CustomerBankingService.GetPrimaryAccountForCurrentCustomerAsync();
            if (account == null) return;

            var loanId = int.Parse(selectedLoanForPayment.Id);
            
            // Get the next pending schedule
            var schedule = await LoanPaymentService.GetNextPendingScheduleAsync(loanId);
            if (schedule == null)
            {
                ShowAlert("No pending payment schedule found", true);
                return;
            }

            // Process the payment
            await LoanProcessService.ProcessPaymentAsync(
                loanId: loanId,
                scheduleId: schedule.ScheduleId,
                paymentAmount: paymentAmountInput,
                paymentMethod: "Cash",
                processedBy: AuthService.CurrentUser ?? "Customer"
            );

            ShowAlert($"✓ Payment of ₱{paymentAmountInput:N2} processed successfully!");
            await LoadCustomerLoans();
            await LoadTransactionHistory();
            ClosePaymentModal();
        }
        catch (Exception ex)
        {
            ShowAlert($"Error: {ex.Message}", true);
        }
        finally
        {
            isSubmitting = false;
        }
    }

