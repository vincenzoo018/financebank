    private async Task DownloadInvoice(LoanTransactionHistory transaction)
    {
        try
        {
            var customer = AuthService.CurrentUser ?? "Customer";
            var html = GenerateInvoiceHtml(transaction, customer);
            
            var bytes = System.Text.Encoding.UTF8.GetBytes(html);
            var base64 = Convert.ToBase64String(bytes);
            var fileName = $"Invoice_{transaction.TransactionType}_{transaction.TransactionDate:yyyyMMdd_HHmmss}.html";
            
            await JS.InvokeVoidAsync("eval", $@"
                var link = document.createElement('a');
                link.href = 'data:text/html;base64,{base64}';
                link.download = '{fileName}';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            ");
        }
        catch (Exception ex)
        {
            ShowAlert($"Error generating invoice: {ex.Message}", true);
        }
    }

