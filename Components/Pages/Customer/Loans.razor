            "VERIFIED" => ("Verified", "#dbeafe", "#1e40af"),
            "ENCODED" or "PENDING_ACCOUNTANT_REVIEW" => ("Under Assessment", "#e0e7ff", "#3730a3"),
            "ASSESSED" or "PENDING_FINANCEMANAGER_APPROVAL" => ("Awaiting Approval", "#fef9c3", "#854d0e"),
            "APPROVED" or "APPROVED_READY_FOR_RELEASE" => ("Approved", "#dcfce7", "#166534"),
            "REJECTED" or "REJECTED_TELLER" or "REJECTED_FINANCEMANAGER" => ("Rejected", "#fee2e2", "#991b1b"),
