        sb.AppendLine("<div class=\"header\"><h1>FinanceBank</h1><p>Official Transaction Invoice</p></div>");
        sb.AppendLine("<div class=\"content\">");
        sb.AppendLine("<div class=\"row\"><span class=\"label\">Invoice Number</span><span class=\"value\">" + invoiceNumber + "</span></div>");
        sb.AppendLine("<div class=\"row\"><span class=\"label\">Transaction Type</span><span class=\"value\">" + transactionTitle + "</span></div>");
        sb.AppendLine("<div class=\"row\"><span class=\"label\">Customer Name</span><span class=\"value\">" + customerName + "</span></div>");
        sb.AppendLine("<div class=\"row\"><span class=\"label\">Loan Number</span><span class=\"value\">" + loanNum + "</span></div>");
        sb.AppendLine("<div class=\"row\"><span class=\"label\">Transaction Date</span><span class=\"value\">" + txnDate + "</span></div>");
        sb.AppendLine("<div class=\"row\"><span class=\"label\">Status</span><span class=\"status\">" + txnStatus + "</span></div>");
        sb.AppendLine(penaltySection);
        sb.AppendLine("<div class=\"row\"><span class=\"label\">Description</span><span class=\"value\">" + txnDesc + "</span></div>");
        sb.AppendLine("<div class=\"row total-row\"><span class=\"total-label\">Amount</span><span class=\"total-value\">₱" + txnAmount + "</span></div>");
        sb.AppendLine("</div>");
        sb.AppendLine("<div class=\"footer\"><p>Thank you for banking with FinanceBank!</p><p>This is an official electronic invoice - Generated on " + genDate + "</p></div>");
        sb.AppendLine("</div></body></html>");
        
        return sb.ToString();
    }

