        {
            "SUBMITTED" or "PENDING_TELLER_REVIEW" => 0,
            "VERIFIED" or "ENCODED" or "PENDING_ACCOUNTANT_REVIEW" => 1,
            "ASSESSED" or "PENDING_FINANCEMANAGER_APPROVAL" => 2,
            "APPROVED" or "APPROVED_READY_FOR_RELEASE" => 3,
            "COMPLETED_RELEASED" or "DISBURSED" => 4,
