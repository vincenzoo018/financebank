@page "/customer/savings-accounts"
@layout CustomerLayout
@using FinanceBank.Services
@using FinanceBank.Models
@inject AuthService AuthService
@inject SavingsAccountService SavingsService
@inject SavingsInterestService InterestService
@inject NavigationManager Navigation

<div style="padding: 24px; max-width: 1400px; margin: 0 auto;">
    <!-- Header -->
    <div style="background: #2F3E2A; border-radius: 14px; padding: 24px; margin-bottom: 24px; color: #FFFFFF;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div
                style="width: 56px; height: 56px; background: rgba(255,255,255,0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                <svg width="28" height="28" fill="none" stroke="white" stroke-width="2">
                    <path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16" />
                    <path d="M9 12h6M12 9v6" />
                </svg>
            </div>
            <div style="flex: 1;">
                <h1 style="font-size: 26px; font-weight: 600; margin: 0;">My Savings Accounts</h1>
                <p style="margin: 6px 0 0; opacity: 0.9;">Manage your savings and track interest earnings</p>
            </div>
            <div
                style="background: rgba(255,255,255,0.2); padding: 12px 20px; border-radius: 10px; text-align: center;">
                <div style="font-size: 12px; opacity: 0.9;">Total Savings</div>
                <div style="font-size: 24px; font-weight: 600;">₱@totalBalance.ToString("N2")</div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div
            style="background: #FFFFFF; border-radius: 14px; padding: 60px; text-align: center; border: 1px solid #E2E2DC;">
            <div class="spinner-border text-success" role="status"></div>
            <p style="margin-top: 16px; color: #6B6B6B;">Loading your savings accounts...</p>
        </div>
    }
    else if (savingsAccounts.Count == 0)
    {
        <div
            style="background: #FFFFFF; border-radius: 14px; padding: 60px; text-align: center; border: 1px solid #E2E2DC;">
            <div style="font-size: 48px; margin-bottom: 16px;">🏦</div>
            <h3 style="font-size: 20px; font-weight: 600; margin-bottom: 8px; color: #2B2B2B;">No Savings Accounts Yet</h3>
            <p style="color: #6B6B6B; margin-bottom: 24px;">Visit your nearest branch to open a savings account</p>
        </div>
    }
    else
    {
        <!-- Savings Accounts Grid -->
        <div style="display: grid; gap: 20px; margin-bottom: 32px;">
            @foreach (var account in savingsAccounts)
            {
                <div
                    style="background: #FFFFFF; border-radius: 14px; padding: 24px; border: 1px solid #E2E2DC; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
                    <div style="display: grid; grid-template-columns: 1fr auto; gap: 24px;">
                        <!-- Account Info -->
                        <div>
                            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                                <div style="font-size: 32px;">
                                    @(account.AccountType?.TypeName == "Regular" ? "💰" : account.AccountType?.TypeName ==
                                                                "TimeDeposit" ? "🔒" : "⭐")
                                </div>
                                <div>
                                    <h3 style="font-size: 18px; font-weight: 600; margin: 0;">@account.AccountType?.TypeName
                                        Savings</h3>
                                    <div style="font-size: 13px; color: #6B6B6B;">@account.AccountNumber</div>
                                </div>
                                <div style="@GetStatusBadgeStyle(account.Status)">
                                    @account.Status
                                </div>
                            </div>

                            <div
                                style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; padding: 16px; background: #F7F7F4; border-radius: 10px;">
                                <div>
                                    <div style="font-size: 11px; color: #6B6B6B; margin-bottom: 4px;">CURRENT BALANCE</div>
                                    <div style="font-size: 20px; font-weight: 600; color: #5F6F52;">
                                        ₱@account.Balance.ToString("N2")</div>
                                </div>
                                <div>
                                    <div style="font-size: 11px; color: #6B6B6B; margin-bottom: 4px;">INTEREST EARNED</div>
                                    <div style="font-size: 16px; font-weight: 600; color: #5F6F52;">
                                        ₱@account.TotalInterestEarned.ToString("N2")</div>
                                </div>
                                <div>
                                    <div style="font-size: 11px; color: #6B6B6B; margin-bottom: 4px;">INTEREST RATE</div>
                                    <div style="font-size: 16px; font-weight: 600;">@account.CurrentInterestRate% APY</div>
                                </div>
                                <div>
                                    <div style="font-size: 11px; color: #6B6B6B; margin-bottom: 4px;">OPENED DATE</div>
                                    <div style="font-size: 14px; font-weight: 500;">@account.OpenedDate.ToString("MMM dd, yyyy")
                                    </div>
                                </div>
                            </div>

                            @if (account.LockInPeriodDays > 0 && account.MaturityDate.HasValue)
                            {
                                var daysRemaining = (account.MaturityDate.Value - DateTime.Now).Days;
                                <div
                                    style="margin-top: 12px; padding: 12px; background: @(daysRemaining > 0 ? "#fef3c7" : "rgba(95, 111, 82, 0.2)"); border-radius: 10px; display: flex; align-items: center; gap: 8px;">
                                    @if (daysRemaining > 0)
                                    {
                                        <span>🔒</span>
                                        <span style="font-size: 13px; font-weight: 600;">Lock-in Period: @daysRemaining days remaining
                                            (Matures @account.MaturityDate.Value.ToString("MMM dd, yyyy"))</span>
                                    }
                                    else
                                    {
                                        <span>✅</span>
                                        <span style="font-size: 13px; font-weight: 600;">Matured! You can now withdraw without
                                            penalty</span>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Actions -->
                        <div style="display: flex; flex-direction: column; gap: 8px; min-width: 140px;">
                            <button @onclick="() => ViewTransactions(account.SavingsAccountId)"
                                style="padding: 10px 16px; background: #5F6F52; color: #FFFFFF; border: none; border-radius: 10px; cursor: pointer; font-weight: 600; font-size: 13px;">
                                @(selectedAccountId == account.SavingsAccountId && transactions.Any() ? "Hide" : "View")
                                Transactions
                            </button>
                            <button @onclick="() => ViewInterestHistory(account.SavingsAccountId)"
                                style="padding: 10px 16px; background: #F7F7F4; color: #2B2B2B; border: 1px solid #E2E2DC; border-radius: 10px; cursor: pointer; font-weight: 600; font-size: 13px;">
                                @(selectedAccountId == account.SavingsAccountId && interestRecords.Any() ? "Hide" : "View")
                                Interest
                            </button>
                        </div>
                    </div>

                    <!-- Transaction Summary (if loaded) -->
                    @if (selectedAccountId == account.SavingsAccountId && transactions.Any())
                    {
                        <div style="margin-top: 20px; border-top: 1px solid #E2E2DC; padding-top: 20px;">
                            <h4 style="font-size: 14px; font-weight: 600; margin-bottom: 12px;">Recent Transactions</h4>
                            <div style="max-height: 300px; overflow-y: auto;">
                                @foreach (var tx in transactions.Take(10))
                                {
                                    <div
                                        style="display: flex; justify-content: space-between; padding: 12px; border-bottom: 1px solid #F7F7F4; align-items: center;">
                                        <div style="display: flex; align-items: center; gap: 12px;">
                                            <div style="font-size: 20px;">
                                                @(tx.TransactionType == "Deposit" ? "💵" : tx.TransactionType == "Withdrawal" ? "💸" :
                                                                                tx.TransactionType == "InterestPosting" ? "📈" : "⚠️")
                                            </div>
                                            <div>
                                                <div style="font-weight: 600; font-size: 13px;">@tx.TransactionType</div>
                                                <div style="font-size: 12px; color: #6B6B6B;">@tx.TransactionDate.ToString("MMM dd, yyyy hh:mm tt")</div>
                                                @if (!string.IsNullOrEmpty(tx.Description))
                                                {
                                                    <div style="font-size: 11px; color: #9ca3af;">@tx.Description</div>
                                                }
                                            </div>
                                        </div>
                                        <div style="text-align: right;">
                                            <div
                                                style="font-weight: 600; font-size: 15px; color: @(tx.TransactionType == "Withdrawal" || tx.TransactionType == "PenaltyCharge" ? "#9B3A3A" : "#5F6F52");">
                                                @(tx.TransactionType == "Withdrawal" || tx.TransactionType == "PenaltyCharge" ? "-" :
                                                                                "+")₱@tx.Amount.ToString("N2")
                                            </div>
                                            <div style="font-size: 11px; color: #6B6B6B;">Balance: ₱@tx.BalanceAfter.ToString("N2")
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Interest History (if loaded) -->
                    @if (selectedAccountId == account.SavingsAccountId && interestRecords.Any())
                    {
                        <div style="margin-top: 20px; border-top: 1px solid #E2E2DC; padding-top: 20px;">
                            <h4 style="font-size: 14px; font-weight: 600; margin-bottom: 12px;">Interest Computation History</h4>
                            <div style="max-height: 250px; overflow-y: auto;">
                                @foreach (var record in interestRecords.Take(30))
                                {
                                    <div
                                        style="display: flex; justify-content: space-between; padding: 8px 12px; border-bottom: 1px solid #F7F7F4; font-size: 12px;">
                                        <div>@record.ComputationDate.ToString("MMM dd, yyyy")</div>
                                        <div>Balance: ₱@record.DailyBalance.ToString("N2")</div>
                                        <div>Rate: @record.AppliedInterestRate%</div>
                                        <div style="font-weight: 600; color: #5F6F52;">+₱@record.DailyInterestAmount.ToString("N4")
                                        </div>
                                        <div>@(record.IsPosted ? "✅ Posted" : "⏳ Pending")</div>
                                    </div>
                                }
                            </div>
                            <div
                                style="margin-top: 12px; padding: 12px; background: #F0F2EC; border-radius: 10px; display: flex; justify-content: space-between;">
                                <span style="font-weight: 600;">Unposted Interest:</span>
                                <span style="font-weight: 700; color: #5F6F52;">₱@unpostedInterest.ToString("N2")</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private List<SavingsAccount> savingsAccounts = new();
    private List<SavingsTransaction> transactions = new();
    private List<SavingsInterest> interestRecords = new();
    private decimal totalBalance = 0;
    private decimal unpostedInterest = 0;
    private int selectedAccountId = 0;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadSavingsAccounts();
    }

    private async Task LoadSavingsAccounts()
    {
        isLoading = true;
        var userId = AuthService.CurrentUserId ?? 0;
        savingsAccounts = await SavingsService.GetSavingsAccountsByCustomerAsync(userId);
        totalBalance = savingsAccounts.Sum(a => a.Balance);
        isLoading = false;
    }

    private async Task ViewTransactions(int accountId)
    {
        if (selectedAccountId == accountId)
        {
            selectedAccountId = 0;
            transactions.Clear();
        }
        else
        {
            selectedAccountId = accountId;
            transactions = await SavingsService.GetTransactionHistoryAsync(accountId);
            interestRecords.Clear();
        }
    }

    private async Task ViewInterestHistory(int accountId)
    {
        if (selectedAccountId == accountId && interestRecords.Any())
        {
            selectedAccountId = 0;
            interestRecords.Clear();
        }
        else
        {
            selectedAccountId = accountId;
            interestRecords = await InterestService.GetInterestHistoryAsync(accountId);
            unpostedInterest = await InterestService.GetUnpostedInterestAsync(accountId);
            transactions.Clear();
        }
    }

    private string GetStatusBadgeStyle(string status)
    {
        return status switch
        {
            "ACTIVE" => "padding: 4px 12px; background: rgba(95, 111, 82, 0.2); color: #2F3E2A; border-radius: 12px; font-size: 11px; font-weight: 600;",
            "CLOSED" => "padding: 4px 12px; background: rgba(155, 58, 58, 0.1); color: #9B3A3A; border-radius: 12px; font-size: 11px; font-weight: 600;",
            _ => "padding: 4px 12px; background: #E2E2DC; color: #2B2B2B; border-radius: 12px; font-size: 11px; font-weight: 600;"
        };
    }
}