@page "/customer/dashboard"
@layout CustomerLayout
@using System.Linq
@using FinanceBank.Services
@using FinanceBank.Models
@inject AuthService AuthService
@inject CustomerBankingService BankingService
@inject CustomerTransactionService TransactionService

<div style="padding: 24px; max-width: 1400px; margin: 0 auto;">
    <!-- Welcome Section - BPI/BDO Style -->
    <div style="margin-bottom: 24px;">
        <h1 style="font-size: 28px; font-weight: 700; color: #1f2937; margin-bottom: 4px;">Hello, @(AuthService.FullName ?? "Customer")!</h1>
        <p style="font-size: 14px; color: #6b7280;">@DateTime.Now.ToString("dddd, MMMM dd, yyyy • hh:mm tt")</p>
    </div>

    <!-- Account Overview Cards - BPI Style -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px; margin-bottom: 32px;">
        <!-- Primary Account Card -->
        <div style="background: linear-gradient(135deg, #0c4a6e, #0369a1, #0891b2); border-radius: 20px; padding: 28px; color: white; box-shadow: 0 8px 24px rgba(8,145,178,0.3); position: relative; overflow: hidden;">
            <div style="position: absolute; top: -20px; right: -20px; width: 150px; height: 150px; background: rgba(255,255,255,0.1); border-radius: 50%;"></div>
            <div style="position: relative; z-index: 1;">
                <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 24px;">
                    <div>
                        <div style="font-size: 12px; opacity: 0.9; margin-bottom: 4px; letter-spacing: 0.5px;">@accountLabel</div>
                        <div style="font-size: 13px; font-family: 'Courier New', monospace; opacity: 0.85;">@maskedAccountNumber</div>
                    </div>
                    <div style="width: 40px; height: 40px; background: rgba(255,255,255,0.2); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                        <span style="font-size: 20px;">💳</span>
                    </div>
                </div>
                <div style="margin-bottom: 8px;">
                    <div style="font-size: 12px; opacity: 0.9; margin-bottom: 4px;">Available Balance</div>
                    <div style="font-size: 36px; font-weight: 800; letter-spacing: -1px;">@FormatAmount(currentBalance)</div>
                </div>
                <div style="display: flex; gap: 16px; margin-top: 20px; padding-top: 20px; border-top: 1px solid rgba(255,255,255,0.2);">
                    <div style="flex: 1;">
                        <div style="font-size: 11px; opacity: 0.8;">Pending</div>
                        <div style="font-size: 14px; font-weight: 600;">₱500.00</div>
                    </div>
                    <div style="flex: 1;">
                        <div style="font-size: 11px; opacity: 0.8;">Rewards</div>
                        <div style="font-size: 14px; font-weight: 600;">250 pts</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Monthly Summary Card -->
        <div style="background: white; border-radius: 20px; padding: 28px; box-shadow: 0 4px 16px rgba(0,0,0,0.08); border: 1px solid #e5e7eb;">
            <div style="display: flex; justify-content: between; align-items: center; margin-bottom: 20px;">
                <h3 style="font-size: 18px; font-weight: 700; color: #1f2937; margin: 0;">This Month</h3>
                <span style="padding: 4px 12px; background: #ecfdf5; color: #059669; font-size: 11px; font-weight: 600; border-radius: 12px;">@DateTime.Now.ToString("MMM")</span>
            </div>
            <div style="display: flex; flex-direction: column; gap: 20px;">
                <div style="padding: 16px; background: #f0fdf4; border-radius: 12px; border-left: 4px solid #059669;">
                    <div style="font-size: 12px; color: #6b7280; margin-bottom: 6px;">💰 Total Income</div>
                    <div style="font-size: 24px; font-weight: 700; color: #059669;">+@FormatAmount(monthlyIncome)</div>
                </div>
                <div style="padding: 16px; background: #fef2f2; border-radius: 12px; border-left: 4px solid #dc2626;">
                    <div style="font-size: 12px; color: #6b7280; margin-bottom: 6px;">💸 Total Expenses</div>
                    <div style="font-size: 24px; font-weight: 700; color: #dc2626;">-@FormatAmount(monthlyExpenses)</div>
                </div>
                <div style="padding: 12px; background: #f9fafb; border-radius: 12px; text-align: center;">
                    <div style="font-size: 11px; color: #6b7280; margin-bottom: 4px;">Net Savings</div>
                    <div style="font-size: 20px; font-weight: 700; color: #0891b2;">@FormatAmount(monthlyIncome - monthlyExpenses)</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions - BPI/BDO Style -->
    <div style="background: white; border-radius: 20px; padding: 28px; box-shadow: 0 4px 16px rgba(0,0,0,0.08); margin-bottom: 24px; border: 1px solid #e5e7eb;">
        <h2 style="font-size: 18px; font-weight: 700; color: #1f2937; margin-bottom: 24px;">Quick Actions</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 16px;">
            <a href="/customer/transfer-money" style="text-decoration: none;">
                <div class="quick-action-card" style="background: linear-gradient(135deg, #eff6ff, #dbeafe); border-radius: 16px; padding: 24px; text-align: center; cursor: pointer; transition: all 0.3s; border: 2px solid transparent;">
                    <div style="width: 56px; height: 56px; margin: 0 auto 12px; background: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(30,64,175,0.15);">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#1e40af" stroke-width="2">
                            <path d="M5 12h14M12 5l7 7-7 7"/>
                        </svg>
                    </div>
                    <div style="font-size: 14px; font-weight: 600; color: #1e40af;">Send Money</div>
                    <div style="font-size: 11px; color: #6b7280; margin-top: 4px;">Transfer funds</div>
                </div>
            </a>
            <a href="/customer/deposit" style="text-decoration: none;">
                <div class="quick-action-card" style="background: linear-gradient(135deg, #f0fdf4, #dcfce7); border-radius: 16px; padding: 24px; text-align: center; cursor: pointer; transition: all 0.3s; border: 2px solid transparent;">
                    <div style="width: 56px; height: 56px; margin: 0 auto 12px; background: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(6,95,70,0.15);">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#065f46" stroke-width="2">
                            <path d="M12 5v14M5 12l7 7 7-7"/>
                        </svg>
                    </div>
                    <div style="font-size: 14px; font-weight: 600; color: #065f46;">Deposit</div>
                    <div style="font-size: 11px; color: #6b7280; margin-top: 4px;">Add funds</div>
                </div>
            </a>
            <a href="/customer/withdraw" style="text-decoration: none;">
                <div class="quick-action-card" style="background: linear-gradient(135deg, #fef2f2, #fee2e2); border-radius: 16px; padding: 24px; text-align: center; cursor: pointer; transition: all 0.3s; border: 2px solid transparent;">
                    <div style="width: 56px; height: 56px; margin: 0 auto 12px; background: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(153,27,27,0.15);">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#991b1b" stroke-width="2">
                            <path d="M12 19V5M5 12l7-7 7 7"/>
                        </svg>
                    </div>
                    <div style="font-size: 14px; font-weight: 600; color: #991b1b;">Withdraw</div>
                    <div style="font-size: 11px; color: #6b7280; margin-top: 4px;">Get cash</div>
                </div>
            </a>
            <a href="/customer/bills" style="text-decoration: none;">
                <div class="quick-action-card" style="background: linear-gradient(135deg, #fef3c7, #fde68a); border-radius: 16px; padding: 24px; text-align: center; cursor: pointer; transition: all 0.3s; border: 2px solid transparent;">
                    <div style="width: 56px; height: 56px; margin: 0 auto 12px; background: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(146,64,14,0.15);">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#92400e" stroke-width="2">
                            <rect x="3" y="3" width="18" height="18" rx="2"/>
                            <path d="M3 9h18"/>
                        </svg>
                    </div>
                    <div style="font-size: 14px; font-weight: 600; color: #92400e;">Pay Bills</div>
                    <div style="font-size: 11px; color: #6b7280; margin-top: 4px;">Utilities & more</div>
                </div>
            </a>
            <a href="/customer/loans" style="text-decoration: none;">
                <div class="quick-action-card" style="background: linear-gradient(135deg, #f5f3ff, #ede9fe); border-radius: 16px; padding: 24px; text-align: center; cursor: pointer; transition: all 0.3s; border: 2px solid transparent;">
                    <div style="width: 56px; height: 56px; margin: 0 auto 12px; background: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(91,33,182,0.15);">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#5b21b6" stroke-width="2">
                            <rect x="2" y="7" width="20" height="14" rx="2"/>
                            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                        </svg>
                    </div>
                    <div style="font-size: 14px; font-weight: 600; color: #5b21b6;">Loans</div>
                    <div style="font-size: 11px; color: #6b7280; margin-top: 4px;">Apply now</div>
                </div>
            </a>
            <a href="/customer/cards" style="text-decoration: none;">
                <div class="quick-action-card" style="background: linear-gradient(135deg, #faf5ff, #f3e8ff); border-radius: 16px; padding: 24px; text-align: center; cursor: pointer; transition: all 0.3s; border: 2px solid transparent;">
                    <div style="width: 56px; height: 56px; margin: 0 auto 12px; background: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(124,58,237,0.15);">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2">
                            <rect x="1" y="4" width="22" height="16" rx="2"/>
                            <path d="M1 10h22"/>
                        </svg>
                    </div>
                    <div style="font-size: 14px; font-weight: 600; color: #7c3aed;">My Cards</div>
                    <div style="font-size: 11px; color: #6b7280; margin-top: 4px;">Manage cards</div>
                </div>
            </a>
        </div>
    </div>

    <!-- Recent Transactions - BPI/BDO Style -->
    <div style="background: white; border-radius: 20px; padding: 28px; box-shadow: 0 4px 16px rgba(0,0,0,0.08); border: 1px solid #e5e7eb;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
            <h2 style="font-size: 18px; font-weight: 700; color: #1f2937;">Recent Transactions</h2>
            <a href="/customer/transactions" style="font-size: 13px; color: #0891b2; text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 4px;">View All <span>→</span></a>
        </div>
        <div style="display: flex; flex-direction: column; gap: 12px;">
            @foreach (var transaction in recentTransactions)
            {
                <div style="display: flex; align-items: center; justify-content: space-between; padding: 16px; background: #f9fafb; border-radius: 12px; transition: all 0.2s; cursor: pointer; border: 1px solid #f3f4f6;" class="transaction-row">
                    <div style="display: flex; align-items: center; gap: 14px;">
                        <div style="width: 44px; height: 44px; background: @(transaction.Amount >= 0 ? "linear-gradient(135deg, #d1fae5, #a7f3d0)" : "linear-gradient(135deg, #fee2e2, #fecaca)"); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="@(transaction.Amount >= 0 ? "#059669" : "#dc2626")" stroke-width="2.5">
                                @if (transaction.Amount >= 0)
                                {
                                    <path d="M12 5v14M5 12l7 7 7-7"/>
                                }
                                else
                                {
                                    <path d="M12 19V5M5 12l7-7 7 7"/>
                                }
                            </svg>
                        </div>
                        <div>
                            <div style="font-weight: 600; color: #1f2937; font-size: 15px;">@transaction.Title</div>
                            <div style="font-size: 12px; color: #6b7280; margin-top: 4px;">@transaction.Date.ToString("MMM dd, yyyy • hh:mm tt")</div>
                        </div>
                    </div>
                    <div style="font-weight: 700; font-size: 16px; color: @(transaction.Amount >= 0 ? "#059669" : "#dc2626");">
                        @(transaction.Amount >= 0 ? "+" : "")₱@Math.Abs(transaction.Amount).ToString("N2")
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .quick-action-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.15);
        border-color: rgba(8,145,178,0.3);
    }
    
    .transaction-row:hover {
        background: #f3f4f6 !important;
        border-color: #e5e7eb !important;
    }
</style>

@code {
    private CustomerAccount? account;
    private string accountLabel = "Savings Account";
    private string maskedAccountNumber = "****";
    private decimal currentBalance = 0;
    private decimal monthlyIncome = 0;
    private decimal monthlyExpenses = 0;

    private List<Transaction> recentTransactions = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountAndTransactionsAsync();
    }

    private async Task LoadAccountAndTransactionsAsync()
    {
        try
        {
            account = await BankingService.GetPrimaryAccountForCurrentCustomerAsync();
            if (account != null)
            {
                accountLabel = "SAVINGS ACCOUNT";
                maskedAccountNumber = MaskAccountNumber(account.AccountNumber);
                currentBalance = account.AvailableBalance;

                var transactions = await TransactionService.GetByAccountIdAsync(account.AccountId);
                var thisMonth = transactions.Where(t => t.CreatedAt.Month == DateTime.Now.Month && t.CreatedAt.Year == DateTime.Now.Year).ToList();

                monthlyIncome = thisMonth.Where(t => t.TransactionType == "Deposit").Sum(t => t.Amount);
                monthlyExpenses = thisMonth.Where(t => t.TransactionType == "Withdrawal" || t.TransactionType == "Bills").Sum(t => t.Amount);

                recentTransactions = transactions
                    .Take(5)
                    .Select(t => new Transaction
                    {
                        Title = BuildTransactionTitle(t),
                        Date = t.CreatedAt,
                        Amount = t.TransactionType == "Deposit" ? t.Amount : -t.Amount
                    })
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error loading dashboard: {ex.Message}");
        }
    }

    private static string BuildTransactionTitle(CustomerTransaction t) =>
        t.TransactionType switch
        {
            "Deposit" => "Deposit",
            "Withdrawal" => "Withdrawal",
            "Bills" => $"Bill Payment - {t.BillerName}",
            "Transfer" => $"Transfer to {t.ToAccountName}",
            _ => t.Description ?? "Transaction"
        };

    private static string MaskAccountNumber(string accountNumber)
    {
        if (string.IsNullOrWhiteSpace(accountNumber) || accountNumber.Length < 4)
            return "****  ****  ****  ****";
        var last4 = accountNumber[^4..];
        return $"****  ****  ****  {last4}";
    }

    private static string FormatAmount(decimal amount) => $"₱{Math.Abs(amount):N2}";

    private class Transaction
    {
        public string Title { get; set; } = "";
        public DateTime Date { get; set; }
        public decimal Amount { get; set; }
    }
}

