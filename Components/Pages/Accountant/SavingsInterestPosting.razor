@page "/accountant/savings-interest-posting"
@layout AccountantLayout
@using FinanceBank.Services
@using FinanceBank.Models
@inject AuthService AuthService
@inject SavingsInterestService InterestService

<div style="padding: 24px; max-width: 1400px; margin: 0 auto;">
    <!-- Header -->
    <div style="background: linear-gradient(135deg, #10b981, #059669); border-radius: 16px; padding: 24px; margin-bottom: 24px; color: white;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 56px; height: 56px; background: rgba(255,255,255,0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                <svg width="28" height="28" fill="none" stroke="white" stroke-width="2">
                    <path d="M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>
                </svg>
            </div>
            <div style="flex: 1;">
                <h1 style="font-size: 26px; font-weight: 700; margin: 0;">Savings Interest Posting</h1>
                <p style="margin: 6px 0 0; opacity: 0.9;">Release approved interest to customer accounts</p>
            </div>
            <div style="display: flex; gap: 12px;">
                <div style="background: rgba(255,255,255,0.2); padding: 12px 20px; border-radius: 10px; text-align: center;">
                    <div style="font-size: 12px; opacity: 0.9;">Pending Release</div>
                    <div style="font-size: 24px; font-weight: 700;">@fmApprovedBatches.Count</div>
                </div>
                <div style="background: rgba(255,255,255,0.2); padding: 12px 20px; border-radius: 10px; text-align: center;">
                    <div style="font-size: 12px; opacity: 0.9;">Total Amount</div>
                    <div style="font-size: 24px; font-weight: 700;">₱@totalPendingAmount.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Alerts -->
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div style="background: #d1fae5; border: 1px solid #6ee7b7; color: #065f46; padding: 16px; border-radius: 12px; margin-bottom: 20px; display: flex; align-items: center; gap: 12px; white-space: pre-line;">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            <span style="font-weight: 600;">@successMessage</span>
            <button @onclick="() => successMessage = string.Empty" style="margin-left: auto; background: none; border: none; color: #065f46; cursor: pointer; font-size: 18px;">×</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div style="background: #fee2e2; border: 1px solid #fecaca; color: #991b1b; padding: 16px; border-radius: 12px; margin-bottom: 20px; white-space: pre-line;">
            ❌ @errorMessage
        </div>
    }

    <!-- Daily Operations Card -->
    <div style="background: white; border-radius: 16px; border: 1px solid #e5e7eb; overflow: hidden; margin-bottom: 24px;">
        <div style="background: linear-gradient(135deg, #3b82f6, #2563eb); padding: 20px; color: white;">
            <h3 style="margin: 0 0 8px 0; font-weight: 700; font-size: 18px;">⚙️ Daily Interest Operations</h3>
            <p style="margin: 0; opacity: 0.9; font-size: 13px;">Compute daily interest and create monthly posting batches</p>
        </div>

        <div style="padding: 24px;">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                <!-- Compute Daily Interest -->
                <div style="background: #f0f9ff; border: 2px solid #bfdbfe; border-radius: 12px; padding: 20px;">
                    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                        <div style="width: 40px; height: 40px; background: #3b82f6; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-size: 20px;">
                            📊
                        </div>
                        <div>
                            <h4 style="margin: 0; font-weight: 700; color: #1e40af;">Daily Interest Computation</h4>
                            <p style="margin: 4px 0 0; font-size: 12px; color: #3b82f6;">Run daily for all active accounts</p>
                        </div>
                    </div>
                    <button @onclick="ComputeDailyInterest" disabled="@isProcessing"
                            style="width: 100%; background: linear-gradient(135deg, #3b82f6, #2563eb); color: white; border: none; padding: 12px; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 14px;">
                        @(isProcessing ? "⏳ Computing..." : "▶️ Compute Today's Interest")
                    </button>
                    @if (lastComputationInfo != null)
                    {
                        <div style="margin-top: 12px; padding: 12px; background: white; border-radius: 8px; font-size: 12px;">
                            <div style="color: #6b7280;">Last Run: @lastComputationInfo</div>
                        </div>
                    }
                </div>

                <!-- Create Monthly Batch -->
                <div style="background: #f0fdf4; border: 2px solid #bbf7d0; border-radius: 12px; padding: 20px;">
                    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                        <div style="width: 40px; height: 40px; background: #10b981; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-size: 20px;">
                            📦
                        </div>
                        <div>
                            <h4 style="margin: 0; font-weight: 700; color: #065f46;">Create Monthly Batch</h4>
                            <p style="margin: 4px 0 0; font-size: 12px; color: #10b981;">Bundle interest for FM approval</p>
                        </div>
                    </div>
                    @if (unpostedInterestSummary > 0)
                    {
                        <div style="background: white; padding: 12px; border-radius: 8px; margin-bottom: 12px;">
                            <div style="font-size: 12px; color: #6b7280;">Unposted Interest Available:</div>
                            <div style="font-size: 20px; font-weight: 700; color: #10b981;">₱@unpostedInterestSummary.ToString("N2")</div>
                        </div>
                    }
                    <button @onclick="ShowCreateBatchDialog" disabled="@(isProcessing || unpostedInterestSummary == 0)"
                            style="width: 100%; background: linear-gradient(135deg, #10b981, #059669); color: white; border: none; padding: 12px; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 14px;">
                        @(unpostedInterestSummary > 0 ? "📦 Create Posting Batch" : "No Unposted Interest")
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- FM Approved Batches (Ready for Release) -->
    <div style="background: white; border-radius: 16px; border: 1px solid #e5e7eb; overflow: hidden; margin-bottom: 24px;">
        <div style="background: #f0fdf4; padding: 20px; border-bottom: 1px solid #86efac;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h3 style="margin: 0; font-weight: 700; color: #059669; font-size: 18px;">✅ FM Approved Batches - Ready for Release</h3>
                    <p style="margin: 6px 0 0; color: #10b981; font-size: 13px;">These batches have been reviewed and approved by Finance Manager</p>
                </div>
                <button @onclick="LoadData" style="background: #10b981; color: white; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: 600;">
                    <svg width="16" height="16" fill="none" stroke="white" stroke-width="2" style="vertical-align: middle; margin-right: 6px;">
                        <path d="M23 4v6h-6M1 20v-6h6M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/>
                    </svg>
                    Refresh
                </button>
            </div>
        </div>

        <div style="padding: 24px;">
            @if (isLoading)
            {
                <div style="text-align: center; padding: 48px;">
                    <div class="spinner-border text-success" role="status"></div>
                    <p style="margin-top: 16px; color: #6b7280;">Loading approved batches...</p>
                </div>
            }
            else if (!fmApprovedBatches.Any())
            {
                <div style="text-align: center; padding: 48px;">
                    <div style="font-size: 48px; margin-bottom: 16px;">✅</div>
                    <h4 style="margin: 0; color: #059669; font-weight: 700;">All Caught Up!</h4>
                    <p style="margin-top: 8px; color: #6b7280;">No approved batches waiting for release.</p>
                </div>
            }
            else
            {
                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background: #f9fafb; border-bottom: 2px solid #e5e7eb;">
                            <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 600; color: #6b7280;">BATCH #</th>
                            <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 600; color: #6b7280;">PERIOD</th>
                            <th style="padding: 12px; text-align: center; font-size: 12px; font-weight: 600; color: #6b7280;">ACCOUNTS</th>
                            <th style="padding: 12px; text-align: right; font-size: 12px; font-weight: 600; color: #6b7280;">TOTAL INTEREST</th>
                            <th style="padding: 12px; text-align: center; font-size: 12px; font-weight: 600; color: #6b7280;">APPROVED BY</th>
                            <th style="padding: 12px; text-align: center; font-size: 12px; font-weight: 600; color: #6b7280;">ACTION</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var batch in fmApprovedBatches)
                        {
                            <tr style="border-bottom: 1px solid #f3f4f6;">
                                <td style="padding: 16px;">
                                    <span style="background: #dbeafe; color: #1e40af; padding: 6px 12px; border-radius: 6px; font-weight: 600; font-size: 12px;">
                                        #@batch.PostingId
                                    </span>
                                </td>
                                <td style="padding: 16px;">
                                    <div style="font-weight: 600; color: #1f2937;">@batch.PeriodStart.ToString("MMM dd") - @batch.PeriodEnd.ToString("MMM dd, yyyy")</div>
                                    <div style="font-size: 12px; color: #6b7280;">Created: @batch.PostingDate.ToString("MMM dd, yyyy")</div>
                                </td>
                                <td style="padding: 16px; text-align: center;">
                                    <div style="font-size: 20px; font-weight: 700; color: #10b981;">@batch.AccountsProcessed</div>
                                    <div style="font-size: 11px; color: #6b7280;">accounts</div>
                                </td>
                                <td style="padding: 16px; text-align: right;">
                                    <div style="font-size: 18px; font-weight: 700; color: #059669;">₱@batch.TotalInterestPosted.ToString("N2")</div>
                                </td>
                                <td style="padding: 16px; text-align: center;">
                                    <div style="font-weight: 600; color: #1f2937;">@batch.ApprovedByFM</div>
                                    <div style="font-size: 11px; color: #6b7280;">@batch.ApprovedByFMAt?.ToString("MMM dd, hh:mm tt")</div>
                                </td>
                                <td style="padding: 16px; text-align: center;">
                                    <button @onclick="() => ShowReleaseConfirmDialog(batch)" disabled="@isProcessing"
                                            style="background: linear-gradient(135deg, #059669, #10b981); color: white; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 13px; box-shadow: 0 4px 12px rgba(5, 150, 105, 0.3);">
                                        💳 Release to Accounts
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <!-- Completed Batches History -->
    <div style="background: white; border-radius: 16px; border: 1px solid #e5e7eb; overflow: hidden;">
        <div style="background: #f9fafb; padding: 16px; border-bottom: 1px solid #e5e7eb;">
            <h3 style="margin: 0; font-weight: 700; color: #1f2937; font-size: 16px;">📋 Recently Completed Batches</h3>
        </div>

        <div style="padding: 16px;">
            @if (completedBatches.Any())
            {
                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background: #f9fafb;">
                            <th style="padding: 10px; text-align: left; font-size: 11px; font-weight: 600; color: #6b7280;">BATCH</th>
                            <th style="padding: 10px; text-align: left; font-size: 11px; font-weight: 600; color: #6b7280;">PERIOD</th>
                            <th style="padding: 10px; text-align: center; font-size: 11px; font-weight: 600; color: #6b7280;">ACCOUNTS</th>
                            <th style="padding: 10px; text-align: right; font-size: 11px; font-weight: 600; color: #6b7280;">AMOUNT</th>
                            <th style="padding: 10px; text-align: center; font-size: 11px; font-weight: 600; color: #6b7280;">RELEASED BY</th>
                            <th style="padding: 10px; text-align: center; font-size: 11px; font-weight: 600; color: #6b7280;">STATUS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var batch in completedBatches.Take(10))
                        {
                            <tr style="border-bottom: 1px solid #f3f4f6;">
                                <td style="padding: 12px; font-size: 12px; font-weight: 600;">#@batch.PostingId</td>
                                <td style="padding: 12px; font-size: 12px;">@batch.PeriodStart.ToString("MMM dd") - @batch.PeriodEnd.ToString("MMM dd, yyyy")</td>
                                <td style="padding: 12px; text-align: center; font-size: 12px;">@batch.AccountsProcessed</td>
                                <td style="padding: 12px; text-align: right; font-size: 12px; font-weight: 600; color: #059669;">₱@batch.TotalInterestPosted.ToString("N2")</td>
                                <td style="padding: 12px; text-align: center; font-size: 12px;">
                                    <div>@batch.ReleasedByAccountant</div>
                                    <div style="font-size: 10px; color: #6b7280;">@batch.ReleasedByAccountantAt?.ToString("MMM dd, yyyy")</div>
                                </td>
                                <td style="padding: 12px; text-align: center;">
                                    <span style="background: #d1fae5; color: #065f46; padding: 4px 10px; border-radius: 4px; font-size: 11px; font-weight: 600;">
                                        ✅ Completed
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div style="text-align: center; padding: 32px; color: #6b7280;">
                    <p>No completed batches yet</p>
                </div>
            }
        </div>
    </div>
</div>

@* Create Batch Confirmation Dialog *@
@if (showCreateBatchDialog)
{
    <div style="position: fixed; inset: 0; background: rgba(0, 0, 0, 0.7); display: flex; align-items: center; justify-content: center; z-index: 1000; backdrop-filter: blur(4px);">
        <div style="background: white; border-radius: 24px; max-width: 600px; width: 90%; box-shadow: 0 25px 50px rgba(0, 0, 0, 0.3); animation: slideIn 0.3s ease-out;">
            <div style="background: linear-gradient(135deg, #10b981, #059669); padding: 32px; border-radius: 24px 24px 0 0; text-align: center;">
                <div style="font-size: 64px; margin-bottom: 16px;">📦</div>
                <h3 style="color: white; margin: 0; font-size: 28px; font-weight: 700;">Create Interest Posting Batch</h3>
                <p style="color: rgba(255, 255, 255, 0.9); margin-top: 8px; font-size: 14px;">Bundle unposted interest for Finance Manager approval</p>
            </div>

            <div style="padding: 32px;">
                <div style="background: #f0fdf4; border: 2px solid #86efac; border-radius: 16px; padding: 20px; margin-bottom: 24px;">
                    <div style="display: grid; gap: 16px;">
                        <div>
                            <label style="font-size: 12px; font-weight: 600; color: #059669; margin-bottom: 8px; display: block;">PERIOD START DATE</label>
                            <input type="date" @bind="batchPeriodStart" @bind:event="oninput"
                                   style="width: 100%; padding: 12px; border: 2px solid #d1d5db; border-radius: 8px; font-size: 14px;" />
                        </div>
                        <div>
                            <label style="font-size: 12px; font-weight: 600; color: #059669; margin-bottom: 8px; display: block;">PERIOD END DATE</label>
                            <input type="date" @bind="batchPeriodEnd" @bind:event="oninput"
                                   style="width: 100%; padding: 12px; border: 2px solid #d1d5db; border-radius: 8px; font-size: 14px;" />
                        </div>
                    </div>
                </div>

                <div style="background: #fffbeb; border-left: 4px solid #fbbf24; padding: 16px; border-radius: 8px; margin-bottom: 24px;">
                    <p style="margin: 0; font-size: 13px; color: #78350f;">
                        <strong>⚠️ Note:</strong> This will create a batch from all unposted interest records within the selected period. The batch will be sent to Finance Manager for approval.
                    </p>
                </div>

                <div style="display: flex; gap: 12px; justify-content: flex-end;">
                    <button @onclick="CancelCreateBatch" disabled="@isProcessing"
                            style="background: #f3f4f6; color: #1f2937; border: 2px solid #e5e7eb; padding: 14px 32px; border-radius: 12px; font-weight: 600; cursor: pointer; transition: all 0.3s; font-size: 14px;">
                        ❌ Cancel
                    </button>
                    <button @onclick="ConfirmCreateBatch" disabled="@isProcessing"
                            style="background: linear-gradient(135deg, #10b981, #059669); color: white; border: none; padding: 14px 32px; border-radius: 12px; font-weight: 600; cursor: pointer; box-shadow: 0 8px 20px rgba(16, 185, 129, 0.4); transition: all 0.3s; font-size: 14px;">
                        @if (isProcessing)
                        {
                            <span>⏳ Creating Batch...</span>
                        }
                        else
                        {
                            <span>✅ Confirm & Create Batch</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* Release Confirmation Dialog *@
@if (showReleaseConfirm && selectedBatch != null)
{
    <div style="position: fixed; inset: 0; background: rgba(0, 0, 0, 0.7); display: flex; align-items: center; justify-content: center; z-index: 1000; backdrop-filter: blur(4px);">
        <div style="background: white; border-radius: 24px; max-width: 600px; width: 90%; box-shadow: 0 25px 50px rgba(0, 0, 0, 0.3); animation: slideIn 0.3s ease-out;">
            <div style="background: linear-gradient(135deg, #059669, #10b981); padding: 32px; border-radius: 24px 24px 0 0; text-align: center;">
                <div style="font-size: 64px; margin-bottom: 16px;">💳</div>
                <h3 style="color: white; margin: 0; font-size: 28px; font-weight: 700;">Release Interest to Accounts</h3>
                <p style="color: rgba(255, 255, 255, 0.9); margin-top: 8px; font-size: 14px;">Final approval to credit interest to customer accounts</p>
            </div>

            <div style="padding: 32px;">
                <div style="background: #f0fdf4; border: 2px solid #86efac; border-radius: 16px; padding: 20px; margin-bottom: 24px;">
                    <div style="display: grid; gap: 12px;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-size: 12px; font-weight: 600; color: #059669;">BATCH ID:</span>
                            <span style="background: #dbeafe; color: #1e40af; padding: 4px 12px; border-radius: 6px; font-weight: 600; font-size: 12px;">#@selectedBatch.PostingId</span>
                        </div>
                        <div style="display: flex; justify-content: space-between;">
                            <span style="font-size: 12px; font-weight: 600; color: #059669;">PERIOD:</span>
                            <span style="font-weight: 600; color: #1f2937;">@selectedBatch.PeriodStart.ToString("MMM dd") - @selectedBatch.PeriodEnd.ToString("MMM dd, yyyy")</span>
                        </div>
                        <div style="display: flex; justify-content: space-between;">
                            <span style="font-size: 12px; font-weight: 600; color: #059669;">ACCOUNTS:</span>
                            <span style="font-size: 18px; font-weight: 700; color: #10b981;">@selectedBatch.AccountsProcessed</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; padding-top: 12px; border-top: 2px solid #d1fae5;">
                            <span style="font-size: 12px; font-weight: 600; color: #059669;">TOTAL INTEREST:</span>
                            <span style="font-size: 20px; font-weight: 700; color: #059669;">₱@selectedBatch.TotalInterestPosted.ToString("N2")</span>
                        </div>
                    </div>
                </div>

                <div style="background: #fef3c7; border-left: 4px solid #f59e0b; padding: 16px; border-radius: 8px; margin-bottom: 24px;">
                    <p style="margin: 0; font-size: 13px; color: #78350f;">
                        <strong>⚠️ IMPORTANT:</strong> This action will immediately credit interest to all customer savings accounts. This cannot be undone. Please verify the batch details before proceeding.
                    </p>
                </div>

                <div style="display: flex; gap: 12px; justify-content: flex-end;">
                    <button @onclick="CancelRelease" disabled="@isProcessing"
                            style="background: #f3f4f6; color: #1f2937; border: 2px solid #e5e7eb; padding: 14px 32px; border-radius: 12px; font-weight: 600; cursor: pointer; transition: all 0.3s; font-size: 14px;">
                        ❌ Cancel
                    </button>
                    <button @onclick="ConfirmReleaseInterest" disabled="@isProcessing"
                            style="background: linear-gradient(135deg, #059669, #10b981); color: white; border: none; padding: 14px 32px; border-radius: 12px; font-weight: 600; cursor: pointer; box-shadow: 0 8px 20px rgba(5, 150, 105, 0.4); transition: all 0.3s; font-size: 14px;">
                        @if (isProcessing)
                        {
                            <span>⏳ Releasing...</span>
                        }
                        else
                        {
                            <span>✅ Confirm & Release</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<FinanceBank.Models.SavingsInterestPosting> fmApprovedBatches = new();
    private List<FinanceBank.Models.SavingsInterestPosting> completedBatches = new();
    private decimal totalPendingAmount = 0;
    private decimal unpostedInterestSummary = 0;
    private string? lastComputationInfo = null;
    private string successMessage = "";
    private string errorMessage = "";
    private bool isLoading = true;
    private bool isProcessing = false;
    
    // Dialog states
    private bool showCreateBatchDialog = false;
    private bool showReleaseConfirm = false;
    private FinanceBank.Models.SavingsInterestPosting? selectedBatch = null;
    private DateTime batchPeriodStart = DateTime.Today.AddMonths(-1).Date;
    private DateTime batchPeriodEnd = DateTime.Today.Date;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = "";

        try
        {
            fmApprovedBatches = await InterestService.GetFMApprovedBatchesAsync();
            totalPendingAmount = fmApprovedBatches.Sum(b => b.TotalInterestPosted);

            var allBatches = await InterestService.GetInterestPostingBatchesAsync();
            completedBatches = allBatches.Where(b => b.PostingStatus == "Completed").Take(10).ToList();
            
            // Get unposted interest summary
            unpostedInterestSummary = await InterestService.GetTotalUnpostedInterestAsync();
            
            // Set default period for next batch
            var lastBatch = allBatches.OrderByDescending(b => b.PeriodEnd).FirstOrDefault();
            if (lastBatch != null)
            {
                batchPeriodStart = lastBatch.PeriodEnd.AddDays(1).Date;
                batchPeriodEnd = DateTime.Today.Date;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"❌ ERROR: Failed to load data.\n\nDetails: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ComputeDailyInterest()
    {
        if (isProcessing) return;

        isProcessing = true;
        errorMessage = "";
        successMessage = "";
        lastComputationInfo = null;

        try
        {
            var (accountsProcessed, totalInterest, message) = await InterestService.ComputeDailyInterestAsync();

            if (accountsProcessed > 0)
            {
                successMessage = $"✅ SUCCESS: Daily Interest Computed!\n\nAccounts Processed: {accountsProcessed}\nTotal Interest: ₱{totalInterest:N4}\nDate: {DateTime.Today:MMM dd, yyyy}\n\nThe interest has been computed and stored. Create a batch when ready to submit for approval.";
                lastComputationInfo = $"{DateTime.Now:MMM dd, yyyy hh:mm tt} - {accountsProcessed} accounts, ₱{totalInterest:N4}";
                await LoadData(); // Refresh unposted interest
            }
            else
            {
                errorMessage = $"⚠️ {message}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"❌ SYSTEM ERROR: Failed to compute daily interest.\n\nDetails: {ex.Message}\n\nPlease try again or contact system administrator.";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void ShowCreateBatchDialog()
    {
        showCreateBatchDialog = true;
        errorMessage = "";
    }

    private void CancelCreateBatch()
    {
        showCreateBatchDialog = false;
    }

    private async Task ConfirmCreateBatch()
    {
        if (isProcessing) return;

        // Validation
        if (batchPeriodStart >= batchPeriodEnd)
        {
            errorMessage = "❌ Invalid period: Start date must be before end date.";
            return;
        }

        if (batchPeriodEnd > DateTime.Today)
        {
            errorMessage = "❌ Invalid period: End date cannot be in the future.";
            return;
        }

        isProcessing = true;
        errorMessage = "";
        successMessage = "";

        try
        {
            var accountantName = AuthService.FullName ?? "Accountant";
            var (success, message, posting) = await InterestService.CreateMonthlyPostingBatchAsync(
                batchPeriodStart,
                batchPeriodEnd,
                accountantName);

            if (success && posting != null)
            {
                successMessage = $"✅ SUCCESS: Interest Batch #{posting.PostingId} CREATED!\n\nPeriod: {posting.PeriodStart:MMM dd} - {posting.PeriodEnd:MMM dd, yyyy}\nTotal Interest: ₱{posting.TotalInterestPosted:N2}\nAccounts: {posting.AccountsProcessed}\n\nStatus: Pending Finance Manager Approval\nThe batch has been created and is awaiting Finance Manager review.";
                showCreateBatchDialog = false;
                await LoadData();
            }
            else
            {
                errorMessage = $"❌ BATCH CREATION FAILED: {message}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"❌ SYSTEM ERROR: Unable to create interest batch.\n\nDetails: {ex.Message}\n\nPlease verify the period dates and try again.";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void ShowReleaseConfirmDialog(FinanceBank.Models.SavingsInterestPosting batch)
    {
        selectedBatch = batch;
        showReleaseConfirm = true;
        errorMessage = "";
    }

    private void CancelRelease()
    {
        showReleaseConfirm = false;
        selectedBatch = null;
    }

    private async Task ConfirmReleaseInterest()
    {
        if (isProcessing || selectedBatch == null) return;

        isProcessing = true;
        errorMessage = "";
        successMessage = "";

        try
        {
            var accountantName = AuthService.FullName ?? "Accountant";
            (bool success, string message) = await InterestService.ReleaseInterestToAccountsAsync(selectedBatch.PostingId, accountantName);

            if (success)
            {
                successMessage = $"✅ SUCCESS: Interest Batch #{selectedBatch.PostingId} RELEASED!\n\nTotal Interest Posted: ₱{selectedBatch.TotalInterestPosted:N2}\nAccounts Updated: {selectedBatch.AccountsProcessed}\nPeriod: {selectedBatch.PeriodStart:MMM dd} - {selectedBatch.PeriodEnd:MMM dd, yyyy}\n\nStatus: Interest has been successfully credited to all customer savings accounts.\nCustomers can now see their updated balances.";
                showReleaseConfirm = false;
                selectedBatch = null;
                await LoadData();
            }
            else
            {
                errorMessage = $"❌ RELEASE FAILED: {message}\n\nThe interest was not posted to customer accounts. Please verify the batch and try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"❌ SYSTEM ERROR: Unable to release interest batch.\n\nDetails: {ex.Message}\n\nBatch #{selectedBatch.PostingId} was not released. Please contact system administrator.";
        }
        finally
        {
            isProcessing = false;
        }
    }
}

