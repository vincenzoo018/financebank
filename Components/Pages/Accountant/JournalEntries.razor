                    style="background: #e5e7eb; color: #111827; padding: 10px 18px; border-radius: 8px; font-weight: 600;"
                    @onclick="CloseViewModal">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private List<JournalEntry> entries = new();
    private List<ChartOfAccounts> chartOfAccounts = new();
    private bool showManualModal = false;
    private bool showViewModal = false;
    private JournalEntry? viewEntry = null;
    private int postedThisMonth = 0;
    private bool showAutoGenerated = true;
    private string errorMessage = "";
    private string validationError = "";

    // Manual Entry Form
    private JournalEntry manualEntry = new();
    private List<JournalEntryLine> manualLines = new();
    private JournalEntryLine newManualLine = new();

    // Pagination variables
    private int currentPage = 1;
    private int pageSize = 10;
    private int TotalPages => entries.Any() ? (int)Math.Ceiling(entries.Count / (double)pageSize) : 1;

    // Transaction stats
    private int depositCount = 0;
    private decimal depositAmount = 0;
    private int withdrawalCount = 0;
    private decimal withdrawalAmount = 0;
    private int loanPaymentCount = 0;
    private decimal loanPaymentAmount = 0;
    private int loanDisbursalCount = 0;
    private decimal loanDisbursalAmount = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadChartOfAccounts();
        await LoadEntries();
        await LoadTransactionStats();
    }

    private async Task LoadChartOfAccounts()
    {
        try
        {
            chartOfAccounts = await ChartOfAccountsService.GetAllActiveAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading chart of accounts: {ex.Message}");
        }
    }

    private async Task LoadEntries()
    {
        try
        {
            errorMessage = "";
            entries = await JournalEntryService.GetAllAsync();
            CalculateStats();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading entries: {ex.Message}");
            errorMessage = $"Error loading entries: {ex.Message}";
            entries = new List<JournalEntry>();
        }
    }

    private async Task LoadTransactionStats()
    {
        try
        {
            var stats = await JournalEntryService.GetTransactionStatsAsync();
            depositCount = stats.TotalDeposits;
            depositAmount = stats.DepositAmount;
            withdrawalCount = stats.TotalWithdrawals;
            withdrawalAmount = stats.WithdrawalAmount;
            loanPaymentCount = stats.TotalLoanPayments;
            loanPaymentAmount = stats.LoanPaymentAmount;
            loanDisbursalCount = stats.TotalLoanDisbursals;
            loanDisbursalAmount = stats.LoanDisbursalAmount;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading stats: {ex.Message}");
        }
    }

    private async Task ToggleShowAutoGenerated()
    {
        showAutoGenerated = !showAutoGenerated;
        await LoadEntries();
    }

    private void CalculateStats()
    {
        var today = DateTime.Today;
        var monthStart = new DateTime(today.Year, today.Month, 1);
        var monthEnd = monthStart.AddMonths(1).AddDays(-1);

        postedThisMonth = entries.Count(e => e.TransactionDate >= monthStart && e.TransactionDate <= monthEnd && e.Status ==
        "Posted");
    }

    private void OpenManualEntryModal()
    {
        manualEntry = new JournalEntry
        {
            TransactionDate = DateTime.Today,
            Status = "Draft",
            // SourceType = "Manual", // Property does not exist in database
            Reference = $"MJE-{DateTime.Now:yyyyMMddHHmmss}"
        };
        manualLines = new List<JournalEntryLine>();
        newManualLine = new JournalEntryLine();
        validationError = "";
        showManualModal = true;
    }

    private void AddManualLine()
    {
        validationError = "";

        if (string.IsNullOrEmpty(newManualLine.AccountCode))
        {
            validationError = "Please select an account.";
            return;
        }

        if (newManualLine.DebitAmount == 0 && newManualLine.CreditAmount == 0)
        {
            validationError = "Line must have either a debit or credit amount.";
            return;
        }

        if (newManualLine.DebitAmount > 0 && newManualLine.CreditAmount > 0)
        {
            validationError = "A line cannot have both debit and credit amounts.";
            return;
        }

        var selectedAccount = chartOfAccounts.FirstOrDefault(a => a.AccountCode == newManualLine.AccountCode);
        if (selectedAccount != null)
        {
            manualLines.Add(new JournalEntryLine
            {
                AccountCode = newManualLine.AccountCode,
                AccountName = selectedAccount.AccountName,
                Description = newManualLine.Description ?? selectedAccount.AccountName,
                DebitAmount = newManualLine.DebitAmount,
                CreditAmount = newManualLine.CreditAmount
            });

            newManualLine = new JournalEntryLine();
        }
    }

    private void RemoveManualLine(JournalEntryLine line)
    {
        manualLines.Remove(line);
    }

    private bool falseEntryBalanced()
    {
        return manualLines.Any() && manualLines.Sum(l => l.DebitAmount) == manualLines.Sum(l => l.CreditAmount);
    }

    private bool CanSaveManualEntry()
    {
        return manualLines.Count >= 2 && falseEntryBalanced() && !string.IsNullOrEmpty(manualEntry.Description);
    }

    private async Task SaveManualEntry()
    {
        validationError = "";

        if (manualLines.Count < 2)
        {
            validationError = "A journal entry must have at least 2 lines.";
            return;
        }

        if (!falseEntryBalanced())
        {
            validationError = "Total debits must equal total credits.";
            return;
        }

        try
        {
            manualEntry.Lines = manualLines;
            manualEntry.TotalDebit = manualLines.Sum(l => l.DebitAmount);
            manualEntry.TotalCredit = manualLines.Sum(l => l.CreditAmount);
            manualEntry.CreatedBy = AuthService.CurrentUser ?? "accountant";

            await JournalEntryService.CreateAsync(manualEntry);
            await LoadEntries();
            CloseManualModal();
        }
        catch (Exception ex)
        {
            validationError = $"Error creating entry: {ex.Message}";
            Console.WriteLine($"Error saving manual entry: {ex.Message}");
        }
    }

    private async Task PostJournalEntry(JournalEntry entry)
    {
        try
        {
            await JournalEntryService.PostAsync(entry.JournalId, AuthService.CurrentUser ?? "accountant");
            await LoadEntries();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error posting entry: {ex.Message}");
        }
    }

    private void ViewEntry(JournalEntry entry)
    {
        viewEntry = entry;
        showViewModal = true;
    }

    private void CloseViewModal()
    {
        showViewModal = false;
        viewEntry = null;
    }

    private void CloseManualModal()
    {
        showManualModal = false;
        validationError = "";
    }

    private string GetStatusBg(string status)
    {
        return status switch
        {
            "Posted" => "#D4E6D4",
            "Draft" => "#E5D9B6",
            "Rejected" => "#F5E6E6",
            _ => "#f3f4f6"
        };
    }

    private string GetStatusColor(string status)
    {
        return status switch
        {
            "Posted" => "#2F3E2A",
            "Draft" => "#92400e",
            "Rejected" => "#b91c1c",
            _ => "#4b5563"
        };
    }

    // Pagination methods
    private IEnumerable<JournalEntry> GetPagedEntries()
    {
        return entries
        .OrderByDescending(e => e.TransactionDate)
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize);
    }

    private void NextPage()
    {
        if (currentPage < TotalPages)
        {
            currentPage++;
        }
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
        }
    }

    private void FirstPage()
    {
        currentPage = 1;
    }

    private void LastPage()
    {
        currentPage = TotalPages;
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            currentPage = page;
        }
    }
}