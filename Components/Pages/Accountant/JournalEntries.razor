@page "/accounting/journal-entries"
@layout AccountantLayout
@using FinanceBank.Services
@using FinanceBank.Models
@inject AuthService AuthService
@inject JournalEntryService JournalEntryService
@inject ChartOfAccountsService ChartOfAccountsService

<!-- Page Header -->
<div
    style="background: linear-gradient(135deg, #5F6F52 0%, #2F3E2A 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
                <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M12 2c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12 6.477 2 12 2z" />
                    <path d="M12 6v6l4 2" stroke="white" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round" />
                </svg>
            </div>
            <div>
                <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Journal Entries</h1>
                <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Real-time accounting
                    entries from all transactions</p>
            </div>
        </div>
        <div style="display: flex; gap: 12px;">
            <button class="btn"
                style="background: rgba(255,255,255,0.2); color: white; padding: 10px 18px; border-radius: 8px; font-size: 14px; font-weight: 600; border: 1px solid rgba(255,255,255,0.3);"
                @onclick="ToggleShowAutoGenerated">
                @(showAutoGenerated ? "📋 Manual Only" : "🔄 Show All Transactions")
            </button>
        </div>
    </div>
</div>

<!-- Summary Cards -->
<div
    style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 24px;">
    <div
        style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb; border-left: 4px solid #5F6F52;">
        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 16px;">
            <div>
                <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 4px;">📋 TOTAL ENTRIES
                </div>
                <div style="font-size: 28px; font-weight: 800; color: #5F6F52;">@(depositCount + withdrawalCount +
                                        loanPaymentCount + loanDisbursalCount)</div>
            </div>
            <div
                style="width: 44px; height: 44px; background: #F0F2EC; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                📑</div>
        </div>
        <div style="font-size: 12px; color: #6b7280;">₱@((depositAmount + withdrawalAmount + loanPaymentAmount +
                        loanDisbursalAmount).ToString("N2"))</div>
    </div>
    <div
        style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb; border-left: 4px solid #6B7B5E;">
        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 16px;">
            <div>
                <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 4px;">💰 DEPOSITS</div>
                <div style="font-size: 28px; font-weight: 800; color: #6B7B5E;">@depositCount</div>
            </div>
            <div
                style="width: 44px; height: 44px; background: #E8F0E8; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                💵</div>
        </div>
        <div style="font-size: 12px; color: #6b7280;">₱@depositAmount.ToString("N2")</div>
    </div>
    <div
        style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb; border-left: 4px solid #9B3A3A;">
        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 16px;">
            <div>
                <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 4px;">🏧 WITHDRAWALS</div>
                <div style="font-size: 28px; font-weight: 800; color: #9B3A3A;">@withdrawalCount</div>
            </div>
            <div
                style="width: 44px; height: 44px; background: #F5E6E6; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                🏧</div>
        </div>
        <div style="font-size: 12px; color: #6b7280;">₱@withdrawalAmount.ToString("N2")</div>
    </div>
    <div
        style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb; border-left: 4px solid #A9B388;">
        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 16px;">
            <div>
                <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 4px;">📈 LOAN PAYMENTS
                </div>
                <div style="font-size: 28px; font-weight: 800; color: #5F6F52;">@loanPaymentCount</div>
            </div>
            <div
                style="width: 44px; height: 44px; background: #E8F0E8; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                📈</div>
        </div>
        <div style="font-size: 12px; color: #6b7280;">₱@loanPaymentAmount.ToString("N2")</div>
    </div>
    <div
        style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb; border-left: 4px solid #5F6F52;">
        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 16px;">
            <div>
                <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 4px;">✓ POSTED</div>
                <div style="font-size: 28px; font-weight: 800; color: #5F6F52;">@postedThisMonth</div>
            </div>
            <div
                style="width: 44px; height: 44px; background: #F0F2EC; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                ✓</div>
        </div>
        <div style="font-size: 12px; color: #6b7280;">This month</div>
    </div>
</div>

<!-- Manual Entry Creation Modal -->
@if (showManualModal)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000;"
        @onclick="CloseManualModal">
        <div style="background: white; border-radius: 12px; padding: 24px; width: 90%; max-width: 800px; max-height: 90vh; overflow-y: auto;"
            @onclick:stopPropagation="true">
            <h2 style="font-size: 18px; font-weight: 700; margin-bottom: 20px; color: #1e293b;">
                <span class="material-symbols-outlined" style="vertical-align: middle;">add_circle</span>
                Create Manual Journal Entry
            </h2>

            @if (!string.IsNullOrEmpty(validationError))
            {
                <div
                    style="background: #F5E6E6; border-left: 4px solid #9B3A3A; padding: 12px 16px; border-radius: 8px; margin-bottom: 16px; color: #7A2E2E;">
                    <strong>❌ Validation Error:</strong> @validationError
                </div>
            }

            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-bottom: 16px;">
                <div>
                    <label
                        style="font-size: 12px; font-weight: 600; color: #6b7280; display: block; margin-bottom: 4px;">Entry
                        Date</label>
                    <input type="date" @bind="manualEntry.TransactionDate"
                        style="width: 100%; padding: 8px 12px; border: 1px solid #e5e7eb; border-radius: 6px; font-size: 14px;" />
                </div>
                <div>
                    <label
                        style="font-size: 12px; font-weight: 600; color: #6b7280; display: block; margin-bottom: 4px;">Reference
                        Number</label>
                    <input type="text" @bind="manualEntry.Reference" placeholder="MJE-001"
                        style="width: 100%; padding: 8px 12px; border: 1px solid #e5e7eb; border-radius: 6px; font-size: 14px;" />
                </div>
            </div>

            <div style="margin-bottom: 20px;">
                <label
                    style="font-size: 12px; font-weight: 600; color: #6b7280; display: block; margin-bottom: 4px;">Description</label>
                <textarea @bind="manualEntry.Description" placeholder="Describe this journal entry..." rows="2"
                    style="width: 100%; padding: 8px 12px; border: 1px solid #e5e7eb; border-radius: 6px; font-size: 14px; resize: vertical;"></textarea>
            </div>

            <div style="margin-bottom: 16px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                    <h3 style="font-size: 14px; font-weight: 600; color: #1e293b; margin: 0;">Journal Lines (Min: 2
                        lines)</h3>
                    <span style="font-size: 12px; color: #64748b;">
                        Current: @manualLines.Count line@(manualLines.Count != 1 ? "s" : "")
                    </span>
                </div>

                <!-- Existing Lines -->
                @if (manualLines.Any())
                {
                    <div style="margin-bottom: 12px; border: 1px solid #e5e7eb; border-radius: 8px; overflow: hidden;">
                        <table style="width: 100%; border-collapse: collapse;">
                            <thead>
                                <tr style="background: #f9fafb; border-bottom: 2px solid #e5e7eb;">
                                    <th
                                        style="padding: 10px 12px; text-align: left; font-size: 11px; color: #6b7280; font-weight: 600; text-transform: uppercase;">
                                        ACCOUNT</th>
                                    <th
                                        style="padding: 10px 12px; text-align: left; font-size: 11px; color: #6b7280; font-weight: 600; text-transform: uppercase;">
                                        DESCRIPTION</th>
                                    <th
                                        style="padding: 10px 12px; text-align: right; font-size: 11px; color: #6b7280; font-weight: 600; text-transform: uppercase;">
                                        DEBIT</th>
                                    <th
                                        style="padding: 10px 12px; text-align: right; font-size: 11px; color: #6b7280; font-weight: 600; text-transform: uppercase;">
                                        CREDIT</th>
                                    <th
                                        style="padding: 10px 12px; text-align: center; font-size: 11px; color: #6b7280; font-weight: 600; text-transform: uppercase; width: 80px;">
                                        ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in manualLines)
                                {
                                    <tr style="border-bottom: 1px solid #f1f5f9;">
                                        <td style="padding: 10px 12px; font-size: 13px;">
                                            <div style="font-weight: 600; color: #5F6F52;">@line.AccountCode</div>
                                            <div style="font-size: 11px; color: #64748b;">@line.AccountName</div>
                                        </td>
                                        <td style="padding: 10px 12px; font-size: 13px; color: #475569;">@line.Description</td>
                                        <td
                                            style="padding: 10px 12px; text-align: right; font-size: 13px; font-family: 'JetBrains Mono', monospace;">
                                            @if (line.DebitAmount > 0)
                                            {
                                                <span style="color: #9B3A3A; font-weight: 600;">₱@line.DebitAmount.ToString("N2")</span>
                                            }
                                            else
                                            {
                                                <span style="color: #cbd5e1;">-</span>
                                            }
                                        </td>
                                        <td
                                            style="padding: 10px 12px; text-align: right; font-size: 13px; font-family: 'JetBrains Mono', monospace;">
                                            @if (line.CreditAmount > 0)
                                            {
                                                <span
                                                    style="color: #5F6F52; font-weight: 600;">₱@line.CreditAmount.ToString("N2")</span>
                                            }
                                            else
                                            {
                                                <span style="color: #cbd5e1;">-</span>
                                            }
                                        </td>
                                        <td style="padding: 10px 12px; text-align: center;">
                                            <button class="btn"
                                                style="background: #F5E6E6; color: #7A2E2E; padding: 4px 10px; font-size: 12px; border-radius: 4px; font-weight: 500;"
                                                @onclick="() => RemoveManualLine(line)">
                                                <span class="material-symbols-outlined"
                                                    style="font-size: 14px; vertical-align: middle;">delete</span>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <!-- Add New Line Form -->
                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px;">
                    <h4 style="font-size: 13px; font-weight: 600; color: #475569; margin: 0 0 12px 0;">
                        <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle;">add</span>
                        Add Line Item
                    </h4>
                    <div style="display: grid; grid-template-columns: 2fr 2fr 1fr 1fr auto; gap: 12px; align-items: end;">
                        <div>
                            <label
                                style="font-size: 11px; font-weight: 500; color: #64748b; display: block; margin-bottom: 4px;">Account
                                *</label>
                            <select @bind="newManualLine.AccountCode"
                                style="width: 100%; padding: 8px 10px; border: 1px solid #e5e7eb; border-radius: 6px; font-size: 13px; background: white;">
                                <option value="">-- Select Account --</option>
                                @foreach (var account in chartOfAccounts)
                                {
                                    <option value="@account.AccountCode">@account.AccountCode - @account.AccountName</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label
                                style="font-size: 11px; font-weight: 500; color: #64748b; display: block; margin-bottom: 4px;">Description</label>
                            <input type="text" @bind="newManualLine.Description" placeholder="Line description"
                                style="width: 100%; padding: 8px 10px; border: 1px solid #e5e7eb; border-radius: 6px; font-size: 13px;" />
                        </div>
                        <div>
                            <label
                                style="font-size: 11px; font-weight: 500; color: #64748b; display: block; margin-bottom: 4px;">Debit</label>
                            <input type="number" @bind="newManualLine.DebitAmount" step="0.01" min="0" placeholder="0.00"
                                style="width: 100%; padding: 8px 10px; border: 1px solid #e5e7eb; border-radius: 6px; font-size: 13px; text-align: right;" />
                        </div>
                        <div>
                            <label
                                style="font-size: 11px; font-weight: 500; color: #64748b; display: block; margin-bottom: 4px;">Credit</label>
                            <input type="number" @bind="newManualLine.CreditAmount" step="0.01" min="0" placeholder="0.00"
                                style="width: 100%; padding: 8px 10px; border: 1px solid #e5e7eb; border-radius: 6px; font-size: 13px; text-align: right;" />
                        </div>
                        <div>
                            <button class="btn"
                                style="background: linear-gradient(135deg, #5F6F52, #2F3E2A); color: white; padding: 8px 16px; border-radius: 6px; font-size: 13px; font-weight: 600;"
                                @onclick="AddManualLine">
                                <span class="material-symbols-outlined"
                                    style="font-size: 16px; vertical-align: middle;">add_circle</span>
                                Add
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Balance Summary -->
                <div
                    style="margin-top: 16px; padding: 16px; border-radius: 8px; background: @(falseEntryBalanced() ? "#F0F2EC" : "#FAF5F5"); border: 2px solid @(falseEntryBalanced() ? "#5F6F52" : "#9B3A3A");">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <div style="font-size: 11px; color: #64748b; font-weight: 600; margin-bottom: 4px;">TOTALS</div>
                            <div style="display: flex; gap: 24px;">
                                <div>
                                    <span style="font-size: 12px; color: #64748b;">Debit:</span>
                                    <span
                                        style="font-size: 16px; font-weight: 700; color: #9B3A3A; margin-left: 6px; font-family: 'JetBrains Mono', monospace;">₱@manualLines.Sum(l
                                                                            => l.DebitAmount).ToString("N2")</span>
                            </div>
                            <div>
                                <span style="font-size: 12px; color: #64748b;">Credit:</span>
                                <span
                                    style="font-size: 16px; font-weight: 700; color: #5F6F52; margin-left: 6px; font-family: 'JetBrains Mono', monospace;">₱@manualLines.Sum(l
                                                                        => l.CreditAmount).ToString("N2")</span>
                            </div>
                        </div>
                    </div>
                    <div style="text-align: right;">
                        @if (falseEntryBalanced())
                            {
                                <div
                                    style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; background: #DDE6D5; color: #166534; border-radius: 6px; font-weight: 600; font-size: 14px;">
                                    <span class="material-symbols-outlined" style="font-size: 18px;">check_circle</span>
                                    Balanced
                                </div>
                            }
                            else
                            {
                                <div
                                    style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; background: #F5E6E6; color: #7A2E2E; border-radius: 6px; font-weight: 600; font-size: 14px;">
                                    <span class="material-symbols-outlined" style="font-size: 18px;">cancel</span>
                                    Out of Balance
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div
                style="display: flex; gap: 12px; justify-content: flex-end; padding-top: 16px; border-top: 1px solid #e5e7eb;">
                <button class="btn"
                    style="background: #f1f5f9; color: #475569; padding: 10px 18px; border-radius: 8px; font-weight: 600; font-size: 14px;"
                    @onclick="CloseManualModal">Cancel</button>
                <button class="btn"
                    style="background: linear-gradient(135deg, #5F6F52, #2F3E2A); color: white; padding: 10px 18px; border-radius: 8px; font-weight: 600; font-size: 14px; opacity: @(CanSaveManualEntry() ? "1" : "0.5");"
                    @onclick="SaveManualEntry" disabled="@(!CanSaveManualEntry())">
                    <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle;">save</span>
                    Create Entry
                </button>
            </div>
        </div>
    </div>
}

<!-- Entries Table -->
<div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h2 style="font-size: 18px; font-weight: 600; color: #111827; margin: 0;">Journal Entries</h2>
        <button class="btn"
            style="background: linear-gradient(135deg, #5F6F52, #2F3E2A); color: white; padding: 10px 18px; border-radius: 8px; font-size: 14px; font-weight: 600;"
            @onclick="OpenManualEntryModal">
            <span class="material-symbols-outlined" style="font-size: 18px; vertical-align: middle;">add_circle</span>
            New Manual Entry
        </button>
    </div>

    <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background: #f9fafb; border-bottom: 1px solid #e5e7eb;">
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">DATE</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">REFERENCE</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">DESCRIPTION</th>
                    <th style="padding: 12px; text-align: right; font-size: 12px; color: #6b7280;">DEBIT</th>
                    <th style="padding: 12px; text-align: right; font-size: 12px; color: #6b7280;">CREDIT</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">STATUS</th>
                    <th style="padding: 12px; text-align: center; font-size: 12px; color: #6b7280;">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @if (entries.Any())
                {
                    @foreach (var entry in GetPagedEntries())
                    {
                        // Manual entry checking removed - SourceType property does not exist in database
                        <tr style="border-bottom: 1px solid #e5e7eb; @(false ? "background: #fef3c7;" : "")">
                            <td style="padding: 12px; font-size: 13px; color: #111827;">
                                @entry.TransactionDate.ToString("yyyy-MM-dd")
                                @if (false)
                                {
                                    <span
                                        style="display: inline-block; margin-left: 6px; font-size: 10px; background: #8B5A2B; color: white; padding: 2px 6px; border-radius: 4px; font-weight: 600;">MANUAL</span>
                                }
                            </td>
                            <td style="padding: 12px; font-size: 13px; color: #4b5563;">@entry.Reference</td>
                            <td style="padding: 12px; font-size: 13px; color: #4b5563; max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
                                title="@entry.Description">@entry.Description</td>
                            <td
                                style="padding: 12px; text-align: right; font-size: 13px; color: #9B3A3A; font-weight: 600; font-family: 'JetBrains Mono', monospace;">
                                @(entry.TotalDebit > 0 ? "₱" + entry.TotalDebit.ToString("N2") : "-")</td>
                            <td
                                style="padding: 12px; text-align: right; font-size: 13px; color: #5F6F52; font-weight: 600; font-family: 'JetBrains Mono', monospace;">
                                @(entry.TotalCredit > 0 ? "₱" + entry.TotalCredit.ToString("N2") : "-")</td>
                            <td style="padding: 12px;">
                                <span
                                    style="display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; background: @GetStatusBg(entry.Status); color: @GetStatusColor(entry.Status);">
                                    @entry.Status
                                </span>
                            </td>
                            <td style="padding: 12px; text-align: center;">
                                @if (false && entry.Status == "Draft")
                                {
                                    <button class="btn"
                                        style="background: linear-gradient(135deg, #5F6F52, #5F6F52); color: white; padding: 6px 12px; font-size: 12px; border-radius: 6px; margin-right: 4px; font-weight: 600;"
                                        @onclick="() => PostJournalEntry(entry)">Post</button>
                                }
                                <button class="btn"
                                    style="background: #e5e7eb; color: #111827; padding: 6px 12px; font-size: 12px; border-radius: 6px; font-weight: 600;"
                                    @onclick="() => ViewEntry(entry)">View</button>
                            </td>
                        </tr>
                    }
                }
                else if (!string.IsNullOrEmpty(errorMessage))
                {
                    <tr>
                        <td colspan="7" style="padding: 24px; text-align: center; font-size: 14px; color: #9B3A3A;">
                            @errorMessage</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="7" style="padding: 24px; text-align: center; font-size: 14px; color: #6b7280;">
                            Loading entries... (Found @(depositCount + withdrawalCount + loanPaymentCount) transactions)
                            <br /><a href="#" style="color: #5F6F52;" @onclick="OpenManualEntryModal">Or create a manual
                                entry</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Controls -->
    @if (entries.Any() && TotalPages > 1)
    {
        <div
            style="display: flex; justify-content: space-between; align-items: center; margin-top: 20px; padding-top: 20px; border-top: 1px solid #e5e7eb;">
            <div style="font-size: 14px; color: #6b7280;">
                Showing @((currentPage - 1) * pageSize + 1) to @Math.Min(currentPage * pageSize, entries.Count) of
                @entries.Count entries
            </div>
            <div style="display: flex; gap: 8px; align-items: center;">
                <button class="btn"
                    style="background: @(currentPage == 1 ? "#f3f4f6" : "#e5e7eb"); color: @(currentPage == 1 ? "#9ca3af" : "#111827"); padding: 8px 12px; border-radius: 6px; font-size: 14px; font-weight: 600;"
                    @onclick="FirstPage" disabled="@(currentPage == 1)">
                    ⏮️ First
                </button>
                <button class="btn"
                    style="background: @(currentPage == 1 ? "#f3f4f6" : "#e5e7eb"); color: @(currentPage == 1 ? "#9ca3af" : "#111827"); padding: 8px 12px; border-radius: 6px; font-size: 14px; font-weight: 600;"
                    @onclick="PreviousPage" disabled="@(currentPage == 1)">
                    ← Previous
                </button>
                <div style="display: flex; gap: 4px;">
                    @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(TotalPages, currentPage + 2); i++)
                    {
                        var pageNum = i;
                        <button class="btn"
                            style="background: @(currentPage == pageNum ? "#5F6F52" : "#f3f4f6"); color: @(currentPage == pageNum ? "white" : "#111827"); padding: 8px 12px; border-radius: 6px; font-size: 14px; font-weight: 600; min-width: 40px;"
                            @onclick="() => GoToPage(pageNum)">
                            @pageNum
                        </button>
                    }
                </div>
                <button class="btn"
                    style="background: @(currentPage == TotalPages ? "#f3f4f6" : "#e5e7eb"); color: @(currentPage == TotalPages ? "#9ca3af" : "#111827"); padding: 8px 12px; border-radius: 6px; font-size: 14px; font-weight: 600;"
                    @onclick="NextPage" disabled="@(currentPage == TotalPages)">
                    Next →
                </button>
                <button class="btn"
                    style="background: @(currentPage == TotalPages ? "#f3f4f6" : "#e5e7eb"); color: @(currentPage == TotalPages ? "#9ca3af" : "#111827"); padding: 8px 12px; border-radius: 6px; font-size: 14px; font-weight: 600;"
                    @onclick="LastPage" disabled="@(currentPage == TotalPages)">
                    Last ⏭️
                </button>
            </div>
        </div>
    }
</div>

<!-- View Entry Modal -->
@if (showViewModal && viewEntry != null)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000;"
        @onclick="CloseViewModal">
        <div style="background: white; border-radius: 12px; padding: 24px; width: 90%; max-width: 700px; max-height: 90vh; overflow-y: auto;"
