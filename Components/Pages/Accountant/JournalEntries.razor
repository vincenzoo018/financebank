                    <div style="font-size: 12px; color: #6b7280; font-weight: 600;">Journal Entry ID</div>
                    <div style="font-size: 14px; color: #111827; font-weight: 500;">@viewEntry.JournalId</div>
                </div>
                <div>
                    <div style="font-size: 12px; color: #6b7280; font-weight: 600;">Reference Number</div>
                    <div style="font-size: 14px; color: #111827; font-weight: 500;">@viewEntry.Reference</div>
                </div>
                <div>
                    <div style="font-size: 12px; color: #6b7280; font-weight: 600;">Entry Date</div>
                    <div style="font-size: 14px; color: #111827; font-weight: 500;">
                        @viewEntry.TransactionDate.ToString("MMMM dd, yyyy")</div>
                </div>
                <div>
                    <div style="font-size: 12px; color: #6b7280; font-weight: 600;">Entry Type</div>
                    <div style="font-size: 14px; color: #111827; font-weight: 500;">@("System" ?? "System")
                    </div>
                </div>
                <div style="grid-column: span 2;">
                    <div style="font-size: 12px; color: #6b7280; font-weight: 600;">Description</div>
                    <div style="font-size: 14px; color: #111827;">@viewEntry.Description</div>
                </div>
                <div>
                    <div style="font-size: 12px; color: #6b7280; font-weight: 600;">Created By</div>
                    <div style="font-size: 14px; color: #111827;">@viewEntry.CreatedBy</div>
                </div>
                <div>
                    <div style="font-size: 12px; color: #6b7280; font-weight: 600;">Posted By</div>
                    <div style="font-size: 14px; color: #111827;">@(viewEntry.PostedBy ?? "-")</div>
                </div>
            </div>

            <h3 style="font-size: 14px; font-weight: 600; margin-bottom: 12px;">Line Items (Double-Entry)</h3>
            <table style="width: 100%; border-collapse: collapse; margin-bottom: 16px;">
