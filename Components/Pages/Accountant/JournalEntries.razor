@page "/accounting/journal-entries"
@layout AccountantLayout
@using FinanceBank.Services
@using FinanceBank.Models
@inject AuthService AuthService
@inject JournalEntryService JournalEntryService

<!-- Page Header -->
<div
    style="background: linear-gradient(135deg, #059669 0%, #047857 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
                <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M12 2c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12 6.477 2 12 2z" />
                    <path d="M12 6v6l4 2" stroke="white" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round" />
                </svg>
            </div>
            <div>
                <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Journal Entries</h1>
                <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Real-time accounting
                    entries from all transactions</p>
            </div>
        </div>
        <div style="display: flex; gap: 12px;">
            <button class="btn"
                style="background: rgba(255,255,255,0.2); color: white; padding: 10px 18px; border-radius: 8px; font-size: 14px; font-weight: 600; border: 1px solid rgba(255,255,255,0.3);"
                @onclick="ToggleShowAutoGenerated">
                @(showAutoGenerated ? "📋 Manual Only" : "🔄 Show All Transactions")
            </button>
        </div>
    </div>
</div>

<!-- Summary Cards -->
<div
    style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 24px;">
    <div
        style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb; border-left: 4px solid #059669;">
        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 16px;">
            <div>
                <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 4px;">📋 TOTAL ENTRIES
                </div>
                <div style="font-size: 28px; font-weight: 800; color: #059669;">@(depositCount + withdrawalCount +
                                        loanPaymentCount + loanDisbursalCount)</div>
            </div>
            <div
                style="width: 44px; height: 44px; background: #f0fdf4; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                📑</div>
        </div>
        <div style="font-size: 12px; color: #6b7280;">₱@((depositAmount + withdrawalAmount + loanPaymentAmount +
                        loanDisbursalAmount).ToString("N2"))</div>
    </div>
    <div
        style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb; border-left: 4px solid #3b82f6;">
        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 16px;">
            <div>
                <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 4px;">💰 DEPOSITS</div>
                <div style="font-size: 28px; font-weight: 800; color: #3b82f6;">@depositCount</div>
            </div>
            <div
                style="width: 44px; height: 44px; background: #dbeafe; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                💵</div>
        </div>
        <div style="font-size: 12px; color: #6b7280;">₱@depositAmount.ToString("N2")</div>
    </div>
    <div
        style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb; border-left: 4px solid #f59e0b;">
        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 16px;">
            <div>
                <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 4px;">🏧 WITHDRAWALS</div>
                <div style="font-size: 28px; font-weight: 800; color: #f59e0b;">@withdrawalCount</div>
            </div>
            <div
                style="width: 44px; height: 44px; background: #fef3c7; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                🏧</div>
        </div>
        <div style="font-size: 12px; color: #6b7280;">₱@withdrawalAmount.ToString("N2")</div>
    </div>
    <div
        style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb; border-left: 4px solid #8b5cf6;">
        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 16px;">
            <div>
                <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 4px;">📈 LOAN PAYMENTS
                </div>
                <div style="font-size: 28px; font-weight: 800; color: #8b5cf6;">@loanPaymentCount</div>
            </div>
            <div
                style="width: 44px; height: 44px; background: #ede9fe; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                📈</div>
        </div>
        <div style="font-size: 12px; color: #6b7280;">₱@loanPaymentAmount.ToString("N2")</div>
    </div>
    <div
        style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb; border-left: 4px solid #059669;">
        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 16px;">
            <div>
                <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 4px;">✓ POSTED</div>
                <div style="font-size: 28px; font-weight: 800; color: #059669;">@postedThisMonth</div>
            </div>
            <div
                style="width: 44px; height: 44px; background: #f0fdf4; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                ✓</div>
        </div>
        <div style="font-size: 12px; color: #6b7280;">This month</div>
    </div>
</div>

<!-- Create Modal -->
@if (showModal)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000;"
        @onclick="CloseModal">
        <div style="background: white; border-radius: 12px; padding: 24px; width: 90%; max-width: 700px; max-height: 90vh; overflow-y: auto;"
            @onclick:stopPropagation="true">
            <h2 style="font-size: 18px; font-weight: 700; margin-bottom: 20px;">@(isEditing ? "Edit Journal Entry" : "New Journal Entry")</h2>

            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-bottom: 16px;">
                <div>
                    <label style="font-size: 12px; font-weight: 600; color: #6b7280;">Date</label>
                    <input type="date" @bind="formData.TransactionDate"
                        style="width: 100%; padding: 8px; border: 1px solid #e5e7eb; border-radius: 6px;" />
                </div>
                <div>
                    <label style="font-size: 12px; font-weight: 600; color: #6b7280;">Reference</label>
                    <input type="text" @bind="formData.Reference" placeholder="REF-001"
                        style="width: 100%; padding: 8px; border: 1px solid #e5e7eb; border-radius: 6px;" />
                </div>
            </div>

            <div style="margin-bottom: 16px;">
                <label style="font-size: 12px; font-weight: 600; color: #6b7280;">Description</label>
                <input type="text" @bind="formData.Description" placeholder="Entry description"
                    style="width: 100%; padding: 8px; border: 1px solid #e5e7eb; border-radius: 6px;" />
            </div>

            <div style="margin-bottom: 16px;">
                <h3 style="font-size: 14px; font-weight: 600; margin-bottom: 12px;">Line Items</h3>
                <table style="width: 100%; border-collapse: collapse; margin-bottom: 12px;">
                    <thead>
                        <tr style="background: #f9fafb; border-bottom: 1px solid #e5e7eb;">
                            <th style="padding: 8px; text-align: left; font-size: 12px;">Account Code</th>
                            <th style="padding: 8px; text-align: right; font-size: 12px;">Debit</th>
                            <th style="padding: 8px; text-align: right; font-size: 12px;">Credit</th>
                            <th style="padding: 8px; text-align: center; font-size: 12px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in lineItems)
                        {
                            <tr style="border-bottom: 1px solid #e5e7eb;">
                                <td style="padding: 8px;">@line.AccountCode</td>
                                <td style="padding: 8px; text-align: right;">@line.DebitAmount.ToString("N2")</td>
                                <td style="padding: 8px; text-align: right;">@line.CreditAmount.ToString("N2")</td>
                                <td style="padding: 8px; text-align: center;">
                                    <button class="btn"
                                        style="background: #f3f4f6; color: #111827; padding: 4px 8px; font-size: 12px;"
                                        @onclick="() => RemoveLine(line)">Remove</button>
                                </td>
                            </tr>
                        }
                        <tr style="background: #f9fafb; border-bottom: 1px solid #e5e7eb;">
                            <td style="padding: 8px;"><input type="text" @bind="newLine.AccountCode" placeholder="ACC-001"
                                    style="width: 100%; padding: 6px; border: 1px solid #e5e7eb; border-radius: 4px;" />
                            </td>
                            <td style="padding: 8px;"><input type="number" @bind="newLine.DebitAmount" step="0.01"
                                    placeholder="0.00"
                                    style="width: 100%; padding: 6px; border: 1px solid #e5e7eb; border-radius: 4px; text-align: right;" />
                            </td>
                            <td style="padding: 8px;"><input type="number" @bind="newLine.CreditAmount" step="0.01"
                                    placeholder="0.00"
                                    style="width: 100%; padding: 6px; border: 1px solid #e5e7eb; border-radius: 4px; text-align: right;" />
                            </td>
                            <td style="padding: 8px; text-align: center;">
                                <button class="btn"
                                    style="background: #3b82f6; color: white; padding: 4px 8px; font-size: 12px;"
                                    @onclick="AddLineItem">Add</button>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div
                    style="display: flex; justify-content: flex-end; gap: 24px; padding: 12px; background: #f9fafb; border-radius: 6px;">
                    <div><strong>Debit Total:</strong> ₱@lineItems.Sum(l => l.DebitAmount).ToString("N2")</div>
                    <div><strong>Credit Total:</strong> ₱@lineItems.Sum(l => l.CreditAmount).ToString("N2")</div>
                    <div style="color: @(IsBalanced() ? "#10b981" : "#ef4444");"><strong>@(IsBalanced() ? "✓ Balanced" : "✗ Out of Balance")</strong></div>
                </div>
            </div>

            <div style="display: flex; gap: 12px; justify-content: flex-end;">
                <button class="btn"
                    style="background: #e5e7eb; color: #111827; padding: 10px 18px; border-radius: 8px; font-weight: 600;"
                    @onclick="CloseModal">Cancel</button>
                <button class="btn"
                    style="background: #059669; color: white; padding: 10px 18px; border-radius: 8px; font-weight: 600;"
                    @onclick="SaveEntry" disabled="@(!IsBalanced())">
                    @(isEditing ? "Update" : "Create") Entry
                </button>
            </div>
        </div>
    </div>
}

<!-- Entries Table -->
<div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h2 style="font-size: 18px; font-weight: 600; color: #111827; margin: 0;">Journal Entries</h2>
        <button class="btn"
            style="background: #059669; color: white; padding: 10px 18px; border-radius: 8px; font-size: 14px; font-weight: 600;"
            @onclick="OpenNewEntryModal">+ New Entry</button>
    </div>

    <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background: #f9fafb; border-bottom: 1px solid #e5e7eb;">
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">DATE</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">REFERENCE</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">DESCRIPTION</th>
                    <th style="padding: 12px; text-align: right; font-size: 12px; color: #6b7280;">DEBIT</th>
                    <th style="padding: 12px; text-align: right; font-size: 12px; color: #6b7280;">CREDIT</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">STATUS</th>
                    <th style="padding: 12px; text-align: center; font-size: 12px; color: #6b7280;">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @if (entries.Any())
                {
                    @foreach (var entry in entries.OrderByDescending(e => e.TransactionDate))
                    {
                        var isAutoGenerated = entry.JournalId < 0 || entry.JournalNumber?.StartsWith("AUTO-") == true;
                        <tr style="border-bottom: 1px solid #e5e7eb; @(isAutoGenerated ? "background: #fefce8;" : "")">
                            <td style="padding: 12px; font-size: 13px; color: #111827;">
                                @entry.TransactionDate.ToString("yyyy-MM-dd")
                                @if (isAutoGenerated)
                                {
                                    <span
                                        style="display: inline-block; margin-left: 6px; font-size: 10px; background: #fef3c7; color: #92400e; padding: 2px 6px; border-radius: 4px;">AUTO</span>
                                }
                            </td>
                            <td style="padding: 12px; font-size: 13px; color: #4b5563;">@entry.Reference</td>
                            <td style="padding: 12px; font-size: 13px; color: #4b5563; max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
                                title="@entry.Description">@entry.Description</td>
                            <td style="padding: 12px; text-align: right; font-size: 13px; color: #10b981; font-weight: 600;">
                                @(entry.TotalDebit > 0 ? "₱" + entry.TotalDebit.ToString("N2") : "")</td>
                            <td style="padding: 12px; text-align: right; font-size: 13px; color: #ef4444; font-weight: 600;">
                                @(entry.TotalCredit > 0 ? "₱" + entry.TotalCredit.ToString("N2") : "")</td>
                            <td style="padding: 12px;">
                                <span
                                    style="display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; background: @GetStatusBg(entry.Status); color: @GetStatusColor(entry.Status);">
                                    @entry.Status
                                </span>
                            </td>
                            <td style="padding: 12px; text-align: center;">
                                @if (!isAutoGenerated && entry.Status == "Draft")
                                {
                                    <button class="btn"
                                        style="background: #059669; color: white; padding: 6px 12px; font-size: 12px; border-radius: 6px; margin-right: 4px; font-weight: 600;"
                                        @onclick="() => EditEntry(entry)">Edit</button>
                                    <button class="btn"
                                        style="background: #10b981; color: white; padding: 6px 12px; font-size: 12px; border-radius: 6px; font-weight: 600;"
                                        @onclick="() => PostEntry(entry)">Post</button>
                                }
                                <button class="btn"
                                    style="background: #e5e7eb; color: #111827; padding: 6px 12px; font-size: 12px; border-radius: 6px; font-weight: 600;"
                                    @onclick="() => ViewEntry(entry)">View</button>
                            </td>
                        </tr>
                    }
                }
                else if (!string.IsNullOrEmpty(errorMessage))
                {
                    <tr>
                        <td colspan="7" style="padding: 24px; text-align: center; font-size: 14px; color: #ef4444;">
                            @errorMessage</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="7" style="padding: 24px; text-align: center; font-size: 14px; color: #6b7280;">
                            Loading entries... (Found @(depositCount + withdrawalCount + loanPaymentCount) transactions)
                            <br /><a href="#" style="color: #8b5cf6;" @onclick="OpenNewEntryModal">Or create a manual
                                entry</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- View Entry Modal -->
@if (showViewModal && viewEntry != null)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000;"
        @onclick="CloseViewModal">
        <div style="background: white; border-radius: 12px; padding: 24px; width: 90%; max-width: 700px; max-height: 90vh; overflow-y: auto;"
            @onclick:stopPropagation="true">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h2 style="font-size: 18px; font-weight: 700; margin: 0;">Journal Entry Details</h2>
                <span
                    style="padding: 4px 12px; border-radius: 999px; font-size: 12px; font-weight: 600; background: @GetStatusBg(viewEntry.Status); color: @GetStatusColor(viewEntry.Status);">@viewEntry.Status</span>
            </div>

            <div
                style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-bottom: 20px; background: #f9fafb; padding: 16px; border-radius: 8px;">
                <div>
                    <div style="font-size: 12px; color: #6b7280; font-weight: 600;">Journal Number</div>
                    <div style="font-size: 14px; color: #111827; font-weight: 500;">@viewEntry.JournalNumber</div>
                </div>
                <div>
                    <div style="font-size: 12px; color: #6b7280; font-weight: 600;">Transaction Date</div>
                    <div style="font-size: 14px; color: #111827; font-weight: 500;">
                        @viewEntry.TransactionDate.ToString("MMMM dd, yyyy")</div>
                </div>
                <div style="grid-column: span 2;">
                    <div style="font-size: 12px; color: #6b7280; font-weight: 600;">Description</div>
                    <div style="font-size: 14px; color: #111827;">@viewEntry.Description</div>
                </div>
                <div>
                    <div style="font-size: 12px; color: #6b7280; font-weight: 600;">Reference</div>
                    <div style="font-size: 14px; color: #111827;">@(viewEntry.Reference ?? "-")</div>
                </div>
                <div>
                    <div style="font-size: 12px; color: #6b7280; font-weight: 600;">Created By</div>
                    <div style="font-size: 14px; color: #111827;">@viewEntry.CreatedBy</div>
                </div>
            </div>

            <h3 style="font-size: 14px; font-weight: 600; margin-bottom: 12px;">Line Items (Double-Entry)</h3>
            <table style="width: 100%; border-collapse: collapse; margin-bottom: 16px;">
                <thead>
                    <tr style="background: #f9fafb; border-bottom: 1px solid #e5e7eb;">
                        <th style="padding: 10px; text-align: left; font-size: 12px; color: #6b7280;">ACCOUNT</th>
                        <th style="padding: 10px; text-align: left; font-size: 12px; color: #6b7280;">DESCRIPTION</th>
                        <th style="padding: 10px; text-align: right; font-size: 12px; color: #6b7280;">DEBIT</th>
                        <th style="padding: 10px; text-align: right; font-size: 12px; color: #6b7280;">CREDIT</th>
                    </tr>
                </thead>
                <tbody>
                    @if (viewEntry.Lines != null && viewEntry.Lines.Any())
                    {
                        @foreach (var line in viewEntry.Lines)
                        {
                            <tr style="border-bottom: 1px solid #e5e7eb;">
                                <td style="padding: 10px; font-size: 13px;">
                                    <span style="font-weight: 600; color: #3b82f6;">@line.AccountCode</span>
                                    <span style="color: #4b5563;"> - @line.AccountName</span>
                                </td>
                                <td style="padding: 10px; font-size: 13px; color: #6b7280;">@line.Description</td>
                                <td
                                    style="padding: 10px; text-align: right; font-size: 13px; color: @(line.DebitAmount > 0 ? "#10b981" : "#9ca3af"); font-weight: @(line.DebitAmount > 0 ? "600" : "400");">
                                    @(line.DebitAmount > 0 ? "₱" + line.DebitAmount.ToString("N2") : "-")
                                </td>
                                <td
                                    style="padding: 10px; text-align: right; font-size: 13px; color: @(line.CreditAmount > 0 ? "#ef4444" : "#9ca3af"); font-weight: @(line.CreditAmount > 0 ? "600" : "400");">
                                    @(line.CreditAmount > 0 ? "₱" + line.CreditAmount.ToString("N2") : "-")
                                </td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    <tr style="background: #f0fdf4; border-top: 2px solid #059669;">
                        <td colspan="2" style="padding: 12px; text-align: right; font-weight: 700; color: #111827;">TOTALS:
                        </td>
                        <td style="padding: 12px; text-align: right; font-weight: 700; color: #10b981;">
                            ₱@viewEntry.TotalDebit.ToString("N2")</td>
                        <td style="padding: 12px; text-align: right; font-weight: 700; color: #ef4444;">
                            ₱@viewEntry.TotalCredit.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>

            <div
                style="text-align: center; padding: 12px; border-radius: 8px; background: @(viewEntry.TotalDebit == viewEntry.TotalCredit ? "#f0fdf4" : "#fef2f2"); color: @(viewEntry.TotalDebit == viewEntry.TotalCredit ? "#065f46" : "#991b1b"); font-weight: 600;">
                @(viewEntry.TotalDebit == viewEntry.TotalCredit ? "✓ Entry is balanced" : "✗ Entry is NOT balanced")
            </div>

            <div style="display: flex; gap: 12px; justify-content: flex-end; margin-top: 20px;">
                <button class="btn"
                    style="background: #e5e7eb; color: #111827; padding: 10px 18px; border-radius: 8px; font-weight: 600;"
                    @onclick="CloseViewModal">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private List<JournalEntry> entries = new();
    private JournalEntry formData = new();
    private List<JournalEntryLine> lineItems = new();
    private JournalEntryLine newLine = new();
    private bool showModal = false;
    private bool showViewModal = false;
    private JournalEntry? viewEntry = null;
    private bool isEditing = false;
    private int editingId = 0;
    private int postedThisMonth = 0;
    private int pendingCount = 0;
    private bool showAutoGenerated = true;
    private string errorMessage = "";

    // Transaction stats
    private int depositCount = 0;
    private decimal depositAmount = 0;
    private int withdrawalCount = 0;
    private decimal withdrawalAmount = 0;
    private int loanPaymentCount = 0;
    private decimal loanPaymentAmount = 0;
    private int loanDisbursalCount = 0;
    private decimal loanDisbursalAmount = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadEntries();
        await LoadTransactionStats();
    }

    private async Task LoadEntries()
    {
        try
        {
            errorMessage = "";
            // Always load with transactions to show all entries
            entries = await JournalEntryService.GetAllWithTransactionsAsync();
            CalculateStats();
            System.Diagnostics.Debug.WriteLine($"Loaded {entries.Count} entries");

            if (entries.Count == 0)
            {
                errorMessage = "No journal entries found. Transactions may not be available yet.";
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error loading entries: {ex.Message}");
            errorMessage = $"Error loading entries: {ex.Message}";
            entries = new List<JournalEntry>();
        }
        StateHasChanged();
    }

    private async Task LoadTransactionStats()
    {
        try
        {
            var stats = await JournalEntryService.GetTransactionStatsAsync();
            depositCount = stats.TotalDeposits;
            depositAmount = stats.DepositAmount;
            withdrawalCount = stats.TotalWithdrawals;
            withdrawalAmount = stats.WithdrawalAmount;
            loanPaymentCount = stats.TotalLoanPayments;
            loanPaymentAmount = stats.LoanPaymentAmount;
            loanDisbursalCount = stats.TotalLoanDisbursals;
            loanDisbursalAmount = stats.LoanDisbursalAmount;
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error loading stats: {ex.Message}");
        }
    }

    private async Task ToggleShowAutoGenerated()
    {
        showAutoGenerated = !showAutoGenerated;
        await LoadEntries();
    }

    private void CalculateStats()
    {
        var today = DateTime.Today;
        var monthStart = new DateTime(today.Year, today.Month, 1);
        var monthEnd = monthStart.AddMonths(1).AddDays(-1);

        postedThisMonth = entries.Count(e => e.TransactionDate >= monthStart && e.TransactionDate <= monthEnd && e.Status ==
        "Posted");
        pendingCount = entries.Count(e => e.Status == "Draft");
    }

    private void OpenNewEntryModal()
    {
        formData = new JournalEntry { TransactionDate = DateTime.Today, Status = "Draft" };
        lineItems = new List<JournalEntryLine>();
        newLine = new JournalEntryLine();
        isEditing = false;
        editingId = 0;
        showModal = true;
    }

    private void EditEntry(JournalEntry entry)
    {
        formData = entry;
        lineItems = entry.Lines?.ToList() ?? new List<JournalEntryLine>();
        newLine = new JournalEntryLine();
        isEditing = true;
        editingId = entry.JournalId;
        showModal = true;
    }

    private void ViewEntry(JournalEntry entry)
    {
        viewEntry = entry;
        showViewModal = true;
    }

    private void CloseViewModal()
    {
        showViewModal = false;
        viewEntry = null;
    }

    private async Task SaveEntry()
    {
        try
        {
            formData.Lines = lineItems;
            formData.TotalDebit = lineItems.Sum(l => l.DebitAmount);
            formData.TotalCredit = lineItems.Sum(l => l.CreditAmount);
            formData.CreatedBy = AuthService.CurrentUser ?? "accountant";

            if (isEditing)
            {
                await JournalEntryService.UpdateAsync(formData);
            }
            else
            {
                await JournalEntryService.CreateAsync(formData);
            }

            await LoadEntries();
            CloseModal();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error saving entry: {ex.Message}");
        }
    }

    private async Task PostEntry(JournalEntry entry)
    {
        try
        {
            if (entry.TotalDebit == entry.TotalCredit)
            {
                await JournalEntryService.PostAsync(entry.JournalId, AuthService.CurrentUser ?? "accountant");
                await LoadEntries();
            }
            else
            {
                System.Diagnostics.Debug.WriteLine("Cannot post unbalanced entry");
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error posting entry: {ex.Message}");
        }
    }

    private void AddLineItem()
    {
        if (!string.IsNullOrEmpty(newLine.AccountCode))
        {
            lineItems.Add(new JournalEntryLine
            {
                AccountCode = newLine.AccountCode,
                DebitAmount = newLine.DebitAmount,
                CreditAmount = newLine.CreditAmount
            });
            newLine = new JournalEntryLine();
        }
    }

    private void RemoveLine(JournalEntryLine line)
    {
        lineItems.Remove(line);
    }

    private bool IsBalanced()
    {
        return lineItems.Sum(l => l.DebitAmount) == lineItems.Sum(l => l.CreditAmount) && lineItems.Count > 0;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private string GetStatusBg(string status)
    {
        return status switch
        {
            "Posted" => "#d1fae5",
            "Draft" => "#fef3c7",
            "Rejected" => "#fee2e2",
            _ => "#f3f4f6"
        };
    }

    private string GetStatusColor(string status)
    {
        return status switch
        {
            "Posted" => "#065f46",
            "Draft" => "#92400e",
            "Rejected" => "#b91c1c",
            _ => "#4b5563"
        };
    }
}