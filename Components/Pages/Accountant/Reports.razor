@page "/accountant/reports"
@layout AccountantLayout
@using FinanceBank.Services
@using FinanceBank.Models
@inject AuthService AuthService

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #059669 0%, #047857 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
            <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path d="M3 3h18v18H3z"/>
                <path d="M9 9h6v6H9z"/>
            </svg>
        </div>
        <div>
            <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Reports</h1>
            <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Generate and view financial reports</p>
        </div>
    </div>
</div>

<!-- Available Reports -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;">
    <!-- Monthly Financial Statement -->
    <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
            <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #059669, #047857); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                </svg>
            </div>
            <div>
                <h3 style="font-size: 16px; font-weight: 700; color: #111827; margin: 0;">Monthly Financial Statement</h3>
                <p style="font-size: 12px; color: #6b7280; margin: 4px 0 0 0;">Complete overview for the month</p>
            </div>
        </div>
        <button class="btn" style="width: 100%; background: #059669; color: white; padding: 10px; border-radius: 8px; font-weight: 600;">Generate Report</button>
    </div>

    <!-- Account Reconciliation -->
    <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
            <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #059669, #047857); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                    <polyline points="20 6 9 17 4 12"/>
                </svg>
            </div>
            <div>
                <h3 style="font-size: 16px; font-weight: 700; color: #111827; margin: 0;">Account Reconciliation</h3>
                <p style="font-size: 12px; color: #6b7280; margin: 4px 0 0 0;">Verify account balances</p>
            </div>
        </div>
        <button class="btn" style="width: 100%; background: #059669; color: white; padding: 10px; border-radius: 8px; font-weight: 600;">Generate Report</button>
    </div>

    <!-- Expense Summary -->
    <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
            <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #f59e0b, #d97706); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="1"/>
                    <path d="M19.07 4.93l-2.58 2.58A8 8 0 1 0 20.5 12z"/>
                </svg>
            </div>
            <div>
                <h3 style="font-size: 16px; font-weight: 700; color: #111827; margin: 0;">Expense Summary</h3>
                <p style="font-size: 12px; color: #6b7280; margin: 4px 0 0 0;">Breakdown of all expenses</p>
            </div>
        </div>
        <button class="btn" style="width: 100%; background: #f59e0b; color: white; padding: 10px; border-radius: 8px; font-weight: 600;">Generate Report</button>
    </div>

    <!-- Cash Flow Analysis -->
    <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
            <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #059669, #047857); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M12 2v20M2 12h20"/>
                </svg>
            </div>
            <div>
                <h3 style="font-size: 16px; font-weight: 700; color: #111827; margin: 0;">Cash Flow Analysis</h3>
                <p style="font-size: 12px; color: #6b7280; margin: 4px 0 0 0;">Analyze cash movements</p>
            </div>
        </div>
        <button class="btn" style="width: 100%; background: #059669; color: white; padding: 10px; border-radius: 8px; font-weight: 600;">Generate Report</button>
    </div>

    <!-- Payables & Receivables -->
    <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
            <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #059669, #047857); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
            </div>
            <div>
                <h3 style="font-size: 16px; font-weight: 700; color: #111827; margin: 0;">Payables & Receivables</h3>
                <p style="font-size: 12px; color: #6b7280; margin: 4px 0 0 0;">Outstanding amounts summary</p>
            </div>
        </div>
        <button class="btn" style="width: 100%; background: #059669; color: white; padding: 10px; border-radius: 8px; font-weight: 600;">Generate Report</button>
    </div>

    <!-- Audit Trail -->
    <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
            <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #059669, #047857); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M12 2v20M2 12h20"/>
                </svg>
            </div>
            <div>
                <h3 style="font-size: 16px; font-weight: 700; color: #111827; margin: 0;">Audit Trail</h3>
                <p style="font-size: 12px; color: #6b7280; margin: 4px 0 0 0;">System activity log</p>
            </div>
        </div>
        <button class="btn" style="width: 100%; background: #059669; color: white; padding: 10px; border-radius: 8px; font-weight: 600;">Generate Report</button>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        // Load any necessary data
    }
}
