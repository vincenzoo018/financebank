@page "/accountant/chart-of-accounts"
@layout AccountantLayout
@using FinanceBank.Models
@using FinanceBank.Services
@inject AccountingService AccountingService
@inject NotificationService NotificationService
@inject AuthService AuthService

<!-- Page Header -->
<div
    style="background: linear-gradient(135deg, #059669 0%, #047857 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
            <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path
                    d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
        </div>
        <div>
            <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Chart of Accounts</h1>
            <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Manage financial accounts
                structure</p>
        </div>
    </div>
</div>

<!-- Action Bar -->
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <div style="display: flex; gap: 12px;">
        <button
            style="background: linear-gradient(135deg, #059669, #10b981); color: white; padding: 12px 24px; border: none; border-radius: 10px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px;"
            @onclick="ShowAddModal">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Add Account
        </button>
    </div>
    <div style="display: flex; align-items: center; gap: 12px;">
        <div style="position: relative;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2"
                style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%);">
                <circle cx="11" cy="11" r="8" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <input type="text" placeholder="Search accounts..." @bind="searchQuery" @bind:event="oninput"
                style="padding: 10px 16px 10px 42px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px; width: 280px;" />
        </div>
        <select @bind="filterType"
            style="padding: 10px 16px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px; background: white;">
            <option value="">All Types</option>
            <option value="Asset">Asset</option>
            <option value="Liability">Liability</option>
            <option value="Equity">Equity</option>
            <option value="Revenue">Revenue</option>
            <option value="Expense">Expense</option>
        </select>
    </div>
</div>

<!-- Summary Cards -->
<div style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; margin-bottom: 24px;">
    <div
        style="background: linear-gradient(135deg, #ecfdf5, #d1fae5); border-radius: 12px; padding: 18px; border: 1px solid #6ee7b7; text-align: center;">
        <div style="font-size: 12px; color: #047857; font-weight: 600; margin-bottom: 6px;">ASSETS</div>
        <div style="font-size: 24px; font-weight: 700; color: #059669;">@accounts.Count(a => a.AccountType == "Asset")
        </div>
    </div>
    <div
        style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); border-radius: 12px; padding: 18px; border: 1px solid #6ee7b7; text-align: center;">
        <div style="font-size: 12px; color: #047857; font-weight: 600; margin-bottom: 6px;">LIABILITIES</div>
        <div style="font-size: 24px; font-weight: 700; color: #059669;">@accounts.Count(a => a.AccountType ==
                        "Liability")</div>
    </div>
    <div
        style="background: linear-gradient(135deg, #ecfdf5, #d1fae5); border-radius: 12px; padding: 18px; border: 1px solid #6ee7b7; text-align: center;">
        <div style="font-size: 12px; color: #047857; font-weight: 600; margin-bottom: 6px;">EQUITY</div>
        <div style="font-size: 24px; font-weight: 700; color: #059669;">@accounts.Count(a => a.AccountType == "Equity")
        </div>
    </div>
    <div
        style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); border-radius: 12px; padding: 18px; border: 1px solid #6ee7b7; text-align: center;">
        <div style="font-size: 12px; color: #047857; font-weight: 600; margin-bottom: 6px;">REVENUE</div>
        <div style="font-size: 24px; font-weight: 700; color: #059669;">@accounts.Count(a => a.AccountType == "Revenue")
        </div>
    </div>
    <div
        style="background: linear-gradient(135deg, #ecfdf5, #d1fae5); border-radius: 12px; padding: 18px; border: 1px solid #6ee7b7; text-align: center;">
        <div style="font-size: 12px; color: #047857; font-weight: 600; margin-bottom: 6px;">EXPENSES</div>
        <div style="font-size: 24px; font-weight: 700; color: #059669;">@accounts.Count(a => a.AccountType == "Expense")
        </div>
    </div>
</div>

<!-- Alerts -->
@if (!string.IsNullOrEmpty(successMessage))
{
    <div
        style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); border: 1px solid #6ee7b7; color: #065f46; padding: 16px 20px; border-radius: 12px; margin-bottom: 20px; display: flex; align-items: center; gap: 12px;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
        <span style="font-weight: 500;">@successMessage</span>
        <button @onclick="() => successMessage = string.Empty"
            style="margin-left: auto; background: none; border: none; color: #065f46; cursor: pointer; font-size: 18px;">×</button>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div
        style="background: #fee2e2; border: 1px solid #fecaca; color: #991b1b; padding: 16px 20px; border-radius: 12px; margin-bottom: 20px; display: flex; align-items: center; gap: 12px;">
        <span style="font-weight: 500;">❌ @errorMessage</span>
        <button @onclick="() => errorMessage = string.Empty"
            style="margin-left: auto; background: none; border: none; color: #991b1b; cursor: pointer; font-size: 18px;">×</button>
    </div>
}

<!-- Chart of Accounts Table -->
<div style="background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden;">
    <div style="background: linear-gradient(135deg, #059669, #10b981); color: white; padding: 20px 24px;">
        <h4 style="margin: 0; font-weight: 600; font-size: 18px;">
            📊 Account List
        </h4>
        <p style="margin: 6px 0 0 0; opacity: 0.9; font-size: 13px;">@FilteredAccounts.Count() accounts found</p>
    </div>

    <div style="padding: 24px;">
        @if (isLoading)
        {
            <div style="text-align: center; padding: 60px;">
                <div
                    style="width: 48px; height: 48px; border: 4px solid #e5e7eb; border-top-color: #059669; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto;">
                </div>
                <p style="margin-top: 16px; color: #6b7280;">Loading accounts...</p>
            </div>
        }
        else if (!FilteredAccounts.Any())
        {
            <div style="text-align: center; padding: 60px;">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5"
                    style="margin: 0 auto 16px;">
                    <path
                        d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
                <p style="color: #6b7280; font-size: 16px;">No accounts found</p>
                <p style="color: #9ca3af; font-size: 14px;">Add accounts or adjust your filters</p>
            </div>
        }
        else
        {
            <table style="width: 100%; border-collapse: separate; border-spacing: 0;">
                <thead>
                    <tr style="background: linear-gradient(135deg, #f8fafc, #f1f5f9);">
                        <th
                            style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">
                            Code</th>
                        <th
                            style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">
                            Account Name</th>
                        <th
                            style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">
                            Type</th>
                        <th
                            style="padding: 14px 16px; text-align: center; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">
                            Level</th>
                        <th
                            style="padding: 14px 16px; text-align: center; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">
                            Status</th>
                        <th
                            style="padding: 14px 16px; text-align: center; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">
                            Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var account in FilteredAccounts)
                    {
                        <tr style="border-bottom: 1px solid #f1f5f9; transition: background 0.2s;">
                            <td style="padding: 16px;">
                                <span
                                    style="background: #e0e7ff; color: #3730a3; padding: 4px 10px; border-radius: 6px; font-family: monospace; font-weight: 600;">@account.AccountCode</span>
                            </td>
                            <td style="padding: 16px;">
                                <div style="font-weight: 600; color: #1e293b;">@account.AccountName</div>
                                @if (!string.IsNullOrEmpty(account.ParentAccountCode))
                                {
                                    <div style="font-size: 12px; color: #64748b; margin-top: 2px;">Parent:
                                        @account.ParentAccountCode</div>
                                }
                            </td>
                            <td style="padding: 16px;">
                                @{
                                    var (typeColor, typeBg) = GetAccountTypeStyle(account.AccountType);
                                }
                                <span
                                    style="background: @typeBg; color: @typeColor; padding: 4px 10px; border-radius: 6px; font-weight: 600; font-size: 12px;">@account.AccountType</span>
                            </td>
                            <td style="padding: 16px; text-align: center;">
                                <span style="font-weight: 600; color: #374151;">@account.Level</span>
                            </td>
                            <td style="padding: 16px; text-align: center;">
                                @if (account.IsActive)
                                {
                                    <span
                                        style="background: #d1fae5; color: #065f46; padding: 4px 10px; border-radius: 6px; font-weight: 600; font-size: 12px;">Active</span>
                                }
                                else
                                {
                                    <span
                                        style="background: #f1f5f9; color: #64748b; padding: 4px 10px; border-radius: 6px; font-weight: 600; font-size: 12px;">Inactive</span>
                                }
                            </td>
                            <td style="padding: 16px; text-align: center;">
                                <button
                                    style="background: linear-gradient(135deg, #059669, #047857); color: white; padding: 6px 12px; border: none; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer; margin-right: 4px;"
                                    @onclick="() => EditAccount(account)">
                                    ✏️ Edit
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<!-- Add/Edit Account Modal -->
@if (showModal)
{
    <div
        style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000;">
        <div
            style="background: white; border-radius: 16px; padding: 32px; max-width: 600px; width: 90%; max-height: 90vh; overflow-y: auto; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
            <h2
                style="font-size: 20px; font-weight: 700; margin: 0 0 24px 0; display: flex; align-items: center; gap: 10px;">
                <span style="font-size: 24px;">@(isEditing ? "✏️" : "➕")</span>
                @(isEditing ? "Edit Account" : "Add New Account")
            </h2>

            @if (!string.IsNullOrEmpty(formErrorMessage))
            {
                <div
                    style="background: #fee2e2; border: 1px solid #fecaca; color: #991b1b; padding: 12px 16px; border-radius: 8px; margin-bottom: 16px; font-size: 13px;">
                    ⚠️ @formErrorMessage
                </div>
            }

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <div>
                    <label style="display: block; font-weight: 600; color: #374151; margin-bottom: 8px;">Account Code <span
                            style="color: #ef4444;">*</span></label>
                    <input type="text" @bind="editAccount.AccountCode"
                        style="width: 100%; padding: 12px; border: 2px solid @(string.IsNullOrEmpty(editAccount.AccountCode) && !string.IsNullOrEmpty(formErrorMessage) ? "#fecaca" : "#e5e7eb"); border-radius: 8px; font-size: 14px;"
                        placeholder="e.g., 1000, 1010, 2000" />
                </div>
                <div>
                    <label style="display: block; font-weight: 600; color: #374151; margin-bottom: 8px;">Account Name
                        *</label>
                    <input type="text" @bind="editAccount.AccountName"
                        style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;"
                        placeholder="e.g., Cash" />
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px;">
                <div>
                    <label style="display: block; font-weight: 600; color: #374151; margin-bottom: 8px;">Account Type
                        *</label>
                    <select @bind="editAccount.AccountType"
                        style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px; background: white;">
                        <option value="">Select Type</option>
                        <option value="Asset">Asset</option>
                        <option value="Liability">Liability</option>
                        <option value="Equity">Equity</option>
                        <option value="Revenue">Revenue</option>
                        <option value="Expense">Expense</option>
                    </select>
                </div>
                <div>
                    <label style="display: block; font-weight: 600; color: #374151; margin-bottom: 8px;">Parent Account
                        Code</label>
                    <input type="text" @bind="editAccount.ParentAccountCode"
                        style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;"
                        placeholder="e.g., 1000 (optional)" />
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px;">
                <div>
                    <label style="display: block; font-weight: 600; color: #374151; margin-bottom: 8px;">Level</label>
                    <input type="number" @bind="editAccount.Level" min="1" max="5"
                        style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;" />
                </div>
                <div style="display: flex; align-items: flex-end; padding-bottom: 8px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <input type="checkbox" @bind="editAccount.IsActive" id="isActive" />
                        <label for="isActive" style="font-weight: 500; color: #374151;">Account is Active</label>
                    </div>
                </div>
            </div>

            <div style="display: flex; gap: 12px; justify-content: flex-end; margin-top: 24px;">
                <button
                    style="background: #e5e7eb; color: #374151; padding: 12px 24px; border: none; border-radius: 10px; font-weight: 600; cursor: pointer;"
                    @onclick="CloseModal">Cancel</button>
                <button
                    style="background: linear-gradient(135deg, #059669, #10b981); color: white; padding: 12px 24px; border: none; border-radius: 10px; font-weight: 600; cursor: pointer;"
                    @onclick="SaveAccount">
                    @(isEditing ? "Update Account" : "Add Account")
                </button>
            </div>
        </div>
    </div>
}

<style>
    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

@code {
    private List<FinanceBank.Models.ChartOfAccounts> accounts = new();
    private FinanceBank.Models.ChartOfAccounts editAccount = new();
    private bool showModal = false;
    private bool isEditing = false;
    private bool isLoading = true;
    private string successMessage = "";
    private string errorMessage = "";
    private string formErrorMessage = "";
    private string searchQuery = "";
    private string filterType = "";

    private IEnumerable<FinanceBank.Models.ChartOfAccounts> FilteredAccounts => accounts
    .Where(a => string.IsNullOrEmpty(searchQuery) ||
    a.AccountName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
    a.AccountCode.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
    .Where(a => string.IsNullOrEmpty(filterType) || a.AccountType == filterType)
    .OrderBy(a => a.AccountCode);

    protected override async Task OnInitializedAsync()
    {
        await LoadAccounts();
    }

    private async Task LoadAccounts()
    {
        isLoading = true;
        try
        {
            accounts = await AccountingService.GetAllChartOfAccountsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading accounts: {ex.Message}");
            accounts = new List<FinanceBank.Models.ChartOfAccounts>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowAddModal()
    {
        editAccount = new FinanceBank.Models.ChartOfAccounts
        {
            IsActive = true,
            Level = 1,
            CreatedBy = "Accountant"
        };
        isEditing = false;
        formErrorMessage = "";
        showModal = true;
    }

    private void EditAccount(FinanceBank.Models.ChartOfAccounts account)
    {
        editAccount = new FinanceBank.Models.ChartOfAccounts
        {
            AccountId = account.AccountId,
            AccountCode = account.AccountCode,
            AccountName = account.AccountName,
            AccountType = account.AccountType,
            ParentAccountCode = account.ParentAccountCode,
            Level = account.Level,
            IsActive = account.IsActive,
            CreatedBy = account.CreatedBy,
            CreatedAt = account.CreatedAt
        };
        isEditing = true;
        formErrorMessage = "";
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        editAccount = new FinanceBank.Models.ChartOfAccounts();
        formErrorMessage = "";
    }

    private async Task SaveAccount()
    {
        formErrorMessage = "";

        // Validation
        if (string.IsNullOrWhiteSpace(editAccount.AccountCode))
        {
            formErrorMessage = "Account Code is required. Please enter a unique account code.";
            NotificationService.ShowError("Validation Error", "Account Code is required. Please enter a unique account code.");
            return;
        }

        if (string.IsNullOrWhiteSpace(editAccount.AccountName))
        {
            formErrorMessage = "Account Name is required. Please enter a descriptive name.";
            NotificationService.ShowError("Validation Error", "Account Name is required. Please enter a descriptive name.");
            return;
        }

        if (string.IsNullOrWhiteSpace(editAccount.AccountType))
        {
            formErrorMessage = "Account Type is required. Please select Asset, Liability, Equity, Revenue, or Expense.";
            NotificationService.ShowError("Validation Error", "Account Type is required. Please select a type.");
            return;
        }

        // Check for duplicate account code when creating
        if (!isEditing && accounts.Any(a => a.AccountCode.Equals(editAccount.AccountCode, StringComparison.OrdinalIgnoreCase)))
        {
            formErrorMessage = $"Account Code '{editAccount.AccountCode}' already exists. Please use a unique code.";
            NotificationService.ShowError("Duplicate Account", $"Account Code '{editAccount.AccountCode}' already exists.");
            return;
        }

        try
        {
            var currentUser = AuthService.CurrentUser ?? "Accountant";
            var reason = isEditing ? $"Updated by {currentUser} at {DateTime.Now:g}" : $"Created by {currentUser} at {DateTime.Now:g}";

            if (isEditing)
            {
                // Note: CreatedBy/CreatedAt remain from original creation
                await AccountingService.UpdateChartOfAccountsAsync(editAccount);
                successMessage = $"✓ Account '{editAccount.AccountName}' ({editAccount.AccountCode}) updated successfully!";
                NotificationService.ShowSuccess("Account Updated", $"Account '{editAccount.AccountName}' has been updated successfully. Reason: {reason}");
            }
            else
            {
                editAccount.CreatedAt = DateTime.Now;
                editAccount.CreatedBy = currentUser;
                await AccountingService.CreateChartOfAccountsAsync(editAccount);
                successMessage = $"✓ Account '{editAccount.AccountName}' ({editAccount.AccountCode}) created successfully!";
                NotificationService.ShowSuccess("Account Created", $"Account '{editAccount.AccountName}' has been created successfully. Reason: {reason}");
            }

            await LoadAccounts();
            CloseModal();
        }
        catch (Exception ex)
        {
            formErrorMessage = $"Failed to save account: {ex.Message}";
            NotificationService.ShowError("Save Failed", $"Failed to save account: {ex.Message}");
            Console.WriteLine($"Error saving account: {ex.Message}");
        }
    }

    private (string color, string bg) GetAccountTypeStyle(string type) => type switch
    {
        "Asset" => ("#1e40af", "#dbeafe"),
        "Liability" => ("#9d174d", "#fce7f3"),
        "Equity" => ("#5b21b6", "#ede9fe"),
        "Revenue" => ("#065f46", "#d1fae5"),
        "Expense" => ("#991b1b", "#fee2e2"),
        _ => ("#374151", "#f3f4f6")
    };
}