    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    private void ViewDocument(LoanDocument doc)
    {
        currentViewingDocument = doc;
        
        // Create data URL for viewing
        var mimeType = doc.ContentType ?? "application/octet-stream";
        var base64 = Convert.ToBase64String(doc.FileData);
        documentViewerDataUrl = $"data:{mimeType};base64,{base64}";
        
        showDocumentViewer = true;
        StateHasChanged();
    }

    private void CloseDocumentViewer()
    {
        showDocumentViewer = false;
        currentViewingDocument = null;
        documentViewerDataUrl = "";
    }

    private async Task VerifyDocument(int documentId, bool isVerified)
    {
        try
        {
            var doc = await DbContext.LoanDocuments.FindAsync(documentId);
            if (doc != null)
            {
                doc.VerificationStatus = isVerified ? "VERIFIED" : "REJECTED";
                doc.VerifiedBy = AuthService.CurrentUser ?? "accountant";
                doc.VerifiedAt = DateTime.Now;
                
                await DbContext.SaveChangesAsync();
                
                // Update local list
                var localDoc = uploadedDocuments.FirstOrDefault(d => d.DocumentId == documentId);
                if (localDoc != null)
                {
                    localDoc.VerificationStatus = doc.VerificationStatus;
                    localDoc.VerifiedBy = doc.VerifiedBy;
                    localDoc.VerifiedAt = doc.VerifiedAt;
                }
                
                ShowToast($"Document {(isVerified ? "verified" : "rejected")} successfully!", "success");
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Error verifying document: {ex.Message}", "error");
        }
    }
