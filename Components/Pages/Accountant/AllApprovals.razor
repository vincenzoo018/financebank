@code {
    private bool isLoading = true;
    private bool isProcessing = false;
    private string activeTab = "pending";
    private string filterType = "";

    // Toast
    private bool showToast = false;
    private string toastMessage = "";
    private string toastType = "success";

    // Stats
    private int pendingCount = 0;
    private int approvedCount = 0;
    private int declinedCount = 0;
    private int totalCount = 0;

    // Data
    private List<ApprovalItem> pendingItems = new();
    private List<ApprovalItem> historyItems = new();
    private List<ApprovalItem> filteredPendingItems => string.IsNullOrEmpty(filterType)
    ? pendingItems
    : pendingItems.Where(x => x.Type == filterType).ToList();
    private List<ApprovalItem> filteredHistoryItems => string.IsNullOrEmpty(filterType)
    ? historyItems
    : historyItems.Where(x => x.Type == filterType).ToList();

    // Modal
    private bool showReviewModal = false;
    private ApprovalItem? selectedItem;
    private int currentStep = 1;
    private string? approvalDecision;
    private string approvalNotes = "";

    // =====================================================================
    // LOAN ASSESSMENT FIELDS (For Credit Analysis)
    // =====================================================================
    private LoanApplicationDetails? loanDetails;
    private bool isLoadingLoanDetails = false;

    // Credit Score Simulation
    private int simulatedCreditScore = 650;
    private string creditScoreSource = "INTERNAL";
    private string creditScoreCategory => simulatedCreditScore switch
    {
        >= 750 => "Excellent",
        >= 700 => "Good",
        >= 650 => "Fair",
        >= 600 => "Poor",
        _ => "Very Poor"
    };

    // DTI Calculation
    private decimal monthlyIncome = 0;
    private decimal existingMonthlyDebts = 0;
    private decimal proposedMonthlyPayment = 0;
    private decimal dtiRatio => monthlyIncome > 0 
        ? Math.Round(((existingMonthlyDebts + proposedMonthlyPayment) / monthlyIncome) * 100, 2) 
        : 0;
    private string dtiCategory => dtiRatio switch
    {
        <= 20 => "Excellent",
        <= 35 => "Good",
        <= 43 => "Acceptable",
        <= 50 => "High",
        _ => "Very High"
    };

    // Risk Assessment
    private string riskCategory = "MEDIUM";
    private int riskScore = 50;
    private string riskAssessmentNotes = "";

    // Accountant Recommendation
    private string accountantRecommendation = "";
    private string recommendationReason = "";
    private decimal? suggestedAmount;
    private int? suggestedTerm;
    private decimal? suggestedRate;

    // Verification Checks
    private bool verifyIdentity = false;
    private bool verifyIncome = false;
    private bool verifyEmployment = false;
    private bool verifyBankStatements = false;
    private bool verifyCollateral = false;
    private bool verifyCoBorrower = false;
    private decimal? averageMonthlyBalance;

    // Document viewing and verification
    private List<LoanDocument> uploadedDocuments = new();
    private bool showDocumentViewer = false;
    private LoanDocument? currentViewingDocument;
    private string documentViewerDataUrl = "";

    // Loan-specific data class
    private class LoanApplicationDetails
    {
        public LoanApplication? Application { get; set; }
        public LoanCollateral? Collateral { get; set; }
        public LoanCoBorrower? CoBorrower { get; set; }
        public CustomerAccount? Account { get; set; }
        public AuthUser? Customer { get; set; }
        public int TransactionCount { get; set; }
        public decimal AverageBalance { get; set; }
        public int AccountAgeMonths { get; set; }
        public bool HasPreviousLoans { get; set; }
        public int PreviousLoansCount { get; set; }
        public bool HasOverdueHistory { get; set; }
    }

    private class ApprovalItem
    {
        public int Id { get; set; }
        public string Type { get; set; } = "";
        public string Reference { get; set; } = "";
        public string CustomerName { get; set; } = "";
        public decimal Amount { get; set; }
        public string SubmittedBy { get; set; } = "";
        public DateTime SubmittedAt { get; set; }
        public string Status { get; set; } = "Pending";
        public string? ProcessedBy { get; set; }
        public DateTime? ProcessedAt { get; set; }
        public string? Description { get; set; }
        public string? Notes { get; set; }
        // For tracking source
        public string SourceType { get; set; } = ""; // LoanApplication, LoanAssessment, Transaction, etc.
        public int SourceId { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            pendingItems.Clear();
            historyItems.Clear();

            // Load Loan Applications pending for Accountant review
            var loanApps = await DbContext.LoanApplications
            .Include(a => a.Account)
            .ThenInclude(a => a!.Customer)
            .Where(a => a.Status == "PENDING_ACCOUNTANT_REVIEW" || a.Status == "ENCODED" || a.Status == "VERIFIED")
            .OrderByDescending(a => a.ApplicationDate)
            .ToListAsync();

            foreach (var app in loanApps)
            {
                pendingItems.Add(new ApprovalItem
                {
                    Id = app.ApplicationId,
                    Type = "LoanApplication",
                    Reference = app.ApplicationNumber,
                    CustomerName = app.Account?.Customer?.FullName ?? "Unknown",
                    Amount = app.RequestedAmount,
                    SubmittedBy = app.SubmittedBy,
                    SubmittedAt = app.ApplicationDate,
                    Status = "Pending",
                    Description = $"{app.LoanType} - {app.Purpose}",
                    SourceType = "LoanApplication",
                    SourceId = app.ApplicationId
                });
            }

            // Load Loan Assessments pending approval
            var assessments = await DbContext.LoanAssessments
            .Include(a => a.Application)
            .ThenInclude(app => app!.Account)
            .ThenInclude(acc => acc!.Customer)
            .Where(a => a.AssessmentStatus == "ASSESSED" || a.AssessmentStatus == "FORWARDED")
            .OrderByDescending(a => a.AssessmentDate)
            .ToListAsync();

            foreach (var assessment in assessments)
            {
                pendingItems.Add(new ApprovalItem
                {
                    Id = assessment.AssessmentId,
                    Type = "LoanAssessment",
                    Reference = assessment.Application?.ApplicationNumber ?? $"ASS-{assessment.AssessmentId}",
                    CustomerName = assessment.Application?.Account?.Customer?.FullName ?? "Unknown",
                    Amount = assessment.LoanAmount,
                    SubmittedBy = assessment.AssessedBy,
                    SubmittedAt = assessment.AssessmentDate,
                    Status = "Pending",
                    Description = $"Term: {assessment.TermMonths} months @ {assessment.InterestRate}% - Monthly: ₱{assessment.ComputedMonthlyPayment:N2}",
                    SourceType = "LoanAssessment",
                    SourceId = assessment.AssessmentId
                });
            }

            // Load Transactions pending approval
            var transactions = await DbContext.CustomerTransactions
            .Include(t => t.Account)
            .ThenInclude(a => a!.Customer)
            .Include(t => t.ProcessedByEmployee)
            .Where(t => t.Status == "Pending" || t.Status == "PendingApproval")
            .OrderByDescending(t => t.CreatedAt)
            .ToListAsync();

            foreach (var trans in transactions)
            {
                var processedByName = trans.ProcessedByEmployee != null
                                    ? $"{trans.ProcessedByEmployee.FirstName} {trans.ProcessedByEmployee.LastName}"
                : "System";
                pendingItems.Add(new ApprovalItem
                {
                    Id = trans.TransactionId,
                    Type = "Transaction",
                    Reference = trans.TransactionNumber,
                    CustomerName = trans.Account?.Customer?.FullName ?? "Unknown",
                    Amount = trans.Amount,
                    SubmittedBy = processedByName,
                    SubmittedAt = trans.CreatedAt,
                    Status = "Pending",
                    Description = $"{trans.TransactionType} - {trans.Description}",
                    SourceType = "Transaction",
                    SourceId = trans.TransactionId
                });
            }

            // Load Fund Transfers pending approval
            var transfers = await DbContext.FundTransfers
            .Include(t => t.FromAccount)
            .Where(t => t.Status == "Pending" || t.Status == "PendingApproval")
            .OrderByDescending(t => t.CreatedAt)
            .ToListAsync();

            foreach (var trans in transfers)
            {
                pendingItems.Add(new ApprovalItem
                {
                    Id = trans.TransferId,
                    Type = "Transfer",
                    Reference = trans.TransferNumber,
                    CustomerName = trans.FromAccount?.AccountName ?? "Unknown",
                    Amount = trans.Amount,
                    SubmittedBy = trans.ProcessedBy ?? "System",
                    SubmittedAt = trans.CreatedAt,
                    Status = "Pending",
                    Description = trans.Description,
                    SourceType = "Transfer",
                    SourceId = trans.TransferId
                });
            }

            // Load History - Approved/Declined Loan Approvals
            var loanApprovals = await DbContext.LoanApprovals
            .Include(a => a.Application)
            .ThenInclude(app => app!.Account)
            .ThenInclude(acc => acc!.Customer)
            .OrderByDescending(a => a.ApprovalDate)
            .Take(50)
            .ToListAsync();

            foreach (var approval in loanApprovals)
            {
                historyItems.Add(new ApprovalItem
                {
                    Id = approval.ApprovalId,
                    Type = "LoanApproval",
                    Reference = approval.Application?.ApplicationNumber ?? $"APR-{approval.ApprovalId}",
                    CustomerName = approval.Application?.Account?.Customer?.FullName ?? "Unknown",
                    Amount = approval.ApprovedAmount ?? approval.Application?.RequestedAmount ?? 0,
                    SubmittedBy = approval.ApprovedBy,
                    SubmittedAt = approval.ApprovalDate,
                    Status = approval.ApprovalStatus == "APPROVED" ? "Approved" : "Declined",
                    ProcessedBy = approval.ApprovedBy,
                    ProcessedAt = approval.ApprovalDate,
                    Notes = approval.DeclinationReason ?? approval.SpecialConditions,
                    SourceType = "LoanApproval",
                    SourceId = approval.ApprovalId
                });
            }

            // Load History - Completed Transactions
            var completedTrans = await DbContext.CustomerTransactions
            .Include(t => t.Account)
            .ThenInclude(a => a!.Customer)
            .Include(t => t.ProcessedByEmployee)
            .Where(t => t.Status == "Completed" || t.Status == "Approved" || t.Status == "Rejected")
            .OrderByDescending(t => t.CreatedAt)
            .Take(50)
            .ToListAsync();

            foreach (var trans in completedTrans)
            {
                var processedByName = trans.ProcessedByEmployee != null
                                    ? $"{trans.ProcessedByEmployee.FirstName} {trans.ProcessedByEmployee.LastName}"
                : "System";
                historyItems.Add(new ApprovalItem
                {
                    Id = trans.TransactionId,
                    Type = "Transaction",
                    Reference = trans.TransactionNumber,
                    CustomerName = trans.Account?.Customer?.FullName ?? "Unknown",
                    Amount = trans.Amount,
                    SubmittedBy = processedByName,
                    SubmittedAt = trans.CreatedAt,
                    Status = trans.Status == "Rejected" ? "Declined" : "Approved",
                    ProcessedBy = processedByName,
                    ProcessedAt = trans.ProcessedAt ?? trans.CreatedAt,
                    Description = trans.Description,
                    SourceType = "Transaction",
                    SourceId = trans.TransactionId
                });
            }

            // Calculate statistics
            pendingCount = pendingItems.Count;
            approvedCount = historyItems.Count(x => x.Status == "Approved");
            declinedCount = historyItems.Count(x => x.Status == "Declined");
            totalCount = pendingCount + approvedCount + declinedCount;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
            ShowToast($"Error loading data: {ex.Message}", "error");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
    }

    private async Task OpenReviewModal(ApprovalItem item)
    {
        selectedItem = item;
        currentStep = 1;
        approvalDecision = null;
        approvalNotes = "";
        showReviewModal = true;

        // Reset loan assessment fields
        ResetLoanAssessmentFields();

        // Load loan-specific data if applicable
        if (item.SourceType == "LoanApplication" || item.SourceType == "LoanAssessment")
        {
            await LoadLoanDetails(item);
        }
    }

    private void ResetLoanAssessmentFields()
    {
        loanDetails = null;
        simulatedCreditScore = 650;
        creditScoreSource = "INTERNAL";
        monthlyIncome = 0;
        existingMonthlyDebts = 0;
        proposedMonthlyPayment = 0;
        riskCategory = "MEDIUM";
        riskScore = 50;
        riskAssessmentNotes = "";
        accountantRecommendation = "";
        recommendationReason = "";
        suggestedAmount = null;
        suggestedTerm = null;
        suggestedRate = null;
        verifyIdentity = false;
        verifyIncome = false;
        verifyEmployment = false;
        verifyBankStatements = false;
        verifyCollateral = false;
        verifyCoBorrower = false;
        averageMonthlyBalance = null;
    }

    private async Task LoadLoanDetails(ApprovalItem item)
    {
        isLoadingLoanDetails = true;
        StateHasChanged();

        try
        {
            int applicationId = item.SourceId;
            
            // If it's an assessment, get the application ID from the assessment
            if (item.SourceType == "LoanAssessment")
            {
                var assessment = await DbContext.LoanAssessments
                    .FirstOrDefaultAsync(a => a.AssessmentId == item.SourceId);
                if (assessment != null)
                    applicationId = assessment.ApplicationId;
            }

            // Load the loan application with all related data
            var application = await DbContext.LoanApplications
                .Include(a => a.Account)
                .ThenInclude(acc => acc!.Customer)
                .FirstOrDefaultAsync(a => a.ApplicationId == applicationId);

            if (application == null)
            {
                isLoadingLoanDetails = false;
                return;
            }

            // Load collateral (table may not exist yet)
            LoanCollateral? collateral = null;
            try
            {
                collateral = await DbContext.Set<LoanCollateral>()
                    .FirstOrDefaultAsync(c => c.ApplicationId == applicationId);
            }
            catch { /* LoanCollaterals table doesn't exist yet */ }

            // Load co-borrower (table may not exist yet)
            LoanCoBorrower? coBorrower = null;
            try
            {
                coBorrower = await DbContext.Set<LoanCoBorrower>()
                    .FirstOrDefaultAsync(c => c.ApplicationId == applicationId);
            }
            catch { /* LoanCoBorrowers table doesn't exist yet */ }

            // Load uploaded documents
            try
            {
                uploadedDocuments = await DbContext.LoanDocuments
                    .Where(d => d.ApplicationId == applicationId)
                    .ToListAsync();
            }
            catch 
            { 
                uploadedDocuments = new List<LoanDocument>();
            }

            // Calculate account statistics
            var account = application.Account;
            var transactionCount = 0;
            decimal averageBalance = 0;
            int accountAgeMonths = 0;
            bool hasOverdueHistory = false;
            int previousLoansCount = 0;

            if (account != null)
            {
                transactionCount = await DbContext.CustomerTransactions
                    .CountAsync(t => t.AccountId == account.AccountId);
                
                averageBalance = account.Balance;
                accountAgeMonths = (int)((DateTime.Now - account.CreatedAt).TotalDays / 30);
                
                // Check for previous loans
                previousLoansCount = await DbContext.LoanApplications
                    .CountAsync(l => l.AccountId == account.AccountId && l.Status == "COMPLETED");
                
                // Check for overdue history (simplified)
                hasOverdueHistory = await DbContext.LoanApplications
                    .AnyAsync(l => l.AccountId == account.AccountId && 
                        (l.Status == "DELINQUENT" || l.Status == "DEFAULTED"));
            }

            loanDetails = new LoanApplicationDetails
            {
                Application = application,
                Collateral = collateral,
                CoBorrower = coBorrower,
                Account = account,
                Customer = account?.Customer,
                TransactionCount = transactionCount,
                AverageBalance = averageBalance,
                AccountAgeMonths = accountAgeMonths,
                HasPreviousLoans = previousLoansCount > 0,
                PreviousLoansCount = previousLoansCount,
                HasOverdueHistory = hasOverdueHistory
            };

            // Pre-populate assessment fields with application data
            monthlyIncome = application.MonthlyIncome ?? 0;
            existingMonthlyDebts = application.ExistingMonthlyPayments;
            
            // Calculate proposed monthly payment
            var rate = 10.0m / 100 / 12; // 10% annual
            var term = application.RequestedTermMonths > 0 ? application.RequestedTermMonths : 12;
            proposedMonthlyPayment = application.RequestedAmount * (rate * (decimal)Math.Pow(1 + (double)rate, term))
                / ((decimal)Math.Pow(1 + (double)rate, term) - 1);
            proposedMonthlyPayment = Math.Round(proposedMonthlyPayment, 2);

            // Simulate credit score based on account history
            simulatedCreditScore = CalculateInternalCreditScore(loanDetails);
            
            // Auto-assess risk based on DTI and credit score
            AutoAssessRisk();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading loan details: {ex.Message}");
        }
        finally
        {
            isLoadingLoanDetails = false;
            StateHasChanged();
        }
    }

    private int CalculateInternalCreditScore(LoanApplicationDetails details)
    {
        // Internal credit score simulation based on banking relationship
        int score = 550; // Base score

        // Account age factor (+5 per month, max +100)
        score += Math.Min(details.AccountAgeMonths * 5, 100);

        // Transaction activity (+1 per transaction, max +50)
        score += Math.Min(details.TransactionCount, 50);

        // Average balance factor (based on loan amount ratio)
        if (selectedItem != null && selectedItem.Amount > 0)
        {
            var balanceRatio = details.AverageBalance / selectedItem.Amount;
            if (balanceRatio >= 0.5m) score += 50;
            else if (balanceRatio >= 0.25m) score += 25;
            else if (balanceRatio >= 0.1m) score += 10;
        }

        // Previous loans in good standing
        if (details.HasPreviousLoans && !details.HasOverdueHistory)
            score += 75;

        // Penalty for overdue history
        if (details.HasOverdueHistory)
            score -= 100;

        // Cap between 300 and 850
        return Math.Max(300, Math.Min(850, score));
    }

    private void AutoAssessRisk()
    {
        // Auto-assess risk based on DTI and credit score
        if (dtiRatio > 50 || simulatedCreditScore < 550)
        {
            riskCategory = "VERY_HIGH";
            riskScore = 85;
        }
        else if (dtiRatio > 43 || simulatedCreditScore < 650)
        {
            riskCategory = "HIGH";
            riskScore = 70;
        }
        else if (dtiRatio > 35 || simulatedCreditScore < 700)
        {
            riskCategory = "MEDIUM";
            riskScore = 45;
        }
        else
        {
            riskCategory = "LOW";
            riskScore = 20;
        }
    }

    private decimal CalculateLTV(decimal loanAmount, decimal collateralValue)
    {
        if (collateralValue <= 0) return 0;
        return (loanAmount / collateralValue) * 100;
    }

    private void CloseReviewModal()
    {
        showReviewModal = false;
        selectedItem = null;
        currentStep = 1;
        approvalDecision = null;
        approvalNotes = "";
        ResetLoanAssessmentFields();
    }

    private void NextStep()
    {
        if (currentStep < 3 && CanProceedToNextStep())
            currentStep++;
    }

    private void PreviousStep()
    {
        if (currentStep > 1)
            currentStep--;
    }

    private bool CanProceedToNextStep()
    {
        return currentStep switch
        {
            1 => true, // Can always proceed from review
            2 => !string.IsNullOrEmpty(approvalDecision), // Must select decision
            _ => true
        };
    }

    private string GetStepTitle(int step) => step switch
    {
        1 => "Review",
        2 => "Decision",
        3 => "Confirm",
        _ => ""
    };

    private async Task SubmitDecision()
    {
        if (selectedItem == null || string.IsNullOrEmpty(approvalDecision))
            return;

        isProcessing = true;
        try
        {
            var currentUser = AuthService.CurrentUser ?? "Accountant";
            var isApproved = approvalDecision == "Approved";

            // Process based on source type
            switch (selectedItem.SourceType)
            {
                case "LoanApplication":
                    var loanApp = await DbContext.LoanApplications.FindAsync(selectedItem.SourceId);
                    if (loanApp != null)
                    {
                        if (isApproved)
                        {
                            // Create comprehensive assessment record with credit score, DTI, and risk data
                            var termMonths = suggestedTerm ?? loanApp.RequestedTermMonths;
                            if (termMonths <= 0) termMonths = 12;
                            
                            var interestRate = suggestedRate ?? 10.0m;
                            var loanAmount = suggestedAmount ?? selectedItem.Amount;
                            
                            var monthlyRate = interestRate / 100 / 12;
                            var monthlyPayment = loanAmount * (monthlyRate * (decimal)Math.Pow(1 + (double)monthlyRate, termMonths))
                                / ((decimal)Math.Pow(1 + (double)monthlyRate, termMonths) - 1);
                            var totalPayable = monthlyPayment * termMonths;

                            // Build comprehensive remarks with assessment details
                            var assessmentRemarks = $"ACCOUNTANT ASSESSMENT SUMMARY\n" +
                                $"═══════════════════════════════════════\n" +
                                $"Credit Score: {simulatedCreditScore} ({creditScoreCategory}) - Source: {creditScoreSource}\n" +
                                $"DTI Ratio: {dtiRatio}% ({dtiCategory})\n" +
                                $"Risk Category: {riskCategory} (Score: {riskScore}/100)\n" +
                                $"Recommendation: {accountantRecommendation}\n" +
                                $"───────────────────────────────────────\n" +
                                $"Reason: {recommendationReason}\n" +
                                $"Risk Notes: {riskAssessmentNotes}\n" +
                                $"Additional Notes: {approvalNotes}";

                            var newAssessment = new LoanAssessment
                            {
                                ApplicationId = loanApp.ApplicationId,
                                AccountId = loanApp.AccountId,
                                LoanAmount = loanAmount,
                                InterestRate = interestRate,
                                TermMonths = termMonths,
                                ComputedMonthlyPayment = Math.Round(monthlyPayment, 2),
                                TotalPayable = Math.Round(totalPayable, 2),
                                AssessmentStatus = "ASSESSED",
                                AssessedBy = currentUser,
                                Remarks = assessmentRemarks,
                                AssessmentDate = DateTime.Now,
                                // Credit and Risk Assessment Fields
                                CreditScore = simulatedCreditScore,
                                CreditScoreSource = creditScoreSource,
                                DebtToIncomeRatio = dtiRatio,
                                RiskScore = riskScore,
                                RiskCategory = riskCategory,
                                RiskAssessmentDetails = riskAssessmentNotes,
                                // Verification Results
                                IdentityVerified = verifyIdentity,
                                IncomeVerified = verifyIncome,
                                EmploymentVerified = verifyEmployment,
                                BankStatementsReviewed = verifyBankStatements,
                                CollateralVerified = verifyCollateral,
                                CoBorrowerVerified = verifyCoBorrower,
                                AverageMonthlyBalance = averageMonthlyBalance,
                                // Accountant Recommendation
                                AccountantRecommendation = accountantRecommendation,
                                RecommendationReason = recommendationReason,
                                SuggestedAmount = suggestedAmount,
                                SuggestedTerm = suggestedTerm,
                                SuggestedRate = suggestedRate
                            };
                            DbContext.LoanAssessments.Add(newAssessment);
                            
                            // Update application status to pending Finance Manager approval
                            loanApp.Status = "PENDING_FINANCEMANAGER_APPROVAL";
                        }
                        else
                        {
                            // Rejection with detailed reason
                            var rejectionRemarks = $"ACCOUNTANT REJECTION\n" +
                                $"═══════════════════════════════════════\n" +
                                $"Credit Score: {simulatedCreditScore} ({creditScoreCategory})\n" +
                                $"DTI Ratio: {dtiRatio}% ({dtiCategory})\n" +
                                $"Risk Category: {riskCategory}\n" +
                                $"───────────────────────────────────────\n" +
                                $"Reason: {recommendationReason}\n" +
                                $"Notes: {approvalNotes}";
                                
                            loanApp.Status = "REJECTED_ACCOUNTANT";
                            loanApp.RejectionReason = rejectionRemarks;
                            loanApp.RejectedAt = DateTime.Now;
                            loanApp.RejectedBy = currentUser;
                        }
                        await DbContext.SaveChangesAsync();
                    }
                    break;

                case "LoanAssessment":
                    var existingAssessment = await DbContext.LoanAssessments
                        .Include(a => a.Application)
                        .FirstOrDefaultAsync(a => a.AssessmentId == selectedItem.SourceId);
                    if (existingAssessment != null)
                    {
                        if (isApproved)
                        {
                            // Update assessment with accountant's analysis
                            existingAssessment.CreditScore = simulatedCreditScore;
                            existingAssessment.CreditScoreSource = creditScoreSource;
                            existingAssessment.DebtToIncomeRatio = dtiRatio;
                            existingAssessment.RiskScore = riskScore;
                            existingAssessment.RiskCategory = riskCategory;
                            existingAssessment.RiskAssessmentDetails = riskAssessmentNotes;
                            existingAssessment.IdentityVerified = verifyIdentity;
                            existingAssessment.IncomeVerified = verifyIncome;
                            existingAssessment.EmploymentVerified = verifyEmployment;
                            existingAssessment.BankStatementsReviewed = verifyBankStatements;
                            existingAssessment.CollateralVerified = verifyCollateral;
                            existingAssessment.CoBorrowerVerified = verifyCoBorrower;
                            existingAssessment.AverageMonthlyBalance = averageMonthlyBalance;
                            existingAssessment.AccountantRecommendation = accountantRecommendation;
                            existingAssessment.RecommendationReason = recommendationReason;
                            existingAssessment.SuggestedAmount = suggestedAmount;
                            existingAssessment.SuggestedTerm = suggestedTerm;
                            existingAssessment.SuggestedRate = suggestedRate;
                            existingAssessment.Remarks = $"{existingAssessment.Remarks}\n\nACCOUNTANT UPDATE:\n{approvalNotes}";
                            
                            existingAssessment.AssessmentStatus = "ASSESSED";
                            
                            if (existingAssessment.Application != null)
                            {
                                existingAssessment.Application.Status = "PENDING_FINANCEMANAGER_APPROVAL";
                            }
                        }
                        else
                        {
                            existingAssessment.AssessmentStatus = "DECLINED";
                            existingAssessment.AccountantRecommendation = "NOT_RECOMMEND";
                            existingAssessment.RecommendationReason = recommendationReason;
                            
                            if (existingAssessment.Application != null)
                            {
                                existingAssessment.Application.Status = "REJECTED_ACCOUNTANT";
                                existingAssessment.Application.RejectionReason = $"Credit Score: {simulatedCreditScore}, DTI: {dtiRatio}%, Risk: {riskCategory}. Reason: {recommendationReason}. {approvalNotes}";
                                existingAssessment.Application.RejectedAt = DateTime.Now;
                                existingAssessment.Application.RejectedBy = currentUser;
                            }
                        }
                        await DbContext.SaveChangesAsync();
                    }
                    break;

                case "Transaction":
                    var trans = await DbContext.CustomerTransactions.FindAsync(selectedItem.SourceId);
                    if (trans != null)
                    {
                        trans.Status = isApproved ? "Completed" : "Rejected";
                        trans.ProcessedAt = DateTime.Now;
                        await DbContext.SaveChangesAsync();
                    }
                    break;

                case "Transfer":
                    var transfer = await DbContext.FundTransfers.FindAsync(selectedItem.SourceId);
                    if (transfer != null)
                    {
                        transfer.Status = isApproved ? "Completed" : "Rejected";
                        transfer.ProcessedAt = DateTime.Now;
                        await DbContext.SaveChangesAsync();
                    }
                    break;
            }

            CloseReviewModal();
            var action = isApproved ? "forwarded to Finance Manager" : "declined";
            ShowToast($"Loan application {action} successfully!", "success");
            NotificationService.ShowSuccess("Decision Processed", $"Application has been {action}. Processed by {currentUser}");
            await LoadData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error processing decision: {ex.Message}");
            ShowToast($"Error: {ex.Message}", "error");
            NotificationService.ShowError("Processing Failed", $"Failed to process decision: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void ShowToast(string message, string type)
    {
        toastMessage = message;
        toastType = type;
        showToast = true;
        _ = HideToastAfterDelay();
    }

    private async Task HideToastAfterDelay()
    {
        await Task.Delay(4000);
        showToast = false;
        StateHasChanged();
    }

