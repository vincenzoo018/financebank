@page "/accountant/loan-recording"
@using Microsoft.AspNetCore.Authorization
@using FinanceBank.Services
@using FinanceBank.Models
@layout AccountantLayout
@inject LoanProcessService LoanProcessService
@inject LoanPaymentService LoanPaymentService
@inject NavigationManager Navigation
@inject Microsoft.EntityFrameworkCore.DbContext DbContext
@attribute [Authorize(Roles = "Accountant")]

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
                <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
            </div>
            <div>
                <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Loan Recording & Completion</h1>
                <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Track and manage all loan records</p>
            </div>
        </div>
        <div style="display: flex; gap: 12px;">
            <div style="background: rgba(255,255,255,0.2); padding: 12px 20px; border-radius: 10px; text-align: center;">
                <div style="font-size: 12px; color: rgba(255,255,255,0.8); margin-bottom: 4px;">ACTIVE LOANS</div>
                <div style="font-size: 24px; font-weight: 700; color: white;">@(activeLoans?.Count ?? 0)</div>
            </div>
            <div style="background: rgba(255,255,255,0.2); padding: 12px 20px; border-radius: 10px; text-align: center;">
                <div style="font-size: 12px; color: rgba(255,255,255,0.8); margin-bottom: 4px;">COMPLETED</div>
                <div style="font-size: 24px; font-weight: 700; color: white;">@(completedLoans?.Count ?? 0)</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow" style="border-radius: 16px; border: 1px solid #e5e7eb;">
        <div style="background: white; border-bottom: 2px solid #f3f4f6; padding: 20px 24px; border-radius: 16px 16px 0 0;">
            <h4 style="margin: 0; font-weight: 600; font-size: 18px; color: #111827;">📋 Loan Records Management</h4>
        </div>
        <div class="card-body">
            @if (successMessage != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @successMessage
                    <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
                </div>
            }

            @if (errorMessage != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
                </div>
            }

            <ul class="nav nav-tabs mb-3" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" @onclick="OnActiveLoansTabClick" type="button" role="tab">
                        <i class="bi bi-play-circle"></i> Active Loans
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" @onclick="OnCompletedLoansTabClick" type="button" role="tab">
                        <i class="bi bi-check-circle"></i> Completed Loans
                    </button>
                </li>
            </ul>

            @if (activeTab == "active")
            {
                @if (activeLoans == null)
                {
                    <div class="text-center">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else if (activeLoans.Count == 0)
                {
                    <div class="alert alert-info">No active loans.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Loan Number</th>
                                    <th>Customer</th>
                                    <th>Loan Type</th>
                                    <th>Loan Amount</th>
                                    <th>Outstanding Balance</th>
                                    <th>Monthly Payment</th>
                                    <th>Status</th>
                                    <th>Next Due Date</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var loan in activeLoans)
                                {
                                    <tr style="border-bottom: 1px solid #f1f5f9;">
                                        <td style="padding: 14px;"><span style="background: #dbeafe; color: #1e40af; padding: 6px 12px; border-radius: 8px; font-weight: 600; font-family: monospace; font-size: 13px;">@loan.LoanNumber</span></td>
                                        <td style="padding: 14px; font-weight: 500;">@loan.Account?.Customer?.FullName ?? "N/A"</td>
                                        <td style="padding: 14px;">
                                            <span style="@GetLoanTypeStyle(loan.LoanType)">@loan.LoanType</span>
                                        </td>
                                        <td style="padding: 14px; font-weight: 600; color: #059669;">₱@loan.LoanAmount.ToString("N2")</td>
                                        <td style="padding: 14px; font-weight: 600; color: @(loan.OutstandingBalance > 0 ? "#dc2626" : "#059669");">₱@loan.OutstandingBalance.ToString("N2")</td>
                                        <td style="padding: 14px;">₱@loan.MonthlyPayment.ToString("N2")</td>
                                        <td style="padding: 14px;">
                                            <span style="@GetLoanStatusStyle(loan.Status)">@loan.Status</span>
                                        </td>
                                        <td style="padding: 14px; font-size: 13px; color: @(loan.NextDueDate.HasValue && loan.NextDueDate < DateTime.Today ? "#dc2626" : "#6b7280");">@(loan.NextDueDate?.ToString("MMM dd, yyyy") ?? "N/A")</td>
                                        <td style="padding: 14px;">style="padding: 14px;">
                                            @if (loan.OutstandingBalance == 0 && loan.Status == "ACTIVE")
                                            {
                                                <button style="background: #10b981; color: white; padding: 6px 12px; border: none; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer;" @onclick="() => CompleteLoanAsync(loan.LoanId)">
                                                    ✓ Mark Complete
                                                </button>
                                            }
                                            else
                                            {
                                                <button style="background: #3b82f6; color: white; padding: 6px 12px; border: none; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer;" @onclick="() => ViewLoanDetails(loan)">
                                                    👁️ View Details
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

            @if (activeTab == "completed")
            {
                @if (completedLoans == null)
                {
                    <div class="text-center">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else if (completedLoans.Count == 0)
                {
                    <div class="alert alert-info">No completed loans.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Loan Number</th>
                                    <th>Customer</th>
                                    <th>Loan Type</th>
                                    <th>Loan Amount</th>
                                    <th>Total Paid</th>
                                    <th>Total Interest</th>
                                    <th>Status</th>
                                    <th>Completion Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var loan in completedLoans)
                                {
                                    <tr style="border-bottom: 1px solid #f1f5f9;">
                                        <td style="padding: 14px;"><span style="background: #d1fae5; color: #065f46; padding: 6px 12px; border-radius: 8px; font-weight: 600; font-family: monospace; font-size: 13px;">@loan.LoanNumber</span></td>
                                        <td style="padding: 14px; font-weight: 500;">@loan.Account?.Customer?.FullName</td>
                                        <td style="padding: 14px;">
                                            <span style="@GetLoanTypeStyle(loan.LoanType)">@loan.LoanType</span>
                                        </td>
                                        <td style="padding: 14px; font-weight: 600; color: #059669;">₱@loan.LoanAmount.ToString("N2")</td>
                                        <td style="padding: 14px; font-weight: 600; color: #10b981;">₱@loan.LoanAmount.ToString("N2")</td>
                                        <td style="padding: 14px; color: #6b7280;">₱@((loan.MonthlyPayment * loan.TermMonths) - loan.LoanAmount).ToString("N2")</td>
                                        <td style="padding: 14px;">
                                            <span style="@GetLoanStatusStyle(loan.Status)">@loan.Status</span>
                                        </td>
                                        <td style="padding: 14px; font-size: 13px; color: #6b7280;">@loan.EndDate.ToString("MMM dd, yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

            @if (selectedLoan != null)
            {
                <div class="card mt-4 border-primary">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Loan Summary - @selectedLoan.LoanNumber</h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <p><strong>Customer:</strong> @selectedLoan.Account?.Customer?.FullName</p>
                                <p><strong>Loan Type:</strong> @selectedLoan.LoanType</p>
                                <p><strong>Original Amount:</strong> ₱@selectedLoan.LoanAmount.ToString("N2")</p>
                                <p><strong>Interest Rate:</strong> @selectedLoan.InterestRate%</p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Term Months:</strong> @selectedLoan.TermMonths</p>
                                <p><strong>Monthly Payment:</strong> ₱@selectedLoan.MonthlyPayment.ToString("N2")</p>
                                <p><strong>Outstanding Balance:</strong> ₱@selectedLoan.OutstandingBalance.ToString("N2")</p>
                                <p><strong>Total Penalties:</strong> ₱@selectedLoan.TotalPenalties.ToString("N2")</p>
                            </div>
                        </div>
                        <button class="btn btn-secondary" @onclick="ClearDetails">Close</button>
                    </div>
                </div>
            }
        </div>
    </div>

@code {
    private List<Loan>? activeLoans;
    private List<Loan>? completedLoans;
    private string activeTab = "active";
    private Loan? selectedLoan;
    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadLoansAsync();
    }

    private async Task LoadLoansAsync()
    {
        try
        {
            // Get active loans (already disbursed)
            activeLoans = await LoanProcessService.GetActiveLoansAsync();
            // Get completed loans
            completedLoans = await LoanProcessService.GetCompletedLoansAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading loans: {ex.Message}";
        }
    }

    private void ViewLoanDetails(Loan loan)
    {
        selectedLoan = loan;
    }

    private async Task CompleteLoanAsync(int loanId)
    {
        try
        {
            await LoanPaymentService.MarkLoanCompleteAsync(loanId);
            successMessage = "Loan marked as complete!";
            await LoadLoansAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error completing loan: {ex.Message}";
        }
    }

    private void ClearDetails()
    {
        selectedLoan = null;
    }

    private void OnActiveLoansTabClick()
    {
        activeTab = "active";
    }

    private void OnCompletedLoansTabClick()
    {
        activeTab = "completed";
    }

    // Helper method to get loan type styling
    private string GetLoanTypeStyle(string loanType)
    {
        return loanType switch
        {
            "Personal" => "background: #fef3c7; color: #92400e; padding: 4px 10px; border-radius: 6px; font-weight: 600; font-size: 12px;",
            "Home" => "background: #dbeafe; color: #1e40af; padding: 4px 10px; border-radius: 6px; font-weight: 600; font-size: 12px;",
            "Auto" => "background: #e0e7ff; color: #3730a3; padding: 4px 10px; border-radius: 6px; font-weight: 600; font-size: 12px;",
            "Education" => "background: #ede9fe; color: #5b21b6; padding: 4px 10px; border-radius: 6px; font-weight: 600; font-size: 12px;",
            "Business" => "background: #fce7f3; color: #9d174d; padding: 4px 10px; border-radius: 6px; font-weight: 600; font-size: 12px;",
            _ => "background: #f3f4f6; color: #4b5563; padding: 4px 10px; border-radius: 6px; font-weight: 600; font-size: 12px;"
        };
    }

    // Helper method to get loan status styling based on the Status attribute from CustomerLoans table
    private string GetLoanStatusStyle(string status)
    {
        return status?.ToUpper() switch
        {
            "ACTIVE" => "background: #d1fae5; color: #065f46; padding: 6px 12px; border-radius: 999px; font-weight: 600; font-size: 12px; display: inline-block;",
            "COMPLETED" => "background: #dbeafe; color: #1e40af; padding: 6px 12px; border-radius: 999px; font-weight: 600; font-size: 12px; display: inline-block;",
            "PAID" => "background: #d1fae5; color: #065f46; padding: 6px 12px; border-radius: 999px; font-weight: 600; font-size: 12px; display: inline-block;",
            "DEFAULTED" => "background: #fee2e2; color: #991b1b; padding: 6px 12px; border-radius: 999px; font-weight: 600; font-size: 12px; display: inline-block;",
            "OVERDUE" => "background: #fef3c7; color: #92400e; padding: 6px 12px; border-radius: 999px; font-weight: 600; font-size: 12px; display: inline-block;",
            "PENDING" => "background: #e0e7ff; color: #3730a3; padding: 6px 12px; border-radius: 999px; font-weight: 600; font-size: 12px; display: inline-block;",
            "CLOSED" => "background: #f3f4f6; color: #4b5563; padding: 6px 12px; border-radius: 999px; font-weight: 600; font-size: 12px; display: inline-block;",
            _ => "background: #f3f4f6; color: #4b5563; padding: 6px 12px; border-radius: 999px; font-weight: 600; font-size: 12px; display: inline-block;"
        };
    }
}
