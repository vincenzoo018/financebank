@page "/accountant/trial-balance"
@layout AccountantLayout
@inject TrialBalanceService TrialBalanceService
@inject IJSRuntime JSRuntime
@inject NotificationService NotificationService

<!-- Page Header -->
<div
    style="background: linear-gradient(135deg, #059669 0%, #047857 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
            <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
        </div>
        <div>
            <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Trial Balance</h1>
            <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Verify that debits and credits
                are balanced</p>
        </div>
    </div>
</div>

<!-- Action Bar -->
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <div style="display: flex; gap: 12px;">
        <button
            style="background: linear-gradient(135deg, #059669, #10b981); color: white; padding: 12px 24px; border: none; border-radius: 10px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px;"
            @onclick="GenerateTrialBalance">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M23 4v6h-6M1 20v-6h6M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15" />
            </svg>
            Generate Trial Balance
        </button>
        <button
            style="background: #3b82f6; color: white; padding: 12px 24px; border: none; border-radius: 10px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px;"
            @onclick="ExportToCsv" disabled="@(!tbEntries.Any())">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Export CSV
        </button>
        <button
            style="background: #8b5cf6; color: white; padding: 12px 24px; border: none; border-radius: 10px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px;"
            @onclick="PrintReport" disabled="@(!tbEntries.Any())">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 6 2 18 2 18 9"/>
                <path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/>
                <rect x="6" y="14" width="12" height="8"/>
            </svg>
            Print
        </button>
    </div>
    <div style="display: flex; align-items: center; gap: 12px;">
        <span style="font-size: 14px; color: #6b7280;">As of:</span>
        <input type="date" @bind="asOfDate"
            style="padding: 10px 16px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;" />
    </div>
</div>

<!-- Summary Cards -->
<div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 24px;">
    <div
        style="background: linear-gradient(135deg, #dbeafe, #bfdbfe); border-radius: 16px; padding: 24px; border: 2px solid #93c5fd;">
        <div style="font-size: 13px; color: #1e40af; font-weight: 600; margin-bottom: 8px; text-transform: uppercase;">
            💰 Total Debits</div>
        <div style="font-size: 32px; font-weight: 700; color: #1e40af;">₱@totalDebits.ToString("N2")</div>
    </div>
    <div
        style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); border-radius: 16px; padding: 24px; border: 2px solid #6ee7b7;">
        <div style="font-size: 13px; color: #065f46; font-weight: 600; margin-bottom: 8px; text-transform: uppercase;">✅
            Total Credits</div>
        <div style="font-size: 32px; font-weight: 700; color: #065f46;">₱@totalCredits.ToString("N2")</div>
    </div>
    <div
        style="background: linear-gradient(135deg, @(isBalanced ? "#d1fae5" : "#fee2e2"), @(isBalanced ? "#a7f3d0" : "#fecaca")); border-radius: 16px; padding: 24px; border: 2px solid @(isBalanced ? "#6ee7b7" : "#fca5a5");">
        <div
            style="font-size: 13px; color: @(isBalanced ? "#065f46" : "#991b1b"); font-weight: 600; margin-bottom: 8px; text-transform: uppercase;">
            ⚖️ Balance Status</div>
        <div style="font-size: 28px; font-weight: 700; color: @(isBalanced ? "#065f46" : "#991b1b");">@(isBalanced ? "✓ BALANCED" : "✗ UNBALANCED")</div>
    </div>
</div>

<!-- Alerts -->
@if (!string.IsNullOrEmpty(successMessage))
{
    <div
        style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); border: 1px solid #6ee7b7; color: #065f46; padding: 16px 20px; border-radius: 12px; margin-bottom: 20px; display: flex; align-items: center; gap: 12px;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
        <span style="font-weight: 500;">@successMessage</span>
        <button @onclick="() => successMessage = string.Empty"
            style="margin-left: auto; background: none; border: none; color: #065f46; cursor: pointer; font-size: 18px;">×</button>
    </div>
}

<!-- Trial Balance Table -->
<div style="background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden;">
    <div style="background: linear-gradient(135deg, #059669, #10b981); color: white; padding: 20px 24px;">
        <h4 style="margin: 0; font-weight: 600; font-size: 18px;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                style="margin-right: 8px; vertical-align: middle;">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Trial Balance Report
        </h4>
        <p style="margin: 6px 0 0 0; opacity: 0.9; font-size: 13px;">As of @asOfDate.ToString("MMMM dd, yyyy")</p>
    </div>

    <div style="padding: 24px;">
        @if (isLoading)
        {
            <div style="text-align: center; padding: 60px;">
                <div
                    style="width: 48px; height: 48px; border: 4px solid #e5e7eb; border-top-color: #059669; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto;">
                </div>
                <p style="margin-top: 16px; color: #6b7280;">Loading trial balance...</p>
            </div>
        }
        else if (tbEntries == null || !tbEntries.Any())
        {
            <div style="text-align: center; padding: 60px;">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5"
                    style="margin: 0 auto 16px;">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <p style="color: #6b7280; font-size: 16px;">No trial balance entries found</p>
                <p style="color: #9ca3af; font-size: 14px;">Click "Generate Trial Balance" to create a report</p>
            </div>
        }
        else
        {
            <table style="width: 100%; border-collapse: separate; border-spacing: 0;">
                <thead>
                    <tr style="background: linear-gradient(135deg, #f8fafc, #f1f5f9);">
                        <th
                            style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">
                            Account Code</th>
                        <th
                            style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">
                            Account Name</th>
                        <th
                            style="padding: 14px 16px; text-align: right; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">
                            Debit</th>
                        <th
                            style="padding: 14px 16px; text-align: right; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">
                            Credit</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in tbEntries)
                    {
                        <tr style="border-bottom: 1px solid #f1f5f9;">
                            <td style="padding: 16px;">
                                <span
                                    style="background: #e0e7ff; color: #3730a3; padding: 4px 10px; border-radius: 6px; font-family: monospace; font-weight: 600;">@entry.AccountCode</span>
                            </td>
                            <td style="padding: 16px; font-weight: 500; color: #1e293b;">@entry.AccountName</td>
                            <td
                                style="padding: 16px; text-align: right; font-weight: 600; color: @(entry.DebitBalance > 0 ? "#dc2626" : "#9ca3af");">
                                @(entry.DebitBalance > 0 ? $"₱{entry.DebitBalance:N2}" : "-")
                            </td>
                            <td
                                style="padding: 16px; text-align: right; font-weight: 600; color: @(entry.CreditBalance > 0 ? "#059669" : "#9ca3af");">
                                @(entry.CreditBalance > 0 ? $"₱{entry.CreditBalance:N2}" : "-")
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr style="background: linear-gradient(135deg, #f8fafc, #f1f5f9); border-top: 2px solid #e2e8f0;">
                        <td colspan="2"
                            style="padding: 16px; text-align: right; font-weight: 700; color: #1e293b; font-size: 15px;">
                            TOTALS:</td>
                        <td style="padding: 16px; text-align: right; font-weight: 700; color: #dc2626; font-size: 16px;">
                            ₱@totalDebits.ToString("N2")</td>
                        <td style="padding: 16px; text-align: right; font-weight: 700; color: #059669; font-size: 16px;">
                            ₱@totalCredits.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        }
    </div>
</div>

<style>
    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

@code {
    private List<TrialBalanceEntry> tbEntries = new();
    private decimal totalDebits = 0;
    private decimal totalCredits = 0;
    private bool isBalanced = true;
    private bool isLoading = true;
    private DateTime asOfDate = DateTime.Today;
    private string successMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadTrialBalance();
    }

    private async Task LoadTrialBalance()
    {
        isLoading = true;
        try
        {
            tbEntries = await TrialBalanceService.GetAllAsync();
            CalculateTotals();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading trial balance: {ex.Message}");
            tbEntries = new List<TrialBalanceEntry>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void CalculateTotals()
    {
        totalDebits = tbEntries.Sum(e => e.DebitBalance);
        totalCredits = tbEntries.Sum(e => e.CreditBalance);
        isBalanced = Math.Abs(totalDebits - totalCredits) < 0.01m;
    }

    private async Task GenerateTrialBalance()
    {
        isLoading = true;
        try
        {
            // Refresh the trial balance from the database
            await LoadTrialBalance();
            successMessage = $"✓ Trial Balance refreshed successfully as of {asOfDate:MMM dd, yyyy}";
            NotificationService.ShowSuccess("Trial Balance Generated", $"Trial balance refreshed successfully as of {asOfDate:MMM dd, yyyy}. Status: {(isBalanced ? "BALANCED" : "UNBALANCED")}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error generating trial balance: {ex.Message}");
            NotificationService.ShowError("Generation Failed", $"Failed to generate trial balance: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ExportToCsv()
    {
        if (!tbEntries.Any())
        {
            successMessage = "No data to export. Please generate a trial balance first.";
            NotificationService.ShowWarning("No Data", "No data to export. Please generate a trial balance first.");
            return;
        }

        try
        {
            var csv = new System.Text.StringBuilder();
            csv.AppendLine($"FINEBANK TRIAL BALANCE");
            csv.AppendLine($"As of: {asOfDate:MMMM dd, yyyy}");
            csv.AppendLine();
            csv.AppendLine("Account Code,Account Name,Debit,Credit");

            foreach (var entry in tbEntries)
            {
                csv.AppendLine($"\"{entry.AccountCode}\",\"{entry.AccountName}\",\"{entry.DebitBalance:N2}\",\"{entry.CreditBalance:N2}\"");
            }

            csv.AppendLine();
            csv.AppendLine($"TOTALS,,\"{totalDebits:N2}\",\"{totalCredits:N2}\"");
            csv.AppendLine($"Balance Status: {(isBalanced ? "BALANCED" : "UNBALANCED")}");

            var fileName = $"TrialBalance_{asOfDate:yyyyMMdd}.csv";
            var bytes = System.Text.Encoding.UTF8.GetBytes(csv.ToString());
            var base64 = Convert.ToBase64String(bytes);

            await JSRuntime.InvokeVoidAsync("downloadFile", fileName, "text/csv", base64);
            successMessage = $"✓ Trial Balance exported to {fileName}";
            NotificationService.ShowSuccess("Export Complete", $"Trial balance exported to {fileName}");
        }
        catch (Exception ex)
        {
            successMessage = $"Export failed: {ex.Message}";
            NotificationService.ShowError("Export Failed", $"Failed to export trial balance: {ex.Message}");
        }
    }

    private async Task PrintReport()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("print");
            successMessage = "✓ Print dialog opened";
            NotificationService.ShowInfo("Print", "Print dialog opened successfully.");
        }
        catch
        {
            successMessage = "Print feature requires browser support";
            NotificationService.ShowWarning("Print Unavailable", "Print feature requires browser support.");
        }
    }
}