@page "/accountant/dashboard"
@layout AccountantLayout
@inject JournalEntryService JournalEntryService
@inject AccountsPayableService AccountsPayableService
@inject AccountsReceivableService AccountsReceivableService
@inject GeneralLedgerService GeneralLedgerService
@inject FinancialStatementService FinancialStatementService
@inject CustomerTransactionService CustomerTransactionService
@inject LoanService LoanService

<div style="padding: 24px; max-width: 1400px; margin: 0 auto;">
    <!-- Header with Filter -->
    <div style="background: linear-gradient(135deg, #f59e0b, #d97706); border-radius: 16px; padding: 24px; margin-bottom: 24px; color: white;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h1 style="font-size: 24px; font-weight: 700; margin: 0;">📊 Accountant Dashboard</h1>
                <p style="margin: 8px 0 0; font-size: 14px; opacity: 0.9;">Real-time financial records & accounting operations</p>
            </div>
            <div style="display: flex; gap: 8px;">
                <button @onclick='() => SetPeriod("day")'
                    style="padding: 8px 16px; background: @(selectedPeriod == "day" ? "white" : "rgba(255,255,255,0.2)"); color: @(selectedPeriod == "day" ? "#d97706" : "white"); border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer;">Today</button>
                <button @onclick='() => SetPeriod("week")'
                    style="padding: 8px 16px; background: @(selectedPeriod == "week" ? "white" : "rgba(255,255,255,0.2)"); color: @(selectedPeriod == "week" ? "#d97706" : "white"); border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer;">This Week</button>
                <button @onclick='() => SetPeriod("month")'
                    style="padding: 8px 16px; background: @(selectedPeriod == "month" ? "white" : "rgba(255,255,255,0.2)"); color: @(selectedPeriod == "month" ? "#d97706" : "white"); border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer;">This Month</button>
                <button @onclick="LoadData" style="padding: 8px 16px; background: rgba(255,255,255,0.2); color: white; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer;">
                    🔄 Refresh
                </button>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div style="text-align: center; padding: 60px;">
            <div style="width: 48px; height: 48px; border: 4px solid #e5e7eb; border-top-color: #f59e0b; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto;"></div>
            <p style="margin-top: 16px; color: #6b7280;">Loading dashboard data...</p>
        </div>
    }
    else
    {
        <!-- Stats Cards -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 24px;">
            <!-- Journal Entries -->
            <div style="background: white; border-radius: 12px; padding: 20px; border: 2px solid #fef3c7; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                    <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #fef3c7, #fde68a); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                        <span style="font-size: 24px;">📝</span>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: #6b7280; font-weight: 500;">Journal Entries</div>
                        <div style="font-size: 28px; font-weight: 700; color: #d97706;">@totalJournalEntries</div>
                    </div>
                </div>
                <div style="font-size: 12px; color: #92400e; background: #fef3c7; padding: 6px 10px; border-radius: 6px;">
                    @pendingJournalEntries pending review
                </div>
            </div>

            <!-- Accounts Payable -->
            <div style="background: white; border-radius: 12px; padding: 20px; border: 2px solid #fee2e2; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                    <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #fee2e2, #fecaca); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                        <span style="font-size: 24px;">💳</span>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: #6b7280; font-weight: 500;">Accounts Payable</div>
                        <div style="font-size: 28px; font-weight: 700; color: #dc2626;">₱@FormatAmount(totalPayables)</div>
                    </div>
                </div>
                <div style="font-size: 12px; color: #991b1b; background: #fee2e2; padding: 6px 10px; border-radius: 6px;">
                    @pendingPayables invoices pending
                </div>
            </div>

            <!-- Accounts Receivable -->
            <div style="background: white; border-radius: 12px; padding: 20px; border: 2px solid #d1fae5; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                    <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #d1fae5, #a7f3d0); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                        <span style="font-size: 24px;">💰</span>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: #6b7280; font-weight: 500;">Accounts Receivable</div>
                        <div style="font-size: 28px; font-weight: 700; color: #059669;">₱@FormatAmount(totalReceivables)</div>
                    </div>
                </div>
                <div style="font-size: 12px; color: #065f46; background: #d1fae5; padding: 6px 10px; border-radius: 6px;">
                    @pendingReceivables pending collection
                </div>
            </div>

            <!-- General Ledger Entries -->
            <div style="background: white; border-radius: 12px; padding: 20px; border: 2px solid #dbeafe; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                    <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #dbeafe, #bfdbfe); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                        <span style="font-size: 24px;">📒</span>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: #6b7280; font-weight: 500;">GL Entries</div>
                        <div style="font-size: 28px; font-weight: 700; color: #2563eb;">@totalGLEntries</div>
                    </div>
                </div>
                <div style="font-size: 12px; color: #1e40af; background: #dbeafe; padding: 6px 10px; border-radius: 6px;">
                    Posted to ledger
                </div>
            </div>
        </div>

        <!-- Second Row Stats -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 24px;">
            <!-- Total Deposits -->
            <div style="background: white; border-radius: 12px; padding: 20px; border: 2px solid #d1fae5; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #059669, #047857); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                        <span style="font-size: 24px; filter: grayscale(1) brightness(10);">⬆️</span>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: #6b7280; font-weight: 500;">Total Deposits</div>
                        <div style="font-size: 24px; font-weight: 700; color: #059669;">₱@FormatAmount(totalDeposits)</div>
                        <div style="font-size: 11px; color: #6b7280;">@periodLabel</div>
                    </div>
                </div>
            </div>

            <!-- Total Withdrawals -->
            <div style="background: white; border-radius: 12px; padding: 20px; border: 2px solid #fee2e2; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #dc2626, #b91c1c); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                        <span style="font-size: 24px; filter: grayscale(1) brightness(10);">⬇️</span>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: #6b7280; font-weight: 500;">Total Withdrawals</div>
                        <div style="font-size: 24px; font-weight: 700; color: #dc2626;">₱@FormatAmount(totalWithdrawals)</div>
                        <div style="font-size: 11px; color: #6b7280;">@periodLabel</div>
                    </div>
                </div>
            </div>

            <!-- Active Loans -->
            <div style="background: white; border-radius: 12px; padding: 20px; border: 2px solid #ede9fe; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #7c3aed, #6d28d9); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                        <span style="font-size: 24px; filter: grayscale(1) brightness(10);">🏦</span>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: #6b7280; font-weight: 500;">Active Loans</div>
                        <div style="font-size: 24px; font-weight: 700; color: #7c3aed;">@activeLoans</div>
                        <div style="font-size: 11px; color: #6b7280;">₱@FormatAmount(totalLoanAmount) outstanding</div>
                    </div>
                </div>
            </div>

            <!-- Financial Statements -->
            <div style="background: white; border-radius: 12px; padding: 20px; border: 2px solid #fce7f3; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #ec4899, #db2777); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                        <span style="font-size: 24px; filter: grayscale(1) brightness(10);">📄</span>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: #6b7280; font-weight: 500;">Financial Statements</div>
                        <div style="font-size: 24px; font-weight: 700; color: #db2777;">@totalStatements</div>
                        <div style="font-size: 11px; color: #6b7280;">Generated reports</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts Row -->
        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 20px; margin-bottom: 24px;">
            <!-- Transaction Trend Chart -->
            <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                    <h3 style="font-size: 16px; font-weight: 700; margin: 0;">📈 Transaction Flow (@periodLabel)</h3>
                    <div style="display: flex; gap: 16px;">
                        <div style="display: flex; align-items: center; gap: 6px;">
                            <div style="width: 12px; height: 12px; background: #059669; border-radius: 3px;"></div>
                            <span style="font-size: 12px; color: #6b7280;">Deposits</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 6px;">
                            <div style="width: 12px; height: 12px; background: #dc2626; border-radius: 3px;"></div>
                            <span style="font-size: 12px; color: #6b7280;">Withdrawals</span>
                        </div>
                    </div>
                </div>
                
                @if (transactionChartData.Any())
                {
                    <div style="display: flex; align-items: flex-end; gap: 8px; height: 200px; padding-bottom: 30px; border-bottom: 2px solid #e5e7eb;">
                        @foreach (var data in transactionChartData)
                        {
                            var maxVal = transactionChartData.Max(d => Math.Max(d.Deposits, d.Withdrawals));
                            var depositHeight = maxVal > 0 ? (data.Deposits / maxVal * 100) : 0;
                            var withdrawalHeight = maxVal > 0 ? (data.Withdrawals / maxVal * 100) : 0;
                            
                            <div style="flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4px;">
                                <div style="display: flex; gap: 2px; align-items: flex-end; height: 160px;">
                                    <div style="width: 16px; background: linear-gradient(180deg, #059669, #047857); border-radius: 4px 4px 0 0; height: @(depositHeight)%; min-height: 4px;" title="Deposits: ₱@data.Deposits.ToString("N0")"></div>
                                    <div style="width: 16px; background: linear-gradient(180deg, #dc2626, #b91c1c); border-radius: 4px 4px 0 0; height: @(withdrawalHeight)%; min-height: 4px;" title="Withdrawals: ₱@data.Withdrawals.ToString("N0")"></div>
                                </div>
                                <div style="font-size: 10px; color: #6b7280; font-weight: 600;">@data.Label</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div style="text-align: center; padding: 40px; color: #6b7280;">
                        <p>No transaction data for this period</p>
                    </div>
                }

                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; margin-top: 16px;">
                    <div style="text-align: center; padding: 12px; background: #d1fae5; border-radius: 8px;">
                        <div style="font-size: 11px; color: #065f46;">Total Deposits</div>
                        <div style="font-size: 18px; font-weight: 700; color: #059669;">₱@FormatAmount(totalDeposits)</div>
                    </div>
                    <div style="text-align: center; padding: 12px; background: #fee2e2; border-radius: 8px;">
                        <div style="font-size: 11px; color: #991b1b;">Total Withdrawals</div>
                        <div style="font-size: 18px; font-weight: 700; color: #dc2626;">₱@FormatAmount(totalWithdrawals)</div>
                    </div>
                    <div style="text-align: center; padding: 12px; background: @(netFlow >= 0 ? "#d1fae5" : "#fee2e2"); border-radius: 8px;">
                        <div style="font-size: 11px; color: @(netFlow >= 0 ? "#065f46" : "#991b1b");">Net Flow</div>
                        <div style="font-size: 18px; font-weight: 700; color: @(netFlow >= 0 ? "#059669" : "#dc2626");">₱@FormatAmount(netFlow)</div>
                    </div>
                </div>
            </div>

            <!-- Financial Summary -->
            <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
                <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 20px;">💼 Financial Summary</h3>
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div style="padding: 16px; background: linear-gradient(135deg, #dbeafe, #bfdbfe); border-radius: 12px;">
                        <div style="font-size: 12px; color: #1e40af; font-weight: 600;">Total Assets (Receivables)</div>
                        <div style="font-size: 24px; font-weight: 700; margin-top: 4px; color: #1e40af;">₱@FormatAmount(totalReceivables)</div>
                    </div>
                    <div style="padding: 16px; background: linear-gradient(135deg, #fee2e2, #fecaca); border-radius: 12px;">
                        <div style="font-size: 12px; color: #991b1b; font-weight: 600;">Total Liabilities (Payables)</div>
                        <div style="font-size: 24px; font-weight: 700; margin-top: 4px; color: #dc2626;">₱@FormatAmount(totalPayables)</div>
                    </div>
                    <div style="padding: 16px; background: linear-gradient(135deg, @(netPosition >= 0 ? "#d1fae5, #a7f3d0" : "#fee2e2, #fecaca")); border-radius: 12px;">
                        <div style="font-size: 12px; color: @(netPosition >= 0 ? "#065f46" : "#991b1b"); font-weight: 600;">Net Position</div>
                        <div style="font-size: 24px; font-weight: 700; margin-top: 4px; color: @(netPosition >= 0 ? "#059669" : "#dc2626");">₱@FormatAmount(netPosition)</div>
                    </div>
                    <div style="padding: 12px; background: #f9fafb; border-radius: 8px;">
                        <div style="font-size: 12px; color: #6b7280;">Data Accuracy</div>
                        <div style="display: flex; align-items: center; gap: 8px; margin-top: 8px;">
                            <div style="flex: 1; height: 10px; background: #e5e7eb; border-radius: 5px; overflow: hidden;">
                                <div style="width: 100%; height: 100%; background: linear-gradient(90deg, #10b981, #059669);"></div>
                            </div>
                            <span style="font-size: 16px; font-weight: 700; color: #059669;">100%</span>
                        </div>
                        <div style="font-size: 10px; color: #6b7280; margin-top: 4px;">Real-time database sync</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Activities -->
        <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
            <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 16px;">🕐 Recent Transactions</h3>
            @if (recentTransactions.Any())
            {
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    @foreach (var tx in recentTransactions.Take(8))
                    {
                        var isDeposit = tx.TransactionType == "Deposit";
                        var isWithdrawal = tx.TransactionType == "Withdrawal";
                        var color = isDeposit ? "#059669" : (isWithdrawal ? "#dc2626" : "#3b82f6");
                        var bgColor = isDeposit ? "#d1fae5" : (isWithdrawal ? "#fee2e2" : "#dbeafe");
                        var icon = isDeposit ? "⬆️" : (isWithdrawal ? "⬇️" : "↔️");
                        
                        <div style="display: flex; align-items: center; gap: 12px; padding: 12px; background: #f9fafb; border-radius: 8px; border-left: 4px solid @color;">
                            <div style="width: 36px; height: 36px; background: @bgColor; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                <span style="font-size: 16px;">@icon</span>
                            </div>
                            <div style="flex: 1;">
                                <div style="font-weight: 600; font-size: 14px; color: #111827;">@tx.TransactionType</div>
                                <div style="font-size: 12px; color: #6b7280;">Account: @tx.AccountId • Ref: @(tx.Reference ?? "N/A")</div>
                            </div>
                            <div style="text-align: right;">
                                <div style="font-weight: 700; font-size: 16px; color: @color;">@(isWithdrawal ? "-" : "+")₱@tx.Amount.ToString("N2")</div>
                                <div style="font-size: 11px; color: #9ca3af;">@tx.CreatedAt.ToString("MMM dd, HH:mm")</div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div style="text-align: center; padding: 40px; color: #6b7280;">
                    <p>No recent transactions</p>
                </div>
            }
        </div>
    }
</div>

<style>
    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

@code {
    private string selectedPeriod = "month";
    private string periodLabel = "This Month";
    private bool isLoading = true;
    
    // Stats
    private int totalJournalEntries = 0;
    private int pendingJournalEntries = 0;
    private decimal totalPayables = 0;
    private int pendingPayables = 0;
    private decimal totalReceivables = 0;
    private int pendingReceivables = 0;
    private int totalGLEntries = 0;
    private decimal totalDeposits = 0;
    private decimal totalWithdrawals = 0;
    private decimal netFlow = 0;
    private decimal netPosition = 0;
    private int activeLoans = 0;
    private decimal totalLoanAmount = 0;
    private int totalStatements = 0;
    
    // Data
    private List<TransactionChartData> transactionChartData = new();
    private List<CustomerTransaction> recentTransactions = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task SetPeriod(string period)
    {
        selectedPeriod = period;
        periodLabel = period switch
        {
            "day" => "Today",
            "week" => "This Week",
            "month" => "This Month",
            _ => "This Month"
        };
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();
        
        try
        {
            var startDate = selectedPeriod switch
            {
                "day" => DateTime.Today,
                "week" => DateTime.Today.AddDays(-(int)DateTime.Today.DayOfWeek),
                "month" => new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1),
                _ => new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1)
            };
            var endDate = DateTime.Now;

            // Load Journal Entries
            var journalEntries = await JournalEntryService.GetAllAsync();
            var periodJournalEntries = journalEntries.Where(j => j.TransactionDate >= startDate && j.TransactionDate <= endDate).ToList();
            totalJournalEntries = periodJournalEntries.Count;
            pendingJournalEntries = periodJournalEntries.Count(j => j.Status == "Draft" || j.Status == "Pending");

            // Load Accounts Payable
            var payables = await AccountsPayableService.GetAllAsync();
            totalPayables = payables.Where(p => p.Status != "Paid").Sum(p => p.OutstandingAmount);
            pendingPayables = payables.Count(p => p.Status == "Pending" || p.Status == "Draft");

            // Load Accounts Receivable
            var receivables = await AccountsReceivableService.GetAllAsync();
            totalReceivables = receivables.Where(r => r.Status != "Paid").Sum(r => r.OutstandingAmount);
            pendingReceivables = receivables.Count(r => r.Status == "Pending" || r.Status == "Draft");

            // Load General Ledger
            var glEntries = await GeneralLedgerService.GetAllAsync();
            totalGLEntries = glEntries.Count(g => g.TransactionDate >= startDate && g.TransactionDate <= endDate);

            // Load Customer Transactions
            var transactions = await CustomerTransactionService.GetAllAsync();
            var periodTransactions = transactions.Where(t => t.CreatedAt >= startDate && t.CreatedAt <= endDate).ToList();
            
            totalDeposits = periodTransactions.Where(t => t.TransactionType == "Deposit").Sum(t => t.Amount);
            totalWithdrawals = periodTransactions.Where(t => t.TransactionType == "Withdrawal").Sum(t => t.Amount);
            netFlow = totalDeposits - totalWithdrawals;
            netPosition = totalReceivables - totalPayables;
            
            recentTransactions = transactions.OrderByDescending(t => t.CreatedAt).Take(10).ToList();

            // Load Loans
            var loans = await LoanService.GetAllAsync();
            activeLoans = loans.Count(l => l.Status == "Active" || l.Status == "Approved");
            totalLoanAmount = loans.Where(l => l.Status == "Active" || l.Status == "Approved").Sum(l => l.LoanAmount);

            // Load Financial Statements
            var statements = await FinancialStatementService.GetAllAsync();
            totalStatements = statements.Count;

            // Build chart data
            BuildChartData(periodTransactions, startDate, endDate);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void BuildChartData(List<CustomerTransaction> transactions, DateTime startDate, DateTime endDate)
    {
        transactionChartData.Clear();
        
        if (selectedPeriod == "day")
        {
            // Hourly breakdown for today
            for (int hour = 0; hour < 24; hour += 4)
            {
                var hourStart = startDate.AddHours(hour);
                var hourEnd = startDate.AddHours(hour + 4);
                var hourTransactions = transactions.Where(t => t.CreatedAt >= hourStart && t.CreatedAt < hourEnd);
                
                transactionChartData.Add(new TransactionChartData
                {
                    Label = $"{hour}:00",
                    Deposits = hourTransactions.Where(t => t.TransactionType == "Deposit").Sum(t => t.Amount),
                    Withdrawals = hourTransactions.Where(t => t.TransactionType == "Withdrawal").Sum(t => t.Amount)
                });
            }
        }
        else if (selectedPeriod == "week")
        {
            // Daily breakdown for the week
            string[] days = { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" };
            for (int i = 0; i < 7; i++)
            {
                var dayDate = startDate.AddDays(i);
                var dayTransactions = transactions.Where(t => t.CreatedAt.Date == dayDate.Date);
                
                transactionChartData.Add(new TransactionChartData
                {
                    Label = days[(int)dayDate.DayOfWeek],
                    Deposits = dayTransactions.Where(t => t.TransactionType == "Deposit").Sum(t => t.Amount),
                    Withdrawals = dayTransactions.Where(t => t.TransactionType == "Withdrawal").Sum(t => t.Amount)
                });
            }
        }
        else
        {
            // Weekly breakdown for the month
            var weekStart = startDate;
            int weekNum = 1;
            while (weekStart <= endDate)
            {
                var weekEnd = weekStart.AddDays(7) > endDate ? endDate : weekStart.AddDays(7);
                var weekTransactions = transactions.Where(t => t.CreatedAt >= weekStart && t.CreatedAt < weekEnd);
                
                transactionChartData.Add(new TransactionChartData
                {
                    Label = $"Wk {weekNum}",
                    Deposits = weekTransactions.Where(t => t.TransactionType == "Deposit").Sum(t => t.Amount),
                    Withdrawals = weekTransactions.Where(t => t.TransactionType == "Withdrawal").Sum(t => t.Amount)
                });
                
                weekStart = weekEnd;
                weekNum++;
            }
        }
    }

    private string FormatAmount(decimal amount)
    {
        if (Math.Abs(amount) >= 1000000)
            return $"{amount / 1000000:N2}M";
        if (Math.Abs(amount) >= 1000)
            return $"{amount / 1000:N1}K";
        return amount.ToString("N0");
    }

    private class TransactionChartData
    {
        public string Label { get; set; } = "";
        public decimal Deposits { get; set; }
        public decimal Withdrawals { get; set; }
    }
}
