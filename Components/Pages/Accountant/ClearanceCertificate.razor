@page "/accountant/clearance-certificate"
@using Microsoft.AspNetCore.Authorization
@using FinanceBank.Services
@using FinanceBank.Models
@layout AccountantLayout
@inject LoanProcessService LoanProcessService
@inject LoanPaymentService LoanPaymentService
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Accountant")]

<div class="card shadow">
        <div class="card-header bg-warning text-white">
            <h4 class="mb-0"><i class="bi bi-certificate"></i> Loan Clearance Certificate</h4>
        </div>
        <div class="card-body">
            @if (successMessage != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @successMessage
                    <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
                </div>
            }

            @if (errorMessage != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
                </div>
            }

            @if (completedLoans == null)
            {
                <div class="text-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else if (completedLoans.Count == 0)
            {
                <div class="alert alert-info">No completed loans available for clearance certificate.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Loan Number</th>
                                <th>Customer</th>
                                <th>Loan Amount</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var loan in completedLoans)
                            {
                                <tr>
                                    <td><span class="badge bg-primary">@loan.LoanNumber</span></td>
                                    <td>@loan.Account?.Customer?.FullName</td>
                                    <td>₱@loan.LoanAmount.ToString("N2")</td>
                                    <td>@loan.StartDate.ToString("yyyy-MM-dd")</td>
                                    <td>@loan.EndDate.ToString("yyyy-MM-dd")</td>
                                    <td><span class="badge bg-success">@loan.Status</span></td>
                                    <td>
                                        <button class="btn btn-sm btn-warning" @onclick="() => ViewCertificateAsync(loan)">
                                            <i class="bi bi-file-pdf"></i> Certificate
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (selectedLoan != null)
            {
                <div class="card mt-4 border-warning">
                    <div class="card-header bg-warning text-white">
                        <h5 class="mb-0">📄 Loan Clearance Certificate</h5>
                    </div>
                    <div class="card-body">
                        <div style="border: 2px solid #d4af37; padding: 40px; border-radius: 10px; background: linear-gradient(135deg, #fffacd 0%, #faf0e6 100%);">
                            <div style="text-align: center; margin-bottom: 30px;">
                                <h3 style="color: #333; font-weight: bold;">LOAN CLEARANCE CERTIFICATE</h3>
                                <p style="color: #666; font-style: italic;">This is to certify that the loan has been fully settled</p>
                            </div>

                            <div style="margin: 20px 0;">
                                <p><strong>Loan Number:</strong> @selectedLoan.LoanNumber</p>
                                <p><strong>Customer Name:</strong> @selectedLoan.Account?.Customer?.FullName</p>
                                <p><strong>Customer Account #:</strong> @selectedLoan.Account?.AccountNumber</p>
                            </div>

                            <div style="margin: 20px 0; border-top: 1px solid #ccc; padding-top: 20px;">
                                <p><strong>Loan Amount:</strong> ₱@selectedLoan.LoanAmount.ToString("N2")</p>
                                <p><strong>Interest Rate:</strong> @selectedLoan.InterestRate.ToString("N2")%</p>
                                <p><strong>Loan Term:</strong> @selectedLoan.TermMonths months</p>
                                <p><strong>Start Date:</strong> @selectedLoan.StartDate.ToString("MMMM dd, yyyy")</p>
                                <p><strong>Completion Date:</strong> @selectedLoan.EndDate.ToString("MMMM dd, yyyy")</p>
                            </div>

                            <div style="margin-top: 30px; border-top: 1px solid #ccc; padding-top: 20px; text-align: center;">
                                <p style="font-size: 14px; color: #666;">
                                    This certifies that the above-mentioned loan has been fully settled and all outstanding obligations have been cleared.
                                </p>
                                <p style="margin-top: 20px; color: #333;">
                                    <strong>Issued by: Finance System</strong>
                                </p>
                                <p style="color: #666;">
                                    Date: @DateTime.Now.ToString("MMMM dd, yyyy")
                                </p>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button class="btn btn-primary" @onclick="GenerateCertificateAsync">
                                <i class="bi bi-download"></i> Download Certificate
                            </button>
                            <button class="btn btn-secondary" @onclick="ClearSelection">
                                Close
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

@code {
    private List<Loan>? completedLoans;
    private Loan? selectedLoan;
    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadCompletedLoansAsync();
    }

    private async Task LoadCompletedLoansAsync()
    {
        try
        {
            completedLoans = await LoanProcessService.GetCompletedLoansAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading loans: {ex.Message}";
        }
    }

    private void ViewCertificateAsync(Loan loan)
    {
        selectedLoan = loan;
    }

    private async Task GenerateCertificateAsync()
    {
        try
        {
            if (selectedLoan == null) return;
            
            // In a real scenario, this would generate a PDF certificate
            // For now, we'll just show a success message
            successMessage = $"Clearance certificate for {selectedLoan.LoanNumber} has been generated and downloaded!";
            await Task.Delay(2000);
            ClearSelection();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error generating certificate: {ex.Message}";
        }
    }

    private void ClearSelection()
    {
        selectedLoan = null;
    }
}
