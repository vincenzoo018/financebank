@page "/accountant/review-assessment"
@using Microsoft.AspNetCore.Authorization
@using FinanceBank.Services
@using FinanceBank.Models
@layout AccountantLayout
@inject LoanProcessService LoanProcessService
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Accountant")]

<div class="card shadow">
    <div class="card-header bg-warning text-white">
        <h4 class="mb-0"><i class="bi bi-calculator"></i> Loan Assessment Review</h4>
    </div>
    <div class="card-body">
        @if (successMessage != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @successMessage
                <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
            </div>
        }

        @if (errorMessage != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @errorMessage
                <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
            </div>
        }

        @if (pendingAssessments == null)
        {
            <div class="text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else if (pendingAssessments.Count == 0)
        {
            <div class="alert alert-info">No applications pending assessment.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Application #</th>
                            <th>Customer</th>
                            <th>Loan Type</th>
                            <th>Amount</th>
                            <th>Monthly Income</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in pendingAssessments)
                        {
                            <tr>
                                <td><span class="badge bg-primary">@app.ApplicationNumber</span></td>
                                <td>@app.Account?.Customer?.FullName</td>
                                <td>@app.LoanType</td>
                                <td>₱@app.RequestedAmount.ToString("N2")</td>
                                <td>₱@app.MonthlyIncome?.ToString("N2")</td>
                                <td>
                                    <button class="btn btn-sm btn-warning"
                                        @onclick="() => ReviewAsync(app.ApplicationId, app.AccountId, app.RequestedAmount, app.LoanType)">
                                        <i class="bi bi-eye"></i> Review
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (selectedApplication != null)
        {
            <div class="card mt-4 border-primary">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Loan Assessment Computation</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Loan Amount (₱)</label>
                            <input type="number" class="form-control" @bind="assessmentAmount" step="0.01" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Interest Rate (%)</label>
                            <input type="number" class="form-control" @bind="assessmentRate" step="0.01" />
                        </div>
                    </div>
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> Loan term is based on the customer's application (default: 36
                        months).
                    </div>
                    <div class="d-grid gap-2">
                        <button class="btn btn-primary" @onclick="SubmitAssessmentAsync">
                            <i class="bi bi-check-lg"></i> Submit Assessment
                        </button>
                        <button class="btn btn-secondary" @onclick="CancelAssessment">Cancel</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<LoanApplication>? pendingAssessments;
    private LoanApplication? selectedApplication;
    private decimal assessmentAmount;
    private decimal assessmentRate;
    private int assessmentTerm;
    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadPendingAssessmentsAsync();
    }

    private async Task LoadPendingAssessmentsAsync()
    {
        try
        {
            pendingAssessments = await LoanProcessService.GetPendingApplicationsAsync("ACCOUNTANT");
            Console.WriteLine($"[DEBUG] Loaded {pendingAssessments?.Count ?? 0} pending assessments");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading applications: {ex.Message}";
            Console.WriteLine($"[ERROR] {ex}");
        }
    }

    private void ReviewAsync(int applicationId, int accountId, decimal amount, string loanType)
    {
        selectedApplication = new LoanApplication { ApplicationId = applicationId, AccountId = accountId };
        assessmentAmount = amount;
        assessmentTerm = 36; // Default 3 years

        // Set interest rate based on loan type
        assessmentRate = loanType switch
        {
            "Personal" => 12.5m,
            "Home" => 8.5m,
            "Auto" => 9.5m,
            _ => 10.0m
        };
    }

    private async Task SubmitAssessmentAsync()
    {
        try
        {
            if (selectedApplication != null)
            {
                await LoanProcessService.CreateAssessmentAsync(
                applicationId: selectedApplication.ApplicationId,
                accountId: selectedApplication.AccountId,
                loanAmount: assessmentAmount,
                interestRate: assessmentRate,
                termMonths: assessmentTerm,
                assessedBy: "accountant-user"
                );

                successMessage = "Loan assessment submitted successfully!";
                selectedApplication = null;
                await LoadPendingAssessmentsAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error submitting assessment: {ex.Message}";
        }
    }

    private void CancelAssessment()
    {
        selectedApplication = null;
    }
}