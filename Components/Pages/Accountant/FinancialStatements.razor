@page "/accountant/financial-statements"
@layout AccountantLayout
@inject FinancialStatementService FinancialStatementService
@inject AuthService AuthService
@using System.Text.Json

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
            <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
        </div>
        <div>
            <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Financial Statements</h1>
            <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Income Statement, Balance Sheet, Cash Flow - Generated from real transactions</p>
        </div>
    </div>
</div>

<!-- Data Source Info -->
<div style="background: #dbeafe; border: 1px solid #3b82f6; border-radius: 12px; padding: 16px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 12px;">
        <span style="font-size: 24px;">📊</span>
        <div>
            <p style="margin: 0; font-weight: 600; color: #1e40af;">Real-Time Data Connection</p>
            <p style="margin: 4px 0 0; font-size: 13px; color: #3b82f6;">
                Financial statements are generated from: <strong>General Ledger</strong> (for Income/Balance Sheet), 
                <strong>Customer Transactions</strong>, <strong>Loan Payments</strong>, and <strong>Loan Disbursals</strong> (for Cash Flow)
            </p>
        </div>
    </div>
</div>

<!-- Action Buttons -->
<div style="display: flex; gap: 12px; margin-bottom: 24px; flex-wrap: wrap;">
    <button style="background: linear-gradient(135deg, #7c3aed, #8b5cf6); color: white; padding: 14px 28px; border: none; border-radius: 12px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 10px; font-size: 15px; box-shadow: 0 4px 12px rgba(124, 58, 237, 0.3);"
        @onclick='() => ShowStatementModal("IncomeStatement")'>
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
            <polyline points="17 6 23 6 23 12"></polyline>
        </svg>
        Income Statement
    </button>
    <button style="background: linear-gradient(135deg, #3b82f6, #2563eb); color: white; padding: 14px 28px; border: none; border-radius: 12px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 10px; font-size: 15px; box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);"
        @onclick='() => ShowStatementModal("BalanceSheet")'>
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="3" y1="9" x2="21" y2="9"></line>
            <line x1="9" y1="21" x2="9" y2="9"></line>
        </svg>
        Balance Sheet
    </button>
    <button style="background: linear-gradient(135deg, #059669, #047857); color: white; padding: 14px 28px; border: none; border-radius: 12px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 10px; font-size: 15px; box-shadow: 0 4px 12px rgba(5, 150, 105, 0.3);"
        @onclick='() => ShowStatementModal("CashFlow")'>
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <line x1="12" y1="1" x2="12" y2="23"></line>
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
        </svg>
        Cash Flow Statement
    </button>
    <button style="background: #f3f4f6; color: #374151; padding: 14px 28px; border: none; border-radius: 12px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 10px; font-size: 15px;"
        @onclick="LoadStatements">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M23 4v6h-6M1 20v-6h6M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"></path>
        </svg>
        Refresh
    </button>
</div>

<!-- Summary Cards -->
<div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 24px;">
    <div style="background: linear-gradient(135deg, #ede9fe, #ddd6fe); border-radius: 16px; padding: 24px; border: 2px solid #c4b5fd;">
        <div style="font-size: 13px; color: #5b21b6; font-weight: 600; margin-bottom: 8px; text-transform: uppercase;">📈 Income Statements</div>
        <div style="font-size: 32px; font-weight: 700; color: #5b21b6;">@statements.Count(s => s.StatementType == "IncomeStatement")</div>
        <div style="font-size: 12px; color: #7c3aed; margin-top: 4px;">Revenue vs Expenses analysis</div>
    </div>
    <div style="background: linear-gradient(135deg, #dbeafe, #bfdbfe); border-radius: 16px; padding: 24px; border: 2px solid #93c5fd;">
        <div style="font-size: 13px; color: #1e40af; font-weight: 600; margin-bottom: 8px; text-transform: uppercase;">📊 Balance Sheets</div>
        <div style="font-size: 32px; font-weight: 700; color: #1e40af;">@statements.Count(s => s.StatementType == "BalanceSheet")</div>
        <div style="font-size: 12px; color: #3b82f6; margin-top: 4px;">Assets = Liabilities + Equity</div>
    </div>
    <div style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); border-radius: 16px; padding: 24px; border: 2px solid #6ee7b7;">
        <div style="font-size: 13px; color: #065f46; font-weight: 600; margin-bottom: 8px; text-transform: uppercase;">💵 Cash Flow Statements</div>
        <div style="font-size: 32px; font-weight: 700; color: #065f46;">@statements.Count(s => s.StatementType == "CashFlow")</div>
        <div style="font-size: 12px; color: #059669; margin-top: 4px;">Operating, Investing, Financing</div>
    </div>
</div>

<!-- Alerts -->
@if (!string.IsNullOrEmpty(successMessage))
{
    <div style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); border: 1px solid #6ee7b7; color: #065f46; padding: 16px 20px; border-radius: 12px; margin-bottom: 20px; display: flex; align-items: center; gap: 12px;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
        <span style="font-weight: 500;">@successMessage</span>
        <button @onclick="() => successMessage = string.Empty"
            style="margin-left: auto; background: none; border: none; color: #065f46; cursor: pointer; font-size: 18px;">×</button>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div style="background: #fee2e2; border: 1px solid #fca5a5; color: #dc2626; padding: 16px 20px; border-radius: 12px; margin-bottom: 20px;">
        <span style="font-weight: 500;">@errorMessage</span>
    </div>
}

<!-- Financial Statements Table -->
<div style="background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden;">
    <div style="background: linear-gradient(135deg, #7c3aed, #8b5cf6); color: white; padding: 20px 24px;">
        <h4 style="margin: 0; font-weight: 600; font-size: 18px;">📄 Generated Statements</h4>
        <p style="margin: 6px 0 0 0; opacity: 0.9; font-size: 13px;">Click "View" to see detailed financial data</p>
    </div>

    <div style="padding: 24px;">
        @if (isLoading)
        {
            <div style="text-align: center; padding: 60px;">
                <div style="width: 48px; height: 48px; border: 4px solid #e5e7eb; border-top-color: #7c3aed; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto;"></div>
                <p style="margin-top: 16px; color: #6b7280;">Loading statements...</p>
            </div>
        }
        else if (!statements.Any())
        {
            <div style="text-align: center; padding: 60px;">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5" style="margin: 0 auto 16px;">
                    <path d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <p style="color: #6b7280; font-size: 16px;">No financial statements generated yet</p>
                <p style="color: #9ca3af; font-size: 14px;">Click the buttons above to generate statements from real transaction data</p>
            </div>
        }
        else
        {
            <table style="width: 100%; border-collapse: separate; border-spacing: 0;">
                <thead>
                    <tr style="background: linear-gradient(135deg, #f8fafc, #f1f5f9);">
                        <th style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">Type</th>
                        <th style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">Period</th>
                        <th style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">Generated</th>
                        <th style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">By</th>
                        <th style="padding: 14px 16px; text-align: center; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var stmt in statements)
                    {
                        <tr style="border-bottom: 1px solid #f1f5f9;">
                            <td style="padding: 16px;">
                                <span style="background: @GetTypeBg(stmt.StatementType); color: @GetTypeColor(stmt.StatementType); padding: 6px 12px; border-radius: 8px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
                                    @GetTypeIcon(stmt.StatementType) @FormatStatementType(stmt.StatementType)
                                </span>
                            </td>
                            <td style="padding: 16px; font-weight: 500; color: #1e293b;">
                                @stmt.PeriodStart.ToString("MMM dd, yyyy") - @stmt.PeriodEnd.ToString("MMM dd, yyyy")
                            </td>
                            <td style="padding: 16px; font-size: 14px; color: #64748b;">@stmt.GeneratedAt.ToString("MMM dd, yyyy HH:mm")</td>
                            <td style="padding: 16px; font-weight: 500;">@stmt.GeneratedBy</td>
                            <td style="padding: 16px; text-align: center;">
                                <button style="background: linear-gradient(135deg, #7c3aed, #8b5cf6); color: white; border: none; padding: 8px 16px; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer;"
                                    @onclick="() => ViewStatement(stmt)">
                                    👁️ View Details
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<!-- Generate Statement Modal -->
@if (showStatementModal)
{
    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000;">
        <div style="background: white; border-radius: 16px; padding: 32px; max-width: 500px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
            <h2 style="font-size: 20px; font-weight: 700; margin: 0 0 8px 0; display: flex; align-items: center; gap: 10px;">
                📄 Generate @FormatStatementType(selectedStatement)
            </h2>
            <p style="color: #6b7280; font-size: 14px; margin: 0 0 24px 0;">Data will be calculated from real transactions</p>

            <div style="margin-bottom: 16px;">
                <label style="display: block; font-weight: 600; color: #374151; margin-bottom: 8px;">Period Start</label>
                <input type="date" @bind="genStmt_PeriodStart"
                    style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;" />
            </div>

            <div style="margin-bottom: 24px;">
                <label style="display: block; font-weight: 600; color: #374151; margin-bottom: 8px;">Period End</label>
                <input type="date" @bind="genStmt_PeriodEnd"
                    style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;" />
            </div>

            <div style="display: flex; gap: 12px; justify-content: flex-end;">
                <button style="background: #e5e7eb; color: #374151; padding: 12px 24px; border: none; border-radius: 10px; font-weight: 600; cursor: pointer;"
                    @onclick="CloseStatementModal">Cancel</button>
                <button style="background: linear-gradient(135deg, #7c3aed, #8b5cf6); color: white; padding: 12px 24px; border: none; border-radius: 10px; font-weight: 600; cursor: pointer;"
                    @onclick="GenerateStatement" disabled="@isGenerating">
                    @if (isGenerating)
                    {
                        <span>Generating...</span>
                    }
                    else
                    {
                        <span>Generate Statement</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- View Statement Detail Modal -->
@if (showViewModal && viewingStatement != null)
{
    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000; overflow-y: auto; padding: 20px;">
        <div style="background: white; border-radius: 16px; max-width: 900px; width: 95%; max-height: 90vh; overflow-y: auto; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
            <!-- Modal Header -->
            <div style="background: @GetStatementHeaderColor(viewingStatement.StatementType); padding: 24px; border-radius: 16px 16px 0 0; position: sticky; top: 0;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <h2 style="font-size: 22px; font-weight: 700; color: white; margin: 0;">@FormatStatementType(viewingStatement.StatementType)</h2>
                        <p style="color: rgba(255,255,255,0.9); margin: 4px 0 0 0; font-size: 14px;">
                            Period: @viewingStatement.PeriodStart.ToString("MMM dd, yyyy") - @viewingStatement.PeriodEnd.ToString("MMM dd, yyyy")
                        </p>
                    </div>
                    <button @onclick="CloseViewModal" style="background: rgba(255,255,255,0.2); border: none; color: white; width: 40px; height: 40px; border-radius: 50%; font-size: 20px; cursor: pointer;">×</button>
                </div>
            </div>

            <!-- Modal Body -->
            <div style="padding: 24px;">
                @if (viewingStatement.StatementType == "IncomeStatement")
                {
                    <!-- Income Statement Display -->
                    <div style="margin-bottom: 24px;">
                        <h3 style="font-size: 18px; font-weight: 700; color: #5b21b6; margin: 0 0 16px 0; display: flex; align-items: center; gap: 8px;">
                            📈 Revenue
                        </h3>
                        <div style="background: #f8fafc; border-radius: 12px; overflow: hidden;">
                            <table style="width: 100%; border-collapse: collapse;">
                                <thead>
                                    <tr style="background: #ede9fe;">
                                        <th style="padding: 12px 16px; text-align: left; font-weight: 600; color: #5b21b6;">Account</th>
                                        <th style="padding: 12px 16px; text-align: right; font-weight: 600; color: #5b21b6;">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in GetRevenueItems())
                                    {
                                        <tr style="border-bottom: 1px solid #e5e7eb;">
                                            <td style="padding: 12px 16px; color: #374151;">@item.Account</td>
                                            <td style="padding: 12px 16px; text-align: right; color: #059669; font-weight: 600;">₱@item.Amount.ToString("N2")</td>
                                        </tr>
                                    }
                                    <tr style="background: #d1fae5;">
                                        <td style="padding: 12px 16px; font-weight: 700; color: #047857;">Total Revenue</td>
                                        <td style="padding: 12px 16px; text-align: right; font-weight: 700; color: #047857;">₱@GetTotalRevenue().ToString("N2")</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div style="margin-bottom: 24px;">
                        <h3 style="font-size: 18px; font-weight: 700; color: #dc2626; margin: 0 0 16px 0; display: flex; align-items: center; gap: 8px;">
                            📉 Expenses
                        </h3>
                        <div style="background: #f8fafc; border-radius: 12px; overflow: hidden;">
                            <table style="width: 100%; border-collapse: collapse;">
                                <thead>
                                    <tr style="background: #fee2e2;">
                                        <th style="padding: 12px 16px; text-align: left; font-weight: 600; color: #dc2626;">Account</th>
                                        <th style="padding: 12px 16px; text-align: right; font-weight: 600; color: #dc2626;">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in GetExpenseItems())
                                    {
                                        <tr style="border-bottom: 1px solid #e5e7eb;">
                                            <td style="padding: 12px 16px; color: #374151;">@item.Account</td>
                                            <td style="padding: 12px 16px; text-align: right; color: #dc2626; font-weight: 600;">₱@item.Amount.ToString("N2")</td>
                                        </tr>
                                    }
                                    <tr style="background: #fee2e2;">
                                        <td style="padding: 12px 16px; font-weight: 700; color: #dc2626;">Total Expenses</td>
                                        <td style="padding: 12px 16px; text-align: right; font-weight: 700; color: #dc2626;">₱@GetTotalExpenses().ToString("N2")</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div style="background: @(GetNetIncome() >= 0 ? "linear-gradient(135deg, #d1fae5, #a7f3d0)" : "linear-gradient(135deg, #fee2e2, #fecaca)"); border-radius: 12px; padding: 24px; text-align: center;">
                        <div style="font-size: 14px; font-weight: 600; color: @(GetNetIncome() >= 0 ? "#047857" : "#dc2626"); margin-bottom: 8px;">NET INCOME</div>
                        <div style="font-size: 36px; font-weight: 700; color: @(GetNetIncome() >= 0 ? "#047857" : "#dc2626");">₱@GetNetIncome().ToString("N2")</div>
                        <div style="font-size: 14px; color: @(GetNetIncome() >= 0 ? "#059669" : "#ef4444"); margin-top: 8px;">@(GetNetIncome() >= 0 ? "✓ Profit" : "⚠ Loss")</div>
                    </div>
                }
                else if (viewingStatement.StatementType == "BalanceSheet")
                {
                    <!-- Balance Sheet Display -->
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
                        <!-- Assets -->
                        <div>
                            <h3 style="font-size: 18px; font-weight: 700; color: #1e40af; margin: 0 0 16px 0;">🏦 Assets</h3>
                            <div style="background: #f8fafc; border-radius: 12px; overflow: hidden;">
                                <table style="width: 100%; border-collapse: collapse;">
                                    <thead>
                                        <tr style="background: #dbeafe;">
                                            <th style="padding: 10px 12px; text-align: left; font-weight: 600; color: #1e40af; font-size: 13px;">Account</th>
                                            <th style="padding: 10px 12px; text-align: right; font-weight: 600; color: #1e40af; font-size: 13px;">Balance</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in GetAssetItems())
                                        {
                                            <tr style="border-bottom: 1px solid #e5e7eb;">
                                                <td style="padding: 10px 12px; color: #374151; font-size: 13px;">@item.Account</td>
                                                <td style="padding: 10px 12px; text-align: right; color: #1e40af; font-weight: 600; font-size: 13px;">₱@item.Balance.ToString("N2")</td>
                                            </tr>
                                        }
                                        <tr style="background: #dbeafe;">
                                            <td style="padding: 12px; font-weight: 700; color: #1e40af;">Total Assets</td>
                                            <td style="padding: 12px; text-align: right; font-weight: 700; color: #1e40af;">₱@GetTotalAssets().ToString("N2")</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Liabilities & Equity -->
                        <div>
                            <h3 style="font-size: 18px; font-weight: 700; color: #dc2626; margin: 0 0 16px 0;">📋 Liabilities</h3>
                            <div style="background: #f8fafc; border-radius: 12px; overflow: hidden; margin-bottom: 16px;">
                                <table style="width: 100%; border-collapse: collapse;">
                                    <thead>
                                        <tr style="background: #fee2e2;">
                                            <th style="padding: 10px 12px; text-align: left; font-weight: 600; color: #dc2626; font-size: 13px;">Account</th>
                                            <th style="padding: 10px 12px; text-align: right; font-weight: 600; color: #dc2626; font-size: 13px;">Balance</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in GetLiabilityItems())
                                        {
                                            <tr style="border-bottom: 1px solid #e5e7eb;">
                                                <td style="padding: 10px 12px; color: #374151; font-size: 13px;">@item.Account</td>
                                                <td style="padding: 10px 12px; text-align: right; color: #dc2626; font-weight: 600; font-size: 13px;">₱@item.Balance.ToString("N2")</td>
                                            </tr>
                                        }
                                        <tr style="background: #fee2e2;">
                                            <td style="padding: 12px; font-weight: 700; color: #dc2626;">Total Liabilities</td>
                                            <td style="padding: 12px; text-align: right; font-weight: 700; color: #dc2626;">₱@GetTotalLiabilities().ToString("N2")</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <h3 style="font-size: 18px; font-weight: 700; color: #059669; margin: 0 0 16px 0;">💰 Equity</h3>
                            <div style="background: #f8fafc; border-radius: 12px; overflow: hidden;">
                                <table style="width: 100%; border-collapse: collapse;">
                                    <tbody>
                                        @foreach (var item in GetEquityItems())
                                        {
                                            <tr style="border-bottom: 1px solid #e5e7eb;">
                                                <td style="padding: 10px 12px; color: #374151; font-size: 13px;">@item.Account</td>
                                                <td style="padding: 10px 12px; text-align: right; color: #059669; font-weight: 600; font-size: 13px;">₱@item.Balance.ToString("N2")</td>
                                            </tr>
                                        }
                                        <tr style="background: #d1fae5;">
                                            <td style="padding: 12px; font-weight: 700; color: #047857;">Total Equity</td>
                                            <td style="padding: 12px; text-align: right; font-weight: 700; color: #047857;">₱@GetTotalEquity().ToString("N2")</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div style="background: @(IsBalanceSheetBalanced() ? "#d1fae5" : "#fee2e2"); border-radius: 12px; padding: 16px; margin-top: 24px; text-align: center;">
                        <span style="font-weight: 700; color: @(IsBalanceSheetBalanced() ? "#047857" : "#dc2626");">
                            @(IsBalanceSheetBalanced() ? "✓ Balance Sheet is BALANCED" : "⚠ Balance Sheet is NOT BALANCED") 
                            (Assets: ₱@GetTotalAssets().ToString("N2") = Liabilities: ₱@GetTotalLiabilities().ToString("N2") + Equity: ₱@GetTotalEquity().ToString("N2"))
                        </span>
                    </div>
                }
                else if (viewingStatement.StatementType == "CashFlow")
                {
                    <!-- Cash Flow Statement Display -->
                    <div style="margin-bottom: 24px;">
                        <h3 style="font-size: 18px; font-weight: 700; color: #059669; margin: 0 0 16px 0;">💼 Operating Activities</h3>
                        <div style="background: #f0fdf4; border-radius: 12px; padding: 20px;">
                            <div style="display: grid; gap: 12px;">
                                <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #d1fae5;">
                                    <span style="color: #374151;">Customer Deposits</span>
                                    <span style="font-weight: 600; color: #059669;">₱@GetCashFlowItem("CustomerDeposits").ToString("N2")</span>
                                </div>
                                <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #d1fae5;">
                                    <span style="color: #374151;">Customer Withdrawals</span>
                                    <span style="font-weight: 600; color: #dc2626;">₱@GetCashFlowItem("CustomerWithdrawals").ToString("N2")</span>
                                </div>
                                <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #d1fae5;">
                                    <span style="color: #374151;">Service Fees Collected</span>
                                    <span style="font-weight: 600; color: #059669;">₱@GetCashFlowItem("ServiceFees").ToString("N2")</span>
                                </div>
                                <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #d1fae5;">
                                    <span style="color: #374151;">Loan Payments Received</span>
                                    <span style="font-weight: 600; color: #059669;">₱@GetCashFlowItem("LoanPaymentsReceived").ToString("N2")</span>
                                </div>
                                <div style="display: flex; justify-content: space-between; padding: 12px; background: #d1fae5; border-radius: 8px; margin-top: 8px;">
                                    <span style="font-weight: 700; color: #047857;">Net Cash from Operating</span>
                                    <span style="font-weight: 700; color: #047857;">₱@GetNetCashFromOperating().ToString("N2")</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div style="margin-bottom: 24px;">
                        <h3 style="font-size: 18px; font-weight: 700; color: #dc2626; margin: 0 0 16px 0;">🏛️ Financing Activities</h3>
                        <div style="background: #fef2f2; border-radius: 12px; padding: 20px;">
                            <div style="display: grid; gap: 12px;">
                                <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #fee2e2;">
                                    <span style="color: #374151;">Loan Disbursements</span>
                                    <span style="font-weight: 600; color: #dc2626;">₱@GetCashFlowItem("LoanDisbursements").ToString("N2")</span>
                                </div>
                                <div style="display: flex; justify-content: space-between; padding: 12px; background: #fee2e2; border-radius: 8px; margin-top: 8px;">
                                    <span style="font-weight: 700; color: #dc2626;">Net Cash from Financing</span>
                                    <span style="font-weight: 700; color: #dc2626;">₱@GetNetCashFromFinancing().ToString("N2")</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div style="background: @(GetNetCashChange() >= 0 ? "linear-gradient(135deg, #d1fae5, #a7f3d0)" : "linear-gradient(135deg, #fee2e2, #fecaca)"); border-radius: 12px; padding: 24px; text-align: center;">
                        <div style="font-size: 14px; font-weight: 600; color: @(GetNetCashChange() >= 0 ? "#047857" : "#dc2626"); margin-bottom: 8px;">NET CHANGE IN CASH</div>
                        <div style="font-size: 36px; font-weight: 700; color: @(GetNetCashChange() >= 0 ? "#047857" : "#dc2626");">₱@GetNetCashChange().ToString("N2")</div>
                        <div style="font-size: 14px; color: @(GetNetCashChange() >= 0 ? "#059669" : "#ef4444"); margin-top: 8px;">@(GetNetCashChange() >= 0 ? "✓ Positive Cash Flow" : "⚠ Negative Cash Flow")</div>
                    </div>
                }
            </div>

            <!-- Modal Footer -->
            <div style="padding: 16px 24px; border-top: 1px solid #e5e7eb; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 13px; color: #6b7280;">Generated by @viewingStatement.GeneratedBy on @viewingStatement.GeneratedAt.ToString("MMM dd, yyyy HH:mm")</span>
                <button @onclick="CloseViewModal" style="background: #e5e7eb; color: #374151; padding: 10px 20px; border: none; border-radius: 8px; font-weight: 600; cursor: pointer;">Close</button>
            </div>
        </div>
    </div>
}

<style>
    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

@code {
    private List<FinanceBank.Models.FinancialStatement> statements = new();
    private bool showStatementModal = false;
    private bool showViewModal = false;
    private string selectedStatement = "";
    private DateTime genStmt_PeriodStart = DateTime.Today.AddMonths(-1);
    private DateTime genStmt_PeriodEnd = DateTime.Today;
    private bool isLoading = true;
    private bool isGenerating = false;
    private string successMessage = "";
    private string errorMessage = "";
    
    private FinanceBank.Models.FinancialStatement? viewingStatement;
    private JsonDocument? parsedData;

    protected override async Task OnInitializedAsync()
    {
        await LoadStatements();
    }

    private async Task LoadStatements()
    {
        isLoading = true;
        errorMessage = "";
        try
        {
            statements = await FinancialStatementService.GetAllAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading statements: {ex.Message}";
            statements = new List<FinanceBank.Models.FinancialStatement>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowStatementModal(string type)
    {
        selectedStatement = type;
        genStmt_PeriodStart = DateTime.Today.AddMonths(-1);
        genStmt_PeriodEnd = DateTime.Today;
        showStatementModal = true;
    }

    private void CloseStatementModal()
    {
        showStatementModal = false;
        selectedStatement = "";
    }

    private async Task GenerateStatement()
    {
        if (string.IsNullOrWhiteSpace(selectedStatement)) return;

        isGenerating = true;
        errorMessage = "";
        try
        {
            var currentUser = AuthService.CurrentUser ?? "Accountant";
            
            switch (selectedStatement)
            {
                case "IncomeStatement":
                    await FinancialStatementService.GenerateIncomeStatementAsync(genStmt_PeriodStart, genStmt_PeriodEnd, currentUser);
                    break;
                case "BalanceSheet":
                    await FinancialStatementService.GenerateBalanceSheetAsync(genStmt_PeriodEnd, currentUser);
                    break;
                case "CashFlow":
                    await FinancialStatementService.GenerateCashFlowAsync(genStmt_PeriodStart, genStmt_PeriodEnd, currentUser);
                    break;
            }

            await LoadStatements();
            CloseStatementModal();
            successMessage = $"✓ {FormatStatementType(selectedStatement)} generated successfully from real transaction data!";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error generating statement: {ex.Message}";
        }
        finally
        {
            isGenerating = false;
        }
    }

    private void ViewStatement(FinanceBank.Models.FinancialStatement stmt)
    {
        viewingStatement = stmt;
        try
        {
            if (!string.IsNullOrEmpty(stmt.StatementData))
            {
                parsedData = JsonDocument.Parse(stmt.StatementData);
            }
        }
        catch
        {
            parsedData = null;
        }
        showViewModal = true;
    }

    private void CloseViewModal()
    {
        showViewModal = false;
        viewingStatement = null;
        parsedData?.Dispose();
        parsedData = null;
    }

    // Helper methods for Income Statement
    private List<(string Account, decimal Amount)> GetRevenueItems()
    {
        var items = new List<(string Account, decimal Amount)>();
        if (parsedData == null) return items;
        try
        {
            if (parsedData.RootElement.TryGetProperty("Revenues", out var revenues))
            {
                foreach (var item in revenues.EnumerateArray())
                {
                    var account = item.GetProperty("Account").GetString() ?? "Unknown";
                    var amount = item.GetProperty("Amount").GetDecimal();
                    items.Add((account, amount));
                }
            }
        }
        catch { }
        return items;
    }

    private List<(string Account, decimal Amount)> GetExpenseItems()
    {
        var items = new List<(string Account, decimal Amount)>();
        if (parsedData == null) return items;
        try
        {
            if (parsedData.RootElement.TryGetProperty("Expenses", out var expenses))
            {
                foreach (var item in expenses.EnumerateArray())
                {
                    var account = item.GetProperty("Account").GetString() ?? "Unknown";
                    var amount = item.GetProperty("Amount").GetDecimal();
                    items.Add((account, amount));
                }
            }
        }
        catch { }
        return items;
    }

    private decimal GetTotalRevenue()
    {
        if (parsedData == null) return 0;
        try
        {
            if (parsedData.RootElement.TryGetProperty("TotalRevenue", out var val))
                return val.GetDecimal();
        }
        catch { }
        return 0;
    }

    private decimal GetTotalExpenses()
    {
        if (parsedData == null) return 0;
        try
        {
            if (parsedData.RootElement.TryGetProperty("TotalExpenses", out var val))
                return val.GetDecimal();
        }
        catch { }
        return 0;
    }

    private decimal GetNetIncome()
    {
        if (parsedData == null) return 0;
        try
        {
            if (parsedData.RootElement.TryGetProperty("NetIncome", out var val))
                return val.GetDecimal();
        }
        catch { }
        return 0;
    }

    // Helper methods for Balance Sheet
    private List<(string Account, decimal Balance)> GetAssetItems()
    {
        var items = new List<(string Account, decimal Balance)>();
        if (parsedData == null) return items;
        try
        {
            if (parsedData.RootElement.TryGetProperty("Assets", out var assets))
            {
                foreach (var item in assets.EnumerateArray())
                {
                    var account = item.GetProperty("Account").GetString() ?? "Unknown";
                    var balance = item.GetProperty("Balance").GetDecimal();
                    items.Add((account, balance));
                }
            }
        }
        catch { }
        return items;
    }

    private List<(string Account, decimal Balance)> GetLiabilityItems()
    {
        var items = new List<(string Account, decimal Balance)>();
        if (parsedData == null) return items;
        try
        {
            if (parsedData.RootElement.TryGetProperty("Liabilities", out var liabilities))
            {
                foreach (var item in liabilities.EnumerateArray())
                {
                    var account = item.GetProperty("Account").GetString() ?? "Unknown";
                    var balance = item.GetProperty("Balance").GetDecimal();
                    items.Add((account, balance));
                }
            }
        }
        catch { }
        return items;
    }

    private List<(string Account, decimal Balance)> GetEquityItems()
    {
        var items = new List<(string Account, decimal Balance)>();
        if (parsedData == null) return items;
        try
        {
            if (parsedData.RootElement.TryGetProperty("Equity", out var equity))
            {
                foreach (var item in equity.EnumerateArray())
                {
                    var account = item.GetProperty("Account").GetString() ?? "Unknown";
                    var balance = item.GetProperty("Balance").GetDecimal();
                    items.Add((account, balance));
                }
            }
            // Add Retained Earnings
            if (parsedData.RootElement.TryGetProperty("RetainedEarnings", out var re))
            {
                items.Add(("Retained Earnings", re.GetDecimal()));
            }
        }
        catch { }
        return items;
    }

    private decimal GetTotalAssets()
    {
        if (parsedData == null) return 0;
        try
        {
            if (parsedData.RootElement.TryGetProperty("TotalAssets", out var val))
                return val.GetDecimal();
        }
        catch { }
        return 0;
    }

    private decimal GetTotalLiabilities()
    {
        if (parsedData == null) return 0;
        try
        {
            if (parsedData.RootElement.TryGetProperty("TotalLiabilities", out var val))
                return val.GetDecimal();
        }
        catch { }
        return 0;
    }

    private decimal GetTotalEquity()
    {
        if (parsedData == null) return 0;
        try
        {
            if (parsedData.RootElement.TryGetProperty("TotalEquity", out var val))
                return val.GetDecimal();
        }
        catch { }
        return 0;
    }

    private bool IsBalanceSheetBalanced()
    {
        return Math.Abs(GetTotalAssets() - (GetTotalLiabilities() + GetTotalEquity())) < 0.01m;
    }

    // Helper methods for Cash Flow
    private decimal GetCashFlowItem(string itemName)
    {
        if (parsedData == null) return 0;
        try
        {
            if (parsedData.RootElement.TryGetProperty("OperatingActivities", out var opAct))
            {
                if (opAct.TryGetProperty(itemName, out var val))
                    return val.GetDecimal();
            }
            if (parsedData.RootElement.TryGetProperty("FinancingActivities", out var finAct))
            {
                if (finAct.TryGetProperty(itemName, out var val))
                    return val.GetDecimal();
            }
        }
        catch { }
        return 0;
    }

    private decimal GetNetCashFromOperating()
    {
        if (parsedData == null) return 0;
        try
        {
            if (parsedData.RootElement.TryGetProperty("OperatingActivities", out var opAct))
            {
                if (opAct.TryGetProperty("NetCashFromOperating", out var val))
                    return val.GetDecimal();
            }
        }
        catch { }
        return 0;
    }

    private decimal GetNetCashFromFinancing()
    {
        if (parsedData == null) return 0;
        try
        {
            if (parsedData.RootElement.TryGetProperty("FinancingActivities", out var finAct))
            {
                if (finAct.TryGetProperty("NetCashFromFinancing", out var val))
                    return val.GetDecimal();
            }
        }
        catch { }
        return 0;
    }

    private decimal GetNetCashChange()
    {
        if (parsedData == null) return 0;
        try
        {
            if (parsedData.RootElement.TryGetProperty("NetCashChange", out var val))
                return val.GetDecimal();
        }
        catch { }
        return 0;
    }

    // Formatting helpers
    private string FormatStatementType(string type) => type switch
    {
        "IncomeStatement" => "Income Statement",
        "BalanceSheet" => "Balance Sheet",
        "CashFlow" => "Cash Flow Statement",
        _ => type
    };

    private string GetTypeIcon(string type) => type switch
    {
        "IncomeStatement" => "📈",
        "BalanceSheet" => "📊",
        "CashFlow" => "💵",
        _ => "📄"
    };

    private string GetTypeColor(string type) => type switch
    {
        "IncomeStatement" => "#5b21b6",
        "BalanceSheet" => "#1e40af",
        "CashFlow" => "#065f46",
        _ => "#374151"
    };

    private string GetTypeBg(string type) => type switch
    {
        "IncomeStatement" => "#ede9fe",
        "BalanceSheet" => "#dbeafe",
        "CashFlow" => "#d1fae5",
        _ => "#f3f4f6"
    };

    private string GetStatementHeaderColor(string type) => type switch
    {
        "IncomeStatement" => "linear-gradient(135deg, #7c3aed, #6d28d9)",
        "BalanceSheet" => "linear-gradient(135deg, #3b82f6, #2563eb)",
        "CashFlow" => "linear-gradient(135deg, #059669, #047857)",
        _ => "linear-gradient(135deg, #6b7280, #4b5563)"
    };
}
