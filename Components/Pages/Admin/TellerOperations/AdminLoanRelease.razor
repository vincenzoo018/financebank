@page "/admin/teller-ops/loan-release"
@layout AdminLayout
@using FinanceBank.Models
@using FinanceBank.Services
@using Microsoft.EntityFrameworkCore
@inject LoanProcessService LoanService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject IDbContextFactory<BFASDbContext> DbFactory

<!-- Admin Notice -->
<div style="background: #dbeafe; border: 1px solid #3b82f6; border-radius: 12px; padding: 16px; margin-bottom: 24px;">
    <div style="display: flex; align-items: flex-start; gap: 12px;">
        <span style="font-size: 20px;">ℹ️</span>
        <div>
            <h4 style="margin: 0 0 4px; font-size: 14px; font-weight: 700; color: #1e40af;">SuperAdmin Loan Release Access</h4>
            <p style="margin: 0; font-size: 13px; color: #1e40af; opacity: 0.9;">You have direct authority to release loan funds. All admin releases are logged with full audit trail.</p>
        </div>
    </div>
</div>

<!-- Admin Reason Field -->
<div style="background: #f0fdf4; border: 2px solid #059669; border-radius: 12px; padding: 16px; margin-bottom: 24px;">
    <label style="font-size: 14px; font-weight: 700; display: block; margin-bottom: 8px; color: #065f46;">
        📋 Admin Action Reason (Required for Releases)
    </label>
    <textarea @bind="adminActionReason" 
              style="width: 100%; padding: 12px; border: 1px solid #86efac; border-radius: 8px; font-size: 14px; font-family: inherit; resize: vertical; min-height: 60px;" 
              placeholder="Document why you are releasing loans as admin (e.g., 'Teller unavailable - urgent release', 'Manager approval for expedited release')..."></textarea>
</div>

<div class="page-container" style="padding: 24px;">
    <!-- Page Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <div>
            <h2 style="margin: 0; color: #1f2937; font-weight: 700; font-size: 24px;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2" style="margin-right: 10px; vertical-align: middle;">
                    <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                    <path d="M12 9v6"></path>
                    <path d="M9 12h6"></path>
                </svg>
                Admin Release Approved Loans
            </h2>
            <p style="margin: 4px 0 0 0; color: #6b7280; font-size: 14px;">Disburse approved loan funds (Admin Authority)</p>
        </div>
        <button @onclick="OpenHistoryModal" 
                style="display: flex; align-items: center; gap: 8px; background: linear-gradient(135deg, #059669, #10b981); color: white; border: none; padding: 12px 20px; border-radius: 10px; cursor: pointer; font-weight: 600; font-size: 14px; box-shadow: 0 4px 12px rgba(5, 150, 105, 0.3); transition: all 0.2s;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            Release History
        </button>
    </div>

    <!-- Stats Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">
        <div style="background: linear-gradient(135deg, #f0fdf4, #dcfce7); border-radius: 12px; padding: 20px; border: 1px solid #bbf7d0;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 48px; height: 48px; background: #059669; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                </div>
                <div>
                    <p style="margin: 0; color: #059669; font-size: 12px; font-weight: 600; text-transform: uppercase;">Pending Release</p>
                    <p style="margin: 4px 0 0 0; font-size: 28px; font-weight: 700; color: #065f46;">@(approvedLoans?.Count ?? 0)</p>
                </div>
            </div>
        </div>
        <div style="background: linear-gradient(135deg, #eff6ff, #dbeafe); border-radius: 12px; padding: 20px; border: 1px solid #bfdbfe;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 48px; height: 48px; background: #3b82f6; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                        <path d="M12 2v20M2 12h20"></path>
                    </svg>
                </div>
                <div>
                    <p style="margin: 0; color: #3b82f6; font-size: 12px; font-weight: 600; text-transform: uppercase;">Total Amount</p>
                    <p style="margin: 4px 0 0 0; font-size: 24px; font-weight: 700; color: #1e40af;">₱@((approvedLoans?.Sum(a => a.ApprovedAmount ?? 0) ?? 0).ToString("N2"))</p>
                </div>
            </div>
        </div>
        <div style="background: linear-gradient(135deg, #fefce8, #fef9c3); border-radius: 12px; padding: 20px; border: 1px solid #fde047;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 48px; height: 48px; background: #eab308; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                    </svg>
                </div>
                <div>
                    <p style="margin: 0; color: #ca8a04; font-size: 12px; font-weight: 600; text-transform: uppercase;">Today's Releases</p>
                    <p style="margin: 4px 0 0 0; font-size: 28px; font-weight: 700; color: #854d0e;">@todayReleasesCount</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Alerts -->
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); border: 1px solid #6ee7b7; color: #065f46; padding: 16px 20px; border-radius: 12px; margin-bottom: 20px; display: flex; align-items: center; gap: 12px; box-shadow: 0 2px 8px rgba(16, 185, 129, 0.15);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <span style="font-weight: 500;">@successMessage</span>
            <button @onclick="() => successMessage = string.Empty" style="margin-left: auto; background: none; border: none; color: #065f46; cursor: pointer; font-size: 18px;">×</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div style="background: #fee2e2; border: 1px solid #fecaca; color: #991b1b; padding: 16px 20px; border-radius: 12px; margin-bottom: 20px; display: flex; align-items: center; gap: 12px;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="15" y1="9" x2="9" y2="15"></line>
                <line x1="9" y1="9" x2="15" y2="15"></line>
            </svg>
            <span style="font-weight: 500;">@errorMessage</span>
            <button @onclick="() => errorMessage = string.Empty" style="margin-left: auto; background: none; border: none; color: #991b1b; cursor: pointer; font-size: 18px;">×</button>
        </div>
    }

    <!-- Main Content Card -->
    <div style="background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden;">
        <div style="background: linear-gradient(135deg, #059669, #10b981); color: white; padding: 20px 24px;">
            <h4 style="margin: 0; font-weight: 600; font-size: 18px;">
                🔐 Loans Ready for Admin Release
            </h4>
            <p style="margin: 6px 0 0 0; opacity: 0.9; font-size: 13px;">Review and release approved loan funds with admin authority</p>
        </div>

        <div style="padding: 24px;">
            @if (isLoading)
            {
                <div style="text-align: center; padding: 60px;">
                    <div style="width: 48px; height: 48px; border: 4px solid #e5e7eb; border-top-color: #059669; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto;"></div>
                    <p style="margin-top: 16px; color: #6b7280; font-size: 15px;">Loading approved loans...</p>
                </div>
            }
            else if (approvedLoans == null || approvedLoans.Count == 0)
            {
                <div style="text-align: center; padding: 80px 20px; background: linear-gradient(135deg, #f9fafb, #f3f4f6); border-radius: 16px;">
                    <div style="width: 80px; height: 80px; background: #e5e7eb; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                    </div>
                    <h5 style="color: #4b5563; margin-top: 20px; font-size: 18px; font-weight: 600;">No Loans Pending Release</h5>
                    <p style="color: #9ca3af; font-size: 14px; margin-top: 8px;">All approved loans have been disbursed.</p>
                </div>
            }
            else
            {
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: separate; border-spacing: 0;">
                        <thead>
                            <tr style="background: linear-gradient(135deg, #f8fafc, #f1f5f9);">
                                <th style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">Approval ID</th>
                                <th style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">Customer</th>
                                <th style="padding: 14px 16px; text-align: right; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">Amount</th>
                                <th style="padding: 14px 16px; text-align: center; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">Rate</th>
                                <th style="padding: 14px 16px; text-align: center; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">Term</th>
                                <th style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">Approved By</th>
                                <th style="padding: 14px 16px; text-align: center; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var approval in approvedLoans)
                            {
                                var customer = approval.Assessment?.Application?.Account?.Customer;
                                <tr style="border-bottom: 1px solid #f1f5f9; transition: all 0.2s;" class="table-row-hover">
                                    <td style="padding: 16px;">
                                        <span style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); color: #065f46; padding: 6px 14px; border-radius: 20px; font-weight: 600; font-size: 13px; display: inline-block;">
                                            APV-@approval.ApprovalId
                                        </span>
                                    </td>
                                    <td style="padding: 16px;">
                                        <div style="font-weight: 600; color: #1e293b; font-size: 15px;">@(customer?.FullName ?? "N/A")</div>
                                        <div style="font-size: 12px; color: #64748b; margin-top: 2px;">@(approval.Assessment?.Application?.Account?.AccountNumber ?? "")</div>
                                    </td>
                                    <td style="padding: 16px; text-align: right;">
                                        <span style="font-weight: 700; color: #059669; font-size: 17px;">₱@(approval.ApprovedAmount?.ToString("N2") ?? "0.00")</span>
                                    </td>
                                    <td style="padding: 16px; text-align: center; color: #475569; font-weight: 500;">
                                        @(approval.ApprovedInterestRate?.ToString("N2") ?? "0")%
                                    </td>
                                    <td style="padding: 16px; text-align: center; color: #475569; font-weight: 500;">
                                        @(approval.ApprovedTermMonths ?? 0) mo
                                    </td>
                                    <td style="padding: 16px;">
                                        <div style="font-weight: 500; color: #1e293b;">@approval.ApprovedBy</div>
                                        <div style="font-size: 12px; color: #94a3b8; margin-top: 2px;">@approval.ApprovalDate.ToString("MMM dd, yyyy")</div>
                                    </td>
                                    <td style="padding: 16px; text-align: center;">
                                        <button style="background: linear-gradient(135deg, #059669, #10b981); color: white; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 13px; box-shadow: 0 2px 8px rgba(5, 150, 105, 0.25); transition: all 0.2s;"
                                                @onclick="() => OpenReleaseModal(approval)">
                                            🔐 Admin Release
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@* Release Modal *@
@if (showReleaseModal && selectedApproval != null)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.6); display: flex; align-items: center; justify-content: center; z-index: 1000; backdrop-filter: blur(4px);" @onclick="CloseModal">
        <div style="background: white; border-radius: 20px; width: 90%; max-width: 700px; max-height: 90vh; overflow-y: auto; box-shadow: 0 25px 60px rgba(0,0,0,0.3);" @onclick:stopPropagation>
            <div style="background: linear-gradient(135deg, #059669, #10b981); color: white; padding: 24px 28px; border-radius: 20px 20px 0 0;">
                <h4 style="margin: 0; font-weight: 700; font-size: 20px;">🔐 Admin Release Loan Funds</h4>
                <p style="margin: 6px 0 0 0; opacity: 0.9; font-size: 14px;">Approval ID: APV-@selectedApproval.ApprovalId</p>
            </div>

            <div style="padding: 28px;">
                <!-- Admin Authority Notice -->
                <div style="background: #dbeafe; border: 1px solid #3b82f6; border-radius: 12px; padding: 16px; margin-bottom: 20px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <span style="font-size: 20px;">🔓</span>
                        <div>
                            <h5 style="margin: 0 0 4px; font-size: 14px; font-weight: 700; color: #1e40af;">Direct Admin Authorization</h5>
                            <p style="margin: 0; font-size: 13px; color: #1e40af; opacity: 0.9;">This release will be logged with admin audit trail.</p>
                        </div>
                    </div>
                </div>

                @if (currentStep == 1)
                {
                    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
                        <div style="width: 36px; height: 36px; background: linear-gradient(135deg, #059669, #10b981); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 16px;">1</div>
                        <h5 style="margin: 0; color: #1e293b; font-size: 18px; font-weight: 600;">Loan Details</h5>
                    </div>

                    <div style="background: linear-gradient(135deg, #f0fdf4, #dcfce7); border-radius: 16px; padding: 24px; margin-bottom: 24px; border: 1px solid #bbf7d0;">
                        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;">
                            <div>
                                <label style="font-size: 11px; color: #059669; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">Approved Amount</label>
                                <p style="margin: 6px 0 0 0; font-weight: 800; color: #065f46; font-size: 26px;">₱@(selectedApproval.ApprovedAmount?.ToString("N2"))</p>
                            </div>
                            <div>
                                <label style="font-size: 11px; color: #059669; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">Interest Rate</label>
                                <p style="margin: 6px 0 0 0; font-weight: 700; color: #065f46; font-size: 20px;">@(selectedApproval.ApprovedInterestRate?.ToString("N2"))% p.a.</p>
                            </div>
                            <div>
                                <label style="font-size: 11px; color: #059669; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">Loan Term</label>
                                <p style="margin: 6px 0 0 0; font-weight: 700; color: #065f46; font-size: 20px;">@(selectedApproval.ApprovedTermMonths) months</p>
                            </div>
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                        <div>
                            <label style="font-size: 14px; font-weight: 600; color: #374151; display: block; margin-bottom: 8px;">Disbursed To <span style="color: #ef4444;">*</span></label>
                            <input type="text" @bind="disbursedTo" placeholder="Customer full name" 
                                   style="width: 100%; padding: 14px 16px; border: 2px solid #e5e7eb; border-radius: 10px; font-size: 15px; transition: border-color 0.2s;" />
                        </div>
                        <div>
                            <label style="font-size: 14px; font-weight: 600; color: #374151; display: block; margin-bottom: 8px;">Contract Reference</label>
                            <input type="text" @bind="contractReference" placeholder="Auto-generated if blank" 
                                   style="width: 100%; padding: 14px 16px; border: 2px solid #e5e7eb; border-radius: 10px; font-size: 15px;" />
                        </div>
                    </div>

                    <!-- Admin Reason Display -->
                    @if (!string.IsNullOrWhiteSpace(adminActionReason))
                    {
                        <div style="background: #dbeafe; border: 1px solid #3b82f6; border-radius: 8px; padding: 16px; margin-bottom: 20px;">
                            <p style="margin: 0 0 8px; color: #1e40af; font-size: 12px; font-weight: 600;">📋 ADMIN REASON FOR RELEASE</p>
                            <p style="margin: 0; color: #1e40af; font-size: 14px;">@adminActionReason</p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(selectedApproval.SpecialConditions))
                    {
                        <div style="background: #fef3c7; padding: 16px 20px; border-radius: 10px; border: 1px solid #fde68a;">
                            <label style="font-size: 11px; color: #92400e; text-transform: uppercase; font-weight: 700;">Special Conditions</label>
                            <p style="margin: 8px 0 0 0; color: #78350f; font-size: 14px;">@selectedApproval.SpecialConditions</p>
                        </div>
                    }
                }
                else
                {
                    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
                        <div style="width: 36px; height: 36px; background: linear-gradient(135deg, #059669, #10b981); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 16px;">2</div>
                        <h5 style="margin: 0; color: #1e293b; font-size: 18px; font-weight: 600;">Contract Preview (Admin Release)</h5>
                    </div>

                    <div style="background: white; border: 2px solid #e2e8f0; border-radius: 16px; padding: 28px;">
                        <div style="text-align: center; margin-bottom: 24px; padding-bottom: 20px; border-bottom: 2px solid #e2e8f0;">
                            <h3 style="margin: 0; color: #1e293b; font-size: 22px; font-weight: 700;">LOAN AGREEMENT CONTRACT</h3>
                            <p style="color: #64748b; margin: 8px 0 0 0; font-size: 14px;">FinanceBank Corporation - Admin Release</p>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px;">
                            <div style="background: #f8fafc; padding: 12px 16px; border-radius: 8px;">
                                <span style="font-size: 12px; color: #64748b;">Contract Reference</span><br/>
                                <span style="font-weight: 700; color: #059669; font-size: 15px;">@(string.IsNullOrEmpty(contractReference) ? $"ADMIN-REL-{DateTime.Now:yyyyMMddHHmmss}" : contractReference)</span>
                            </div>
                            <div style="background: #f8fafc; padding: 12px 16px; border-radius: 8px;">
                                <span style="font-size: 12px; color: #64748b;">Contract Date</span><br/>
                                <span style="font-weight: 600; color: #1e293b; font-size: 15px;">@DateTime.Now.ToString("MMMM dd, yyyy")</span>
                            </div>
                        </div>

                        <div style="background: linear-gradient(135deg, #f0fdf4, #dcfce7); padding: 16px 20px; border-radius: 10px; border: 1px solid #bbf7d0;">
                            <h6 style="margin: 0 0 12px 0; color: #059669; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px;">Loan Terms</h6>
                            <table style="width: 100%; font-size: 14px;">
                                <tr><td style="padding: 6px 0; color: #475569;"><strong>Principal:</strong></td><td style="text-align: right; font-weight: 600; color: #1e293b;">₱@(selectedApproval.ApprovedAmount?.ToString("N2"))</td></tr>
                                <tr><td style="padding: 6px 0; color: #475569;"><strong>Interest:</strong></td><td style="text-align: right; font-weight: 600; color: #1e293b;">@(selectedApproval.ApprovedInterestRate?.ToString("N2"))% p.a.</td></tr>
                                <tr><td style="padding: 6px 0; color: #475569;"><strong>Term:</strong></td><td style="text-align: right; font-weight: 600; color: #1e293b;">@(selectedApproval.ApprovedTermMonths) months</td></tr>
                                <tr><td style="padding: 6px 0; color: #475569;"><strong>Monthly:</strong></td><td style="text-align: right; font-weight: 600; color: #1e293b;">₱@CalculateMonthlyPayment().ToString("N2")</td></tr>
                                <tr style="border-top: 2px solid #bbf7d0;"><td style="padding: 12px 0; color: #065f46;"><strong>Total Payable:</strong></td><td style="text-align: right; font-weight: 800; color: #059669; font-size: 18px;">₱@((CalculateMonthlyPayment() * selectedApproval.ApprovedTermMonths!.Value).ToString("N2"))</td></tr>
                            </table>
                        </div>
                    </div>
                }

                <div style="display: flex; gap: 12px; justify-content: flex-end; padding-top: 24px; border-top: 1px solid #e5e7eb; margin-top: 24px;">
                    <button style="background: #f1f5f9; color: #475569; border: none; padding: 12px 24px; border-radius: 10px; cursor: pointer; font-weight: 600; font-size: 14px;"
                            @onclick="CloseModal" disabled="@isProcessing">Cancel</button>
                    
                    @if (currentStep == 1)
                    {
                        <button style="background: linear-gradient(135deg, #059669, #10b981); color: white; border: none; padding: 12px 28px; border-radius: 10px; cursor: pointer; font-weight: 700; font-size: 14px; box-shadow: 0 4px 12px rgba(5, 150, 105, 0.3);"
                                @onclick="GoToStep2" disabled="@(string.IsNullOrWhiteSpace(disbursedTo))">Continue →</button>
                    }
                    else
                    {
                        <button style="background: #64748b; color: white; border: none; padding: 12px 24px; border-radius: 10px; cursor: pointer; font-weight: 600; font-size: 14px;"
                                @onclick="() => currentStep = 1" disabled="@isProcessing">← Back</button>
                        <button style="background: linear-gradient(135deg, #059669, #10b981); color: white; border: none; padding: 12px 28px; border-radius: 10px; cursor: pointer; font-weight: 700; font-size: 14px; box-shadow: 0 4px 12px rgba(5, 150, 105, 0.3);"
                                @onclick="ReleaseFunds" disabled="@isProcessing">@(isProcessing ? "Processing..." : "🔐 Admin Release Funds")</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@* History Modal *@
@if (showHistoryModal)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.6); display: flex; align-items: center; justify-content: center; z-index: 1000; backdrop-filter: blur(4px);" @onclick="CloseHistoryModal">
        <div style="background: white; border-radius: 20px; width: 95%; max-width: 1100px; max-height: 90vh; overflow: hidden; box-shadow: 0 25px 60px rgba(0,0,0,0.3); display: flex; flex-direction: column;" @onclick:stopPropagation>
            <div style="background: linear-gradient(135deg, #059669, #10b981); color: white; padding: 24px 28px; display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h4 style="margin: 0; font-weight: 700; font-size: 20px;">
                        Release History & Invoices (Admin View)
                    </h4>
                    <p style="margin: 6px 0 0 0; opacity: 0.9; font-size: 14px;">View all loan releases and download invoices</p>
                </div>
                <button @onclick="CloseHistoryModal" style="background: rgba(255,255,255,0.2); border: none; color: white; width: 36px; height: 36px; border-radius: 50%; cursor: pointer; font-size: 20px;">×</button>
            </div>

            <div style="padding: 24px; overflow-y: auto; flex: 1;">
                @if (isLoadingHistory)
                {
                    <div style="text-align: center; padding: 60px;">
                        <div style="width: 48px; height: 48px; border: 4px solid #e5e7eb; border-top-color: #059669; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto;"></div>
                        <p style="margin-top: 16px; color: #6b7280;">Loading release history...</p>
                    </div>
                }
                else if (releaseInvoices == null || releaseInvoices.Count == 0)
                {
                    <div style="text-align: center; padding: 60px;">
                        <h5 style="color: #475569; margin-top: 20px; font-weight: 600;">No Release History</h5>
                        <p style="color: #94a3b8; font-size: 14px;">No loan releases have been recorded yet.</p>
                    </div>
                }
                else
                {
                    <div style="overflow-x: auto;">
                        <table style="width: 100%; border-collapse: separate; border-spacing: 0; font-size: 14px;">
                            <thead>
                                <tr style="background: linear-gradient(135deg, #f8fafc, #f1f5f9);">
                                    <th style="padding: 14px 12px; text-align: left; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">Invoice #</th>
                                    <th style="padding: 14px 12px; text-align: left; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">Customer</th>
                                    <th style="padding: 14px 12px; text-align: right; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">Amount</th>
                                    <th style="padding: 14px 12px; text-align: left; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">Processed By</th>
                                    <th style="padding: 14px 12px; text-align: left; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var invoice in releaseInvoices)
                                {
                                    <tr style="border-bottom: 1px solid #f1f5f9;" class="table-row-hover">
                                        <td style="padding: 14px 12px;">
                                            <span style="background: linear-gradient(135deg, #dbeafe, #bfdbfe); color: #1e40af; padding: 4px 10px; border-radius: 6px; font-weight: 600; font-size: 12px;">@invoice.InvoiceNumber</span>
                                        </td>
                                        <td style="padding: 14px 12px; font-weight: 500; color: #1e293b;">@invoice.CustomerName</td>
                                        <td style="padding: 14px 12px; text-align: right; font-weight: 700; color: #059669; font-size: 15px;">₱@invoice.PrincipalAmount.ToString("N2")</td>
                                        <td style="padding: 14px 12px; color: #475569;">@invoice.ProcessedBy</td>
                                        <td style="padding: 14px 12px; color: #64748b;">@invoice.InvoiceDate.ToString("MMM dd, yyyy hh:mm tt")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
}

<style>
    @@keyframes spin { to { transform: rotate(360deg); } }
    .table-row-hover:hover { background: #f8fafc !important; }
    input:focus { outline: none; border-color: #059669 !important; box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.1); }
    button:hover:not(:disabled) { transform: translateY(-1px); }
    button:disabled { opacity: 0.6; cursor: not-allowed; }
</style>

@code {
    // Admin-specific fields
    private string adminActionReason = "";

    private List<LoanApproval>? approvedLoans;
    private List<LoanInvoice>? releaseInvoices;
    private LoanApproval? selectedApproval;
    
    private bool showReleaseModal = false;
    private bool showHistoryModal = false;
    private bool isLoading = true;
    private bool isLoadingHistory = false;
    private bool isProcessing = false;
    
    private int currentStep = 1;
    private int todayReleasesCount = 0;
    
    private string disbursedTo = "";
    private string contractReference = "";
    private string successMessage = "";
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        // Verify admin role
        if (!AuthService.IsAuthenticated || !AuthService.HasRole(AuthService.Roles.SuperAdmin))
        {
            return;
        }

        Console.WriteLine($"[ADMIN ACTION] Loan Release page accessed by SuperAdmin-{AuthService.CurrentUser}");

        await LoadApprovedLoans();
        await LoadTodayReleasesCount();
    }

    private async Task LoadApprovedLoans()
    {
        isLoading = true;
        try { approvedLoans = await LoanService.GetApprovedLoansForReleaseAsync(); }
        catch (Exception ex) { errorMessage = $"Error loading approved loans: {ex.Message}"; }
        finally { isLoading = false; }
    }

    private async Task LoadTodayReleasesCount()
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var today = DateTime.Today;
            todayReleasesCount = await db.Set<LoanInvoice>().Where(i => i.InvoiceType == "RELEASE" && i.InvoiceDate.Date == today).CountAsync();
        }
        catch { todayReleasesCount = 0; }
    }

    private async Task LoadReleaseHistory()
    {
        isLoadingHistory = true;
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            releaseInvoices = await db.Set<LoanInvoice>().Where(i => i.InvoiceType == "RELEASE").OrderByDescending(i => i.InvoiceDate).Take(100).ToListAsync();
        }
        catch (Exception ex) { errorMessage = $"Error loading history: {ex.Message}"; }
        finally { isLoadingHistory = false; }
    }

    private void OpenReleaseModal(LoanApproval approval)
    {
        selectedApproval = approval;
        disbursedTo = approval.Assessment?.Application?.Account?.Customer?.FullName ?? "";
        contractReference = "";
        currentStep = 1;
        showReleaseModal = true;
    }

    private void CloseModal() { showReleaseModal = false; selectedApproval = null; currentStep = 1; }

    private async Task OpenHistoryModal() { showHistoryModal = true; await LoadReleaseHistory(); }

    private void CloseHistoryModal() { showHistoryModal = false; releaseInvoices = null; }

    private void GoToStep2() { if (!string.IsNullOrWhiteSpace(disbursedTo)) currentStep = 2; }

    private decimal CalculateMonthlyPayment()
    {
        if (selectedApproval?.ApprovedAmount == null || selectedApproval?.ApprovedInterestRate == null || selectedApproval?.ApprovedTermMonths == null) return 0;
        var principal = selectedApproval.ApprovedAmount.Value;
        var rate = selectedApproval.ApprovedInterestRate.Value / 100 / 12;
        var term = selectedApproval.ApprovedTermMonths.Value;
        if (rate == 0) return principal / term;
        return principal * (rate * (decimal)Math.Pow(1 + (double)rate, term)) / ((decimal)Math.Pow(1 + (double)rate, term) - 1);
    }

    private async Task ReleaseFunds()
    {
        if (selectedApproval == null) return;
        
        // Validate admin reason
        if (string.IsNullOrWhiteSpace(adminActionReason))
        {
            errorMessage = "⚠️ Admin action reason is required for loan releases.";
            return;
        }
        
        isProcessing = true;
        errorMessage = "";
        try
        {
            // Log admin action
            Console.WriteLine($"[ADMIN ACTION] Releasing loan APV-{selectedApproval.ApprovalId} - Amount: ₱{selectedApproval.ApprovedAmount:N2}, Admin: SuperAdmin-{AuthService.CurrentUser}, Reason: {adminActionReason}");

            var result = await LoanService.TellerReleaseFundsAsync(
                selectedApproval.ApprovalId, 
                selectedApproval.ApplicationId, 
                selectedApproval.AccountId, 
                selectedApproval.ApprovedAmount ?? 0, 
                $"{disbursedTo} [ADMIN: {AuthService.CurrentUser}] Reason: {adminActionReason}", 
                $"SuperAdmin-{AuthService.CurrentUser}", 
                string.IsNullOrEmpty(contractReference) ? $"ADMIN-REL-{DateTime.Now:yyyyMMddHHmmss}" : contractReference
            );
            
            var loan = result.Item1;
            var disbursal = result.Item2;
            
            successMessage = $"✓ Loan {loan.LoanNumber} has been released by Admin! ₱{disbursal.DisbursalAmount:N2} has been credited to the customer's account.";
            Console.WriteLine($"[ADMIN ACTION] Loan {loan.LoanNumber} released by SuperAdmin-{AuthService.CurrentUser}");
            
            CloseModal();
            await LoadApprovedLoans();
            await LoadTodayReleasesCount();
        }
        catch (Exception ex) 
        { 
            Console.WriteLine($"[ADMIN ERROR] Loan release failed - {ex.Message}");
            errorMessage = $"Error releasing funds: {ex.Message}"; 
        }
        finally { isProcessing = false; }
    }
}
