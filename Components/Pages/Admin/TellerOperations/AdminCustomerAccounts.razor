@page "/admin/teller-ops/accounts"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@inject AuthService AuthService
@inject CustomerAccountService CustomerAccountService
@inject CustomerTransactionService CustomerTransactionService
@inject NavigationManager Navigation

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #5F6F52 0%, #2F3E2A 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
            <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
            </svg>
        </div>
        <div>
            <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Customer Accounts</h1>
            <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">View and manage customer accounts</p>
        </div>
    </div>
</div>

<!-- Admin Access Notice -->
<div style="background: #E8F0E8; border: 2px solid #5F6F52; border-radius: 12px; padding: 16px; margin-bottom: 20px;">
    <p style="margin: 0; color: #2F3E2A; font-weight: 600; display: flex; align-items: center; gap: 8px;">
        <span style="font-size: 20px;">ℹ️</span>
        <strong>SuperAdmin Teller Operations Access</strong> - Full customer account visibility with override capabilities
    </p>
</div>

<!-- Search & Filter -->
<div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb; margin-bottom: 20px; display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end;">
    <div style="flex: 1 1 250px;">
        <label style="display:block; font-size:12px; font-weight:600; color:#374151; margin-bottom:4px;">Search Account</label>
        <input type="text" class="form-control" @bind="searchQuery" @oninput="FilterAccounts" placeholder="Account number or customer name..." />
    </div>
    <div style="flex: 1 1 200px;">
        <label style="display:block; font-size:12px; font-weight:600; color:#374151; margin-bottom:4px;">Account Status</label>
        <select class="form-control" @bind="selectedStatus">
            <option value="">All</option>
            <option value="Active">Active</option>
            <option value="Inactive">Inactive</option>
        </select>
    </div>
    <div style="flex: 0 0 auto; display:flex; gap:8px;">
        <button class="btn" style="background:#5F6F52; color:white; padding:8px 16px; border-radius:8px; font-size:14px; font-weight:600;" @onclick="ReloadAccounts">🔄 Refresh</button>
    </div>
</div>

<!-- Summary Stats -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 24px;">
    <div style="background: linear-gradient(135deg, #D4E6D4, #BCC9A6); border-radius: 12px; padding: 16px; border: 1px solid #A9B388;">
        <div style="font-size: 12px; color: #2F3E2A; font-weight: 600;">TOTAL ACCOUNTS</div>
        <div style="font-size: 24px; font-weight: 700; color: #2F3E2A;">@accounts.Count</div>
    </div>
    <div style="background: linear-gradient(135deg, #F0F2EC, #DDE6D5); border-radius: 12px; padding: 16px; border: 1px solid #BCC9A6;">
        <div style="font-size: 12px; color: #2F3E2A; font-weight: 600;">ACTIVE</div>
        <div style="font-size: 24px; font-weight: 700; color: #5F6F52;">@accounts.Count(a => a.IsActive)</div>
    </div>
    <div style="background: linear-gradient(135deg, #F5E8E8, #E8D5D5); border-radius: 12px; padding: 16px; border: 1px solid #D4B5B5;">
        <div style="font-size: 12px; color: #7A2E2E; font-weight: 600;">INACTIVE</div>
        <div style="font-size: 24px; font-weight: 700; color: #9B3A3A;">@accounts.Count(a => !a.IsActive)</div>
    </div>
    <div style="background: linear-gradient(135deg, #E5D9B6, #D4C9A8); border-radius: 12px; padding: 16px; border: 1px solid #C4B8A0;">
        <div style="font-size: 12px; color: #6B4423; font-weight: 600;">TOTAL BALANCE</div>
        <div style="font-size: 24px; font-weight: 700; color: #8B5A2B;">₱@accounts.Sum(a => a.Balance).ToString("N0")</div>
    </div>
</div>

<!-- Accounts Table -->
<div style="background:white; border-radius:16px; border:1px solid #e5e7eb; overflow:hidden;">
    <table style="width:100%; border-collapse:collapse;">
        <thead>
            <tr style="background:#f9fafb; border-bottom:1px solid #e5e7eb;">
                <th style="padding:12px; text-align:left; font-size:12px; color:#6b7280;">ACCOUNT NUMBER</th>
                <th style="padding:12px; text-align:left; font-size:12px; color:#6b7280;">CUSTOMER NAME</th>
                <th style="padding:12px; text-align:left; font-size:12px; color:#6b7280;">BALANCE</th>
                <th style="padding:12px; text-align:left; font-size:12px; color:#6b7280;">AVAILABLE</th>
                <th style="padding:12px; text-align:left; font-size:12px; color:#6b7280;">STATUS</th>
                <th style="padding:12px; text-align:left; font-size:12px; color:#6b7280;">CREATED</th>
                <th style="padding:12px; text-align:center; font-size:12px; color:#6b7280;">ACTIONS</th>
            </tr>
        </thead>
        <tbody>
            @if (filteredAccounts.Any())
            {
                @foreach (var account in filteredAccounts)
                {
                    <tr style="border-bottom:1px solid #e5e7eb;">
                        <td style="padding:12px; font-size:13px; color:#111827; font-weight:600;">@account.AccountNumber</td>
                        <td style="padding:12px; font-size:13px; color:#4b5563;">@account.Customer?.FullName</td>
                        <td style="padding:12px; font-size:13px; color:#111827; font-weight:600;">₱@account.Balance.ToString("N2")</td>
                        <td style="padding:12px; font-size:13px; color:#5F6F52; font-weight:600;">₱@account.AvailableBalance.ToString("N2")</td>
                        <td style="padding:12px;">
                            <span style="display:inline-flex; align-items:center; padding:4px 10px; border-radius:999px; font-size:12px; font-weight:600; background:@(account.IsActive ? "#D4E6D4" : "#fee2e2"); color:@(account.IsActive ? "#2F3E2A" : "#b91c1c");">
                                @(account.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td style="padding:12px; font-size:13px; color:#6b7280;">@account.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td style="padding:12px; text-align:center;">
                            <button class="btn" style="background:#1f2937; color:white; padding:6px 12px; font-size:12px; border-radius:6px; margin-right:4px;" @onclick="() => ViewAccountDetails(account)">View</button>
                            <button class="btn" style="background:#5F6F52; color:white; padding:6px 12px; font-size:12px; border-radius:6px;" @onclick="() => QuickDeposit(account)">Deposit</button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" style="padding:24px; text-align:center; font-size:14px; color:#6b7280;">No accounts found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Account Details Modal -->
@if (showDetailsModal && selectedAccount != null)
{
    <div @onclick="CloseDetailsModal" style="position:fixed; inset:0; background:rgba(0,0,0,0.5); display:flex; align-items:center; justify-content:center; z-index:1000; padding:20px;">
        <div @onclick:stopPropagation style="background:white; border-radius:16px; max-width:700px; width:100%; max-height:80vh; overflow-y:auto; box-shadow:0 20px 60px rgba(0,0,0,0.3);">
            <div style="padding:20px 24px; border-bottom:1px solid #e5e7eb; display:flex; justify-content:space-between; align-items:center; background: linear-gradient(135deg, #5F6F52, #2F3E2A); border-radius: 16px 16px 0 0;">
                <h2 style="font-size:20px; font-weight:700; color:white; margin:0;">👑 Admin: Account Details</h2>
                <button @onclick="CloseDetailsModal" style="background:rgba(255,255,255,0.2); border:none; font-size:22px; color:white; cursor:pointer; width:32px; height:32px; border-radius:8px;">×</button>
            </div>
            <div style="padding:20px 24px;">
                <!-- Account Info -->
                <div style="margin-bottom:24px;">
                    <h3 style="font-size:16px; font-weight:600; color:#111827; margin-bottom:12px;">Account Information</h3>
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                        <div>
                            <div style="font-size:12px; font-weight:600; color:#6b7280; margin-bottom:4px;">Account Number</div>
                            <div style="font-size:14px; color:#111827;">@selectedAccount.AccountNumber</div>
                        </div>
                        <div>
                            <div style="font-size:12px; font-weight:600; color:#6b7280; margin-bottom:4px;">Status</div>
                            <div style="font-size:14px; color:#111827;">@(selectedAccount.IsActive ? "Active" : "Inactive")</div>
                        </div>
                        <div>
                            <div style="font-size:12px; font-weight:600; color:#6b7280; margin-bottom:4px;">Created</div>
                            <div style="font-size:14px; color:#111827;">@selectedAccount.CreatedAt.ToString("yyyy-MM-dd")</div>
                        </div>
                    </div>
                </div>

                <!-- Customer Info -->
                <div style="margin-bottom:24px;">
                    <h3 style="font-size:16px; font-weight:600; color:#111827; margin-bottom:12px;">Customer Information</h3>
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                        <div>
                            <div style="font-size:12px; font-weight:600; color:#6b7280; margin-bottom:4px;">Full Name</div>
                            <div style="font-size:14px; color:#111827;">@selectedAccount.Customer?.FullName</div>
                        </div>
                        <div>
                            <div style="font-size:12px; font-weight:600; color:#6b7280; margin-bottom:4px;">Email</div>
                            <div style="font-size:14px; color:#111827;">@selectedAccount.Customer?.Email</div>
                        </div>
                        <div>
                            <div style="font-size:12px; font-weight:600; color:#6b7280; margin-bottom:4px;">Phone</div>
                            <div style="font-size:14px; color:#111827;">@selectedAccount.Customer?.PhoneNumber</div>
                        </div>
                    </div>
                </div>

                <!-- Balance Info -->
                <div style="margin-bottom:24px;">
                    <h3 style="font-size:16px; font-weight:600; color:#111827; margin-bottom:12px;">Balance Information</h3>
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                        <div>
                            <div style="font-size:12px; font-weight:600; color:#6b7280; margin-bottom:4px;">Current Balance</div>
                            <div style="font-size:18px; font-weight:700; color:#5F6F52;">₱@selectedAccount.Balance.ToString("N2")</div>
                        </div>
                        <div>
                            <div style="font-size:12px; font-weight:600; color:#6b7280; margin-bottom:4px;">Available Balance</div>
                            <div style="font-size:18px; font-weight:700; color:#0891b2;">₱@selectedAccount.AvailableBalance.ToString("N2")</div>
                        </div>
                    </div>
                </div>

                <!-- Admin Actions -->
                <div style="margin-bottom:24px; background:#f3e8ff; padding:16px; border-radius:12px; border:2px solid #c4b5fd;">
                    <h3 style="font-size:14px; font-weight:700; color:#7c3aed; margin-bottom:12px;">👑 Admin Quick Actions</h3>
                    <div style="display:flex; gap:8px; flex-wrap:wrap;">
                        <button style="padding:8px 16px; background:#5F6F52; color:white; border:none; border-radius:6px; font-size:13px; font-weight:600; cursor:pointer;" @onclick="() => QuickDeposit(selectedAccount)">💰 Quick Deposit</button>
                        <button style="padding:8px 16px; background:#dc2626; color:white; border:none; border-radius:6px; font-size:13px; font-weight:600; cursor:pointer;" @onclick="() => QuickWithdraw(selectedAccount)">💸 Quick Withdraw</button>
                        <button style="padding:8px 16px; background:#7c3aed; color:white; border:none; border-radius:6px; font-size:13px; font-weight:600; cursor:pointer;">📊 Full History</button>
                    </div>
                </div>

                <!-- Recent Transactions -->
                <div>
                    <h3 style="font-size:16px; font-weight:600; color:#111827; margin-bottom:12px;">Recent Transactions</h3>
                    @if (recentTransactions.Any())
                    {
                        <div style="border:1px solid #e5e7eb; border-radius:8px; overflow:hidden;">
                            <table style="width:100%; border-collapse:collapse;">
                                <thead>
                                    <tr style="background:#f9fafb; border-bottom:1px solid #e5e7eb;">
                                        <th style="padding:8px 12px; text-align:left; font-size:11px; color:#6b7280;">TYPE</th>
                                        <th style="padding:8px 12px; text-align:left; font-size:11px; color:#6b7280;">AMOUNT</th>
                                        <th style="padding:8px 12px; text-align:left; font-size:11px; color:#6b7280;">DATE</th>
                                        <th style="padding:8px 12px; text-align:left; font-size:11px; color:#6b7280;">BY</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var txn in recentTransactions.Take(5))
                                    {
                                        var isAdminTxn = txn.Description?.Contains("[ADMIN") ?? false;
                                        <tr style="border-bottom:1px solid #e5e7eb; @(isAdminTxn ? "background:#faf5ff;" : "")">
                                            <td style="padding:8px 12px; font-size:12px; color:#111827;">@txn.TransactionType</td>
                                            <td style="padding:8px 12px; font-size:12px; color:#111827; font-weight:600;">₱@txn.Amount.ToString("N2")</td>
                                            <td style="padding:8px 12px; font-size:12px; color:#6b7280;">@txn.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td style="padding:8px 12px; font-size:11px;">
                                                @if (isAdminTxn)
                                                {
                                                    <span style="background:#f3e8ff; color:#7c3aed; padding:2px 6px; border-radius:4px;">👑</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div style="padding:12px; text-align:center; font-size:12px; color:#6b7280;">No transactions yet.</div>
                    }
                </div>
            </div>
            <div style="padding:16px 24px; border-top:1px solid #e5e7eb; display:flex; justify-content:flex-end;">
                <button class="btn" style="background:#f3f4f6; color:#111827; padding:8px 16px; border-radius:8px; font-size:14px;" @onclick="CloseDetailsModal">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private List<CustomerAccount> accounts = new();
    private string searchQuery = "";
    private string selectedStatus = "";
    private bool showDetailsModal;
    private CustomerAccount? selectedAccount;
    private List<CustomerTransaction> recentTransactions = new();

    protected override async Task OnInitializedAsync()
    {
        // Verify admin access
        if (AuthService.CurrentRole != "SuperAdmin")
        {
            Navigation.NavigateTo("/admin");
            return;
        }

        await ReloadAccounts();
    }

    private async Task ReloadAccounts()
    {
        try
        {
            accounts = await CustomerAccountService.GetAllAsync();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error loading accounts: {ex.Message}");
            accounts = new List<CustomerAccount>();
        }
    }

    private void FilterAccounts(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
    }

    private IEnumerable<CustomerAccount> filteredAccounts => accounts
        .Where(a => string.IsNullOrEmpty(searchQuery) || 
                   a.AccountNumber.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                   a.Customer?.FullName?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) == true)
        .Where(a => string.IsNullOrEmpty(selectedStatus) || 
                   (selectedStatus == "Active" && a.IsActive) || 
                   (selectedStatus == "Inactive" && !a.IsActive));

    private async Task ViewAccountDetails(CustomerAccount account)
    {
        selectedAccount = account;
        
        // Load recent transactions for this account
        try
        {
            recentTransactions = await CustomerTransactionService.GetByAccountIdAsync(account.AccountId);
        }
        catch
        {
            recentTransactions = new List<CustomerTransaction>();
        }
        
        showDetailsModal = true;
    }

    private void CloseDetailsModal()
    {
        showDetailsModal = false;
        selectedAccount = null;
        recentTransactions = new List<CustomerTransaction>();
    }

    private void QuickDeposit(CustomerAccount account)
    {
        // Navigate to deposit page with account pre-filled
        Navigation.NavigateTo($"/admin/teller-ops/deposits?account={account.AccountNumber}");
    }

    private void QuickWithdraw(CustomerAccount account)
    {
        // Navigate to withdrawal page with account pre-filled
        Navigation.NavigateTo($"/admin/teller-ops/withdrawals?account={account.AccountNumber}");
    }
}
