    private void ShowConfirmation()
    {
        showError = true;
        errorMessage = "";
        successMessage = "";
        lastReceiptNumber = "";

        // Validation with admin reason requirement
        if (string.IsNullOrWhiteSpace(adminActionReason))
        {
            NotificationService.ShowError("Validation Error", "Admin action reason is required. Please document why you are processing this withdrawal.");
            return;
        }

        if (string.IsNullOrWhiteSpace(accountNumber))
        {
            NotificationService.ShowError("Validation Error", "Account number is required. Please enter a valid account number.");
            return;
        }

        if (string.IsNullOrWhiteSpace(customerName))
        {
            NotificationService.ShowError("Validation Error", "Invalid account number. Customer not found in the system.");
            return;
        }

        if (withdrawalAmount <= 0)
        {
            NotificationService.ShowError("Validation Error", "Withdrawal amount must be greater than ₱0.00");
            return;
        }

        if (withdrawalAmount > currentAccountBalance)
        {
            NotificationService.ShowError("Insufficient Balance", $"Available balance: ₱{currentAccountBalance:N2}. Cannot withdraw ₱{withdrawalAmount:N2}");
            return;
        }

        if (string.IsNullOrWhiteSpace(withdrawalMethod))
        {
            NotificationService.ShowError("Validation Error", "Please select a withdrawal method before proceeding.");
            return;
        }

        // Show confirmation modal (no PIN or password required for admin)
        showConfirmationModal = true;
        NotificationService.ShowInfo("Confirmation Required", $"Please review the withdrawal details for {customerName} - ₱{withdrawalAmount:N2}");
    }

    private void CancelConfirmation()
    {
        showConfirmationModal = false;
    }

    private async Task HandleWithdrawal()
    {
        showConfirmationModal = false;
        isLoading = true;
        NotificationService.ShowInfo("Processing", "Processing your withdrawal transaction...");

        try
        {
            // Log admin action
            Console.WriteLine($"[ADMIN ACTION] Processing withdrawal - Account: {accountNumber}, Amount: ₱{withdrawalAmount:N2}, Admin: SuperAdmin-{AuthService.CurrentUser}, Reason: {adminActionReason}");

            // Append admin audit info to notes
            var adminNotes = $"[ADMIN: {AuthService.CurrentUser}] Reason: {adminActionReason}\n{notes}";

            var (success, message, transaction, receiptNumber) = await TellerBankingService.ProcessWithdrawalAsync(
                accountNumber,
                withdrawalAmount,
                withdrawalMethod,
                referenceNumber,
                adminNotes
            );

            if (success)
            {
                lastReceiptNumber = receiptNumber;
                successMessage = $"✓ Admin withdrawal processed successfully. {message}";
                
                NotificationService.ShowSuccess("Withdrawal Successful", $"₱{withdrawalAmount:N2} withdrawn from {customerName}'s account. Receipt: {receiptNumber}");
                
                Console.WriteLine($"[ADMIN ACTION] Withdrawal completed - Receipt: {receiptNumber}, Admin: SuperAdmin-{AuthService.CurrentUser}");
                
                // Add to real-time transactions list
                todayTransactions.Insert(0, new TransactionRecord
                {
                    AccountNumber = accountNumber,
                    CustomerName = customerName,
                    Amount = withdrawalAmount,
                    Method = withdrawalMethod,
                    Time = DateTime.Now,
                    Reference = referenceNumber
                });
                
                await Task.Delay(2000);
                ResetForm();
            }
            else
            {
                errorMessage = message;
                NotificationService.ShowError("Withdrawal Failed", message);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ADMIN ERROR] Withdrawal failed - {ex.Message}");
            errorMessage = $"Error: {ex.Message}";
            NotificationService.ShowError("System Error", $"An error occurred: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

