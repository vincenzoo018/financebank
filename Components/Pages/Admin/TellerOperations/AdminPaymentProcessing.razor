@page "/admin/teller-ops/payment-processing"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@inject LoanPaymentService LoanPaymentService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject NotificationService NotificationService

<div style="padding: 24px; max-width: 1200px; margin: 0 auto;">
    <div style="background: linear-gradient(135deg, #5F6F52 0%, #2F3E2A 100%); border-radius: 16px; padding: 24px; margin-bottom: 24px; color: white;">
        <h1 style="font-size: 24px; font-weight: 700; margin: 0 0 4px 0;">💳 Loan Payment Processing</h1>
        <p style="font-size: 14px; opacity: 0.9; margin: 0;">Process loan payments with admin authority.</p>
    </div>

    <!-- Admin Access Notice -->
    <div style="background: #E8F0E8; border: 2px solid #5F6F52; border-radius: 12px; padding: 16px; margin-bottom: 20px;">
        <p style="margin: 0; color: #2F3E2A; font-weight: 600; display: flex; align-items: center; gap: 8px;">
            <span style="font-size: 20px;">ℹ️</span>
            <strong>SuperAdmin Teller Operations Access</strong> - Direct payment processing authority
        </p>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div style="background: #D4E6D4; border: 2px solid #5F6F52; border-radius: 12px; padding: 16px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
            <span style="color: #2F3E2A; font-weight: 600;">✓ @successMessage</span>
            <button @onclick="() => successMessage = null" style="background: none; border: none; color: #2F3E2A; cursor: pointer; font-size: 18px;">×</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div style="background: #fee2e2; border: 2px solid #ef4444; border-radius: 12px; padding: 16px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
            <span style="color: #dc2626; font-weight: 600;">⚠️ @errorMessage</span>
            <button @onclick="() => errorMessage = null" style="background: none; border: none; color: #dc2626; cursor: pointer; font-size: 18px;">×</button>
        </div>
    }

    <!-- Tabs -->
    <div style="background: white; border-radius: 16px; border: 1px solid #e5e7eb; overflow: hidden;">
        <div style="display: flex; border-bottom: 2px solid #e5e7eb;">
            <button @onclick="SetPendingTab"
                    style="flex: 1; padding: 16px; border: none; background: @(activeTab == "pending" ? "#5F6F52" : "transparent"); color: @(activeTab == "pending" ? "white" : "#374151"); font-weight: 600; cursor: pointer; font-size: 14px;">
                ⏳ Pending Payments
            </button>
            <button @onclick="SetOverdueTab"
                    style="flex: 1; padding: 16px; border: none; background: @(activeTab == "overdue" ? "#9B3A3A" : "transparent"); color: @(activeTab == "overdue" ? "white" : "#374151"); font-weight: 600; cursor: pointer; font-size: 14px;">
                ⚠️ Overdue Payments
            </button>
        </div>

        <div style="padding: 24px;">
            @if (activeTab == "pending")
            {
                @if (pendingPayments == null)
                {
                    <div style="text-align: center; padding: 40px;">
                        <div style="width: 40px; height: 40px; border: 4px solid #e5e7eb; border-top-color: #5F6F52; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto;"></div>
                        <p style="margin-top: 16px; color: #6b7280;">Loading pending payments...</p>
                    </div>
                }
                else if (pendingPayments.Count == 0)
                {
                    <div style="text-align: center; padding: 40px; background: #F0F2EC; border-radius: 12px;">
                        <p style="color: #5F6F52; font-weight: 600;">✓ No pending payments at this time.</p>
                    </div>
                }
                else
                {
                    <div style="overflow-x: auto;">
                        <table style="width: 100%; border-collapse: collapse;">
                            <thead>
                                <tr style="background: #f9fafb; border-bottom: 2px solid #e5e7eb;">
                                    <th style="padding: 12px; text-align: left; font-size: 11px; font-weight: 700; color: #6b7280; text-transform: uppercase;">Schedule ID</th>
                                    <th style="padding: 12px; text-align: left; font-size: 11px; font-weight: 700; color: #6b7280; text-transform: uppercase;">Loan Number</th>
                                    <th style="padding: 12px; text-align: left; font-size: 11px; font-weight: 700; color: #6b7280; text-transform: uppercase;">Payment #</th>
                                    <th style="padding: 12px; text-align: center; font-size: 11px; font-weight: 700; color: #6b7280; text-transform: uppercase;">Due Date</th>
                                    <th style="padding: 12px; text-align: right; font-size: 11px; font-weight: 700; color: #6b7280; text-transform: uppercase;">Min. Payment</th>
                                    <th style="padding: 12px; text-align: right; font-size: 11px; font-weight: 700; color: #6b7280; text-transform: uppercase;">Principal</th>
                                    <th style="padding: 12px; text-align: right; font-size: 11px; font-weight: 700; color: #6b7280; text-transform: uppercase;">Interest</th>
                                    <th style="padding: 12px; text-align: center; font-size: 11px; font-weight: 700; color: #6b7280; text-transform: uppercase;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var payment in pendingPayments)
                                {
                                    <tr style="border-bottom: 1px solid #e5e7eb;">
                                        <td style="padding: 12px;">
                                            <span style="background: #5F6F52; color: white; padding: 4px 8px; border-radius: 6px; font-size: 12px; font-weight: 600;">SCH-@payment.ScheduleId</span>
                                        </td>
                                        <td style="padding: 12px; font-size: 13px; font-weight: 600;">@payment.Loan?.LoanNumber</td>
                                        <td style="padding: 12px; font-size: 13px; color: #374151;">#@payment.PaymentNumber</td>
                                        <td style="padding: 12px; text-align: center; font-size: 13px;">@payment.DueDate.ToString("yyyy-MM-dd")</td>
                                        <td style="padding: 12px; text-align: right; font-size: 14px; font-weight: 700; color: #5F6F52;">₱@payment.MinimumPayment.ToString("N2")</td>
                                        <td style="padding: 12px; text-align: right; font-size: 13px; color: #6b7280;">₱@payment.PrincipalAmount.ToString("N2")</td>
                                        <td style="padding: 12px; text-align: right; font-size: 13px; color: #6b7280;">₱@payment.InterestAmount.ToString("N2")</td>
                                        <td style="padding: 12px; text-align: center;">
                                            <button @onclick="() => ShowPaymentForm(payment)"
                                                    style="background: #5F6F52; color: white; border: none; padding: 8px 16px; border-radius: 6px; font-weight: 600; cursor: pointer; font-size: 12px;">
                                                ✓ Pay
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
            else
            {
                @if (overduePayments == null)
                {
                    <div style="text-align: center; padding: 40px;">
                        <div style="width: 40px; height: 40px; border: 4px solid #e5e7eb; border-top-color: #dc2626; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto;"></div>
                        <p style="margin-top: 16px; color: #6b7280;">Loading overdue payments...</p>
                    </div>
                }
                else if (overduePayments.Count == 0)
                {
                    <div style="text-align: center; padding: 40px; background: #F0F2EC; border-radius: 12px;">
                        <p style="color: #5F6F52; font-weight: 600;">✓ No overdue payments at this time.</p>
                    </div>
                }
                else
                {
                    <div style="overflow-x: auto;">
                        <table style="width: 100%; border-collapse: collapse;">
                            <thead>
                                <tr style="background: #fee2e2; border-bottom: 2px solid #ef4444;">
                                    <th style="padding: 12px; text-align: left; font-size: 11px; font-weight: 700; color: #991b1b; text-transform: uppercase;">Schedule ID</th>
                                    <th style="padding: 12px; text-align: left; font-size: 11px; font-weight: 700; color: #991b1b; text-transform: uppercase;">Loan Number</th>
                                    <th style="padding: 12px; text-align: left; font-size: 11px; font-weight: 700; color: #991b1b; text-transform: uppercase;">Payment #</th>
                                    <th style="padding: 12px; text-align: center; font-size: 11px; font-weight: 700; color: #991b1b; text-transform: uppercase;">Due Date</th>
                                    <th style="padding: 12px; text-align: center; font-size: 11px; font-weight: 700; color: #991b1b; text-transform: uppercase;">Days Overdue</th>
                                    <th style="padding: 12px; text-align: right; font-size: 11px; font-weight: 700; color: #991b1b; text-transform: uppercase;">Penalty</th>
                                    <th style="padding: 12px; text-align: right; font-size: 11px; font-weight: 700; color: #991b1b; text-transform: uppercase;">Total Due</th>
                                    <th style="padding: 12px; text-align: center; font-size: 11px; font-weight: 700; color: #991b1b; text-transform: uppercase;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var payment in overduePayments)
                                {
                                    <tr style="border-bottom: 1px solid #fecaca; background: #fff5f5;">
                                        <td style="padding: 12px;">
                                            <span style="background: #dc2626; color: white; padding: 4px 8px; border-radius: 6px; font-size: 12px; font-weight: 600;">SCH-@payment.ScheduleId</span>
                                        </td>
                                        <td style="padding: 12px; font-size: 13px; font-weight: 600;">@payment.Loan?.LoanNumber</td>
                                        <td style="padding: 12px; font-size: 13px; color: #374151;">#@payment.PaymentNumber</td>
                                        <td style="padding: 12px; text-align: center; font-size: 13px;">@payment.DueDate.ToString("yyyy-MM-dd")</td>
                                        <td style="padding: 12px; text-align: center;">
                                            <span style="background: #dc2626; color: white; padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: 600;">@payment.DaysOverdue days</span>
                                        </td>
                                        <td style="padding: 12px; text-align: right; font-size: 13px; font-weight: 600; color: #dc2626;">₱@payment.Penalty.ToString("N2")</td>
                                        <td style="padding: 12px; text-align: right; font-size: 14px; font-weight: 700; color: #dc2626;">₱@((payment.MinimumPayment + payment.Penalty).ToString("N2"))</td>
                                        <td style="padding: 12px; text-align: center;">
                                            <button @onclick="() => ShowPaymentForm(payment)"
                                                    style="background: #dc2626; color: white; border: none; padding: 8px 16px; border-radius: 6px; font-weight: 600; cursor: pointer; font-size: 12px;">
                                                ⚠️ Collect
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    </div>

    <!-- Payment Form -->
    @if (selectedSchedule != null)
    {
        <div style="background: white; border-radius: 16px; border: 2px solid #5F6F52; padding: 24px; margin-top: 24px;">
            <h3 style="font-size: 18px; font-weight: 700; color: #5F6F52; margin-bottom: 20px;">Process Payment</h3>
            
            <!-- Admin Reason -->
            <div style="margin-bottom: 16px;">
                <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #7c3aed;">
                    👑 Admin Override Reason <span style="color: #dc2626;">*</span>
                </label>
                <textarea @bind="adminReason" rows="2" 
                          placeholder="Provide reason for admin payment processing (e.g., 'Direct collection request', 'Customer service recovery', etc.)..."
                          style="width: 100%; padding: 12px; border: 2px solid #5F6F52; border-radius: 8px; font-size: 14px; resize: vertical;"></textarea>
                <span style="font-size: 12px; color: #6b7280;">Required: Document why this payment is being processed by admin</span>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <div>
                    <label style="display: block; font-weight: 600; margin-bottom: 8px;">Payment Amount (₱) <span style="color: #dc2626;">*</span></label>
                    <input type="number" @bind="paymentAmount" step="0.01"
                           style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;" />
                    <span style="font-size: 12px; color: #6b7280;">Minimum: ₱@selectedSchedule.MinimumPayment.ToString("N2")</span>
                </div>
                <div>
                    <label style="display: block; font-weight: 600; margin-bottom: 8px;">Payment Method</label>
                    <select @bind="paymentMethod" style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;">
                        <option value="Bank Transfer">Bank Transfer</option>
                        <option value="Check">Check</option>
                        <option value="Cash">Cash</option>
                        <option value="Online Banking">Online Banking</option>
                    </select>
                </div>
            </div>

            <div style="margin-top: 16px;">
                <label style="display: block; font-weight: 600; margin-bottom: 8px;">Reference Number</label>
                <input type="text" @bind="paymentReference" placeholder="e.g., CHK-001"
                       style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;" />
            </div>

            <div style="display: flex; gap: 12px; margin-top: 20px;">
                <button @onclick="CancelPayment" 
                        style="flex: 1; background: #f3f4f6; color: #374151; border: none; padding: 14px; border-radius: 8px; font-weight: 600; cursor: pointer;">
                    Cancel
                </button>
                <button @onclick="ProcessPaymentAsync" disabled="@isProcessing"
                        style="flex: 1; background: #5F6F52; color: white; border: none; padding: 14px; border-radius: 8px; font-weight: 600; cursor: pointer;">
                    @(isProcessing ? "Processing..." : "💰 Process Payment")
                </button>
            </div>
        </div>
    }

    <!-- Payment Confirmation -->
    @if (paymentConfirmation != null)
    {
        <div style="background: white; border-radius: 16px; border: 2px solid #5F6F52; padding: 24px; margin-top: 24px;">
            <h3 style="font-size: 18px; font-weight: 700; color: #5F6F52; margin-bottom: 20px;">✓ Payment Confirmation</h3>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <div style="display: grid; gap: 8px;">
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: #6b7280;">Amount Paid</span>
                        <span style="font-weight: 700; color: #5F6F52;">₱@paymentConfirmation.PaymentAmount.ToString("N2")</span>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: #6b7280;">Method</span>
                        <span style="font-weight: 600;">@paymentConfirmation.PaymentMethod</span>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: #6b7280;">Date</span>
                        <span style="font-weight: 600;">@paymentConfirmation.PaymentDate.ToString("yyyy-MM-dd HH:mm")</span>
                    </div>
                </div>
                <div style="display: grid; gap: 8px;">
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: #6b7280;">Reference</span>
                        <span style="background: #5F6F52; color: white; padding: 2px 8px; border-radius: 4px; font-size: 12px; font-weight: 600;">@paymentConfirmation.Reference</span>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: #6b7280;">Processed By</span>
                        <span style="font-weight: 600;">@paymentConfirmation.ProcessedBy</span>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: #6b7280;">Status</span>
                        <span style="background: #5F6F52; color: white; padding: 2px 8px; border-radius: 4px; font-size: 12px; font-weight: 600;">PROCESSED</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    @@keyframes spin { to { transform: rotate(360deg); } }
</style>

@code {
    private List<LoanPaymentSchedule>? pendingPayments;
    private List<LoanPaymentSchedule>? overduePayments;
    private string activeTab = "pending";
    private LoanPaymentSchedule? selectedSchedule;
    private decimal paymentAmount;
    private string? paymentMethod = "Bank Transfer";
    private string? paymentReference;
    private string adminReason = "";
    private LoanPayment? paymentConfirmation;
    private string? successMessage;
    private string? errorMessage;
    private bool isProcessing = false;

    protected override async Task OnInitializedAsync()
    {
        // Verify admin access
        if (AuthService.CurrentRole != "SuperAdmin")
        {
            Navigation.NavigateTo("/admin");
            return;
        }

        await LoadPaymentsAsync();
    }

    private async Task LoadPaymentsAsync()
    {
        try
        {
            // Load all pending and overdue payments (not filtered by loanId for admin view)
            pendingPayments = await LoanPaymentService.GetUpcomingPaymentsAsync(loanId: 1);
            overduePayments = await LoanPaymentService.GetOverduePaymentsAsync(loanId: 1);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading payments: {ex.Message}";
            Console.WriteLine($"[ADMIN ERROR] Load payments error: {ex.Message}");
        }
    }

    private void ShowPaymentForm(LoanPaymentSchedule schedule)
    {
        selectedSchedule = schedule;
        paymentAmount = schedule.MinimumPayment;
        paymentReference = $"ADMIN-REF-{DateTime.Now:yyyyMMddHHmmss}";
        adminReason = "";
        paymentConfirmation = null;
    }

    private async Task ProcessPaymentAsync()
    {
        // Validate admin reason
        if (string.IsNullOrWhiteSpace(adminReason))
        {
            NotificationService.ShowError("Validation Error", "Please provide an admin override reason for this payment.");
            return;
        }

        if (selectedSchedule == null)
            return;

        if (paymentAmount <= 0)
        {
            NotificationService.ShowError("Validation Error", "Payment amount must be greater than zero.");
            return;
        }

        isProcessing = true;
        errorMessage = null;
        NotificationService.ShowInfo("Processing", "Processing loan payment...");

        try
        {
            var adminUsername = AuthService.CurrentUser ?? "Admin";
            
            Console.WriteLine($"[ADMIN ACTION] Payment processed by {adminUsername}");
            Console.WriteLine($"[ADMIN ACTION] Schedule: {selectedSchedule.ScheduleId}, Amount: ₱{paymentAmount:N2}");
            Console.WriteLine($"[ADMIN ACTION] Reason: {adminReason}");

            paymentConfirmation = await LoanPaymentService.ProcessPaymentAsync(
                scheduleId: selectedSchedule.ScheduleId,
                amount: paymentAmount,
                method: paymentMethod ?? "",
                processedBy: $"Admin-{adminUsername}"
            );

            successMessage = "Payment processed successfully by admin!";
            NotificationService.ShowSuccess("Payment Successful", $"₱{paymentAmount:N2} payment has been processed successfully!");
            selectedSchedule = null;
            adminReason = "";
            await LoadPaymentsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error processing payment: {ex.Message}";
            NotificationService.ShowError("Payment Failed", $"Error processing payment: {ex.Message}");
            Console.WriteLine($"[ADMIN ERROR] Payment processing error: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void CancelPayment()
    {
        selectedSchedule = null;
        adminReason = "";
    }

    private void SetPendingTab()
    {
        activeTab = "pending";
    }

    private void SetOverdueTab()
    {
        activeTab = "overdue";
    }
}
