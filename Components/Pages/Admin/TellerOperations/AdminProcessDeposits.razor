    private void ShowConfirmation()
    {
        showError = true;
        errorMessage = "";
        successMessage = "";

        // Validation with admin reason requirement
        if (string.IsNullOrWhiteSpace(adminActionReason))
        {
            NotificationService.ShowError("Validation Error", "Admin action reason is required. Please document why you are processing this deposit.");
            return;
        }

        if (string.IsNullOrWhiteSpace(accountNumber))
        {
            NotificationService.ShowError("Validation Error", "Account number is required. Please enter a valid account number.");
            return;
        }

        if (string.IsNullOrWhiteSpace(customerName))
        {
            NotificationService.ShowError("Validation Error", "Invalid account number. Customer not found in the system.");
            return;
        }

        if (depositAmount <= 0)
        {
            NotificationService.ShowError("Validation Error", "Deposit amount must be greater than ₱0.00");
            return;
        }

        if (string.IsNullOrWhiteSpace(depositMethod))
        {
            NotificationService.ShowError("Validation Error", "Please select a deposit method before proceeding.");
            return;
        }

        // Show confirmation modal (no PIN required for admin)
        showConfirmationModal = true;
        NotificationService.ShowInfo("Confirmation Required", $"Please review the deposit details for {customerName} - ₱{depositAmount:N2}");
    }

    private void CancelConfirmation()
    {
        showConfirmationModal = false;
    }

    private async Task HandleDeposit()
    {
        showConfirmationModal = false;
        lastReceiptNumber = "";

        isLoading = true;
        NotificationService.ShowInfo("Processing", "Processing your deposit transaction...");

        try
        {
            // Log admin action
            Console.WriteLine($"[ADMIN ACTION] Processing deposit - Account: {accountNumber}, Amount: ₱{depositAmount:N2}, Admin: SuperAdmin-{AuthService.CurrentUser}, Reason: {adminActionReason}");

            // Append admin audit info to notes
            var adminNotes = $"[ADMIN: {AuthService.CurrentUser}] Reason: {adminActionReason}\n{notes}";

            var (success, message, transaction, receiptNumber) = await TellerBankingService.ProcessDepositAsync(
                accountNumber,
                depositAmount,
                depositMethod,
                referenceNumber,
                adminNotes
            );

            if (success)
            {
                lastReceiptNumber = receiptNumber;
                successMessage = $"✓ Admin deposit processed successfully. {message}";
                
                NotificationService.ShowSuccess("Deposit Successful", $"₱{depositAmount:N2} deposited to {customerName}'s account. Receipt: {receiptNumber}");
                
                Console.WriteLine($"[ADMIN ACTION] Deposit completed - Receipt: {receiptNumber}, Admin: SuperAdmin-{AuthService.CurrentUser}");
                
                // Add to real-time transactions list
                todayTransactions.Insert(0, new TransactionRecord
                {
                    AccountNumber = accountNumber,
                    CustomerName = customerName,
                    Amount = depositAmount,
                    Method = depositMethod,
                    Date = DateTime.Now,
                    Reference = referenceNumber
                });
                
                await Task.Delay(2000);
                ResetForm();
            }
            else
            {
                errorMessage = message;
                NotificationService.ShowError("Deposit Failed", message);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ADMIN ERROR] Deposit failed - {ex.Message}");
            errorMessage = $"Error: {ex.Message}";
            NotificationService.ShowError("System Error", $"An error occurred: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

