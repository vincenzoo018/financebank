@page "/admin/teller-ops/deposits"
@layout AdminLayout
@inject AuthService AuthService
@inject TellerBankingService TellerBankingService
@inject NotificationService NotificationService
@using System.Collections.Generic
@using FinanceBank.Data
@using FinanceBank.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<BFASDbContext> DbContextFactory

<!-- Admin Notice -->
<div style="background: #E8F0E8; border: 1px solid #5F6F52; border-radius: 12px; padding: 16px; margin-bottom: 24px;">
    <div style="display: flex; align-items: flex-start; gap: 12px;">
        <span style="font-size: 20px;">ℹ️</span>
        <div>
            <h4 style="margin: 0 0 4px; font-size: 14px; font-weight: 700; color: #2F3E2A;">SuperAdmin Deposit Operations Access</h4>
            <p style="margin: 0; font-size: 13px; color: #2F3E2A; opacity: 0.9;">You have direct authority to process deposits without PIN verification. All admin transactions are logged with audit trail.</p>
        </div>
    </div>
</div>

<!-- Header Title Card -->
<div style="background: linear-gradient(135deg, rgba(95, 111, 82, 0.1), rgba(47, 62, 42, 0.15)); border: 1px solid rgba(95, 111, 82, 0.3); border-radius: 16px; padding: 32px; margin-bottom: 32px; color: #5F6F52;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
        <div>
            <h1 style="font-size: 28px; font-weight: 700; margin: 0;">Admin Process Deposits</h1>
            <p style="margin: 4px 0 0; opacity: 0.7; font-size: 14px;">Record customer cash deposits (Admin Authority)</p>
        </div>
    </div>
</div>

<!-- Admin Reason Field -->
<div style="background: #F0F2EC; border: 2px solid #5F6F52; border-radius: 12px; padding: 16px; margin-bottom: 24px;">
    <label style="font-size: 14px; font-weight: 700; display: block; margin-bottom: 8px; color: #2F3E2A;">
        📋 Admin Action Reason (Required)
    </label>
    <textarea @bind="adminActionReason" 
              style="width: 100%; padding: 12px; border: 1px solid #A9B388; border-radius: 8px; font-size: 14px; font-family: inherit; resize: vertical; min-height: 60px;" 
              placeholder="Document why you are processing this deposit as admin (e.g., 'Teller unavailable - customer urgent deposit', 'System maintenance deposit processing')..."></textarea>
    @if (showError && string.IsNullOrWhiteSpace(adminActionReason))
    {
        <span style="color: #dc2626; font-size: 12px; display: block; margin-top: 4px;">❌ Admin reason is required for all transactions</span>
    }
</div>

<!-- Deposit Form -->
<div style="background: white; border-radius: 16px; padding: 32px; border: 1px solid #e5e7eb; margin-bottom: 32px;">
    <h3 style="margin: 0 0 24px; font-size: 18px; font-weight: 700; color: #1f2937;">New Deposit Transaction (Admin)</h3>
    
    <form @onsubmit="ShowConfirmation" @onsubmit:preventDefault>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px;">
            <!-- Account Number -->
            <div>
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Account Number *</label>
                <input type="text" style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;" 
                       @bind="accountNumber" @oninput="OnAccountNumberChanged" placeholder="Enter account number..." />
                @if (showError && string.IsNullOrEmpty(accountNumber)) 
                { 
                    <span style="color: #dc2626; font-size: 12px;">Required</span> 
                }
            </div>

            <!-- Customer Name -->
            <div>
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Customer Name</label>
                <input type="text" style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px; background: #f9fafb;" 
                       @bind="customerName" placeholder="Auto-filled" readonly />
            </div>

            <!-- Current Balance -->
            <div>
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Current Balance</label>
                <input type="text" style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px; background: #f9fafb;" 
                       @bind="currentBalance" placeholder="₱0.00" readonly />
            </div>

            <!-- Deposit Amount -->
            <div>
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Deposit Amount (₱) *</label>
                <input type="number" style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;" 
                       @bind="depositAmount" placeholder="0.00" step="0.01" />
                @if (showError && depositAmount <= 0) 
                { 
                    <span style="color: #dc2626; font-size: 12px;">Amount must be greater than 0</span> 
                }
            </div>

            <!-- Deposit Method -->
            <div>
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Deposit Method *</label>
                <select style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;" @bind="depositMethod">
                    <option value="">Select method...</option>
                    <option value="OTC">Over-the-Counter (OTC)</option>
                    <option value="BankTransfer">Bank Transfer</option>
                    <option value="CDM">Cash Deposit Machine (CDM)</option>
                    <option value="AdminOverride">Admin Override Deposit</option>
                </select>
                @if (showError && string.IsNullOrEmpty(depositMethod)) 
                { 
                    <span style="color: #dc2626; font-size: 12px;">Required</span> 
                }
            </div>

            <!-- Reference Number -->
            <div>
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Reference Number</label>
                <input type="text" style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px; background: #F0F2EC; color: #2F3E2A; font-weight: 600;" 
                       value="@referenceNumber" readonly placeholder="Auto-generated" />
                <span style="color: #5F6F52; font-size: 11px; display: block; margin-top: 4px;">✓ Auto-generated reference number (ADMIN prefix)</span>
            </div>

            <!-- Notes -->
            <div style="grid-column: 1 / -1;">
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Notes</label>
                <textarea style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px; font-family: inherit; resize: vertical; min-height: 80px;" 
                          @bind="notes" placeholder="Additional notes..."></textarea>
            </div>

            <!-- Admin Authority Notice -->
            <div style="grid-column: 1 / -1; background: #dbeafe; border: 1px solid #3b82f6; border-radius: 12px; padding: 16px;">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <span style="font-size: 20px;">🔓</span>
                    <div>
                        <h4 style="margin: 0 0 4px; font-size: 14px; font-weight: 700; color: #1e40af;">Direct Admin Authorization</h4>
                        <p style="margin: 0; font-size: 13px; color: #1e40af; opacity: 0.9;">No PIN verification required. Your admin credentials authorize this transaction directly.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Messages -->
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div style="padding: 16px; background: #fee2e2; border-radius: 8px; color: #991b1b; margin-bottom: 20px; font-size: 14px;">
                <strong>Error:</strong> @errorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div style="padding: 16px; background: #D4E6D4; border-radius: 8px; color: #2F3E2A; margin-bottom: 20px; font-size: 14px;">
                <strong>Success:</strong> @successMessage
                @if (!string.IsNullOrEmpty(lastReceiptNumber))
                {
                    <div style="margin-top: 12px; font-size: 13px;">
                        Receipt #: <strong>@lastReceiptNumber</strong>
                        <button type="button" @onclick="PrintReceipt" style="margin-left: 12px; background: #5F6F52; color: white; padding: 6px 12px; border-radius: 6px; border: none; cursor: pointer; font-weight: 600;">Print Receipt</button>
                    </div>
                }
            </div>
        }

        <!-- Buttons -->
        <div style="display: flex; gap: 12px; justify-content: flex-end;">
            <button type="button" style="background: #f3f4f6; color: #374151; padding: 12px 24px; border-radius: 8px; border: none; font-weight: 600; cursor: pointer;" @onclick="ResetForm">
                Reset
            </button>
            <button type="submit" 
                    style="background: linear-gradient(135deg, #5F6F52, #2F3E2A); color: white; padding: 12px 32px; border-radius: 8px; border: none; font-weight: 600; cursor: pointer;" 
                    disabled="@isLoading">
                @if (isLoading) { <span>Processing...</span> }
                else { <span>🔐 Process Deposit (Admin)</span> }
            </button>
        </div>
    </form>
</div>

<!-- Real-Time Transactions Table -->
<div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
    <h3 style="margin: 0 0 20px; font-size: 18px; font-weight: 700; color: #1f2937;">Today's Deposits (Real-Time)</h3>
    
    @if (todayTransactions.Any())
    {
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="border-bottom: 2px solid #e5e7eb; background: #f9fafb;">
                        <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">ACCOUNT #</th>
                        <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">CUSTOMER</th>
                        <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">AMOUNT</th>
                        <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">METHOD</th>
                        <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">TIME</th>
                        <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">STATUS</th>
                        <th style="padding: 12px; text-align: center; font-size: 12px; font-weight: 700; color: #6b7280;">ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var transaction in todayTransactions)
                    {
                        <tr style="border-bottom: 1px solid #e5e7eb; hover:background: #f9fafb;">
                            <td style="padding: 16px; font-weight: 600;">@transaction.AccountNumber</td>
                            <td style="padding: 16px;">@transaction.CustomerName</td>
                            <td style="padding: 16px; font-weight: 600; color: #5F6F52;">₱@transaction.Amount.ToString("N2")</td>
                            <td style="padding: 16px; font-size: 12px;">@transaction.Method</td>
                            <td style="padding: 16px; font-size: 12px; color: #6b7280;">@transaction.Date.ToString("hh:mm tt")</td>
                            <td style="padding: 16px;"><span style="padding: 4px 12px; background: #D4E6D4; color: #2F3E2A; border-radius: 8px; font-size: 12px; font-weight: 600;">Completed</span></td>
                            <td style="padding: 16px; text-align: center;">
                                <button type="button" 
                                        @onclick="@(() => ViewInvoice(transaction))"
                                        style="background: #5F6F52; color: white; padding: 6px 12px; border-radius: 6px; border: none; cursor: pointer; font-weight: 600; font-size: 12px;">
                                    📄 Invoice
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div style="padding: 32px; text-align: center; color: #6b7280;">
            <p style="margin: 0; font-size: 14px;">No deposits recorded today yet.</p>
        </div>
    }
</div>

<!-- Invoice Modal -->
@if (showInvoiceModal && selectedTransaction != null)
{
    var trans = selectedTransaction;
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000;" @onclick="CloseInvoiceModal">
        <div style="background: white; border-radius: 16px; padding: 32px; max-width: 600px; width: 90%; max-height: 90vh; overflow-y: auto; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);" @onclick:stopPropagation>
            <!-- Modal Header -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; border-bottom: 2px solid #e5e7eb; padding-bottom: 16px;">
                <h2 style="margin: 0; font-size: 20px; font-weight: 700; color: #1f2937;">Deposit Invoice (Admin)</h2>
                <button type="button" @onclick="CloseInvoiceModal" style="background: none; border: none; font-size: 24px; cursor: pointer; color: #6b7280;">✕</button>
            </div>

            <!-- Invoice Content -->
            <div style="font-size: 14px; line-height: 1.8;">
                <!-- Header -->
                <div style="text-align: center; margin-bottom: 24px;">
                    <h3 style="margin: 0 0 8px; font-size: 18px; font-weight: 700; color: #5F6F52;">ADMIN DEPOSIT INVOICE</h3>
                    <p style="margin: 0; color: #6b7280; font-size: 12px;">FinanceBank System - Admin Transaction</p>
                </div>

                <!-- Customer Info -->
                <div style="background: #f9fafb; padding: 16px; border-radius: 8px; margin-bottom: 20px;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                        <div>
                            <p style="margin: 0 0 4px; color: #6b7280; font-size: 12px; font-weight: 600;">ACCOUNT NUMBER</p>
                            <p style="margin: 0; font-weight: 600; color: #1f2937;">@trans.AccountNumber</p>
                        </div>
                        <div>
                            <p style="margin: 0 0 4px; color: #6b7280; font-size: 12px; font-weight: 600;">CUSTOMER NAME</p>
                            <p style="margin: 0; font-weight: 600; color: #1f2937;">@trans.CustomerName</p>
                        </div>
                        <div>
                            <p style="margin: 0 0 4px; color: #6b7280; font-size: 12px; font-weight: 600;">DATE & TIME</p>
                            <p style="margin: 0; color: #1f2937;">@trans.Date.ToString("yyyy-MM-dd HH:mm:ss")</p>
                        </div>
                        <div>
                            <p style="margin: 0 0 4px; color: #6b7280; font-size: 12px; font-weight: 600;">DEPOSIT METHOD</p>
                            <p style="margin: 0; color: #1f2937;">@trans.Method</p>
                        </div>
                    </div>
                </div>

                <!-- Transaction Details -->
                <div style="background: #F0F2EC; padding: 16px; border-radius: 8px; margin-bottom: 20px; border-left: 4px solid #5F6F52;">
                    <p style="margin: 0 0 12px; color: #6b7280; font-size: 12px; font-weight: 600;">TRANSACTION DETAILS</p>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                        <div>
                            <p style="margin: 0 0 4px; color: #6b7280; font-size: 12px;">Deposit Amount</p>
                            <p style="margin: 0; font-size: 18px; font-weight: 700; color: #5F6F52;">₱@trans.Amount.ToString("N2")</p>
                        </div>
                        <div>
                            <p style="margin: 0 0 4px; color: #6b7280; font-size: 12px;">Status</p>
                            <p style="margin: 0; font-weight: 600; color: #2F3E2A;">✓ Completed</p>
                        </div>
                    </div>
                </div>

                <!-- Processing Info -->
                <div style="background: #dbeafe; padding: 16px; border-radius: 8px; border-left: 4px solid #3b82f6;">
                    <p style="margin: 0 0 12px; color: #1e40af; font-size: 12px; font-weight: 600;">ADMIN PROCESSING INFORMATION</p>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                        <div>
                            <p style="margin: 0 0 4px; color: #1e40af; font-size: 12px;">Processed By (Admin)</p>
                            <p style="margin: 0; color: #1e40af; font-weight: 600;">SuperAdmin-@AuthService.CurrentUser</p>
                        </div>
                        <div>
                            <p style="margin: 0 0 4px; color: #1e40af; font-size: 12px;">Reference</p>
                            <p style="margin: 0; color: #1e40af;">@trans.Reference</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Buttons -->
            <div style="display: flex; gap: 12px; margin-top: 24px; padding-top: 16px; border-top: 1px solid #e5e7eb;">
                <button type="button" 
                        @onclick="PrintInvoice"
                        style="flex: 1; background: #5F6F52; color: white; padding: 12px; border-radius: 8px; border: none; font-weight: 600; cursor: pointer;">
                    Print Invoice
                </button>
                <button type="button" 
                        @onclick="CloseInvoiceModal"
                        style="flex: 1; background: #f3f4f6; color: #374151; padding: 12px; border-radius: 8px; border: none; font-weight: 600; cursor: pointer;">
                    Close
                </button>
            </div>
        </div>
    </div>
}

<!-- Confirmation Modal -->
@if (showConfirmationModal)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1001;">
        <div style="background: white; border-radius: 16px; padding: 32px; max-width: 500px; width: 90%; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);">
            <!-- Admin Authority Icon -->
            <div style="text-align: center; margin-bottom: 20px;">
                <div style="width: 64px; height: 64px; background: #dbeafe; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
                    <span style="font-size: 28px;">🔐</span>
                </div>
            </div>

            <h2 style="margin: 0 0 16px; font-size: 20px; font-weight: 700; color: #1f2937; text-align: center;">Admin Deposit Confirmation</h2>
            <p style="margin: 0 0 24px; color: #6b7280; text-align: center; font-size: 14px;">You are processing this deposit with admin authority.</p>

            <!-- Transaction Summary -->
            <div style="background: #F0F2EC; border: 1px solid #A9B388; border-radius: 12px; padding: 16px; margin-bottom: 16px;">
                <div style="display: grid; gap: 12px;">
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: #6b7280; font-size: 13px;">Account:</span>
                        <span style="font-weight: 600; color: #1f2937;">@accountNumber</span>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: #6b7280; font-size: 13px;">Customer:</span>
                        <span style="font-weight: 600; color: #1f2937;">@customerName</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; padding-top: 12px; border-top: 1px dashed #A9B388;">
                        <span style="color: #6b7280; font-size: 13px;">Deposit Amount:</span>
                        <span style="font-weight: 700; color: #5F6F52; font-size: 18px;">₱@depositAmount.ToString("N2")</span>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: #6b7280; font-size: 13px;">Method:</span>
                        <span style="font-weight: 600; color: #1f2937;">@depositMethod</span>
                    </div>
                </div>
            </div>

            <!-- Admin Reason Display -->
            <div style="background: #dbeafe; border: 1px solid #3b82f6; border-radius: 12px; padding: 16px; margin-bottom: 24px;">
                <p style="margin: 0 0 8px; color: #1e40af; font-size: 12px; font-weight: 600;">📋 ADMIN REASON FOR ACTION</p>
                <p style="margin: 0; color: #1e40af; font-size: 14px;">@adminActionReason</p>
            </div>

            <!-- Buttons -->
            <div style="display: flex; gap: 12px;">
                <button type="button" 
                        @onclick="CancelConfirmation"
                        style="flex: 1; padding: 12px; background: #f3f4f6; color: #374151; border-radius: 8px; border: none; font-weight: 600; cursor: pointer;">
                    Cancel
                </button>
                <button type="button" 
                        @onclick="HandleDeposit"
                        disabled="@isLoading"
                        style="flex: 1; padding: 12px; background: linear-gradient(135deg, #5F6F52, #2F3E2A); color: white; border-radius: 8px; border: none; font-weight: 600; cursor: pointer;">
                    @if (isLoading) { <span>Processing...</span> }
                    else { <span>✓ Confirm Admin Deposit</span> }
                </button>
            </div>
        </div>
    </div>
}

@code {
    // Admin-specific fields
    private string adminActionReason = "";

    // Form fields
    private string accountNumber = "";
    private string customerName = "";
    private string currentBalance = "₱0.00";
    private decimal depositAmount = 0;
    private string referenceNumber = "";
    private string depositMethod = "";
    private string notes = "";
    private bool showError = false;
    private bool isLoading = false;
    private string errorMessage = "";
    private string successMessage = "";
    private string lastReceiptNumber = "";

    // Transaction tracking
    private class TransactionRecord
    {
        public string AccountNumber { get; set; } = string.Empty;
        public string CustomerName { get; set; } = string.Empty;
        public decimal Amount { get; set; }
        public string Method { get; set; } = string.Empty;
        public DateTime Date { get; set; }
        public string Reference { get; set; } = string.Empty;
    }

    private List<TransactionRecord> todayTransactions = new();
    private bool showInvoiceModal = false;
    private TransactionRecord? selectedTransaction = null;

    // Confirmation modal
    private bool showConfirmationModal = false;

    protected override async Task OnInitializedAsync()
    {
        // Verify admin role
        if (!AuthService.IsAuthenticated || !AuthService.HasRole(AuthService.Roles.SuperAdmin))
        {
            return;
        }

        Console.WriteLine($"[ADMIN ACTION] Deposit page accessed by SuperAdmin-{AuthService.CurrentUser}");
        
        GenerateReferenceNumber();
        await LoadTodayTransactions();
    }

    private void GenerateReferenceNumber()
    {
        // Generate admin-specific reference number: ADMIN-DEP-YYYYMMDD-HHMMSS-XXXX
        var timestamp = DateTime.Now;
        var random = new Random().Next(1000, 9999);
        referenceNumber = $"ADMIN-DEP-{timestamp:yyyyMMdd}-{timestamp:HHmmss}-{random}";
    }

    private async Task OnAccountNumberChanged(ChangeEventArgs e)
    {
        accountNumber = e.Value?.ToString() ?? "";
        await LoadAccountDetails();
    }

    private async Task LoadAccountDetails()
    {
        if (string.IsNullOrWhiteSpace(accountNumber))
        {
            customerName = "";
            currentBalance = "₱0.00";
            return;
        }

        var (success, account, message) = await TellerBankingService.GetAccountByNumberAsync(accountNumber);
        
        if (success && account != null)
        {
            customerName = account.Customer?.FullName ?? "";
            currentBalance = $"₱{account.Balance:N2}";
        }
        else
        {
            customerName = "";
            currentBalance = "₱0.00";
        }
    }

    private async Task LoadTodayTransactions()
    {
        try
        {
            var transactions = await TellerBankingService.GetTodayTransactionsAsync();
            todayTransactions = transactions
                .Where(t => t.Type == "Deposit")
                .Select(t => new TransactionRecord
                {
                    AccountNumber = t.AccountNumber,
                    CustomerName = t.CustomerName,
                    Amount = t.Amount,
                    Method = t.Type,
                    Date = t.Time,
                    Reference = "REF-" + t.Time.Ticks.ToString().Substring(0, 8)
                })
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ADMIN ERROR] Loading transactions: {ex.Message}");
        }
    }

    private void ViewInvoice(TransactionRecord transaction)
    {
        selectedTransaction = transaction;
        showInvoiceModal = true;
    }

    private void CloseInvoiceModal()
    {
        showInvoiceModal = false;
        selectedTransaction = null;
    }

    private void PrintInvoice()
    {
        if (selectedTransaction == null)
            return;

        var trans = selectedTransaction;
        var invoiceContent = $@"
========================================================
               ADMIN DEPOSIT INVOICE                    
