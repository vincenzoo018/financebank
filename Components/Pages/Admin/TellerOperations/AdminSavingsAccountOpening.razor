@page "/admin/teller-ops/savings/open"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@using FinanceBank.Data
@using Microsoft.EntityFrameworkCore
@inject AuthService AuthService
@inject SavingsAccountService SavingsService
@inject CustomerAccountService CustomerAccountService
@inject IDbContextFactory<BFASDbContext> DbContextFactory
@inject NavigationManager Navigation
@inject NotificationService NotificationService

<div style="padding: 24px; max-width: 1200px; margin: 0 auto;">
    <!-- Header -->
    <div style="background: linear-gradient(135deg, #10b981, #059669); border-radius: 16px; padding: 24px; margin-bottom: 24px; color: white;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 56px; height: 56px; background: rgba(255,255,255,0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                <svg width="28" height="28" fill="none" stroke="white" stroke-width="2">
                    <rect x="3" y="3" width="18" height="18" rx="2"/>
                    <path d="M12 8v8m-4-4h8"/>
                </svg>
            </div>
            <div style="flex: 1;">
                <h1 style="font-size: 26px; font-weight: 700; margin: 0;">Open Savings Account</h1>
                <p style="margin: 6px 0 0; opacity: 0.9;">Create new savings account for customer</p>
            </div>
        </div>
    </div>

    <!-- Admin Access Notice -->
    <div style="background: #dbeafe; border: 2px solid #3b82f6; border-radius: 12px; padding: 16px; margin-bottom: 20px;">
        <p style="margin: 0; color: #1e40af; font-weight: 600; display: flex; align-items: center; gap: 8px;">
            <span style="font-size: 20px;">ℹ️</span>
            <strong>SuperAdmin Teller Operations Access</strong> - Direct savings account opening authority
        </p>
    </div>

    <!-- Admin Reason Field -->
    <div style="background: white; border-radius: 16px; padding: 20px; border: 2px solid #059669; margin-bottom: 20px;">
        <label style="display: block; font-weight: 700; margin-bottom: 8px; color: #059669;">Admin Action Reason *</label>
        <textarea @bind="adminActionReason" rows="2" 
                  placeholder="Document reason for admin savings account opening (required)"
                  style="width: 100%; padding: 12px; border: 2px solid #059669; border-radius: 8px; resize: vertical;"></textarea>
        <small style="color: #059669;">Required: This will be logged in the audit trail</small>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div style="background: #d1fae5; border: 1px solid #6ee7b7; color: #065f46; padding: 20px; border-radius: 12px; margin-bottom: 20px; white-space: pre-line;">
            @successMessage
            <div style="margin-top: 16px;">
                <button @onclick="ResetForm" style="background: #059669; color: white; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: 600;">Open Another Account</button>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div style="background: #fee2e2; border: 1px solid #fecaca; color: #991b1b; padding: 20px; border-radius: 12px; margin-bottom: 20px; white-space: pre-line;">
            @errorMessage
        </div>
    }

    @if (showConfirmation)
    {
        <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 9999;">
            <div style="background: white; border-radius: 16px; padding: 32px; max-width: 500px; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
                <div style="text-align: center; margin-bottom: 24px;">
                    <div style="font-size: 48px; margin-bottom: 16px;">👑</div>
                    <h3 style="font-size: 22px; font-weight: 700; margin-bottom: 12px; color: #1f2937;">Admin: Confirm Account Opening</h3>
                    <p style="color: #6b7280; margin-bottom: 20px;">Please review the details before proceeding:</p>
                </div>

                <div style="background: #f9fafb; padding: 20px; border-radius: 12px; margin-bottom: 16px; text-align: left;">
                    <div style="display: grid; gap: 12px;">
                        <div style="display: flex; justify-content: space-between;">
                            <span style="color: #6b7280;">Customer:</span>
                            <strong>@customerName</strong>
                        </div>
                        <div style="display: flex; justify-content: space-between;">
                            <span style="color: #6b7280;">Account Number:</span>
                            <strong>@customerAccountNumber</strong>
                        </div>
                        <div style="display: flex; justify-content: space-between; border-top: 1px solid #e5e7eb; padding-top: 12px;">
                            <span style="color: #6b7280;">Account Type:</span>
                            <strong>@selectedAccountType?.TypeName</strong>
                        </div>
                        <div style="display: flex; justify-content: space-between;">
                            <span style="color: #6b7280;">Initial Deposit:</span>
                            <strong style="color: #10b981;">₱@initialDeposit.ToString("N2")</strong>
                        </div>
                        <div style="display: flex; justify-content: space-between;">
                            <span style="color: #6b7280;">Interest Rate:</span>
                            <strong>@interestRate% per annum</strong>
                        </div>
                        @if (lockInDays > 0)
                        {
                            <div style="display: flex; justify-content: space-between;">
                                <span style="color: #6b7280;">Lock-In Period:</span>
                                <strong>@lockInDays days</strong>
                            </div>
                        }
                    </div>
                </div>

                <!-- Admin Reason Display -->
                <div style="background: #f3e8ff; padding: 12px; border-radius: 8px; margin-bottom: 16px; border: 1px solid #c4b5fd;">
                    <span style="font-size: 12px; font-weight: 600; color: #7c3aed;">👑 Admin Reason:</span>
                    <p style="margin: 4px 0 0; color: #6b21a8; font-style: italic;">"@adminActionReason"</p>
                </div>

                <div style="display: flex; gap: 12px;">
                    <button @onclick="CancelConfirmation" disabled="@isSubmitting"
                            style="flex: 1; padding: 12px; border: 1px solid #e5e7eb; background: white; border-radius: 8px; cursor: pointer; font-weight: 600; color: #374151;">
                        Cancel
                    </button>
                    <button @onclick="SubmitOpenAccount" disabled="@isSubmitting"
                            style="flex: 1; padding: 12px; background: linear-gradient(135deg, #10b981, #059669); color: white; border: none; border-radius: 8px; cursor: @(isSubmitting ? "not-allowed" : "pointer"); font-weight: 600; opacity: @(isSubmitting ? "0.6" : "1");">
                        @(isSubmitting ? "Processing..." : "✓ Confirm & Open")
                    </button>
                </div>
            </div>
        </div>
    }

    <div style="background: white; border-radius: 16px; padding: 32px; border: 1px solid #e5e7eb;">
        <form @onsubmit="SubmitOpenAccount" @onsubmit:preventDefault>
            <!-- Step 1: Customer Selection -->
            <div style="margin-bottom: 32px;">
                <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 16px; color: #1f2937;">
                    <span style="display: inline-block; width: 28px; height: 28px; background: #10b981; color: white; border-radius: 50%; text-align: center; line-height: 28px; margin-right: 8px;">1</span>
                    Customer Information
                </h3>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div>
                        <label style="display: block; font-weight: 600; margin-bottom: 6px;">Customer Account Number *</label>
                        <input type="text" @bind="customerAccountNumber" @oninput="OnCustomerAccountChanged" 
                               style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px;"
                               placeholder="e.g., ACC-000001"/>
                    </div>
                    <div>
                        <label style="display: block; font-weight: 600; margin-bottom: 6px;">Customer Name</label>
                        <input type="text" @bind="customerName" readonly
                               style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; background: #f9fafb;"
                               placeholder="Auto-filled"/>
                    </div>
                </div>
            </div>

            <!-- Step 2: Account Type Selection -->
            <div style="margin-bottom: 32px;">
                <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 16px; color: #1f2937;">
                    <span style="display: inline-block; width: 28px; height: 28px; background: #10b981; color: white; border-radius: 50%; text-align: center; line-height: 28px; margin-right: 8px;">2</span>
                    Account Type
                </h3>
                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;">
                    @foreach (var type in accountTypes)
                    {
                        <div @onclick="() => SelectAccountType(type)" 
                             style="@GetAccountTypeCardStyle(type)" 
                             class="account-type-card">
                            <div style="font-size: 20px; margin-bottom: 8px;">
                                @(type.TypeName == "Regular" ? "💰" : type.TypeName == "TimeDeposit" ? "🔒" : "⭐")
                            </div>
                            <div style="font-weight: 700; margin-bottom: 4px;">@type.TypeName</div>
                            <div style="font-size: 12px; opacity: 0.7; margin-bottom: 12px;">@type.Description</div>
                            <div style="font-size: 14px; font-weight: 600; color: #10b981;">
                                @type.InterestRateMin% - @type.InterestRateMax% APY
                            </div>
                            @if (type.DefaultLockInDays > 0)
                            {
                                <div style="font-size: 11px; margin-top: 6px; color: #6b7280;">
                                    🔒 @type.DefaultLockInDays days lock-in
                                </div>
                            }
                        </div>
                    }
                </div>

                @if (selectedAccountType != null)
                {
                    <div style="margin-top: 16px; padding: 16px; background: #f0fdf4; border: 1px solid #86efac; border-radius: 8px;">
                        <div style="font-weight: 600; margin-bottom: 8px;">Selected: @selectedAccountType.TypeName</div>
                        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; font-size: 13px;">
                            <div>Min. Initial: <strong>₱@selectedAccountType.MinimumInitialDeposit.ToString("N2")</strong></div>
                            <div>Min. Maintaining: <strong>₱@selectedAccountType.MinimumMaintainingBalance.ToString("N2")</strong></div>
                        </div>
                    </div>
                }
            </div>

            <!-- Step 3: Initial Deposit & Lock-In Period -->
            <div style="margin-bottom: 32px;">
                <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 16px; color: #1f2937;">
                    <span style="display: inline-block; width: 28px; height: 28px; background: #10b981; color: white; border-radius: 50%; text-align: center; line-height: 28px; margin-right: 8px;">3</span>
                    Deposit Details
                </h3>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div>
                        <label style="display: block; font-weight: 600; margin-bottom: 6px;">Initial Deposit Amount *</label>
                        <input type="number" @bind="initialDeposit" step="0.01" min="0"
                               style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px;"
                               placeholder="Minimum ₱@(selectedAccountType?.MinimumInitialDeposit ?? 0)"/>
                        @if (selectedAccountType != null && initialDeposit < selectedAccountType.MinimumInitialDeposit)
                        {
                            <small style="color: #dc2626;">Minimum: ₱@selectedAccountType.MinimumInitialDeposit.ToString("N2")</small>
                        }
                    </div>

                    @if (selectedAccountType?.TypeName == "TimeDeposit")
                    {
                        <div>
                            <label style="display: block; font-weight: 600; margin-bottom: 6px;">Lock-In Period *</label>
                            <select @bind="lockInDays" style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px;">
                                <option value="30">30 Days (3.00% APY)</option>
                                <option value="90">90 Days (4.00% APY)</option>
                                <option value="180">180 Days (5.00% APY)</option>
                                <option value="360">360 Days (6.50% APY)</option>
                            </select>
                        </div>
                    }
                    else if (selectedAccountType?.TypeName == "HighYield")
                    {
                        <div>
                            <label style="display: block; font-weight: 600; margin-bottom: 6px;">Lock-In Period (Optional)</label>
                            <select @bind="lockInDays" style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px;">
                                <option value="0">No Lock-In (2.00% APY)</option>
                                <option value="90">90 Days (3.50% APY)</option>
                                <option value="180">180 Days (4.50% APY)</option>
                            </select>
                        </div>
                    }

                    <div style="grid-column: 1 / -1;">
                        <label style="display: block; font-weight: 600; margin-bottom: 6px;">Interest Rate (Annual)</label>
                        <input type="number" @bind="interestRate" step="0.01" min="0" max="10"
                               style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px;"
                               placeholder="e.g., 2.50"/>
                        <small style="color: #6b7280;">Range: @(selectedAccountType?.InterestRateMin ?? 0)% - @(selectedAccountType?.InterestRateMax ?? 10)%</small>
                    </div>
                </div>
            </div>

            <!-- Submit Button -->
            <div style="border-top: 1px solid #e5e7eb; padding-top: 24px; display: flex; justify-content: flex-end; gap: 12px;">
                <button type="button" @onclick="ResetForm" disabled="@isSubmitting"
                        style="padding: 12px 24px; border: 1px solid #e5e7eb; background: white; border-radius: 8px; cursor: @(isSubmitting ? "not-allowed" : "pointer"); font-weight: 600; opacity: @(isSubmitting ? "0.6" : "1");">
                    Reset
                </button>
                <button type="submit" disabled="@(!CanSubmit())"
                        style="padding: 12px 32px; background: @(CanSubmit() ? "linear-gradient(135deg, #10b981, #059669)" : "#d1d5db"); color: white; border: none; border-radius: 8px; cursor: @(CanSubmit() ? "pointer" : "not-allowed"); font-weight: 600; box-shadow: @(CanSubmit() ? "0 4px 12px rgba(16, 185, 129, 0.3)" : "none");">
                    @(isSubmitting ? "⏳ Processing..." : "Open Savings Account")
                </button>
            </div>
        </form>
    </div>
</div>

@code {
    private List<SavingsAccountType> accountTypes = new();
    private SavingsAccountType? selectedAccountType;
    private string customerAccountNumber = "";
    private string customerName = "";
    private int customerId = 0;
    private int customerAccountId = 0;
    private decimal initialDeposit = 0;
    private int lockInDays = 0;
    private decimal interestRate = 0.50m;
    private string successMessage = "";
    private string errorMessage = "";
    private bool showConfirmation = false;
    private bool isSubmitting = false;
    private string adminActionReason = "";

    protected override async Task OnInitializedAsync()
    {
        // Verify admin access
        if (AuthService.CurrentRole != "SuperAdmin")
        {
            Navigation.NavigateTo("/admin");
            return;
        }

        accountTypes = await SavingsService.GetAccountTypesAsync();
    }

    private async Task OnCustomerAccountChanged(ChangeEventArgs e)
    {
        customerAccountNumber = e.Value?.ToString() ?? "";
        errorMessage = "";

        if (string.IsNullOrEmpty(customerAccountNumber)) return;

        using var context = await DbContextFactory.CreateDbContextAsync();
        var customerAccount = await context.CustomerAccounts
            .Include(ca => ca.Customer)
            .FirstOrDefaultAsync(ca => ca.AccountNumber == customerAccountNumber);

        if (customerAccount != null)
        {
            customerId = customerAccount.CustomerId;
            customerName = customerAccount.Customer?.FullName ?? "Unknown";
            customerAccountId = customerAccount.AccountId;
        }
        else
        {
            customerName = "";
            errorMessage = "Customer account not found";
        }
    }

    private void SelectAccountType(SavingsAccountType type)
    {
        selectedAccountType = type;
        lockInDays = type.DefaultLockInDays;
        interestRate = (type.InterestRateMin + type.InterestRateMax) / 2;
    }

    private string GetAccountTypeCardStyle(SavingsAccountType type)
    {
        var isSelected = selectedAccountType?.TypeId == type.TypeId;
        return $"padding: 20px; border: 2px solid {(isSelected ? "#10b981" : "#e5e7eb")}; border-radius: 12px; cursor: pointer; transition: all 0.3s; background: {(isSelected ? "#f0fdf4" : "white")};";
    }

    private bool CanSubmit()
    {
        return !string.IsNullOrEmpty(customerAccountNumber) &&
               customerId > 0 &&
               selectedAccountType != null &&
               initialDeposit >= selectedAccountType.MinimumInitialDeposit &&
               interestRate >= selectedAccountType.InterestRateMin &&
               interestRate <= selectedAccountType.InterestRateMax &&
               !string.IsNullOrWhiteSpace(adminActionReason) &&
               !isSubmitting;
    }

    private async Task SubmitOpenAccount()
    {
        // Validation checks
        if (isSubmitting) return;
        
        errorMessage = "";
        successMessage = "";

        try
        {
            // Validate admin reason
            if (string.IsNullOrWhiteSpace(adminActionReason))
            {
                NotificationService.ShowError("Validation Error", "Admin action reason is required to open this savings account.");
                return;
            }

            // Validate customer account
            if (string.IsNullOrEmpty(customerAccountNumber))
            {
                NotificationService.ShowError("Validation Error", "Please enter a customer account number.");
                return;
            }

            if (customerId <= 0 || customerAccountId <= 0)
            {
                NotificationService.ShowError("Validation Error", "Invalid customer account. Please verify the account number.");
                return;
            }

            // Validate account type selection
            if (selectedAccountType == null)
            {
                NotificationService.ShowError("Validation Error", "Please select an account type.");
                return;
            }

            // Validate initial deposit
            if (initialDeposit <= 0)
            {
                NotificationService.ShowError("Validation Error", "Initial deposit must be greater than zero.");
                return;
            }

            if (initialDeposit < selectedAccountType.MinimumInitialDeposit)
            {
                NotificationService.ShowError("Validation Error", $"Initial deposit must be at least ₱{selectedAccountType.MinimumInitialDeposit:N2} for {selectedAccountType.TypeName} account.");
                return;
            }

            // Validate interest rate
            if (interestRate < selectedAccountType.InterestRateMin || interestRate > selectedAccountType.InterestRateMax)
            {
                NotificationService.ShowError("Validation Error", $"Interest rate must be between {selectedAccountType.InterestRateMin}% and {selectedAccountType.InterestRateMax}%");
                return;
            }

            // Show confirmation
            if (!showConfirmation)
            {
                showConfirmation = true;
                NotificationService.ShowInfo("Confirmation Required", $"Please review and confirm the savings account opening for {customerName}.");
                return;
            }

            // Process the account opening
            isSubmitting = true;
            NotificationService.ShowInfo("Processing", "Opening savings account...");
            
            var adminUser = AuthService.CurrentUser ?? "SuperAdmin";
            var tellerName = $"[ADMIN: {adminUser}] {AuthService.FullName ?? adminUser}";

            // Log admin action
            Console.WriteLine($"[ADMIN ACTION] Savings Account Opening by {adminUser}: {adminActionReason}");

            (bool success, string message, FinanceBank.Models.SavingsAccount? account) = await SavingsService.OpenSavingsAccountAsync(
                customerId,
                customerAccountId,
                selectedAccountType.TypeId,
                initialDeposit,
                lockInDays,
                tellerName
            );

            if (success && account != null)
            {
                successMessage = $"✅ SUCCESS! Savings account {account.AccountNumber} opened successfully!\n\n" +
                                $"Account Type: {selectedAccountType.TypeName}\n" +
                                $"Initial Deposit: ₱{initialDeposit:N2}\n" +
                                $"Interest Rate: {interestRate}% per annum\n" +
                                $"Current Balance: ₱{account.Balance:N2}\n" +
                                (lockInDays > 0 ? $"Maturity Date: {account.MaturityDate?.ToString("MMMM dd, yyyy")}\n" : "") +
                                $"\nCustomer: {customerName}\n" +
                                $"\n👑 Admin: {adminUser}\nReason: {adminActionReason}";
                
                NotificationService.ShowSuccess("Account Opened", $"Savings account {account.AccountNumber} created successfully for {customerName}!");
                showConfirmation = false;
            }
            else
            {
                errorMessage = $"❌ ERROR: {message}";
                NotificationService.ShowError("Account Opening Failed", message);
                showConfirmation = false;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"❌ SYSTEM ERROR: An unexpected error occurred. Please try again or contact support.\n\nDetails: {ex.Message}";
            NotificationService.ShowError("System Error", $"An unexpected error occurred: {ex.Message}");
            showConfirmation = false;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void CancelConfirmation()
    {
        showConfirmation = false;
    }

    private void ResetForm()
    {
        customerAccountNumber = "";
        customerName = "";
        customerId = 0;
        customerAccountId = 0;
        selectedAccountType = null;
        initialDeposit = 0;
        lockInDays = 0;
        interestRate = 0.50m;
        successMessage = "";
        errorMessage = "";
        showConfirmation = false;
        isSubmitting = false;
        // Keep admin reason for batch operations
    }
}

<style>
    .account-type-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    }
</style>
