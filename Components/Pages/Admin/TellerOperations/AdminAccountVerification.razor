@page "/admin/teller-ops/verification"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@using Microsoft.EntityFrameworkCore
@inject AuthService AuthService
@inject IDbContextFactory<BFASDbContext> DbContextFactory
@inject NavigationManager Navigation

<div style="padding: 24px; max-width: 1100px; margin: 0 auto;">
    <div style="background: linear-gradient(135deg, #5F6F52 0%, #2F3E2A 100%); border-radius: 16px; padding: 24px; margin-bottom: 24px; color: white;">
        <h1 style="font-size: 24px; font-weight: 700; margin: 0 0 4px 0;">Account Verification</h1>
        <p style="font-size: 14px; opacity: 0.9; margin: 0;">Lookup and verify customer accounts before processing transactions.</p>
    </div>

    <!-- Admin Access Notice -->
    <div style="background: #E8F0E8; border: 2px solid #5F6F52; border-radius: 12px; padding: 16px; margin-bottom: 20px;">
        <p style="margin: 0; color: #2F3E2A; font-weight: 600; display: flex; align-items: center; gap: 8px;">
            <span style="font-size: 20px;">ℹ️</span>
            <strong>SuperAdmin Teller Operations Access</strong> - Full account verification capability
        </p>
    </div>

    <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb; margin-bottom: 20px;">
        <h2 style="font-size: 16px; font-weight: 600; margin-bottom: 16px;">Search Account</h2>
        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 12px;">
            <input type="text" @bind="searchQuery" @oninput="OnSearchChanged" 
                   placeholder="Enter account number or customer name..." 
                   style="width: 100%; padding: 12px; border: 2px solid #5F6F52; border-radius: 8px; font-size: 14px;" />
            <button @onclick="SearchAccount" style="background: #5F6F52; color: white; border: none; padding: 12px 24px; border-radius: 8px; font-weight: 600; cursor: pointer;">
                🔍 Search
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div style="background: white; border-radius: 16px; padding: 40px; border: 1px solid #e5e7eb; text-align: center;">
            <div style="width: 40px; height: 40px; border: 4px solid #e5e7eb; border-top-color: #5F6F52; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto;"></div>
            <p style="margin-top: 16px; color: #6b7280;">Searching...</p>
        </div>
    }
    else if (searchResults.Any())
    {
        <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb; margin-bottom: 20px;">
            <h2 style="font-size: 16px; font-weight: 600; margin-bottom: 16px;">Search Results (@searchResults.Count found)</h2>
            <div style="display: grid; gap: 16px;">
                @foreach (var account in searchResults)
                {
                    <div style="background: #f9fafb; border-radius: 12px; padding: 20px; border: 2px solid @(selectedAccount?.AccountId == account.AccountId ? "#5F6F52" : "#e5e7eb"); cursor: pointer;"
                         @onclick="() => SelectAccount(account)">
                        <div style="display: flex; justify-content: space-between; align-items: start;">
                            <div>
                                <div style="font-size: 18px; font-weight: 700; color: #111827; margin-bottom: 4px;">@account.Customer?.FullName</div>
                                <div style="font-size: 14px; color: #5F6F52; font-weight: 600; margin-bottom: 8px;">@account.AccountNumber</div>
                                <div style="display: flex; gap: 16px; font-size: 13px; color: #6b7280;">
                                    <span>Balance: <strong style="color: #111827;">₱@account.Balance.ToString("N2")</strong></span>
                                    <span>Status: 
                                        <span style="background: @(account.IsActive ? "#D4E6D4" : "#fee2e2"); color: @(account.IsActive ? "#2F3E2A" : "#991b1b"); padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 600;">
                                            @(account.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </span>
                                </div>
                            </div>
                            <button style="background: #5F6F52; color: white; border: none; padding: 8px 16px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer;"
                                    @onclick:stopPropagation @onclick="() => SelectAccount(account)">
                                Select
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else if (hasSearched)
    {
        <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb; margin-bottom: 20px;">
            <h2 style="font-size: 16px; font-weight: 600; margin-bottom: 8px;">Results</h2>
            <p style="font-size: 13px; color: #6b7280;">No accounts found matching your search criteria.</p>
        </div>
    }
    else
    {
        <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
            <h2 style="font-size: 16px; font-weight: 600; margin-bottom: 8px;">Results</h2>
            <p style="font-size: 13px; color: #6b7280;">No account selected. Use the search above to verify an account.</p>
        </div>
    }

    @if (selectedAccount != null)
    {
        <div style="background: white; border-radius: 16px; padding: 24px; border: 2px solid #5F6F52;">
            <h2 style="font-size: 18px; font-weight: 700; margin-bottom: 20px; color: #5F6F52;">✓ Account Verified</h2>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
                <!-- Customer Info -->
                <div>
                    <h3 style="font-size: 14px; font-weight: 600; color: #6b7280; margin-bottom: 12px;">CUSTOMER INFORMATION</h3>
                    <div style="display: grid; gap: 8px;">
                        <div>
                            <span style="font-size: 12px; color: #6b7280;">Full Name</span>
                            <div style="font-size: 14px; font-weight: 600; color: #111827;">@selectedAccount.Customer?.FullName</div>
                        </div>
                        <div>
                            <span style="font-size: 12px; color: #6b7280;">Email</span>
                            <div style="font-size: 14px; color: #111827;">@selectedAccount.Customer?.Email</div>
                        </div>
                        <div>
                            <span style="font-size: 12px; color: #6b7280;">Phone</span>
                            <div style="font-size: 14px; color: #111827;">@selectedAccount.Customer?.PhoneNumber</div>
                        </div>
                    </div>
                </div>

                <!-- Account Info -->
                <div>
                    <h3 style="font-size: 14px; font-weight: 600; color: #6b7280; margin-bottom: 12px;">ACCOUNT INFORMATION</h3>
                    <div style="display: grid; gap: 8px;">
                        <div>
                            <span style="font-size: 12px; color: #6b7280;">Account Number</span>
                            <div style="font-size: 14px; font-weight: 600; color: #5F6F52;">@selectedAccount.AccountNumber</div>
                        </div>
                        <div>
                            <span style="font-size: 12px; color: #6b7280;">Current Balance</span>
                            <div style="font-size: 20px; font-weight: 700; color: #5F6F52;">₱@selectedAccount.Balance.ToString("N2")</div>
                        </div>
                        <div>
                            <span style="font-size: 12px; color: #6b7280;">Available Balance</span>
                            <div style="font-size: 14px; font-weight: 600; color: #0891b2;">₱@selectedAccount.AvailableBalance.ToString("N2")</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Admin Quick Actions -->
            <div style="margin-top: 24px; padding-top: 20px; border-top: 2px solid #e5e7eb;">
                <h3 style="font-size: 14px; font-weight: 700; color: #7c3aed; margin-bottom: 12px;">👑 Admin Quick Actions</h3>
                <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                    <button style="background: #5F6F52; color: white; border: none; padding: 10px 20px; border-radius: 8px; font-weight: 600; cursor: pointer;"
                            @onclick="() => NavigateToDeposit()">💰 Process Deposit</button>
                    <button style="background: #dc2626; color: white; border: none; padding: 10px 20px; border-radius: 8px; font-weight: 600; cursor: pointer;"
                            @onclick="() => NavigateToWithdraw()">💸 Process Withdrawal</button>
                    <button style="background: #2563eb; color: white; border: none; padding: 10px 20px; border-radius: 8px; font-weight: 600; cursor: pointer;"
                            @onclick="() => NavigateToTransactions()">📊 View Transactions</button>
                </div>
            </div>
        </div>
    }
</div>

<style>
    @@keyframes spin { to { transform: rotate(360deg); } }
</style>

@code {
    private string searchQuery = "";
    private bool isLoading = false;
    private bool hasSearched = false;
    private List<CustomerAccount> searchResults = new();
    private CustomerAccount? selectedAccount;

    protected override void OnInitialized()
    {
        // Verify admin access
        if (AuthService.CurrentRole != "SuperAdmin")
        {
            Navigation.NavigateTo("/admin");
        }
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
    }

    private async Task SearchAccount()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
            return;

        isLoading = true;
        hasSearched = true;
        selectedAccount = null;
        searchResults.Clear();

        try
        {
            using var context = await DbContextFactory.CreateDbContextAsync();
            var query = searchQuery.ToLower();

            searchResults = await context.CustomerAccounts
                .Include(a => a.Customer)
                .Where(a => a.AccountNumber.ToLower().Contains(query) ||
                           (a.Customer != null && a.Customer.FullName != null && a.Customer.FullName.ToLower().Contains(query)))
                .Take(10)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Search error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SelectAccount(CustomerAccount account)
    {
        selectedAccount = account;
    }

    private void NavigateToDeposit()
    {
        if (selectedAccount != null)
        {
            Navigation.NavigateTo($"/admin/teller-ops/deposits?account={selectedAccount.AccountNumber}");
        }
    }

    private void NavigateToWithdraw()
    {
        if (selectedAccount != null)
        {
            Navigation.NavigateTo($"/admin/teller-ops/withdrawals?account={selectedAccount.AccountNumber}");
        }
    }

    private void NavigateToTransactions()
    {
        if (selectedAccount != null)
        {
            Navigation.NavigateTo($"/admin/teller-ops/transactions?account={selectedAccount.AccountNumber}");
        }
    }
}
