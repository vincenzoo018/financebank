@page "/admin/teller-ops/daily-report"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@using Microsoft.EntityFrameworkCore
@inject AuthService AuthService
@inject IDbContextFactory<BFASDbContext> DbContextFactory
@inject TellerReportService ReportService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #059669 0%, #047857 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
                <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="3" y="4" width="18" height="18" rx="2"/>
                    <path d="M16 2v4M8 2v4M3 10h18"/>
                </svg>
            </div>
            <div>
                <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Daily Report</h1>
                <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Today's transaction summary</p>
            </div>
        </div>
        <button @onclick="ExportReport" style="display: flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.2); border: 2px solid white; padding: 10px 20px; border-radius: 8px; color: white; font-weight: 600; cursor: pointer;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Export Report
        </button>
    </div>
</div>

<!-- Admin Access Notice -->
<div style="background: #dbeafe; border: 2px solid #3b82f6; border-radius: 12px; padding: 16px; margin-bottom: 20px;">
    <p style="margin: 0; color: #1e40af; font-weight: 600; display: flex; align-items: center; gap: 8px;">
        <span style="font-size: 20px;">ℹ️</span>
        <strong>SuperAdmin Teller Operations Access</strong> - Full daily report with admin transaction visibility
    </p>
</div>

<!-- Summary Cards -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 24px;">
    <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb;">
        <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 8px;">Total Deposits</div>
        <div style="font-size: 28px; font-weight: 700; color: #059669; margin-bottom: 4px;">₱@totalDeposits.ToString("N2")</div>
        <div style="font-size: 12px; color: #6b7280;">@depositCount transactions</div>
    </div>
    <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb;">
        <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 8px;">Total Withdrawals</div>
        <div style="font-size: 28px; font-weight: 700; color: #dc2626; margin-bottom: 4px;">₱@totalWithdrawals.ToString("N2")</div>
        <div style="font-size: 12px; color: #6b7280;">@withdrawalCount transactions</div>
    </div>
    <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb;">
        <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 8px;">Loan Payments</div>
        <div style="font-size: 28px; font-weight: 700; color: #2563eb; margin-bottom: 4px;">₱@totalLoanPayments.ToString("N2")</div>
        <div style="font-size: 12px; color: #6b7280;">Cash received</div>
    </div>
    <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb;">
        <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 8px;">Loan Disbursements</div>
        <div style="font-size: 28px; font-weight: 700; color: #d97706; margin-bottom: 4px;">₱@totalLoanDisbursements.ToString("N2")</div>
        <div style="font-size: 12px; color: #6b7280;">Cash released</div>
    </div>
    <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb;">
        <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 8px;">Net Cash Flow</div>
        <div style="font-size: 28px; font-weight: 700; color: @(netCashFlow >= 0 ? "#059669" : "#dc2626"); margin-bottom: 4px;">₱@netCashFlow.ToString("N2")</div>
        <div style="font-size: 12px; color: #6b7280;">@(netCashFlow >= 0 ? "Positive" : "Negative")</div>
    </div>
    <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb;">
        <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 8px;">Total Transactions</div>
        <div style="font-size: 28px; font-weight: 700; color: #7c3aed; margin-bottom: 4px;">@totalTransactions</div>
        <div style="font-size: 12px; color: #6b7280;">Today's activity</div>
    </div>
</div>

<!-- Admin Transactions Summary -->
<div style="background: linear-gradient(135deg, #f3e8ff, #e9d5ff); border-radius: 16px; padding: 20px; border: 2px solid #c4b5fd; margin-bottom: 24px;">
    <h3 style="font-size: 16px; font-weight: 700; color: #7c3aed; margin-bottom: 12px;">👑 Admin Processed Transactions</h3>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 16px;">
        <div style="background: white; border-radius: 12px; padding: 16px; text-align: center;">
            <div style="font-size: 24px; font-weight: 700; color: #7c3aed;">@adminTransactionCount</div>
            <div style="font-size: 12px; color: #6b7280;">Transactions</div>
        </div>
        <div style="background: white; border-radius: 12px; padding: 16px; text-align: center;">
            <div style="font-size: 24px; font-weight: 700; color: #7c3aed;">₱@adminTransactionTotal.ToString("N0")</div>
            <div style="font-size: 12px; color: #6b7280;">Total Amount</div>
        </div>
    </div>
</div>

<!-- Transactions by Type -->
<div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb; margin-bottom: 24px;">
    <h2 style="font-size: 18px; font-weight: 600; color: #111827; margin-bottom: 16px;">Transactions by Type</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px;">
        @foreach (var type in transactionTypes)
        {
            <div style="background: #f9fafb; border-radius: 12px; padding: 16px; border: 1px solid #e5e7eb;">
                <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 8px;">@type.Key</div>
                <div style="font-size: 24px; font-weight: 700; color: #111827;">@type.Value</div>
            </div>
        }
    </div>
</div>

<!-- Today's Transactions Table -->
<div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
    <h2 style="font-size: 18px; font-weight: 600; color: #111827; margin-bottom: 16px;">Today's Transactions</h2>
    <div style="overflow-x:auto;">
        <table style="width:100%; border-collapse:collapse;">
            <thead>
                <tr style="background:#f9fafb; border-bottom:1px solid #e5e7eb;">
                    <th style="padding:12px; text-align:left; font-size:12px; color:#6b7280;">TIME</th>
                    <th style="padding:12px; text-align:left; font-size:12px; color:#6b7280;">ACCOUNT</th>
                    <th style="padding:12px; text-align:left; font-size:12px; color:#6b7280;">TYPE</th>
                    <th style="padding:12px; text-align:left; font-size:12px; color:#6b7280;">AMOUNT</th>
                    <th style="padding:12px; text-align:left; font-size:12px; color:#6b7280;">STATUS</th>
                    <th style="padding:12px; text-align:left; font-size:12px; color:#6b7280;">PROCESSED BY</th>
                </tr>
            </thead>
            <tbody>
                @if (todayTransactions.Any())
                {
                    @foreach (var txn in todayTransactions.OrderByDescending(t => t.CreatedAt))
                    {
                        var isAdminTxn = txn.Description?.Contains("[ADMIN") ?? false;
                        <tr style="border-bottom:1px solid #e5e7eb; @(isAdminTxn ? "background: #faf5ff;" : "")">
                            <td style="padding:12px; font-size:13px; color:#111827;">@txn.CreatedAt.ToString("HH:mm:ss")</td>
                            <td style="padding:12px; font-size:13px; color:#4b5563;">@txn.Account?.AccountNumber</td>
                            <td style="padding:12px; font-size:13px; color:#4b5563;">@txn.TransactionType</td>
                            <td style="padding:12px; font-size:13px; color:#111827; font-weight:600;">₱@txn.Amount.ToString("N2")</td>
                            <td style="padding:12px;">
                                <span style="display:inline-flex; align-items:center; padding:4px 10px; border-radius:999px; font-size:12px; font-weight:600; background:@GetStatusBg(txn.Status); color:@GetStatusColor(txn.Status);">
                                    @txn.Status
                                </span>
                            </td>
                            <td style="padding:12px;">
                                @if (isAdminTxn)
                                {
                                    <span style="display:inline-flex; align-items:center; padding:4px 10px; border-radius:8px; font-size:11px; font-weight:600; background:#f3e8ff; color:#7c3aed;">
                                        👑 Admin
                                    </span>
                                }
                                else
                                {
                                    <span style="font-size:13px; color:#6b7280;">Teller</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="padding:24px; text-align:center; font-size:14px; color:#6b7280;">No transactions today.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private decimal totalDeposits = 0;
    private decimal totalWithdrawals = 0;
    private decimal totalLoanPayments = 0;
    private decimal totalLoanDisbursements = 0;
    private decimal netCashFlow = 0;
    private int totalTransactions = 0;
    private int depositCount = 0;
    private int withdrawalCount = 0;
    private int adminTransactionCount = 0;
    private decimal adminTransactionTotal = 0;
    private List<CustomerTransaction> todayTransactions = new();
    private Dictionary<string, int> transactionTypes = new();

    protected override async Task OnInitializedAsync()
    {
        // Verify admin access
        if (AuthService.CurrentRole != "SuperAdmin")
        {
            Navigation.NavigateTo("/admin");
            return;
        }

        await LoadDailyReport();
    }

    private async Task LoadDailyReport()
    {
        try
        {
            var today = DateTime.Today;
            var tomorrow = today.AddDays(1);
            
            using var context = await DbContextFactory.CreateDbContextAsync();
            
            // Load today's transactions directly from database (efficient single query)
            todayTransactions = await context.CustomerTransactions
                .Include(t => t.Account)
                .Where(t => t.CreatedAt >= today && t.CreatedAt < tomorrow)
                .OrderByDescending(t => t.CreatedAt)
                .ToListAsync();
            
            // Calculate deposits
            var completedDeposits = todayTransactions
                .Where(t => t.TransactionType == "Deposit" && t.Status == "Completed")
                .ToList();
            totalDeposits = completedDeposits.Sum(t => t.Amount);
            depositCount = completedDeposits.Count;
            
            // Calculate withdrawals
            var completedWithdrawals = todayTransactions
                .Where(t => t.TransactionType == "Withdrawal" && t.Status == "Completed")
                .ToList();
            totalWithdrawals = completedWithdrawals.Sum(t => t.Amount);
            withdrawalCount = completedWithdrawals.Count;
            
            // Get loan payments for today
            totalLoanPayments = await context.LoanPayments
                .Where(p => p.PaymentDate >= today && p.PaymentDate < tomorrow)
                .SumAsync(p => (decimal?)p.PaymentAmount) ?? 0;
            
            // Get loan disbursements for today
            totalLoanDisbursements = await context.LoanDisbursals
                .Where(d => d.DisbursalDate >= today && d.DisbursalDate < tomorrow)
                .SumAsync(d => (decimal?)d.DisbursalAmount) ?? 0;
            
            // Calculate net cash flow (deposits + loan payments - withdrawals - loan disbursements)
            netCashFlow = totalDeposits + totalLoanPayments - totalWithdrawals - totalLoanDisbursements;
            totalTransactions = todayTransactions.Count(t => t.Status == "Completed");
            
            // Calculate admin processed transactions
            var adminTxns = todayTransactions.Where(t => t.Description?.Contains("[ADMIN") ?? false).ToList();
            adminTransactionCount = adminTxns.Count;
            adminTransactionTotal = adminTxns.Sum(t => t.Amount);
            
            // Group by transaction type
            transactionTypes = todayTransactions
                .GroupBy(t => t.TransactionType)
                .ToDictionary(g => g.Key, g => g.Count());
            
            // Add loan transactions to type breakdown
            var loanPaymentCount = await context.LoanPayments
                .Where(p => p.PaymentDate >= today && p.PaymentDate < tomorrow)
                .CountAsync();
            if (loanPaymentCount > 0)
                transactionTypes["Loan Payment"] = loanPaymentCount;
            
            var loanDisbursementCount = await context.LoanDisbursals
                .Where(d => d.DisbursalDate >= today && d.DisbursalDate < tomorrow)
                .CountAsync();
            if (loanDisbursementCount > 0)
                transactionTypes["Loan Disbursement"] = loanDisbursementCount;
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error loading daily report: {ex.Message}");
        }
    }

    private async Task ExportReport()
    {
        try
        {
            var today = DateTime.Today;
            var sb = new System.Text.StringBuilder();
            sb.AppendLine("Daily Report - " + today.ToString("MMMM dd, yyyy"));
            sb.AppendLine("Generated by: " + (AuthService.CurrentUser ?? "Admin"));
            sb.AppendLine("");
            sb.AppendLine("SUMMARY");
            sb.AppendLine($"Total Deposits: ₱{totalDeposits:N2} ({depositCount} transactions)");
            sb.AppendLine($"Total Withdrawals: ₱{totalWithdrawals:N2} ({withdrawalCount} transactions)");
            sb.AppendLine($"Loan Payments: ₱{totalLoanPayments:N2}");
            sb.AppendLine($"Loan Disbursements: ₱{totalLoanDisbursements:N2}");
            sb.AppendLine($"Net Cash Flow: ₱{netCashFlow:N2}");
            sb.AppendLine($"Admin Transactions: {adminTransactionCount} (₱{adminTransactionTotal:N2})");
            sb.AppendLine("");
            sb.AppendLine("TRANSACTIONS");
            sb.AppendLine("Time,Account,Type,Amount,Status,ProcessedBy");
            foreach (var txn in todayTransactions.OrderByDescending(t => t.CreatedAt))
            {
                var isAdmin = txn.Description?.Contains("[ADMIN") ?? false;
                sb.AppendLine($"{txn.CreatedAt:HH:mm:ss},{txn.Account?.AccountNumber},{txn.TransactionType},{txn.Amount:N2},{txn.Status},{(isAdmin ? "Admin" : "Teller")}");
            }
            
            var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
            var base64 = Convert.ToBase64String(bytes);
            var fileName = $"Admin_DailyReport_{today:yyyyMMdd}.csv";
            
            await JS.InvokeVoidAsync("eval", $@"
                var link = document.createElement('a');
                link.href = 'data:text/csv;base64,{base64}';
                link.download = '{fileName}';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            ");
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error exporting report: {ex.Message}");
        }
    }

    private string GetStatusBg(string status)
    {
        return status switch
        {
            "Completed" => "#d1fae5",
            "Pending" => "#fef3c7",
            "Failed" => "#fee2e2",
            _ => "#f3f4f6"
        };
    }

    private string GetStatusColor(string status)
    {
        return status switch
        {
            "Completed" => "#065f46",
            "Pending" => "#92400e",
            "Failed" => "#b91c1c",
            _ => "#4b5563"
        };
    }
}
