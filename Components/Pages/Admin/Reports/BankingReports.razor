@page "/admin/reports/banking"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@inject BankingReportService BankingReportService
@inject AuthService AuthService

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #1f2937 0%, #111827 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
            <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path d="M3 3h18v4H3zM3 9h18v12H3z" />
            </svg>
        </div>
        <div>
            <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Banking Reports</h1>
            <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Generate and review summarized banking activity</p>
        </div>
    </div>
</div>

<!-- Filters & Generate -->
<div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb; margin-bottom: 20px; display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end;">
    <div style="flex: 1 1 180px;">
        <label style="display:block; font-size:12px; font-weight:600; color:#374151; margin-bottom:4px;">Period Start</label>
        <input type="date" class="form-control" @bind="periodStart" />
    </div>
    <div style="flex: 1 1 180px;">
        <label style="display:block; font-size:12px; font-weight:600; color:#374151; margin-bottom:4px;">Period End</label>
        <input type="date" class="form-control" @bind="periodEnd" />
    </div>
    <div style="flex: 1 1 200px;">
        <label style="display:block; font-size:12px; font-weight:600; color:#374151; margin-bottom:4px;">Quick Range</label>
        <select class="form-control" @onchange="OnQuickRangeChanged">
            <option value="">Custom Range</option>
            <option value="this-month">This Month</option>
            <option value="last-month">Last Month</option>
            <option value="last-7">Last 7 Days</option>
            <option value="last-30">Last 30 Days</option>
        </select>
    </div>
    <div style="flex: 0 0 auto; display:flex; gap:8px;">
        <button class="btn" style="background:#f3f4f6; color:#111827; padding:8px 16px; border-radius:8px; font-size:14px;" @onclick="ReloadReports">Refresh</button>
        <button class="btn" style="background:#059669; color:white; padding:8px 16px; border-radius:8px; font-size:14px;" @onclick="GenerateReport">Generate Report</button>
    </div>
</div>

<!-- Reports Table -->
<div style="background:white; border-radius:16px; border:1px solid #e5e7eb; overflow:hidden;">
    <table style="width:100%; border-collapse:collapse;">
        <thead>
            <tr style="background:#f9fafb; border-bottom:1px solid #e5e7eb;">
                <th style="padding:12px; text-align:left; font-size:12px; color:#6b7280;">REPORT NAME</th>
                <th style="padding:12px; text-align:left; font-size:12px; color:#6b7280;">TYPE</th>
                <th style="padding:12px; text-align:left; font-size:12px; color:#6b7280;">PERIOD</th>
                <th style="padding:12px; text-align:left; font-size:12px; color:#6b7280;">GENERATED BY</th>
                <th style="padding:12px; text-align:left; font-size:12px; color:#6b7280;">GENERATED AT</th>
                <th style="padding:12px; text-align:center; font-size:12px; color:#6b7280;">ACTIONS</th>
            </tr>
        </thead>
        <tbody>
            @if (reports.Any())
            {
                @foreach (var r in reports)
                {
                    <tr style="border-bottom:1px solid #e5e7eb;">
                        <td style="padding:12px; font-size:14px; color:#111827; font-weight:500;">@r.ReportName</td>
                        <td style="padding:12px; font-size:13px; color:#6b7280;">@r.ReportType</td>
                        <td style="padding:12px; font-size:13px; color:#4b5563;">@r.PeriodStart.ToString("yyyy-MM-dd") - @r.PeriodEnd.ToString("yyyy-MM-dd")</td>
                        <td style="padding:12px; font-size:13px; color:#6b7280;">@r.GeneratedBy</td>
                        <td style="padding:12px; font-size:13px; color:#6b7280;">@r.GeneratedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td style="padding:12px; text-align:center;">
                            <button class="btn" style="background:#111827; color:white; padding:6px 12px; font-size:12px; border-radius:6px;" @onclick="() => OpenReport(r)">View</button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" style="padding:24px; text-align:center; font-size:14px; color:#6b7280;">No banking reports generated yet. Use the Generate Report button above.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- View Report Modal -->
@if (showReportModal && selectedReport != null)
{
    <div @onclick="CloseReportModal" style="position:fixed; inset:0; background:rgba(0,0,0,0.45); display:flex; align-items:center; justify-content:center; z-index:1000; padding:20px;">
        <div @onclick:stopPropagation style="background:white; border-radius:16px; max-width:700px; width:100%; max-height:80vh; display:flex; flex-direction:column; box-shadow:0 20px 60px rgba(0,0,0,0.3);">
            <div style="padding:20px 24px; border-bottom:1px solid #e5e7eb; display:flex; justify-content:space-between; align-items:center;">
                <div>
                    <h3 style="font-size:20px; font-weight:700; color:#111827; margin:0;">@selectedReport.ReportName</h3>
                    <p style="font-size:13px; color:#6b7280; margin:4px 0 0 0;">@selectedReport.ReportType · @selectedReport.PeriodStart.ToString("yyyy-MM-dd") - @selectedReport.PeriodEnd.ToString("yyyy-MM-dd")</p>
                </div>
                <button @onclick="CloseReportModal" style="background:none; border:none; font-size:22px; color:#6b7280; cursor:pointer;">×</button>
            </div>
            <div style="padding:16px 24px; overflow:auto; font-family:ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace; font-size:13px; white-space:pre-wrap;">
                @selectedReport.Data
            </div>
            <div style="padding:16px 24px; border-top:1px solid #e5e7eb; display:flex; justify-content:flex-end; gap:8px;">
                <button class="btn" style="background:#f3f4f6; color:#111827; padding:8px 16px; border-radius:8px; font-size:14px;" @onclick="CloseReportModal">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private List<BankingReport> reports = new();
    private DateTime periodStart = DateTime.Today.AddMonths(-1);
    private DateTime periodEnd = DateTime.Today;

    private bool showReportModal = false;
    private BankingReport? selectedReport;

    protected override async Task OnInitializedAsync()
    {
        // Default to current month
        var now = DateTime.Today;
        var firstOfMonth = new DateTime(now.Year, now.Month, 1);
        periodStart = firstOfMonth;
        periodEnd = now;

        await ReloadReports();
    }

    private async Task ReloadReports()
    {
        reports = await BankingReportService.GetAllAsync();
    }

    private void OnQuickRangeChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        var today = DateTime.Today;

        if (value == "this-month")
        {
            var start = new DateTime(today.Year, today.Month, 1);
            periodStart = start;
            periodEnd = today;
        }
        else if (value == "last-month")
        {
            var lastMonth = today.AddMonths(-1);
            var start = new DateTime(lastMonth.Year, lastMonth.Month, 1);
            var end = start.AddMonths(1).AddDays(-1);
            periodStart = start;
            periodEnd = end;
        }
        else if (value == "last-7")
        {
            var start = today.AddDays(-6);
            periodStart = start;
            periodEnd = today;
        }
        else if (value == "last-30")
        {
            var start = today.AddDays(-29);
            periodStart = start;
            periodEnd = today;
        }
    }

    private async Task GenerateReport()
    {
        var start = periodStart;
        var end = periodEnd;

        if (end < start)
        {
            var tmp = start;
            start = end;
            end = tmp;
        }

        var user = AuthService.FullName ?? AuthService.CurrentUser ?? "system";
        var report = await BankingReportService.GenerateSummaryAsync(start, end, user);
        reports.Insert(0, report);
    }

    private void OpenReport(BankingReport report)
    {
        selectedReport = report;
        showReportModal = true;
    }

    private void CloseReportModal()
    {
        showReportModal = false;
        selectedReport = null;
    }
}
