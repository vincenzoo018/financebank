@page "/admin/system/roles"
@layout AdminLayout
@using FinanceBank.Data
@using FinanceBank.Services
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Roles & Permissions - FINSYS</PageTitle>

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; justify-content: space-between;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
                <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
            </div>
            <div>
                <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Roles & Permissions</h1>
                <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Manage system roles and access control</p>
            </div>
        </div>
        <button style="background: white; color: #6366f1; padding: 10px 18px; font-weight: 600; border-radius: 8px; font-size: 14px; cursor: pointer; border: none;" @onclick="OpenAddRoleModal">
            + New Role
        </button>
    </div>
</div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div style="padding: 16px; background: #d1fae5; border: 1px solid #10b981; border-radius: 12px; color: #065f46; margin-bottom: 20px; font-size: 14px; display: flex; justify-content: space-between; align-items: center;">
            <strong>Success:</strong> @successMessage
            <button type="button" style="background: none; border: none; color: #065f46; cursor: pointer; font-size: 18px;" @onclick="() => successMessage = string.Empty">✕</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div style="padding: 16px; background: #fee2e2; border: 1px solid #dc2626; border-radius: 12px; color: #991b1b; margin-bottom: 20px; font-size: 14px; display: flex; justify-content: space-between; align-items: center;">
            <strong>Error:</strong> @errorMessage
            <button type="button" style="background: none; border: none; color: #991b1b; cursor: pointer; font-size: 18px;" @onclick="() => errorMessage = string.Empty">✕</button>
        </div>
    }

<div style="background: white; border: 1px solid #e5e7eb; border-radius: 16px; overflow: hidden;">
    <div style="border-bottom: 1px solid #e5e7eb; padding: 20px;">
        <h3 style="font-size: 18px; font-weight: 600; color: #111827; margin: 0;">System Roles</h3>
    </div>
    <div style="padding: 20px;">
            @if (roles == null)
            {
                <div style="text-align: center; padding: 32px; color: #6b7280;">
                    <p>Loading roles...</p>
                </div>
            }
            else if (roles.Count == 0)
            {
                <div style="text-align: center; padding: 32px; color: #6b7280;">
                    <p>No roles found</p>
                </div>
            }
            else
            {
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="border-bottom: 2px solid #e5e7eb; background: #f9fafb;">
                                <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280; font-weight: 600;">ROLE NAME</th>
                                <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280; font-weight: 600;">DESCRIPTION</th>
                                <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280; font-weight: 600;">PERMISSIONS</th>
                                <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280; font-weight: 600;">STATUS</th>
                                <th style="padding: 12px; text-align: center; font-size: 12px; color: #6b7280; font-weight: 600;">ACTIONS</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var role in roles)
                            {
                                <tr style="border-bottom: 1px solid #e5e7eb;">
                                    <td style="padding: 12px; font-size: 13px; color: #111827; font-weight: 600;">@role.Name</td>
                                    <td style="padding: 12px; font-size: 13px; color: #6b7280;">@(string.IsNullOrEmpty(role.Description) ? "N/A" : role.Description)</td>
                                    <td style="padding: 12px; font-size: 13px;">
                                        <div style="display: flex; gap: 4px; flex-wrap: wrap;">
                                            @foreach (var perm in role.Permissions)
                                            {
                                                <span style="display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 999px; font-size: 11px; font-weight: 600; background: #dbeafe; color: #1e40af;">
                                                    @perm
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td style="padding: 12px; font-size: 13px;">
                                        <span style="display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 999px; font-size: 11px; font-weight: 600; background: #d1fae5; color: #065f46;">
                                            Active
                                        </span>
                                    </td>
                                    <td style="padding: 12px; text-align: center; display: flex; gap: 6px; justify-content: center;">
                                        <button style="background: #6366f1; color: white; padding: 6px 12px; border-radius: 6px; font-weight: 600; font-size: 12px; cursor: pointer; border: none;" @onclick="() => EditRole(role)">Edit</button>
                                        @if (!role.IsSystemRole)
                                        {
                                            <button style="background: #dc2626; color: white; padding: 6px 12px; border-radius: 6px; font-weight: 600; font-size: 12px; cursor: pointer; border: none;" @onclick="() => DeleteRole(role)">Delete</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
    </div>
</div>

<!-- Add/Edit Role Modal -->
@if (showModal)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000;" @onclick="CloseModal">
        <div style="background: white; border-radius: 16px; padding: 32px; width: 90%; max-width: 600px; box-shadow: 0 20px 25px rgba(0,0,0,0.1);" @onclick:stopPropagation="true">
            <h2 style="font-size: 20px; font-weight: 700; color: #111827; margin: 0 0 24px 0;">@(editingRole?.Id > 0 ? "Edit Role" : "Add New Role")</h2>
            
            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 6px;">Role Name *</label>
                <input type="text" placeholder="Enter role name" @bind="editingRole.Name" style="width: 100%; padding: 10px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;" />
            </div>

            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 6px;">Description</label>
                <textarea placeholder="Enter description" @bind="editingRole.Description" rows="3" style="width: 100%; padding: 10px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px; resize: vertical;"></textarea>
            </div>

            <div style="margin-bottom: 24px;">
                <label style="display: block; font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 8px;">Permissions</label>
                <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px;">
                    @foreach (var perm in availablePermissions)
                    {
                        <label style="display: flex; align-items: center; gap: 8px; padding: 8px; border: 1px solid #e5e7eb; border-radius: 6px; cursor: pointer;">
                            <input type="checkbox" checked="@editingRole.Permissions.Contains(perm)" @onchange="@(e => TogglePermission(perm, (bool)e.Value))" />
                            <span style="font-size: 13px; color: #374151;">@perm</span>
                        </label>
                    }
                </div>
            </div>

            <div style="display: flex; gap: 12px; justify-content: flex-end;">
                <button style="background: #e5e7eb; color: #111827; padding: 10px 18px; font-weight: 600; border-radius: 8px; cursor: pointer; border: none;" @onclick="CloseModal">Cancel</button>
                <button style="background: #6366f1; color: white; padding: 10px 18px; font-weight: 600; border-radius: 8px; cursor: pointer; border: none;" @onclick="SaveRole">Save Role</button>
            </div>
        </div>
    </div>
}

@code {
    private List<RoleModel> roles = new();
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;
    private bool showModal = false;
    private RoleModel editingRole = new();
    private List<string> availablePermissions = new() { "Create", "Read", "Update", "Delete", "Approve", "Export", "Import", "Manage Users" };

    private class RoleModel
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public List<string> Permissions { get; set; } = new();
        public bool IsSystemRole { get; set; } = false;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Check authorization
            if (!AuthService.HasRole(AuthService.Roles.SuperAdmin))
            {
                Navigation.NavigateTo("/admin/dashboard");
                return;
            }

            // Load available roles from the system
            var rolesList = new List<RoleModel>
            {
                new() { Id = 1, Name = AuthService.Roles.SuperAdmin, Description = "Full system access with all permissions", Permissions = new() { "Create", "Read", "Update", "Delete", "Approve", "Export", "Import", "Manage Users" }, IsSystemRole = true },
                new() { Id = 2, Name = AuthService.Roles.Admin, Description = "Administrative access with most permissions", Permissions = new() { "Create", "Read", "Update", "Delete", "Approve" }, IsSystemRole = true },
                new() { Id = 3, Name = AuthService.Roles.Accountant, Description = "Accounting operations and financial reporting", Permissions = new() { "Create", "Read", "Update", "Export" }, IsSystemRole = true },
                new() { Id = 4, Name = AuthService.Roles.FinanceManager, Description = "Finance management and budget control", Permissions = new() { "Create", "Read", "Update", "Approve", "Export" }, IsSystemRole = true },
                new() { Id = 5, Name = AuthService.Roles.Teller, Description = "Customer service and transaction processing", Permissions = new() { "Read", "Create" }, IsSystemRole = true },
                new() { Id = 6, Name = AuthService.Roles.Customer, Description = "Customer account access", Permissions = new() { "Read" }, IsSystemRole = true }
            };

            roles = rolesList;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading roles: {ex.Message}";
        }
        
        await Task.CompletedTask;
    }

    private void OpenAddRoleModal()
    {
        editingRole = new RoleModel();
        errorMessage = string.Empty;
        successMessage = string.Empty;
        showModal = true;
    }

    private void EditRole(RoleModel role)
    {
        editingRole = new RoleModel
        {
            Id = role.Id,
            Name = role.Name,
            Description = role.Description,
            Permissions = new List<string>(role.Permissions),
            IsSystemRole = role.IsSystemRole
        };
        errorMessage = string.Empty;
        successMessage = string.Empty;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        editingRole = new();
    }

    private void TogglePermission(string permission, bool isChecked)
    {
        if (isChecked && !editingRole.Permissions.Contains(permission))
        {
            editingRole.Permissions.Add(permission);
        }
        else if (!isChecked && editingRole.Permissions.Contains(permission))
        {
            editingRole.Permissions.Remove(permission);
        }
    }

    private async Task SaveRole()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(editingRole.Name))
            {
                errorMessage = "Role name is required";
                return;
            }

            if (editingRole.Permissions.Count == 0)
            {
                errorMessage = "At least one permission must be selected";
                return;
            }

            if (editingRole.Id == 0)
            {
                // Add new role
                editingRole.Id = roles.Count > 0 ? roles.Max(r => r.Id) + 1 : 1;
                roles.Add(editingRole);
                successMessage = $"Role '{editingRole.Name}' created successfully";
            }
            else
            {
                // Update existing role
                var index = roles.FindIndex(r => r.Id == editingRole.Id);
                if (index >= 0)
                {
                    roles[index] = editingRole;
                    successMessage = $"Role '{editingRole.Name}' updated successfully";
                }
            }

            showModal = false;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving role: {ex.Message}";
        }
        
        await Task.CompletedTask;
    }

    private async Task DeleteRole(RoleModel role)
    {
        try
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
                $"Are you sure you want to delete the role '{role.Name}'?");
            
            if (!confirmed)
                return;

            roles.Remove(role);
            successMessage = $"Role '{role.Name}' deleted successfully";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting role: {ex.Message}";
        }
    }
}
