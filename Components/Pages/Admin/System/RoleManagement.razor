@page "/admin/system/roles"
@using FinanceBank.Data
@using FinanceBank.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Roles & Permissions - FINSYS</PageTitle>

<div class="page-container">
    <div class="page-header">
        <div class="header-content">
            <h1>Roles & Permissions Management</h1>
            <p class="header-subtitle">Manage system roles and their associated permissions</p>
        </div>
        <button class="btn btn-primary" @onclick="OpenAddRoleModal">
            <span>+ New Role</span>
        </button>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
        </div>
    }

    <div class="card">
        <div class="card-header">
            <h3>System Roles</h3>
        </div>
        <div class="card-body">
            @if (roles == null)
            {
                <div class="text-center py-4">
                    <p>Loading roles...</p>
                </div>
            }
            else if (roles.Count == 0)
            {
                <div class="text-center py-4">
                    <p class="text-muted">No roles found</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Role Name</th>
                                <th>Description</th>
                                <th>Permissions</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var role in roles)
                            {
                                <tr>
                                    <td><strong>@role.Name</strong></td>
                                    <td>@(string.IsNullOrEmpty(role.Description) ? "N/A" : role.Description)</td>
                                    <td>
                                        <small class="badge bg-info">@role.Permissions?.Count() permissions</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-success">Active</span>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => EditRole(role)">Edit</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteRole(role)">Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<RoleModel> roles = new();
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;

    private class RoleModel
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public List<string> Permissions { get; set; } = new();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Check authorization
            if (!AuthService.HasRole(AuthService.Roles.SuperAdmin))
            {
                Navigation.NavigateTo("/admin/dashboard");
                return;
            }

            // Load available roles from the system
            var rolesList = new List<RoleModel>
            {
                new() { Id = 1, Name = AuthService.Roles.SuperAdmin, Description = "Full system access", Permissions = new() { "Create", "Read", "Update", "Delete" } },
                new() { Id = 2, Name = AuthService.Roles.Admin, Description = "Administrative access", Permissions = new() { "Create", "Read", "Update" } },
                new() { Id = 3, Name = AuthService.Roles.Accountant, Description = "Accounting operations", Permissions = new() { "Read", "Update" } },
                new() { Id = 4, Name = AuthService.Roles.FinanceManager, Description = "Finance management", Permissions = new() { "Read", "Update" } },
                new() { Id = 5, Name = AuthService.Roles.Teller, Description = "Teller operations", Permissions = new() { "Read" } },
                new() { Id = 6, Name = AuthService.Roles.Customer, Description = "Customer access", Permissions = new() { "Read" } }
            };

            roles = rolesList;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading roles: {ex.Message}";
        }
    }

    private void OpenAddRoleModal()
    {
        successMessage = "Feature coming soon: Add new role functionality";
    }

    private void EditRole(RoleModel role)
    {
        successMessage = $"Editing role: {role.Name}";
    }

    private async Task DeleteRole(RoleModel role)
    {
        try
        {
            // Remove from list
            roles.Remove(role);
            successMessage = $"Role '{role.Name}' deleted successfully";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting role: {ex.Message}";
        }
    }
}
