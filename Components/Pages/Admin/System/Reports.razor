@page "/admin/system/reports"
@layout AdminLayout
@namespace FinanceBank.Components.Pages.Admin.System

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
            <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path>
                <polyline points="13 2 13 9 20 9"></polyline>
            </svg>
        </div>
        <div>
            <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">System Reports</h1>
            <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">System performance and audit reports</p>
        </div>
    </div>
</div>

<!-- Report Cards -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-bottom: 24px;">
    <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
            <div style="background: #dbeafe; border-radius: 8px; padding: 10px;">
                <svg width="20" height="20" fill="none" stroke="#3b82f6" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 11l3 3L22 4"></path>
                    <path d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
            </div>
            <h3 style="font-size: 16px; font-weight: 700; color: #1f2937; margin: 0;">System Health</h3>
        </div>
        <p style="font-size: 14px; color: #6b7280; margin: 0 0 16px 0;">Monitor system performance, uptime, and resource usage</p>
        <button class="btn" style="background: #3b82f6; color: white; border: none; padding: 10px 16px; border-radius: 8px; cursor: pointer; width: 100%; font-weight: 600;">View Report</button>
    </div>

    <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
            <div style="background: #f0fdf4; border-radius: 8px; padding: 10px;">
                <svg width="20" height="20" fill="none" stroke="#16a34a" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M12 8v8m4-4H8"></path>
                    <circle cx="12" cy="12" r="9"></circle>
                </svg>
            </div>
            <h3 style="font-size: 16px; font-weight: 700; color: #1f2937; margin: 0;">Activity Logs</h3>
        </div>
        <p style="font-size: 14px; color: #6b7280; margin: 0 0 16px 0;">Track all system activities, logins, and user actions</p>
        <button class="btn" style="background: #16a34a; color: white; border: none; padding: 10px 16px; border-radius: 8px; cursor: pointer; width: 100%; font-weight: 600;">View Report</button>
    </div>

    <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
            <div style="background: #fef3c7; border-radius: 8px; padding: 10px;">
                <svg width="20" height="20" fill="none" stroke="#d97706" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M12 9v2m0 4v2m0 4v.01"></path>
                    <circle cx="12" cy="12" r="9"></circle>
                </svg>
            </div>
            <h3 style="font-size: 16px; font-weight: 700; color: #1f2937; margin: 0;">Error Logs</h3>
        </div>
        <p style="font-size: 14px; color: #6b7280; margin: 0 0 16px 0;">Review system errors and warnings for troubleshooting</p>
        <button class="btn" style="background: #d97706; color: white; border: none; padding: 10px 16px; border-radius: 8px; cursor: pointer; width: 100%; font-weight: 600;">View Report</button>
    </div>

    <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
            <div style="background: #f5f3ff; border-radius: 8px; padding: 10px;">
                <svg width="20" height="20" fill="none" stroke="#8b5cf6" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                </svg>
            </div>
            <h3 style="font-size: 16px; font-weight: 700; color: #1f2937; margin: 0;">Database Reports</h3>
        </div>
        <p style="font-size: 14px; color: #6b7280; margin: 0 0 16px 0;">Database health, backups, and integrity checks</p>
        <button class="btn" style="background: #8b5cf6; color: white; border: none; padding: 10px 16px; border-radius: 8px; cursor: pointer; width: 100%; font-weight: 600;">View Report</button>
    </div>
</div>

@code {
}
