@page "/admin/system/finance-manager-reports"
@layout AdminLayout
@*@inherits AuthorizedPageBase*@

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #059669 0%, #047857 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
            <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
        </div>
        <div>
            <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Finance Manager Reports</h1>
            <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Financial analysis and management reports</p>
        </div>
    </div>
</div>

<!-- Report Categories -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-bottom: 24px;">
    <!-- Budget Reports -->
    <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
            <div style="background: #d1fae5; border-radius: 8px; padding: 10px;">
                <svg width="20" height="20" fill="none" stroke="#059669" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                </svg>
            </div>
            <h3 style="font-size: 16px; font-weight: 700; color: #1f2937; margin: 0;">Budget Reports</h3>
        </div>
        <div style="display: flex; flex-direction: column; gap: 8px;">
            <button @onclick='() => ShowReportModal("Budget vs Actual")' class="btn" style="background: #f9fafb; border: 1px solid #e5e7eb; color: #374151; padding: 10px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 14px;">Budget vs Actual</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7"/>
                </svg>
            </button>
            <button @onclick='() => ShowReportModal("Budget Variance Analysis")' class="btn" style="background: #f9fafb; border: 1px solid #e5e7eb; color: #374151; padding: 10px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 14px;">Variance Analysis</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7"/>
                </svg>
            </button>
            <button @onclick='() => ShowReportModal("Department Budget Summary")' class="btn" style="background: #f9fafb; border: 1px solid #e5e7eb; color: #374151; padding: 10px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 14px;">Department Summary</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7"/>
                </svg>
            </button>
            <button @onclick='() => ShowReportModal("Budget Utilization")' class="btn" style="background: #f9fafb; border: 1px solid #e5e7eb; color: #374151; padding: 10px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 14px;">Budget Utilization</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7"/>
                </svg>
            </button>
        </div>
    </div>

    <!-- Cash Flow Reports -->
    <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
            <div style="background: #dbeafe; border-radius: 8px; padding: 10px;">
                <svg width="20" height="20" fill="none" stroke="#0891b2" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"/>
                </svg>
            </div>
            <h3 style="font-size: 16px; font-weight: 700; color: #1f2937; margin: 0;">Cash Flow Reports</h3>
        </div>
        <div style="display: flex; flex-direction: column; gap: 8px;">
            <button @onclick='() => ShowReportModal("Cash Flow Statement")' class="btn" style="background: #f9fafb; border: 1px solid #e5e7eb; color: #374151; padding: 10px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 14px;">Cash Flow Statement</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7"/>
                </svg>
            </button>
            <button @onclick='() => ShowReportModal("Cash Position Report")' class="btn" style="background: #f9fafb; border: 1px solid #e5e7eb; color: #374151; padding: 10px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 14px;">Cash Position</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7"/>
                </svg>
            </button>
            <button @onclick='() => ShowReportModal("Cash Flow Forecast")' class="btn" style="background: #f9fafb; border: 1px solid #e5e7eb; color: #374151; padding: 10px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 14px;">Cash Flow Forecast</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7"/>
                </svg>
            </button>
            <button @onclick='() => ShowReportModal("Liquidity Analysis")' class="btn" style="background: #f9fafb; border: 1px solid #e5e7eb; color: #374151; padding: 10px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 14px;">Liquidity Analysis</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7"/>
                </svg>
            </button>
        </div>
    </div>

    <!-- AR/AP Reports -->
    <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
            <div style="background: #fef3c7; border-radius: 8px; padding: 10px;">
                <svg width="20" height="20" fill="none" stroke="#f59e0b" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                </svg>
            </div>
            <h3 style="font-size: 16px; font-weight: 700; color: #1f2937; margin: 0;">AR/AP Reports</h3>
        </div>
        <div style="display: flex; flex-direction: column; gap: 8px;">
            <button @onclick='() => ShowReportModal("Accounts Receivable Aging")' class="btn" style="background: #f9fafb; border: 1px solid #e5e7eb; color: #374151; padding: 10px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 14px;">AR Aging Report</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7"/>
                </svg>
            </button>
            <button @onclick='() => ShowReportModal("Accounts Payable Aging")' class="btn" style="background: #f9fafb; border: 1px solid #e5e7eb; color: #374151; padding: 10px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 14px;">AP Aging Report</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7"/>
                </svg>
            </button>
            <button @onclick='() => ShowReportModal("Collection Report")' class="btn" style="background: #f9fafb; border: 1px solid #e5e7eb; color: #374151; padding: 10px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 14px;">Collection Report</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7"/>
                </svg>
            </button>
            <button @onclick='() => ShowReportModal("Payment Schedule")' class="btn" style="background: #f9fafb; border: 1px solid #e5e7eb; color: #374151; padding: 10px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 14px;">Payment Schedule</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7"/>
                </svg>
            </button>
        </div>
    </div>

    <!-- Financial Analysis -->
    <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
            <div style="background: #e0e7ff; border-radius: 8px; padding: 10px;">
                <svg width="20" height="20" fill="none" stroke="#6366f1" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                </svg>
            </div>
            <h3 style="font-size: 16px; font-weight: 700; color: #1f2937; margin: 0;">Financial Analysis</h3>
        </div>
        <div style="display: flex; flex-direction: column; gap: 8px;">
            <button @onclick='() => ShowReportModal("Financial Ratios")' class="btn" style="background: #f9fafb; border: 1px solid #e5e7eb; color: #374151; padding: 10px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 14px;">Financial Ratios</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7"/>
                </svg>
            </button>
            <button @onclick='() => ShowReportModal("Profitability Analysis")' class="btn" style="background: #f9fafb; border: 1px solid #e5e7eb; color: #374151; padding: 10px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 14px;">Profitability Analysis</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7"/>
                </svg>
            </button>
            <button @onclick='() => ShowReportModal("Trend Analysis")' class="btn" style="background: #f9fafb; border: 1px solid #e5e7eb; color: #374151; padding: 10px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 14px;">Trend Analysis</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7"/>
                </svg>
            </button>
            <button @onclick='() => ShowReportModal("Financial Forecast")' class="btn" style="background: #f9fafb; border: 1px solid #e5e7eb; color: #374151; padding: 10px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 14px;">Financial Forecast</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7"/>
                </svg>
            </button>
        </div>
    </div>
</div>

<!-- Report Generation Modal -->
@if (showReportModal)
{
    <div @onclick="CloseReportModal" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000; padding: 20px;">
        <div @onclick:stopPropagation style="background: white; border-radius: 16px; max-width: 600px; width: 100%; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
            <div style="padding: 24px; border-bottom: 1px solid #e5e7eb;">
                <h3 style="font-size: 20px; font-weight: 700; color: #1f2937; margin: 0;">Generate @selectedReportType</h3>
                <p style="font-size: 14px; color: #6b7280; margin: 4px 0 0 0;">Configure report parameters</p>
            </div>
            
            <div style="padding: 24px;">
                <div style="margin-bottom: 20px;">
                    <label style="display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 6px;">Report Period</label>
                    <select style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;">
                        <option>Current Month</option>
                        <option>Last Month</option>
                        <option>Current Quarter</option>
                        <option>Last Quarter</option>
                        <option>Current Year</option>
                        <option>Last Year</option>
                        <option>Custom Date Range</option>
                    </select>
                </div>

                <div style="margin-bottom: 20px;">
                    <label style="display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 6px;">Report Format</label>
                    <select style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;">
                        <option>PDF Document</option>
                        <option>Excel Spreadsheet</option>
                        <option>CSV File</option>
                        <option>HTML Report</option>
                    </select>
                </div>

                <div style="margin-bottom: 20px;">
                    <label style="display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 6px;">Detail Level</label>
                    <select style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;">
                        <option>Summary</option>
                        <option>Detailed</option>
                        <option>Comprehensive</option>
                    </select>
                </div>

                <div style="background: #f9fafb; border-radius: 8px; padding: 16px;">
                    <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                        <input type="checkbox" style="width: 18px; height: 18px;" />
                        <span style="font-size: 14px; color: #374151;">Include comparative data</span>
                    </label>
                    <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; margin-top: 12px;">
                        <input type="checkbox" style="width: 18px; height: 18px;" checked />
                        <span style="font-size: 14px; color: #374151;">Include charts and graphs</span>
                    </label>
                    <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; margin-top: 12px;">
                        <input type="checkbox" style="width: 18px; height: 18px;" />
                        <span style="font-size: 14px; color: #374151;">Include executive summary</span>
                    </label>
                </div>
            </div>

            <div style="padding: 20px 24px; background: #f9fafb; border-top: 1px solid #e5e7eb; display: flex; gap: 12px; justify-content: flex-end; border-radius: 0 0 16px 16px;">
                <button @onclick="CloseReportModal" class="btn" style="background: white; border: 2px solid #e5e7eb; color: #374151; padding: 10px 24px; font-weight: 600;">Cancel</button>
                <button class="btn" style="background: #059669; color: white; padding: 10px 24px; font-weight: 600;">Generate Report</button>
            </div>
        </div>
    </div>
}

@code {
    private bool showReportModal = false;
    private string selectedReportType = "";

    private void ShowReportModal(string reportType)
    {
        selectedReportType = reportType;
        showReportModal = true;
    }

    private void CloseReportModal() => showReportModal = false;
}

