@page "/admin/system/user-management"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@inject UserCrudService UserService
@inject PasswordHashingService PasswordService
@inject IJSRuntime JSRuntime

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #059669 0%, #047857 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
            <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
        </div>
        <div>
            <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">User Management</h1>
            <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">View, create, and manage all system users</p>
        </div>
    </div>
</div>

<!-- Filter & Actions -->
<div style="display: flex; gap: 12px; margin-bottom: 24px; align-items: center; flex-wrap: wrap;">
    <input type="text" placeholder="Search users..." @bind="searchTerm" style="flex: 1; min-width: 200px; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;" />
    
    <select @bind="filterRole" style="padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;">
        <option value="">All Roles</option>
        <option value="Admin">Admin</option>
        <option value="SuperAdmin">SuperAdmin</option>
        <option value="Accountant">Accountant</option>
        <option value="FinanceManager">FinanceManager</option>
        <option value="Teller">Teller</option>
        <option value="Customer">Customer</option>
    </select>

    <button class="btn" style="background: #059669; color: white; padding: 10px 18px; font-weight: 600; border-radius: 8px; font-size: 14px; cursor: pointer;" @onclick="FilterUsers">Filter</button>
    <button class="btn" style="background: #047857; color: white; padding: 10px 18px; font-weight: 600; border-radius: 8px; font-size: 14px; cursor: pointer;" @onclick="ShowCreateModal">+ Add User</button>
</div>

<!-- Create/Edit Modal -->
@if (showModal)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000;" @onclick="HideModal">
        <div style="background: white; border-radius: 16px; padding: 32px; width: 90%; max-width: 700px; box-shadow: 0 20px 25px rgba(0,0,0,0.1); max-height: 90vh; overflow-y: auto;" @onclick:stopPropagation="true">
            <h2 style="font-size: 20px; font-weight: 700; color: #111827; margin: 0 0 24px 0;">@(editingUser?.UserId > 0 ? "Edit User" : "Create New User")</h2>
            
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div style="padding: 12px; background: #fee2e2; border: 1px solid #dc2626; border-radius: 8px; color: #991b1b; margin-bottom: 16px; font-size: 13px;">
                    <strong>Error:</strong> @errorMessage
                </div>
            }
            
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div style="padding: 12px; background: #d1fae5; border: 1px solid #10b981; border-radius: 8px; color: #065f46; margin-bottom: 16px; font-size: 13px;">
                    <strong>Success:</strong> @successMessage
                </div>
            }
            
            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-bottom: 16px;">
                <div>
                    <label style="display: block; font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 6px;">Username *</label>
                    <input type="text" placeholder="Enter username" @bind="editingUser.Username" disabled="@(editingUser.UserId > 0)" style="width: 100%; padding: 10px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;" />
                </div>
                <div>
                    <label style="display: block; font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 6px;">Full Name *</label>
                    <input type="text" placeholder="Enter full name" @bind="editingUser.FullName" style="width: 100%; padding: 10px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;" />
                </div>
            </div>

            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-bottom: 16px;">
                <div>
                    <label style="display: block; font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 6px;">Email</label>
                    <input type="email" placeholder="Enter email" @bind="editingUser.Email" style="width: 100%; padding: 10px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;" />
                </div>
                <div>
                    <label style="display: block; font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 6px;">Phone Number</label>
                    <input type="text" placeholder="Enter phone" @bind="editingUser.PhoneNumber" style="width: 100%; padding: 10px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;" />
                </div>
            </div>

            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-bottom: 16px;">
                <div>
                    <label style="display: block; font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 6px;">Role *</label>
                    <select @bind="editingUser.Role" style="width: 100%; padding: 10px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;">
                        <option value="">Select Role</option>
                        <option value="Admin">Admin</option>
                        <option value="SuperAdmin">SuperAdmin</option>
                        <option value="Accountant">Accountant</option>
                        <option value="FinanceManager">FinanceManager</option>
                        <option value="Teller">Teller</option>
                        <option value="Customer">Customer</option>
                    </select>
                </div>
                <div>
                    <label style="display: block; font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 6px;">Status</label>
                    <select @bind="editingUser.IsActive" style="width: 100%; padding: 10px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;">
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                </div>
            </div>

            @if (editingUser?.UserId == 0)
            {
                <div style="margin-bottom: 24px;">
                    <label style="display: block; font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 6px;">Password * (min 12 characters)</label>
                    <input type="password" placeholder="Enter password" @bind="userPassword" style="width: 100%; padding: 10px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;" />
                    <p style="font-size: 11px; color: #6b7280; margin: 4px 0 0 0;">Must contain uppercase, lowercase, digit, and special character</p>
                </div>
            }

            <div style="display: flex; gap: 12px; justify-content: flex-end;">
                <button class="btn" style="background: #e5e7eb; color: #111827; padding: 10px 18px; font-weight: 600; border-radius: 8px; cursor: pointer;" @onclick="HideModal">Cancel</button>
                <button class="btn" style="background: #059669; color: white; padding: 10px 18px; font-weight: 600; border-radius: 8px; cursor: pointer;" @onclick="SaveUser">Save User</button>
            </div>
        </div>
    </div>
}

<!-- Users Table -->
<div style="background: white; border: 1px solid #e5e7eb; border-radius: 16px; overflow: hidden;">
    <table style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr style="border-bottom: 1px solid #e5e7eb; background: #f9fafb;">
                <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280; font-weight: 600;">USERNAME</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280; font-weight: 600;">FULL NAME</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280; font-weight: 600;">EMAIL</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280; font-weight: 600;">ROLE</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280; font-weight: 600;">STATUS</th>
                <th style="padding: 12px; text-align: center; font-size: 12px; color: #6b7280; font-weight: 600;">ACTIONS</th>
            </tr>
        </thead>
        <tbody>
            @if (displayedUsers.Count == 0)
            {
                <tr>
                    <td colspan="6" style="padding: 24px; text-align: center; color: #6b7280; font-size: 14px;">No users found</td>
                </tr>
            }
            @foreach (var user in displayedUsers)
            {
                <tr style="border-bottom: 1px solid #e5e7eb;">
                    <td style="padding: 12px; font-size: 13px; color: #111827; font-weight: 600;">@user.Username</td>
                    <td style="padding: 12px; font-size: 13px; color: #111827;">@user.FullName</td>
                    <td style="padding: 12px; font-size: 13px; color: #6b7280;">@user.Email</td>
                    <td style="padding: 12px; font-size: 13px;">
                        <span style="display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 999px; font-size: 11px; font-weight: 600; background: #f0fdf4; color: #065f46;">
                            @user.Role
                        </span>
                    </td>
                    <td style="padding: 12px; font-size: 13px;">
                        <span style="display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 999px; font-size: 11px; font-weight: 600; background: @(user.IsActive ? "#d1fae5" : "#fee2e2"); color: @(user.IsActive ? "#065f46" : "#991b1b");">
                            @(user.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td style="padding: 12px; text-align: center; display: flex; gap: 6px; justify-content: center;">
                        <button class="btn" style="background: #059669; color: white; padding: 6px 12px; border-radius: 6px; font-weight: 600; font-size: 12px; cursor: pointer;" @onclick="() => EditUser(user)">Edit</button>
                        <button class="btn" style="background: @(user.IsActive ? "#dc2626" : "#10b981"); color: white; padding: 6px 12px; border-radius: 6px; font-weight: 600; font-size: 12px; cursor: pointer;" @onclick="() => ToggleUserStatus(user)">@(user.IsActive ? "Deactivate" : "Activate")</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<AuthUser> users = new();
    private List<AuthUser> displayedUsers = new();
    private string searchTerm = "";
    private string filterRole = "";
    private bool showModal = false;
    private AuthUser editingUser = new();
    private string userPassword = "";
    private string errorMessage = "";
    private string successMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        users = await UserService.GetAllUsersAsync();
        displayedUsers = new List<AuthUser>(users);
    }

    private void ShowCreateModal()
    {
        editingUser = new AuthUser { IsActive = true };
        userPassword = "";
        errorMessage = "";
        successMessage = "";
        showModal = true;
    }

    private void EditUser(AuthUser user)
    {
        editingUser = new AuthUser
        {
            UserId = user.UserId,
            Username = user.Username,
            FullName = user.FullName,
            Email = user.Email,
            PhoneNumber = user.PhoneNumber,
            Role = user.Role,
            IsActive = user.IsActive
        };
        userPassword = "";
        errorMessage = "";
        successMessage = "";
        showModal = true;
    }

    private void HideModal()
    {
        showModal = false;
        editingUser = new();
        errorMessage = "";
        successMessage = "";
    }

    private async Task SaveUser()
    {
        errorMessage = "";
        successMessage = "";

        if (string.IsNullOrWhiteSpace(editingUser.Username) || string.IsNullOrWhiteSpace(editingUser.FullName))
        {
            errorMessage = "Username and Full Name are required";
            return;
        }

        if (editingUser.UserId == 0)
        {
            // Create new user
            if (string.IsNullOrWhiteSpace(userPassword))
            {
                errorMessage = "Password is required for new users";
                return;
            }

            // Validate password strength
            var (isValid, validationMessage) = PasswordService.ValidatePasswordStrength(userPassword);
            if (!isValid)
            {
                errorMessage = validationMessage;
                return;
            }

            // Hash the password
            var hashedPassword = PasswordService.HashPassword(userPassword);

            var (success, message, userId) = await UserService.CreateUserAsync(
                editingUser.Username,
                hashedPassword,
                editingUser.FullName,
                editingUser.Email ?? "",
                editingUser.PhoneNumber ?? "",
                editingUser.Role ?? "Customer",
                null, // department
                null, // employeeId
                editingUser.IsActive
            );

            if (success)
            {
                successMessage = message;
                await LoadUsers();
                await Task.Delay(1500);
                showModal = false;
            }
            else
            {
                errorMessage = message;
            }
        }
        else
        {
            // Update existing user
            var (success, message) = await UserService.UpdateUserAsync(
                editingUser.UserId,
                editingUser.FullName,
                editingUser.Email,
                editingUser.PhoneNumber,
                null, // department
                editingUser.IsActive
            );

            if (success)
            {
                successMessage = message;
                await LoadUsers();
                await Task.Delay(1500);
                showModal = false;
            }
            else
            {
                errorMessage = message;
            }
        }
    }

    private async Task ToggleUserStatus(AuthUser user)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
            $"Are you sure you want to {(user.IsActive ? "deactivate" : "activate")} this user?");
        
        if (!confirmed)
            return;

        var (success, message) = await UserService.SetUserActiveStatusAsync(user.UserId, !user.IsActive);
        
        if (success)
        {
            await LoadUsers();
        }
        else
        {
            errorMessage = message;
        }
    }

    private async Task FilterUsers()
    {
        displayedUsers = users
            .Where(u => 
                (string.IsNullOrWhiteSpace(searchTerm) || 
                 u.Username.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                 (u.FullName != null && u.FullName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                 (u.Email != null && u.Email.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))) &&
                (string.IsNullOrWhiteSpace(filterRole) || u.Role == filterRole))
            .ToList();
        await Task.CompletedTask;
    }
}
