@page "/admin/system/accountant-reports"
@layout AdminLayout
@*@inherits AuthorizedPageBase*@

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #1f2937 0%, #111827 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
            <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
        </div>
        <div>
            <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Accountant Reports</h1>
            <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Generate and view accounting reports</p>
        </div>
    </div>
</div>

<!-- Report Categories -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-bottom: 24px;">
    <!-- Financial Reports -->
    <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
            <div style="background: #dbeafe; border-radius: 8px; padding: 10px;">
                <svg width="20" height="20" fill="none" stroke="#2563eb" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"/>
                </svg>
            </div>
            <h3 style="font-size: 16px; font-weight: 700; color: #1f2937; margin: 0;">Financial Reports</h3>
        </div>
        <div style="display: flex; flex-direction: column; gap: 8px;">
            <button @onclick='() => ShowReportModal("Income Statement")' class="btn" style="background: #f9fafb; border: 1px solid #e5e7eb; color: #374151; padding: 10px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 14px;">Income Statement</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7"/>
                </svg>
            </button>
            <button @onclick='() => ShowReportModal("Balance Sheet")' class="btn" style="background: #f9fafb; border: 1px solid #e5e7eb; color: #374151; padding: 10px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 14px;">Balance Sheet</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7"/>
                </svg>
            </button>
            <button @onclick='() => ShowReportModal("Cash Flow Statement")' class="btn" style="background: #f9fafb; border: 1px solid #e5e7eb; color: #374151; padding: 10px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 14px;">Cash Flow Statement</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7"/>
                </svg>
            </button>
            <button @onclick='() => ShowReportModal("Statement of Changes in Equity")' class="btn" style="background: #f9fafb; border: 1px solid #e5e7eb; color: #374151; padding: 10px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 14px;">Changes in Equity</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7"/>
                </svg>
            </button>
        </div>
    </div>

    <!-- Ledger Reports -->
    <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
            <div style="background: #d1fae5; border-radius: 8px; padding: 10px;">
                <svg width="20" height="20" fill="none" stroke="#059669" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                </svg>
            </div>
            <h3 style="font-size: 16px; font-weight: 700; color: #1f2937; margin: 0;">Ledger Reports</h3>
        </div>
        <div style="display: flex; flex-direction: column; gap: 8px;">
            <button @onclick='() => ShowReportModal("General Ledger")' class="btn" style="background: #f9fafb; border: 1px solid #e5e7eb; color: #374151; padding: 10px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 14px;">General Ledger</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7"/>
                </svg>
            </button>
            <button @onclick='() => ShowReportModal("Trial Balance")' class="btn" style="background: #f9fafb; border: 1px solid #e5e7eb; color: #374151; padding: 10px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 14px;">Trial Balance</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7"/>
                </svg>
            </button>
            <button @onclick='() => ShowReportModal("Subsidiary Ledger")' class="btn" style="background: #f9fafb; border: 1px solid #e5e7eb; color: #374151; padding: 10px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 14px;">Subsidiary Ledger</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7"/>
                </svg>
            </button>
            <button @onclick='() => ShowReportModal("Account Summary")' class="btn" style="background: #f9fafb; border: 1px solid #e5e7eb; color: #374151; padding: 10px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 14px;">Account Summary</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7"/>
                </svg>
            </button>
        </div>
    </div>

    <!-- Transaction Reports -->
    <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
            <div style="background: #fef3c7; border-radius: 8px; padding: 10px;">
                <svg width="20" height="20" fill="none" stroke="#f59e0b" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                </svg>
            </div>
            <h3 style="font-size: 16px; font-weight: 700; color: #1f2937; margin: 0;">Transaction Reports</h3>
        </div>
        <div style="display: flex; flex-direction: column; gap: 8px;">
            <button @onclick='() => ShowReportModal("Journal Entries")' class="btn" style="background: #f9fafb; border: 1px solid #e5e7eb; color: #374151; padding: 10px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 14px;">Journal Entries</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7"/>
                </svg>
            </button>
            <button @onclick='() => ShowReportModal("Transaction History")' class="btn" style="background: #f9fafb; border: 1px solid #e5e7eb; color: #374151; padding: 10px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 14px;">Transaction History</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7"/>
                </svg>
            </button>
            <button @onclick='() => ShowReportModal("Audit Trail")' class="btn" style="background: #f9fafb; border: 1px solid #e5e7eb; color: #374151; padding: 10px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 14px;">Audit Trail</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7"/>
                </svg>
            </button>
            <button @onclick='() => ShowReportModal("Reconciliation Report")' class="btn" style="background: #f9fafb; border: 1px solid #e5e7eb; color: #374151; padding: 10px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 14px;">Reconciliation</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7"/>
                </svg>
            </button>
        </div>
    </div>

    <!-- Tax & Compliance -->
    <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
            <div style="background: #e0e7ff; border-radius: 8px; padding: 10px;">
                <svg width="20" height="20" fill="none" stroke="#6366f1" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
            </div>
            <h3 style="font-size: 16px; font-weight: 700; color: #1f2937; margin: 0;">Tax & Compliance</h3>
        </div>
        <div style="display: flex; flex-direction: column; gap: 8px;">
            <button @onclick='() => ShowReportModal("Tax Summary")' class="btn" style="background: #f9fafb; border: 1px solid #e5e7eb; color: #374151; padding: 10px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 14px;">Tax Summary</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7"/>
                </svg>
            </button>
            <button @onclick='() => ShowReportModal("BIR Reports")' class="btn" style="background: #f9fafb; border: 1px solid #e5e7eb; color: #374151; padding: 10px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 14px;">BIR Reports</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7"/>
                </svg>
            </button>
            <button @onclick='() => ShowReportModal("Regulatory Compliance")' class="btn" style="background: #f9fafb; border: 1px solid #e5e7eb; color: #374151; padding: 10px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 14px;">Regulatory Compliance</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7"/>
                </svg>
            </button>
            <button @onclick='() => ShowReportModal("BSP Reports")' class="btn" style="background: #f9fafb; border: 1px solid #e5e7eb; color: #374151; padding: 10px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 14px;">BSP Reports</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5l7 7-7 7"/>
                </svg>
            </button>
        </div>
    </div>
</div>

<!-- Report Generation Modal -->
@if (showReportModal)
{
    <div @onclick="CloseReportModal" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000; padding: 20px;">
        <div @onclick:stopPropagation style="background: white; border-radius: 16px; max-width: 600px; width: 100%; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
            <div style="padding: 24px; border-bottom: 1px solid #e5e7eb;">
                <h3 style="font-size: 20px; font-weight: 700; color: #1f2937; margin: 0;">Generate @selectedReportType</h3>
                <p style="font-size: 14px; color: #6b7280; margin: 4px 0 0 0;">Configure report parameters</p>
            </div>
            
            <div style="padding: 24px;">
                <div style="margin-bottom: 20px;">
                    <label style="display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 6px;">Report Period</label>
                    <select style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;">
                        <option>Current Month</option>
                        <option>Last Month</option>
                        <option>Current Quarter</option>
                        <option>Last Quarter</option>
                        <option>Current Year</option>
                        <option>Last Year</option>
                        <option>Custom Date Range</option>
                    </select>
                </div>

                <div style="margin-bottom: 20px;">
                    <label style="display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 6px;">Report Format</label>
                    <select style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;">
                        <option>PDF Document</option>
                        <option>Excel Spreadsheet</option>
                        <option>CSV File</option>
                        <option>HTML Report</option>
                    </select>
                </div>

                <div style="margin-bottom: 20px;">
                    <label style="display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 6px;">Detail Level</label>
                    <select style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;">
                        <option>Summary</option>
                        <option>Detailed</option>
                        <option>Comprehensive</option>
                    </select>
                </div>

                <div style="background: #f9fafb; border-radius: 8px; padding: 16px;">
                    <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                        <input type="checkbox" style="width: 18px; height: 18px;" />
                        <span style="font-size: 14px; color: #374151;">Include comparative data</span>
                    </label>
                    <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; margin-top: 12px;">
                        <input type="checkbox" style="width: 18px; height: 18px;" />
                        <span style="font-size: 14px; color: #374151;">Include charts and graphs</span>
                    </label>
                    <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; margin-top: 12px;">
                        <input type="checkbox" style="width: 18px; height: 18px;" checked />
                        <span style="font-size: 14px; color: #374151;">Include notes and annotations</span>
                    </label>
                </div>
            </div>

            <div style="padding: 20px 24px; background: #f9fafb; border-top: 1px solid #e5e7eb; display: flex; gap: 12px; justify-content: flex-end; border-radius: 0 0 16px 16px;">
                <button @onclick="CloseReportModal" class="btn" style="background: white; border: 2px solid #e5e7eb; color: #374151; padding: 10px 24px; font-weight: 600;">Cancel</button>
                <button class="btn" style="background: #1f2937; color: white; padding: 10px 24px; font-weight: 600;">Generate Report</button>
            </div>
        </div>
    </div>
}

@code {
    private bool showReportModal = false;
    private string selectedReportType = "";

    private void ShowReportModal(string reportType)
    {
        selectedReportType = reportType;
        showReportModal = true;
    }

    private void CloseReportModal() => showReportModal = false;
}

