@page "/admin/accountant/journal-entries"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@using Microsoft.EntityFrameworkCore
@inject AuthService AuthService
@inject JournalEntryService JournalEntryService
@inject ChartOfAccountsService ChartOfAccountsService
@inject NotificationService NotificationService
@inject IDbContextFactory<BFASDbContext> DbFactory

<!-- Page Header -->
<div
    style="background: linear-gradient(135deg, #5F6F52 0%, #2F3E2A 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
                <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M12 2c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12 6.477 2 12 2z" />
                    <path d="M12 6v6l4 2" stroke="white" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round" />
                </svg>
            </div>
            <div>
                <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Admin - Journal Entries</h1>
                <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Administrative journal
                    entries management with audit trail</p>
            </div>
        </div>
        <div style="display: flex; gap: 12px;">
            <button class="btn"
                style="background: white; color: #5F6F52; padding: 10px 18px; border-radius: 8px; font-size: 14px; font-weight: 600;"
                @onclick="OpenCreateModal">
                ➕ New Entry
            </button>
            <button class="btn"
                style="background: rgba(255,255,255,0.2); color: white; padding: 10px 18px; border-radius: 8px; font-size: 14px; font-weight: 600; border: 1px solid rgba(255,255,255,0.3);"
                @onclick="LoadEntries">
                🔄 Refresh
            </button>
        </div>
    </div>
</div>

<!-- Admin Notice -->
<div
    style="background: linear-gradient(135deg, #E5D9B6 0%, #D8CCA6 100%); border: 1px solid #C4B896; border-radius: 12px; padding: 16px; margin-bottom: 24px; display: flex; align-items: center; gap: 12px;">
    <span style="font-size: 24px;">⚠️</span>
    <div>
        <div style="font-weight: 700; color: #6B4423;">Administrative Access</div>
        <div style="font-size: 13px; color: #8B5A2B;">All journal entry actions are logged with admin identity for audit
            compliance.</div>
    </div>
</div>

<!-- Summary Cards -->
<div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 24px;">
    <div
        style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb; border-left: 4px solid #5F6F52;">
        <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 4px;">📋 TOTAL ENTRIES</div>
        <div style="font-size: 28px; font-weight: 800; color: #5F6F52;">@entries.Count</div>
    </div>
    <div
        style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb; border-left: 4px solid #5F6F52;">
        <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 4px;">✓ POSTED</div>
        <div style="font-size: 28px; font-weight: 800; color: #5F6F52;">@entries.Count(e => e.Status == "Posted")</div>
    </div>
    <div
        style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb; border-left: 4px solid #2F3E2A;">
        <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 4px;">⏳ DRAFT</div>
        <div style="font-size: 28px; font-weight: 800; color: #2F3E2A;">@entries.Count(e => e.Status == "Draft")</div>
    </div>
    <div
        style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb; border-left: 4px solid #5F6F52;">
        <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 4px;">💰 TOTAL AMOUNT</div>
        <div style="font-size: 28px; font-weight: 800; color: #5F6F52;">₱@entries.Sum(e => e.TotalDebit).ToString("N0")
        </div>
    </div>
</div>

<!-- Entries Table -->
<div style="background: white; border-radius: 16px; border: 1px solid #e5e7eb; overflow: hidden;">
    <div
        style="padding: 20px; border-bottom: 1px solid #e5e7eb; display: flex; justify-content: space-between; align-items: center;">
        <h3 style="font-size: 16px; font-weight: 600; margin: 0;">Journal Entries</h3>
        <input type="text" @bind="searchTerm" @bind:after="FilterEntries" placeholder="Search entries..."
            style="padding: 8px 16px; border: 1px solid #e5e7eb; border-radius: 8px; width: 250px;" />
    </div>

    @if (isLoading)
    {
        <div style="text-align: center; padding: 60px; color: #6b7280;">
            <div style="font-size: 32px; animation: spin 1s linear infinite;">⏳</div>
            <p>Loading journal entries...</p>
        </div>
    }
    else if (!filteredEntries.Any())
    {
        <div style="text-align: center; padding: 60px; color: #6b7280;">
            <div style="font-size: 48px; margin-bottom: 16px;">📑</div>
            <div>No journal entries found</div>
        </div>
    }
    else
    {
        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background: #f9fafb;">
                    <th style="padding: 12px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #6b7280;">
                        Journal #</th>
                    <th style="padding: 12px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #6b7280;">
                        Date</th>
                    <th style="padding: 12px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #6b7280;">
                        Description</th>
                    <th style="padding: 12px 16px; text-align: right; font-size: 12px; font-weight: 600; color: #6b7280;">
                        Debit</th>
                    <th style="padding: 12px 16px; text-align: right; font-size: 12px; font-weight: 600; color: #6b7280;">
                        Credit</th>
                    <th style="padding: 12px 16px; text-align: center; font-size: 12px; font-weight: 600; color: #6b7280;">
                        Status</th>
                    <th style="padding: 12px 16px; text-align: center; font-size: 12px; font-weight: 600; color: #6b7280;">
                        Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in filteredEntries.Take(50))
                {
                    <tr style="border-bottom: 1px solid #f3f4f6;">
                        <td style="padding: 16px; font-weight: 600; font-family: monospace;">@entry.JournalNumber</td>
                        <td style="padding: 16px; color: #6b7280;">@entry.TransactionDate.ToString("MMM dd, yyyy")</td>
                        <td style="padding: 16px; max-width: 300px; overflow: hidden; text-overflow: ellipsis;">
                            @entry.Description</td>
                        <td style="padding: 16px; text-align: right; font-weight: 600; color: #5F6F52;">
                            ₱@entry.TotalDebit.ToString("N2")</td>
                        <td style="padding: 16px; text-align: right; font-weight: 600; color: #ef4444;">
                            ₱@entry.TotalCredit.ToString("N2")</td>
                        <td style="padding: 16px; text-align: center;">
                            <span
                                style="padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; @GetStatusStyle(entry.Status)">
                                @entry.Status
                            </span>
                        </td>
                        <td style="padding: 16px; text-align: center;">
                            @if (entry.Status == "Draft")
                            {
                                <button class="btn"
                                    style="background: #5F6F52; color: white; padding: 6px 12px; border-radius: 6px; font-size: 12px;"
                                    @onclick="() => OpenPostModal(entry)">
                                    ✓ Post
                                </button>
                            }
                            <button class="btn"
                                style="background: #6b7280; color: white; padding: 6px 12px; border-radius: 6px; font-size: 12px; margin-left: 4px;"
                                @onclick="() => ViewEntry(entry)">
                                👁️
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<!-- Create Entry Modal -->
@if (showCreateModal)
{
    <div
        style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000;">
        <div
            style="background: white; border-radius: 16px; width: 95%; max-width: 600px; padding: 24px; max-height: 90vh; overflow-y: auto;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h3 style="font-size: 18px; font-weight: 700; margin: 0; color: #7c3aed;">➕ Create Admin Journal Entry</h3>
                <button @onclick="CloseModal"
                    style="background: none; border: none; font-size: 24px; cursor: pointer; color: #6b7280;">×</button>
            </div>

            <div style="display: grid; gap: 16px;">
                <div>
                    <label
                        style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 4px;">Transaction
                        Date</label>
                    <input type="date" @bind="newEntry.TransactionDate"
                        style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" />
                </div>
                <div>
                    <label
                        style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 4px;">Description</label>
                    <textarea @bind="newEntry.Description" rows="2"
                        style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px; resize: vertical;"></textarea>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div>
                        <label
                            style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 4px;">Debit
                            Amount</label>
                        <input type="number" @bind="newEntry.TotalDebit" step="0.01"
                            style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" />
                    </div>
                    <div>
                        <label
                            style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 4px;">Credit
                            Amount</label>
                        <input type="number" @bind="newEntry.TotalCredit" step="0.01"
                            style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" />
                    </div>
                </div>

                <!-- Admin Reason -->
                <div style="background: #fffbeb; border: 1px solid #f59e0b; border-radius: 8px; padding: 16px;">
                    <label style="display: block; font-size: 13px; font-weight: 600; color: #92400e; margin-bottom: 8px;">⚠️
                        Admin Reason (Required)</label>
                    <textarea @bind="adminReason" rows="2" placeholder="Reason for creating this journal entry..."
                        style="width: 100%; padding: 10px; border: 1px solid #f59e0b; border-radius: 8px; background: white; resize: vertical;"></textarea>
                </div>
            </div>

            <div style="display: flex; gap: 12px; margin-top: 20px;">
                <button class="btn"
                    style="flex: 1; background: #7c3aed; color: white; padding: 12px; border-radius: 8px; font-weight: 600;"
                    @onclick="CreateEntry" disabled="@(string.IsNullOrWhiteSpace(adminReason) || isProcessing)">
                    @(isProcessing ? "⏳ Creating..." : "✓ Create Entry")
                </button>
                <button class="btn"
                    style="background: #f3f4f6; color: #374151; padding: 12px 24px; border-radius: 8px; font-weight: 600;"
                    @onclick="CloseModal">
                    Cancel
                </button>
            </div>
        </div>
    </div>
}

<!-- Post Entry Modal -->
@if (showPostModal && selectedEntry != null)
{
    <div
        style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000;">
        <div style="background: white; border-radius: 16px; width: 95%; max-width: 500px; padding: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h3 style="font-size: 18px; font-weight: 700; margin: 0; color: #5F6F52;">✓ Post Journal Entry</h3>
                <button @onclick="CloseModal"
                    style="background: none; border: none; font-size: 24px; cursor: pointer; color: #6b7280;">×</button>
            </div>

            <div style="background: #f9fafb; padding: 16px; border-radius: 12px; margin-bottom: 20px;">
                <div style="font-size: 14px;">
                    <div><span style="color: #6b7280;">Journal #:</span> <strong>@selectedEntry.JournalNumber</strong></div>
                    <div><span style="color: #6b7280;">Description:</span> @selectedEntry.Description</div>
                    <div><span style="color: #6b7280;">Amount:</span> <strong
                            style="color: #5F6F52;">₱@selectedEntry.TotalDebit.ToString("N2")</strong></div>
                </div>
            </div>

            <!-- Post Reason -->
            <div style="margin-bottom: 20px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: #92400e; margin-bottom: 8px;">⚠️
                    Post Reason (Required)</label>
                <textarea @bind="postReason" rows="3" placeholder="Reason for posting this entry to GL..."
                    style="width: 100%; padding: 12px; border: 1px solid #f59e0b; border-radius: 8px; background: #fffbeb; resize: vertical;"></textarea>
            </div>

            <div style="display: flex; gap: 12px;">
                <button class="btn"
                    style="flex: 1; background: #5F6F52; color: white; padding: 12px; border-radius: 8px; font-weight: 600;"
                    @onclick="PostEntry" disabled="@(string.IsNullOrWhiteSpace(postReason) || isProcessing)">
                    @(isProcessing ? "⏳ Posting..." : "✓ Post to General Ledger")
                </button>
                <button class="btn"
                    style="background: #f3f4f6; color: #374151; padding: 12px 24px; border-radius: 8px; font-weight: 600;"
                    @onclick="CloseModal">
                    Cancel
                </button>
            </div>
        </div>
    </div>
}

<!-- View Entry Modal -->
@if (showViewModal && selectedEntry != null)
{
    <div
        style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000;">
        <div style="background: white; border-radius: 16px; width: 95%; max-width: 500px; padding: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h3 style="font-size: 18px; font-weight: 700; margin: 0;">Journal Entry Details</h3>
                <button @onclick="CloseModal"
                    style="background: none; border: none; font-size: 24px; cursor: pointer; color: #6b7280;">×</button>
            </div>

            <div style="display: grid; gap: 12px;">
                <div
                    style="display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #f3f4f6;">
                    <span style="color: #6b7280;">Journal Number</span>
                    <span style="font-weight: 600; font-family: monospace;">@selectedEntry.JournalNumber</span>
                </div>
                <div
                    style="display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #f3f4f6;">
                    <span style="color: #6b7280;">Date</span>
                    <span style="font-weight: 600;">@selectedEntry.TransactionDate.ToString("MMM dd, yyyy")</span>
                </div>
                <div
                    style="display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #f3f4f6;">
                    <span style="color: #6b7280;">Description</span>
                    <span style="font-weight: 600; max-width: 250px; text-align: right;">@selectedEntry.Description</span>
                </div>
                <div
                    style="display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #f3f4f6;">
                    <span style="color: #6b7280;">Debit</span>
                    <span style="font-weight: 600; color: #5F6F52;">₱@selectedEntry.TotalDebit.ToString("N2")</span>
                </div>
                <div
                    style="display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #f3f4f6;">
                    <span style="color: #6b7280;">Credit</span>
                    <span style="font-weight: 600; color: #ef4444;">₱@selectedEntry.TotalCredit.ToString("N2")</span>
                </div>
                <div
                    style="display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #f3f4f6;">
                    <span style="color: #6b7280;">Status</span>
                    <span
                        style="padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; @GetStatusStyle(selectedEntry.Status)">@selectedEntry.Status</span>
                </div>
                <div style="display: flex; justify-content: space-between; padding: 12px 0;">
                    <span style="color: #6b7280;">Created By</span>
                    <span style="font-weight: 600;">@selectedEntry.CreatedBy</span>
                </div>
            </div>

            <button class="btn"
                style="width: 100%; background: #f3f4f6; color: #374151; padding: 12px; border-radius: 8px; font-weight: 600; margin-top: 20px;"
                @onclick="CloseModal">
                Close
            </button>
        </div>
    </div>
}

@code {
    private List<JournalEntry> entries = new();
    private List<JournalEntry> filteredEntries = new();
    private JournalEntry? selectedEntry;
    private JournalEntry newEntry = new() { TransactionDate = DateTime.Today, Status = "Draft" };
    private bool isLoading = true;
    private bool isProcessing = false;
    private bool showCreateModal = false;
    private bool showPostModal = false;
    private bool showViewModal = false;
    private string searchTerm = "";
    private string adminReason = "";
    private string postReason = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadEntries();
    }

    private async Task LoadEntries()
    {
        isLoading = true;
        try
        {
            entries = await JournalEntryService.GetAllWithTransactionsAsync();
            FilterEntries();
            NotificationService.ShowSuccess("Loaded", $"Loaded {entries.Count} journal entries.");
        }
        catch (Exception ex)
        {
            NotificationService.ShowError("Load Failed", ex.Message);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void FilterEntries()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredEntries = entries.OrderByDescending(e => e.TransactionDate).ToList();
        }
        else
        {
            var term = searchTerm.ToLower();
            filteredEntries = entries
            .Where(e => e.JournalNumber.ToLower().Contains(term) ||
            e.Description.ToLower().Contains(term) ||
            e.Reference?.ToLower().Contains(term) == true)
            .OrderByDescending(e => e.TransactionDate)
            .ToList();
        }
    }

    private void OpenCreateModal()
    {
        newEntry = new JournalEntry
        {
            TransactionDate = DateTime.Today,
            Status = "Draft",
            JournalNumber = $"ADM-{DateTime.Now:yyyyMMddHHmmss}"
        };
        adminReason = "";
        showCreateModal = true;
    }

    private void OpenPostModal(JournalEntry entry)
    {
        selectedEntry = entry;
        postReason = "";
        showPostModal = true;
    }

    private void ViewEntry(JournalEntry entry)
    {
        selectedEntry = entry;
        showViewModal = true;
    }

    private void CloseModal()
    {
        showCreateModal = false;
        showPostModal = false;
        showViewModal = false;
        selectedEntry = null;
        adminReason = "";
        postReason = "";
    }

    private async Task CreateEntry()
    {
        if (string.IsNullOrWhiteSpace(adminReason))
        {
            NotificationService.ShowError("Reason Required", "Please provide a reason for creating this entry.");
            return;
        }

        if (newEntry.TotalDebit != newEntry.TotalCredit)
        {
            NotificationService.ShowError("Unbalanced Entry", "Debit and Credit amounts must be equal.");
            return;
        }

        isProcessing = true;
        try
        {
            newEntry.CreatedBy = AuthService.CurrentUser;
            newEntry.CreatedAt = DateTime.Now;

            await JournalEntryService.CreateAsync(newEntry);
            await LogAdminAction("CREATE_JOURNAL_ENTRY", newEntry.JournalNumber, adminReason);

            NotificationService.ShowSuccess("Entry Created", $"Journal Entry {newEntry.JournalNumber} created. Reason: {adminReason}");

            CloseModal();
            await LoadEntries();
        }
        catch (Exception ex)
        {
            NotificationService.ShowError("Create Failed", ex.Message);
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task PostEntry()
    {
        if (selectedEntry == null || string.IsNullOrWhiteSpace(postReason))
        {
            NotificationService.ShowError("Reason Required", "Please provide a reason for posting.");
            return;
        }

        isProcessing = true;
        try
        {
            await JournalEntryService.PostAsync(selectedEntry.JournalId, AuthService.CurrentUser ?? "Admin");
            await LogAdminAction("POST_JOURNAL_ENTRY", selectedEntry.JournalNumber, postReason);

            NotificationService.ShowSuccess("Entry Posted", $"Journal Entry {selectedEntry.JournalNumber} posted to GL. Reason: {postReason}");

            CloseModal();
            await LoadEntries();
        }
        catch (Exception ex)
        {
            NotificationService.ShowError("Post Failed", ex.Message);
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LogAdminAction(string action, string reference, string reason)
    {
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            context.AuditLogs.Add(new AuditLog
            {
                UserId = AuthService.CurrentUserId?.ToString() ?? "0",
                Action = action,
                Module = "JournalEntries",
                Description = $"{reason} | Reference: {reference}",
                IpAddress = "Admin Panel",
                CreatedAt = DateTime.Now
            });
            await context.SaveChangesAsync();
        }
        catch { }
    }

    private string GetStatusStyle(string status) => status switch
    {
        "Posted" => "background: #D4E6D4; color: #2F3E2A;",
        "Draft" => "background: #fef3c7; color: #92400e;",
        "Rejected" => "background: #fee2e2; color: #991b1b;",
        _ => "background: #f3f4f6; color: #6b7280;"
    };
}