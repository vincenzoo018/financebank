@page "/admin/account-unlock-requests"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@using Microsoft.EntityFrameworkCore
@inject AuthService AuthService
@inject IDbContextFactory<BFASDbContext> DbContextFactory

<!-- Page Header -->
<div
    style="background: linear-gradient(135deg, #9B3A3A 0%, #7B2A2A 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
            <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                <circle cx="12" cy="16" r="1"></circle>
            </svg>
        </div>
        <div>
            <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Account Unlock Requests</h1>
            <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Review and process customer
                account unlock requests submitted by tellers</p>
        </div>
    </div>
</div>

<!-- Summary Cards -->
<div
    style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 24px;">
    <div
        style="background: linear-gradient(135deg, #F0E8E8, #E8D8D8); border-radius: 12px; padding: 16px; border: 2px solid #C9A9A9;">
        <div style="font-size: 11px; font-weight: 600; color: #6B3A3A; margin-bottom: 4px; text-transform: uppercase;">
            TOTAL REQUESTS</div>
        <div style="font-size: 24px; font-weight: 800; color: #9B3A3A;">@unlockRequests.Count</div>
    </div>
    <div style="background: linear-gradient(135deg, #F5EFE6, #E8DFD0); border-radius: 12px; padding: 16px; border: 2px solid #C4A574; cursor: pointer;"
        @onclick='() => { selectedStatus = "Pending"; ApplyFilters(); }'>
        <div style="font-size: 11px; font-weight: 600; color: #6B4423; margin-bottom: 4px; text-transform: uppercase;">⏳
            PENDING</div>
        <div style="font-size: 24px; font-weight: 800; color: #8B5A2B;">@unlockRequests.Count(r => r.Status ==
                        "Pending")</div>
    </div>
    <div style="background: linear-gradient(135deg, #F0E8E8, #E8D8D8); border-radius: 12px; padding: 16px; border: 2px solid #C9A9A9; cursor: pointer;"
        @onclick='() => { selectedPriority = "Urgent"; ApplyFilters(); }'>
        <div style="font-size: 11px; font-weight: 600; color: #6B3A3A; margin-bottom: 4px; text-transform: uppercase;">
            🔥 URGENT</div>
        <div style="font-size: 24px; font-weight: 800; color: #9B3A3A;">@unlockRequests.Count(r => r.Priority ==
                        "Urgent" && r.Status == "Pending")</div>
    </div>
    <div
        style="background: linear-gradient(135deg, #E8F0E8, #D4E6D4); border-radius: 12px; padding: 16px; border: 2px solid #A9B388;">
        <div style="font-size: 11px; font-weight: 600; color: #2F3E2A; margin-bottom: 4px; text-transform: uppercase;">✓
            APPROVED</div>
        <div style="font-size: 24px; font-weight: 800; color: #5F6F52;">@unlockRequests.Count(r => r.Status ==
                        "Approved")</div>
    </div>
    <div
        style="background: linear-gradient(135deg, #F0E8E8, #E8D8D8); border-radius: 12px; padding: 16px; border: 2px solid #C9A9A9;">
        <div style="font-size: 11px; font-weight: 600; color: #6B3A3A; margin-bottom: 4px; text-transform: uppercase;">✗
            REJECTED</div>
        <div style="font-size: 24px; font-weight: 800; color: #9B3A3A;">@unlockRequests.Count(r => r.Status ==
                        "Rejected")</div>
    </div>
</div>

<!-- Filters -->
<div
    style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb; margin-bottom: 20px; display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end;">
    <div style="flex: 1 1 200px;">
        <label style="display:block; font-size:12px; font-weight:600; color:#374151; margin-bottom:4px;">Search</label>
        <input type="text" @bind="searchQuery" @bind:event="oninput"
            placeholder="Search by customer name, username, teller..."
            style="padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px; width: 100%;" />
    </div>
    <div style="flex: 1 1 150px;">
        <label style="display:block; font-size:12px; font-weight:600; color:#374151; margin-bottom:4px;">Status</label>
        <select @bind="selectedStatus"
            style="padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px; width: 100%;">
            <option value="">All Status</option>
            <option value="Pending">Pending</option>
            <option value="Approved">Approved</option>
            <option value="Rejected">Rejected</option>
        </select>
    </div>
    <div style="flex: 1 1 150px;">
        <label
            style="display:block; font-size:12px; font-weight:600; color:#374151; margin-bottom:4px;">Priority</label>
        <select @bind="selectedPriority"
            style="padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px; width: 100%;">
            <option value="">All Priority</option>
            <option value="Urgent">Urgent</option>
            <option value="High">High</option>
            <option value="Normal">Normal</option>
            <option value="Low">Low</option>
        </select>
    </div>
    <div style="flex: 0 0 auto; display:flex; gap:8px;">
        <button class="btn"
            style="background: linear-gradient(135deg, #5F6F52, #2F3E2A); color:white; padding:10px 18px; border-radius:8px; font-size:14px; font-weight:600;"
            @onclick="ApplyFilters">🔍 Filter</button>
        <button class="btn"
            style="background:#e5e7eb; color:#374151; padding:10px 18px; border-radius:8px; font-size:14px; font-weight:600;"
            @onclick="ResetFilters">↻ Reset</button>
    </div>
</div>

<!-- Requests Table -->
<div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h2 style="font-size: 18px; font-weight: 600; color: #111827; margin: 0;">
            All Unlock Requests
            <span style="font-size: 14px; font-weight: 400; color: #6b7280;">(@GetFilteredRequests().Count()
                records)</span>
        </h2>
        <button @onclick="LoadData" class="btn"
            style="background: #f3f4f6; color: #374151; padding: 8px 16px; border-radius: 8px; font-size: 13px; font-weight: 500; border: none; cursor: pointer;">
            ↻ Refresh
        </button>
    </div>

    <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background: #f9fafb; border-bottom: 2px solid #e5e7eb;">
                    <th
                        style="padding: 12px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #6b7280; text-transform: uppercase;">
                        Request ID</th>
                    <th
                        style="padding: 12px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #6b7280; text-transform: uppercase;">
                        Customer</th>
                    <th
                        style="padding: 12px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #6b7280; text-transform: uppercase;">
                        Lock Reason</th>
                    <th
                        style="padding: 12px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #6b7280; text-transform: uppercase;">
                        Submitted By</th>
                    <th
                        style="padding: 12px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #6b7280; text-transform: uppercase;">
                        ID Verified</th>
                    <th
                        style="padding: 12px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #6b7280; text-transform: uppercase;">
                        Priority</th>
                    <th
                        style="padding: 12px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #6b7280; text-transform: uppercase;">
                        Status</th>
                    <th
                        style="padding: 12px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #6b7280; text-transform: uppercase;">
                        Requested</th>
                    <th
                        style="padding: 12px 16px; text-align: center; font-size: 12px; font-weight: 600; color: #6b7280; text-transform: uppercase;">
                        Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (GetFilteredRequests().Any())
                {
                    @foreach (var request in GetFilteredRequests())
                    {
                        <tr style="border-bottom: 1px solid #f3f4f6; transition: background 0.2s; @(request.Priority == "Urgent" && request.Status == "Pending" ? "background: #fef2f2;" : "")"
                            onmouseover="this.style.background='#f9fafb'"
                            onmouseout="this.style.background='@(request.Priority == "Urgent" && request.Status == "Pending" ? "#fef2f2" : "transparent")'">
                            <td style="padding: 16px;">
                                <span style="font-weight: 600; color: #111827;">REQ-@request.RequestId.ToString("D5")</span>
                            </td>
                            <td style="padding: 16px;">
                                <div style="display: flex; align-items: center; gap: 12px;">
                                    <div
                                        style="width: 40px; height: 40px; background: linear-gradient(135deg, #dc2626, #b91c1c); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: 600; font-size: 14px;">
                                        @GetInitials(request.CustomerName)
                                    </div>
                                    <div>
                                        <div style="font-weight: 600; color: #111827;">@request.CustomerName</div>
                                        <div style="font-size: 12px; color: #6b7280;">@@@request.CustomerUsername</div>
                                    </div>
                                </div>
                            </td>
                            <td style="padding: 16px;">
                                <span style="font-size: 13px; color: #374151;">@TruncateText(request.LockReason, 30)</span>
                            </td>
                            <td style="padding: 16px;">
                                <div style="font-size: 13px; font-weight: 500; color: #111827;">@request.RequestedByTellerName
                                </div>
                            </td>
                            <td style="padding: 16px;">
                                @if (request.IdentificationVerified)
                                {
                                    <span
                                        style="display: inline-flex; align-items: center; gap: 4px; background: #D4E6D4; color: #2F3E2A; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 600;">
                                        ✓ Yes
                                    </span>
                                }
                                else
                                {
                                    <span
                                        style="display: inline-flex; align-items: center; gap: 4px; background: #fee2e2; color: #991b1b; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 600;">
                                        ✗ No
                                    </span>
                                }
                            </td>
                            <td style="padding: 16px;">
                                <span
                                    style="background: @GetPriorityBackground(request.Priority); color: @GetPriorityColor(request.Priority); padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 600;">
                                    @(request.Priority == "Urgent" ? "🔥 " : "")@request.Priority
                                </span>
                            </td>
                            <td style="padding: 16px;">
                                <span
                                    style="background: @GetStatusBackground(request.Status); color: @GetStatusColor(request.Status); padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 600;">
                                    @request.Status
                                </span>
                            </td>
                            <td style="padding: 16px;">
                                <div style="font-size: 13px; color: #374151;">@request.RequestedAt.ToString("MMM dd, yyyy")
                                </div>
                                <div style="font-size: 11px; color: #9ca3af;">@request.RequestedAt.ToString("hh:mm tt")</div>
                            </td>
                            <td style="padding: 16px; text-align: center;">
                                <div style="display: flex; gap: 4px; justify-content: center; flex-wrap: wrap;">
                                    <button @onclick="() => OpenViewModal(request)" class="btn"
                                        style="background: #dbeafe; color: #1e40af; padding: 6px 10px; border-radius: 6px; font-size: 11px; font-weight: 600; border: none; cursor: pointer;">
                                        👁 View
                                    </button>
                                    @if (request.Status == "Pending")
                                    {
                                        <button @onclick="() => OpenProcessModal(request)" class="btn"
                                            style="background: linear-gradient(135deg, #5F6F52, #2F3E2A); color: white; padding: 6px 10px; border-radius: 6px; font-size: 11px; font-weight: 600; border: none; cursor: pointer;">
                                            ⚡ Process
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" style="padding: 48px; text-align: center; color: #6b7280;">
                            <div style="font-size: 48px; margin-bottom: 16px;">🔓</div>
                            <div style="font-size: 16px; font-weight: 500; margin-bottom: 4px;">No unlock requests found
                            </div>
                            <div style="font-size: 14px;">Unlock requests from tellers will appear here</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- View Request Modal -->
@if (showViewModal && viewRequest != null)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000;"
        @onclick="CloseViewModal">
        <div style="background: white; border-radius: 16px; padding: 28px; max-width: 600px; width: 95%; max-height: 90vh; overflow-y: auto; box-shadow: 0 20px 60px rgba(0,0,0,0.3);"
            @onclick:stopPropagation="true">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                <h2 style="font-size: 20px; font-weight: 700; color: #1f2937; margin: 0;">
                    Request Details - REQ-@viewRequest.RequestId.ToString("D5")
                </h2>
                <button @onclick="CloseViewModal"
                    style="background: none; border: none; font-size: 24px; cursor: pointer; color: #6b7280;">&times;</button>
            </div>

            <!-- Status Badge -->
            <div style="text-align: center; margin-bottom: 24px;">
                <span
                    style="background: @GetStatusBackground(viewRequest.Status); color: @GetStatusColor(viewRequest.Status); padding: 8px 24px; border-radius: 20px; font-size: 16px; font-weight: 700;">
                    @viewRequest.Status.ToUpper()
                </span>
            </div>

            <!-- Customer Information -->
            <div style="background: #f9fafb; border-radius: 12px; padding: 20px; margin-bottom: 16px;">
                <h3 style="font-size: 14px; font-weight: 600; color: #374151; margin: 0 0 12px 0;">Customer Information</h3>
                <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;">
                    <div>
                        <div style="font-size: 11px; color: #6b7280; text-transform: uppercase;">Full Name</div>
                        <div style="font-size: 14px; font-weight: 600; color: #111827;">@viewRequest.CustomerName</div>
                    </div>
                    <div>
                        <div style="font-size: 11px; color: #6b7280; text-transform: uppercase;">Username</div>
                        <div style="font-size: 14px; font-weight: 600; color: #111827;">@@@viewRequest.CustomerUsername
                        </div>
                    </div>
                    <div>
                        <div style="font-size: 11px; color: #6b7280; text-transform: uppercase;">Email</div>
                        <div style="font-size: 14px; color: #111827;">@(viewRequest.CustomerEmail ?? "Not provided")</div>
                    </div>
                    <div>
                        <div style="font-size: 11px; color: #6b7280; text-transform: uppercase;">Phone</div>
                        <div style="font-size: 14px; color: #111827;">@(viewRequest.CustomerPhone ?? "Not provided")</div>
                    </div>
                </div>
            </div>

            <!-- Request Details -->
            <div style="background: #fef2f2; border-radius: 12px; padding: 20px; margin-bottom: 16px;">
                <h3 style="font-size: 14px; font-weight: 600; color: #991b1b; margin: 0 0 12px 0;">Lock Information</h3>
                <div style="margin-bottom: 12px;">
                    <div style="font-size: 11px; color: #6b7280; text-transform: uppercase;">Lock Reason</div>
                    <div style="font-size: 14px; font-weight: 600; color: #dc2626;">@viewRequest.LockReason</div>
                </div>
                @if (!string.IsNullOrEmpty(viewRequest.CustomerStatement))
                {
                    <div style="margin-bottom: 12px;">
                        <div style="font-size: 11px; color: #6b7280; text-transform: uppercase;">Customer's Statement</div>
                        <div style="font-size: 14px; color: #374151;">@viewRequest.CustomerStatement</div>
                    </div>
                }
                <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;">
                    <div>
                        <div style="font-size: 11px; color: #6b7280; text-transform: uppercase;">ID Verified</div>
                        <div
                            style="font-size: 14px; font-weight: 600; color: @(viewRequest.IdentificationVerified ? "#5F6F52" : "#dc2626");">
                            @(viewRequest.IdentificationVerified ? "✓ Yes" : "✗ No")
                        </div>
                    </div>
                    @if (viewRequest.IdentificationVerified)
                    {
                        <div>
                            <div style="font-size: 11px; color: #6b7280; text-transform: uppercase;">ID Type</div>
                            <div style="font-size: 14px; color: #111827;">@viewRequest.IdentificationType
                                @(!string.IsNullOrEmpty(viewRequest.IdentificationNumber) ?
                                                        $"(****{viewRequest.IdentificationNumber})" : "")</div>
                        </div>
                    }
                    <div>
                        <div style="font-size: 11px; color: #6b7280; text-transform: uppercase;">Priority</div>
                        <span
                            style="background: @GetPriorityBackground(viewRequest.Priority); color: @GetPriorityColor(viewRequest.Priority); padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 600;">
                            @viewRequest.Priority
                        </span>
                    </div>
                </div>
            </div>

            <!-- Teller Information -->
            <div style="background: #dbeafe; border-radius: 12px; padding: 20px; margin-bottom: 16px;">
                <h3 style="font-size: 14px; font-weight: 600; color: #1e40af; margin: 0 0 12px 0;">Request Submitted By</h3>
                <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;">
                    <div>
                        <div style="font-size: 11px; color: #6b7280; text-transform: uppercase;">Teller Name</div>
                        <div style="font-size: 14px; font-weight: 600; color: #111827;">@viewRequest.RequestedByTellerName
                        </div>
                    </div>
                    <div>
                        <div style="font-size: 11px; color: #6b7280; text-transform: uppercase;">Submitted At</div>
                        <div style="font-size: 14px; color: #111827;">@viewRequest.RequestedAt.ToString("MMM dd, yyyy hh:mm tt")</div>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(viewRequest.TellerNotes))
                {
                    <div style="margin-top: 12px;">
                        <div style="font-size: 11px; color: #6b7280; text-transform: uppercase;">Teller Notes</div>
                        <div style="font-size: 14px; color: #374151;">@viewRequest.TellerNotes</div>
                    </div>
                }
            </div>

            <!-- Admin Processing (if processed) -->
            @if (viewRequest.ProcessedAt.HasValue)
            {
                <div
                    style="background: @(viewRequest.Status == "Approved" ? "#D4E6D4" : "#fee2e2"); border-radius: 12px; padding: 20px; margin-bottom: 16px;">
                    <h3
                        style="font-size: 14px; font-weight: 600; color: @(viewRequest.Status == "Approved" ? "#2F3E2A" : "#991b1b"); margin: 0 0 12px 0;">
                        Admin Decision
                    </h3>
                    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;">
                        <div>
                            <div style="font-size: 11px; color: #6b7280; text-transform: uppercase;">Processed By</div>
                            <div style="font-size: 14px; font-weight: 600; color: #111827;">@viewRequest.ProcessedByAdminName
                            </div>
                        </div>
                        <div>
                            <div style="font-size: 11px; color: #6b7280; text-transform: uppercase;">Processed At</div>
                            <div style="font-size: 14px; color: #111827;">@viewRequest.ProcessedAt.Value.ToString("MMM dd, yyyy hh:mm tt")</div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(viewRequest.AdminNotes))
                    {
                        <div style="margin-top: 12px;">
                            <div style="font-size: 11px; color: #6b7280; text-transform: uppercase;">Admin Notes</div>
                            <div style="font-size: 14px; color: #374151;">@viewRequest.AdminNotes</div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(viewRequest.RejectionReason))
                    {
                        <div style="margin-top: 12px;">
                            <div style="font-size: 11px; color: #6b7280; text-transform: uppercase;">Rejection Reason</div>
                            <div style="font-size: 14px; color: #dc2626; font-weight: 600;">@viewRequest.RejectionReason</div>
                        </div>
                    }
                </div>
            }

            <div style="display: flex; justify-content: flex-end; gap: 12px;">
                @if (viewRequest.Status == "Pending")
                {
                    <button @onclick="() => { CloseViewModal(); OpenProcessModal(viewRequest); }"
                        style="padding: 12px 24px; background: linear-gradient(135deg, #5F6F52, #2F3E2A); color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer;">
                        ⚡ Process Request
                    </button>
                }
                <button @onclick="CloseViewModal"
                    style="padding: 12px 24px; background: #e5e7eb; color: #374151; border: none; border-radius: 8px; font-weight: 600; cursor: pointer;">
                    Close
                </button>
            </div>
        </div>
    </div>
}

<!-- Process Request Modal -->
@if (showProcessModal && processRequest != null)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000;"
        @onclick="CloseProcessModal">
        <div style="background: white; border-radius: 16px; padding: 28px; max-width: 550px; width: 95%; max-height: 90vh; overflow-y: auto; box-shadow: 0 20px 60px rgba(0,0,0,0.3);"
            @onclick:stopPropagation="true">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                <h2 style="font-size: 20px; font-weight: 700; color: #1f2937; margin: 0;">
                    ⚡ Process Unlock Request
                </h2>
                <button @onclick="CloseProcessModal"
                    style="background: none; border: none; font-size: 24px; cursor: pointer; color: #6b7280;">&times;</button>
            </div>

            @if (!string.IsNullOrEmpty(processMessage))
            {
                <div
                    style="padding: 12px; margin-bottom: 16px; border-radius: 8px; background: @(processSuccess ? "#D4E6D4" : "#fee2e2"); color: @(processSuccess ? "#2F3E2A" : "#991b1b"); font-size: 14px;">
                    @processMessage
                </div>
            }

            <!-- Request Summary -->
            <div
                style="background: #fef2f2; border: 2px solid #fca5a5; border-radius: 12px; padding: 20px; margin-bottom: 20px;">
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                    <div
                        style="width: 48px; height: 48px; background: linear-gradient(135deg, #dc2626, #b91c1c); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 16px;">
                        @GetInitials(processRequest.CustomerName)
                    </div>
                    <div>
                        <div style="font-weight: 700; color: #111827; font-size: 16px;">@processRequest.CustomerName</div>
                        <div style="font-size: 13px; color: #6b7280;">@@@processRequest.CustomerUsername</div>
                    </div>
                </div>
                <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; font-size: 13px;">
                    <div><strong>Lock Reason:</strong> @TruncateText(processRequest.LockReason, 30)</div>
                    <div><strong>Priority:</strong>
                        <span
                            style="background: @GetPriorityBackground(processRequest.Priority); color: @GetPriorityColor(processRequest.Priority); padding: 2px 8px; border-radius: 12px; font-size: 11px; font-weight: 600;">
                            @processRequest.Priority
                        </span>
                    </div>
                    <div><strong>ID Verified:</strong> @(processRequest.IdentificationVerified ? "✓ Yes" : "✗ No")</div>
                    <div><strong>Submitted:</strong> @processRequest.RequestedAt.ToString("MMM dd, yyyy")</div>
                </div>
            </div>

            <!-- Decision Section -->
            <div style="margin-bottom: 20px;">
                <label style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 12px;">Your
                    Decision</label>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <button @onclick="@(() => processDecision = "Approve")"
                        style="padding: 16px; border-radius: 12px; border: 2px solid @(processDecision == "Approve" ? "#5F6F52" : "#e5e7eb"); background: @(processDecision == "Approve" ? "#D4E6D4" : "white"); cursor: pointer; text-align: center;">
                        <div style="font-size: 24px; margin-bottom: 4px;">✓</div>
                        <div style="font-weight: 600; color: @(processDecision == "Approve" ? "#2F3E2A" : "#374151");">
                            APPROVE</div>
                        <div style="font-size: 11px; color: #6b7280;">Unlock the account</div>
                    </button>
                    <button @onclick="@(() => processDecision = "Reject")"
                        style="padding: 16px; border-radius: 12px; border: 2px solid @(processDecision == "Reject" ? "#dc2626" : "#e5e7eb"); background: @(processDecision == "Reject" ? "#fee2e2" : "white"); cursor: pointer; text-align: center;">
                        <div style="font-size: 24px; margin-bottom: 4px;">✗</div>
                        <div style="font-weight: 600; color: @(processDecision == "Reject" ? "#991b1b" : "#374151");">REJECT
                        </div>
                        <div style="font-size: 11px; color: #6b7280;">Keep account locked</div>
                    </button>
                </div>
            </div>

            @if (processDecision == "Reject")
            {
                <div style="margin-bottom: 20px;">
                    <label
                        style="display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 6px;">Rejection
                        Reason *</label>
                    <textarea @bind="rejectionReason" rows="2" placeholder="Explain why the request is being rejected..."
                        style="width: 100%; padding: 10px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px; resize: vertical;"></textarea>
                </div>
            }

            <div style="margin-bottom: 20px;">
                <label style="display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 6px;">Admin
                    Notes (Optional)</label>
                <textarea @bind="adminNotes" rows="2" placeholder="Add any notes about this decision..."
                    style="width: 100%; padding: 10px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px; resize: vertical;"></textarea>
            </div>

            <div style="display: flex; gap: 12px; justify-content: flex-end;">
                <button @onclick="CloseProcessModal"
                    style="padding: 12px 24px; background: #e5e7eb; color: #374151; border: none; border-radius: 8px; font-weight: 600; cursor: pointer;">
                    Cancel
                </button>
                <button @onclick="SubmitDecision" disabled="@(isProcessing || string.IsNullOrEmpty(processDecision))"
                    style="padding: 12px 24px; background: @(processDecision == "Approve" ? "linear-gradient(135deg, #5F6F52, #2F3E2A)" : processDecision == "Reject" ? "linear-gradient(135deg, #dc2626, #b91c1c)" : "#9ca3af"); color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; opacity: @(isProcessing || string.IsNullOrEmpty(processDecision) ? "0.6" : "1");">
                    @(isProcessing ? "Processing..." : processDecision == "Approve" ? "✓ Approve & Unlock" : processDecision
                                    == "Reject" ? "✗ Reject Request" : "Select Decision")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<AccountUnlockRequest> unlockRequests = new();
    private string searchQuery = "";
    private string selectedStatus = "";
    private string selectedPriority = "";

    // View Modal
    private bool showViewModal = false;
    private AccountUnlockRequest? viewRequest;

    // Process Modal
    private bool showProcessModal = false;
    private AccountUnlockRequest? processRequest;
    private string processDecision = "";
    private string rejectionReason = "";
    private string adminNotes = "";
    private bool isProcessing = false;
    private string processMessage = "";
    private bool processSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            using var context = await DbContextFactory.CreateDbContextAsync();

            unlockRequests = await context.AccountUnlockRequests
            .OrderByDescending(r => r.Status == "Pending" ? 0 : 1)
            .ThenByDescending(r => r.Priority == "Urgent" ? 0 : r.Priority == "High" ? 1 : r.Priority == "Normal" ? 2 : 3)
            .ThenByDescending(r => r.RequestedAt)
            .ToListAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading unlock requests: {ex.Message}");
            unlockRequests = new List<AccountUnlockRequest>();
        }
    }

    private List<AccountUnlockRequest> GetFilteredRequests()
    {
        var filtered = unlockRequests.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var search = searchQuery.ToLower();
            filtered = filtered.Where(r =>
            r.CustomerName.ToLower().Contains(search) ||
            r.CustomerUsername.ToLower().Contains(search) ||
            r.RequestedByTellerName.ToLower().Contains(search) ||
            r.RequestId.ToString().Contains(search));
        }

        if (!string.IsNullOrEmpty(selectedStatus))
        {
            filtered = filtered.Where(r => r.Status == selectedStatus);
        }

        if (!string.IsNullOrEmpty(selectedPriority))
        {
            filtered = filtered.Where(r => r.Priority == selectedPriority);
        }

        return filtered.ToList();
    }

    private async Task ApplyFilters()
    {
        await Task.CompletedTask;
        StateHasChanged();
    }

    private async Task ResetFilters()
    {
        searchQuery = "";
        selectedStatus = "";
        selectedPriority = "";
        await Task.CompletedTask;
        StateHasChanged();
    }

    // View Modal Methods
    private void OpenViewModal(AccountUnlockRequest request)
    {
        viewRequest = request;
        showViewModal = true;
    }

    private void CloseViewModal()
    {
        showViewModal = false;
        viewRequest = null;
    }

    // Process Modal Methods
    private void OpenProcessModal(AccountUnlockRequest request)
    {
        processRequest = request;
        processDecision = "";
        rejectionReason = "";
        adminNotes = "";
        processMessage = "";
        processSuccess = false;
        showProcessModal = true;
    }

    private void CloseProcessModal()
    {
        showProcessModal = false;
        processRequest = null;
    }

    private async Task SubmitDecision()
    {
        if (processRequest == null || string.IsNullOrEmpty(processDecision))
        {
            processMessage = "Please select a decision.";
            processSuccess = false;
            return;
        }

        if (processDecision == "Reject" && string.IsNullOrWhiteSpace(rejectionReason))
        {
            processMessage = "Please provide a rejection reason.";
            processSuccess = false;
            return;
        }

        isProcessing = true;
        processMessage = "";

        try
        {
            using var context = await DbContextFactory.CreateDbContextAsync();

            // Update the request
            var request = await context.AccountUnlockRequests.FindAsync(processRequest.RequestId);
            if (request == null)
            {
                processMessage = "Request not found.";
                processSuccess = false;
                isProcessing = false;
                return;
            }

            request.Status = processDecision == "Approve" ? "Approved" : "Rejected";
            request.ProcessedByAdminId = AuthService.CurrentUserId;
            request.ProcessedByAdminName = AuthService.FullName ?? AuthService.CurrentUser ?? "Admin";
            request.ProcessedAt = DateTime.Now;
            request.AdminNotes = adminNotes;
            request.RejectionReason = processDecision == "Reject" ? rejectionReason : null;
            request.UpdatedAt = DateTime.Now;

            // If approved, unlock the customer's account
            if (processDecision == "Approve")
            {
                // CustomerUsername stores the account number (e.g., ACC-20251213-3043)
                var accountNumber = request.CustomerUsername;
                if (!string.IsNullOrEmpty(accountNumber))
                {
                    var customerAccount = await context.CustomerAccounts
                    .FirstOrDefaultAsync(ca => ca.AccountNumber == accountNumber);

                    if (customerAccount != null)
                    {
                        customerAccount.IsActive = true;
                        customerAccount.Status = "ACTIVE";
                        customerAccount.EligibilityRemarks = $"Unlocked by Admin on {DateTime.Now:MMM dd, yyyy hh:mm tt}. Previous reason: {request.LockReason}";

                        // Add ADMIN_ACCOUNT_UNLOCK audit log entry - this is the actual unlock mechanism
                        var unlockAuditLog = new AuditLog
                        {
                            CustomerAccountId = customerAccount.CustomerId,
                            UserId = (AuthService.CurrentUserId ?? 0).ToString(),
                            Action = "ADMIN_ACCOUNT_UNLOCK",
                            Module = "AccountUnlock",
                            Description = $"Account unlocked by Admin. Request ID: {request.RequestId}. Previous lock reason: {request.LockReason}",
                            IsAccountLocked = false,
                            LockReason = null,
                            PinAttemptCount = 0,
                            FailedAttemptCount = 0,
                            CreatedAt = DateTime.Now
                        };
                        context.AuditLogs.Add(unlockAuditLog);
                    }
                }
            }

            await context.SaveChangesAsync();

            processMessage = processDecision == "Approve"
                            ? "✓ Request approved! Customer account has been unlocked successfully."
                            : "✓ Request rejected. The customer's account remains locked.";
            processSuccess = true;

            // Reload data
            await LoadData();

            // Close modal after a delay
            await Task.Delay(2000);
            CloseProcessModal();
        }
        catch (Exception ex)
        {
            processMessage = $"Error processing request: {ex.Message}";
            processSuccess = false;
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    // Helper Methods
    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, 1).ToUpper();
        return (parts[0].Substring(0, 1) + parts[^1].Substring(0, 1)).ToUpper();
    }

    private string TruncateText(string? text, int maxLength)
    {
        if (string.IsNullOrEmpty(text)) return "";
        return text.Length <= maxLength ? text : text.Substring(0, maxLength) + "...";
    }

    private string GetStatusBackground(string status) => status switch
    {
        "Pending" => "#fef3c7",
        "Approved" => "#D4E6D4",
        "Rejected" => "#fee2e2",
        _ => "#f3f4f6"
    };

    private string GetStatusColor(string status) => status switch
    {
        "Pending" => "#92400e",
        "Approved" => "#2F3E2A",
        "Rejected" => "#991b1b",
        _ => "#4b5563"
    };

    private string GetPriorityBackground(string priority) => priority switch
    {
        "Low" => "#e0e7ff",
        "Normal" => "#dbeafe",
        "High" => "#fef3c7",
        "Urgent" => "#fee2e2",
        _ => "#f3f4f6"
    };

    private string GetPriorityColor(string priority) => priority switch
    {
        "Low" => "#3730a3",
        "Normal" => "#1e40af",
        "High" => "#92400e",
        "Urgent" => "#991b1b",
        _ => "#4b5563"
    };
}