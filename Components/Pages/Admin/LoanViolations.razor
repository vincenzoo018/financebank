@page "/admin/loan-violations"
@using FinanceBank.Models
@using Microsoft.EntityFrameworkCore
@inject BFASDbContext DbContext
@inject IJSRuntime JS

<div class="sidebar-content">
    <div class="card">
        <div class="card-header">
            <h1 class="modal-title">Loan Violations & Penalties</h1>
            <p class="modal-subtitle">Track late payments, penalties, and blacklisted accounts</p>
        </div>

        <div class="card-body" style="padding: 24px;">
            <!-- Summary Cards -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 32px;">
                <div class="stat-card">
                    <div class="stat-label">Active Violations</div>
                    <div class="stat-value">@activeViolations</div>
                    <div class="stat-change negative">Unresolved</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Total Penalties</div>
                    <div class="stat-value">₱@totalPenalties.ToString("N0")</div>
                    <div class="stat-change">Collected</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Blacklisted Accounts</div>
                    <div class="stat-value">@blacklistedCount</div>
                    <div class="stat-change negative">3+ violations</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Overdue Loans</div>
                    <div class="stat-value">@overdueLoans</div>
                    <div class="stat-change">Active</div>
                </div>
            </div>

            <!-- Filters -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px; padding: 20px; background: var(--bg-lighter); border-radius: var(--radius-md);">
                <div class="form-group" style="margin: 0;">
                    <label class="form-label">Violation Status</label>
                    <select class="form-control" @bind="filterStatus" @bind:after="ApplyFilters">
                        <option value="">All Violations</option>
                        <option value="ACTIVE">Active Only</option>
                        <option value="RESOLVED">Resolved Only</option>
                    </select>
                </div>
                <div class="form-group" style="margin: 0;">
                    <label class="form-label">Violation Type</label>
                    <select class="form-control" @bind="filterType" @bind:after="ApplyFilters">
                        <option value="">All Types</option>
                        <option value="LATE_PAYMENT">Late Payment</option>
                        <option value="MISSED_PAYMENT">Missed Payment</option>
                        <option value="REPEATED_VIOLATION">Repeated Violation</option>
                    </select>
                </div>
                <div class="form-group" style="margin: 0;">
                    <label class="form-label">Search</label>
                    <input type="text" class="form-control" @bind="searchQuery" @bind:after="ApplyFilters" 
                           placeholder="Loan number, customer..." />
                </div>
            </div>

            <!-- Violations List -->
            @if (isLoading)
            {
                <div class="text-center" style="padding: 40px;">
                    <p style="color: var(--text-gray);">Loading violations...</p>
                </div>
            }
            else if (!filteredViolations.Any())
            {
                <div class="text-center" style="padding: 40px;">
                    <p style="color: var(--text-gray); font-size: 16px;">No violations found</p>
                </div>
            }
            else
            {
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="border-bottom: 2px solid var(--border); background: var(--bg-lighter);">
                                <th style="padding: 16px 12px; text-align: left; font-size: 13px; color: var(--text-gray); font-weight: 700; text-transform: uppercase;">Date</th>
                                <th style="padding: 16px 12px; text-align: left; font-size: 13px; color: var(--text-gray); font-weight: 700; text-transform: uppercase;">Loan Number</th>
                                <th style="padding: 16px 12px; text-align: left; font-size: 13px; color: var(--text-gray); font-weight: 700; text-transform: uppercase;">Customer</th>
                                <th style="padding: 16px 12px; text-align: left; font-size: 13px; color: var(--text-gray); font-weight: 700; text-transform: uppercase;">Type</th>
                                <th style="padding: 16px 12px; text-align: left; font-size: 13px; color: var(--text-gray); font-weight: 700; text-transform: uppercase;">Days Overdue</th>
                                <th style="padding: 16px 12px; text-align: left; font-size: 13px; color: var(--text-gray); font-weight: 700; text-transform: uppercase;">Penalty</th>
                                <th style="padding: 16px 12px; text-align: left; font-size: 13px; color: var(--text-gray); font-weight: 700; text-transform: uppercase;">Status</th>
                                <th style="padding: 16px 12px; text-align: left; font-size: 13px; color: var(--text-gray); font-weight: 700; text-transform: uppercase;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var violation in filteredViolations)
                            {
                                var loan = GetLoan(violation.LoanId);
                                var account = loan != null ? GetAccount(loan.AccountId) : null;
                                var isBlacklisted = loan?.IsBlacklisted ?? false;
                                
                                <tr style="border-bottom: 1px solid var(--border); background: @(isBlacklisted ? "#fee2e2" : "white");">
                                    <td style="padding: 16px 12px; font-size: 14px;">
                                        @violation.ViolationDate.ToString("MMM dd, yyyy")
                                    </td>
                                    <td style="padding: 16px 12px; font-size: 14px; font-weight: 600;">
                                        @(loan?.LoanNumber ?? "N/A")
                                        @if (isBlacklisted)
                                        {
                                            <span style="display: block; font-size: 11px; color: var(--danger); font-weight: 700; margin-top: 4px;">
                                                🚫 BLACKLISTED
                                            </span>
                                        }
                                    </td>
                                    <td style="padding: 16px 12px; font-size: 14px;">
                                        @(account?.Customer?.FullName ?? "N/A")
                                    </td>
                                    <td style="padding: 16px 12px;">
                                        <span style="padding: 6px 10px; border-radius: 8px; font-size: 12px; font-weight: 600; background: @GetTypeColor(violation.ViolationType); color: white;">
                                            @violation.ViolationType.Replace("_", " ")
                                        </span>
                                    </td>
                                    <td style="padding: 16px 12px; font-size: 15px; font-weight: 600; color: @(violation.DaysOverdue > 30 ? "var(--danger)" : "var(--warning)");">
                                        @violation.DaysOverdue days
                                    </td>
                                    <td style="padding: 16px 12px; font-size: 15px; font-weight: 700; color: var(--danger);">
                                        ₱@violation.PenaltyAmount.ToString("N2")
                                    </td>
                                    <td style="padding: 16px 12px;">
                                        @if (violation.IsResolved)
                                        {
                                            <span style="padding: 6px 10px; border-radius: 8px; font-size: 12px; font-weight: 600; background: var(--success); color: white;">
                                                ✓ RESOLVED
                                            </span>
                                            <span style="display: block; font-size: 11px; color: var(--text-gray); margin-top: 4px;">
                                                @violation.ResolvedAt?.ToString("MMM dd")
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="padding: 6px 10px; border-radius: 8px; font-size: 12px; font-weight: 600; background: var(--danger); color: white;">
                                                ⚠ ACTIVE
                                            </span>
                                        }
                                    </td>
                                    <td style="padding: 16px 12px;">
                                        <button class="btn btn-sm" style="padding: 6px 12px; font-size: 13px; background: var(--info); color: white;" 
                                                @onclick="() => ViewDetails(violation)">
                                            View Details
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Info -->
                <div style="margin-top: 20px; text-align: center; color: var(--text-gray);">
                    Showing @filteredViolations.Count() of @allViolations.Count violations
                </div>
            }
        </div>
    </div>

    <!-- Blacklisted Accounts Section -->
    @if (blacklistedAccounts.Any())
    {
        <div class="card" style="margin-top: 32px;">
            <div class="card-header">
                <h2 class="modal-title" style="font-size: 20px;">Blacklisted Accounts</h2>
                <p class="modal-subtitle">Customers with 3 or more violations</p>
            </div>
            <div class="card-body" style="padding: 24px;">
                <div style="display: grid; gap: 16px;">
                    @foreach (var loan in blacklistedAccounts)
                    {
                        var account = GetAccount(loan.AccountId);
                        var violations = allViolations.Where(v => v.LoanId == loan.LoanId).ToList();
                        
                        <div style="border: 2px solid var(--danger); border-radius: var(--radius-md); padding: 20px; background: #fee2e2;">
                            <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 16px;">
                                <div>
                                    <h4 style="font-size: 18px; font-weight: 700; color: var(--danger); margin: 0 0 8px 0;">
                                        🚫 @(account?.Customer?.FullName ?? "Unknown Customer")
                                    </h4>
                                    <p style="font-size: 14px; color: var(--text-gray); margin: 0;">
                                        Account: @(account?.AccountNumber ?? "N/A") | Loan: @loan.LoanNumber
                                    </p>
                                </div>
                                <span style="background: var(--danger); color: white; padding: 8px 16px; border-radius: 12px; font-size: 13px; font-weight: 700;">
                                    BLACKLISTED
                                </span>
                            </div>
                            
                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px;">
                                <div>
                                    <p style="font-size: 13px; color: var(--text-gray); margin-bottom: 4px;">Outstanding Balance</p>
                                    <p style="font-size: 18px; font-weight: 700; color: var(--danger); margin: 0;">₱@loan.OutstandingBalance.ToString("N2")</p>
                                </div>
                                <div>
                                    <p style="font-size: 13px; color: var(--text-gray); margin-bottom: 4px;">Total Violations</p>
                                    <p style="font-size: 18px; font-weight: 700; color: var(--danger); margin: 0;">@violations.Count</p>
                                </div>
                                <div>
                                    <p style="font-size: 13px; color: var(--text-gray); margin-bottom: 4px;">Total Penalties</p>
                                    <p style="font-size: 18px; font-weight: 700; color: var(--danger); margin: 0;">₱@loan.TotalPenalties.ToString("N2")</p>
                                </div>
                                <div>
                                    <p style="font-size: 13px; color: var(--text-gray); margin-bottom: 4px;">Cumulative Late Days</p>
                                    <p style="font-size: 18px; font-weight: 700; color: var(--danger); margin: 0;">@loan.CumulativeLateDays days</p>
                                </div>
                            </div>
                            
                            @if (!string.IsNullOrWhiteSpace(loan.BlacklistedReason))
                            {
                                <div style="margin-top: 16px; padding: 12px; background: white; border-radius: var(--radius-sm);">
                                    <p style="font-size: 13px; color: var(--text-gray); margin: 0 0 4px 0;">Blacklist Reason:</p>
                                    <p style="font-size: 14px; font-weight: 600; color: var(--text-dark); margin: 0;">@loan.BlacklistedReason</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private List<LoanViolation> allViolations = new();
    private IEnumerable<LoanViolation> filteredViolations = Enumerable.Empty<LoanViolation>();
    private List<Loan> blacklistedAccounts = new();
    
    private int activeViolations;
    private decimal totalPenalties;
    private int blacklistedCount;
    private int overdueLoans;

    // Filters
    private string filterStatus = "";
    private string filterType = "";
    private string searchQuery = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadViolationsData();
    }

    private async Task LoadViolationsData()
    {
        isLoading = true;
        try
        {
            allViolations = await DbContext.LoanViolations
                .OrderByDescending(v => v.ViolationDate)
                .ToListAsync();

            activeViolations = allViolations.Count(v => !v.IsResolved);
            totalPenalties = allViolations.Sum(v => v.PenaltyAmount);

            blacklistedAccounts = await DbContext.Loans
                .Where(l => l.IsBlacklisted)
                .ToListAsync();
            
            blacklistedCount = blacklistedAccounts.Count;

            overdueLoans = await DbContext.Loans
                .CountAsync(l => l.Status == "OVERDUE");

            ApplyFilters();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error loading violations: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFilters()
    {
        filteredViolations = allViolations.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(filterStatus))
        {
            if (filterStatus == "ACTIVE")
                filteredViolations = filteredViolations.Where(v => !v.IsResolved);
            else if (filterStatus == "RESOLVED")
                filteredViolations = filteredViolations.Where(v => v.IsResolved);
        }

        if (!string.IsNullOrWhiteSpace(filterType))
        {
            filteredViolations = filteredViolations.Where(v => v.ViolationType == filterType);
        }

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var query = searchQuery.ToLower();
            filteredViolations = filteredViolations.Where(v =>
            {
                var loan = GetLoan(v.LoanId);
                var account = loan != null ? GetAccount(loan.AccountId) : null;
                return (loan?.LoanNumber?.ToLower().Contains(query) ?? false) ||
                       (account?.Customer?.FullName?.ToLower().Contains(query) ?? false);
            });
        }

        filteredViolations = filteredViolations.ToList();
    }

    private Loan? GetLoan(int loanId)
    {
        return DbContext.Loans.FirstOrDefault(l => l.LoanId == loanId);
    }

    private CustomerAccount? GetAccount(int accountId)
    {
        return DbContext.CustomerAccounts.FirstOrDefault(a => a.AccountId == accountId);
    }

    private string GetTypeColor(string type)
    {
        return type switch
        {
            "LATE_PAYMENT" => "#f59e0b",
            "MISSED_PAYMENT" => "#ef4444",
            "REPEATED_VIOLATION" => "#dc2626",
            _ => "#6b7280"
        };
    }

    private async Task ViewDetails(LoanViolation violation)
    {
        var loan = GetLoan(violation.LoanId);
        var account = loan != null ? GetAccount(loan.AccountId) : null;
        
        var message = $"Violation Details:\n\n" +
                      $"Date: {violation.ViolationDate:MMM dd, yyyy}\n" +
                      $"Customer: {account?.Customer?.FullName ?? "N/A"}\n" +
                      $"Loan: {loan?.LoanNumber ?? "N/A"}\n" +
                      $"Type: {violation.ViolationType}\n" +
                      $"Days Overdue: {violation.DaysOverdue}\n" +
                      $"Penalty Rate: {violation.PenaltyRate}%\n" +
                      $"Penalty Amount: ₱{violation.PenaltyAmount:N2}\n" +
                      $"Outstanding Balance: ₱{violation.OutstandingBalance:N2}\n" +
                      $"Status: {(violation.IsResolved ? "Resolved" : "Active")}\n" +
                      (violation.IsResolved ? $"Resolved At: {violation.ResolvedAt:MMM dd, yyyy}\n" : "") +
                      (!string.IsNullOrWhiteSpace(violation.Remarks) ? $"Remarks: {violation.Remarks}" : "");
        
        await JS.InvokeVoidAsync("alert", message);
    }
}
