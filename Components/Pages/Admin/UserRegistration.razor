@page "/admin/user-registration"
@layout AdminLayout
@inject NavigationManager Navigation
@inject AuthService AuthService
@inject IDbContextFactory<BFASDbContext> DbContextFactory
@inject UserRegistrationService RegistrationService
@using Microsoft.EntityFrameworkCore

<Toast @ref="toastComponent" />

<!-- Header with Gradient -->
<div style="background: linear-gradient(135deg, #059669, #047857); border-radius: 16px; padding: 32px; margin-bottom: 32px; color: white;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-9a9 9 0 11-18 0 9 9 0 0118 0zM9 19H5a2 2 0 00-2 2v2a2 2 0 002 2h14a2 2 0 002-2v-2a2 2 0 00-2-2h-4m-6-4a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        <div>
            <h1 style="font-size: 28px; font-weight: 700; margin: 0;">Register New User</h1>
            <p style="margin: 4px 0 0; opacity: 0.9; font-size: 14px;">Create employee or customer accounts with role-based access</p>
        </div>
    </div>
</div>

<!-- User Type Selection -->
<div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb; margin-bottom: 32px;">
    <h3 style="font-size: 16px; font-weight: 700; margin: 0 0 20px; color: #1f2937;">Select User Type</h3>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px;">
        <div style="border: 2px solid @(userType == "Employee" ? "#059669" : "#e5e7eb"); border-radius: 12px; padding: 20px; cursor: pointer; background: @(userType == "Employee" ? "#ecfdf5" : "white");" @onclick="@(() => SelectUserType("Employee"))">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #059669, #047857); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                    <svg width="24" height="24" fill="none" stroke="white" stroke-width="2"><path d="M12 4.354a4 4 0 110 5.292M15 21H3v-2a6 6 0 0112 0v2zm0 0h6v-2a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                </div>
                <div>
                    <h4 style="margin: 0; font-size: 16px; font-weight: 700; color: #1f2937;">Employee</h4>
                    <p style="margin: 4px 0 0; font-size: 12px; color: #6b7280;">Staff member account</p>
                </div>
            </div>
            <p style="margin: 0; font-size: 13px; color: #6b7280;">Assign department, employee ID, and role-based permissions for staff members.</p>
        </div>

        <div style="border: 2px solid @(userType == "Customer" ? "#059669" : "#e5e7eb"); border-radius: 12px; padding: 20px; cursor: pointer; background: @(userType == "Customer" ? "#ecfdf5" : "white");" @onclick="@(() => SelectUserType("Customer"))">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #059669, #047857); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                    <svg width="24" height="24" fill="none" stroke="white" stroke-width="2"><path d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <div>
                    <h4 style="margin: 0; font-size: 16px; font-weight: 700; color: #1f2937;">Customer</h4>
                    <p style="margin: 4px 0 0; font-size: 12px; color: #6b7280;">Personal banking account</p>
                </div>
            </div>
            <p style="margin: 0; font-size: 13px; color: #6b7280;">Create personal banking accounts for customers with access to banking services.</p>
        </div>
    </div>
</div>

<!-- User Registration Form -->
<div style="background: white; border-radius: 16px; padding: 32px; border: 1px solid #e5e7eb;">
    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px; padding-bottom: 16px; border-bottom: 2px solid #e5e7eb;">
        <span style="font-size: 24px;">📝</span>
        <h3 style="margin: 0; font-size: 20px; font-weight: 700;">@(userType == "Employee" ? "Employee Account Details" : "Customer Account Details")</h3>
    </div>

    <form @onsubmit="HandleRegistration" @onsubmit:preventDefault>
        <!-- Personal Information -->
        <div style="margin-bottom: 32px;">
            <h4 style="font-size: 15px; font-weight: 700; color: #1f2937; margin-bottom: 16px;">Personal Information</h4>
            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px;">
                <div>
                    <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Last Name *</label>
                    <input type="text" style="width: 100%; padding: 10px; border: 1px solid @(showError && string.IsNullOrEmpty(lastName) ? "#dc2626" : "#e5e7eb"); border-radius: 8px;" @bind="lastName" placeholder="Enter last name" />
                    @if (showError && string.IsNullOrEmpty(lastName)) { <span style="color: #dc2626; font-size: 12px;">Required</span> }
                </div>
                <div>
                    <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">First Name *</label>
                    <input type="text" style="width: 100%; padding: 10px; border: 1px solid @(showError && string.IsNullOrEmpty(firstName) ? "#dc2626" : "#e5e7eb"); border-radius: 8px;" @bind="firstName" placeholder="Enter first name" />
                    @if (showError && string.IsNullOrEmpty(firstName)) { <span style="color: #dc2626; font-size: 12px;">Required</span> }
                </div>
                <div>
                    <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Middle Name</label>
                    <input type="text" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" @bind="middleName" placeholder="Enter middle name (optional)" />
                </div>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px;">
                <div>
                    <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Email *</label>
                    <input type="email" style="width: 100%; padding: 10px; border: 1px solid @(showError && string.IsNullOrEmpty(email) ? "#dc2626" : "#e5e7eb"); border-radius: 8px;" @bind="email" placeholder="Enter email" />
                    @if (showError && string.IsNullOrEmpty(email)) { <span style="color: #dc2626; font-size: 12px;">Required</span> }
                </div>
                <div>
                    <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Contact Number * (11 digits)</label>
                    <input type="tel" style="width: 100%; padding: 10px; border: 1px solid @(showError && !string.IsNullOrEmpty(contactNumberError) ? "#dc2626" : "#e5e7eb"); border-radius: 8px;" @bind="contactNumber" placeholder="09XXXXXXXXX" maxlength="11" />
                    @if (showError && string.IsNullOrEmpty(contactNumber)) { <span style="color: #dc2626; font-size: 12px;">Required</span> }
                    @if (!string.IsNullOrEmpty(contactNumberError)) { <span style="color: #dc2626; font-size: 12px; display: block;">@contactNumberError</span> }
                </div>
                <div style="grid-column: span 2;">
                    <label style="font-size: 14px; font-weight: 700; display: block; margin-bottom: 12px; color: #1f2937;">Complete Address *</label>
                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px;">
                        <div>
                            <label style="font-size: 12px; font-weight: 500; display: block; margin-bottom: 4px; color: #6b7280;">House/Unit No. *</label>
                            <input type="text" style="width: 100%; padding: 10px; border: 1px solid @(showError && string.IsNullOrEmpty(houseUnitNumber) ? "#dc2626" : "#e5e7eb"); border-radius: 8px;" @bind="houseUnitNumber" placeholder="e.g., 123 or Unit 5B" />
                        </div>
                        <div>
                            <label style="font-size: 12px; font-weight: 500; display: block; margin-bottom: 4px; color: #6b7280;">Street Name *</label>
                            <input type="text" style="width: 100%; padding: 10px; border: 1px solid @(showError && string.IsNullOrEmpty(streetName) ? "#dc2626" : "#e5e7eb"); border-radius: 8px;" @bind="streetName" placeholder="e.g., Rizal Street" />
                        </div>
                        <div>
                            <label style="font-size: 12px; font-weight: 500; display: block; margin-bottom: 4px; color: #6b7280;">Barangay *</label>
                            <input type="text" style="width: 100%; padding: 10px; border: 1px solid @(showError && string.IsNullOrEmpty(barangay) ? "#dc2626" : "#e5e7eb"); border-radius: 8px;" @bind="barangay" placeholder="e.g., Brgy. San Antonio" />
                        </div>
                        <div>
                            <label style="font-size: 12px; font-weight: 500; display: block; margin-bottom: 4px; color: #6b7280;">City/Municipality *</label>
                            <input type="text" style="width: 100%; padding: 10px; border: 1px solid @(showError && string.IsNullOrEmpty(cityMunicipality) ? "#dc2626" : "#e5e7eb"); border-radius: 8px;" @bind="cityMunicipality" placeholder="e.g., Makati City" />
                        </div>
                        <div>
                            <label style="font-size: 12px; font-weight: 500; display: block; margin-bottom: 4px; color: #6b7280;">Province *</label>
                            <input type="text" style="width: 100%; padding: 10px; border: 1px solid @(showError && string.IsNullOrEmpty(province) ? "#dc2626" : "#e5e7eb"); border-radius: 8px;" @bind="province" placeholder="e.g., Metro Manila" />
                        </div>
                        <div>
                            <label style="font-size: 12px; font-weight: 500; display: block; margin-bottom: 4px; color: #6b7280;">Postal/ZIP Code *</label>
                            <input type="text" style="width: 100%; padding: 10px; border: 1px solid @(showError && string.IsNullOrEmpty(postalCode) ? "#dc2626" : "#e5e7eb"); border-radius: 8px;" @bind="postalCode" placeholder="e.g., 1200" maxlength="10" />
                        </div>
                        <div style="grid-column: span 3;">
                            <label style="font-size: 12px; font-weight: 500; display: block; margin-bottom: 4px; color: #6b7280;">Country</label>
                            <input type="text" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px; background: #f9fafb;" @bind="country" readonly />
                        </div>
                    </div>
                    @if (showError && string.IsNullOrEmpty(fullAddress)) { <span style="color: #dc2626; font-size: 12px; display: block; margin-top: 8px;">Please fill in all address fields</span> }
                    @if (!string.IsNullOrEmpty(fullAddress))
                    {
                        <div style="margin-top: 12px; padding: 12px; background: #f0fdf4; border-radius: 8px; border: 1px solid #bbf7d0;">
                            <label style="font-size: 11px; font-weight: 600; color: #059669; display: block; margin-bottom: 4px;">COMPLETE ADDRESS PREVIEW</label>
                            <span style="font-size: 13px; color: #065f46;">@fullAddress</span>
                        </div>
                    }
                </div>
                <div>
                    <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Date of Birth * (Must be 18+)</label>
                    <input type="date" style="width: 100%; padding: 10px; border: 1px solid @(showError && !string.IsNullOrEmpty(birthDateError) ? "#dc2626" : "#e5e7eb"); border-radius: 8px;" @onchange="@((ChangeEventArgs e) => ValidateBirthDate(e.Value?.ToString() ?? ""))" value="@dateOfBirthString" />
                    @if (!string.IsNullOrEmpty(birthDateError)) { <span style="color: #dc2626; font-size: 12px; display: block;">@birthDateError</span> }
                </div>
                <div>
                    <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Gender</label>
                    <select style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" @bind="gender">
                        <option value="">Select...</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div>
                    <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Civil Status *</label>
                    <select style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" @bind="civilStatus">
                        <option value="">Select...</option>
                        <option value="Single">Single</option>
                        <option value="Married">Married</option>
                        <option value="Widowed">Widowed</option>
                        <option value="Separated">Separated</option>
                    </select>
                </div>
                <div>
                    <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Mother's Maiden Name</label>
                    <input type="text" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" @bind="motherMaidenName" placeholder="Enter mother's maiden name" />
                </div>
            </div>
        </div>

        <!-- Employment & Income Information (Required for Account Eligibility) -->
        <div style="margin-bottom: 32px;">
            <h4 style="font-size: 15px; font-weight: 700; color: #1f2937; margin-bottom: 16px; display: flex; align-items: center; gap: 8px;">
                Employment & Income Information
                <span style="font-size: 11px; font-weight: 500; color: #dc2626; background: #fee2e2; padding: 2px 8px; border-radius: 4px;">Required for Account Eligibility</span>
            </h4>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                <div>
                    <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Employment Status *</label>
                    <select style="width: 100%; padding: 10px; border: 1px solid @(showError && string.IsNullOrEmpty(employmentStatus) ? "#dc2626" : "#e5e7eb"); border-radius: 8px;" @bind="employmentStatus">
                        <option value="">Select employment status...</option>
                        <option value="Employed">Employed</option>
                        <option value="Self-Employed">Self-Employed</option>
                        <option value="Business Owner">Business Owner</option>
                        <option value="OFW">OFW (Overseas Filipino Worker)</option>
                        <option value="Freelancer">Freelancer</option>
                        <option value="Government Employee">Government Employee</option>
                        <option value="Retired">Retired</option>
                        <option value="Student">Student</option>
                        <option value="Unemployed">Unemployed</option>
                    </select>
                    @if (showError && string.IsNullOrEmpty(employmentStatus)) { <span style="color: #dc2626; font-size: 12px;">Required</span> }
                </div>
                <div>
                    <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Monthly Gross Income *</label>
                    <input type="number" style="width: 100%; padding: 10px; border: 1px solid @(showError && monthlyGrossIncome <= 0 ? "#dc2626" : "#e5e7eb"); border-radius: 8px;" @bind="monthlyGrossIncome" placeholder="Enter monthly income" min="0" step="0.01" />
                    @if (showError && monthlyGrossIncome <= 0) { <span style="color: #dc2626; font-size: 12px;">Required</span> }
                </div>
            </div>

            @if (employmentStatus == "Employed" || employmentStatus == "Government Employee" || employmentStatus == "OFW")
            {
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px;">
                    <div>
                        <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Employer Name *</label>
                        <input type="text" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" @bind="employerName" placeholder="Enter employer/company name" />
                    </div>
                    <div>
                        <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Job Title/Position *</label>
                        <input type="text" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" @bind="jobTitle" placeholder="Enter job title" />
                    </div>
                    <div style="grid-column: span 2;">
                        <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Employer Address</label>
                        <input type="text" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" @bind="employerAddress" placeholder="Enter employer address" />
                    </div>
                    <div>
                        <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Employer Contact Number</label>
                        <input type="tel" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" @bind="employerContactNumber" placeholder="Enter employer phone" />
                    </div>
                    <div>
                        <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Years at Current Job</label>
                        <div style="display: flex; gap: 10px;">
                            <input type="number" style="width: 50%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" @bind="yearsAtCurrentJob" placeholder="Years" min="0" max="50" />
                            <input type="number" style="width: 50%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" @bind="monthsAtCurrentJob" placeholder="Months" min="0" max="11" />
                        </div>
                    </div>
                </div>
            }

            @if (employmentStatus == "Self-Employed" || employmentStatus == "Business Owner" || employmentStatus == "Freelancer")
            {
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px;">
                    <div>
                        <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Business/Trade Name</label>
                        <input type="text" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" @bind="employerName" placeholder="Enter business name" />
                    </div>
                    <div>
                        <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Nature of Business</label>
                        <input type="text" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" @bind="jobTitle" placeholder="Enter nature of business" />
                    </div>
                    <div style="grid-column: span 2;">
                        <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Business Address</label>
                        <input type="text" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" @bind="employerAddress" placeholder="Enter business address" />
                    </div>
                    <div>
                        <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Years in Business</label>
                        <input type="number" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" @bind="yearsAtCurrentJob" placeholder="Years" min="0" max="50" />
                    </div>
                </div>
            }

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px;">
                <div>
                    <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Other Income Source</label>
                    <input type="text" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" @bind="otherIncomeSource" placeholder="e.g., Rental, Investments, Pension" />
                </div>
                <div>
                    <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Other Income Amount (Monthly)</label>
                    <input type="number" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" @bind="otherIncomeAmount" placeholder="Enter amount" min="0" step="0.01" />
                </div>
            </div>

            <!-- Government IDs -->
            <div style="margin-top: 24px; padding-top: 20px; border-top: 1px solid #e5e7eb;">
                <p style="font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 16px;">Government IDs (At least one required)</p>
                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 16px;">
                    <div>
                        <label style="font-size: 12px; font-weight: 600; display: block; margin-bottom: 6px;">TIN (Tax ID)</label>
                        <input type="text" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 13px;" @bind="taxIdentificationNumber" placeholder="XXX-XXX-XXX-XXX" maxlength="15" />
                    </div>
                    <div>
                        <label style="font-size: 12px; font-weight: 600; display: block; margin-bottom: 6px;">SSS Number</label>
                        <input type="text" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 13px;" @bind="sssNumber" placeholder="XX-XXXXXXX-X" maxlength="12" />
                    </div>
                    <div>
                        <label style="font-size: 12px; font-weight: 600; display: block; margin-bottom: 6px;">Pag-IBIG Number</label>
                        <input type="text" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 13px;" @bind="pagIbigNumber" placeholder="XXXX-XXXX-XXXX" maxlength="14" />
                    </div>
                    <div>
                        <label style="font-size: 12px; font-weight: 600; display: block; margin-bottom: 6px;">PhilHealth Number</label>
                        <input type="text" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 13px;" @bind="philHealthNumber" placeholder="XX-XXXXXXXXX-X" maxlength="14" />
                    </div>
                </div>
            </div>

            <!-- Spouse Information (if married) -->
            @if (civilStatus == "Married")
            {
                <div style="margin-top: 24px; padding-top: 20px; border-top: 1px solid #e5e7eb;">
                    <p style="font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 16px;">Spouse Information</p>
                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px;">
                        <div>
                            <label style="font-size: 12px; font-weight: 600; display: block; margin-bottom: 6px;">Spouse Full Name</label>
                            <input type="text" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 13px;" @bind="spouseName" placeholder="Enter spouse's full name" />
                        </div>
                        <div>
                            <label style="font-size: 12px; font-weight: 600; display: block; margin-bottom: 6px;">Spouse Employer</label>
                            <input type="text" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 13px;" @bind="spouseEmployer" placeholder="Enter spouse's employer" />
                        </div>
                        <div>
                            <label style="font-size: 12px; font-weight: 600; display: block; margin-bottom: 6px;">Spouse Monthly Income</label>
                            <input type="number" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 13px;" @bind="spouseIncome" placeholder="Enter income" min="0" step="0.01" />
                        </div>
                    </div>
                </div>
            }

            <!-- Eligibility Notice -->
            <div style="margin-top: 20px; padding: 16px; background: #eff6ff; border-radius: 10px; border: 1px solid #bfdbfe;">
                <div style="display: flex; align-items: start; gap: 12px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="16" x2="12" y2="12"></line>
                        <line x1="12" y1="8" x2="12.01" y2="8"></line>
                    </svg>
                    <div>
                        <p style="font-size: 13px; font-weight: 600; color: #1e40af; margin: 0 0 4px;">Account & Loan Eligibility</p>
                        <p style="font-size: 12px; color: #3b82f6; margin: 0;">Employment and income information is required to determine account eligibility and future loan qualification. Customers with verified employment may qualify for loan products.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Profile Picture Upload -->
        <div style="margin-bottom: 32px;">
            <h4 style="font-size: 15px; font-weight: 700; color: #1f2937; margin-bottom: 16px;">Profile Picture</h4>
            <div style="background: #f9fafb; border: 2px dashed #e5e7eb; border-radius: 12px; padding: 32px; text-align: center;">
                <p style="margin: 0 0 16px; font-size: 14px; font-weight: 600; color: #1f2937;">Upload Profile Picture</p>
                <button type="button" @onclick="PickProfilePicture" style="background: linear-gradient(135deg, #059669, #047857); color: white; padding: 12px 24px; border-radius: 8px; font-weight: 600; cursor: pointer; border: none;">
                    Choose Picture
                </button>
                @if (profilePicturePreview != null)
                {
                    <div style="margin-top: 20px;">
                        <img src="@profilePicturePreview" style="max-width: 200px; max-height: 200px; border-radius: 12px; border: 3px solid #059669; object-fit: cover;" alt="Profile Preview" />
                        <div style="margin-top: 12px; padding: 12px; background: #d1fae5; border-radius: 8px; color: #065f46; font-size: 13px;">
                            ✓ @profilePictureFileName
                            <button type="button" @onclick="ClearProfilePicture" style="margin-left: 12px; background: #059669; color: white; padding: 4px 12px; border-radius: 6px; border: none; font-size: 12px; cursor: pointer;">Remove</button>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- ID Upload -->
        <div style="margin-bottom: 32px;">
            <h4 style="font-size: 15px; font-weight: 700; color: #1f2937; margin-bottom: 16px;">Valid ID Upload</h4>
            <div style="background: #f9fafb; border: 2px dashed #e5e7eb; border-radius: 12px; padding: 32px; text-align: center;">
                <p style="margin: 0 0 16px; font-size: 14px; font-weight: 600; color: #1f2937;">Upload Valid ID</p>
                <button type="button" @onclick="PickIDFile" style="background: linear-gradient(135deg, #059669, #047857); color: white; padding: 12px 24px; border-radius: 8px; font-weight: 600; cursor: pointer; border: none;">
                    Choose File
                </button>
                @if (!string.IsNullOrEmpty(uploadedIdFileName))
                {
                    <div style="margin-top: 16px; padding: 12px; background: #d1fae5; border-radius: 8px; color: #065f46; font-size: 13px;">
                        ✓ @uploadedIdFileName
                    </div>
                }
            </div>
        </div>

        <!-- Credentials -->
        <div style="margin-bottom: 32px;">
            <h4 style="font-size: 15px; font-weight: 700; color: #1f2937; margin-bottom: 16px;">Account Credentials</h4>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                <div>
                    <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Username *</label>
                    <input type="text" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" @bind="username" placeholder="Username" />
                    @if (showError && string.IsNullOrEmpty(username)) { <span style="color: #dc2626; font-size: 12px;">Required</span> }
                </div>
                <div>
                    <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Password *</label>
                    <input type="@(showPassword ? "text" : "password")" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" @bind="initialPassword" placeholder="Minimum 12 characters" />
                    @if (showError && string.IsNullOrEmpty(initialPassword))
                    {
                        <span style="color: #dc2626; font-size: 12px;">Password is required</span>
                    }
                    @if (!string.IsNullOrEmpty(passwordError))
                    {
                        <span style="color: #dc2626; font-size: 12px; display: block; margin-top: 4px;">@passwordError</span>
                    }
                    <label style="font-size: 12px; margin-top: 8px; display: flex; align-items: center; gap: 4px; cursor: pointer;">
                        <input type="checkbox" @onchange="() => showPassword = !showPassword" />
                        Show Password
                    </label>
                    <div style="margin-top: 8px; padding: 10px; background: #ecfdf5; border-radius: 6px; border: 1px solid #6ee7b7;">
                        <p style="font-size: 11px; color: #047857; margin: 0 0 4px; font-weight: 600;">Password Requirements:</p>
                        <ul style="font-size: 11px; color: #047857; margin: 0; padding-left: 20px;">
                            <li>Minimum 12 characters</li>
                            <li>At least 1 uppercase letter (A-Z)</li>
                            <li>At least 1 lowercase letter (a-z)</li>
                            <li>At least 1 number (0-9)</li>
                            <li>At least 1 special character (!@@#$%^&*)</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Security PIN -->
        <div style="margin-bottom: 32px;">
            <h4 style="font-size: 15px; font-weight: 700; color: #1f2937; margin-bottom: 16px;">Security PIN (For Transactions)</h4>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                <div>
                    <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">4-Digit PIN *</label>
                    <input type="@(showPin ? "text" : "password")" style="width: 100%; padding: 10px; border: 1px solid @(showError && string.IsNullOrEmpty(transferPin) ? "#dc2626" : "#e5e7eb"); border-radius: 8px; letter-spacing: 6px; text-align: center; font-size: 18px;" @bind="transferPin" placeholder="●●●●" maxlength="4" />
                    @if (showError && string.IsNullOrEmpty(transferPin)) { <span style="color: #dc2626; font-size: 12px;">PIN is required</span> }
                    @if (!string.IsNullOrEmpty(pinError)) { <span style="color: #dc2626; font-size: 12px; display: block; margin-top: 4px;">@pinError</span> }
                    <label style="font-size: 12px; margin-top: 8px; display: flex; align-items: center; gap: 4px; cursor: pointer;">
                        <input type="checkbox" @onchange="() => showPin = !showPin" />
                        Show PIN
                    </label>
                </div>
                <div>
                    <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Confirm PIN *</label>
                    <input type="@(showPin ? "text" : "password")" style="width: 100%; padding: 10px; border: 1px solid @(showError && string.IsNullOrEmpty(confirmPin) ? "#dc2626" : "#e5e7eb"); border-radius: 8px; letter-spacing: 6px; text-align: center; font-size: 18px;" @bind="confirmPin" placeholder="●●●●" maxlength="4" />
                    @if (showError && string.IsNullOrEmpty(confirmPin)) { <span style="color: #dc2626; font-size: 12px;">Confirm PIN is required</span> }
                    <div style="margin-top: 8px; padding: 10px; background: #ecfdf5; border-radius: 6px; border: 1px solid #6ee7b7;">
                        <p style="font-size: 11px; color: #047857; margin: 0; font-weight: 600;">⚠️ PIN Requirements:</p>
                        <ul style="font-size: 11px; color: #047857; margin: 4px 0 0; padding-left: 20px;">
                            <li>Exactly 4 digits (0-9)</li>
                            <li>Used for fund transfers and teller transactions</li>
                            <li>Keep it secure!</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Role & Department -->
        @if (userType == "Employee")
        {
            <div style="margin-bottom: 32px;">
                <h4 style="font-size: 15px; font-weight: 700; color: #1f2937; margin-bottom: 16px;">Role & Department</h4>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                    <div>
                        <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Role *</label>
                        <select style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" @bind="selectedRole">
                            <option value="">Select role...</option>
                            <option value="SuperAdmin">Super Administrator</option>
                            <option value="Accountant">Accountant</option>
                            <option value="FinanceManager">Finance Manager</option>
                            <option value="Teller">Teller</option>
                            <option value="Registrar">Registrar</option>
                        </select>
                        @if (showError && string.IsNullOrEmpty(selectedRole)) { <span style="color: #dc2626; font-size: 12px;">Required</span> }
                    </div>
                    <div>
                        <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Department *</label>
                        <select style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" @bind="department">
                            <option value="">Select department...</option>
                            <option value="Finance">Finance</option>
                            <option value="Accounting">Accounting</option>
                            <option value="Loans">Loans</option>
                            <option value="Operations">Operations</option>
                            <option value="Customer Service">Customer Service</option>
                            <option value="Registration">Registration</option>
                            <option value="IT">IT</option>
                            <option value="HR">HR</option>
                            <option value="Audit">Audit</option>
                            <option value="Management">Management</option>
                        </select>
                        @if (showError && string.IsNullOrEmpty(department)) { <span style="color: #dc2626; font-size: 12px;">Required</span> }
                    </div>
                    <div>
                        <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Employee ID</label>
                        <p style="padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px; background: #f1f5f9; color: #64748b; font-style: italic;">Auto-generated by database</p>
                    </div>
                    <div>
                        <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Branch/Location</label>
                        <input type="text" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" @bind="branchLocation" placeholder="Branch" />
                    </div>
                </div>
            </div>
        }

        <!-- Messages -->
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div style="padding: 16px; background: #fee2e2; border-radius: 8px; color: #991b1b; margin-bottom: 20px;">
                <strong>Error:</strong> @errorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div style="padding: 16px; background: #d1fae5; border-radius: 8px; color: #065f46; margin-bottom: 20px;">
                <strong>Success:</strong> @successMessage
            </div>
        }

        <!-- Buttons -->
        <div style="display: flex; gap: 12px; justify-content: flex-end; padding-top: 20px; border-top: 2px solid #e5e7eb;">
            <button type="button" style="background: #f3f4f6; color: #374151; padding: 12px 24px; border-radius: 8px; border: none; font-weight: 600; cursor: pointer;" @onclick="ClearForm">
                Reset
            </button>
            <button type="submit" style="background: linear-gradient(135deg, #059669, #047857); color: white; padding: 12px 32px; border-radius: 8px; border: none; font-weight: 600; cursor: pointer;" disabled="@isLoading">
                @if (isLoading) { <span>Creating...</span> } else { <span>Create Account</span> }
            </button>
        </div>
    </form>
</div>

@using FinanceBank.Data
@using FinanceBank.Models
@using Microsoft.EntityFrameworkCore
@inject PasswordHashingService PasswordHasher

@code {
    private Toast? toastComponent;
    
    private string userType = "Employee";
    private string lastName = "";
    private string firstName = "";
    private string middleName = "";
    private string fullName => string.IsNullOrEmpty(middleName) 
        ? $"{lastName}, {firstName}".Trim(new[] { ',', ' ' })
        : $"{lastName}, {firstName} {middleName}".Trim();
    private string email = "";
    private string contactNumber = "";
    private string contactNumberError = "";
    
    // Detailed address fields
    private string houseUnitNumber = "";
    private string streetName = "";
    private string barangay = "";
    private string cityMunicipality = "";
    private string province = "";
    private string postalCode = "";
    private string country = "Philippines";
    
    // Combined address computed property
    private string fullAddress => BuildFullAddress();
    private string address => fullAddress; // For backward compatibility
    
    private string BuildFullAddress()
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(houseUnitNumber)) parts.Add(houseUnitNumber);
        if (!string.IsNullOrWhiteSpace(streetName)) parts.Add(streetName);
        if (!string.IsNullOrWhiteSpace(barangay)) parts.Add(barangay);
        if (!string.IsNullOrWhiteSpace(cityMunicipality)) parts.Add(cityMunicipality);
        if (!string.IsNullOrWhiteSpace(province)) parts.Add(province);
        if (!string.IsNullOrWhiteSpace(postalCode)) parts.Add(postalCode);
        if (!string.IsNullOrWhiteSpace(country)) parts.Add(country);
        return string.Join(", ", parts);
    }
    
    private string dateOfBirthString = "";
    private string birthDateError = "";
    private string gender = "";
    private string uploadedIdFileName = "";
    private byte[]? profilePictureData = null;
    private string? profilePictureFileName = null;
    private string? profilePictureContentType = null;
    private string? profilePicturePreview = null;
    private string username = "";
    private string initialPassword = "";
    private bool showPassword = false;
    private string transferPin = "";
    private string confirmPin = "";
    private bool showPin = false;
    private string pinError = "";
    private string selectedRole = "";
    private string department = "";
    private int? employeeId = null;
    private string branchLocation = "";
    private List<string> selectedPermissions = new();
    private List<string> availablePermissions = new() { "Dashboard", "Transactions", "Accounts", "Users", "Reports", "Settings", "Accounting", "HR/Payroll", "CRM", "Loans", "Cards", "Bills", "Security", "Audit" };
    private bool showError = false;
    private bool isLoading = false;
    private string errorMessage = "";
    private string successMessage = "";
    private string passwordError = "";
    private List<PendingUser> pendingUsers = new();
    
    // Employment & Income fields
    private string employmentStatus = "";
    private string employerName = "";
    private string employerAddress = "";
    private string employerContactNumber = "";
    private string jobTitle = "";
    private int yearsAtCurrentJob = 0;
    private int monthsAtCurrentJob = 0;
    private decimal monthlyGrossIncome = 0;
    private string otherIncomeSource = "";
    private decimal otherIncomeAmount = 0;
    private string taxIdentificationNumber = "";
    private string sssNumber = "";
    private string pagIbigNumber = "";
    private string philHealthNumber = "";
    private string spouseName = "";
    private string spouseEmployer = "";
    private decimal spouseIncome = 0;
    private string civilStatus = "";
    private string motherMaidenName = "";

    private void ValidateBirthDate(string dateValue)
    {
        dateOfBirthString = dateValue;
        birthDateError = "";
        
        if (!string.IsNullOrEmpty(dateValue) && DateTime.TryParse(dateValue, out var birthDate))
        {
            var age = DateTime.Today.Year - birthDate.Year;
            if (birthDate.Date > DateTime.Today.AddYears(-age)) age--;
            
            if (age < 18)
            {
                birthDateError = "User must be at least 18 years old";
            }
        }
    }

    private bool ValidateContactNumber()
    {
        contactNumberError = "";
        
        if (string.IsNullOrEmpty(contactNumber))
        {
            contactNumberError = "Contact number is required";
            return false;
        }
        
        // Remove any spaces or dashes
        var cleanNumber = contactNumber.Replace(" ", "").Replace("-", "");
        
        if (cleanNumber.Length != 11)
        {
            contactNumberError = "Contact number must be exactly 11 digits";
            return false;
        }
        
        if (!cleanNumber.All(char.IsDigit))
        {
            contactNumberError = "Contact number must contain only digits";
            return false;
        }
        
        return true;
    }

    private void SelectUserType(string type)
    {
        userType = type;
        selectedRole = "";
        department = "";
        employeeId = null;
        branchLocation = "";
        selectedPermissions.Clear();
        errorMessage = "";
        successMessage = "";
    }

    private void TogglePermission(string permission)
    {
        if (selectedPermissions.Contains(permission))
            selectedPermissions.Remove(permission);
        else
            selectedPermissions.Add(permission);
    }

    private async Task HandleRegistration()
    {
        showError = true;
        errorMessage = "";
        successMessage = "";
        passwordError = "";
        pinError = "";
        contactNumberError = "";

        // Validate required fields (name is now split into parts)
        if (string.IsNullOrEmpty(lastName) || string.IsNullOrEmpty(firstName) || string.IsNullOrEmpty(email) || string.IsNullOrEmpty(contactNumber) || string.IsNullOrEmpty(address) || string.IsNullOrEmpty(username) || string.IsNullOrEmpty(initialPassword))
        {
            errorMessage = "Please fill in all required fields";
            return;
        }

        // Validate contact number (11 digits)
        if (!ValidateContactNumber())
        {
            errorMessage = "Contact number must be exactly 11 digits";
            return;
        }

        // Validate birthdate (18+ years old)
        if (!string.IsNullOrEmpty(dateOfBirthString))
        {
            if (DateTime.TryParse(dateOfBirthString, out var birthDate))
            {
                var age = DateTime.Today.Year - birthDate.Year;
                if (birthDate.Date > DateTime.Today.AddYears(-age)) age--;
                
                if (age < 18)
                {
                    birthDateError = "User must be at least 18 years old";
                    errorMessage = "User must be at least 18 years old to register";
                    return;
                }
            }
        }

        // Validate PIN
        if (string.IsNullOrEmpty(transferPin) || string.IsNullOrEmpty(confirmPin))
        {
            pinError = "PIN is required";
            errorMessage = "Please enter a 4-digit PIN";
            return;
        }

        if (transferPin.Length != 4 || !transferPin.All(char.IsDigit))
        {
            pinError = "PIN must be exactly 4 digits";
            errorMessage = "PIN must be exactly 4 digits (0-9)";
            return;
        }

        if (transferPin != confirmPin)
        {
            pinError = "PINs do not match";
            errorMessage = "PIN and Confirm PIN must match";
            return;
        }

        // Validate password strength
        var (isValid, validationError) = PasswordHasher.ValidatePasswordStrength(initialPassword);
        if (!isValid)
        {
            passwordError = validationError;
            errorMessage = "Password does not meet security requirements";
            return;
        }

        if (userType == "Employee" && (string.IsNullOrEmpty(selectedRole) || string.IsNullOrEmpty(department)))
        {
            errorMessage = "Please select a role and department for the employee";
            return;
        }

        isLoading = true;

        try
        {
            // Hash the password and PIN before sending to service
            var hashedPassword = PasswordHasher.HashPassword(initialPassword);
            var hashedPin = PasswordHasher.HashPassword(transferPin);
            
            // Save user to database with profile picture
            using var context = await DbContextFactory.CreateDbContextAsync();
            
            // Check if username already exists
            var existingUser = await context.Users.FirstOrDefaultAsync(u => u.Username == username);
            if (existingUser != null)
            {
                errorMessage = "Username already exists. Please choose a different username.";
                isLoading = false;
                return;
            }

            // Create new user with all employment and income fields
            var newUser = new AuthUser
            {
                Username = username,
                PasswordHash = hashedPassword,
                FullName = fullName,
                Email = email,
                PhoneNumber = contactNumber,
                Role = userType == "Employee" ? selectedRole : "Customer",
                IsActive = true,
                CreatedAt = DateTime.Now,
                ProfilePicture = profilePictureData,
                ProfilePictureFileName = profilePictureFileName,
                ProfilePictureContentType = profilePictureContentType,
                TransferPinHash = hashedPin,
                // Personal Details
                DateOfBirth = DateTime.TryParse(dateOfBirthString, out var dob) ? dob : null,
                Gender = !string.IsNullOrEmpty(gender) ? gender : null,
                CivilStatus = !string.IsNullOrEmpty(civilStatus) ? civilStatus : null,
                Nationality = "Filipino",
                MotherMaidenName = !string.IsNullOrEmpty(motherMaidenName) ? motherMaidenName : null,
                PermanentAddress = address,
                PresentAddress = address,
                // Employment Information
                EmploymentStatus = !string.IsNullOrEmpty(employmentStatus) ? employmentStatus : null,
                EmployerName = !string.IsNullOrEmpty(employerName) ? employerName : null,
                EmployerAddress = !string.IsNullOrEmpty(employerAddress) ? employerAddress : null,
                EmployerContactNumber = !string.IsNullOrEmpty(employerContactNumber) ? employerContactNumber : null,
                JobTitle = !string.IsNullOrEmpty(jobTitle) ? jobTitle : null,
                YearsAtCurrentJob = yearsAtCurrentJob > 0 ? yearsAtCurrentJob : null,
                MonthsAtCurrentJob = monthsAtCurrentJob > 0 ? monthsAtCurrentJob : null,
                // Income Information
                MonthlyGrossIncome = monthlyGrossIncome > 0 ? monthlyGrossIncome : null,
                OtherIncomeSource = !string.IsNullOrEmpty(otherIncomeSource) ? otherIncomeSource : null,
                OtherIncomeAmount = otherIncomeAmount > 0 ? otherIncomeAmount : null,
                TotalMonthlyIncome = monthlyGrossIncome + otherIncomeAmount + spouseIncome,
                AnnualIncome = (monthlyGrossIncome + otherIncomeAmount + spouseIncome) * 12,
                // Government IDs
                TaxIdentificationNumber = !string.IsNullOrEmpty(taxIdentificationNumber) ? taxIdentificationNumber : null,
                SSSNumber = !string.IsNullOrEmpty(sssNumber) ? sssNumber : null,
                PagIbigNumber = !string.IsNullOrEmpty(pagIbigNumber) ? pagIbigNumber : null,
                PhilHealthNumber = !string.IsNullOrEmpty(philHealthNumber) ? philHealthNumber : null,
                // Spouse Information
                SpouseName = !string.IsNullOrEmpty(spouseName) ? spouseName : null,
                SpouseEmployer = !string.IsNullOrEmpty(spouseEmployer) ? spouseEmployer : null,
                SpouseIncome = spouseIncome > 0 ? spouseIncome : null
            };

            context.Users.Add(newUser);
            await context.SaveChangesAsync();

            var accountNumber = "";

            // If employee, create employee record
            if (userType == "Employee")
            {
                var employee = new Employee
                {
                    UserId = newUser.UserId,
                    FirstName = fullName?.Split(' ').FirstOrDefault() ?? username,
                    LastName = fullName?.Split(' ').Skip(1).FirstOrDefault() ?? "",
                    Department = department ?? "General",
                    Position = selectedRole,
                    HireDate = DateTime.Now,
                    IsActive = true
                };

                // Note: Do NOT set EmployeeId manually - it's an identity column generated by the database

                context.Employees.Add(employee);
                await context.SaveChangesAsync();
                
                // Update user with employee FK
                newUser.EmployeeId_FK = employee.EmployeeId;
                await context.SaveChangesAsync();
                
                accountNumber = $"EMP-{employee.EmployeeId:D5}";
            }
            else
            {
                // NOTE: Eligibility fields are configured to be IGNORED by EF Core in BFASDbContext
                // until the database is updated with LOAN_PROCESS_ENHANCEMENT.sql
                // The fields below (AccountType, AccountPurpose, EligibilityStatus, etc.) are NOT saved to DB
                
                // Create customer account with core fields only
                accountNumber = $"ACC-{DateTime.Now:yyyyMMdd}-{new Random().Next(1000, 9999)}";
                var customerAccount = new CustomerAccount
                {
                    AccountNumber = accountNumber,
                    CustomerId = newUser.UserId, // Link to user
                    Balance = 0,
                    AvailableBalance = 0,
                    Currency = "PHP",
                    Status = "ACTIVE",
                    IsActive = true,
                    CreatedAt = DateTime.Now
                    // NOTE: Eligibility fields (AccountType, AccountPurpose, EligibilityStatus, 
                    // CanApplyForLoan, MaxLoanAmount, etc.) are IGNORED by EF Core until 
                    // LOAN_PROCESS_ENHANCEMENT.sql is run on the database
                };

                context.CustomerAccounts.Add(customerAccount);
                await context.SaveChangesAsync();
            }

            // Show success message
            var profilePicStatus = profilePictureData != null ? " (Profile picture saved to database)" : "";
            successMessage = $"✓ Account created successfully{profilePicStatus}!\n\nAccount Number: {accountNumber}\nUsername: {username}\nRole: {(userType == "Employee" ? selectedRole : "Customer")}\n{(userType == "Employee" ? $"Department: {department}" : "")}\n\nUser can log in immediately. Profile picture is stored in SQL Server database.";
            
            // Clear form after brief delay
            await Task.Delay(2000);
            ClearForm();
            isLoading = false;
        }
        catch (DbUpdateException dbEx)
        {
            // Show the inner exception for better debugging
            var innerMsg = dbEx.InnerException?.Message ?? dbEx.Message;
            errorMessage = $"Database Error: {innerMsg}";
            isLoading = false;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            isLoading = false;
        }
    }

    private string GenerateAccountNumber()
    {
        // Format: ACC-YYYY-XXXXX (e.g., ACC-2025-00001)
        var year = DateTime.Now.Year;
        var randomPart = new Random().Next(1, 99999).ToString("D5");
        return $"ACC-{year}-{randomPart}";
    }

    private void ClearForm()
    {
        lastName = "";
        firstName = "";
        middleName = "";
        email = "";
        contactNumber = "";
        contactNumberError = "";
        // Reset address fields
        houseUnitNumber = "";
        streetName = "";
        barangay = "";
        cityMunicipality = "";
        province = "";
        postalCode = "";
        country = "Philippines";
        dateOfBirthString = "";
        birthDateError = "";
        gender = "";
        uploadedIdFileName = "";
        profilePictureData = null;
        profilePictureFileName = null;
        profilePictureContentType = null;
        profilePicturePreview = null;
        username = "";
        initialPassword = "";
        transferPin = "";
        confirmPin = "";
        showPin = false;
        pinError = "";
        selectedRole = "";
        department = "";
        employeeId = null;
        branchLocation = "";
        selectedPermissions.Clear();
        showError = false;
        errorMessage = "";
        passwordError = "";
        // Clear employment fields
        employmentStatus = "";
        employerName = "";
