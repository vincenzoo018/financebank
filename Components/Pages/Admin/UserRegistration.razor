@page "/admin/user-registration"
@layout AdminLayout
@inject NavigationManager Navigation
@inject AuthService AuthService
@inject BFASDbContext DbContext
@inject UserRegistrationService RegistrationService

<Toast @ref="toastComponent" />

<!-- Header with Gradient -->
<div style="background: linear-gradient(135deg, #1f2937, #111827); border-radius: 16px; padding: 32px; margin-bottom: 32px; color: white;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-9a9 9 0 11-18 0 9 9 0 0118 0zM9 19H5a2 2 0 00-2 2v2a2 2 0 002 2h14a2 2 0 002-2v-2a2 2 0 00-2-2h-4m-6-4a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        <div>
            <h1 style="font-size: 28px; font-weight: 700; margin: 0;">Register New User</h1>
            <p style="margin: 4px 0 0; opacity: 0.9; font-size: 14px;">Create employee or customer accounts with role-based access</p>
        </div>
    </div>
</div>

<!-- User Type Selection -->
<div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb; margin-bottom: 32px;">
    <h3 style="font-size: 16px; font-weight: 700; margin: 0 0 20px; color: #1f2937;">Select User Type</h3>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px;">
        <div style="border: 2px solid @(userType == "Employee" ? "#2563eb" : "#e5e7eb"); border-radius: 12px; padding: 20px; cursor: pointer; background: @(userType == "Employee" ? "#eff6ff" : "white");" @onclick="@(() => SelectUserType("Employee"))">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #2563eb, #1e40af); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                    <svg width="24" height="24" fill="none" stroke="white" stroke-width="2"><path d="M12 4.354a4 4 0 110 5.292M15 21H3v-2a6 6 0 0112 0v2zm0 0h6v-2a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                </div>
                <div>
                    <h4 style="margin: 0; font-size: 16px; font-weight: 700; color: #1f2937;">Employee</h4>
                    <p style="margin: 4px 0 0; font-size: 12px; color: #6b7280;">Staff member account</p>
                </div>
            </div>
            <p style="margin: 0; font-size: 13px; color: #6b7280;">Assign department, employee ID, and role-based permissions for staff members.</p>
        </div>

        <div style="border: 2px solid @(userType == "Customer" ? "#059669" : "#e5e7eb"); border-radius: 12px; padding: 20px; cursor: pointer; background: @(userType == "Customer" ? "#f0fdf4" : "white");" @onclick="@(() => SelectUserType("Customer"))">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #059669, #047857); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                    <svg width="24" height="24" fill="none" stroke="white" stroke-width="2"><path d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <div>
                    <h4 style="margin: 0; font-size: 16px; font-weight: 700; color: #1f2937;">Customer</h4>
                    <p style="margin: 4px 0 0; font-size: 12px; color: #6b7280;">Personal banking account</p>
                </div>
            </div>
            <p style="margin: 0; font-size: 13px; color: #6b7280;">Create personal banking accounts for customers with access to banking services.</p>
        </div>
    </div>
</div>

<!-- User Registration Form -->
<div style="background: white; border-radius: 16px; padding: 32px; border: 1px solid #e5e7eb;">
    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px; padding-bottom: 16px; border-bottom: 2px solid #e5e7eb;">
        <span style="font-size: 24px;">📝</span>
        <h3 style="margin: 0; font-size: 20px; font-weight: 700;">@(userType == "Employee" ? "Employee Account Details" : "Customer Account Details")</h3>
    </div>

    <form @onsubmit="HandleRegistration" @onsubmit:preventDefault>
        <!-- Personal Information -->
        <div style="margin-bottom: 32px;">
            <h4 style="font-size: 15px; font-weight: 700; color: #1f2937; margin-bottom: 16px;">Personal Information</h4>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                <div>
                    <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Full Name *</label>
                    <input type="text" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" @bind="fullName" placeholder="Enter full name" />
                    @if (showError && string.IsNullOrEmpty(fullName)) { <span style="color: #dc2626; font-size: 12px;">Required</span> }
                </div>
                <div>
                    <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Email *</label>
                    <input type="email" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" @bind="email" placeholder="Enter email" />
                    @if (showError && string.IsNullOrEmpty(email)) { <span style="color: #dc2626; font-size: 12px;">Required</span> }
                </div>
                <div>
                    <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Contact *</label>
                    <input type="tel" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" @bind="contactNumber" placeholder="Enter contact" />
                    @if (showError && string.IsNullOrEmpty(contactNumber)) { <span style="color: #dc2626; font-size: 12px;">Required</span> }
                </div>
                <div>
                    <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Address *</label>
                    <input type="text" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" @bind="address" placeholder="Enter address" />
                    @if (showError && string.IsNullOrEmpty(address)) { <span style="color: #dc2626; font-size: 12px;">Required</span> }
                </div>
                <div>
                    <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Date of Birth</label>
                    <input type="date" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" @onchange="@((ChangeEventArgs e) => dateOfBirthString = e.Value?.ToString() ?? "")" value="@dateOfBirthString" />
                </div>
                <div>
                    <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Gender</label>
                    <select style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" @bind="gender">
                        <option value="">Select...</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- ID Upload -->
        <div style="margin-bottom: 32px;">
            <h4 style="font-size: 15px; font-weight: 700; color: #1f2937; margin-bottom: 16px;">Valid ID Upload</h4>
            <div style="background: #f9fafb; border: 2px dashed #e5e7eb; border-radius: 12px; padding: 32px; text-align: center;">
                <p style="margin: 0 0 16px; font-size: 14px; font-weight: 600; color: #1f2937;">Upload Valid ID</p>
                <InputFile OnChange="HandleIDUpload" accept="image/*,.pdf" style="display: none;" id="idUploadInput" />
                <label for="idUploadInput" style="background: linear-gradient(135deg, #2563eb, #1e40af); color: white; padding: 12px 24px; border-radius: 8px; font-weight: 600; cursor: pointer; display: inline-block;">
                    Choose File
                </label>
                @if (!string.IsNullOrEmpty(uploadedIdFileName))
                {
                    <div style="margin-top: 16px; padding: 12px; background: #d1fae5; border-radius: 8px; color: #065f46; font-size: 13px;">
                        ✓ @uploadedIdFileName
                    </div>
                }
            </div>
        </div>

        <!-- Credentials -->
        <div style="margin-bottom: 32px;">
            <h4 style="font-size: 15px; font-weight: 700; color: #1f2937; margin-bottom: 16px;">Account Credentials</h4>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                <div>
                    <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Username *</label>
                    <input type="text" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" @bind="username" placeholder="Username" />
                    @if (showError && string.IsNullOrEmpty(username)) { <span style="color: #dc2626; font-size: 12px;">Required</span> }
                </div>
                <div>
                    <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Password *</label>
                    <input type="@(showPassword ? "text" : "password")" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" @bind="initialPassword" placeholder="Minimum 12 characters" />
                    @if (showError && string.IsNullOrEmpty(initialPassword))
                    {
                        <span style="color: #dc2626; font-size: 12px;">Password is required</span>
                    }
                    @if (!string.IsNullOrEmpty(passwordError))
                    {
                        <span style="color: #dc2626; font-size: 12px; display: block; margin-top: 4px;">@passwordError</span>
                    }
                    <label style="font-size: 12px; margin-top: 8px; display: flex; align-items: center; gap: 4px; cursor: pointer;">
                        <input type="checkbox" @onchange="() => showPassword = !showPassword" />
                        Show Password
                    </label>
                    <div style="margin-top: 8px; padding: 10px; background: #f0f9ff; border-radius: 6px; border: 1px solid #bfdbfe;">
                        <p style="font-size: 11px; color: #1e40af; margin: 0 0 4px; font-weight: 600;">Password Requirements:</p>
                        <ul style="font-size: 11px; color: #1e40af; margin: 0; padding-left: 20px;">
                            <li>Minimum 12 characters</li>
                            <li>At least 1 uppercase letter (A-Z)</li>
                            <li>At least 1 lowercase letter (a-z)</li>
                            <li>At least 1 number (0-9)</li>
                            <li>At least 1 special character (!@@#$%^&*)</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Role & Department -->
        @if (userType == "Employee")
        {
            <div style="margin-bottom: 32px;">
                <h4 style="font-size: 15px; font-weight: 700; color: #1f2937; margin-bottom: 16px;">Role & Department</h4>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                    <div>
                        <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Role *</label>
                        <select style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" @bind="selectedRole">
                            <option value="">Select role...</option>
                            <option value="SuperAdmin">Super Administrator</option>
                            <option value="Accountant">Accountant</option>
                            <option value="FinanceManager">Finance Manager</option>
                            <option value="Teller">Teller</option>
                            <option value="Registrar">Registrar</option>
                        </select>
                        @if (showError && string.IsNullOrEmpty(selectedRole)) { <span style="color: #dc2626; font-size: 12px;">Required</span> }
                    </div>
                    <div>
                        <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Department *</label>
                        <select style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" @bind="department">
                            <option value="">Select department...</option>
                            <option value="Finance">Finance</option>
                            <option value="Accounting">Accounting</option>
                            <option value="Loans">Loans</option>
                            <option value="Operations">Operations</option>
                            <option value="Customer Service">Customer Service</option>
                            <option value="Registration">Registration</option>
                            <option value="IT">IT</option>
                            <option value="HR">HR</option>
                            <option value="Audit">Audit</option>
                            <option value="Management">Management</option>
                        </select>
                        @if (showError && string.IsNullOrEmpty(department)) { <span style="color: #dc2626; font-size: 12px;">Required</span> }
                    </div>
                    <div>
                        <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Employee ID (Optional - Auto-generated)</label>
                        <input type="number" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px; background: #f9fafb;" @bind="employeeId" placeholder="Leave blank for auto-generation" />
                        <p style="font-size: 12px; color: #6b7280; margin-top: 4px;">If left blank, will be auto-generated with next available ID</p>
                    </div>
                    <div>
                        <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Branch/Location</label>
                        <input type="text" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px;" @bind="branchLocation" placeholder="Branch" />
                    </div>
                </div>
            </div>
        }

        <!-- Messages -->
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div style="padding: 16px; background: #fee2e2; border-radius: 8px; color: #991b1b; margin-bottom: 20px;">
                <strong>Error:</strong> @errorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div style="padding: 16px; background: #d1fae5; border-radius: 8px; color: #065f46; margin-bottom: 20px;">
                <strong>Success:</strong> @successMessage
            </div>
        }

        <!-- Buttons -->
        <div style="display: flex; gap: 12px; justify-content: flex-end; padding-top: 20px; border-top: 2px solid #e5e7eb;">
            <button type="button" style="background: #f3f4f6; color: #374151; padding: 12px 24px; border-radius: 8px; border: none; font-weight: 600; cursor: pointer;" @onclick="ClearForm">
                Reset
            </button>
            <button type="submit" style="background: linear-gradient(135deg, #2563eb, #1e40af); color: white; padding: 12px 32px; border-radius: 8px; border: none; font-weight: 600; cursor: pointer;" disabled="@isLoading">
                @if (isLoading) { <span>Creating...</span> } else { <span>Create Account</span> }
            </button>
        </div>
    </form>
</div>

@using FinanceBank.Data
@using FinanceBank.Models
@using Microsoft.EntityFrameworkCore
@inject PasswordHashingService PasswordHasher

@code {
    private Toast? toastComponent;
    
    private string userType = "Employee";
    private string fullName = "";
    private string email = "";
    private string contactNumber = "";
    private string address = "";
    private string dateOfBirthString = "";
    private string gender = "";
    private string uploadedIdFileName = "";
    private string username = "";
    private string initialPassword = "";
    private bool showPassword = false;
    private string selectedRole = "";
    private string department = "";
    private int? employeeId = null;
    private string branchLocation = "";
    private List<string> selectedPermissions = new();
    private List<string> availablePermissions = new() { "Dashboard", "Transactions", "Accounts", "Users", "Reports", "Settings", "Accounting", "HR/Payroll", "CRM", "Loans", "Cards", "Bills", "Security", "Audit" };
    private bool showError = false;
    private bool isLoading = false;
    private string errorMessage = "";
    private string successMessage = "";
    private string passwordError = "";
    private List<PendingUser> pendingUsers = new();

    private void SelectUserType(string type)
    {
        userType = type;
        selectedRole = "";
        department = "";
        employeeId = null;
        branchLocation = "";
        selectedPermissions.Clear();
        errorMessage = "";
        successMessage = "";
    }

    private void TogglePermission(string permission)
    {
        if (selectedPermissions.Contains(permission))
            selectedPermissions.Remove(permission);
        else
            selectedPermissions.Add(permission);
    }

    private async Task HandleRegistration()
    {
        showError = true;
        errorMessage = "";
        successMessage = "";
        passwordError = "";

        // Validate required fields
        if (string.IsNullOrEmpty(fullName) || string.IsNullOrEmpty(email) || string.IsNullOrEmpty(contactNumber) || string.IsNullOrEmpty(address) || string.IsNullOrEmpty(username) || string.IsNullOrEmpty(initialPassword))
        {
            errorMessage = "Please fill in all required fields";
            return;
        }

        // Validate password strength
        var (isValid, validationError) = PasswordHasher.ValidatePasswordStrength(initialPassword);
        if (!isValid)
        {
            passwordError = validationError;
            errorMessage = "Password does not meet security requirements";
            return;
        }

        if (userType == "Employee" && (string.IsNullOrEmpty(selectedRole) || string.IsNullOrEmpty(department)))
        {
            errorMessage = "Please select a role and department for the employee";
            return;
        }

        isLoading = true;

        try
        {
            // Hash the password before sending to service
            var hashedPassword = PasswordHasher.HashPassword(initialPassword);
            
            // Call backend service to create user with hashed password
            var (success, message, accountNumber) = await RegistrationService.CreateUserAsync(
                username: username,
                password: hashedPassword,
                fullName: fullName,
                email: email,
                phoneNumber: contactNumber,
                role: userType == "Employee" ? selectedRole : AuthService.Roles.Customer,
                department: userType == "Employee" ? department : null,
                employeeId: userType == "Employee" ? employeeId : null,
                isActive: true  // Always activate immediately since admin is creating it
            );

            if (!success)
            {
                errorMessage = message;
                isLoading = false;
                return;
            }

            // Show success message
            successMessage = $"✓ Account created successfully!\n\nAccount Number: {accountNumber}\nUsername: {username}\nRole: {(userType == "Employee" ? selectedRole : "Customer")}\n{(userType == "Employee" ? $"Employee ID: {(employeeId.HasValue ? employeeId.Value : "Auto-generated")}\nDepartment: {department}" : "")}\n\nPassword has been securely hashed. User can log in immediately.";
            
            // Clear form after brief delay
            await Task.Delay(2000);
            ClearForm();
            isLoading = false;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            isLoading = false;
        }
    }

    private string GenerateAccountNumber()
    {
        // Format: ACC-YYYY-XXXXX (e.g., ACC-2025-00001)
        var year = DateTime.Now.Year;
        var randomPart = new Random().Next(1, 99999).ToString("D5");
        return $"ACC-{year}-{randomPart}";
    }

    private void ClearForm()
    {
        fullName = "";
        email = "";
        contactNumber = "";
        address = "";
        dateOfBirthString = "";
        gender = "";
        uploadedIdFileName = "";
        username = "";
        initialPassword = "";
        selectedRole = "";
        department = "";
        employeeId = null;
        branchLocation = "";
        selectedPermissions.Clear();
        showError = false;
        errorMessage = "";
        passwordError = "";
    }

    private async Task HandleIDUpload(InputFileChangeEventArgs e)
    {
        try
        {
            errorMessage = "";
            
            if (e.FileCount == 0)
            {
                return;
            }

            var file = e.GetMultipleFiles(1).FirstOrDefault();
            
            if (file == null)
            {
                return;
            }

            // Validate file size (5MB max)
            const long maxFileSize = 5 * 1024 * 1024;
            if (file.Size > maxFileSize)
            {
                errorMessage = "File size must not exceed 5MB";
                StateHasChanged();
                return;
            }

            // Validate file extension
            var allowedExtensions = new[] { ".jpg", ".jpeg", ".png", ".pdf" };
            var fileName = file.Name.ToLower();
            var hasValidExtension = allowedExtensions.Any(ext => fileName.EndsWith(ext));
            
            if (!hasValidExtension)
            {
                errorMessage = "Only JPG, PNG, and PDF files are allowed";
                StateHasChanged();
                return;
            }

            // File is valid - store the filename only (don't read the stream)
            uploadedIdFileName = file.Name;
            errorMessage = "";
            
            // Show success toast
            if (toastComponent != null)
            {
                await toastComponent.Show("ID Upload Successful", $"File: {file.Name}\nSize: {FormatFileSize(file.Size)}", 3000);
            }
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error uploading file: {ex.Message}";
            StateHasChanged();
        }
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    private class PendingUser
    {
        public string FullName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Role { get; set; } = "";
        public string Department { get; set; } = "";
        public DateTime RequestDate { get; set; }
    }
}
