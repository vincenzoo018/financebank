    private async Task PickProfilePicture()
    {
        try
        {
            errorMessage = "";
            
            var customFileType = new FilePickerFileType(
                new Dictionary<DevicePlatform, IEnumerable<string>>
                {
                    { DevicePlatform.WinUI, new[] { ".jpg", ".jpeg", ".png", ".gif" } },
                    { DevicePlatform.Android, new[] { "image/jpeg", "image/png", "image/gif" } },
                    { DevicePlatform.iOS, new[] { "public.jpeg", "public.png", "com.compuserve.gif" } },
                    { DevicePlatform.MacCatalyst, new[] { "public.jpeg", "public.png", "com.compuserve.gif" } }
                });

            var options = new PickOptions
            {
                PickerTitle = "Select Profile Picture",
                FileTypes = customFileType
            };

            var result = await FilePicker.Default.PickAsync(options);
            
            if (result == null)
            {
                return; // User cancelled
            }

            // Validate file size (2MB max for profile pictures)
            using var stream = await result.OpenReadAsync();
            if (stream.Length > 2 * 1024 * 1024)
            {
                errorMessage = "Profile picture size must not exceed 2MB";
                await InvokeAsync(StateHasChanged);
                return;
            }

            // Read file into byte array
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            profilePictureData = memoryStream.ToArray();
            profilePictureFileName = result.FileName;
            profilePictureContentType = result.ContentType ?? "image/jpeg";
            
            // Create preview
            var base64 = Convert.ToBase64String(profilePictureData);
            profilePicturePreview = $"data:{profilePictureContentType};base64,{base64}";
            
            errorMessage = "";
            
            // Show success toast
            if (toastComponent != null)
            {
                await toastComponent.Show("Profile Picture Uploaded", $"File: {result.FileName}", 3000);
            }
            
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error uploading profile picture: {ex.Message}";
            profilePictureData = null;
            profilePictureFileName = null;
            profilePictureContentType = null;
            profilePicturePreview = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ClearProfilePicture()
    {
        profilePictureData = null;
        profilePictureFileName = null;
        profilePictureContentType = null;
        profilePicturePreview = null;
        StateHasChanged();
    }

