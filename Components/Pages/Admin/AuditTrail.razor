                    Cancel
                </button>
                <button style="padding: 10px 20px; background: #dc2626; color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer;"
                        @onclick="ConfirmDeactivateAccount">
                    ⛔ Deactivate Account
