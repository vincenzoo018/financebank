}

@code {
    private List<AuditLog> allLogs = new();
    private List<AuditLog> maliciousAttempts = new();
    private List<AuditLog> securityLogs = new();
    private List<LockedAccountInfo> lockedAccounts = new();
    private List<LockedAccountInfo> fullyLockedAccounts = new();
    private string selectedModule = "";
    private string selectedAction = "";
    private DateTime dateFrom = DateTime.Today.AddMonths(-1);
    private DateTime dateTo = DateTime.Today;
    private int todayCount = 0;
    private int weekCount = 0;
    private int uniqueUsers = 0;
    private int maliciousCount = 0;
    private int lockedAccountsCount = 0;
    private int fullyLockedCount = 0;
    private string activeTab = "fullylocked";
    private string successMessage = "";
    private string errorMessage = "";

    // Modal states
    private bool showUnlockModal = false;
    private bool showResetPasswordModal = false;
    private bool showDeactivateModal = false;
    private LockedAccountInfo? selectedAccountForAction;
    private string newPassword = "";
    private string confirmPassword = "";
    private bool unlockAfterReset = true;
    private string deactivationReason = "";

    // View model for locked accounts
    private class LockedAccountInfo
    {
        public int UserId { get; set; }
        public string Username { get; set; } = "";
        public string? FullName { get; set; }
        public int FailedAttempts { get; set; }
        public DateTime? LastAttempt { get; set; }
        public DateTime? LockoutEnd { get; set; }
        public string? LockReason { get; set; }
        public bool IsFullyLocked { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAllData();
    }

    private async Task LoadAllData()
    {
        await LoadAuditLogs();
        await LoadMaliciousAttempts();
        await LoadSecurityLogs();
        await LoadLockedAccounts();
        await LoadFullyLockedAccounts();
    }

    private async Task LoadAuditLogs()
    {
        try
        {
            allLogs = await AuditLogService.GetAllAsync();
            CalculateStats();
        }
        catch (Exception ex)
        {
            allLogs = new List<AuditLog>();
        }
    }

    private async Task LoadMaliciousAttempts()
    {
        try
        {
            maliciousAttempts = await AuditLogService.GetMaliciousAttemptsAsync();
            maliciousCount = await AuditLogService.GetRecentMaliciousAttemptsCountAsync();
        }
        catch
        {
            maliciousAttempts = new List<AuditLog>();
            maliciousCount = 0;
        }
    }

    private async Task LoadSecurityLogs()
    {
        try
        {
            securityLogs = await AuditLogService.GetSecurityLogsAsync();
        }
        catch
        {
            securityLogs = new List<AuditLog>();
        }
    }

    private async Task LoadFullyLockedAccounts()
    {
        try
        {
            using var context = await DbContextFactory.CreateDbContextAsync();
            
            // Get fully locked accounts (failed PIN verification - requires admin intervention)
            var fullyLockedLogs = await context.AuditLogs
                .Where(a => a.Action == "ACCOUNT_FULLY_LOCKED" || 
                           (a.IsAccountLocked && a.LockReason != null && a.LockReason.Contains("PIN")))
                .Where(a => a.CreatedAt >= DateTime.Now.AddDays(-7))
                .OrderByDescending(a => a.CreatedAt)
                .ToListAsync();

            var fullyLockedInfoList = new List<LockedAccountInfo>();
            var processedUserIds = new HashSet<int>();

            foreach (var lockEvent in fullyLockedLogs)
            {
                int? userId = lockEvent.CustomerAccountId;
                
                // Fallback to parsing from Description if CustomerAccountId is null
                if (userId == null)
                {
                    var userIdMatch = System.Text.RegularExpressions.Regex.Match(lockEvent.Description ?? "", @"UserId:(\d+)");
                    if (userIdMatch.Success)
                        userId = int.Parse(userIdMatch.Groups[1].Value);
                }

                if (userId == null || processedUserIds.Contains(userId.Value)) continue;

                // Check if there's a subsequent unlock
                var wasUnlocked = await context.AuditLogs
                    .AnyAsync(a => a.Action == "ACCOUNT_UNLOCKED" &&
                                  (a.CustomerAccountId == userId || 
                                   (a.Description != null && a.Description.Contains($"UserId:{userId}"))) &&
                                  a.CreatedAt > lockEvent.CreatedAt);

                if (!wasUnlocked)
                {
                    var user = await context.Users.FindAsync(userId.Value);
                    if (user != null && user.Role == "Customer")
                    {
                        fullyLockedInfoList.Add(new LockedAccountInfo
                        {
                            UserId = user.UserId,
                            Username = user.Username,
                            FullName = user.FullName,
                            FailedAttempts = lockEvent.FailedAttemptCount ?? 5,
                            LastAttempt = lockEvent.CreatedAt,
                            LockoutEnd = null, // Indefinite until admin unlocks
                            LockReason = lockEvent.LockReason ?? "Failed PIN verification attempts",
                            IsFullyLocked = true
                        });

                        processedUserIds.Add(userId.Value);
                    }
                }
            }

            fullyLockedAccounts = fullyLockedInfoList.OrderByDescending(a => a.LastAttempt).ToList();
            fullyLockedCount = fullyLockedAccounts.Count;
        }
        catch
        {
            fullyLockedAccounts = new List<LockedAccountInfo>();
            fullyLockedCount = 0;
        }
    }

    private async Task LoadLockedAccounts()
    {
        try
        {
            using var context = await DbContextFactory.CreateDbContextAsync();
            
            // Get locked accounts from AuditLogs where Action = "MALICIOUS_ATTEMPT"
            // and no subsequent unlock happened within 24 hours
            var maliciousLocks = await context.AuditLogs
                .Where(a => a.Action == "MALICIOUS_ATTEMPT" && a.Description != null && a.Description.Contains("[LOCKED]"))
                .Where(a => a.CreatedAt >= DateTime.Now.AddHours(-24))
                .OrderByDescending(a => a.CreatedAt)
                .ToListAsync();

            // Extract UserId from Description and get unique locked accounts
            var lockedUserIds = new HashSet<int>();
            var lockedInfoList = new List<LockedAccountInfo>();

            foreach (var lockEvent in maliciousLocks)
            {
                // Extract UserId from Description (format: "[LOCKED] UserId:123 ...")
                var userIdMatch = System.Text.RegularExpressions.Regex.Match(lockEvent.Description ?? "", @"UserId:(\d+)");
                if (!userIdMatch.Success) continue;
                
                var userId = int.Parse(userIdMatch.Groups[1].Value);
                if (lockedUserIds.Contains(userId)) continue;

                // Check if there's a subsequent unlock
                var wasUnlocked = await context.AuditLogs
                    .AnyAsync(a => a.Action == "ACCOUNT_UNLOCKED" &&
                                  a.Description != null &&
                                  a.Description.Contains($"UserId:{userId}") &&
                                  a.CreatedAt > lockEvent.CreatedAt);

                if (!wasUnlocked)
                {
                    var user = await context.Users.FindAsync(userId);
                    if (user != null && user.Role == "Customer")
                    {
                        // Count failed attempts for this user in the last hour
                        var failedAttempts = await context.AuditLogs
                            .CountAsync(a => a.UserId == user.UserId.ToString() &&
                                           a.Action == "LOGIN_FAILED" &&
                                           a.CreatedAt >= DateTime.Now.AddHours(-1));

                        lockedInfoList.Add(new LockedAccountInfo
                        {
                            UserId = user.UserId,
                            Username = user.Username,
                            FullName = user.FullName,
                            FailedAttempts = failedAttempts > 0 ? failedAttempts : 5,
                            LastAttempt = lockEvent.CreatedAt,
                            LockoutEnd = lockEvent.CreatedAt.AddHours(24)
                        });

                        lockedUserIds.Add(userId);
                    }
                }
            }

            lockedAccounts = lockedInfoList.OrderByDescending(a => a.LastAttempt).ToList();
            lockedAccountsCount = lockedAccounts.Count;
        }
        catch
        {
            lockedAccounts = new List<LockedAccountInfo>();
            lockedAccountsCount = 0;
        }
    }

    private void CalculateStats()
    {
        var today = DateTime.Today;
        var weekAgo = today.AddDays(-7);

        todayCount = allLogs.Count(l => l.CreatedAt.Date == today);
        weekCount = allLogs.Count(l => l.CreatedAt.Date >= weekAgo && l.CreatedAt.Date <= today);
        uniqueUsers = allLogs.Select(l => l.UserId).Distinct().Count();
    }

    private IEnumerable<AuditLog> filteredLogs => allLogs
        .Where(l => string.IsNullOrEmpty(selectedModule) || l.Module == selectedModule)
        .Where(l => string.IsNullOrEmpty(selectedAction) || l.Action.Contains(selectedAction, StringComparison.OrdinalIgnoreCase))
        .Where(l => l.CreatedAt.Date >= dateFrom && l.CreatedAt.Date <= dateTo);

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
    }

    private async Task ApplyFilters()
    {
        await Task.CompletedTask;
    }

    private async Task UnlockAccount(int userId)
    {
        try
        {
            using var context = await DbContextFactory.CreateDbContextAsync();
            var user = await context.Users.FindAsync(userId);
            
            if (user != null)
            {
                // Log the unlock action to AuditLogs
                var auditLog = new AuditLog
                {
                    UserId = AuthService.CurrentUserId?.ToString() ?? "SuperAdmin",
                    Action = "ACCOUNT_UNLOCKED",
                    Module = "Security",
                    Description = $"UserId:{userId} Admin '{AuthService.CurrentUser}' unlocked account for user '{user.Username}'",
                    CreatedAt = DateTime.Now
                };
                context.AuditLogs.Add(auditLog);
                await context.SaveChangesAsync();

                successMessage = $"Account for '{user.Username}' has been unlocked successfully.";
                await LoadAllData();
                StateHasChanged();

                await Task.Delay(3000);
                successMessage = "";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error unlocking account: {ex.Message}";
            StateHasChanged();

            await Task.Delay(3000);
            errorMessage = "";
            StateHasChanged();
        }
    }

    private async Task DeactivateAccount(int userId)
    {
        try
        {
            using var context = await DbContextFactory.CreateDbContextAsync();
            var user = await context.Users.FindAsync(userId);
            
            if (user != null)
            {
                user.IsActive = false;
                await context.SaveChangesAsync();

                // Log the deactivation
                var auditLog = new AuditLog
                {
                    UserId = AuthService.CurrentUserId?.ToString() ?? "SuperAdmin",
                    Action = "ACCOUNT_DEACTIVATED",
                    Module = "Security",
                    Description = $"UserId:{userId} Admin '{AuthService.CurrentUser}' deactivated account for user '{user.Username}'",
                    CreatedAt = DateTime.Now
                };
                context.AuditLogs.Add(auditLog);
                await context.SaveChangesAsync();

                successMessage = $"Account for '{user.Username}' has been deactivated.";
                await LoadAllData();
                StateHasChanged();

                await Task.Delay(3000);
                successMessage = "";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deactivating account: {ex.Message}";
            StateHasChanged();

            await Task.Delay(3000);
            errorMessage = "";
            StateHasChanged();
        }
    }

    private string GetActionBackground(string action)
    {
        return action switch
        {
            "LOGIN_SUCCESS" => "#d1fae5",
            "LOGIN_FAILED" => "#fef2f2",
            "LOGOUT" => "#dbeafe",
            "MALICIOUS_ATTEMPT" => "#fef2f2",
            "ACCOUNT_LOCKED" => "#fef3c7",
            "ACCOUNT_UNLOCKED" => "#d1fae5",
            "PASSWORD_RESET" => "#dbeafe",
            "ACCOUNT_FULLY_LOCKED" => "#fee2e2",
            _ => "#f3f4f6"
        };
    }

    private string GetActionColor(string action)
    {
        return action switch
        {
            "LOGIN_SUCCESS" => "#065f46",
            "LOGIN_FAILED" => "#991b1b",
            "LOGOUT" => "#1e40af",
            "MALICIOUS_ATTEMPT" => "#991b1b",
            "ACCOUNT_LOCKED" => "#92400e",
            "ACCOUNT_UNLOCKED" => "#065f46",
            "PASSWORD_RESET" => "#1e40af",
            "ACCOUNT_FULLY_LOCKED" => "#7f1d1d",
            _ => "#374151"
        };
    }

    // Modal Methods
    private void ShowUnlockModal(LockedAccountInfo account)
    {
        selectedAccountForAction = account;
        showUnlockModal = true;
    }

    private void ShowResetPasswordModal(LockedAccountInfo account)
    {
        selectedAccountForAction = account;
        newPassword = "";
        confirmPassword = "";
        unlockAfterReset = true;
        showResetPasswordModal = true;
    }

    private void DeactivateAccountConfirm(int userId)
    {
        var account = fullyLockedAccounts.FirstOrDefault(a => a.UserId == userId) 
                     ?? lockedAccounts.FirstOrDefault(a => a.UserId == userId);
        if (account != null)
        {
            selectedAccountForAction = account;
            deactivationReason = "";
            showDeactivateModal = true;
        }
    }

    private void CloseModals()
    {
        showUnlockModal = false;
        showResetPasswordModal = false;
        showDeactivateModal = false;
        selectedAccountForAction = null;
        newPassword = "";
        confirmPassword = "";
        deactivationReason = "";
    }

    private async Task ConfirmUnlockAccount()
    {
        if (selectedAccountForAction == null) return;

        try
        {
            var adminUsername = AuthService.CurrentUser ?? "SuperAdmin";
            var result = await AuthService.AdminUnlockAccountAsync(
                selectedAccountForAction.UserId, 
                adminUsername);
            if (result.success)
            {
                successMessage = result.message;
                CloseModals();
                await LoadAllData();
                StateHasChanged();

                await Task.Delay(3000);
                successMessage = "";
                StateHasChanged();
            }
            else
            {
                errorMessage = result.message;
                StateHasChanged();

                await Task.Delay(3000);
                errorMessage = "";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error unlocking account: {ex.Message}";
            StateHasChanged();

            await Task.Delay(3000);
            errorMessage = "";
            StateHasChanged();
        }
    }

    private async Task ConfirmResetPassword()
    {
        if (selectedAccountForAction == null) return;

        if (string.IsNullOrEmpty(newPassword) || newPassword.Length < 6)
        {
            errorMessage = "Password must be at least 6 characters long.";
            StateHasChanged();
            await Task.Delay(3000);
            errorMessage = "";
            StateHasChanged();
            return;
        }

        if (newPassword != confirmPassword)
        {
            errorMessage = "Passwords do not match.";
            StateHasChanged();
            await Task.Delay(3000);
            errorMessage = "";
            StateHasChanged();
            return;
        }

        try
        {
            var adminUsername = AuthService.CurrentUser ?? "SuperAdmin";
            var result = await AuthService.AdminUnlockAccountAsync(
                selectedAccountForAction.UserId, 
                adminUsername, 
                newPassword);
                
            if (result.success)
            {
                successMessage = result.message;
                CloseModals();
                await LoadAllData();
                StateHasChanged();

                await Task.Delay(3000);
                successMessage = "";
                StateHasChanged();
            }
            else
            {
                errorMessage = result.message;
                StateHasChanged();

                await Task.Delay(3000);
                errorMessage = "";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error resetting password: {ex.Message}";
            StateHasChanged();

            await Task.Delay(3000);
            errorMessage = "";
            StateHasChanged();
        }
    }

    private async Task ConfirmDeactivateAccount()
    {
        if (selectedAccountForAction == null) return;

        try
        {
            var adminUsername = AuthService.CurrentUser ?? "SuperAdmin";
            var result = await AuthService.AdminDeactivateAccountAsync(
                selectedAccountForAction.UserId,
                adminUsername,
                string.IsNullOrEmpty(deactivationReason) ? "Deactivated by administrator" : deactivationReason);
                
            if (result.success)
            {
                successMessage = result.message;
                CloseModals();
                await LoadAllData();
                StateHasChanged();

                await Task.Delay(3000);
                successMessage = "";
                StateHasChanged();
            }
            else
            {
                errorMessage = result.message;
                StateHasChanged();

                await Task.Delay(3000);
                errorMessage = "";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deactivating account: {ex.Message}";
            StateHasChanged();

            await Task.Delay(3000);
            errorMessage = "";
            StateHasChanged();
        }
    }
}