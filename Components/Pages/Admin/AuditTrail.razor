@page "/admin/audit-trail"
@page "/admin/system/audit-logs"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@using FinanceBank.Data
@using Microsoft.EntityFrameworkCore
@inject AuthService AuthService
@inject AuditLogService AuditLogService
@inject IDbContextFactory<BFASDbContext> DbContextFactory

<div class="section-header">
    <h2 class="section-title">🔒 Security & Audit Logs</h2>
    <p style="color: var(--text-secondary); font-size: 14px; margin-top: 8px;">
        Monitor security events, malicious attempts, and manage customer account status
    </p>
</div>

<!-- Security Alert Stats -->
<div style="display: grid; grid-template-columns: repeat(6, 1fr); gap: 16px; margin-bottom: 24px;">
    <div style="background: linear-gradient(135deg, #fee2e2, #fecaca); border-radius: 16px; padding: 20px; border: 2px solid #dc2626;">
        <div style="font-size: 13px; color: #991b1b; margin-bottom: 4px;">⚠️ Malicious Attempts</div>
        <div style="font-size: 32px; font-weight: 800; color: #dc2626;">@maliciousCount</div>
        <div style="font-size: 11px; color: #7f1d1d; margin-top: 4px;">Last 24 hours</div>
    </div>
    <div style="background: linear-gradient(135deg, #fef3c7, #fde68a); border-radius: 16px; padding: 20px; border: 2px solid #f59e0b;">
        <div style="font-size: 13px; color: #92400e; margin-bottom: 4px;">🔐 Locked Accounts</div>
        <div style="font-size: 32px; font-weight: 800; color: #f59e0b;">@lockedAccountsCount</div>
        <div style="font-size: 11px; color: #78350f; margin-top: 4px;">Customers</div>
    </div>
    <div style="background: linear-gradient(135deg, #7f1d1d, #991b1b); border-radius: 16px; padding: 20px; border: 2px solid #450a0a;">
        <div style="font-size: 13px; color: #fecaca; margin-bottom: 4px;">🚨 Fully Locked</div>
        <div style="font-size: 32px; font-weight: 800; color: #fef2f2;">@fullyLockedCount</div>
        <div style="font-size: 11px; color: #fca5a5; margin-top: 4px;">Requires Admin</div>
    </div>
    <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid var(--border);">
        <div style="font-size: 13px; color: var(--text-secondary); margin-bottom: 4px;">Total Activities</div>
        <div style="font-size: 28px; font-weight: 700; color: var(--text);">@allLogs.Count</div>
    </div>
    <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid var(--border);">
        <div style="font-size: 13px; color: var(--text-secondary); margin-bottom: 4px;">Today's Activities</div>
        <div style="font-size: 28px; font-weight: 700; color: #3b82f6;">@todayCount</div>
    </div>
    <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid var(--border);">
        <div style="font-size: 13px; color: var(--text-secondary); margin-bottom: 4px;">Unique Users</div>
        <div style="font-size: 28px; font-weight: 700; color: #10b981;">@uniqueUsers</div>
    </div>
</div>

<!-- Tabs -->
<div style="display: flex; gap: 8px; margin-bottom: 24px; flex-wrap: wrap;">
    <button class="@(activeTab == "fullylocked" ? "btn btn-danger" : "btn btn-outline")" 
            style="@(activeTab == "fullylocked" ? "background: #7f1d1d; color: white;" : "")"
            @onclick='() => SetActiveTab("fullylocked")'>
        🚨 Fully Locked (@fullyLockedCount)
    </button>
    <button class="@(activeTab == "malicious" ? "btn btn-danger" : "btn btn-outline")" 
            style="@(activeTab == "malicious" ? "background: #dc2626; color: white;" : "")"
            @onclick='() => SetActiveTab("malicious")'>
        ⚠️ Malicious Attempts (@maliciousAttempts.Count)
    </button>
    <button class="@(activeTab == "locked" ? "btn btn-warning" : "btn btn-outline")"
            style="@(activeTab == "locked" ? "background: #f59e0b; color: white;" : "")"
            @onclick='() => SetActiveTab("locked")'>
        🔐 Locked Accounts (@lockedAccounts.Count)
    </button>
    <button class="@(activeTab == "security" ? "btn btn-primary" : "btn btn-outline")"
            style="@(activeTab == "security" ? "background: #3b82f6; color: white;" : "")"
            @onclick='() => SetActiveTab("security")'>
        🛡️ Security Logs
    </button>
    <button class="@(activeTab == "all" ? "btn btn-primary" : "btn btn-outline")"
            style="@(activeTab == "all" ? "background: #059669; color: white;" : "")"
            @onclick='() => SetActiveTab("all")'>
        📋 All Audit Logs
    </button>
</div>

@if (activeTab == "fullylocked")
{
    <!-- Fully Locked Accounts (Requires SuperAdmin Intervention) -->
    <div style="background: white; border-radius: 16px; padding: 24px; border: 2px solid #7f1d1d; margin-bottom: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h3 style="font-size: 18px; font-weight: 700; margin: 0; color: #7f1d1d;">🚨 Fully Locked Accounts - Requires Admin Intervention</h3>
            <span style="font-size: 12px; color: #6b7280;">Accounts locked after failed PIN verification attempts</span>
        </div>

        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="border-bottom: 2px solid #fecaca; background: #fef2f2;">
                    <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #7f1d1d;">USER ID</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #7f1d1d;">USERNAME</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #7f1d1d;">FULL NAME</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #7f1d1d;">LOCK REASON</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #7f1d1d;">LOCKED AT</th>
                    <th style="padding: 12px; text-align: center; font-size: 12px; font-weight: 700; color: #7f1d1d;">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @if (fullyLockedAccounts.Any())
                {
                    @foreach (var item in fullyLockedAccounts)
                    {
                        <tr style="border-bottom: 1px solid #fecaca; background: #fef2f2;">
                            <td style="padding: 16px; font-weight: 600;">@item.UserId</td>
                            <td style="padding: 16px;">
                                <div style="font-weight: 600; color: #7f1d1d;">@item.Username</div>
                            </td>
                            <td style="padding: 16px;">@(item.FullName ?? "N/A")</td>
                            <td style="padding: 16px;">
                                <span style="padding: 4px 12px; background: #fee2e2; color: #991b1b; border-radius: 8px; font-size: 12px; font-weight: 600;">
                                    @(item.LockReason ?? "PIN verification failed")
                                </span>
                            </td>
                            <td style="padding: 16px; font-size: 12px;">@(item.LastAttempt?.ToString("MMM dd, HH:mm") ?? "N/A")</td>
                            <td style="padding: 16px; text-align: center;">
                                <div style="display: flex; gap: 8px; justify-content: center; flex-wrap: wrap;">
                                    <button class="btn btn-sm" 
                                            style="background: #059669; color: white; padding: 6px 12px; font-size: 11px;"
                                            @onclick="() => ShowUnlockModal(item)">
                                        🔓 Unlock
                                    </button>
                                    <button class="btn btn-sm" 
                                            style="background: #3b82f6; color: white; padding: 6px 12px; font-size: 11px;"
                                            @onclick="() => ShowResetPasswordModal(item)">
                                        🔑 Reset Password
                                    </button>
                                    <button class="btn btn-sm" 
                                            style="background: #dc2626; color: white; padding: 6px 12px; font-size: 11px;"
                                            @onclick="() => DeactivateAccountConfirm(item.UserId)">
                                        ⛔ Deactivate
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="padding: 32px; text-align: center; color: #059669; font-size: 14px;">
                            ✅ No fully locked accounts. All customer accounts are accessible.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
{
    <!-- Malicious Attempts Table -->
    <div style="background: white; border-radius: 16px; padding: 24px; border: 2px solid #dc2626; margin-bottom: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h3 style="font-size: 18px; font-weight: 700; margin: 0; color: #dc2626;">🚨 Malicious Login Attempts</h3>
            <span style="font-size: 12px; color: #6b7280;">Accounts flagged after 5+ failed login attempts</span>
        </div>

        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="border-bottom: 2px solid #fecaca; background: #fef2f2;">
                    <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #991b1b;">TIMESTAMP</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #991b1b;">USER</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #991b1b;">DESCRIPTION</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #991b1b;">IP ADDRESS</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #991b1b;">STATUS</th>
                    <th style="padding: 12px; text-align: center; font-size: 12px; font-weight: 700; color: #991b1b;">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @if (maliciousAttempts.Any())
                {
                    @foreach (var log in maliciousAttempts.OrderByDescending(l => l.CreatedAt).Take(50))
                    {
                        var userIdMatch = System.Text.RegularExpressions.Regex.Match(log.Description ?? "", @"UserId:(\d+)");
                        var extractedUserId = userIdMatch.Success ? int.Parse(userIdMatch.Groups[1].Value) : (int?)null;
                        var isLocked = log.Description?.Contains("[LOCKED]") ?? false;
                        <tr style="border-bottom: 1px solid #fecaca;">
                            <td style="padding: 16px;">
                                <div style="font-weight: 600;">@log.CreatedAt.ToString("HH:mm:ss")</div>
                                <div style="font-size: 11px; color: #991b1b;">@log.CreatedAt.ToString("MMM dd, yyyy")</div>
                            </td>
                            <td style="padding: 16px;">
                                <div style="font-weight: 600; color: #dc2626;">@log.UserId</div>
                                <div style="font-size: 11px; color: #6b7280;">Customer ID: @(extractedUserId?.ToString() ?? "N/A")</div>
                            </td>
                            <td style="padding: 16px; max-width: 300px;">
                                <div style="font-size: 13px;">@log.Description</div>
                            </td>
                            <td style="padding: 16px; font-family: monospace; font-size: 12px;">@(log.IpAddress ?? "N/A")</td>
                            <td style="padding: 16px;">
                                <span style="padding: 4px 12px; background: @(isLocked ? "#fef2f2" : "#d1fae5"); color: @(isLocked ? "#dc2626" : "#065f46"); border-radius: 20px; font-size: 11px; font-weight: 600;">
                                    @(isLocked ? "Locked" : "Active")
                                </span>
                            </td>
                            <td style="padding: 16px; text-align: center;">
                                @if (extractedUserId.HasValue)
                                {
                                    <button class="btn btn-sm" 
                                            style="background: #059669; color: white; padding: 6px 12px; font-size: 11px;"
                                            @onclick="() => UnlockAccount(extractedUserId.Value)">
                                        🔓 Unlock
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="padding: 32px; text-align: center; color: #059669; font-size: 14px;">
                            ✅ No malicious attempts detected. All accounts are secure.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (activeTab == "locked")
{
    <!-- Locked Accounts Table -->
    <div style="background: white; border-radius: 16px; padding: 24px; border: 2px solid #f59e0b; margin-bottom: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h3 style="font-size: 18px; font-weight: 700; margin: 0; color: #f59e0b;">🔐 Locked Customer Accounts</h3>
            <span style="font-size: 12px; color: #6b7280;">Accounts locked due to security violations</span>
        </div>

        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="border-bottom: 2px solid #fde68a; background: #fef3c7;">
                    <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #92400e;">USER ID</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #92400e;">USERNAME</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #92400e;">FULL NAME</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #92400e;">FAILED ATTEMPTS</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #92400e;">LAST ATTEMPT</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #92400e;">LOCKOUT UNTIL</th>
                    <th style="padding: 12px; text-align: center; font-size: 12px; font-weight: 700; color: #92400e;">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @if (lockedAccounts.Any())
                {
                    @foreach (var item in lockedAccounts)
                    {
                        <tr style="border-bottom: 1px solid #fde68a;">
                            <td style="padding: 16px; font-weight: 600;">@item.UserId</td>
                            <td style="padding: 16px;">
                                <div style="font-weight: 600; color: #f59e0b;">@item.Username</div>
                            </td>
                            <td style="padding: 16px;">@(item.FullName ?? "N/A")</td>
                            <td style="padding: 16px;">
                                <span style="padding: 4px 12px; background: #fef2f2; color: #dc2626; border-radius: 20px; font-size: 12px; font-weight: 700;">
                                    @item.FailedAttempts attempts
                                </span>
                            </td>
                            <td style="padding: 16px; font-size: 12px;">@(item.LastAttempt?.ToString("MMM dd, HH:mm") ?? "N/A")</td>
                            <td style="padding: 16px; font-size: 12px;">@(item.LockoutEnd?.ToString("MMM dd, HH:mm") ?? "Indefinite")</td>
                            <td style="padding: 16px; text-align: center;">
                                <div style="display: flex; gap: 8px; justify-content: center;">
                                    <button class="btn btn-sm" 
                                            style="background: #059669; color: white; padding: 6px 12px; font-size: 11px;"
                                            @onclick="() => UnlockAccount(item.UserId)">
                                        🔓 Unlock
                                    </button>
                                    <button class="btn btn-sm" 
                                            style="background: #dc2626; color: white; padding: 6px 12px; font-size: 11px;"
                                            @onclick="() => DeactivateAccount(item.UserId)">
                                        ⛔ Deactivate
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" style="padding: 32px; text-align: center; color: #059669; font-size: 14px;">
                            ✅ No locked accounts. All customer accounts are accessible.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (activeTab == "security")
{
    <!-- Security Logs Table -->
    <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid var(--border); margin-bottom: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h3 style="font-size: 18px; font-weight: 700; margin: 0;">🛡️ Security Event Logs</h3>
            <button class="btn" style="background: #10b981; color: white; padding: 8px 16px;">
                📥 Export Report
            </button>
        </div>

        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="border-bottom: 2px solid var(--border); background: #f9fafb;">
                    <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">TIMESTAMP</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">USER</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">ACTION</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">DETAILS</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">IP ADDRESS</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">STATUS</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in securityLogs.OrderByDescending(l => l.CreatedAt).Take(50))
                {
                    var isMaliciousAction = log.Action == "MALICIOUS_ATTEMPT" || log.Action == "LOGIN_FAILED";
                    <tr style="border-bottom: 1px solid var(--border);">
                        <td style="padding: 16px;">
                            <div style="font-weight: 600;">@log.CreatedAt.ToString("HH:mm:ss")</div>
                            <div style="font-size: 11px; color: var(--text-secondary);">@log.CreatedAt.ToString("MMM dd, yyyy")</div>
                        </td>
                        <td style="padding: 16px; font-weight: 600;">@log.UserId</td>
                        <td style="padding: 16px;">
                            <span style="padding: 4px 12px; background: @GetActionBackground(log.Action); color: @GetActionColor(log.Action); border-radius: 20px; font-size: 11px; font-weight: 600;">
                                @log.Action
                            </span>
                        </td>
                        <td style="padding: 16px; font-size: 13px; max-width: 300px;">@log.Description</td>
                        <td style="padding: 16px; font-family: monospace; font-size: 12px;">@(log.IpAddress ?? "N/A")</td>
                        <td style="padding: 16px;">
                            @if (isMaliciousAction)
                            {
                                <span style="padding: 4px 12px; background: #fef2f2; color: #dc2626; border-radius: 20px; font-size: 11px; font-weight: 600;">⚠️ Flagged</span>
                            }
                            else
                            {
                                <span style="padding: 4px 12px; background: #d1fae5; color: #065f46; border-radius: 20px; font-size: 11px; font-weight: 600;">✓ Normal</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (activeTab == "all")
{
    <!-- Filters & Search -->
    <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid var(--border); margin-bottom: 24px;">
        <div style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px;">
            <div class="form-group">
                <label class="form-label">Module</label>
                <select class="form-control" @bind="selectedModule">
                    <option value="">All Modules</option>
                    <option value="Settings">Settings</option>
                    <option value="Banking">Banking</option>
                    <option value="Accounting">Accounting</option>
                    <option value="Users">Users</option>
                    <option value="Security">Security</option>
                    <option value="Authentication">Authentication</option>
                    <option value="Teller Banking">Teller Banking</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Action Type</label>
                <select class="form-control" @bind="selectedAction">
                    <option value="">All Actions</option>
                    <option value="Create">Create</option>
                    <option value="Update">Update</option>
                    <option value="Delete">Delete</option>
                    <option value="Login">Login</option>
                    <option value="Logout">Logout</option>
                    <option value="MALICIOUS">Malicious</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Date From</label>
                <input type="date" class="form-control" @bind="dateFrom" />
            </div>
            <div class="form-group">
                <label class="form-label">Date To</label>
                <input type="date" class="form-control" @bind="dateTo" />
            </div>
            <div class="form-group">
                <label class="form-label" style="visibility: hidden;">Action</label>
                <button class="btn btn-primary" style="width: 100%;" @onclick="ApplyFilters">🔍 Search</button>
            </div>
        </div>
    </div>

    <!-- Audit Trail Table -->
    <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid var(--border);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h3 style="font-size: 18px; font-weight: 700; margin: 0;">📊 All Activity Records</h3>
            <button class="btn" style="background: #10b981; color: white; padding: 8px 16px;">
                📥 Export Report
            </button>
        </div>

        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="border-bottom: 2px solid var(--border); background: #f9fafb;">
                    <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">TIMESTAMP</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">USER</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">MODULE</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">ACTION</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">DETAILS</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">IP ADDRESS</th>
                </tr>
            </thead>
            <tbody>
                @if (filteredLogs.Any())
                {
                    @foreach (var log in filteredLogs.OrderByDescending(l => l.CreatedAt).Take(50))
                    {
                        var isMaliciousLog = log.Action == "MALICIOUS_ATTEMPT" || log.Action == "LOGIN_FAILED";
                        <tr style="border-bottom: 1px solid var(--border); @(isMaliciousLog ? "background: #fef2f2;" : "")">
                            <td style="padding: 16px;">
                                <div style="font-weight: 600;">@log.CreatedAt.ToString("HH:mm:ss")</div>
                                <div style="font-size: 11px; color: var(--text-secondary);">@log.CreatedAt.ToString("MMM dd, yyyy")</div>
                            </td>
                            <td style="padding: 16px;">
                                <div style="font-weight: 600;">@log.UserId</div>
                            </td>
                            <td style="padding: 16px;">
                                <div style="font-size: 13px;">@log.Module</div>
                            </td>
                            <td style="padding: 16px;">
                                <span style="font-weight: 600; @(isMaliciousLog ? "color: #dc2626;" : "")">
                                    @(isMaliciousLog ? "⚠️ " : "")@log.Action
                                </span>
                            </td>
                            <td style="padding: 16px;">
                                <div style="font-size: 13px;">@log.Description</div>
                            </td>
                            <td style="padding: 16px; font-family: monospace; font-size: 12px;">@(log.IpAddress ?? "N/A")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="padding: 24px; text-align: center; font-size: 14px; color: var(--text-secondary);">No audit logs found.</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Pagination -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--border);">
            <div style="font-size: 13px; color: var(--text-secondary);">
                Showing 1-@Math.Min(50, filteredLogs.Count()) of @filteredLogs.Count() records
            </div>
        </div>
    </div>
}

