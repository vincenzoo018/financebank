@page "/admin/accountant/interest-payouts"
@layout AdminLayout
@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="admin-page accountant-page">
    <div class="page-header">
        <h1>
            <span class="role-badge accountant">Accountant</span>
            Interest Payouts
        </h1>
        <p class="page-subtitle">Process and manage interest payouts for savings accounts</p>
    </div>

    <!-- Admin Action Reason -->
    <div class="admin-action-card">
        <div class="alert alert-warning">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 24px; height: 24px;">
                <path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
            <span>You are accessing Accountant functions as SuperAdmin. All actions are logged.</span>
        </div>
        <div class="form-group">
            <label for="adminReason">Reason for Admin Action (Required)</label>
            <textarea id="adminReason" @bind="adminActionReason" class="form-control" 
                placeholder="Document why you are performing this action as admin..." rows="2"></textarea>
        </div>
    </div>

    <div class="payout-summary" style="margin-top: 24px;">
        <div class="summary-card">
            <div class="summary-icon" style="background: #10b981;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 24px; height: 24px;">
                    <line x1="12" y1="1" x2="12" y2="23"></line>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                </svg>
            </div>
            <div class="summary-content">
                <div class="summary-label">Total Interest Due</div>
                <div class="summary-value">₱@totalInterestDue.ToString("N0")</div>
            </div>
        </div>
        <div class="summary-card">
            <div class="summary-icon" style="background: #3b82f6;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 24px; height: 24px;">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
            </div>
            <div class="summary-content">
                <div class="summary-label">Accounts Pending</div>
                <div class="summary-value">@accountsPending</div>
            </div>
        </div>
        <div class="summary-card">
            <div class="summary-icon" style="background: #8b5cf6;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 24px; height: 24px;">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
            <div class="summary-content">
                <div class="summary-label">Processed Today</div>
                <div class="summary-value">₱@processedToday.ToString("N0")</div>
            </div>
        </div>
        <div class="summary-card">
            <div class="summary-icon" style="background: #f59e0b;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 24px; height: 24px;">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
            </div>
            <div class="summary-content">
                <div class="summary-label">Next Batch Date</div>
                <div class="summary-value">@nextBatchDate.ToString("MMM dd")</div>
            </div>
        </div>
    </div>

    <div class="admin-card" style="margin-top: 24px;">
        <div class="card-header">
            <h3>Pending Interest Payouts</h3>
            <div class="header-actions">
                <button class="btn btn-outline" @onclick="SelectAll">Select All</button>
                <button class="btn btn-primary" @onclick="ProcessSelected" disabled="@(!selectedPayouts.Any() || string.IsNullOrWhiteSpace(adminActionReason))">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 16px; height: 16px;">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    Process Selected (@selectedPayouts.Count)
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="table-filters">
                <div class="filter-group">
                    <input type="text" class="form-control" placeholder="Search account..." @bind="searchQuery" />
                </div>
                <div class="filter-group">
                    <select class="form-select" @bind="accountTypeFilter">
                        <option value="">All Account Types</option>
                        <option value="savings">Regular Savings</option>
                        <option value="time">Time Deposit</option>
                        <option value="special">Special Savings</option>
                    </select>
                </div>
            </div>

            <table class="table">
                <thead>
                    <tr>
                        <th style="width: 40px;">
                            <input type="checkbox" @onchange="ToggleSelectAll" />
                        </th>
                        <th>Account Number</th>
                        <th>Account Holder</th>
                        <th>Account Type</th>
                        <th>Balance</th>
                        <th>Interest Rate</th>
                        <th>Interest Due</th>
                        <th>Period</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payout in pendingPayouts)
                    {
                        <tr class="@(selectedPayouts.Contains(payout) ? "selected" : "")">
                            <td>
                                <input type="checkbox" checked="@selectedPayouts.Contains(payout)" 
                                    @onchange="() => ToggleSelection(payout)" />
                            </td>
                            <td><strong>@payout.AccountNumber</strong></td>
                            <td>@payout.AccountHolder</td>
                            <td>
                                <span class="account-type-badge @payout.AccountType.ToLower()">@payout.AccountType</span>
                            </td>
                            <td>₱@payout.Balance.ToString("N2")</td>
                            <td>@payout.InterestRate% p.a.</td>
                            <td class="interest-amount">₱@payout.InterestDue.ToString("N2")</td>
                            <td>@payout.Period</td>
                            <td>
                                <button class="btn btn-sm btn-success" @onclick="() => ProcessPayout(payout)"
                                    disabled="@string.IsNullOrWhiteSpace(adminActionReason)" title="Process">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 14px; height: 14px;">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="admin-card" style="margin-top: 24px;">
        <div class="card-header">
            <h3>Recent Interest Payouts</h3>
        </div>
        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Account Number</th>
                        <th>Account Holder</th>
                        <th>Interest Paid</th>
                        <th>Processed By</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var history in payoutHistory)
                    {
                        <tr>
                            <td>@history.ProcessedDate.ToString("MMM dd, yyyy HH:mm")</td>
                            <td><strong>@history.AccountNumber</strong></td>
                            <td>@history.AccountHolder</td>
                            <td>₱@history.InterestPaid.ToString("N2")</td>
                            <td>@history.ProcessedBy</td>
                            <td>
                                <span class="badge badge-success">Completed</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .accountant-page .role-badge.accountant {
        background: linear-gradient(135deg, #8b5cf6, #7c3aed);
    }
    .payout-summary {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
    }
    .summary-card {
        display: flex;
        gap: 16px;
        background: white;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }
    .summary-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
    }
    .summary-label {
        font-size: 0.85em;
        color: #6b7280;
    }
    .summary-value {
        font-size: 1.5em;
        font-weight: 700;
        color: #1f2937;
    }
    .header-actions {
        display: flex;
        gap: 12px;
    }
    .table-filters {
        display: flex;
        gap: 16px;
        margin-bottom: 20px;
    }
    .filter-group {
        flex: 1;
        max-width: 300px;
    }
    .table tr.selected {
        background: #f0fdf4;
    }
    .account-type-badge {
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.8em;
    }
    .account-type-badge.savings { background: #dcfce7; color: #166534; }
    .account-type-badge.time { background: #dbeafe; color: #1e40af; }
    .account-type-badge.special { background: #fef3c7; color: #92400e; }
    .interest-amount {
        font-weight: 600;
        color: #10b981;
    }
    .btn-sm {
        padding: 4px 8px;
    }
</style>

@code {
    private string adminActionReason = "";
    private string searchQuery = "";
    private string accountTypeFilter = "";

    private decimal totalInterestDue = 125000;
    private int accountsPending = 48;
    private decimal processedToday = 45000;
    private DateTime nextBatchDate = DateTime.Now.AddDays(3);

    private List<PayoutItem> pendingPayouts = new()
    {
        new() { AccountNumber = "SAV-2024-001", AccountHolder = "Juan Dela Cruz", AccountType = "Savings", Balance = 250000, InterestRate = 2.5m, InterestDue = 520.83m, Period = "Jan 2024" },
        new() { AccountNumber = "TD-2024-002", AccountHolder = "Maria Santos", AccountType = "Time", Balance = 500000, InterestRate = 5.0m, InterestDue = 2083.33m, Period = "Jan 2024" },
        new() { AccountNumber = "SAV-2024-003", AccountHolder = "Pedro Reyes", AccountType = "Savings", Balance = 150000, InterestRate = 2.5m, InterestDue = 312.50m, Period = "Jan 2024" },
        new() { AccountNumber = "SP-2024-004", AccountHolder = "Ana Garcia", AccountType = "Special", Balance = 1000000, InterestRate = 4.0m, InterestDue = 3333.33m, Period = "Jan 2024" }
    };

    private List<PayoutItem> selectedPayouts = new();

    private List<PayoutHistory> payoutHistory = new()
    {
        new() { AccountNumber = "SAV-2024-010", AccountHolder = "Jose Rizal", InterestPaid = 450.00m, ProcessedDate = DateTime.Now.AddHours(-2), ProcessedBy = "Accountant 1" },
        new() { AccountNumber = "TD-2024-011", AccountHolder = "Carlo Mendoza", InterestPaid = 1250.00m, ProcessedDate = DateTime.Now.AddHours(-3), ProcessedBy = "Accountant 1" },
        new() { AccountNumber = "SAV-2024-012", AccountHolder = "Linda Cruz", InterestPaid = 325.00m, ProcessedDate = DateTime.Now.AddHours(-4), ProcessedBy = "Accountant 2" }
    };

    protected override void OnInitialized()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
        }
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        if ((bool)(e.Value ?? false))
        {
            selectedPayouts = new List<PayoutItem>(pendingPayouts);
        }
        else
        {
            selectedPayouts.Clear();
        }
    }

    private void ToggleSelection(PayoutItem payout)
    {
        if (selectedPayouts.Contains(payout))
        {
            selectedPayouts.Remove(payout);
        }
        else
        {
            selectedPayouts.Add(payout);
        }
    }

    private void SelectAll()
    {
        selectedPayouts = new List<PayoutItem>(pendingPayouts);
    }

    private void ProcessSelected()
    {
        if (string.IsNullOrWhiteSpace(adminActionReason)) return;
        foreach (var payout in selectedPayouts.ToList())
        {
            pendingPayouts.Remove(payout);
        }
        selectedPayouts.Clear();
    }

    private void ProcessPayout(PayoutItem payout)
    {
        if (string.IsNullOrWhiteSpace(adminActionReason)) return;
        pendingPayouts.Remove(payout);
        selectedPayouts.Remove(payout);
    }

    private class PayoutItem
    {
        public string AccountNumber { get; set; } = "";
        public string AccountHolder { get; set; } = "";
        public string AccountType { get; set; } = "";
        public decimal Balance { get; set; }
        public decimal InterestRate { get; set; }
        public decimal InterestDue { get; set; }
        public string Period { get; set; } = "";
    }

    private class PayoutHistory
    {
        public string AccountNumber { get; set; } = "";
        public string AccountHolder { get; set; } = "";
        public decimal InterestPaid { get; set; }
        public DateTime ProcessedDate { get; set; }
        public string ProcessedBy { get; set; } = "";
    }
}
