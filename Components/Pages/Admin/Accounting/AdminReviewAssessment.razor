@page "/admin/accountant/review-assessment"
@layout AdminLayout
@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="admin-page accountant-page">
    <div class="page-header">
        <h1>
            <span class="role-badge accountant">Accountant</span>
            Review & Assessment
        </h1>
        <p class="page-subtitle">Review loan applications and financial assessments</p>
    </div>

    <!-- Admin Action Reason -->
    <div class="admin-action-card">
        <div class="alert alert-warning">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 24px; height: 24px;">
                <path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
            <span>You are accessing Accountant functions as SuperAdmin. All actions are logged.</span>
        </div>
        <div class="form-group">
            <label for="adminReason">Reason for Admin Action (Required)</label>
            <textarea id="adminReason" @bind="adminActionReason" class="form-control" 
                placeholder="Document why you are performing this action as admin..." rows="2"></textarea>
        </div>
    </div>

    <div class="review-tabs" style="margin-top: 24px;">
        <button class="tab-btn @(activeTab == "pending" ? "active" : "")" @onclick='() => activeTab = "pending"'>
            Pending Review
            <span class="badge">@pendingReviews.Count</span>
        </button>
        <button class="tab-btn @(activeTab == "inprogress" ? "active" : "")" @onclick='() => activeTab = "inprogress"'>
            In Progress
            <span class="badge">@inProgressReviews.Count</span>
        </button>
        <button class="tab-btn @(activeTab == "completed" ? "active" : "")" @onclick='() => activeTab = "completed"'>
            Completed
            <span class="badge">@completedReviews.Count</span>
        </button>
    </div>

    <div class="admin-card" style="margin-top: 24px;">
        @if (activeTab == "pending")
        {
            <div class="card-header">
                <h3>Pending Reviews</h3>
            </div>
            <div class="card-body">
                @foreach (var review in pendingReviews)
                {
                    <div class="review-card">
                        <div class="review-header">
                            <div class="applicant-info">
                                <strong>@review.ApplicantName</strong>
                                <span class="loan-type">@review.LoanType</span>
                            </div>
                            <div class="review-date">
                                Submitted: @review.SubmittedDate.ToString("MMM dd, yyyy")
                            </div>
                        </div>
                        <div class="review-details">
                            <div class="detail-row">
                                <span class="label">Amount Requested:</span>
                                <span class="value">₱@review.AmountRequested.ToString("N2")</span>
                            </div>
                            <div class="detail-row">
                                <span class="label">Term:</span>
                                <span class="value">@review.Term months</span>
                            </div>
                            <div class="detail-row">
                                <span class="label">Monthly Income:</span>
                                <span class="value">₱@review.MonthlyIncome.ToString("N2")</span>
                            </div>
                            <div class="detail-row">
                                <span class="label">Debt-to-Income Ratio:</span>
                                <span class="value @GetDTIClass(review.DebtToIncomeRatio)">@review.DebtToIncomeRatio%</span>
                            </div>
                        </div>
                        <div class="review-actions">
                            <button class="btn btn-primary" @onclick="() => StartReview(review)" disabled="@string.IsNullOrWhiteSpace(adminActionReason)">
                                Start Review
                            </button>
                            <button class="btn btn-outline" @onclick="() => ViewApplication(review)">
                                View Full Application
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else if (activeTab == "inprogress")
        {
            <div class="card-header">
                <h3>Reviews In Progress</h3>
            </div>
            <div class="card-body">
                @foreach (var review in inProgressReviews)
                {
                    <div class="review-card">
                        <div class="review-header">
                            <div class="applicant-info">
                                <strong>@review.ApplicantName</strong>
                                <span class="loan-type">@review.LoanType</span>
                            </div>
                            <div class="review-progress">
                                <span class="progress-label">@review.ProgressPercent% Complete</span>
                                <div class="progress-bar">
                                    <div class="progress-fill" style="width: @review.ProgressPercent%;"></div>
                                </div>
                            </div>
                        </div>
                        <div class="assessment-form">
                            <h4>Assessment Checklist</h4>
                            <div class="checklist">
                                <label class="check-item">
                                    <input type="checkbox" checked="@review.IncomeVerified" disabled />
                                    <span>Income Verified</span>
                                </label>
                                <label class="check-item">
                                    <input type="checkbox" checked="@review.EmploymentVerified" disabled />
                                    <span>Employment Verified</span>
                                </label>
                                <label class="check-item">
                                    <input type="checkbox" checked="@review.CollateralAssessed" disabled />
                                    <span>Collateral Assessed</span>
                                </label>
                                <label class="check-item">
                                    <input type="checkbox" checked="@review.CreditHistoryReviewed" disabled />
                                    <span>Credit History Reviewed</span>
                                </label>
                            </div>
                        </div>
                        <div class="review-actions">
                            <button class="btn btn-success" @onclick="() => CompleteReview(review)" disabled="@string.IsNullOrWhiteSpace(adminActionReason)">
                                Complete Assessment
                            </button>
                            <button class="btn btn-outline" @onclick="() => ContinueReview(review)">
                                Continue Review
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else if (activeTab == "completed")
        {
            <div class="card-header">
                <h3>Completed Reviews</h3>
            </div>
            <div class="card-body">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Applicant</th>
                            <th>Loan Type</th>
                            <th>Amount</th>
                            <th>Assessment</th>
                            <th>Reviewed By</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var review in completedReviews)
                        {
                            <tr>
                                <td><strong>@review.ApplicantName</strong></td>
                                <td>@review.LoanType</td>
                                <td>₱@review.AmountRequested.ToString("N0")</td>
                                <td>
                                    <span class="badge @GetAssessmentBadge(review.Assessment)">@review.Assessment</span>
                                </td>
                                <td>@review.ReviewedBy</td>
                                <td>@review.CompletedDate?.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <button class="btn btn-sm btn-outline" @onclick="() => ViewAssessment(review)">
                                        View Details
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<style>
    .accountant-page .role-badge.accountant {
        background: linear-gradient(135deg, #8b5cf6, #7c3aed);
    }
    .review-tabs {
        display: flex;
        gap: 8px;
        background: white;
        padding: 8px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }
    .tab-btn {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 20px;
        border: none;
        background: transparent;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 500;
        color: #6b7280;
        transition: all 0.2s;
    }
    .tab-btn:hover {
        background: #f3f4f6;
    }
    .tab-btn.active {
        background: #8b5cf6;
        color: white;
    }
    .tab-btn .badge {
        background: rgba(0,0,0,0.1);
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 0.8em;
    }
    .tab-btn.active .badge {
        background: rgba(255,255,255,0.3);
    }
    .review-card {
        padding: 24px;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        margin-bottom: 16px;
        background: #fafafa;
    }
    .review-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 16px;
    }
    .applicant-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .loan-type {
        padding: 4px 12px;
        background: #e0e7ff;
        color: #4f46e5;
        border-radius: 6px;
        font-size: 0.85em;
    }
    .review-date {
        color: #6b7280;
        font-size: 0.9em;
    }
    .review-details {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
        margin-bottom: 20px;
        padding: 16px;
        background: white;
        border-radius: 8px;
    }
    .detail-row {
        display: flex;
        justify-content: space-between;
    }
    .detail-row .label {
        color: #6b7280;
    }
    .detail-row .value {
        font-weight: 600;
    }
    .dti-good { color: #10b981; }
    .dti-moderate { color: #f59e0b; }
    .dti-high { color: #ef4444; }
    .review-actions {
        display: flex;
        gap: 12px;
    }
    .review-progress {
        text-align: right;
    }
    .progress-label {
        display: block;
        font-size: 0.85em;
        color: #6b7280;
        margin-bottom: 4px;
    }
    .progress-bar {
        width: 150px;
        height: 8px;
        background: #e5e7eb;
        border-radius: 4px;
        overflow: hidden;
    }
    .progress-fill {
        height: 100%;
        background: #8b5cf6;
        border-radius: 4px;
    }
    .assessment-form {
        padding: 16px;
        background: white;
        border-radius: 8px;
        margin-bottom: 20px;
    }
    .assessment-form h4 {
        margin-bottom: 12px;
        font-size: 0.95em;
        color: #374151;
    }
    .checklist {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }
    .check-item {
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
    }
    .check-item input[type="checkbox"] {
        width: 18px;
        height: 18px;
        accent-color: #8b5cf6;
    }
</style>

@code {
    private string adminActionReason = "";
    private string activeTab = "pending";

    private List<ReviewItem> pendingReviews = new()
    {
        new() { ApplicantName = "Juan Dela Cruz", LoanType = "Personal Loan", AmountRequested = 150000, Term = 24, MonthlyIncome = 45000, DebtToIncomeRatio = 28, SubmittedDate = DateTime.Now.AddDays(-2) },
        new() { ApplicantName = "Maria Santos", LoanType = "Business Loan", AmountRequested = 500000, Term = 36, MonthlyIncome = 85000, DebtToIncomeRatio = 35, SubmittedDate = DateTime.Now.AddDays(-1) },
        new() { ApplicantName = "Pedro Reyes", LoanType = "Emergency Loan", AmountRequested = 50000, Term = 12, MonthlyIncome = 25000, DebtToIncomeRatio = 45, SubmittedDate = DateTime.Now }
    };

    private List<ReviewItem> inProgressReviews = new()
    {
        new() { ApplicantName = "Ana Garcia", LoanType = "Home Loan", AmountRequested = 2000000, Term = 240, MonthlyIncome = 75000, DebtToIncomeRatio = 32, ProgressPercent = 75, IncomeVerified = true, EmploymentVerified = true, CollateralAssessed = true, CreditHistoryReviewed = false },
        new() { ApplicantName = "Jose Rizal", LoanType = "Car Loan", AmountRequested = 800000, Term = 60, MonthlyIncome = 55000, DebtToIncomeRatio = 25, ProgressPercent = 50, IncomeVerified = true, EmploymentVerified = true, CollateralAssessed = false, CreditHistoryReviewed = false }
    };

    private List<ReviewItem> completedReviews = new()
    {
        new() { ApplicantName = "Carlo Mendoza", LoanType = "Personal Loan", AmountRequested = 100000, Assessment = "Approved", ReviewedBy = "Accountant 1", CompletedDate = DateTime.Now.AddDays(-1) },
        new() { ApplicantName = "Linda Cruz", LoanType = "Business Loan", AmountRequested = 350000, Assessment = "Conditional", ReviewedBy = "Accountant 2", CompletedDate = DateTime.Now.AddDays(-2) },
        new() { ApplicantName = "Robert Tan", LoanType = "Emergency Loan", AmountRequested = 75000, Assessment = "Rejected", ReviewedBy = "Accountant 1", CompletedDate = DateTime.Now.AddDays(-3) }
    };

    protected override void OnInitialized()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
        }
    }

    private string GetDTIClass(int ratio) => ratio switch
    {
        <= 30 => "dti-good",
        <= 40 => "dti-moderate",
        _ => "dti-high"
    };

    private string GetAssessmentBadge(string assessment) => assessment switch
    {
        "Approved" => "badge-success",
        "Conditional" => "badge-warning",
        "Rejected" => "badge-danger",
        _ => "badge-secondary"
    };

    private void StartReview(ReviewItem review) { }
    private void ViewApplication(ReviewItem review) { }
    private void CompleteReview(ReviewItem review) { }
    private void ContinueReview(ReviewItem review) { }
    private void ViewAssessment(ReviewItem review) { }

    private class ReviewItem
    {
        public string ApplicantName { get; set; } = "";
        public string LoanType { get; set; } = "";
        public decimal AmountRequested { get; set; }
        public int Term { get; set; }
        public decimal MonthlyIncome { get; set; }
        public int DebtToIncomeRatio { get; set; }
        public DateTime SubmittedDate { get; set; }
        public int ProgressPercent { get; set; }
        public bool IncomeVerified { get; set; }
        public bool EmploymentVerified { get; set; }
        public bool CollateralAssessed { get; set; }
        public bool CreditHistoryReviewed { get; set; }
        public string Assessment { get; set; } = "";
        public string ReviewedBy { get; set; } = "";
        public DateTime? CompletedDate { get; set; }
    }
}
