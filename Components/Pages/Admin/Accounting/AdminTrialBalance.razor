@page "/admin/accounting/trial-balance"
@page "/admin/accountant/trial-balance"
@layout AdminLayout
@inject TrialBalanceService TrialBalanceService

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
                <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
            </div>
            <div>
                <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Trial Balance (Admin)</h1>
                <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Verify that debits and credits are balanced - SuperAdmin Access</p>
            </div>
        </div>
        <div style="background: rgba(255,255,255,0.2); padding: 10px 16px; border-radius: 8px;">
            <span style="font-size: 13px; color: white;">👁️ View Only</span>
        </div>
    </div>
</div>

<!-- Admin Notice -->
<div style="background: #ede9fe; border: 1px solid #8b5cf6; border-radius: 12px; padding: 16px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 12px;">
        <span style="font-size: 24px;">⚖️</span>
        <div>
            <p style="margin: 0; font-weight: 600; color: #5b21b6;">Administrative View - Trial Balance</p>
            <p style="margin: 4px 0 0; font-size: 13px; color: #7c3aed;">View-only access to the Trial Balance report as SuperAdmin.</p>
        </div>
    </div>
</div>

<!-- Action Bar -->
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <div style="display: flex; gap: 12px;">
        <button style="background: linear-gradient(135deg, #8b5cf6, #a78bfa); color: white; padding: 12px 24px; border: none; border-radius: 10px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px;" @onclick="GenerateTrialBalance">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M23 4v6h-6M1 20v-6h6M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15" />
            </svg>
            Refresh Trial Balance
        </button>
        <button style="background: #3b82f6; color: white; padding: 12px 24px; border: none; border-radius: 10px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px;" @onclick="ExportToPdf">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
                <polyline points="14 2 14 8 20 8" />
            </svg>
            Export PDF
        </button>
    </div>
    <div style="display: flex; align-items: center; gap: 12px;">
        <span style="font-size: 14px; color: #6b7280;">As of:</span>
        <input type="date" @bind="asOfDate" style="padding: 10px 16px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;" />
    </div>
</div>

<!-- Summary Cards -->
<div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 24px;">
    <div style="background: linear-gradient(135deg, #dbeafe, #bfdbfe); border-radius: 16px; padding: 24px; border: 2px solid #93c5fd;">
        <div style="font-size: 13px; color: #1e40af; font-weight: 600; margin-bottom: 8px; text-transform: uppercase;">💰 Total Debits</div>
        <div style="font-size: 32px; font-weight: 700; color: #1e40af;">₱@totalDebits.ToString("N2")</div>
    </div>
    <div style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); border-radius: 16px; padding: 24px; border: 2px solid #6ee7b7;">
        <div style="font-size: 13px; color: #065f46; font-weight: 600; margin-bottom: 8px; text-transform: uppercase;">✅ Total Credits</div>
        <div style="font-size: 32px; font-weight: 700; color: #065f46;">₱@totalCredits.ToString("N2")</div>
    </div>
    <div style="background: linear-gradient(135deg, @(isBalanced ? "#d1fae5" : "#fee2e2"), @(isBalanced ? "#a7f3d0" : "#fecaca")); border-radius: 16px; padding: 24px; border: 2px solid @(isBalanced ? "#6ee7b7" : "#fca5a5");">
        <div style="font-size: 13px; color: @(isBalanced ? "#065f46" : "#991b1b"); font-weight: 600; margin-bottom: 8px; text-transform: uppercase;">⚖️ Balance Status</div>
        <div style="font-size: 28px; font-weight: 700; color: @(isBalanced ? "#065f46" : "#991b1b");">@(isBalanced ? "✓ BALANCED" : "✗ UNBALANCED")</div>
    </div>
</div>

<!-- Alerts -->
@if (!string.IsNullOrEmpty(successMessage))
{
    <div style="background: linear-gradient(135deg, #ede9fe, #ddd6fe); border: 1px solid #8b5cf6; color: #5b21b6; padding: 16px 20px; border-radius: 12px; margin-bottom: 20px; display: flex; align-items: center; gap: 12px;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
        <span style="font-weight: 500;">@successMessage</span>
        <button @onclick="() => successMessage = string.Empty" style="margin-left: auto; background: none; border: none; color: #5b21b6; cursor: pointer; font-size: 18px;">×</button>
    </div>
}

<!-- Trial Balance Table -->
<div style="background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden;">
    <div style="background: linear-gradient(135deg, #8b5cf6, #a78bfa); color: white; padding: 20px 24px;">
        <h4 style="margin: 0; font-weight: 600; font-size: 18px;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px; vertical-align: middle;">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Trial Balance Report (Admin View)
        </h4>
        <p style="margin: 6px 0 0 0; opacity: 0.9; font-size: 13px;">As of @asOfDate.ToString("MMMM dd, yyyy")</p>
    </div>

    <div style="padding: 24px;">
        @if (isLoading)
        {
            <div style="text-align: center; padding: 60px;">
                <div style="width: 48px; height: 48px; border: 4px solid #e5e7eb; border-top-color: #8b5cf6; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto;"></div>
                <p style="margin-top: 16px; color: #6b7280;">Loading trial balance...</p>
            </div>
        }
        else if (tbEntries == null || !tbEntries.Any())
        {
            <div style="text-align: center; padding: 60px;">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5" style="margin: 0 auto 16px;">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <p style="color: #6b7280; font-size: 16px;">No trial balance entries found</p>
                <p style="color: #9ca3af; font-size: 14px;">Click "Refresh Trial Balance" to load the report</p>
            </div>
        }
        else
        {
            <table style="width: 100%; border-collapse: separate; border-spacing: 0;">
                <thead>
                    <tr style="background: linear-gradient(135deg, #f8fafc, #f1f5f9);">
                        <th style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">Account Code</th>
                        <th style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">Account Name</th>
                        <th style="padding: 14px 16px; text-align: right; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">Debit</th>
                        <th style="padding: 14px 16px; text-align: right; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">Credit</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in tbEntries)
                    {
                        <tr style="border-bottom: 1px solid #f1f5f9;">
                            <td style="padding: 16px;">
                                <span style="background: #ede9fe; color: #5b21b6; padding: 4px 10px; border-radius: 6px; font-family: monospace; font-weight: 600;">@entry.AccountCode</span>
                            </td>
                            <td style="padding: 16px; font-weight: 500; color: #1e293b;">@entry.AccountName</td>
                            <td style="padding: 16px; text-align: right; font-weight: 600; color: @(entry.DebitBalance > 0 ? "#dc2626" : "#9ca3af");">
                                @(entry.DebitBalance > 0 ? $"₱{entry.DebitBalance:N2}" : "-")
                            </td>
                            <td style="padding: 16px; text-align: right; font-weight: 600; color: @(entry.CreditBalance > 0 ? "#059669" : "#9ca3af");">
                                @(entry.CreditBalance > 0 ? $"₱{entry.CreditBalance:N2}" : "-")
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr style="background: linear-gradient(135deg, #ede9fe, #ddd6fe); border-top: 2px solid #8b5cf6;">
                        <td colspan="2" style="padding: 16px; text-align: right; font-weight: 700; color: #1e293b; font-size: 15px;">TOTALS:</td>
                        <td style="padding: 16px; text-align: right; font-weight: 700; color: #dc2626; font-size: 16px;">₱@totalDebits.ToString("N2")</td>
                        <td style="padding: 16px; text-align: right; font-weight: 700; color: #059669; font-size: 16px;">₱@totalCredits.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        }
    </div>
</div>

<style>
    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

@code {
    private List<TrialBalanceEntry> tbEntries = new();
    private decimal totalDebits = 0;
    private decimal totalCredits = 0;
    private bool isBalanced = true;
    private bool isLoading = true;
    private DateTime asOfDate = DateTime.Today;
    private string successMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadTrialBalance();
    }

    private async Task LoadTrialBalance()
    {
        isLoading = true;
        try
        {
            tbEntries = await TrialBalanceService.GetAllAsync();
            CalculateTotals();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading trial balance: {ex.Message}");
            tbEntries = new List<TrialBalanceEntry>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void CalculateTotals()
    {
        totalDebits = tbEntries.Sum(e => e.DebitBalance);
        totalCredits = tbEntries.Sum(e => e.CreditBalance);
        isBalanced = Math.Abs(totalDebits - totalCredits) < 0.01m;
    }

    private async Task GenerateTrialBalance()
    {
        isLoading = true;
        try
        {
            await LoadTrialBalance();
            successMessage = $"✓ Trial Balance refreshed successfully as of {asOfDate:MMM dd, yyyy}";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error generating trial balance: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ExportToPdf()
    {
        successMessage = "PDF export feature coming soon!";
    }
}
