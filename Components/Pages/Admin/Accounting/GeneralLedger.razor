@page "/admin/accounting/general-ledger"
@layout AdminLayout
@inject GeneralLedgerService GeneralLedgerService

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
            <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
        </div>
        <div>
            <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">General Ledger</h1>
            <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Complete record of all financial transactions</p>
        </div>
    </div>
</div>

<!-- Action Bar -->
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <div style="display: flex; gap: 12px;">
        <button class="btn" style="background: #2563eb; color: white; padding: 12px 24px; font-weight: 600;" @onclick="() => showNewEntryModal = true">
            ➕ New Entry
        </button>
    </div>
</div>

<!-- GL Entries Table -->
<div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid var(--border);">
    <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 20px;">General Ledger Entries</h3>

    <table style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr style="border-bottom: 2px solid var(--border); background: #f9fafb;">
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">ENTRY NO.</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">ACCOUNT CODE</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">ACCOUNT NAME</th>
                <th style="padding: 12px; text-align: right; font-size: 12px; font-weight: 700;">DEBIT</th>
                <th style="padding: 12px; text-align: right; font-size: 12px; font-weight: 700;">CREDIT</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">DATE</th>
                <th style="padding: 12px; text-align: center; font-size: 12px; font-weight: 700;">ACTIONS</th>
            </tr>
        </thead>
        <tbody>
            @if (glEntries == null || glEntries.Count == 0)
            {
                <tr>
                    <td colspan="7" style="padding: 16px; text-align: center; color: #6b7280; font-size: 14px;">No GL entries found.</td>
                </tr>
            }
            else
            {
                @foreach (var entry in glEntries)
                {
                    <tr style="border-bottom: 1px solid var(--border); transition: background 0.2s;">
                        <td style="padding: 16px; font-family: monospace; font-weight: 600; color: #2563eb;">@entry.EntryNumber</td>
                        <td style="padding: 16px; font-family: monospace;">@entry.AccountCode</td>
                        <td style="padding: 16px;">@entry.AccountName</td>
                        <td style="padding: 16px; text-align: right; font-size: 14px; color: @(entry.DebitAmount > 0 ? "#dc2626" : "#6b7280");">₱@entry.DebitAmount.ToString("N2")</td>
                        <td style="padding: 16px; text-align: right; font-size: 14px; color: @(entry.CreditAmount > 0 ? "#059669" : "#6b7280");">₱@entry.CreditAmount.ToString("N2")</td>
                        <td style="padding: 16px; font-size: 14px;">@entry.TransactionDate.ToString("MMM dd, yyyy")</td>
                        <td style="padding: 16px; text-align: center;">
                            <button class="btn" style="background: white; border: 2px solid #e5e7eb; color: #374151; padding: 6px 12px; font-size: 13px;" @onclick="() => ShowEntryDetailsModal(entry.EntryId)">
                                👁️ View
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- New Entry Modal -->
<div style="display: @(showNewEntryModal ? "flex" : "none"); position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000;">
    <div style="background: white; border-radius: 16px; padding: 32px; max-width: 500px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
        <h2 style="font-size: 20px; font-weight: 700; margin: 0 0 24px 0;">➕ New GL Entry</h2>
        
        <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label">Account Code</label>
            <input type="text" class="form-control" @bind="newEntry_AccountCode" placeholder="e.g., 1000" />
        </div>
        
        <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label">Account Name</label>
            <input type="text" class="form-control" @bind="newEntry_AccountName" placeholder="e.g., Cash" />
        </div>
        
        <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label">Debit Amount (₱)</label>
            <input type="number" class="form-control" @bind="newEntry_DebitAmount" placeholder="0.00" step="0.01" />
        </div>
        
        <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label">Credit Amount (₱)</label>
            <input type="number" class="form-control" @bind="newEntry_CreditAmount" placeholder="0.00" step="0.01" />
        </div>
        
        <div class="form-group" style="margin-bottom: 24px;">
            <label class="form-label">Description</label>
            <textarea class="form-control" @bind="newEntry_Description" placeholder="Optional notes" style="min-height: 80px;"></textarea>
        </div>
        
        <div style="display: flex; gap: 12px; justify-content: flex-end;">
            <button class="btn" style="background: #e5e7eb; color: #374151; padding: 10px 20px; font-weight: 600;" @onclick="() => showNewEntryModal = false">Cancel</button>
            <button class="btn" style="background: #2563eb; color: white; padding: 10px 20px; font-weight: 600;" @onclick="CreateNewEntry">Create Entry</button>
        </div>
    </div>
</div>

@code {
    @inject GeneralLedgerService GeneralLedgerService

    private List<FinanceBank.Models.GeneralLedgerEntry> glEntries = new();
    private bool showNewEntryModal = false;
    private bool showEntryDetailsModal = false;
    private int selectedEntryId = 0;

    // New entry form
    private string newEntry_AccountCode = "";
    private string newEntry_AccountName = "";
    private decimal newEntry_DebitAmount = 0;
    private decimal newEntry_CreditAmount = 0;
    private string newEntry_Description = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            glEntries = await GeneralLedgerService.GetAllAsync();
        }
        catch
        {
        }
    }

    private async Task CreateNewEntry()
    {
        if (string.IsNullOrWhiteSpace(newEntry_AccountCode) || string.IsNullOrWhiteSpace(newEntry_AccountName))
        {
            return;
        }

        var newEntry = new FinanceBank.Models.GeneralLedgerEntry
        {
            AccountCode = newEntry_AccountCode,
            AccountName = newEntry_AccountName,
            DebitAmount = newEntry_DebitAmount,
            CreditAmount = newEntry_CreditAmount,
            Description = newEntry_Description,
            TransactionDate = DateTime.Today,
            CreatedBy = "Admin"
        };

        try
        {
            await GeneralLedgerService.CreateAsync(newEntry);
            glEntries = await GeneralLedgerService.GetAllAsync();
            
            // Reset form
            newEntry_AccountCode = "";
            newEntry_AccountName = "";
            newEntry_DebitAmount = 0;
            newEntry_CreditAmount = 0;
            newEntry_Description = "";
            showNewEntryModal = false;
        }
        catch
        {
        }
    }

    private void ShowEntryDetailsModal(int id) { selectedEntryId = id; showEntryDetailsModal = true; }
    private void CloseEntryDetailsModal() => showEntryDetailsModal = false;
}

