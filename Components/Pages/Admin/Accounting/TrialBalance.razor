@page "/admin/accounting/trial-balance"
@layout AdminLayout
@inject TrialBalanceService TrialBalanceService

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #059669 0%, #047857 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
            <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
            </svg>
        </div>
        <div>
            <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Trial Balance</h1>
            <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Verify debits and credits balance</p>
        </div>
    </div>
</div>

<!-- Action Bar -->
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <div style="display: flex; gap: 12px;">
        <button class="btn" style="background: #059669; color: white; padding: 12px 24px; font-weight: 600;" @onclick="ShowGenerateReportModal">
            📊 Generate Report
        </button>
    </div>
</div>

<!-- Summary Cards -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 24px;">
    <div style="background: linear-gradient(135deg, #dbeafe, #bfdbfe); border-radius: 16px; padding: 24px; border: 2px solid #93c5fd;">
        <div style="font-size: 13px; color: #1e40af; font-weight: 600; margin-bottom: 8px;">💰 TOTAL DEBITS</div>
        <div style="font-size: 32px; font-weight: 700; color: #1e40af;">₱@totalDebits.ToString("N2")</div>
    </div>
    <div style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); border-radius: 16px; padding: 24px; border: 2px solid #6ee7b7;">
        <div style="font-size: 13px; color: #065f46; font-weight: 600; margin-bottom: 8px;">✅ TOTAL CREDITS</div>
        <div style="font-size: 32px; font-weight: 700; color: #065f46;">₱@totalCredits.ToString("N2")</div>
    </div>
    <div style="background: linear-gradient(135deg, @(isBalanced ? "#d1fae5" : "#fee2e2"), @(isBalanced ? "#a7f3d0" : "#fecaca")); border-radius: 16px; padding: 24px; border: 2px solid @(isBalanced ? "#6ee7b7" : "#fca5a5");">
        <div style="font-size: 13px; color: @(isBalanced ? "#065f46" : "#991b1b"); font-weight: 600; margin-bottom: 8px;">⚖️ BALANCE</div>
        <div style="font-size: 32px; font-weight: 700; color: @(isBalanced ? "#065f46" : "#991b1b");">@(isBalanced ? "✓ BALANCED" : "✗ NOT BALANCED")</div>
    </div>
</div>

<!-- TB Entries Table -->
<div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid var(--border);">
    <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 20px;">Trial Balance Entries</h3>

    <table style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr style="border-bottom: 2px solid var(--border); background: #f9fafb;">
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">ACCOUNT CODE</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">ACCOUNT NAME</th>
                <th style="padding: 12px; text-align: right; font-size: 12px; font-weight: 700;">DEBIT BALANCE</th>
                <th style="padding: 12px; text-align: right; font-size: 12px; font-weight: 700;">CREDIT BALANCE</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">AS OF DATE</th>
            </tr>
        </thead>
        <tbody>
            @if (tbEntries == null || tbEntries.Count == 0)
            {
                <tr>
                    <td colspan="5" style="padding: 16px; text-align: center; color: #6b7280; font-size: 14px;">No trial balance entries found.</td>
                </tr>
            }
            else
            {
                @foreach (var entry in tbEntries)
                {
                    <tr style="border-bottom: 1px solid var(--border); transition: background 0.2s;">
                        <td style="padding: 16px; font-family: monospace; font-weight: 600;">@entry.AccountCode</td>
                        <td style="padding: 16px;">@entry.AccountName</td>
                        <td style="padding: 16px; text-align: right; font-size: 14px; color: @(entry.DebitBalance > 0 ? "#dc2626" : "#6b7280");">₱@entry.DebitBalance.ToString("N2")</td>
                        <td style="padding: 16px; text-align: right; font-size: 14px; color: @(entry.CreditBalance > 0 ? "#059669" : "#6b7280");">₱@entry.CreditBalance.ToString("N2")</td>
                        <td style="padding: 16px; font-size: 14px;">@entry.AsOfDate.ToString("MMM dd, yyyy")</td>
                    </tr>
                }
            }
        </tbody>
        <tfoot>
            <tr style="border-top: 2px solid var(--border); background: #f9fafb; font-weight: 700;">
                <td colspan="2" style="padding: 16px; text-align: right;">TOTALS:</td>
                <td style="padding: 16px; text-align: right; font-size: 14px; color: #dc2626;">₱@totalDebits.ToString("N2")</td>
                <td style="padding: 16px; text-align: right; font-size: 14px; color: #059669;">₱@totalCredits.ToString("N2")</td>
                <td></td>
            </tr>
        </tfoot>
    </table>
</div>

<!-- Generate Report Modal -->
<div style="display: @(showGenerateReportModal ? "flex" : "none"); position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000;">
    <div style="background: white; border-radius: 16px; padding: 32px; max-width: 500px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
        <h2 style="font-size: 20px; font-weight: 700; margin: 0 0 24px 0;">📊 Generate Trial Balance Report</h2>
        
        <div class="form-group" style="margin-bottom: 24px;">
            <label class="form-label">As Of Date</label>
            <input type="date" class="form-control" @bind="reportAsOfDate" />
        </div>
        
        <div style="display: flex; gap: 12px; justify-content: flex-end;">
            <button class="btn" style="background: #e5e7eb; color: #374151; padding: 10px 20px; font-weight: 600;" @onclick="CloseGenerateReportModal">Cancel</button>
            <button class="btn" style="background: #059669; color: white; padding: 10px 20px; font-weight: 600;" @onclick="GenerateReport">Generate</button>
        </div>
    </div>
</div>

@code {
    private List<FinanceBank.Models.TrialBalanceEntry> tbEntries = new();
    private bool showGenerateReportModal = false;
    private DateTime reportAsOfDate = DateTime.Today;
    private decimal totalDebits = 0;
    private decimal totalCredits = 0;
    private bool isBalanced = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            tbEntries = await TrialBalanceService.GetAllAsync();
            CalculateTotals();
        }
        catch
        {
        }
    }

    private void CalculateTotals()
    {
        totalDebits = tbEntries.Sum(t => t.DebitBalance);
        totalCredits = tbEntries.Sum(t => t.CreditBalance);
        isBalanced = Math.Abs(totalDebits - totalCredits) < 0.01m;
    }

    private void ShowGenerateReportModal() => showGenerateReportModal = true;
    private void CloseGenerateReportModal() => showGenerateReportModal = false;

    private async Task GenerateReport()
    {
        // Placeholder: In a real system, this would generate a PDF or export
        showGenerateReportModal = false;
    }
}

