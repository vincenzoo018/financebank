@page "/admin/accountant/transaction-reports"
@layout AdminLayout
@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="admin-page accountant-page">
    <div class="page-header">
        <h1>
            <span class="role-badge accountant">Accountant</span>
            Transaction Reports
        </h1>
        <p class="page-subtitle">Generate and analyze transaction reports</p>
    </div>

    <!-- Admin Action Reason -->
    <div class="admin-action-card">
        <div class="alert alert-warning">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 24px; height: 24px;">
                <path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
            <span>You are accessing Accountant functions as SuperAdmin. All actions are logged.</span>
        </div>
        <div class="form-group">
            <label for="adminReason">Reason for Admin Action (Required)</label>
            <textarea id="adminReason" @bind="adminActionReason" class="form-control" 
                placeholder="Document why you are performing this action as admin..." rows="2"></textarea>
        </div>
    </div>

    <div class="report-controls" style="margin-top: 24px;">
        <div class="control-group">
            <label>Report Type</label>
            <select class="form-select" @bind="reportType">
                <option value="all">All Transactions</option>
                <option value="deposits">Deposits</option>
                <option value="withdrawals">Withdrawals</option>
                <option value="transfers">Transfers</option>
                <option value="loans">Loan Transactions</option>
            </select>
        </div>
        <div class="control-group">
            <label>From Date</label>
            <input type="date" class="form-control" @bind="fromDate" />
        </div>
        <div class="control-group">
            <label>To Date</label>
            <input type="date" class="form-control" @bind="toDate" />
        </div>
        <div class="control-group">
            <label>Branch</label>
            <select class="form-select" @bind="selectedBranch">
                <option value="">All Branches</option>
                <option value="main">Main Branch</option>
                <option value="north">North Branch</option>
                <option value="south">South Branch</option>
            </select>
        </div>
        <button class="btn btn-primary" @onclick="GenerateReport">Generate</button>
        <button class="btn btn-outline" @onclick="ExportReport">Export</button>
    </div>

    <div class="report-summary" style="margin-top: 24px;">
        <div class="summary-card">
            <div class="summary-label">Total Transactions</div>
            <div class="summary-value">@totalTransactions.ToString("N0")</div>
        </div>
        <div class="summary-card">
            <div class="summary-label">Total Volume</div>
            <div class="summary-value">₱@totalVolume.ToString("N0")</div>
        </div>
        <div class="summary-card">
            <div class="summary-label">Average Amount</div>
            <div class="summary-value">₱@averageAmount.ToString("N0")</div>
        </div>
        <div class="summary-card">
            <div class="summary-label">Fee Revenue</div>
            <div class="summary-value" style="color: #10b981;">₱@feeRevenue.ToString("N0")</div>
        </div>
    </div>

    <div class="admin-card" style="margin-top: 24px;">
        <div class="card-header">
            <h3>Transaction Summary by Type</h3>
        </div>
        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Transaction Type</th>
                        <th>Count</th>
                        <th>Total Amount</th>
                        <th>% of Total</th>
                        <th>Avg. Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var summary in typeSummary)
                    {
                        <tr>
                            <td>
                                <span class="tx-type @summary.Type.ToLower().Replace(" ", "")">@summary.Type</span>
                            </td>
                            <td>@summary.Count.ToString("N0")</td>
                            <td>₱@summary.TotalAmount.ToString("N0")</td>
                            <td>
                                <div class="percent-bar">
                                    <div class="percent-fill" style="width: @summary.Percentage%;"></div>
                                    <span>@summary.Percentage%</span>
                                </div>
                            </td>
                            <td>₱@summary.AverageAmount.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="reports-grid" style="margin-top: 24px;">
        <div class="admin-card">
            <div class="card-header">
                <h3>Daily Trend</h3>
            </div>
            <div class="card-body">
                <div class="trend-chart">
                    @foreach (var day in dailyTrend)
                    {
                        <div class="day-column">
                            <div class="bar" style="height: @(day.Volume / 50000)px;" title="₱@day.Volume.ToString("N0")"></div>
                            <span class="day-label">@day.Date.ToString("dd")</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="admin-card">
            <div class="card-header">
                <h3>Top Customers by Volume</h3>
            </div>
            <div class="card-body">
                <div class="customer-list">
                    @foreach (var customer in topCustomers)
                    {
                        <div class="customer-item">
                            <div class="customer-rank">@customer.Rank</div>
                            <div class="customer-info">
                                <strong>@customer.Name</strong>
                                <span>@customer.TransactionCount transactions</span>
                            </div>
                            <div class="customer-amount">₱@customer.TotalVolume.ToString("N0")</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="admin-card" style="margin-top: 24px;">
        <div class="card-header">
            <h3>Transaction Details</h3>
        </div>
        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Reference</th>
                        <th>Type</th>
                        <th>Customer</th>
                        <th>Account</th>
                        <th>Amount</th>
                        <th>Fee</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tx in transactions)
                    {
                        <tr>
                            <td>@tx.Date.ToString("MMM dd, yyyy")</td>
                            <td><strong>@tx.Reference</strong></td>
                            <td>
                                <span class="tx-type @tx.Type.ToLower()">@tx.Type</span>
                            </td>
                            <td>@tx.CustomerName</td>
                            <td>@tx.AccountNumber</td>
                            <td>₱@tx.Amount.ToString("N2")</td>
                            <td>₱@tx.Fee.ToString("N2")</td>
                            <td>
                                <span class="badge badge-success">@tx.Status</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="pagination">
                <button class="btn btn-sm btn-outline" disabled>Previous</button>
                <span class="page-info">Page 1 of 10</span>
                <button class="btn btn-sm btn-outline">Next</button>
            </div>
        </div>
    </div>
</div>

<style>
    .accountant-page .role-badge.accountant {
        background: linear-gradient(135deg, #8b5cf6, #7c3aed);
    }
    .report-controls {
        display: flex;
        gap: 16px;
        align-items: flex-end;
        background: white;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        flex-wrap: wrap;
    }
    .control-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }
    .control-group label {
        font-size: 0.85em;
        color: #6b7280;
    }
    .report-summary {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
    }
    .summary-card {
        background: white;
        padding: 24px;
        border-radius: 12px;
        text-align: center;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }
    .summary-label {
        font-size: 0.9em;
        color: #6b7280;
        margin-bottom: 8px;
    }
    .summary-value {
        font-size: 1.8em;
        font-weight: 700;
        color: #1f2937;
    }
    .tx-type {
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.8em;
    }
    .tx-type.deposit { background: #dcfce7; color: #166534; }
    .tx-type.withdrawal { background: #fee2e2; color: #991b1b; }
    .tx-type.transfer { background: #dbeafe; color: #1e40af; }
    .tx-type.loan, .tx-type.loandisbursement { background: #fef3c7; color: #92400e; }
    .tx-type.loanpayment { background: #e0e7ff; color: #4f46e5; }
    .percent-bar {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .percent-fill {
        height: 8px;
        background: #8b5cf6;
        border-radius: 4px;
        max-width: 100px;
    }
    .reports-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }
    .trend-chart {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        height: 150px;
        padding: 20px 0;
    }
    .day-column {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
    }
    .day-column .bar {
        width: 16px;
        background: #8b5cf6;
        border-radius: 4px 4px 0 0;
        min-height: 4px;
    }
    .day-label {
        font-size: 0.75em;
        color: #6b7280;
    }
    .customer-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .customer-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        background: #f8fafc;
        border-radius: 8px;
    }
    .customer-rank {
        width: 32px;
        height: 32px;
        background: #8b5cf6;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
    }
    .customer-info {
        flex: 1;
    }
    .customer-info span {
        display: block;
        font-size: 0.85em;
        color: #6b7280;
    }
    .customer-amount {
        font-weight: 700;
        color: #1f2937;
    }
    .pagination {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid #e5e7eb;
    }
    .page-info {
        color: #6b7280;
    }
</style>

@code {
    private string adminActionReason = "";
    private string reportType = "all";
    private DateTime fromDate = DateTime.Now.AddDays(-30);
    private DateTime toDate = DateTime.Now;
    private string selectedBranch = "";

    private int totalTransactions = 2547;
    private decimal totalVolume = 125000000;
    private decimal averageAmount = 49078;
    private decimal feeRevenue = 185000;

    private List<TypeSummary> typeSummary = new()
    {
        new() { Type = "Deposit", Count = 856, TotalAmount = 52000000, Percentage = 42, AverageAmount = 60748 },
        new() { Type = "Withdrawal", Count = 723, TotalAmount = 38000000, Percentage = 30, AverageAmount = 52558 },
        new() { Type = "Transfer", Count = 456, TotalAmount = 18000000, Percentage = 14, AverageAmount = 39474 },
        new() { Type = "Loan Disbursement", Count = 89, TotalAmount = 12000000, Percentage = 10, AverageAmount = 134831 },
        new() { Type = "Loan Payment", Count = 423, TotalAmount = 5000000, Percentage = 4, AverageAmount = 11820 }
    };

    private List<DailyData> dailyTrend = new()
    {
        new() { Date = DateTime.Now.AddDays(-6), Volume = 4500000 },
        new() { Date = DateTime.Now.AddDays(-5), Volume = 3800000 },
        new() { Date = DateTime.Now.AddDays(-4), Volume = 5200000 },
        new() { Date = DateTime.Now.AddDays(-3), Volume = 4100000 },
        new() { Date = DateTime.Now.AddDays(-2), Volume = 6100000 },
        new() { Date = DateTime.Now.AddDays(-1), Volume = 4800000 },
        new() { Date = DateTime.Now, Volume = 3500000 }
    };

    private List<TopCustomer> topCustomers = new()
    {
        new() { Rank = 1, Name = "ABC Corporation", TransactionCount = 145, TotalVolume = 8500000 },
        new() { Rank = 2, Name = "XYZ Enterprises", TransactionCount = 98, TotalVolume = 5200000 },
        new() { Rank = 3, Name = "Global Trading Co.", TransactionCount = 87, TotalVolume = 4100000 },
        new() { Rank = 4, Name = "Metro Services Inc.", TransactionCount = 76, TotalVolume = 3800000 },
        new() { Rank = 5, Name = "Prime Industries", TransactionCount = 65, TotalVolume = 2900000 }
    };

    private List<TransactionDetail> transactions = new()
    {
        new() { Date = DateTime.Now, Reference = "TXN-2024-0001", Type = "Deposit", CustomerName = "Juan Dela Cruz", AccountNumber = "SAV-001234", Amount = 50000, Fee = 0, Status = "Completed" },
        new() { Date = DateTime.Now, Reference = "TXN-2024-0002", Type = "Withdrawal", CustomerName = "Maria Santos", AccountNumber = "SAV-002345", Amount = 25000, Fee = 25, Status = "Completed" },
        new() { Date = DateTime.Now, Reference = "TXN-2024-0003", Type = "Transfer", CustomerName = "Pedro Reyes", AccountNumber = "SAV-003456", Amount = 15000, Fee = 50, Status = "Completed" },
        new() { Date = DateTime.Now.AddDays(-1), Reference = "TXN-2024-0004", Type = "Deposit", CustomerName = "Ana Garcia", AccountNumber = "SAV-004567", Amount = 100000, Fee = 0, Status = "Completed" },
        new() { Date = DateTime.Now.AddDays(-1), Reference = "TXN-2024-0005", Type = "Loan", CustomerName = "Jose Rizal", AccountNumber = "LN-005678", Amount = 200000, Fee = 500, Status = "Completed" }
    };

    protected override void OnInitialized()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
        }
    }

    private void GenerateReport() { }
    private void ExportReport() { }

    private class TypeSummary
    {
        public string Type { get; set; } = "";
        public int Count { get; set; }
        public decimal TotalAmount { get; set; }
        public int Percentage { get; set; }
        public decimal AverageAmount { get; set; }
    }

    private class DailyData
    {
        public DateTime Date { get; set; }
        public decimal Volume { get; set; }
    }

    private class TopCustomer
    {
        public int Rank { get; set; }
        public string Name { get; set; } = "";
        public int TransactionCount { get; set; }
        public decimal TotalVolume { get; set; }
    }

    private class TransactionDetail
    {
        public DateTime Date { get; set; }
        public string Reference { get; set; } = "";
        public string Type { get; set; } = "";
        public string CustomerName { get; set; } = "";
        public string AccountNumber { get; set; } = "";
        public decimal Amount { get; set; }
        public decimal Fee { get; set; }
        public string Status { get; set; } = "";
    }
}
