@page "/admin/accountant/transaction-reports"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@using Microsoft.EntityFrameworkCore
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IDbContextFactory<BFASDbContext> DbContextFactory

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #059669 0%, #047857 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
            <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
        </div>
        <div>
            <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Transaction Reports</h1>
            <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Generate and analyze transaction reports</p>
        </div>
    </div>
</div>

<!-- Admin Notice -->
<div style="background: #fef3c7; border: 1px solid #f59e0b; border-radius: 12px; padding: 16px; margin-bottom: 24px; display: flex; align-items: center; gap: 12px;">
    <svg width="20" height="20" fill="none" stroke="#d97706" stroke-width="2" viewBox="0 0 24 24">
        <path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
    </svg>
    <span style="color: #92400e; font-size: 14px;">You are accessing Accountant functions as SuperAdmin. All actions are logged.</span>
</div>

<!-- Report Filters -->
<div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb; margin-bottom: 24px;">
    <div style="display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-end;">
        <div style="flex: 1; min-width: 150px;">
            <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Report Type</label>
            <select @bind="reportType" style="width: 100%; padding: 10px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px;">
                <option value="all">All Transactions</option>
                <option value="deposits">Deposits</option>
                <option value="withdrawals">Withdrawals</option>
                <option value="transfers">Transfers</option>
                <option value="loans">Loan Transactions</option>
            </select>
        </div>
        <div style="flex: 1; min-width: 150px;">
            <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">From Date</label>
            <input type="date" @bind="fromDate" style="width: 100%; padding: 10px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px;" />
        </div>
        <div style="flex: 1; min-width: 150px;">
            <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">To Date</label>
            <input type="date" @bind="toDate" style="width: 100%; padding: 10px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px;" />
        </div>
        <div style="flex: 1; min-width: 150px;">
            <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Branch</label>
            <select @bind="selectedBranch" style="width: 100%; padding: 10px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px;">
                <option value="">All Branches</option>
                <option value="main">Main Branch</option>
                <option value="north">North Branch</option>
                <option value="south">South Branch</option>
            </select>
        </div>
        <div style="display: flex; gap: 8px;">
            <button @onclick="GenerateReport" style="background: linear-gradient(135deg, #059669, #047857); color: white; padding: 10px 20px; border: none; border-radius: 8px; font-weight: 600; cursor: pointer;">
                Generate Report
            </button>
            <button @onclick="ExportReport" style="background: white; color: #059669; padding: 10px 20px; border: 2px solid #059669; border-radius: 8px; font-weight: 600; cursor: pointer;">
                Export
            </button>
        </div>
    </div>
</div>

<!-- Summary Stats -->
<div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 24px;">
    <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb; text-align: center;">
        <div style="font-size: 13px; font-weight: 500; color: #6b7280; margin-bottom: 8px;">Total Transactions</div>
        <div style="font-size: 28px; font-weight: 700; color: #111827;">@totalTransactions.ToString("N0")</div>
    </div>
    <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb; text-align: center;">
        <div style="font-size: 13px; font-weight: 500; color: #6b7280; margin-bottom: 8px;">Total Volume</div>
        <div style="font-size: 28px; font-weight: 700; color: #111827;">₱@totalVolume.ToString("N0")</div>
    </div>
    <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb; text-align: center;">
        <div style="font-size: 13px; font-weight: 500; color: #6b7280; margin-bottom: 8px;">Average Amount</div>
        <div style="font-size: 28px; font-weight: 700; color: #111827;">₱@averageAmount.ToString("N0")</div>
    </div>
    <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb; text-align: center;">
        <div style="font-size: 13px; font-weight: 500; color: #6b7280; margin-bottom: 8px;">Fee Revenue</div>
        <div style="font-size: 28px; font-weight: 700; color: #10b981;">₱@feeRevenue.ToString("N0")</div>
    </div>
</div>

<!-- Transaction Summary by Type -->
<div style="background: white; border-radius: 16px; border: 1px solid #e5e7eb; margin-bottom: 24px; overflow: hidden;">
    <div style="background: linear-gradient(135deg, #059669 0%, #047857 100%); padding: 16px 24px;">
        <h3 style="font-size: 16px; font-weight: 700; color: white; margin: 0;">Transaction Summary by Type</h3>
    </div>
    <div style="padding: 24px;">
        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background: #f9fafb;">
                    <th style="padding: 12px 16px; text-align: left; font-size: 13px; font-weight: 600; color: #374151; border-bottom: 1px solid #e5e7eb;">Transaction Type</th>
                    <th style="padding: 12px 16px; text-align: right; font-size: 13px; font-weight: 600; color: #374151; border-bottom: 1px solid #e5e7eb;">Count</th>
                    <th style="padding: 12px 16px; text-align: right; font-size: 13px; font-weight: 600; color: #374151; border-bottom: 1px solid #e5e7eb;">Total Amount</th>
                    <th style="padding: 12px 16px; text-align: left; font-size: 13px; font-weight: 600; color: #374151; border-bottom: 1px solid #e5e7eb;">% of Total</th>
                    <th style="padding: 12px 16px; text-align: right; font-size: 13px; font-weight: 600; color: #374151; border-bottom: 1px solid #e5e7eb;">Avg. Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var summary in typeSummary)
                {
                    <tr style="border-bottom: 1px solid #e5e7eb;">
                        <td style="padding: 12px 16px;">
                            <span style="padding: 4px 12px; border-radius: 6px; font-size: 13px; font-weight: 500; background: @GetTypeBgColor(summary.Type); color: @GetTypeTextColor(summary.Type);">@summary.Type</span>
                        </td>
                        <td style="padding: 12px 16px; text-align: right; font-size: 14px; color: #374151;">@summary.Count.ToString("N0")</td>
                        <td style="padding: 12px 16px; text-align: right; font-size: 14px; font-weight: 600; color: #111827;">₱@summary.TotalAmount.ToString("N0")</td>
                        <td style="padding: 12px 16px;">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <div style="flex: 1; height: 8px; background: #e5e7eb; border-radius: 4px; max-width: 100px;">
                                    <div style="height: 100%; width: @summary.Percentage%; background: #059669; border-radius: 4px;"></div>
                                </div>
                                <span style="font-size: 13px; color: #6b7280;">@summary.Percentage%</span>
                            </div>
                        </td>
                        <td style="padding: 12px 16px; text-align: right; font-size: 14px; color: #374151;">₱@summary.AverageAmount.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Charts Section -->
<div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; margin-bottom: 24px;">
    <!-- Daily Trend -->
    <div style="background: white; border-radius: 16px; border: 1px solid #e5e7eb; overflow: hidden;">
        <div style="background: linear-gradient(135deg, #059669 0%, #047857 100%); padding: 16px 24px;">
            <h3 style="font-size: 16px; font-weight: 700; color: white; margin: 0;">Daily Trend</h3>
        </div>
        <div style="padding: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-end; height: 150px;">
                @foreach (var day in dailyTrend)
                {
                    <div style="display: flex; flex-direction: column; align-items: center; gap: 8px;">
                        <div style="width: 20px; height: @(day.Volume / 50000)px; background: linear-gradient(180deg, #059669, #047857); border-radius: 4px 4px 0 0; min-height: 4px;" title="₱@day.Volume.ToString("N0")"></div>
                        <span style="font-size: 12px; color: #6b7280;">@day.Date.ToString("dd")</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Top Customers -->
    <div style="background: white; border-radius: 16px; border: 1px solid #e5e7eb; overflow: hidden;">
        <div style="background: linear-gradient(135deg, #059669 0%, #047857 100%); padding: 16px 24px;">
            <h3 style="font-size: 16px; font-weight: 700; color: white; margin: 0;">Top Customers by Volume</h3>
        </div>
        <div style="padding: 24px;">
            <div style="display: flex; flex-direction: column; gap: 12px;">
                @foreach (var customer in topCustomers)
                {
                    <div style="display: flex; align-items: center; gap: 12px; padding: 12px; background: #f8fafc; border-radius: 8px;">
                        <div style="width: 32px; height: 32px; background: linear-gradient(135deg, #059669, #047857); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 14px;">@customer.Rank</div>
                        <div style="flex: 1;">
                            <div style="font-size: 14px; font-weight: 600; color: #111827;">@customer.Name</div>
                            <div style="font-size: 12px; color: #6b7280;">@customer.TransactionCount transactions</div>
                        </div>
                        <div style="font-size: 14px; font-weight: 700; color: #111827;">₱@customer.TotalVolume.ToString("N0")</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Transaction Details Table -->
<div style="background: white; border-radius: 16px; border: 1px solid #e5e7eb; overflow: hidden;">
    <div style="background: linear-gradient(135deg, #059669 0%, #047857 100%); padding: 16px 24px;">
        <h3 style="font-size: 16px; font-weight: 700; color: white; margin: 0;">Transaction Details</h3>
    </div>
    <div style="padding: 24px;">
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="background: #f9fafb;">
                        <th style="padding: 12px 16px; text-align: left; font-size: 13px; font-weight: 600; color: #374151; border-bottom: 1px solid #e5e7eb;">Date</th>
                        <th style="padding: 12px 16px; text-align: left; font-size: 13px; font-weight: 600; color: #374151; border-bottom: 1px solid #e5e7eb;">Reference</th>
                        <th style="padding: 12px 16px; text-align: left; font-size: 13px; font-weight: 600; color: #374151; border-bottom: 1px solid #e5e7eb;">Type</th>
                        <th style="padding: 12px 16px; text-align: left; font-size: 13px; font-weight: 600; color: #374151; border-bottom: 1px solid #e5e7eb;">Customer</th>
                        <th style="padding: 12px 16px; text-align: left; font-size: 13px; font-weight: 600; color: #374151; border-bottom: 1px solid #e5e7eb;">Account</th>
                        <th style="padding: 12px 16px; text-align: right; font-size: 13px; font-weight: 600; color: #374151; border-bottom: 1px solid #e5e7eb;">Amount</th>
                        <th style="padding: 12px 16px; text-align: right; font-size: 13px; font-weight: 600; color: #374151; border-bottom: 1px solid #e5e7eb;">Fee</th>
                        <th style="padding: 12px 16px; text-align: center; font-size: 13px; font-weight: 600; color: #374151; border-bottom: 1px solid #e5e7eb;">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tx in transactions)
                    {
                        <tr style="border-bottom: 1px solid #e5e7eb;">
                            <td style="padding: 12px 16px; font-size: 14px; color: #374151;">@tx.Date.ToString("MMM dd, yyyy")</td>
                            <td style="padding: 12px 16px; font-size: 14px; font-weight: 600; color: #111827;">@tx.Reference</td>
                            <td style="padding: 12px 16px;">
                                <span style="padding: 4px 12px; border-radius: 6px; font-size: 12px; font-weight: 500; background: @GetTypeBgColor(tx.Type); color: @GetTypeTextColor(tx.Type);">@tx.Type</span>
                            </td>
                            <td style="padding: 12px 16px; font-size: 14px; color: #374151;">@tx.CustomerName</td>
                            <td style="padding: 12px 16px; font-size: 14px; color: #6b7280;">@tx.AccountNumber</td>
                            <td style="padding: 12px 16px; text-align: right; font-size: 14px; font-weight: 600; color: #111827;">₱@tx.Amount.ToString("N2")</td>
                            <td style="padding: 12px 16px; text-align: right; font-size: 14px; color: #6b7280;">₱@tx.Fee.ToString("N2")</td>
                            <td style="padding: 12px 16px; text-align: center;">
                                <span style="padding: 4px 12px; border-radius: 6px; font-size: 12px; font-weight: 500; background: #dcfce7; color: #166534;">@tx.Status</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div style="display: flex; align-items: center; justify-content: center; gap: 16px; margin-top: 20px; padding-top: 20px; border-top: 1px solid #e5e7eb;">
            <button style="padding: 8px 16px; border: 1px solid #d1d5db; border-radius: 6px; background: white; color: #6b7280; font-size: 13px; cursor: not-allowed;" disabled>Previous</button>
            <span style="font-size: 14px; color: #6b7280;">Page 1 of 10</span>
            <button style="padding: 8px 16px; border: 1px solid #059669; border-radius: 6px; background: white; color: #059669; font-size: 13px; font-weight: 500; cursor: pointer;">Next</button>
        </div>
    </div>
</div>

@code {
    private string adminActionReason = "";
    private string reportType = "all";
    private DateTime fromDate = DateTime.Now.AddDays(-30);
    private DateTime toDate = DateTime.Now;
    private string selectedBranch = "";

    private int totalTransactions = 0;
    private decimal totalVolume = 0;
    private decimal averageAmount = 0;
    private decimal feeRevenue = 0;

    private List<TypeSummary> typeSummary = new();

    private List<DailyData> dailyTrend = new();

    private List<TopCustomer> topCustomers = new();

    private List<TransactionDetail> transactions = new();

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }
        await LoadTransactionReportData();
    }

    private async Task LoadTransactionReportData()
    {
        try
        {
            using var context = await DbContextFactory.CreateDbContextAsync();
            
            // Build query with filters
            var query = context.CustomerTransactions
                .Include(t => t.Account)
                .ThenInclude(a => a.Customer)
                .Where(t => t.CreatedAt >= fromDate && t.CreatedAt <= toDate);
            
            // Filter by type
            if (!string.IsNullOrEmpty(reportType) && reportType != "all")
            {
                var typeFilter = reportType switch
                {
                    "deposits" => "Deposit",
                    "withdrawals" => "Withdrawal",
                    "transfers" => "Transfer",
                    "loans" => "Loan",
                    _ => ""
                };
                if (!string.IsNullOrEmpty(typeFilter))
                {
                    query = query.Where(t => t.TransactionType == typeFilter);
                }
            }
            
            var allTransactions = await query.ToListAsync();
            
            // Calculate summary stats
            totalTransactions = allTransactions.Count;
            totalVolume = allTransactions.Sum(t => t.Amount);
            averageAmount = totalTransactions > 0 ? totalVolume / totalTransactions : 0;
            feeRevenue = allTransactions.Sum(t => t.Fee);
            
            // Type summary
            typeSummary = allTransactions
                .GroupBy(t => t.TransactionType)
                .Select(g => new TypeSummary
                {
                    Type = g.Key,
                    Count = g.Count(),
                    TotalAmount = g.Sum(t => t.Amount),
                    Percentage = totalTransactions > 0 ? (int)((g.Count() * 100.0) / totalTransactions) : 0,
                    AverageAmount = g.Any() ? g.Average(t => t.Amount) : 0
                })
                .OrderByDescending(t => t.TotalAmount)
                .ToList();
            
            // Daily trend (last 7 days)
            dailyTrend = Enumerable.Range(0, 7)
                .Select(i => DateTime.Today.AddDays(-6 + i))
                .Select(date => new DailyData
                {
                    Date = date,
                    Volume = allTransactions.Where(t => t.CreatedAt.Date == date).Sum(t => t.Amount)
                })
                .ToList();
            
            // Top customers
            topCustomers = allTransactions
                .Where(t => t.Account?.Customer != null)
                .GroupBy(t => t.Account!.Customer!.FullName)
                .Select(g => new TopCustomer
                {
                    Name = g.Key,
                    TransactionCount = g.Count(),
                    TotalVolume = g.Sum(t => t.Amount)
                })
                .OrderByDescending(c => c.TotalVolume)
                .Take(5)
                .Select((c, i) => new TopCustomer 
                { 
                    Rank = i + 1, 
                    Name = c.Name, 
                    TransactionCount = c.TransactionCount, 
                    TotalVolume = c.TotalVolume 
                })
                .ToList();
            
            // Transaction details (recent 20)
            transactions = allTransactions
                .OrderByDescending(t => t.CreatedAt)
                .Take(20)
                .Select(t => new TransactionDetail
                {
                    Date = t.CreatedAt,
                    Reference = t.Reference ?? t.TransactionNumber,
                    Type = t.TransactionType,
                    CustomerName = t.Account?.Customer?.FullName ?? "N/A",
                    AccountNumber = t.Account?.AccountNumber ?? "N/A",
                    Amount = t.Amount,
                    Fee = t.Fee,
                    Status = t.Status
                })
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading transaction report data: {ex.Message}");
        }
    }

    private string GetTypeBgColor(string type) => type.ToLower() switch
    {
        "deposit" => "#dcfce7",
        "withdrawal" => "#fee2e2",
        "transfer" => "#dbeafe",
        "loan" or "loan disbursement" => "#fef3c7",
        "loan payment" => "#e0e7ff",
        _ => "#f3f4f6"
    };

    private string GetTypeTextColor(string type) => type.ToLower() switch
    {
        "deposit" => "#166534",
        "withdrawal" => "#991b1b",
        "transfer" => "#1e40af",
        "loan" or "loan disbursement" => "#92400e",
        "loan payment" => "#4f46e5",
        _ => "#374151"
    };

    private async Task GenerateReport() 
    { 
        await LoadTransactionReportData();
    }
    
    private void ExportReport() { }

    private class TypeSummary
    {
        public string Type { get; set; } = "";
        public int Count { get; set; }
        public decimal TotalAmount { get; set; }
        public int Percentage { get; set; }
        public decimal AverageAmount { get; set; }
    }

    private class DailyData
    {
        public DateTime Date { get; set; }
        public decimal Volume { get; set; }
    }

    private class TopCustomer
    {
        public int Rank { get; set; }
        public string Name { get; set; } = "";
        public int TransactionCount { get; set; }
        public decimal TotalVolume { get; set; }
    }

    private class TransactionDetail
    {
        public DateTime Date { get; set; }
        public string Reference { get; set; } = "";
        public string Type { get; set; } = "";
        public string CustomerName { get; set; } = "";
        public string AccountNumber { get; set; } = "";
        public decimal Amount { get; set; }
        public decimal Fee { get; set; }
        public string Status { get; set; } = "";
    }
}
