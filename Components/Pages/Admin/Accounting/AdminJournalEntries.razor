@page "/admin/accounting/journal-entries"
@page "/admin/accountant/journal-entries"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@inject AuthService AuthService
@inject JournalEntryService JournalEntryService

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #059669 0%, #047857 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
                <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M12 2c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12 6.477 2 12 2z"/>
                    <path d="M12 6v6l4 2" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>
            <div>
                <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Journal Entries (Admin)</h1>
                <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Manage accounting journal entries - SuperAdmin Access</p>
            </div>
        </div>
        <div style="display: flex; gap: 12px;">
            <button class="btn" 
                    style="background: rgba(255,255,255,0.2); color: white; padding: 10px 18px; border-radius: 8px; font-size: 14px; font-weight: 600; border: 1px solid rgba(255,255,255,0.3);"
                    @onclick="ToggleShowAutoGenerated">
                @(showAutoGenerated ? "📋 Manual Only" : "🔄 Show All Transactions")
            </button>
            <button class="btn" 
                    style="background: white; color: #059669; padding: 10px 18px; border-radius: 8px; font-size: 14px; font-weight: 600;"
                    @onclick="OpenModal">
                ✏️ New Entry
            </button>
        </div>
    </div>
</div>

<!-- Admin Notice -->
<div style="background: #fef3c7; border: 1px solid #f59e0b; border-radius: 12px; padding: 16px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 12px;">
        <span style="font-size: 24px;">⚠️</span>
        <div>
            <p style="margin: 0; font-weight: 600; color: #92400e;">Administrative Accounting Access</p>
            <p style="margin: 4px 0 0; font-size: 13px; color: #a16207;">All journal entries created here will be tagged with admin reason for audit purposes.</p>
        </div>
    </div>
</div>

<!-- Summary Cards -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 24px;">
    <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb; border-left: 4px solid #059669;">
        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 16px;">
            <div>
                <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 4px;">📋 TOTAL ENTRIES</div>
                <div style="font-size: 28px; font-weight: 800; color: #059669;">@(depositCount + withdrawalCount + loanPaymentCount + loanDisbursalCount)</div>
            </div>
            <div style="width: 44px; height: 44px; background: #f0fdf4; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px;">📑</div>
        </div>
        <div style="font-size: 12px; color: #6b7280;">₱@((depositAmount + withdrawalAmount + loanPaymentAmount + loanDisbursalAmount).ToString("N2"))</div>
    </div>
    <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb; border-left: 4px solid #3b82f6;">
        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 16px;">
            <div>
                <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 4px;">💰 DEPOSITS</div>
                <div style="font-size: 28px; font-weight: 800; color: #3b82f6;">@depositCount</div>
            </div>
            <div style="width: 44px; height: 44px; background: #dbeafe; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px;">💵</div>
        </div>
        <div style="font-size: 12px; color: #6b7280;">₱@depositAmount.ToString("N2")</div>
    </div>
    <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb; border-left: 4px solid #f59e0b;">
        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 16px;">
            <div>
                <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 4px;">🏧 WITHDRAWALS</div>
                <div style="font-size: 28px; font-weight: 800; color: #f59e0b;">@withdrawalCount</div>
            </div>
            <div style="width: 44px; height: 44px; background: #fef3c7; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px;">🏧</div>
        </div>
        <div style="font-size: 12px; color: #6b7280;">₱@withdrawalAmount.ToString("N2")</div>
    </div>
    <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb; border-left: 4px solid #8b5cf6;">
        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 16px;">
            <div>
                <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 4px;">📈 LOAN PAYMENTS</div>
                <div style="font-size: 28px; font-weight: 800; color: #8b5cf6;">@loanPaymentCount</div>
            </div>
            <div style="width: 44px; height: 44px; background: #ede9fe; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px;">📈</div>
        </div>
        <div style="font-size: 12px; color: #6b7280;">₱@loanPaymentAmount.ToString("N2")</div>
    </div>
</div>

<!-- Journal Entries Table -->
<div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
    <h3 style="margin: 0 0 20px; font-size: 18px; font-weight: 700; color: #1f2937;">Recent Journal Entries</h3>
    
    @if (isLoading)
    {
        <div style="padding: 40px; text-align: center; color: #6b7280;">
            <p>Loading journal entries...</p>
        </div>
    }
    else if (journalEntries.Any())
    {
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="border-bottom: 2px solid #e5e7eb; background: #f9fafb;">
                        <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">DATE</th>
                        <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">REFERENCE</th>
                        <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">DESCRIPTION</th>
                        <th style="padding: 12px; text-align: right; font-size: 12px; font-weight: 700; color: #6b7280;">DEBIT</th>
                        <th style="padding: 12px; text-align: right; font-size: 12px; font-weight: 700; color: #6b7280;">CREDIT</th>
                        <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">STATUS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in journalEntries.Take(20))
                    {
                        <tr style="border-bottom: 1px solid #e5e7eb;">
                            <td style="padding: 14px 12px; font-size: 13px; color: #6b7280;">@entry.Date.ToString("MM/dd/yyyy")</td>
                            <td style="padding: 14px 12px; font-weight: 600;">@entry.Reference</td>
                            <td style="padding: 14px 12px;">@entry.Description</td>
                            <td style="padding: 14px 12px; text-align: right; font-weight: 600; color: #059669;">₱@entry.DebitAmount.ToString("N2")</td>
                            <td style="padding: 14px 12px; text-align: right; font-weight: 600; color: #dc2626;">₱@entry.CreditAmount.ToString("N2")</td>
                            <td style="padding: 14px 12px;">
                                <span style="padding: 4px 10px; background: @(entry.IsPosted ? "#d1fae5" : "#fef3c7"); color: @(entry.IsPosted ? "#065f46" : "#92400e"); border-radius: 6px; font-size: 12px; font-weight: 600;">
                                    @(entry.IsPosted ? "Posted" : "Pending")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div style="padding: 40px; text-align: center; color: #6b7280;">
            <p style="margin: 0; font-size: 14px;">No journal entries found.</p>
        </div>
    }
</div>

<!-- Create/Edit Modal -->
@if (showModal)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000;" @onclick="CloseModal">
        <div style="background: white; border-radius: 12px; padding: 24px; width: 90%; max-width: 700px; max-height: 90vh; overflow-y: auto;" @onclick:stopPropagation="true">
            <h2 style="font-size: 18px; font-weight: 700; margin-bottom: 20px;">@(isEditing ? "Edit Journal Entry" : "New Journal Entry (Admin)")</h2>
            
            <!-- Admin Reason Field -->
            <div style="background: #fef3c7; border: 2px solid #f59e0b; border-radius: 8px; padding: 16px; margin-bottom: 20px;">
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px; color: #92400e;">
                    ⚠️ Reason for Admin Action (Required) *
                </label>
                <textarea style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 6px; font-size: 14px; min-height: 60px;" 
                          @bind="adminReason" placeholder="Enter the reason for creating this journal entry as SuperAdmin..."></textarea>
            </div>

            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-bottom: 16px;">
                <div>
                    <label style="font-size: 12px; font-weight: 600; color: #6b7280;">Date</label>
                    <input type="date" @bind="formData.TransactionDate" style="width: 100%; padding: 8px; border: 1px solid #e5e7eb; border-radius: 6px;" />
                </div>
                <div>
                    <label style="font-size: 12px; font-weight: 600; color: #6b7280;">Reference</label>
                    <input type="text" @bind="formData.Reference" placeholder="REF-001" style="width: 100%; padding: 8px; border: 1px solid #e5e7eb; border-radius: 6px;" />
                </div>
            </div>

            <div style="margin-bottom: 16px;">
                <label style="font-size: 12px; font-weight: 600; color: #6b7280;">Description</label>
                <input type="text" @bind="formData.Description" placeholder="Entry description" style="width: 100%; padding: 8px; border: 1px solid #e5e7eb; border-radius: 6px;" />
            </div>

            <div style="margin-bottom: 16px;">
                <h3 style="font-size: 14px; font-weight: 600; margin-bottom: 12px;">Line Items</h3>
                <table style="width: 100%; border-collapse: collapse; margin-bottom: 12px;">
                    <thead>
                        <tr style="background: #f9fafb; border-bottom: 1px solid #e5e7eb;">
                            <th style="padding: 8px; text-align: left; font-size: 12px;">Account Code</th>
                            <th style="padding: 8px; text-align: right; font-size: 12px;">Debit</th>
                            <th style="padding: 8px; text-align: right; font-size: 12px;">Credit</th>
                            <th style="padding: 8px; text-align: center; font-size: 12px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in lineItems)
                        {
                            <tr style="border-bottom: 1px solid #e5e7eb;">
                                <td style="padding: 8px;">@line.AccountCode</td>
                                <td style="padding: 8px; text-align: right;">@line.DebitAmount.ToString("N2")</td>
                                <td style="padding: 8px; text-align: right;">@line.CreditAmount.ToString("N2")</td>
                                <td style="padding: 8px; text-align: center;">
                                    <button class="btn" style="background: #f3f4f6; color: #111827; padding: 4px 8px; font-size: 12px; border: none; cursor: pointer; border-radius: 4px;" @onclick="() => RemoveLine(line)">Remove</button>
                                </td>
                            </tr>
                        }
                        <tr style="background: #f9fafb; border-bottom: 1px solid #e5e7eb;">
                            <td style="padding: 8px;"><input type="text" @bind="newLine.AccountCode" placeholder="ACC-001" style="width: 100%; padding: 6px; border: 1px solid #e5e7eb; border-radius: 4px;" /></td>
                            <td style="padding: 8px;"><input type="number" @bind="newLine.DebitAmount" step="0.01" placeholder="0.00" style="width: 100%; padding: 6px; border: 1px solid #e5e7eb; border-radius: 4px; text-align: right;" /></td>
                            <td style="padding: 8px;"><input type="number" @bind="newLine.CreditAmount" step="0.01" placeholder="0.00" style="width: 100%; padding: 6px; border: 1px solid #e5e7eb; border-radius: 4px; text-align: right;" /></td>
                            <td style="padding: 8px; text-align: center;">
                                <button class="btn" style="background: #3b82f6; color: white; padding: 4px 8px; font-size: 12px; border: none; cursor: pointer; border-radius: 4px;" @onclick="AddLineItem">Add</button>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div style="display: flex; justify-content: flex-end; gap: 24px; padding: 12px; background: #f9fafb; border-radius: 6px;">
                    <div><strong>Debit Total:</strong> ₱@lineItems.Sum(l => l.DebitAmount).ToString("N2")</div>
                    <div><strong>Credit Total:</strong> ₱@lineItems.Sum(l => l.CreditAmount).ToString("N2")</div>
                    <div style="color: @(IsBalanced() ? "#10b981" : "#ef4444");"><strong>@(IsBalanced() ? "✓ Balanced" : "✗ Out of Balance")</strong></div>
                </div>
            </div>

            <div style="display: flex; gap: 12px; justify-content: flex-end;">
                <button class="btn" style="background: #e5e7eb; color: #111827; padding: 10px 18px; border-radius: 8px; font-weight: 600; border: none; cursor: pointer;" @onclick="CloseModal">Cancel</button>
                <button class="btn" style="background: #059669; color: white; padding: 10px 18px; border-radius: 8px; font-weight: 600; border: none; cursor: pointer;" @onclick="SaveEntry" disabled="@(!IsBalanced() || string.IsNullOrEmpty(adminReason))">
                    @(isEditing ? "Update" : "Create") Entry
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool showModal = false;
    private bool isEditing = false;
    private bool showAutoGenerated = true;
    private string adminReason = "";
    
    // Summary counts
    private int depositCount = 0;
    private int withdrawalCount = 0;
    private int loanPaymentCount = 0;
    private int loanDisbursalCount = 0;
    private decimal depositAmount = 0;
    private decimal withdrawalAmount = 0;
    private decimal loanPaymentAmount = 0;
    private decimal loanDisbursalAmount = 0;
    private int postedThisMonth = 0;
    
    private List<JournalEntryViewModel> journalEntries = new();
    
    private class JournalEntryViewModel
    {
        public int Id { get; set; }
        public DateTime Date { get; set; }
        public string Reference { get; set; } = "";
        public string Description { get; set; } = "";
        public decimal DebitAmount { get; set; }
        public decimal CreditAmount { get; set; }
        public bool IsPosted { get; set; }
    }
    
    private class FormDataModel
    {
        public DateTime TransactionDate { get; set; } = DateTime.Today;
        public string Reference { get; set; } = "";
        public string Description { get; set; } = "";
    }
    
    private class LineItemModel
    {
        public string AccountCode { get; set; } = "";
        public decimal DebitAmount { get; set; }
        public decimal CreditAmount { get; set; }
    }
    
    private FormDataModel formData = new();
    private List<LineItemModel> lineItems = new();
    private LineItemModel newLine = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var entries = await JournalEntryService.GetAllWithTransactionsAsync();
            journalEntries = entries.Select(e => new JournalEntryViewModel
            {
                Id = e.JournalId,
                Date = e.TransactionDate,
                Reference = e.Reference ?? "",
                Description = e.Description ?? "",
                DebitAmount = e.TotalDebit,
                CreditAmount = e.TotalCredit,
                IsPosted = e.Status == "Posted"
            }).ToList();
            
            // Load stats using the service method
            await LoadTransactionStats();
            
            postedThisMonth = entries.Count(e => e.Status == "Posted" && e.TransactionDate.Month == DateTime.Today.Month);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
    
    private async Task LoadTransactionStats()
    {
        try
        {
            var stats = await JournalEntryService.GetTransactionStatsAsync();
            depositCount = stats.TotalDeposits;
            depositAmount = stats.DepositAmount;
            withdrawalCount = stats.TotalWithdrawals;
            withdrawalAmount = stats.WithdrawalAmount;
            loanPaymentCount = stats.TotalLoanPayments;
            loanPaymentAmount = stats.LoanPaymentAmount;
            loanDisbursalCount = stats.TotalLoanDisbursals;
            loanDisbursalAmount = stats.LoanDisbursalAmount;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading stats: {ex.Message}");
        }
    }

    private void ToggleShowAutoGenerated()
    {
        showAutoGenerated = !showAutoGenerated;
    }

    private void OpenModal()
    {
        showModal = true;
        isEditing = false;
        formData = new FormDataModel { TransactionDate = DateTime.Today };
        lineItems.Clear();
        adminReason = "";
    }

    private void CloseModal()
    {
        showModal = false;
        adminReason = "";
    }

    private void AddLineItem()
    {
        if (!string.IsNullOrEmpty(newLine.AccountCode) && (newLine.DebitAmount > 0 || newLine.CreditAmount > 0))
        {
            lineItems.Add(new LineItemModel
            {
                AccountCode = newLine.AccountCode,
                DebitAmount = newLine.DebitAmount,
                CreditAmount = newLine.CreditAmount
            });
            newLine = new LineItemModel();
        }
    }

    private void RemoveLine(LineItemModel line)
    {
        lineItems.Remove(line);
    }

    private bool IsBalanced()
    {
        var totalDebit = lineItems.Sum(l => l.DebitAmount);
        var totalCredit = lineItems.Sum(l => l.CreditAmount);
        return totalDebit == totalCredit && totalDebit > 0;
    }

    private async Task SaveEntry()
    {
        if (!IsBalanced() || string.IsNullOrEmpty(adminReason))
            return;

        try
        {
            // Add admin reason to description
            var adminDescription = $"[ADMIN: {AuthService.CurrentUser}] {formData.Description} | Reason: {adminReason}";
            
            // Create journal entry object
            var journalEntry = new JournalEntry
            {
                TransactionDate = formData.TransactionDate,
                Reference = formData.Reference,
                Description = adminDescription,
                TotalDebit = lineItems.Sum(l => l.DebitAmount),
                TotalCredit = lineItems.Sum(l => l.CreditAmount),
                Status = "Draft",
                CreatedBy = AuthService.CurrentUser ?? "admin",
                Lines = lineItems.Select(l => new JournalEntryLine
                {
                    AccountCode = l.AccountCode,
                    DebitAmount = l.DebitAmount,
                    CreditAmount = l.CreditAmount
                }).ToList()
            };
            
            await JournalEntryService.CreateAsync(journalEntry);
            
            CloseModal();
            await LoadData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving entry: {ex.Message}");
        }
    }
}
