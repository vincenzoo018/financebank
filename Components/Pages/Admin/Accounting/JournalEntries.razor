@page "/admin/accounting/journal-entries"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@inject JournalEntryService Service

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
    <h2 style="font-weight:700;">Journal Entries</h2>
    <button class="btn" style="background:#10b981; color:white;" @onclick="ShowCreate">New Entry</button>
</div>

@if (showCreate)
{
    <div style="position:fixed; inset:0; background:rgba(0,0,0,0.4); display:flex; align-items:center; justify-content:center;" @onclick="HideCreate">
        <div style="background:white; border-radius:12px; padding:16px; width:800px;" @onclick:stopPropagation="true">
            <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:12px;">
                <InputDate @bind-Value="draftDate" />
                <input class="form-control" placeholder="Reference" @bind="draft.Reference" />
                <input class="form-control" placeholder="Description" @bind="draft.Description" />
            </div>
            <div style="margin-top:12px;">
                <table style="width:100%; border-collapse:collapse;">
                    <thead>
                        <tr style="border-bottom:1px solid var(--border); background:#f9fafb;">
                            <th style="padding:8px; text-align:left;">Code</th>
                            <th style="padding:8px; text-align:left;">Account</th>
                            <th style="padding:8px; text-align:right;">Debit</th>
                            <th style="padding:8px; text-align:right;">Credit</th>
                            <th style="padding:8px; text-align:center;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in lines)
                        {
                            <tr style="border-bottom:1px solid var(--border);">
                                <td style="padding:8px;">@l.AccountCode</td>
                                <td style="padding:8px;">@l.AccountName</td>
                                <td style="padding:8px; text-align:right;">@l.DebitAmount.ToString("N2")</td>
                                <td style="padding:8px; text-align:right;">@l.CreditAmount.ToString("N2")</td>
                                <td style="padding:8px; text-align:center;">
                                    <button class="btn" style="background:#f3f4f6;" @onclick="() => RemoveLine(l)">Remove</button>
                                </td>
                            </tr>
                        }
                        <tr>
                            <td style="padding:8px;"><input class="form-control" placeholder="Code" @bind="lineCode" /></td>
                            <td style="padding:8px;"><input class="form-control" placeholder="Account" @bind="lineName" /></td>
                            <td style="padding:8px;"><input class="form-control" type="number" @bind-value="lineDebit" /></td>
                            <td style="padding:8px;"><input class="form-control" type="number" @bind-value="lineCredit" /></td>
                            <td style="padding:8px; text-align:center;"><button class="btn" style="background:#3b82f6; color:white;" @onclick="AddLine">Add</button></td>
                        </tr>
                    </tbody>
                </table>
                <div style="display:flex; justify-content:flex-end; gap:16px; margin-top:8px;">
                    <div>Debit: @lines.Sum(x=>x.DebitAmount).ToString("N2")</div>
                    <div>Credit: @lines.Sum(x=>x.CreditAmount).ToString("N2")</div>
                </div>
            </div>
            <div style="display:flex; gap:8px; justify-content:flex-end; margin-top:12px;">
                <button class="btn" style="background:#10b981; color:white;" @onclick="Create">Save</button>
                <button class="btn" style="background:#f3f4f6;" @onclick="HideCreate">Cancel</button>
            </div>
        </div>
    </div>
}

<div style="background:white; border:1px solid var(--border); border-radius:12px;">
    <table style="width:100%; border-collapse:collapse;">
        <thead>
            <tr style="border-bottom:1px solid var(--border); background:#f9fafb;">
                <th style="padding:12px; text-align:left;">Number</th>
                <th style="padding:12px; text-align:left;">Date</th>
                <th style="padding:12px; text-align:right;">Debit</th>
                <th style="padding:12px; text-align:right;">Credit</th>
                <th style="padding:12px; text-align:left;">Status</th>
                <th style="padding:12px; text-align:center;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in items)
            {
                <tr style="border-bottom:1px solid var(--border);">
                    <td style="padding:12px;">@e.JournalNumber</td>
                    <td style="padding:12px;">@e.TransactionDate.ToString("yyyy-MM-dd")</td>
                    <td style="padding:12px; text-align:right;">@e.TotalDebit.ToString("N2")</td>
                    <td style="padding:12px; text-align:right;">@e.TotalCredit.ToString("N2")</td>
                    <td style="padding:12px;">@e.Status</td>
                    <td style="padding:12px; text-align:center;">
                        <button class="btn" style="background:#3b82f6; color:white; padding:6px 12px;" disabled="@(e.Status=="Posted")" @onclick="() => Post(e.JournalId)">Post</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<JournalEntry> items = new();
    private bool showCreate;
    private JournalEntry draft = new();
    private List<JournalEntryLine> lines = new();
    private DateTime draftDate = DateTime.Today;
    private string lineCode = string.Empty;
    private string lineName = string.Empty;
    private decimal lineDebit = 0;
    private decimal lineCredit = 0;

    protected override async Task OnInitializedAsync()
    {
        items = await Service.GetAllAsync();
    }

    private void ShowCreate()
    {
        draft = new JournalEntry { TransactionDate = DateTime.Today, Description = string.Empty, Status = "Draft" };
        lines = new List<JournalEntryLine>();
        showCreate = true;
    }

    private void HideCreate()
    {
        showCreate = false;
    }

    private void AddLine()
    {
        lines.Add(new JournalEntryLine { AccountCode = lineCode, AccountName = lineName, DebitAmount = lineDebit, CreditAmount = lineCredit });
        lineCode = string.Empty; lineName = string.Empty; lineDebit = 0; lineCredit = 0;
    }

    private void RemoveLine(JournalEntryLine l)
    {
        lines.Remove(l);
    }

    private async Task Create()
    {
        draft.TransactionDate = draftDate;
        draft.TotalDebit = lines.Sum(x => x.DebitAmount);
        draft.TotalCredit = lines.Sum(x => x.CreditAmount);
        draft.Lines = lines;
        var created = await Service.CreateAsync(draft);
        items.Insert(0, created);
        showCreate = false;
    }

    private async Task Post(int id)
    {
        var ok = await Service.PostAsync(id, "accountant");
        if (ok)
        {
            var idx = items.FindIndex(x => x.JournalId == id);
            if (idx >= 0) items[idx].Status = "Posted";
            StateHasChanged();
        }
    }
}

