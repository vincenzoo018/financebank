@page "/admin/accounting/financial-statements"
@layout AdminLayout
@inject FinancialStatementService FinancialStatementService

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
            <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
        </div>
        <div>
            <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Financial Statements</h1>
            <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Income statement, balance sheet, cash flow</p>
        </div>
    </div>
</div>

<!-- Action Bar -->
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <div style="display: flex; gap: 12px;">
        <button class="btn" style="background: #7c3aed; color: white; padding: 12px 24px; font-weight: 600;" @onclick='() => ShowStatementModal("IncomeStatement")'>
            📈 Income Statement
        </button>
        <button class="btn" style="background: #7c3aed; color: white; padding: 12px 24px; font-weight: 600;" @onclick='() => ShowStatementModal("BalanceSheet")'>
            📊 Balance Sheet
        </button>
        <button class="btn" style="background: #7c3aed; color: white; padding: 12px 24px; font-weight: 600;" @onclick='() => ShowStatementModal("CashFlow")'>
            💵 Cash Flow
        </button>
    </div>
</div>

<!-- Financial Statements Table -->
<div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid var(--border);">
    <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 20px;">Generated Statements</h3>

    <table style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr style="border-bottom: 2px solid var(--border); background: #f9fafb;">
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">STATEMENT TYPE</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">PERIOD</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">GENERATED AT</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">GENERATED BY</th>
                <th style="padding: 12px; text-align: center; font-size: 12px; font-weight: 700;">ACTIONS</th>
            </tr>
        </thead>
        <tbody>
            @if (statements == null || statements.Count == 0)
            {
                <tr>
                    <td colspan="5" style="padding: 16px; text-align: center; color: #6b7280; font-size: 14px;">No financial statements generated yet.</td>
                </tr>
            }
            else
            {
                @foreach (var stmt in statements)
                {
                    <tr style="border-bottom: 1px solid var(--border); transition: background 0.2s;">
                        <td style="padding: 16px; font-weight: 600;">@stmt.StatementType</td>
                        <td style="padding: 16px;">@stmt.PeriodStart.ToString("MMM yyyy") - @stmt.PeriodEnd.ToString("MMM yyyy")</td>
                        <td style="padding: 16px; font-size: 14px;">@stmt.GeneratedAt.ToString("MMM dd, yyyy HH:mm")</td>
                        <td style="padding: 16px;">@stmt.GeneratedBy</td>
                        <td style="padding: 16px; text-align: center;">
                            <button class="btn" style="background: white; border: 2px solid #e5e7eb; color: #374151; padding: 6px 12px; font-size: 13px;">
                                👁️ View
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- Generate Statement Modal -->
<div style="display: @(showStatementModal ? "flex" : "none"); position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000;">
    <div style="background: white; border-radius: 16px; padding: 32px; max-width: 500px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
        <h2 style="font-size: 20px; font-weight: 700; margin: 0 0 24px 0;">📄 Generate @selectedStatement</h2>
        
        <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label">Period Start</label>
            <input type="date" class="form-control" @bind="genStmt_PeriodStart" />
        </div>
        
        <div class="form-group" style="margin-bottom: 24px;">
            <label class="form-label">Period End</label>
            <input type="date" class="form-control" @bind="genStmt_PeriodEnd" />
        </div>
        
        <div style="display: flex; gap: 12px; justify-content: flex-end;">
            <button class="btn" style="background: #e5e7eb; color: #374151; padding: 10px 20px; font-weight: 600;" @onclick="CloseStatementModal">Cancel</button>
            <button class="btn" style="background: #7c3aed; color: white; padding: 10px 20px; font-weight: 600;" @onclick="GenerateStatement">Generate</button>
        </div>
    </div>
</div>

@code {
    private List<FinanceBank.Models.FinancialStatement> statements = new();
    private bool showStatementModal = false;
    private string selectedStatement = "";
    private DateTime genStmt_PeriodStart = DateTime.Today.AddMonths(-1);
    private DateTime genStmt_PeriodEnd = DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            statements = await FinancialStatementService.GetAllAsync();
        }
        catch
        {
        }
    }

    private void ShowStatementModal(string type) 
    { 
        selectedStatement = type; 
        showStatementModal = true; 
    }

    private void CloseStatementModal() => showStatementModal = false;

    private async Task GenerateStatement()
    {
        if (string.IsNullOrWhiteSpace(selectedStatement))
        {
            return;
        }

        var newStatement = new FinanceBank.Models.FinancialStatement
        {
            StatementType = selectedStatement,
            PeriodStart = genStmt_PeriodStart,
            PeriodEnd = genStmt_PeriodEnd,
            GeneratedBy = "Admin",
            Data = "{}"
        };

        try
        {
            await FinancialStatementService.CreateAsync(newStatement);
            statements = await FinancialStatementService.GetAllAsync();
            CloseStatementModal();
        }
        catch
        {
        }
    }
}

