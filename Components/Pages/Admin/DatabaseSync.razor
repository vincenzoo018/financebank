@code {
    private bool localConnected = false;
    private bool cloudConnected = false;
    private bool isChecking = false;
    private bool isSyncing = false;
    private string syncDirection = "";
    private string currentProgress = "";
    private DatabaseStats? stats;
    private SyncResult? lastResult;
    private List<LogEntry> syncLogs = new();
    
    // Auto-sync state
    private bool autoSyncEnabled = true;
    private string autoSyncStatus = "";
    
    // Dual-write state (saves to BOTH databases simultaneously)
    private bool dualWriteEnabled = true;

    protected override async Task OnInitializedAsync()
    {
        // Initialize dual-write state from BFASDbContext
        dualWriteEnabled = BFASDbContext.DualWriteEnabled;
        
        // Subscribe to sync status events
        SyncService.SyncStatusChanged += OnSyncStatusChanged;
        
        await CheckConnections();
    }

    private void OnSyncStatusChanged(object? sender, SyncStatusEventArgs e)
    {
        autoSyncStatus = e.Status;
        if (e.LastSyncTime.HasValue)
        {
            autoSyncStatus = $"{e.Status} at {e.LastSyncTime.Value:HH:mm:ss}";
        }
        InvokeAsync(StateHasChanged);
    }

    private void ToggleDualWrite()
    {
        dualWriteEnabled = !dualWriteEnabled;
        BFASDbContext.DualWriteEnabled = dualWriteEnabled;
        
        if (dualWriteEnabled)
        {
            AddLog("🔄 DUAL-WRITE ENABLED - All changes will be saved to BOTH LOCAL and CLOUD databases", "success");
        }
        else
        {
            AddLog("⚠️ DUAL-WRITE DISABLED - Changes will only be saved to LOCAL database", "warning");
        }
        
        StateHasChanged();
    }

    private void ToggleAutoSync()
    {
        autoSyncEnabled = !autoSyncEnabled;
        
        if (autoSyncEnabled)
        {
            SyncService.StartAutoSync();
            AddLog("Auto-sync enabled - data will sync automatically when internet is available", "success");
        }
        else
        {
            SyncService.StopAutoSync();
            AddLog("Auto-sync disabled - use manual sync buttons to sync data", "info");
        }
        
        StateHasChanged();
    }

    public void Dispose()
    {
        SyncService.SyncStatusChanged -= OnSyncStatusChanged;
    }

    private async Task CheckConnections()
    {
        isChecking = true;
        StateHasChanged();

        AddLog("Checking database connections...", "info");

        var (local, cloud) = await SyncService.CheckAllConnectionsAsync();
        localConnected = local;
        cloudConnected = cloud;

        AddLog($"LOCAL: {(local ? "Connected" : "Disconnected")}", local ? "success" : "error");
        AddLog($"CLOUD: {(cloud ? "Connected" : "Disconnected")}", cloud ? "success" : "error");

        if (local && cloud)
        {
            AddLog("Fetching database statistics...", "info");
            stats = await SyncService.GetDatabaseStatsAsync();
            AddLog("Statistics loaded successfully", "success");
        }

        isChecking = false;
        StateHasChanged();
    }

    private async Task SyncLocalToCloud()
    {
        isSyncing = true;
        syncDirection = "LOCAL_TO_CLOUD";
        currentProgress = "Starting sync...";
        StateHasChanged();

        AddLog("Starting LOCAL → CLOUD sync...", "info");

        var progress = new Progress<string>(msg =>
        {
            currentProgress = msg;
            AddLog(msg, "info");
            InvokeAsync(StateHasChanged);
        });

        lastResult = await SyncService.SyncLocalToCloudAsync(progress);

        if (lastResult.Success)
        {
            AddLog($"Sync completed! {lastResult.InsertedRecords} records synced.", "success");
            await RefreshStats();
        }
        else
        {
            AddLog($"Sync failed: {lastResult.ErrorMessage}", "error");
        }

        isSyncing = false;
        currentProgress = "";
        StateHasChanged();
    }

    private async Task SyncCloudToLocal()
    {
        isSyncing = true;
        syncDirection = "CLOUD_TO_LOCAL";
        currentProgress = "Starting sync...";
        StateHasChanged();

        AddLog("Starting CLOUD → LOCAL sync...", "info");

        var progress = new Progress<string>(msg =>
        {
            currentProgress = msg;
            AddLog(msg, "info");
            InvokeAsync(StateHasChanged);
        });

        lastResult = await SyncService.SyncCloudToLocalAsync(progress);

        if (lastResult.Success)
        {
            AddLog($"Sync completed! {lastResult.InsertedRecords} records synced.", "success");
            await RefreshStats();
        }
        else
        {
            AddLog($"Sync failed: {lastResult.ErrorMessage}", "error");
        }

        isSyncing = false;
        currentProgress = "";
        StateHasChanged();
    }

    private async Task SyncBidirectional()
    {
        isSyncing = true;
        syncDirection = "BIDIRECTIONAL";
        currentProgress = "Starting two-way sync...";
        StateHasChanged();

        AddLog("Starting BIDIRECTIONAL sync...", "info");

        var progress = new Progress<string>(msg =>
        {
            currentProgress = msg;
            AddLog(msg, "info");
            InvokeAsync(StateHasChanged);
        });

        lastResult = await SyncService.SyncBidirectionalAsync(progress);

        if (lastResult.Success)
        {
            AddLog($"Bidirectional sync completed! {lastResult.InsertedRecords} records synced.", "success");
            await RefreshStats();
        }
        else
        {
            AddLog($"Sync failed: {lastResult.ErrorMessage}", "error");
        }

        isSyncing = false;
        currentProgress = "";
        StateHasChanged();
    }

    private async Task RefreshStats()
    {
        stats = await SyncService.GetDatabaseStatsAsync();
    }

    private void AddLog(string message, string type)
    {
        syncLogs.Add(new LogEntry { Time = DateTime.Now, Message = message, Type = type });
    }

    private string GetDiffClass(int diff)
    {
        if (diff > 0) return "positive";
        if (diff < 0) return "negative";
        return "neutral";
    }

    private string GetDiffString(int diff)
    {
        if (diff > 0) return $"+{diff}";
        if (diff < 0) return diff.ToString();
        return "=";
    }

    private string GetLogClass(LogEntry log)
    {
        return log.Type;
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/admin/dashboard");
    }

    private class LogEntry
    {
        public DateTime Time { get; set; }
        public string Message { get; set; } = "";
        public string Type { get; set; } = "info";
    }
}
