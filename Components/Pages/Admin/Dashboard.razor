        try
        {
            using var context = await DbContextFactory.CreateDbContextAsync();
            var today = DateTime.Today;
            var startOfMonth = new DateTime(today.Year, today.Month, 1);

            // ===== User Stats =====
            totalUsers = await context.Users.CountAsync();
            activeUsers = await context.Users.CountAsync(u => u.IsActive);
            totalCustomers = await context.Users.CountAsync(u => u.Role == "Customer");
            totalEmployees = await context.Employees.CountAsync();
            totalAccounts = await context.CustomerAccounts.CountAsync();

            // Pending approvals (transactions + loans pending)
            var pendingTxns = await context.CustomerTransactions.CountAsync(t => t.Status == "Pending");
            var pendingLoans = await context.LoanApplications.CountAsync(l => l.Status == "Pending" || l.Status == "PENDING" ||
            l.Status == "FOR_REVIEW");
            pendingApprovals = pendingTxns + pendingLoans;

            // ===== Teller Analytics =====
            var depositsToday = await context.CustomerTransactions
            .Where(t => t.TransactionType == "Deposit" && t.CreatedAt.Date == today && t.Status == "Completed")
            .ToListAsync();
            totalDepositsToday = depositsToday.Sum(t => t.Amount);
            depositCountToday = depositsToday.Count;

            var withdrawalsToday = await context.CustomerTransactions
            .Where(t => t.TransactionType == "Withdrawal" && t.CreatedAt.Date == today && t.Status == "Completed")
            .ToListAsync();
            totalWithdrawalsToday = withdrawalsToday.Sum(t => t.Amount);
            withdrawalCountToday = withdrawalsToday.Count;

            loanPaymentsToday = await context.LoanPayments
            .Where(p => p.PaymentDate.Date == today)
            .SumAsync(p => (decimal?)p.PaymentAmount) ?? 0;

            netCashFlow = totalDepositsToday + loanPaymentsToday - totalWithdrawalsToday;

            // ===== Teller Operations Analytics (Full Dashboard Data) =====
            tellerDepositsTotal = totalDepositsToday;
            tellerDepositsCount = depositCountToday;
            tellerWithdrawalsTotal = totalWithdrawalsToday;
            tellerWithdrawalsCount = withdrawalCountToday;

            // Loan Payments
            var loanPaymentsData = await context.LoanPayments
            .Where(p => p.PaymentDate.Date == today)
            .ToListAsync();
            tellerLoanPaymentsTotal = loanPaymentsData.Sum(p => p.PaymentAmount);
            tellerLoanPaymentsCount = loanPaymentsData.Count;

            // Loan Disbursements
            var loanDisbursementsData = await context.LoanDisbursals
            .Where(d => d.DisbursalDate.Date == today)
            .ToListAsync();
            tellerLoanDisbursementsTotal = loanDisbursementsData.Sum(d => d.DisbursalAmount);
            tellerLoanDisbursementsCount = loanDisbursementsData.Count;

            // Net Cash Flow & Fees
            tellerNetCashFlow = tellerDepositsTotal + tellerLoanPaymentsTotal - tellerWithdrawalsTotal -
            tellerLoanDisbursementsTotal;

            var depositFees = depositsToday.Sum(t => t.Fee);
            var withdrawalFees = withdrawalsToday.Sum(t => t.Fee);
            var penaltiesCollected = loanPaymentsData.Sum(p => p.PenaltyPaid);
            tellerFeeIncome = depositFees + withdrawalFees + penaltiesCollected;

            // ===== Accountant Analytics =====
            totalAccountBalance = await context.CustomerAccounts.SumAsync(a => (decimal?)a.Balance) ?? 0;

            monthlyDeposits = await context.CustomerTransactions
            .Where(t => t.TransactionType == "Deposit" && t.CreatedAt >= startOfMonth && t.Status == "Completed")
            .SumAsync(t => (decimal?)t.Amount) ?? 0;

            journalEntriesCount = await context.CustomerTransactions
            .Where(t => t.CreatedAt >= startOfMonth)
            .CountAsync();

            accountingPendingReviews = await context.LoanApplications
            .CountAsync(l => l.Status == "FOR_REVIEW" || l.Status == "PENDING_ASSESSMENT");

            // Extended Accountant Analytics
            // Journal Entries from JournalEntries table
            var journalEntries = await context.JournalEntries
            .Where(j => j.TransactionDate >= startOfMonth)
            .ToListAsync();
            postedJournalEntries = journalEntries.Count(j => j.Status == "Posted");
            pendingJournalEntries = journalEntries.Count(j => j.Status == "Draft" || j.Status == "Pending");
            totalDebits = journalEntries.Sum(j => j.TotalDebit);
            totalCredits = journalEntries.Sum(j => j.TotalCredit);

            // Interest Batches pending
            var interestBatches = await context.SavingsInterestPostings
            .Where(s => s.PostingStatus == "Pending" || s.PostingStatus == "FMApproved")
            .ToListAsync();
            interestPostingsPending = interestBatches.Count;
            interestBatchesPending = interestBatches.Count;
            interestBatchesAmount = interestBatches.Sum(s => s.TotalInterestPosted);

            // Trial Balance Status
            trialBalanceStatus = (totalDebits == totalCredits && totalDebits > 0) ? "Balanced" : "Not Balanced";

            // Financial Statements
            financialStatementsCount = await context.FinancialStatements
            .Where(f => f.GeneratedAt >= startOfMonth)
            .CountAsync();

            // Financial Statements Generated Today
            financialStatementsGenerated = await context.FinancialStatements
            .Where(f => f.GeneratedAt >= today)
            .CountAsync();

            // Chart of Accounts
            chartOfAccountsCount = await context.ChartOfAccounts.CountAsync();

            // ===== Finance Manager Analytics =====
            var assessments = await context.LoanAssessments
            .Where(l => l.AssessmentStatus == "FORWARDED" || l.AssessmentStatus == "ASSESSED")
            .ToListAsync();
            activeLoans = assessments.Count;
            totalLoanAmount = assessments.Sum(l => l.LoanAmount);

            pendingLoanApplications = await context.LoanApplications
            .CountAsync(l => l.Status == "Pending" || l.Status == "PENDING" || l.Status == "SUBMITTED" || l.Status == "VERIFIED");

            loanDisbursedToday = await context.LoanAssessments
            .Where(l => l.AssessmentDate.Date == today)
            .SumAsync(l => (decimal?)l.LoanAmount) ?? 0;

            // Calculate interest earned (simplified - using loan payments)
            interestEarnedMonth = await context.LoanPayments
            .Where(p => p.PaymentDate >= startOfMonth)
            .SumAsync(p => (decimal?)p.PenaltyPaid) ?? 0;

            // Today's transactions count
            todayTransactions = await context.CustomerTransactions.CountAsync(t => t.CreatedAt.Date == today);

            // ===== Recent Activity =====
            var recentTxns = await context.CustomerTransactions
            .OrderByDescending(t => t.CreatedAt)
            .Take(5)
            .Select(t => new { t.TransactionType, t.Amount, t.CreatedAt, t.AccountId })
            .ToListAsync();

            recentActivities = recentTxns.Select(t => new ActivityItem
            {
                Type = t.TransactionType ?? "Transaction",
                Description = $"{t.TransactionType}: ₱{t.Amount:N2}",
                User = $"Account #{t.AccountId}",
                Time = t.CreatedAt
            }).ToList();

            // ===== Calculate System Health =====
            CalculateSystemHealth();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard: {ex.Message}");
            recentActivities = new List<ActivityItem>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

