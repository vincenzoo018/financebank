    }

    private string GetHealthTitle()
    {
        if (systemHealth >= 90) return "System Status: Excellent";
        if (systemHealth >= 75) return "System Status: Healthy";
        if (systemHealth >= 60) return "System Status: Stable";
        if (systemHealth >= 40) return "Warning: System Needs Attention";
        return "Critical: Immediate Action Required";
    }

    private string GetHealthMessage()
    {
        if (systemHealth >= 90)
            return $"Banking operations are running smoothly. Liquidity ratio at {liquidityRatio:F2} with strong cash reserves.";
        if (systemHealth >= 75)
            return $"System is performing well. Current liquidity ratio: {liquidityRatio:F2}. Continue monitoring key metrics.";
        if (systemHealth >= 60)
            return $"System is stable but watch cash flow closely. Liquidity ratio: {liquidityRatio:F2}. Review pending approvals.";
        if (systemHealth >= 40)
            return $"Low liquidity detected ({liquidityRatio:F2}). Increase cash reserves and reduce outstanding loans to avoid risk.";
        return $"Critical liquidity shortage ({liquidityRatio:F2})! Bank may face insolvency. Immediate intervention required to prevent bankruptcy.";
    }

    private void CalculateSystemHealth()
    {
        // Calculate Liquidity Ratio (Current Assets / Current Liabilities)
        // Simplified: Total Account Balance / Total Loan Amount
        if (totalLoanAmount > 0)
        {
            liquidityRatio = totalAccountBalance / totalLoanAmount;
        }
        else
        {
            liquidityRatio = totalAccountBalance > 0 ? 10.0m : 0m; // No loans = very liquid
        }

        // Calculate Asset Growth (compare current to baseline)
        assetGrowth = totalAccountBalance > 0 ? ((totalAccountBalance - totalLoanAmount) / totalAccountBalance) * 100 : 0;

        // Calculate Cash Reserve Ratio
        cashReserveRatio = totalAccountBalance > 0 ? (netCashFlow / totalAccountBalance) * 100 : 0;

        // Calculate Loan Performance (active vs pending)
        var totalLoanCount = activeLoans + pendingLoanApplications;
        loanPerformanceRatio = totalLoanCount > 0 ? ((decimal)activeLoans / totalLoanCount) * 100 : 100m;

        // Calculate System Health Score (0-100)
        int liquidityScore = liquidityRatio >= 2.0m ? 40 : liquidityRatio >= 1.5m ? 35 : liquidityRatio >= 1.0m ? 25 :
        liquidityRatio >= 0.5m ? 15 : 5;
        int cashFlowScore = netCashFlow > 0 ? 30 : netCashFlow > -100000 ? 20 : netCashFlow > -500000 ? 10 : 5;
        int loanScore = loanPerformanceRatio >= 80 ? 20 : loanPerformanceRatio >= 60 ? 15 : loanPerformanceRatio >= 40 ? 10 : 5;
        int approvalScore = pendingApprovals <= 5 ? 10 : pendingApprovals <= 15 ? 8 : pendingApprovals <= 30 ? 5 : 2;

        systemHealth = liquidityScore + cashFlowScore + loanScore + approvalScore;
        systemHealth = Math.Max(0, Math.Min(100, systemHealth)); // Clamp between 0-100
    }

    // ===== Chart Helper Methods =====

    private List<DateTime> GetLast7Days()
    {
        var days = new List<DateTime>();
        for (int i = 6; i >= 0; i--)
        {
            days.Add(DateTime.Today.AddDays(-i));
        }
        return days;
    }

    private decimal GetDayDeposits(DateTime day)
    {
        // In a real implementation, this would query the database
        // For now, return sample data based on the day
        using var context = DbContextFactory.CreateDbContext();
        return context.CustomerTransactions
        .Where(t => t.TransactionType == "Deposit" && t.CreatedAt.Date == day && t.Status == "Completed")
        .Sum(t => (decimal?)t.Amount) ?? 0;
    }

    private decimal GetDayWithdrawals(DateTime day)
    {
        using var context = DbContextFactory.CreateDbContext();
        return context.CustomerTransactions
        .Where(t => t.TransactionType == "Withdrawal" && t.CreatedAt.Date == day && t.Status == "Completed")
        .Sum(t => (decimal?)t.Amount) ?? 0;
    }

    private decimal GetMaxDayAmount()
    {
        var days = GetLast7Days();
        decimal max = 0;
        foreach (var day in days)
        {
            var deposits = GetDayDeposits(day);
            var withdrawals = GetDayWithdrawals(day);
            max = Math.Max(max, Math.Max(deposits, withdrawals));
        }
        return max > 0 ? max : 100000; // Default minimum for chart scaling
    }

    private int GetDepartmentPercentage(string department)
    {
        var totalActivity = depositCountToday + withdrawalCountToday + journalEntriesCount + pendingLoanApplications +
        pendingApprovals;
        if (totalActivity == 0) return 0;

        return department switch
        {
            "teller" => (int)((depositCountToday + withdrawalCountToday) * 100.0 / totalActivity),
            "accountant" => (int)(journalEntriesCount * 100.0 / totalActivity),
            "finance" => (int)(pendingLoanApplications * 100.0 / totalActivity),
            "admin" => (int)(pendingApprovals * 100.0 / totalActivity),
            _ => 0
        };
    }

