@page "/admin/asset-history"
@layout AdminLayout
@using FinanceBank.Models
@using FinanceBank.Services
@using FinanceBank.Data
@using Microsoft.EntityFrameworkCore
@inject AssetMarketplaceService AssetService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IDbContextFactory<BFASDbContext> DbContextFactory

<div class="sidebar-content">
    <div class="card">
        <div class="card-header" style="background: linear-gradient(135deg, #6366f1, #8b5cf6); color: white; padding: 20px;">
            <h4 style="margin: 0; font-weight: 600;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px; vertical-align: middle;">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                Asset Application History
            </h4>
            <p style="margin: 8px 0 0 0; opacity: 0.9; font-size: 14px;">Complete audit trail of forwarded and released asset applications with contracts</p>
        </div>

        <div class="card-body" style="padding: 24px;">
            <!-- Filter Section -->
            <div style="background: #f8fafc; padding: 20px; border-radius: 12px; margin-bottom: 24px;">
                <h6 style="margin: 0 0 16px 0; color: #374151; font-weight: 600;">🔍 Filter History</h6>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px;">
                    <div>
                        <label style="font-size: 13px; color: #6b7280; display: block; margin-bottom: 4px;">Action Type</label>
                        <select @bind="filterActionType" style="width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px;">
                            <option value="">All Actions</option>
                            <option value="FORWARDED_TO_ACCOUNTANT">📤 Forwarded to Accountant</option>
                            <option value="FORWARDED_TO_FINANCEMANAGER">📤 Forwarded to Finance Manager</option>
                            <option value="APPROVED">✅ Approved</option>
                            <option value="RELEASED">🎉 Released</option>
                            <option value="REJECTED">❌ Rejected</option>
                        </select>
                    </div>
                    <div>
                        <label style="font-size: 13px; color: #6b7280; display: block; margin-bottom: 4px;">From Date</label>
                        <input type="date" @bind="filterFromDate" style="width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px;" />
                    </div>
                    <div>
                        <label style="font-size: 13px; color: #6b7280; display: block; margin-bottom: 4px;">To Date</label>
                        <input type="date" @bind="filterToDate" style="width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px;" />
                    </div>
                    <div>
                        <label style="font-size: 13px; color: #6b7280; display: block; margin-bottom: 4px;">Search User</label>
                        <input type="text" @bind="filterUser" placeholder="Username..." style="width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px;" />
                    </div>
                </div>
                <div style="margin-top: 16px; display: flex; gap: 12px;">
                    <button @onclick="ApplyFilters" style="padding: 10px 24px; background: #6366f1; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 600;">
                        Apply Filters
                    </button>
                    <button @onclick="ClearFilters" style="padding: 10px 24px; background: #e5e7eb; color: #374151; border: none; border-radius: 8px; cursor: pointer; font-weight: 600;">
                        Clear
                    </button>
                </div>
            </div>

            <!-- Statistics Cards -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 24px;">
                <div style="background: linear-gradient(135deg, #dbeafe, #bfdbfe); padding: 20px; border-radius: 12px; text-align: center;">
                    <div style="font-size: 28px; font-weight: 700; color: #1e40af;">@forwardedToAccountantCount</div>
                    <div style="font-size: 13px; color: #3b82f6;">📤 Forwarded to Accountant</div>
                </div>
                <div style="background: linear-gradient(135deg, #fef3c7, #fde68a); padding: 20px; border-radius: 12px; text-align: center;">
                    <div style="font-size: 28px; font-weight: 700; color: #92400e;">@forwardedToFMCount</div>
                    <div style="font-size: 13px; color: #f59e0b;">📤 Forwarded to FM</div>
                </div>
                <div style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); padding: 20px; border-radius: 12px; text-align: center;">
                    <div style="font-size: 28px; font-weight: 700; color: #065f46;">@approvedCount</div>
                    <div style="font-size: 13px; color: #059669;">✅ Approved</div>
                </div>
                <div style="background: linear-gradient(135deg, #ede9fe, #ddd6fe); padding: 20px; border-radius: 12px; text-align: center;">
                    <div style="font-size: 28px; font-weight: 700; color: #5b21b6;">@releasedCount</div>
                    <div style="font-size: 13px; color: #8b5cf6;">🎉 Released</div>
                </div>
                <div style="background: linear-gradient(135deg, #fee2e2, #fecaca); padding: 20px; border-radius: 12px; text-align: center;">
                    <div style="font-size: 28px; font-weight: 700; color: #991b1b;">@rejectedCount</div>
                    <div style="font-size: 13px; color: #ef4444;">❌ Rejected</div>
                </div>
            </div>

            @if (isLoading)
            {
                <div style="text-align: center; padding: 40px;">
                    <div style="width: 40px; height: 40px; border: 3px solid #e5e7eb; border-top-color: #6366f1; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto;"></div>
                    <p style="margin-top: 16px; color: #6b7280;">Loading history...</p>
                </div>
            }
            else if (historyList == null || historyList.Count == 0)
            {
                <div style="text-align: center; padding: 60px 20px; background: #f9fafb; border-radius: 12px;">
                    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5" style="margin: 0 auto;">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <h5 style="color: #6b7280; margin-top: 16px;">No History Found</h5>
                    <p style="color: #9ca3af; font-size: 14px;">No workflow events match your filters.</p>
                </div>
            }
            else
            {
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="background: #f9fafb; border-bottom: 2px solid #e5e7eb;">
                                <th style="padding: 12px; text-align: left; font-weight: 600; color: #374151;">Date/Time</th>
                                <th style="padding: 12px; text-align: left; font-weight: 600; color: #374151;">Application</th>
                                <th style="padding: 12px; text-align: left; font-weight: 600; color: #374151;">Asset</th>
                                <th style="padding: 12px; text-align: center; font-weight: 600; color: #374151;">Action</th>
                                <th style="padding: 12px; text-align: left; font-weight: 600; color: #374151;">Performed By</th>
                                <th style="padding: 12px; text-align: left; font-weight: 600; color: #374151;">Contract</th>
                                <th style="padding: 12px; text-align: right; font-weight: 600; color: #374151;">Amount</th>
                                <th style="padding: 12px; text-align: center; font-weight: 600; color: #374151;">Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var history in historyList)
                            {
                                <tr style="border-bottom: 1px solid #e5e7eb; transition: background 0.2s;" class="table-row-hover">
                                    <td style="padding: 16px 12px;">
                                        <div style="font-weight: 600; color: #374151;">@history.ActionDate.ToString("MMM dd, yyyy")</div>
                                        <div style="font-size: 12px; color: #6b7280;">@history.ActionDate.ToString("hh:mm tt")</div>
                                    </td>
                                    <td style="padding: 16px 12px;">
                                        <span style="background: #dbeafe; color: #1e40af; padding: 4px 12px; border-radius: 20px; font-weight: 600; font-size: 12px;">
                                            @history.Application?.ApplicationNumber
                                        </span>
                                    </td>
                                    <td style="padding: 16px 12px;">
                                        <div style="font-weight: 600; color: #374151;">@(history.Application?.Asset?.DisplayTitle ?? "N/A")</div>
                                        <div style="font-size: 12px; color: #6b7280;">@history.Application?.Asset?.AssetType</div>
                                    </td>
                                    <td style="padding: 16px 12px; text-align: center;">
                                        @{
                                            var (actionColor, actionBg, actionIcon) = GetActionStyle(history.ActionType);
                                        }
                                        <span style="background: @actionBg; color: @actionColor; padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 600;">
                                            @actionIcon @GetActionLabel(history.ActionType)
                                        </span>
                                    </td>
                                    <td style="padding: 16px 12px;">
                                        <div style="font-weight: 600; color: #374151;">@history.ActionBy</div>
                                        <div style="font-size: 12px; color: #6b7280;">@history.ActionByRole</div>
                                    </td>
                                    <td style="padding: 16px 12px;">
                                        @if (!string.IsNullOrEmpty(history.ContractNumber))
                                        {
                                            <div style="font-weight: 600; color: #059669;">@history.ContractNumber</div>
                                            <div style="font-size: 12px; color: #6b7280;">@history.ContractDate?.ToString("MM/dd/yyyy")</div>
                                        }
                                        else
                                        {
                                            <span style="color: #9ca3af; font-size: 12px;">-</span>
                                        }
                                    </td>
                                    <td style="padding: 16px 12px; text-align: right;">
                                        @if (history.AssetPrice > 0)
                                        {
                                            <div style="font-weight: 700; color: #374151;">₱@history.AssetPrice?.ToString("N2")</div>
                                            @if (history.LoanAmount > 0)
                                            {
                                                <div style="font-size: 12px; color: #6b7280;">Loan: ₱@history.LoanAmount?.ToString("N2")</div>
                                            }
                                        }
                                        else
                                        {
                                            <span style="color: #9ca3af;">-</span>
                                        }
                                    </td>
                                    <td style="padding: 16px 12px; text-align: center;">
                                        <button @onclick="() => ShowHistoryDetails(history)" 
                                            style="padding: 8px 16px; background: #6366f1; color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: 500;">
                                            View
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- History Details Modal -->
@if (showDetailsModal && selectedHistory != null)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000;" @onclick="CloseModal">
        <div style="background: white; border-radius: 16px; width: 90%; max-width: 700px; max-height: 90vh; overflow-y: auto; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);" @onclick:stopPropagation>
            <div style="padding: 24px; border-bottom: 1px solid #e5e7eb; background: linear-gradient(135deg, #6366f1, #8b5cf6); border-radius: 16px 16px 0 0;">
                <h4 style="margin: 0; color: white; font-weight: 600;">📜 History Details</h4>
                <p style="margin: 8px 0 0 0; color: rgba(255,255,255,0.9); font-size: 14px;">@selectedHistory.Application?.ApplicationNumber</p>
            </div>
            
            <div style="padding: 24px;">
                <!-- Action Info -->
                <div style="background: #f8fafc; padding: 20px; border-radius: 12px; margin-bottom: 20px;">
                    <h6 style="margin: 0 0 16px 0; color: #374151; font-weight: 600;">Action Information</h6>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                        <div>
                            <label style="font-size: 12px; color: #6b7280; text-transform: uppercase;">Action Type</label>
                            <div style="font-weight: 600; color: #374151; margin-top: 4px;">@GetActionLabel(selectedHistory.ActionType)</div>
                        </div>
                        <div>
                            <label style="font-size: 12px; color: #6b7280; text-transform: uppercase;">Date & Time</label>
                            <div style="font-weight: 600; color: #374151; margin-top: 4px;">@selectedHistory.ActionDate.ToString("MMM dd, yyyy hh:mm tt")</div>
                        </div>
                        <div>
                            <label style="font-size: 12px; color: #6b7280; text-transform: uppercase;">Performed By</label>
                            <div style="font-weight: 600; color: #374151; margin-top: 4px;">@selectedHistory.ActionBy</div>
                        </div>
                        <div>
                            <label style="font-size: 12px; color: #6b7280; text-transform: uppercase;">Role</label>
                            <div style="font-weight: 600; color: #374151; margin-top: 4px;">@selectedHistory.ActionByRole</div>
                        </div>
                        <div>
                            <label style="font-size: 12px; color: #6b7280; text-transform: uppercase;">Previous Status</label>
                            <div style="font-weight: 600; color: #374151; margin-top: 4px;">@(selectedHistory.PreviousStatus ?? "-")</div>
                        </div>
                        <div>
                            <label style="font-size: 12px; color: #6b7280; text-transform: uppercase;">New Status</label>
                            <div style="font-weight: 600; color: #374151; margin-top: 4px;">@(selectedHistory.NewStatus ?? "-")</div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(selectedHistory.Remarks))
                    {
                        <div style="margin-top: 16px;">
                            <label style="font-size: 12px; color: #6b7280; text-transform: uppercase;">Remarks</label>
                            <div style="font-weight: 500; color: #374151; margin-top: 4px; padding: 12px; background: white; border-radius: 8px; border: 1px solid #e5e7eb;">
                                @selectedHistory.Remarks
                            </div>
                        </div>
                    }
                </div>

                <!-- Contract Info (if released) -->
                @if (!string.IsNullOrEmpty(selectedHistory.ContractNumber))
                {
                    <div style="background: #ecfdf5; padding: 20px; border-radius: 12px; margin-bottom: 20px; border: 1px solid #a7f3d0;">
                        <h6 style="margin: 0 0 16px 0; color: #065f46; font-weight: 600;">📄 Contract Information</h6>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                            <div>
                                <label style="font-size: 12px; color: #6b7280; text-transform: uppercase;">Contract Number</label>
                                <div style="font-weight: 700; color: #059669; margin-top: 4px; font-size: 16px;">@selectedHistory.ContractNumber</div>
                            </div>
                            <div>
                                <label style="font-size: 12px; color: #6b7280; text-transform: uppercase;">Contract Date</label>
                                <div style="font-weight: 600; color: #374151; margin-top: 4px;">@selectedHistory.ContractDate?.ToString("MMM dd, yyyy")</div>
                            </div>
                            @if (!string.IsNullOrEmpty(selectedHistory.DeedOfSaleNumber))
                            {
                                <div>
                                    <label style="font-size: 12px; color: #6b7280; text-transform: uppercase;">Deed of Sale</label>
                                    <div style="font-weight: 600; color: #374151; margin-top: 4px;">@selectedHistory.DeedOfSaleNumber</div>
                                </div>
                                <div>
                                    <label style="font-size: 12px; color: #6b7280; text-transform: uppercase;">Deed Date</label>
                                    <div style="font-weight: 600; color: #374151; margin-top: 4px;">@selectedHistory.DeedOfSaleDate?.ToString("MMM dd, yyyy")</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(selectedHistory.ORNumber))
                            {
                                <div>
                                    <label style="font-size: 12px; color: #6b7280; text-transform: uppercase;">OR Number</label>
                                    <div style="font-weight: 600; color: #374151; margin-top: 4px;">@selectedHistory.ORNumber</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(selectedHistory.CRNumber))
                            {
                                <div>
                                    <label style="font-size: 12px; color: #6b7280; text-transform: uppercase;">CR Number</label>
                                    <div style="font-weight: 600; color: #374151; margin-top: 4px;">@selectedHistory.CRNumber</div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Financial Details -->
                @if (selectedHistory.AssetPrice > 0)
                {
                    <div style="background: #fef3c7; padding: 20px; border-radius: 12px; margin-bottom: 20px; border: 1px solid #fde68a;">
                        <h6 style="margin: 0 0 16px 0; color: #92400e; font-weight: 600;">💰 Financial Snapshot</h6>
                        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;">
                            <div>
                                <label style="font-size: 12px; color: #6b7280; text-transform: uppercase;">Asset Price</label>
                                <div style="font-weight: 700; color: #374151; margin-top: 4px;">₱@selectedHistory.AssetPrice?.ToString("N2")</div>
                            </div>
                            <div>
                                <label style="font-size: 12px; color: #6b7280; text-transform: uppercase;">Down Payment</label>
                                <div style="font-weight: 600; color: #374151; margin-top: 4px;">₱@selectedHistory.DownPaymentAmount?.ToString("N2")</div>
                            </div>
                            <div>
                                <label style="font-size: 12px; color: #6b7280; text-transform: uppercase;">Loan Amount</label>
                                <div style="font-weight: 600; color: #374151; margin-top: 4px;">₱@selectedHistory.LoanAmount?.ToString("N2")</div>
                            </div>
                            <div>
                                <label style="font-size: 12px; color: #6b7280; text-transform: uppercase;">Term</label>
                                <div style="font-weight: 600; color: #374151; margin-top: 4px;">@selectedHistory.TermMonths months</div>
                            </div>
                            <div>
                                <label style="font-size: 12px; color: #6b7280; text-transform: uppercase;">Interest Rate</label>
                                <div style="font-weight: 600; color: #374151; margin-top: 4px;">@selectedHistory.InterestRate?.ToString("N2")%</div>
                            </div>
                            <div>
                                <label style="font-size: 12px; color: #6b7280; text-transform: uppercase;">Monthly Payment</label>
                                <div style="font-weight: 700; color: #059669; margin-top: 4px;">₱@selectedHistory.MonthlyPayment?.ToString("N2")</div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Assessment Details (if available) -->
                @if (selectedHistory.DebtToIncomeRatio.HasValue || !string.IsNullOrEmpty(selectedHistory.CreditRiskLevel))
                {
                    <div style="background: #ede9fe; padding: 20px; border-radius: 12px; margin-bottom: 20px; border: 1px solid #ddd6fe;">
                        <h6 style="margin: 0 0 16px 0; color: #5b21b6; font-weight: 600;">📊 Assessment Details</h6>
                        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;">
                            @if (selectedHistory.DebtToIncomeRatio.HasValue)
                            {
                                <div>
                                    <label style="font-size: 12px; color: #6b7280; text-transform: uppercase;">Debt-to-Income</label>
                                    <div style="font-weight: 600; color: #374151; margin-top: 4px;">@selectedHistory.DebtToIncomeRatio?.ToString("N2")%</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(selectedHistory.CreditRiskLevel))
                            {
                                <div>
                                    <label style="font-size: 12px; color: #6b7280; text-transform: uppercase;">Credit Risk</label>
                                    <div style="font-weight: 600; color: @GetRiskColor(selectedHistory.CreditRiskLevel); margin-top: 4px;">@selectedHistory.CreditRiskLevel</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(selectedHistory.Recommendation))
                            {
                                <div>
                                    <label style="font-size: 12px; color: #6b7280; text-transform: uppercase;">Recommendation</label>
                                    <div style="font-weight: 600; color: @(selectedHistory.Recommendation == "APPROVE" ? "#059669" : "#ef4444"); margin-top: 4px;">@selectedHistory.Recommendation</div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (selectedHistory.LinkedLoanId.HasValue)
                {
                    <div style="background: #dbeafe; padding: 16px; border-radius: 12px; text-align: center;">
                        <span style="color: #1e40af; font-weight: 600;">📋 Linked Loan ID: @selectedHistory.LinkedLoanId</span>
                    </div>
                }

                <div style="text-align: right; margin-top: 20px;">
                    <button @onclick="CloseModal" style="padding: 12px 32px; background: #6366f1; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 600;">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .table-row-hover:hover {
        background: #f9fafb;
    }
    
    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

@code {
    private List<FinanceBank.Models.AssetHistory>? historyList;
    private List<FinanceBank.Models.AssetHistory>? allHistory;
    private bool isLoading = true;
    
    // Filter fields
    private string filterActionType = "";
    private DateTime? filterFromDate;
    private DateTime? filterToDate;
    private string filterUser = "";
    
    // Modal
    private bool showDetailsModal = false;
    private FinanceBank.Models.AssetHistory? selectedHistory;
    
    // Statistics
    private int forwardedToAccountantCount => allHistory?.Count(h => h.ActionType == "FORWARDED_TO_ACCOUNTANT") ?? 0;
    private int forwardedToFMCount => allHistory?.Count(h => h.ActionType == "FORWARDED_TO_FINANCEMANAGER") ?? 0;
    private int approvedCount => allHistory?.Count(h => h.ActionType == "APPROVED") ?? 0;
    private int releasedCount => allHistory?.Count(h => h.ActionType == "RELEASED") ?? 0;
    private int rejectedCount => allHistory?.Count(h => h.ActionType == "REJECTED") ?? 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadHistory();
    }

    private async Task LoadHistory()
    {
        isLoading = true;
        try
        {
            allHistory = await AssetService.GetAllHistoryAsync();
            historyList = allHistory;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading history: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApplyFilters()
    {
        isLoading = true;
        try
        {
            historyList = await AssetService.GetAllHistoryAsync(
                filterFromDate, 
                filterToDate, 
                string.IsNullOrEmpty(filterActionType) ? null : filterActionType,
                string.IsNullOrEmpty(filterUser) ? null : filterUser);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ClearFilters()
    {
        filterActionType = "";
        filterFromDate = null;
        filterToDate = null;
        filterUser = "";
        historyList = allHistory;
    }

    private void ShowHistoryDetails(FinanceBank.Models.AssetHistory history)
    {
        selectedHistory = history;
        showDetailsModal = true;
    }

    private void CloseModal()
    {
        showDetailsModal = false;
        selectedHistory = null;
    }

    private (string color, string bg, string icon) GetActionStyle(string actionType)
    {
        return actionType switch
        {
            "FORWARDED_TO_ACCOUNTANT" => ("#1e40af", "#dbeafe", "📤"),
            "FORWARDED_TO_FINANCEMANAGER" => ("#92400e", "#fef3c7", "📤"),
            "APPROVED" => ("#065f46", "#d1fae5", "✅"),
            "RELEASED" => ("#5b21b6", "#ede9fe", "🎉"),
            "REJECTED" => ("#991b1b", "#fee2e2", "❌"),
            "SUBMITTED" => ("#6b7280", "#f3f4f6", "📋"),
            _ => ("#374151", "#f3f4f6", "📄")
        };
    }

    private string GetActionLabel(string actionType)
    {
        return actionType switch
        {
            "FORWARDED_TO_ACCOUNTANT" => "Forwarded to Accountant",
            "FORWARDED_TO_FINANCEMANAGER" => "Forwarded to Finance Manager",
            "APPROVED" => "Approved",
            "RELEASED" => "Released",
            "REJECTED" => "Rejected",
            "SUBMITTED" => "Submitted",
            "CANCELLED" => "Cancelled",
            _ => actionType
        };
    }

    private string GetRiskColor(string? riskLevel)
    {
        return riskLevel?.ToUpper() switch
        {
            "LOW" => "#059669",
            "MEDIUM" => "#f59e0b",
            "HIGH" => "#ef4444",
            _ => "#6b7280"
        };
    }
}
