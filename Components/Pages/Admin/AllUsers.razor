    // Edit Modal Methods
    private void OpenEditModal(AuthUser user)
    {
        // Create a copy to avoid modifying the original until save
        editUser = new AuthUser
        {
            UserId = user.UserId,
            Username = user.Username,
            FullName = user.FullName,
            Email = user.Email,
            Role = user.Role,
            IsActive = user.IsActive,
            PasswordHash = user.PasswordHash,
            CreatedAt = user.CreatedAt,
            ProfilePicture = user.ProfilePicture,
            ProfilePictureContentType = user.ProfilePictureContentType
        };
        editMessage = "";
        editSuccess = false;
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        editUser = null;
        editMessage = "";
    }

    private async Task SaveUserChanges()
    {
        if (editUser == null) return;

        isSaving = true;
        editMessage = "";

        try
        {
            using var context = await DbContextFactory.CreateDbContextAsync();
            var dbUser = await context.Users.FindAsync(editUser.UserId);
            
            if (dbUser != null)
            {
                dbUser.FullName = editUser.FullName;
                dbUser.Email = editUser.Email;
                dbUser.Role = editUser.Role;
                
                await context.SaveChangesAsync();
                
                // Update local list
                var localUser = allUsers.FirstOrDefault(u => u.UserId == editUser.UserId);
                if (localUser != null)
                {
                    localUser.FullName = editUser.FullName;
                    localUser.Email = editUser.Email;
                    localUser.Role = editUser.Role;
                }

                editSuccess = true;
                editMessage = "✓ User updated successfully!";
                
                await Task.Delay(1500);
                CloseEditModal();
            }
            else
            {
                editSuccess = false;
                editMessage = "✗ User not found in database.";
            }
        }
        catch (Exception ex)
        {
            editSuccess = false;
            editMessage = $"✗ Error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    // Deactivate Modal Methods
    private void OpenDeactivateModal(AuthUser user)
    {
        userToDeactivate = user;
        deactivateMessage = "";
        deactivateSuccess = false;
        showDeactivateModal = true;
    }

    private void CloseDeactivateModal()
    {
        showDeactivateModal = false;
        userToDeactivate = null;
        deactivateMessage = "";
    }

    private async Task ConfirmDeactivate()
    {
        if (userToDeactivate == null) return;

        isDeactivating = true;
        deactivateMessage = "";

        try
        {
            using var context = await DbContextFactory.CreateDbContextAsync();
            var dbUser = await context.Users.FindAsync(userToDeactivate.UserId);
            
            if (dbUser != null)
            {
                dbUser.IsActive = false;
                await context.SaveChangesAsync();
                
                // Update local list
                var localUser = allUsers.FirstOrDefault(u => u.UserId == userToDeactivate.UserId);
                if (localUser != null)
                {
                    localUser.IsActive = false;
                }

                deactivateSuccess = true;
                deactivateMessage = "✓ User deactivated successfully!";
                
                await Task.Delay(1500);
                CloseDeactivateModal();
            }
            else
            {
                deactivateSuccess = false;
                deactivateMessage = "✗ User not found in database.";
            }
        }
        catch (Exception ex)
        {
            deactivateSuccess = false;
            deactivateMessage = $"✗ Error: {ex.Message}";
        }
        finally
        {
            isDeactivating = false;
            StateHasChanged();
        }
    }

    private async Task ActivateUser(AuthUser user)
    {
        try
        {
            using var context = await DbContextFactory.CreateDbContextAsync();
            var dbUser = await context.Users.FindAsync(user.UserId);
            
            if (dbUser != null)
            {
                dbUser.IsActive = true;
                await context.SaveChangesAsync();
                
                // Update local list
                var localUser = allUsers.FirstOrDefault(u => u.UserId == user.UserId);
                if (localUser != null)
                {
                    localUser.IsActive = true;
                }
                
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error activating user: {ex.Message}");
        }
    }
