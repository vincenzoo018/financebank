@page "/admin/finance-manager/risk-assessment"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@using Microsoft.EntityFrameworkCore
@inject AuthService AuthService
@inject NotificationService NotificationService
@inject IDbContextFactory<BFASDbContext> DbFactory

<div class="page-container" style="padding: 24px;">
    <!-- Page Header -->
    <div style="background: linear-gradient(135deg, #5F6F52 0%, #2F3E2A 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 16px;">
                <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
                    <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                    </svg>
                </div>
                <div>
                    <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Admin - Risk Assessment</h1>
                    <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Administrative risk management and monitoring</p>
                </div>
            </div>
            <div style="display: flex; gap: 12px;">
                <button @onclick="RefreshData" style="padding: 10px 20px; background: rgba(255,255,255,0.2); border: 1px solid rgba(255,255,255,0.3); border-radius: 8px; color: white; cursor: pointer; font-weight: 600;">
                    🔄 Refresh
                </button>
                <button @onclick="GenerateReport" style="padding: 10px 20px; background: white; color: #5F6F52; border: none; border-radius: 8px; cursor: pointer; font-weight: 600;">
                    📊 Generate Report
                </button>
            </div>
        </div>
    </div>

    <!-- Admin Notice -->
    <div style="background: linear-gradient(135deg, #E5D9B6 0%, #D4C9A8 100%); border: 1px solid #8B5A2B; border-radius: 12px; padding: 16px; margin-bottom: 24px;">
        <div style="display: flex; align-items: center; gap: 12px;">
            <span style="font-size: 24px;">🔐</span>
            <div>
                <p style="font-weight: 600; color: #6B4423; margin: 0;">Administrative Access Mode</p>
                <p style="font-size: 13px; color: #8B5A2B; margin: 4px 0 0 0;">Risk adjustments require justification and audit logging. Admin: @(AuthService.FullName ?? "Admin")</p>
            </div>
        </div>
    </div>

    <!-- Risk Overview Cards -->
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 24px;">
        <div style="background: white; border-radius: 16px; padding: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); border-left: 4px solid @GetRiskColor(overallRisk);">
            <p style="font-size: 13px; color: #6b7280; font-weight: 600; margin: 0;">🎯 Overall Risk Score</p>
            <p style="font-size: 28px; font-weight: 700; color: @GetRiskColor(overallRisk); margin: 8px 0 0 0;">@overallRisk.ToString("N1")</p>
            <p style="font-size: 12px; color: #64748b; margin: 4px 0 0 0;">@GetRiskLevel(overallRisk) Risk Level</p>
        </div>
        <div style="background: white; border-radius: 16px; padding: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); border-left: 4px solid #6B7B5E;">
            <p style="font-size: 13px; color: #6B6B6B; font-weight: 600; margin: 0;">💳 Credit Risk</p>
            <p style="font-size: 28px; font-weight: 700; color: #6B7B5E; margin: 8px 0 0 0;">@creditRisk.ToString("N1")%</p>
            <p style="font-size: 12px; color: #64748b; margin: 4px 0 0 0;">Non-performing loans ratio</p>
        </div>
        <div style="background: white; border-radius: 16px; padding: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); border-left: 4px solid #8B5A2B;">
            <p style="font-size: 13px; color: #6B6B6B; font-weight: 600; margin: 0;">💧 Liquidity Risk</p>
            <p style="font-size: 28px; font-weight: 700; color: #8B5A2B; margin: 8px 0 0 0;">@liquidityRisk.ToString("N1")%</p>
            <p style="font-size: 12px; color: #64748b; margin: 4px 0 0 0;">Liquidity coverage ratio</p>
        </div>
        <div style="background: white; border-radius: 16px; padding: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); border-left: 4px solid #5F6F52;">
            <p style="font-size: 13px; color: #6B6B6B; font-weight: 600; margin: 0;">⚡ Operational Risk</p>
            <p style="font-size: 28px; font-weight: 700; color: #5F6F52; margin: 8px 0 0 0;">@operationalRisk.ToString("N1")%</p>
            <p style="font-size: 12px; color: #64748b; margin: 4px 0 0 0;">System uptime rate</p>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
        <!-- Risk Matrix -->
        <div style="background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden;">
            <div style="background: linear-gradient(135deg, #5F6F52, #2F3E2A); color: white; padding: 20px 24px;">
                <h3 style="font-size: 18px; font-weight: 600; margin: 0;">Risk Categories</h3>
            </div>
            <div style="padding: 24px;">
                @if (isLoading)
                {
                    <div style="display: flex; justify-content: center; padding: 60px;">
                        <div style="width: 48px; height: 48px; border: 4px solid #E2E2DC; border-top-color: #5F6F52; border-radius: 50%; animation: spin 1s linear infinite;"></div>
                    </div>
                }
                else
                {
                    @foreach (var risk in riskCategories)
                    {
                        <div style="margin-bottom: 20px;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                                <span style="font-weight: 600; color: #1e293b;">@risk.Name</span>
                                <span style="font-size: 14px; font-weight: 700; color: @GetRiskColor(risk.Score);">@risk.Score.ToString("N1")</span>
                            </div>
                            <div style="height: 8px; background: #e5e7eb; border-radius: 4px; overflow: hidden;">
                                <div style="width: @(risk.Score * 10)%; height: 100%; background: @GetRiskColor(risk.Score); transition: width 0.3s;"></div>
                            </div>
                            <p style="font-size: 12px; color: #64748b; margin: 4px 0 0 0;">@risk.Description</p>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Risk Alerts -->
        <div style="background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden;">
            <div style="background: linear-gradient(135deg, #9B3A3A, #7A2E2E); color: white; padding: 20px 24px;">
                <h3 style="font-size: 18px; font-weight: 600; margin: 0;">⚠️ Risk Alerts</h3>
            </div>
            <div style="padding: 24px;">
                @if (!riskAlerts.Any())
                {
                    <div style="text-align: center; padding: 40px; color: #6b7280;">
                        <p style="font-size: 32px; margin-bottom: 8px;">✅</p>
                        <p style="font-size: 14px;">No active alerts</p>
                    </div>
                }
                else
                {
                    @foreach (var alert in riskAlerts)
                    {
                        <div style="background: @alert.BgColor; border: 1px solid @alert.BorderColor; border-radius: 8px; padding: 12px; margin-bottom: 12px;">
                            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                                <span style="font-size: 16px;">@alert.Icon</span>
                                <span style="font-weight: 600; color: @alert.TextColor; font-size: 14px;">@alert.Title</span>
                            </div>
                            <p style="font-size: 12px; color: @alert.TextColor; margin: 0;">@alert.Message</p>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- High Risk Loans -->
    <div style="background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden; margin-top: 24px;">
        <div style="background: linear-gradient(135deg, #8B5A2B, #6B4423); color: white; padding: 20px 24px;">
            <h3 style="font-size: 18px; font-weight: 600; margin: 0;">High Risk Loan Applications</h3>
        </div>
        <div style="padding: 24px;">
            @if (!highRiskLoans.Any())
            {
                <div style="text-align: center; padding: 60px; color: #6b7280;">
                    <p style="font-size: 48px; margin-bottom: 16px;">✅</p>
                    <p style="font-size: 16px; font-weight: 500;">No high-risk loans at this time</p>
                </div>
            }
            else
            {
                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background: #f8fafc;">
                            <th style="padding: 14px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #64748b;">Application</th>
                            <th style="padding: 14px 16px; text-align: right; font-size: 12px; font-weight: 600; color: #64748b;">Amount</th>
                            <th style="padding: 14px 16px; text-align: center; font-size: 12px; font-weight: 600; color: #64748b;">Risk Score</th>
                            <th style="padding: 14px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #64748b;">Risk Factors</th>
                            <th style="padding: 14px 16px; text-align: center; font-size: 12px; font-weight: 600; color: #64748b;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var loan in highRiskLoans)
                        {
                            <tr style="border-bottom: 1px solid #e5e7eb;">
                                <td style="padding: 16px; font-size: 14px; color: #1e293b; font-weight: 500;">@loan.ApplicationNumber</td>
                                <td style="padding: 16px; font-size: 14px; color: #1e293b; font-weight: 600; text-align: right;">₱@loan.RequestedAmount.ToString("N2")</td>
                                <td style="padding: 16px; text-align: center;">
                                    <span style="padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; background: #fee2e2; color: #991b1b;">
                                        High Risk
                                    </span>
                                </td>
                                <td style="padding: 16px; font-size: 13px; color: #64748b;">Debt-to-income ratio, Credit history</td>
                                <td style="padding: 16px; text-align: center;">
                                    <button @onclick="() => ReviewLoan(loan)" style="padding: 6px 16px; background: #5F6F52; color: white; border: none; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer;">
                                        Review
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

<style>
    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

@code {
    private decimal overallRisk = 3.2m;
    private decimal creditRisk = 2.8m;
    private decimal liquidityRisk = 85.5m;
    private decimal operationalRisk = 99.2m;
    
    private List<RiskCategory> riskCategories = new();
    private List<RiskAlert> riskAlerts = new();
    private List<LoanApplication> highRiskLoans = new();
    
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        await LogAdminAction("VIEW", "Risk Assessment", "Admin accessed Risk Assessment page");
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            
            // Calculate risk metrics
            var loans = await context.LoanApplications.Where(l => l.Status == "Approved").ToListAsync();
            var totalLoans = loans.Count;
            
            // Mock risk calculations
            riskCategories = new List<RiskCategory>
            {
                new() { Name = "Credit Risk", Score = 3.2m, Description = "Risk from borrower defaults" },
                new() { Name = "Market Risk", Score = 2.8m, Description = "Risk from market fluctuations" },
                new() { Name = "Liquidity Risk", Score = 2.1m, Description = "Risk of cash shortage" },
                new() { Name = "Operational Risk", Score = 1.5m, Description = "Risk from internal processes" },
                new() { Name = "Compliance Risk", Score = 1.8m, Description = "Risk of regulatory violations" },
                new() { Name = "Reputational Risk", Score = 1.2m, Description = "Risk to institution's image" }
            };
            
            // Risk alerts based on thresholds
            riskAlerts = new List<RiskAlert>();
            
            if (creditRisk > 5)
            {
                riskAlerts.Add(new RiskAlert
                {
                    Icon = "🔴",
                    Title = "High Credit Risk",
                    Message = "NPL ratio exceeds threshold",
                    BgColor = "#fee2e2",
                    BorderColor = "#fecaca",
                    TextColor = "#991b1b"
                });
            }
            
            if (liquidityRisk < 90)
            {
                riskAlerts.Add(new RiskAlert
                {
                    Icon = "🟡",
                    Title = "Liquidity Warning",
                    Message = "Coverage ratio below optimal",
                    BgColor = "#fef3c7",
                    BorderColor = "#fde68a",
                    TextColor = "#92400e"
                });
            }
            
            // Get high risk loan applications
            highRiskLoans = await context.LoanApplications
                .Where(l => l.Status == "Pending" && l.RequestedAmount > 500000)
                .Take(5)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            NotificationService.ShowError("Error", $"Failed to load risk data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RefreshData()
    {
        await LoadData();
        NotificationService.ShowSuccess("Refreshed", "Risk data refreshed successfully");
    }

    private async Task GenerateReport()
    {
        await LogAdminAction("GENERATE_REPORT", "Risk Report", "Admin generated risk assessment report");
        NotificationService.ShowSuccess("Report", "Risk assessment report generation initiated");
    }

    private async Task ReviewLoan(LoanApplication loan)
    {
        await LogAdminAction("REVIEW_LOAN", $"Loan: {loan.ApplicationNumber}", $"Admin initiated review for high-risk loan {loan.ApplicationNumber}");
        NotificationService.ShowInfo("Review", $"Opening review for {loan.ApplicationNumber}");
    }

    private string GetRiskColor(decimal score)
    {
        if (score <= 3) return "#5F6F52"; // Green
        if (score <= 6) return "#f59e0b"; // Yellow
        return "#dc2626"; // Red
    }

    private string GetRiskLevel(decimal score)
    {
        if (score <= 3) return "Low";
        if (score <= 6) return "Medium";
        return "High";
    }

    private async Task LogAdminAction(string action, string module, string description)
    {
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            var auditLog = new AuditLog
            {
                UserId = AuthService.CurrentUserId?.ToString() ?? "system",
                Action = $"ADMIN_{action}",
                Module = module,
                Description = $"[ADMIN] {description}",
                CreatedAt = DateTime.Now
            };
            context.AuditLogs.Add(auditLog);
            await context.SaveChangesAsync();
        }
        catch { }
    }

    private class RiskCategory
    {
        public string Name { get; set; } = "";
        public decimal Score { get; set; }
        public string Description { get; set; } = "";
    }

    private class RiskAlert
    {
        public string Icon { get; set; } = "";
        public string Title { get; set; } = "";
        public string Message { get; set; } = "";
        public string BgColor { get; set; } = "";
        public string BorderColor { get; set; } = "";
        public string TextColor { get; set; } = "";
    }
}
