@page "/admin/finance-manager/reports"
@layout Components.Layout.AdminLayout
@using Microsoft.EntityFrameworkCore
@using FinanceBank.Data
@using FinanceBank.Services
@inject IDbContextFactory<BFASDbContext> DbFactory
@inject NotificationService Notification
@inject AuthService AuthService

<div class="page-container">
    <div class="page-header">
        <div class="header-content">
            <h1 class="page-title">
                <span class="material-icons">assessment</span>
                Finance Manager Reports
            </h1>
            <p class="page-subtitle">Generate and export financial reports &amp; analytics</p>
        </div>
        <div class="header-actions">
            <button class="btn btn-outline" @onclick="RefreshData">
                <span class="material-icons">refresh</span>
                Refresh
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-container">
            <div class="loading-spinner"></div>
            <p>Loading reports...</p>
        </div>
    }
    else
    {
        <!-- Report Categories -->
        <div class="report-categories">
            <div class="category-card" @onclick='() => SelectCategory("financial")'>
                <div class="category-icon financial">
                    <span class="material-icons">account_balance</span>
                </div>
                <h3>Financial Reports</h3>
                <p>Income statements, balance sheets, cash flow</p>
                <span class="category-arrow">&gt;</span>
            </div>

            <div class="category-card" @onclick='() => SelectCategory("loan")'>
                <div class="category-icon loan">
                    <span class="material-icons">credit_score</span>
                </div>
                <h3>Loan Reports</h3>
                <p>Loan portfolio, approvals, delinquency</p>
                <span class="category-arrow">&gt;</span>
            </div>

            <div class="category-card" @onclick='() => SelectCategory("savings")'>
                <div class="category-icon savings">
                    <span class="material-icons">savings</span>
                </div>
                <h3>Savings Reports</h3>
                <p>Account statistics, interest analysis</p>
                <span class="category-arrow">&gt;</span>
            </div>

            <div class="category-card" @onclick='() => SelectCategory("risk")'>
                <div class="category-icon risk">
                    <span class="material-icons">warning</span>
                </div>
                <h3>Risk Reports</h3>
                <p>Risk assessment, compliance, audit</p>
                <span class="category-arrow">&gt;</span>
            </div>
        </div>

        <!-- Report Generation Section -->
        <div class="report-section">
            <div class="section-header">
                <h2>Generate Report</h2>
            </div>
            <div class="report-form">
                <div class="form-row">
                    <div class="form-group">
                        <label>Report Type</label>
                        <select @bind="selectedReportType" class="form-control">
                            <option value="">Select Report Type</option>
                            <option value="income_statement">Income Statement</option>
                            <option value="balance_sheet">Balance Sheet</option>
                            <option value="cash_flow">Cash Flow Statement</option>
                            <option value="loan_portfolio">Loan Portfolio Summary</option>
                            <option value="savings_summary">Savings Account Summary</option>
                            <option value="delinquency">Delinquency Report</option>
                            <option value="risk_assessment">Risk Assessment Report</option>
                            <option value="audit_trail">Audit Trail Report</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Date Range</label>
                        <select @bind="selectedDateRange" class="form-control">
                            <option value="today">Today</option>
                            <option value="week">This Week</option>
                            <option value="month">This Month</option>
                            <option value="quarter">This Quarter</option>
                            <option value="year">This Year</option>
                            <option value="custom">Custom Range</option>
                        </select>
                    </div>
                </div>

                @if (selectedDateRange == "custom")
                {
                    <div class="form-row">
                        <div class="form-group">
                            <label>Start Date</label>
                            <input type="date" @bind="startDate" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label>End Date</label>
                            <input type="date" @bind="endDate" class="form-control" />
                        </div>
                    </div>
                }

                <div class="form-row">
                    <div class="form-group">
                        <label>Export Format</label>
                        <select @bind="exportFormat" class="form-control">
                            <option value="pdf">PDF</option>
                            <option value="excel">Excel</option>
                            <option value="csv">CSV</option>
                        </select>
                    </div>
                    <div class="form-group btn-group">
                        <button class="btn btn-primary" @onclick="GenerateReport" disabled="@isGenerating">
                            @if (isGenerating)
                            {
                                <span class="material-icons spinning">sync</span>
                                <span>Generating...</span>
                            }
                            else
                            {
                                <span class="material-icons">play_arrow</span>
                                <span>Generate Report</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Reports -->
        <div class="report-section">
            <div class="section-header">
                <h2>Recent Reports</h2>
                <span class="badge">@recentReports.Count reports</span>
            </div>
            <div class="table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Report Name</th>
                            <th>Type</th>
                            <th>Generated By</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (recentReports.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="empty-state">No reports generated yet</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var report in recentReports)
                            {
                                <tr>
                                    <td>@report.Name</td>
                                    <td><span class="badge badge-info">@report.Type</span></td>
                                    <td>@report.GeneratedBy</td>
                                    <td>@report.GeneratedDate.ToString("MMM dd, yyyy HH:mm")</td>
                                    <td>
                                        <span class="status-badge @GetStatusClass(report.Status)">
                                            @report.Status
                                        </span>
                                    </td>
                                    <td class="action-cell">
                                        <button class="btn btn-sm btn-outline" title="View" @onclick="() => ViewReport(report)">
                                            <span class="material-icons">visibility</span>
                                        </button>
                                        <button class="btn btn-sm btn-outline" title="Download" @onclick="() => DownloadReport(report)">
                                            <span class="material-icons">download</span>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" title="Delete" @onclick="() => DeleteReport(report)">
                                            <span class="material-icons">delete</span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Report Summary Stats -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon blue">
                    <span class="material-icons">description</span>
                </div>
                <div class="stat-content">
                    <span class="stat-value">@totalReportsGenerated</span>
                    <span class="stat-label">Total Reports</span>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon green">
                    <span class="material-icons">check_circle</span>
                </div>
                <div class="stat-content">
                    <span class="stat-value">@completedReports</span>
                    <span class="stat-label">Completed</span>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon orange">
                    <span class="material-icons">pending</span>
                </div>
                <div class="stat-content">
                    <span class="stat-value">@pendingReports</span>
                    <span class="stat-label">Pending</span>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon purple">
                    <span class="material-icons">schedule</span>
                </div>
                <div class="stat-content">
                    <span class="stat-value">@scheduledReports</span>
                    <span class="stat-label">Scheduled</span>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .page-container {
        padding: 24px;
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 24px;
    }

    .page-title {
        font-size: 28px;
        font-weight: 700;
        color: #1a1a2e;
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 0;
    }

    .page-title .material-icons {
        color: #667eea;
        font-size: 32px;
    }

    .page-subtitle {
        color: #64748b;
        margin: 4px 0 0 44px;
    }

    .header-actions {
        display: flex;
        gap: 12px;
    }

    .loading-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px;
        color: #64748b;
    }

    .loading-spinner {
        width: 48px;
        height: 48px;
        border: 4px solid #e2e8f0;
        border-top-color: #667eea;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    .report-categories {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 24px;
    }

    .category-card {
        background: white;
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        position: relative;
    }

    .category-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    }

    .category-icon {
        width: 56px;
        height: 56px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
    }

    .category-icon .material-icons {
        font-size: 28px;
        color: white;
    }

    .category-icon.financial { background: linear-gradient(135deg, #667eea, #764ba2); }
    .category-icon.loan { background: linear-gradient(135deg, #11998e, #38ef7d); }
    .category-icon.savings { background: linear-gradient(135deg, #f093fb, #f5576c); }
    .category-icon.risk { background: linear-gradient(135deg, #ff9a9e, #fecfef); }

    .category-card h3 {
        font-size: 18px;
        font-weight: 600;
        color: #1a1a2e;
        margin: 0 0 8px 0;
    }

    .category-card p {
        color: #64748b;
        font-size: 14px;
        margin: 0;
        flex: 1;
    }

    .category-arrow {
        position: absolute;
        right: 20px;
        top: 50%;
        transform: translateY(-50%);
        color: #667eea;
        font-size: 20px;
        font-weight: bold;
    }

    .report-section {
        background: white;
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        margin-bottom: 24px;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .section-header h2 {
        font-size: 20px;
        font-weight: 600;
        color: #1a1a2e;
        margin: 0;
    }

    .report-form {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .form-row {
        display: flex;
        gap: 16px;
    }

    .form-group {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .form-group.btn-group {
        justify-content: flex-end;
    }

    .form-group label {
        font-weight: 500;
        color: #374151;
        font-size: 14px;
    }

    .form-control {
        padding: 10px 14px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        font-size: 14px;
        transition: all 0.2s;
    }

    .form-control:focus {
        outline: none;
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 500;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.2s;
        border: none;
    }

    .btn-primary {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
    }

    .btn-primary:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
    }

    .btn-primary:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .btn-outline {
        background: white;
        border: 1px solid #d1d5db;
        color: #374151;
    }

    .btn-outline:hover {
        background: #f3f4f6;
    }

    .btn-sm {
        padding: 6px 10px;
    }

    .btn-outline-danger {
        background: white;
        border: 1px solid #fca5a5;
        color: #dc2626;
    }

    .btn-outline-danger:hover {
        background: #fef2f2;
    }

    .table-container {
        overflow-x: auto;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

    .data-table th,
    .data-table td {
        padding: 14px 16px;
        text-align: left;
        border-bottom: 1px solid #e5e7eb;
    }

    .data-table th {
        background: #f8fafc;
        font-weight: 600;
        color: #374151;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .data-table tbody tr:hover {
        background: #f8fafc;
    }

    .empty-state {
        text-align: center;
        color: #64748b;
        padding: 40px !important;
    }

    .badge {
        display: inline-flex;
        align-items: center;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
    }

    .badge-info {
        background: #e0e7ff;
        color: #4338ca;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
    }

    .status-completed {
        background: #dcfce7;
        color: #16a34a;
    }

    .status-pending {
        background: #fef3c7;
        color: #d97706;
    }

    .status-failed {
        background: #fee2e2;
        color: #dc2626;
    }

    .action-cell {
        display: flex;
        gap: 8px;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
    }

    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .stat-icon .material-icons {
        color: white;
        font-size: 24px;
    }

    .stat-icon.blue { background: linear-gradient(135deg, #667eea, #764ba2); }
    .stat-icon.green { background: linear-gradient(135deg, #11998e, #38ef7d); }
    .stat-icon.orange { background: linear-gradient(135deg, #f093fb, #f5576c); }
    .stat-icon.purple { background: linear-gradient(135deg, #a855f7, #6366f1); }

    .stat-content {
        display: flex;
        flex-direction: column;
    }

    .stat-value {
        font-size: 28px;
        font-weight: 700;
        color: #1a1a2e;
    }

    .stat-label {
        font-size: 14px;
        color: #64748b;
    }

    .spinning {
        animation: spin 1s linear infinite;
    }
</style>

@code {
    private bool isLoading = true;
    private bool isGenerating = false;
    private string selectedReportType = "";
    private string selectedDateRange = "month";
    private string exportFormat = "pdf";
    private DateTime startDate = DateTime.Today.AddMonths(-1);
    private DateTime endDate = DateTime.Today;
    private string selectedCategory = "";

    private List<ReportItem> recentReports = new();
    private int totalReportsGenerated = 0;
    private int completedReports = 0;
    private int pendingReports = 0;
    private int scheduledReports = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            // Simulated report data
            recentReports = new List<ReportItem>
            {
                new ReportItem { Name = "Monthly Income Statement", Type = "Financial", GeneratedBy = AuthService.FullName ?? "Admin", GeneratedDate = DateTime.Now.AddDays(-1), Status = "Completed" },
                new ReportItem { Name = "Loan Portfolio Summary", Type = "Loan", GeneratedBy = AuthService.FullName ?? "Admin", GeneratedDate = DateTime.Now.AddDays(-2), Status = "Completed" },
                new ReportItem { Name = "Risk Assessment Q4", Type = "Risk", GeneratedBy = AuthService.FullName ?? "Admin", GeneratedDate = DateTime.Now.AddDays(-3), Status = "Pending" },
                new ReportItem { Name = "Savings Account Analysis", Type = "Savings", GeneratedBy = AuthService.FullName ?? "Admin", GeneratedDate = DateTime.Now.AddDays(-5), Status = "Completed" }
            };

            totalReportsGenerated = 47;
            completedReports = 42;
            pendingReports = 3;
            scheduledReports = 2;

            await Task.Delay(300); // Simulate loading
        }
        catch (Exception ex)
        {
            Notification.ShowError("Error", $"Error loading reports: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshData()
    {
        await LoadData();
        Notification.ShowSuccess("Refreshed", "Reports refreshed");
    }

    private void SelectCategory(string category)
    {
        selectedCategory = category;
        selectedReportType = category switch
        {
            "financial" => "income_statement",
            "loan" => "loan_portfolio",
            "savings" => "savings_summary",
            "risk" => "risk_assessment",
            _ => ""
        };
        StateHasChanged();
    }

    private async Task GenerateReport()
    {
        if (string.IsNullOrEmpty(selectedReportType))
        {
            Notification.ShowWarning("Warning", "Please select a report type");
            return;
        }

        isGenerating = true;
        StateHasChanged();

        try
        {
            await Task.Delay(2000); // Simulate report generation

            var reportName = GetReportName(selectedReportType);
            recentReports.Insert(0, new ReportItem
            {
                Name = reportName,
                Type = GetReportCategory(selectedReportType),
                GeneratedBy = AuthService.FullName ?? "Admin",
                GeneratedDate = DateTime.Now,
                Status = "Completed"
            });

            totalReportsGenerated++;
            completedReports++;

            Notification.ShowSuccess("Success", $"Report '{reportName}' generated successfully");
        }
        catch (Exception ex)
        {
            Notification.ShowError("Error", $"Error generating report: {ex.Message}");
        }
        finally
        {
            isGenerating = false;
            StateHasChanged();
        }
    }

    private string GetReportName(string type) => type switch
    {
        "income_statement" => "Income Statement",
        "balance_sheet" => "Balance Sheet",
        "cash_flow" => "Cash Flow Statement",
        "loan_portfolio" => "Loan Portfolio Summary",
        "savings_summary" => "Savings Account Summary",
        "delinquency" => "Delinquency Report",
        "risk_assessment" => "Risk Assessment Report",
        "audit_trail" => "Audit Trail Report",
        _ => "Report"
    };

    private string GetReportCategory(string type) => type switch
    {
        "income_statement" or "balance_sheet" or "cash_flow" => "Financial",
        "loan_portfolio" or "delinquency" => "Loan",
        "savings_summary" => "Savings",
        "risk_assessment" or "audit_trail" => "Risk",
        _ => "Other"
    };

    private string GetStatusClass(string status) => status.ToLower() switch
    {
        "completed" => "status-completed",
        "pending" => "status-pending",
        "failed" => "status-failed",
        _ => ""
    };

    private void ViewReport(ReportItem report)
    {
        Notification.ShowInfo("View", $"Viewing report: {report.Name}");
    }

    private void DownloadReport(ReportItem report)
    {
        Notification.ShowSuccess("Download", $"Downloading report: {report.Name}");
    }

    private async Task DeleteReport(ReportItem report)
    {
        try
        {
            recentReports.Remove(report);
            totalReportsGenerated--;
            if (report.Status == "Completed") completedReports--;
            else if (report.Status == "Pending") pendingReports--;
            
            Notification.ShowSuccess("Deleted", $"Report '{report.Name}' deleted");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Notification.ShowError("Error", $"Error deleting report: {ex.Message}");
        }
    }

    private class ReportItem
    {
        public string Name { get; set; } = "";
        public string Type { get; set; } = "";
        public string GeneratedBy { get; set; } = "";
        public DateTime GeneratedDate { get; set; }
        public string Status { get; set; } = "";
    }
}
