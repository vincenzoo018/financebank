@page "/admin/finance-manager/dashboard"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@using Microsoft.EntityFrameworkCore
@inject AuthService AuthService
@inject NotificationService NotificationService
@inject IDbContextFactory<BFASDbContext> DbFactory
@inject IJSRuntime JS

<div style="padding: 24px; max-width: 1400px; margin: 0 auto;">
    <!-- Header with Filter -->
    <div style="background: linear-gradient(135deg, #5F6F52 0%, #2F3E2A 100%); border-radius: 16px; padding: 24px; margin-bottom: 24px; color: white;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
            <div style="display: flex; align-items: center; gap: 16px;">
                <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
                    <svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                    </svg>
                </div>
                <div>
                    <h1 style="font-size: 24px; font-weight: 700; margin: 0;">Admin - Finance Manager Dashboard</h1>
                    <p style="font-size: 14px; opacity: 0.9; margin: 4px 0 0 0;">Administrative view of finance operations</p>
                </div>
            </div>
            <div style="display: flex; gap: 12px; align-items: center;">
                <select @bind="selectedPeriod" @bind:after="LoadData" style="padding: 10px 16px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.3); background: rgba(255,255,255,0.1); color: white;">
                    <option value="today" style="color: black;">Today</option>
                    <option value="week" style="color: black;">This Week</option>
                    <option value="month" style="color: black;">This Month</option>
                    <option value="year" style="color: black;">This Year</option>
                </select>
                <button @onclick="RefreshData" style="padding: 10px 20px; background: rgba(255,255,255,0.2); border: 1px solid rgba(255,255,255,0.3); border-radius: 8px; color: white; cursor: pointer; font-weight: 600;">
                    🔄 Refresh
                </button>
            </div>
        </div>
    </div>

    <!-- Admin Notice -->
    <div style="background: linear-gradient(135deg, #E5D9B6 0%, #D4C9A8 100%); border: 1px solid #8B5A2B; border-radius: 12px; padding: 16px; margin-bottom: 24px;">
        <div style="display: flex; align-items: center; gap: 12px;">
            <span style="font-size: 24px;">🔐</span>
            <div>
                <p style="font-weight: 600; color: #6B4423; margin: 0;">Administrative Access Mode</p>
                <p style="font-size: 13px; color: #8B5A2B; margin: 4px 0 0 0;">All views and actions are logged for audit purposes. Admin: @(AuthService.FullName ?? "Admin")</p>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div style="display: flex; justify-content: center; padding: 60px;">
            <div style="width: 48px; height: 48px; border: 4px solid #E2E2DC; border-top-color: #5F6F52; border-radius: 50%; animation: spin 1s linear infinite;"></div>
        </div>
    }
    else
    {
        <!-- Stats Cards -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 24px;">
            <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #E2E2DC; border-left: 4px solid #5F6F52;">
                <p style="font-size: 13px; color: #6B6B6B; font-weight: 600; margin: 0;">💰 Total Deposits</p>
                <p style="font-size: 24px; font-weight: 700; color: #5F6F52; margin: 8px 0 0 0;">₱@totalDeposits.ToString("N2")</p>
                <p style="font-size: 12px; color: #9ca3af; margin: 4px 0 0 0;">@depositCount transactions</p>
            </div>
            <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #E2E2DC; border-left: 4px solid #9B3A3A;">
                <p style="font-size: 13px; color: #6B6B6B; font-weight: 600; margin: 0;">📤 Total Withdrawals</p>
                <p style="font-size: 24px; font-weight: 700; color: #9B3A3A; margin: 8px 0 0 0;">₱@totalWithdrawals.ToString("N2")</p>
                <p style="font-size: 12px; color: #9ca3af; margin: 4px 0 0 0;">@withdrawalCount transactions</p>
            </div>
            <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #E2E2DC; border-left: 4px solid #6B7B5E;">
                <p style="font-size: 13px; color: #6B6B6B; font-weight: 600; margin: 0;">💳 Loan Payments</p>
                <p style="font-size: 24px; font-weight: 700; color: #6B7B5E; margin: 8px 0 0 0;">₱@totalLoanPayments.ToString("N2")</p>
                <p style="font-size: 12px; color: #9ca3af; margin: 4px 0 0 0;">@loanPaymentCount payments</p>
            </div>
            <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #E2E2DC; border-left: 4px solid #8B5A2B;">
                <p style="font-size: 13px; color: #6B6B6B; font-weight: 600; margin: 0;">📊 Net Cash Flow</p>
                <p style="font-size: 24px; font-weight: 700; color: @(netCashFlow >= 0 ? "#5F6F52" : "#9B3A3A"); margin: 8px 0 0 0;">₱@netCashFlow.ToString("N2")</p>
                <p style="font-size: 12px; color: #9ca3af; margin: 4px 0 0 0;">@selectedPeriod period</p>
            </div>
        </div>

        <!-- Cash Flow Summary -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px;">
            <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
                <h3 style="font-size: 16px; font-weight: 600; color: #1e293b; margin: 0 0 16px 0;">📈 Inflows</h3>
                <div style="space-y: 12px;">
                    <div style="display: flex; justify-content: space-between; padding: 12px; background: #F0F2EC; border-radius: 8px; margin-bottom: 8px;">
                        <span style="color: #166534;">Deposits</span>
                        <span style="font-weight: 600; color: #166534;">₱@totalDeposits.ToString("N2")</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; padding: 12px; background: #F0F2EC; border-radius: 8px; margin-bottom: 8px;">
                        <span style="color: #166534;">Loan Payments</span>
                        <span style="font-weight: 600; color: #166534;">₱@totalLoanPayments.ToString("N2")</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; padding: 12px; background: #DDE6D5; border-radius: 8px; font-weight: 700;">
                        <span style="color: #166534;">Total Inflows</span>
                        <span style="color: #166534;">₱@((totalDeposits + totalLoanPayments).ToString("N2"))</span>
                    </div>
                </div>
            </div>
            <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
                <h3 style="font-size: 16px; font-weight: 600; color: #1e293b; margin: 0 0 16px 0;">📉 Outflows</h3>
                <div style="space-y: 12px;">
                    <div style="display: flex; justify-content: space-between; padding: 12px; background: #fef2f2; border-radius: 8px; margin-bottom: 8px;">
                        <span style="color: #991b1b;">Withdrawals</span>
                        <span style="font-weight: 600; color: #991b1b;">₱@totalWithdrawals.ToString("N2")</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; padding: 12px; background: #fef2f2; border-radius: 8px; margin-bottom: 8px;">
                        <span style="color: #991b1b;">Loan Disbursements</span>
                        <span style="font-weight: 600; color: #991b1b;">₱@totalDisbursements.ToString("N2")</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; padding: 12px; background: #fee2e2; border-radius: 8px; font-weight: 700;">
                        <span style="color: #991b1b;">Total Outflows</span>
                        <span style="color: #991b1b;">₱@((totalWithdrawals + totalDisbursements).ToString("N2"))</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Transactions -->
        <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h3 style="font-size: 18px; font-weight: 600; color: #1e293b; margin: 0;">Recent Transactions</h3>
            </div>
            
            @if (!recentTransactions.Any())
            {
                <div style="text-align: center; padding: 40px; color: #6b7280;">
                    <p>No transactions found for this period</p>
                </div>
            }
            else
            {
                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background: #f8fafc;">
                            <th style="padding: 12px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #64748b;">Type</th>
                            <th style="padding: 12px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #64748b;">Account</th>
                            <th style="padding: 12px 16px; text-align: right; font-size: 12px; font-weight: 600; color: #64748b;">Amount</th>
                            <th style="padding: 12px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #64748b;">Date</th>
                            <th style="padding: 12px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #64748b;">Processed By</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var txn in recentTransactions.Take(10))
                        {
                            <tr style="border-bottom: 1px solid #e5e7eb;">
                                <td style="padding: 14px 16px;">
                                    <span style="padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; @GetTypeStyle(txn.Type)">
                                        @txn.Type
                                    </span>
                                </td>
                                <td style="padding: 14px 16px; font-size: 14px; color: #1e293b;">@txn.AccountNumber</td>
                                <td style="padding: 14px 16px; font-size: 14px; font-weight: 600; text-align: right; color: @(txn.Type.Contains("Deposit") || txn.Type.Contains("Payment") ? "#5F6F52" : "#dc2626");">
                                    ₱@txn.Amount.ToString("N2")
                                </td>
                                <td style="padding: 14px 16px; font-size: 14px; color: #64748b;">@txn.Date.ToString("MMM dd, HH:mm")</td>
                                <td style="padding: 14px 16px; font-size: 14px; color: #64748b;">@txn.ProcessedBy</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
</div>

<style>
    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

@code {
    private bool isLoading = true;
    private string selectedPeriod = "week";
    
    // Summary data
    private decimal totalDeposits = 0;
    private decimal totalWithdrawals = 0;
    private decimal totalLoanPayments = 0;
    private decimal totalDisbursements = 0;
    private decimal netCashFlow = 0;
    private int depositCount = 0;
    private int withdrawalCount = 0;
    private int loanPaymentCount = 0;
    private int disbursementCount = 0;
    
    private List<TransactionItem> recentTransactions = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        await LogAdminAction("VIEW", "FM Dashboard", "Admin accessed Finance Manager Dashboard");
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            var (startDate, endDate) = GetDateRange(selectedPeriod);
            
            // Load transactions
            var transactions = await context.CustomerTransactions
                .Include(t => t.Account)
                .Include(t => t.ProcessedByEmployee)
                .Where(t => t.CreatedAt >= startDate && t.CreatedAt <= endDate)
                .OrderByDescending(t => t.CreatedAt)
                .ToListAsync();
            
            // Calculate totals
            totalDeposits = transactions.Where(t => t.TransactionType == "Deposit").Sum(t => t.Amount);
            depositCount = transactions.Count(t => t.TransactionType == "Deposit");
            
            totalWithdrawals = transactions.Where(t => t.TransactionType == "Withdrawal").Sum(t => t.Amount);
            withdrawalCount = transactions.Count(t => t.TransactionType == "Withdrawal");
            
            totalLoanPayments = transactions.Where(t => t.TransactionType == "Loan Payment").Sum(t => t.Amount);
            loanPaymentCount = transactions.Count(t => t.TransactionType == "Loan Payment");
            
            totalDisbursements = transactions.Where(t => t.TransactionType == "Loan Disbursement").Sum(t => t.Amount);
            disbursementCount = transactions.Count(t => t.TransactionType == "Loan Disbursement");
            
            netCashFlow = (totalDeposits + totalLoanPayments) - (totalWithdrawals + totalDisbursements);
            
            // Map to display items
            recentTransactions = transactions.Take(20).Select(t => new TransactionItem
            {
                Type = t.TransactionType ?? "Unknown",
                AccountNumber = t.Account?.AccountNumber ?? "N/A",
                Amount = t.Amount,
                Date = t.CreatedAt,
                ProcessedBy = t.ProcessedByEmployee?.FirstName ?? "System"
            }).ToList();
        }
        catch (Exception ex)
        {
            NotificationService.ShowError("Error", $"Failed to load data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RefreshData()
    {
        await LoadData();
        await LogAdminAction("REFRESH", "FM Dashboard", "Admin refreshed Finance Manager Dashboard data");
        NotificationService.ShowSuccess("Refreshed", "Dashboard data refreshed successfully");
    }

    private (DateTime start, DateTime end) GetDateRange(string period) => period switch
    {
        "today" => (DateTime.Today, DateTime.Today.AddDays(1)),
        "week" => (DateTime.Today.AddDays(-7), DateTime.Today.AddDays(1)),
        "month" => (DateTime.Today.AddMonths(-1), DateTime.Today.AddDays(1)),
        "year" => (DateTime.Today.AddYears(-1), DateTime.Today.AddDays(1)),
        _ => (DateTime.Today.AddDays(-7), DateTime.Today.AddDays(1))
    };

    private string GetTypeStyle(string type) => type switch
    {
        "Deposit" => "background: #DDE6D5; color: #166534;",
        "Withdrawal" => "background: #fee2e2; color: #991b1b;",
        "Loan Payment" => "background: #dbeafe; color: #1e40af;",
        "Loan Disbursement" => "background: #fef3c7; color: #92400e;",
        _ => "background: #f3f4f6; color: #6b7280;"
    };

    private async Task LogAdminAction(string action, string module, string description)
    {
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            var auditLog = new AuditLog
            {
                UserId = AuthService.CurrentUserId?.ToString() ?? "system",
                Action = $"ADMIN_{action}",
                Module = module,
                Description = $"[ADMIN] {description}",
                CreatedAt = DateTime.Now
            };
            context.AuditLogs.Add(auditLog);
            await context.SaveChangesAsync();
        }
        catch { }
    }

    private class TransactionItem
    {
        public string Type { get; set; } = "";
        public string AccountNumber { get; set; } = "";
        public decimal Amount { get; set; }
        public DateTime Date { get; set; }
        public string ProcessedBy { get; set; } = "";
    }
}
