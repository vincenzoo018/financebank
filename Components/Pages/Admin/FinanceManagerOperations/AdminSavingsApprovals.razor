@page "/admin/finance-manager/savings-approvals"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@using Microsoft.EntityFrameworkCore
@using SIPModel = FinanceBank.Models.SavingsInterestPosting
@inject AuthService AuthService
@inject SavingsAccountService SavingsService
@inject SavingsInterestService InterestService
@inject NotificationService NotificationService
@inject IDbContextFactory<BFASDbContext> DbFactory

<div style="padding: 24px; max-width: 1400px; margin: 0 auto;">
    <!-- Header -->
    <div style="background: linear-gradient(135deg, #5F6F52 0%, #2F3E2A 100%); border-radius: 16px; padding: 24px; margin-bottom: 24px; color: white;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
            <div>
                <h1 style="font-size: 24px; font-weight: 700; margin: 0;">Admin - Savings Approvals</h1>
                <p style="font-size: 14px; opacity: 0.9; margin: 4px 0 0 0;">Administrative savings approval management with audit trail</p>
            </div>
        </div>
    </div>

    <!-- Admin Notice -->
    <div style="background: linear-gradient(135deg, #E5D9B6 0%, #D4C9A8 100%); border: 1px solid #8B5A2B; border-radius: 12px; padding: 16px; margin-bottom: 24px;">
        <div style="display: flex; align-items: center; gap: 12px;">
            <span style="font-size: 24px;">🔐</span>
            <div>
                <p style="font-weight: 600; color: #6B4423; margin: 0;">Administrative Override Mode</p>
                <p style="font-size: 13px; color: #8B5A2B; margin: 4px 0 0 0;">All approval decisions require a reason. Admin: @(AuthService.FullName ?? "Admin")</p>
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <div style="margin-bottom: 24px; border-bottom: 2px solid #E2E2DC;">
        <button @onclick='() => activeTab = "withdrawals"' 
                style="padding: 12px 24px; border: none; border-bottom: 3px solid @(activeTab == "withdrawals" ? "#5F6F52" : "transparent"); background: none; font-weight: 600; color: @(activeTab == "withdrawals" ? "#5F6F52" : "#6B6B6B"); cursor: pointer; margin-right: 8px;">
            💸 Withdrawal Requests (@withdrawalRequests.Count)
        </button>
        <button @onclick='() => activeTab = "interest"' 
                style="padding: 12px 24px; border: none; border-bottom: 3px solid @(activeTab == "interest" ? "#5F6F52" : "transparent"); background: none; font-weight: 600; color: @(activeTab == "interest" ? "#5F6F52" : "#6B6B6B"); cursor: pointer;">
            💰 Interest Batches (@interestBatches.Count)
        </button>
    </div>

    @if (isLoading)
    {
        <div style="display: flex; justify-content: center; padding: 60px;">
            <div style="width: 48px; height: 48px; border: 4px solid #E2E2DC; border-top-color: #5F6F52; border-radius: 50%; animation: spin 1s linear infinite;"></div>
        </div>
    }
    else
    {
        @if (activeTab == "withdrawals")
        {
            <div style="background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden;">
                <div style="background: linear-gradient(135deg, #5F6F52, #2F3E2A); color: white; padding: 20px 24px;">
                    <h3 style="font-size: 18px; font-weight: 600; margin: 0;">Pending Withdrawal Requests</h3>
                </div>
                <div style="padding: 24px;">
                    @if (!withdrawalRequests.Any())
                    {
                        <div style="text-align: center; padding: 60px; color: #6b7280;">
                            <p style="font-size: 48px; margin-bottom: 16px;">✅</p>
                            <p style="font-size: 16px; font-weight: 500;">No pending withdrawal requests</p>
                        </div>
                    }
                    else
                    {
                        <table style="width: 100%; border-collapse: collapse;">
                            <thead>
                                <tr style="background: #f8fafc;">
                                    <th style="padding: 14px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #64748b;">Request ID</th>
                                    <th style="padding: 14px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #64748b;">Account</th>
                                    <th style="padding: 14px 16px; text-align: right; font-size: 12px; font-weight: 600; color: #64748b;">Amount</th>
                                    <th style="padding: 14px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #64748b;">Request Date</th>
                                    <th style="padding: 14px 16px; text-align: center; font-size: 12px; font-weight: 600; color: #64748b;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var request in withdrawalRequests)
                                {
                                    <tr style="border-bottom: 1px solid #e5e7eb;">
                                        <td style="padding: 16px; font-size: 14px; color: #1e293b; font-weight: 500;">#@request.RequestId</td>
                                        <td style="padding: 16px; font-size: 14px; color: #1e293b;">@(request.SavingsAccount?.AccountNumber ?? "N/A")</td>
                                        <td style="padding: 16px; font-size: 14px; color: #9B3A3A; font-weight: 600; text-align: right;">₱@request.RequestedAmount.ToString("N2")</td>
                                        <td style="padding: 16px; font-size: 14px; color: #64748b;">@request.RequestedDate.ToString("MMM dd, yyyy HH:mm")</td>
                                        <td style="padding: 16px; text-align: center;">
                                            <button @onclick="() => ShowApproveWithdrawal(request)" style="padding: 6px 16px; background: #5F6F52; color: white; border: none; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; margin-right: 4px;">
                                                Approve
                                            </button>
                                            <button @onclick="() => ShowRejectWithdrawal(request)" style="padding: 6px 16px; background: #9B3A3A; color: white; border: none; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer;">
                                                Reject
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        }
        else
        {
            <div style="background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden;">
                <div style="background: linear-gradient(135deg, #6B7B5E, #2F3E2A); color: white; padding: 20px 24px;">
                    <h3 style="font-size: 18px; font-weight: 600; margin: 0;">Pending Interest Batches</h3>
                </div>
                <div style="padding: 24px;">
                    @if (!interestBatches.Any())
                    {
                        <div style="text-align: center; padding: 60px; color: #6b7280;">
                            <p style="font-size: 48px; margin-bottom: 16px;">✅</p>
                            <p style="font-size: 16px; font-weight: 500;">No pending interest batches</p>
                        </div>
                    }
                    else
                    {
                        <table style="width: 100%; border-collapse: collapse;">
                            <thead>
                                <tr style="background: #f8fafc;">
                                    <th style="padding: 14px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #64748b;">Batch ID</th>
                                    <th style="padding: 14px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #64748b;">Period</th>
                                    <th style="padding: 14px 16px; text-align: right; font-size: 12px; font-weight: 600; color: #64748b;">Total Interest</th>
                                    <th style="padding: 14px 16px; text-align: center; font-size: 12px; font-weight: 600; color: #64748b;">Accounts</th>
                                    <th style="padding: 14px 16px; text-align: center; font-size: 12px; font-weight: 600; color: #64748b;">Status</th>
                                    <th style="padding: 14px 16px; text-align: center; font-size: 12px; font-weight: 600; color: #64748b;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var batch in interestBatches)
                                {
                                    <tr style="border-bottom: 1px solid #e5e7eb;">
                                        <td style="padding: 16px; font-size: 14px; color: #1e293b; font-weight: 500;">#@batch.PostingId</td>
                                        <td style="padding: 16px; font-size: 14px; color: #64748b;">@batch.PeriodStart.ToString("MMM dd") - @batch.PeriodEnd.ToString("MMM dd, yyyy")</td>
                                        <td style="padding: 16px; font-size: 14px; color: #5F6F52; font-weight: 600; text-align: right;">₱@batch.TotalInterestPosted.ToString("N2")</td>
                                        <td style="padding: 16px; font-size: 14px; color: #1e293b; text-align: center;">@batch.AccountsProcessed</td>
                                        <td style="padding: 16px; text-align: center;">
                                            <span style="padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; background: #fef3c7; color: #92400e;">
                                                @batch.PostingStatus
                                            </span>
                                        </td>
                                        <td style="padding: 16px; text-align: center;">
                                            <button @onclick="() => ShowApproveBatch(batch)" style="padding: 6px 16px; background: #5F6F52; color: white; border: none; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer;">
                                                Approve
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        }
    }
</div>

<!-- Approve Withdrawal Modal -->
@if (showApproveWithdrawalModal && selectedWithdrawal != null)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000;">
        <div style="background: white; border-radius: 16px; padding: 32px; width: 500px; max-width: 90%;">
            <h3 style="font-size: 20px; font-weight: 700; color: #1e293b; margin: 0 0 24px 0;">✅ Approve Withdrawal</h3>
            
            <div style="background: #F0F2EC; border: 1px solid #A9B388; border-radius: 12px; padding: 16px; margin-bottom: 20px;">
                <p style="font-size: 14px; color: #166534; margin: 0;"><strong>Request #@selectedWithdrawal.RequestId</strong></p>
                <p style="font-size: 14px; color: #166534; margin: 4px 0 0 0;">Amount: ₱@selectedWithdrawal.RequestedAmount.ToString("N2")</p>
            </div>

            <div style="margin-bottom: 20px;">
                <label style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 8px;">
                    Admin Approval Reason <span style="color: #dc2626;">*</span>
                </label>
                <textarea @bind="approvalReason" rows="4" placeholder="Enter reason for approval (required)"
                          style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px; resize: vertical;"></textarea>
            </div>

            <div style="display: flex; gap: 12px; justify-content: flex-end;">
                <button @onclick="CloseModals" style="padding: 12px 24px; background: #F7F7F4; color: #2B2B2B; border: none; border-radius: 8px; font-weight: 600; cursor: pointer;">
                    Cancel
                </button>
                <button @onclick="ConfirmApproveWithdrawal" disabled="@(string.IsNullOrWhiteSpace(approvalReason) || isProcessing)"
                        style="padding: 12px 24px; background: #5F6F52; color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; @(string.IsNullOrWhiteSpace(approvalReason) ? "opacity: 0.5;" : "")">
                    @(isProcessing ? "Processing..." : "Confirm Approval")
                </button>
            </div>
        </div>
    </div>
}

<!-- Reject Withdrawal Modal -->
@if (showRejectWithdrawalModal && selectedWithdrawal != null)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000;">
        <div style="background: white; border-radius: 16px; padding: 32px; width: 500px; max-width: 90%;">
            <h3 style="font-size: 20px; font-weight: 700; color: #1e293b; margin: 0 0 24px 0;">❌ Reject Withdrawal</h3>
            
            <div style="background: #fef2f2; border: 1px solid #fca5a5; border-radius: 12px; padding: 16px; margin-bottom: 20px;">
                <p style="font-size: 14px; color: #991b1b; margin: 0;"><strong>Request #@selectedWithdrawal.RequestId</strong></p>
                <p style="font-size: 14px; color: #991b1b; margin: 4px 0 0 0;">Amount: ₱@selectedWithdrawal.RequestedAmount.ToString("N2")</p>
            </div>

            <div style="margin-bottom: 20px;">
                <label style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 8px;">
                    Admin Rejection Reason <span style="color: #dc2626;">*</span>
                </label>
                <textarea @bind="rejectionReason" rows="4" placeholder="Enter reason for rejection (required)"
                          style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px; resize: vertical;"></textarea>
            </div>

            <div style="display: flex; gap: 12px; justify-content: flex-end;">
                <button @onclick="CloseModals" style="padding: 12px 24px; background: #F7F7F4; color: #2B2B2B; border: none; border-radius: 8px; font-weight: 600; cursor: pointer;">
                    Cancel
                </button>
                <button @onclick="ConfirmRejectWithdrawal" disabled="@(string.IsNullOrWhiteSpace(rejectionReason) || isProcessing)"
                        style="padding: 12px 24px; background: #9B3A3A; color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; @(string.IsNullOrWhiteSpace(rejectionReason) ? "opacity: 0.5;" : "")">
                    @(isProcessing ? "Processing..." : "Confirm Rejection")
                </button>
            </div>
        </div>
    </div>
}

<!-- Approve Batch Modal -->
@if (showApproveBatchModal && selectedBatch != null)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000;">
        <div style="background: white; border-radius: 16px; padding: 32px; width: 500px; max-width: 90%;">
            <h3 style="font-size: 20px; font-weight: 700; color: #1e293b; margin: 0 0 24px 0;">✅ Approve Interest Batch</h3>
            
            <div style="background: #F0F2EC; border: 1px solid #A9B388; border-radius: 12px; padding: 16px; margin-bottom: 20px;">
                <p style="font-size: 14px; color: #166534; margin: 0;"><strong>Batch #@selectedBatch.PostingId</strong></p>
                <p style="font-size: 14px; color: #166534; margin: 4px 0 0 0;">Total Interest: ₱@selectedBatch.TotalInterestPosted.ToString("N2") | Accounts: @selectedBatch.AccountsProcessed</p>
            </div>

            <div style="margin-bottom: 20px;">
                <label style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 8px;">
                    Admin Approval Reason <span style="color: #dc2626;">*</span>
                </label>
                <textarea @bind="approvalReason" rows="4" placeholder="Enter reason for approval (required)"
                          style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px; resize: vertical;"></textarea>
            </div>

            <div style="display: flex; gap: 12px; justify-content: flex-end;">
                <button @onclick="CloseModals" style="padding: 12px 24px; background: #F7F7F4; color: #2B2B2B; border: none; border-radius: 8px; font-weight: 600; cursor: pointer;">
                    Cancel
                </button>
                <button @onclick="ConfirmApproveBatch" disabled="@(string.IsNullOrWhiteSpace(approvalReason) || isProcessing)"
                        style="padding: 12px 24px; background: #5F6F52; color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; @(string.IsNullOrWhiteSpace(approvalReason) ? "opacity: 0.5;" : "")">
                    @(isProcessing ? "Processing..." : "Confirm Approval")
                </button>
            </div>
        </div>
    </div>
}

<style>
    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

@code {
    private List<SavingsWithdrawalRequest> withdrawalRequests = new();
    private List<SIPModel> interestBatches = new();
    private string activeTab = "withdrawals";
    private bool isLoading = true;
    private bool isProcessing = false;

    // Modal state
    private bool showApproveWithdrawalModal = false;
    private bool showRejectWithdrawalModal = false;
    private bool showApproveBatchModal = false;
    private SavingsWithdrawalRequest? selectedWithdrawal;
    private SIPModel? selectedBatch;
    private string approvalReason = "";
    private string rejectionReason = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        await LogAdminAction("VIEW", "Savings Approvals", "Admin accessed Savings Approvals page");
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            
            withdrawalRequests = await context.SavingsWithdrawalRequests
                .Include(r => r.SavingsAccount)
                .Where(r => r.Status == "Pending" || r.Status == "PendingFMApproval")
                .OrderByDescending(r => r.RequestedDate)
                .ToListAsync();
            
            interestBatches = await context.SavingsInterestPostings
                .Where(p => p.PostingStatus == "Pending")
                .OrderByDescending(p => p.PostingDate)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            NotificationService.ShowError("Error", $"Failed to load data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowApproveWithdrawal(SavingsWithdrawalRequest request)
    {
        selectedWithdrawal = request;
        approvalReason = "";
        showApproveWithdrawalModal = true;
    }

    private void ShowRejectWithdrawal(SavingsWithdrawalRequest request)
    {
        selectedWithdrawal = request;
        rejectionReason = "";
        showRejectWithdrawalModal = true;
    }

    private void ShowApproveBatch(SIPModel batch)
    {
        selectedBatch = batch;
        approvalReason = "";
        showApproveBatchModal = true;
    }

    private void CloseModals()
    {
        showApproveWithdrawalModal = false;
        showRejectWithdrawalModal = false;
        showApproveBatchModal = false;
        selectedWithdrawal = null;
        selectedBatch = null;
        approvalReason = "";
        rejectionReason = "";
    }

    private async Task ConfirmApproveWithdrawal()
    {
        if (selectedWithdrawal == null || string.IsNullOrWhiteSpace(approvalReason)) return;
        
        isProcessing = true;
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            var request = await context.SavingsWithdrawalRequests.FindAsync(selectedWithdrawal.RequestId);
            if (request != null)
            {
                request.Status = "FMApproved";
                request.ApprovedByFM = AuthService.FullName;
                request.ApprovedByFMAt = DateTime.Now;
                request.RejectionReason = $"[ADMIN OVERRIDE] {approvalReason}";
                await context.SaveChangesAsync();
            }
            
            await LogAdminAction("APPROVE_WITHDRAWAL", $"Request #{selectedWithdrawal.RequestId}", 
                $"Approved withdrawal of ₱{selectedWithdrawal.RequestedAmount:N2}. Reason: {approvalReason}");
            
            NotificationService.ShowSuccess("Approved", $"Withdrawal request #{selectedWithdrawal.RequestId} approved");
            CloseModals();
            await LoadData();
        }
        catch (Exception ex)
        {
            NotificationService.ShowError("Error", $"Failed to approve: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ConfirmRejectWithdrawal()
    {
        if (selectedWithdrawal == null || string.IsNullOrWhiteSpace(rejectionReason)) return;
        
        isProcessing = true;
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            var request = await context.SavingsWithdrawalRequests.FindAsync(selectedWithdrawal.RequestId);
            if (request != null)
            {
                request.Status = "Rejected";
                request.RejectionReason = $"[ADMIN OVERRIDE] {rejectionReason}";
                await context.SaveChangesAsync();
            }
            
            await LogAdminAction("REJECT_WITHDRAWAL", $"Request #{selectedWithdrawal.RequestId}", 
                $"Rejected withdrawal of ₱{selectedWithdrawal.RequestedAmount:N2}. Reason: {rejectionReason}");
            
            NotificationService.ShowSuccess("Rejected", $"Withdrawal request #{selectedWithdrawal.RequestId} rejected");
            CloseModals();
            await LoadData();
        }
        catch (Exception ex)
        {
            NotificationService.ShowError("Error", $"Failed to reject: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ConfirmApproveBatch()
    {
        if (selectedBatch == null || string.IsNullOrWhiteSpace(approvalReason)) return;
        
        isProcessing = true;
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            var batch = await context.SavingsInterestPostings.FindAsync(selectedBatch.PostingId);
            if (batch != null)
            {
                batch.PostingStatus = "FMApproved";
                batch.ApprovedByFM = AuthService.FullName;
                batch.ApprovedByFMAt = DateTime.Now;
                batch.Notes = $"[ADMIN OVERRIDE] {approvalReason}";
                await context.SaveChangesAsync();
            }
            
            await LogAdminAction("APPROVE_INTEREST_BATCH", $"Batch #{selectedBatch.PostingId}", 
                $"Approved interest batch of ₱{selectedBatch.TotalInterestPosted:N2}. Reason: {approvalReason}");
            
            NotificationService.ShowSuccess("Approved", $"Interest batch #{selectedBatch.PostingId} approved");
            CloseModals();
            await LoadData();
        }
        catch (Exception ex)
        {
            NotificationService.ShowError("Error", $"Failed to approve: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LogAdminAction(string action, string module, string description)
    {
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            var auditLog = new AuditLog
            {
                UserId = AuthService.CurrentUserId?.ToString() ?? "system",
                Action = $"ADMIN_{action}",
                Module = module,
                Description = $"[ADMIN] {description}",
                CreatedAt = DateTime.Now
            };
            context.AuditLogs.Add(auditLog);
            await context.SaveChangesAsync();
        }
        catch { }
    }
}
