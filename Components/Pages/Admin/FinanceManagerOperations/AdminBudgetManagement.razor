@page "/admin/finance-manager/budget-management"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@using Microsoft.EntityFrameworkCore
@using BudgetModel = FinanceBank.Models.Budget
@inject AuthService AuthService
@inject NotificationService NotificationService
@inject IDbContextFactory<BFASDbContext> DbFactory

<div class="page-container" style="padding: 24px;">
    <!-- Page Header -->
    <div style="background: linear-gradient(135deg, #059669 0%, #047857 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 16px;">
                <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
                    <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <div>
                    <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Admin - Budget Management</h1>
                    <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Administrative budget oversight with full audit trail</p>
                </div>
            </div>
            <div style="display: flex; gap: 12px;">
                <button @onclick="RefreshData" style="padding: 10px 20px; background: rgba(255,255,255,0.2); border: 1px solid rgba(255,255,255,0.3); border-radius: 8px; color: white; cursor: pointer; font-weight: 600;">
                    🔄 Refresh
                </button>
                <button @onclick="ShowAddModal" style="padding: 10px 20px; background: white; color: #059669; border: none; border-radius: 8px; cursor: pointer; font-weight: 600;">
                    + Create Budget
                </button>
            </div>
        </div>
    </div>

    <!-- Admin Notice -->
    <div style="background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%); border: 1px solid #f59e0b; border-radius: 12px; padding: 16px; margin-bottom: 24px;">
        <div style="display: flex; align-items: center; gap: 12px;">
            <span style="font-size: 24px;">🔐</span>
            <div>
                <p style="font-weight: 600; color: #92400e; margin: 0;">Administrative Access Mode</p>
                <p style="font-size: 13px; color: #a16207; margin: 4px 0 0 0;">All budget changes require justification. Admin: @(AuthService.FullName ?? "Admin")</p>
            </div>
        </div>
    </div>

    <!-- Budget Summary Cards -->
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 24px;">
        <div style="background: white; border-radius: 16px; padding: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); border-left: 4px solid #3b82f6;">
            <p style="font-size: 13px; color: #6b7280; font-weight: 600; margin: 0;">📊 Total Budgets</p>
            <p style="font-size: 28px; font-weight: 700; color: #3b82f6; margin: 8px 0 0 0;">@totalBudgets</p>
        </div>
        <div style="background: white; border-radius: 16px; padding: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); border-left: 4px solid #059669;">
            <p style="font-size: 13px; color: #6b7280; font-weight: 600; margin: 0;">💰 Total Allocated</p>
            <p style="font-size: 28px; font-weight: 700; color: #059669; margin: 8px 0 0 0;">₱@totalAllocated.ToString("N0")</p>
        </div>
        <div style="background: white; border-radius: 16px; padding: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); border-left: 4px solid #f59e0b;">
            <p style="font-size: 13px; color: #6b7280; font-weight: 600; margin: 0;">📈 Total Spent</p>
            <p style="font-size: 28px; font-weight: 700; color: #f59e0b; margin: 8px 0 0 0;">₱@totalSpent.ToString("N0")</p>
        </div>
        <div style="background: white; border-radius: 16px; padding: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); border-left: 4px solid #059669;">
            <p style="font-size: 13px; color: #6b7280; font-weight: 600; margin: 0;">📉 Remaining</p>
            <p style="font-size: 28px; font-weight: 700; color: #059669; margin: 8px 0 0 0;">₱@totalRemaining.ToString("N0")</p>
        </div>
    </div>

    <!-- Budgets Table -->
    <div style="background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden;">
        <div style="background: linear-gradient(135deg, #059669, #047857); color: white; padding: 20px 24px;">
            <h3 style="font-size: 18px; font-weight: 600; margin: 0;">Budget Categories</h3>
        </div>
        <div style="padding: 24px;">
            @if (isLoading)
            {
                <div style="display: flex; justify-content: center; padding: 60px;">
                    <div style="width: 48px; height: 48px; border: 4px solid #e5e7eb; border-top-color: #059669; border-radius: 50%; animation: spin 1s linear infinite;"></div>
                </div>
            }
            else if (!budgets.Any())
            {
                <div style="text-align: center; padding: 60px; color: #6b7280;">
                    <p style="font-size: 48px; margin-bottom: 16px;">📊</p>
                    <p style="font-size: 16px; font-weight: 500;">No budgets found</p>
                </div>
            }
            else
            {
                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background: #f8fafc;">
                            <th style="padding: 14px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #64748b;">Category</th>
                            <th style="padding: 14px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #64748b;">Period</th>
                            <th style="padding: 14px 16px; text-align: right; font-size: 12px; font-weight: 600; color: #64748b;">Allocated</th>
                            <th style="padding: 14px 16px; text-align: right; font-size: 12px; font-weight: 600; color: #64748b;">Spent</th>
                            <th style="padding: 14px 16px; text-align: right; font-size: 12px; font-weight: 600; color: #64748b;">Remaining</th>
                            <th style="padding: 14px 16px; text-align: center; font-size: 12px; font-weight: 600; color: #64748b;">Usage</th>
                            <th style="padding: 14px 16px; text-align: center; font-size: 12px; font-weight: 600; color: #64748b;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var budget in budgets)
                        {
                            var remaining = budget.AllocatedAmount - budget.SpentAmount;
                            var usage = budget.AllocatedAmount > 0 ? (budget.SpentAmount / budget.AllocatedAmount * 100) : 0;
                            <tr style="border-bottom: 1px solid #e5e7eb;">
                                <td style="padding: 16px; font-size: 14px; color: #1e293b; font-weight: 500;">@budget.BudgetName</td>
                                <td style="padding: 16px; font-size: 14px; color: #64748b;">@budget.Department / @budget.Category</td>
                                <td style="padding: 16px; font-size: 14px; color: #059669; font-weight: 600; text-align: right;">₱@budget.AllocatedAmount.ToString("N2")</td>
                                <td style="padding: 16px; font-size: 14px; color: #f59e0b; font-weight: 600; text-align: right;">₱@budget.SpentAmount.ToString("N2")</td>
                                <td style="padding: 16px; font-size: 14px; font-weight: 600; text-align: right; color: @(remaining >= 0 ? "#3b82f6" : "#dc2626");">₱@remaining.ToString("N2")</td>
                                <td style="padding: 16px; text-align: center;">
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <div style="flex: 1; height: 8px; background: #e5e7eb; border-radius: 4px; overflow: hidden;">
                                            <div style="width: @(Math.Min(usage, 100))%; height: 100%; background: @(usage > 90 ? "#dc2626" : usage > 70 ? "#f59e0b" : "#059669"); transition: width 0.3s;"></div>
                                        </div>
                                        <span style="font-size: 12px; font-weight: 600; color: @(usage > 90 ? "#dc2626" : "#64748b");">@usage.ToString("N0")%</span>
                                    </div>
                                </td>
                                <td style="padding: 16px; text-align: center;">
                                    <button @onclick="() => ShowAdjustModal(budget)" style="padding: 6px 16px; background: #059669; color: white; border: none; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer;">
                                        Adjust
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

<!-- Add Budget Modal -->
@if (showAddModal)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000;">
        <div style="background: white; border-radius: 16px; padding: 32px; width: 500px; max-width: 90%;">
            <h3 style="font-size: 20px; font-weight: 700; color: #1e293b; margin: 0 0 24px 0;">➕ Create New Budget</h3>
            
            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 8px;">Budget Name <span style="color: #dc2626;">*</span></label>
                <input type="text" @bind="newBudget.BudgetName" placeholder="e.g., Marketing Budget Q1" style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;">
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
                <div>
                    <label style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 8px;">Department <span style="color: #dc2626;">*</span></label>
                    <input type="text" @bind="newBudget.Department" placeholder="e.g., Marketing" style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;">
                </div>
                <div>
                    <label style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 8px;">Category</label>
                    <select @bind="newBudget.Category" style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;">
                        <option value="Operating">Operating</option>
                        <option value="Capital">Capital</option>
                        <option value="Project">Project</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
            </div>

            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 8px;">Allocated Amount (₱) <span style="color: #dc2626;">*</span></label>
                <input type="number" @bind="newBudget.AllocatedAmount" step="0.01" style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;">
            </div>

            <div style="margin-bottom: 20px;">
                <label style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 8px;">Admin Justification <span style="color: #dc2626;">*</span></label>
                <textarea @bind="actionReason" rows="3" placeholder="Enter justification for this budget (required)" style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px; resize: vertical;"></textarea>
            </div>

            <div style="display: flex; gap: 12px; justify-content: flex-end;">
                <button @onclick="CloseModals" style="padding: 12px 24px; background: #f3f4f6; color: #374151; border: none; border-radius: 8px; font-weight: 600; cursor: pointer;">
                    Cancel
                </button>
                <button @onclick="SaveBudget" disabled="@(string.IsNullOrWhiteSpace(actionReason) || isProcessing)"
                        style="padding: 12px 24px; background: #7c3aed; color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; @(string.IsNullOrWhiteSpace(actionReason) ? "opacity: 0.5;" : "")">
                    @(isProcessing ? "Creating..." : "Create Budget")
                </button>
            </div>
        </div>
    </div>
}

<!-- Adjust Budget Modal -->
@if (showAdjustModal && selectedBudget != null)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000;">
        <div style="background: white; border-radius: 16px; padding: 32px; width: 500px; max-width: 90%;">
            <h3 style="font-size: 20px; font-weight: 700; color: #1e293b; margin: 0 0 24px 0;">⚙️ Adjust Budget</h3>
            
            <div style="background: #f0fdf4; border: 1px solid #86efac; border-radius: 12px; padding: 16px; margin-bottom: 20px;">
                <p style="font-size: 14px; color: #166534; margin: 0;"><strong>@selectedBudget.BudgetName</strong></p>
                <p style="font-size: 14px; color: #166534; margin: 4px 0 0 0;">Current: ₱@selectedBudget.AllocatedAmount.ToString("N2") | Spent: ₱@selectedBudget.SpentAmount.ToString("N2")</p>
            </div>

            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 8px;">New Allocated Amount (₱)</label>
                <input type="number" @bind="adjustmentAmount" step="0.01" style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;">
            </div>

            <div style="margin-bottom: 20px;">
                <label style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 8px;">Admin Justification <span style="color: #dc2626;">*</span></label>
                <textarea @bind="actionReason" rows="3" placeholder="Enter justification for this adjustment (required)" style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px; resize: vertical;"></textarea>
            </div>

            <div style="display: flex; gap: 12px; justify-content: flex-end;">
                <button @onclick="CloseModals" style="padding: 12px 24px; background: #f3f4f6; color: #374151; border: none; border-radius: 8px; font-weight: 600; cursor: pointer;">
                    Cancel
                </button>
                <button @onclick="ProcessAdjustment" disabled="@(string.IsNullOrWhiteSpace(actionReason) || isProcessing)"
                        style="padding: 12px 24px; background: #7c3aed; color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; @(string.IsNullOrWhiteSpace(actionReason) ? "opacity: 0.5;" : "")">
                    @(isProcessing ? "Adjusting..." : "Confirm Adjustment")
                </button>
            </div>
        </div>
    </div>
}

<style>
    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

@code {
    private List<Budget> budgets = new();
    private Budget newBudget = new() { BudgetName = "", Department = "", Category = "Operating" };
    private Budget? selectedBudget;
    private decimal adjustmentAmount = 0;
    private string actionReason = "";
    
    private int totalBudgets = 0;
    private decimal totalAllocated = 0;
    private decimal totalSpent = 0;
    private decimal totalRemaining = 0;
    
    private bool isLoading = true;
    private bool isProcessing = false;
    private bool showAddModal = false;
    private bool showAdjustModal = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        await LogAdminAction("VIEW", "Budget Management", "Admin accessed Budget Management page");
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            budgets = await context.Budgets.OrderByDescending(b => b.StartDate).ThenBy(b => b.Category).ToListAsync();
            
            totalBudgets = budgets.Count;
            totalAllocated = budgets.Sum(b => b.AllocatedAmount);
            totalSpent = budgets.Sum(b => b.SpentAmount);
            totalRemaining = totalAllocated - totalSpent;
        }
        catch (Exception ex)
        {
            NotificationService.ShowError("Error", $"Failed to load budgets: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RefreshData()
    {
        await LoadData();
        NotificationService.ShowSuccess("Refreshed", "Data refreshed successfully");
    }

    private void ShowAddModal()
    {
        newBudget = new Budget { BudgetName = "", Department = "", Category = "Operating" };
        actionReason = "";
        showAddModal = true;
    }

    private void ShowAdjustModal(BudgetModel budget)
    {
        selectedBudget = budget;
        adjustmentAmount = budget.AllocatedAmount;
        actionReason = "";
        showAdjustModal = true;
    }

    private void CloseModals()
    {
        showAddModal = false;
        showAdjustModal = false;
        selectedBudget = null;
        actionReason = "";
    }

    private async Task SaveBudget()
    {
        if (string.IsNullOrWhiteSpace(actionReason)) return;
        
        isProcessing = true;
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            
            newBudget.SpentAmount = 0;
            newBudget.RemainingAmount = newBudget.AllocatedAmount;
            newBudget.StartDate = DateTime.Today;
            newBudget.EndDate = DateTime.Today.AddYears(1);
            newBudget.Status = "Active";
            newBudget.CreatedBy = $"ADMIN:{AuthService.FullName}";
            newBudget.CreatedAt = DateTime.Now;
            
            context.Budgets.Add(newBudget);
            await context.SaveChangesAsync();
            
            await LogAdminAction("CREATE_BUDGET", $"Budget: {newBudget.BudgetName}", 
                $"Created budget {newBudget.BudgetName} - ₱{newBudget.AllocatedAmount:N2}. Justification: {actionReason}");
            
            NotificationService.ShowSuccess("Success", $"Budget '{newBudget.BudgetName}' created successfully");
            CloseModals();
            await LoadData();
        }
        catch (Exception ex)
        {
            NotificationService.ShowError("Error", $"Failed to create budget: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ProcessAdjustment()
    {
        if (selectedBudget == null || string.IsNullOrWhiteSpace(actionReason)) return;
        
        isProcessing = true;
        try
        {
            var oldAmount = selectedBudget.AllocatedAmount;
            
            using var context = await DbFactory.CreateDbContextAsync();
            var budget = await context.Budgets.FindAsync(selectedBudget.BudgetId);
            if (budget != null)
            {
                budget.AllocatedAmount = adjustmentAmount;
                budget.RemainingAmount = adjustmentAmount - budget.SpentAmount;
                await context.SaveChangesAsync();
            }
            
            await LogAdminAction("ADJUST_BUDGET", $"Budget: {selectedBudget.BudgetName}", 
                $"Adjusted budget from ₱{oldAmount:N2} to ₱{adjustmentAmount:N2}. Justification: {actionReason}");
            
            NotificationService.ShowSuccess("Success", $"Budget adjusted successfully");
            CloseModals();
            await LoadData();
        }
        catch (Exception ex)
        {
            NotificationService.ShowError("Error", $"Failed to adjust budget: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LogAdminAction(string action, string module, string description)
    {
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            var auditLog = new AuditLog
            {
                UserId = AuthService.CurrentUserId?.ToString() ?? "system",
                Action = $"ADMIN_{action}",
                Module = module,
                Description = $"[ADMIN] {description}",
                CreatedAt = DateTime.Now
            };
            context.AuditLogs.Add(auditLog);
            await context.SaveChangesAsync();
        }
        catch { }
    }
}
