@page "/admin/teller/account-inquiry"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@using Microsoft.EntityFrameworkCore
@using FinanceBank.Data
@inject AuthService AuthService
@inject IDbContextFactory<BFASDbContext> DbContextFactory
@inject CustomerTransactionService CustomerTransactionService
@inject NavigationManager Navigation

<div class="admin-page">
    <!-- Header with Gradient -->
    <div style="background: linear-gradient(135deg, #3b82f6, #2563eb); border-radius: 16px; padding: 24px; margin-bottom: 24px; color: white;">
        <div style="display: flex; align-items: center; gap: 12px;">
            <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.35-4.35"></path>
            </svg>
            <div>
                <h1 style="font-size: 20px; font-weight: 700; margin: 0;">Account Inquiry (Admin)</h1>
                <p style="margin: 4px 0 0; opacity: 0.9; font-size: 13px;">Search and view detailed account information</p>
            </div>
        </div>
    </div>

    <!-- Search Form Card -->
    <div style="background: white; border-radius: 16px; padding: 32px; border: 1px solid #e5e7eb; margin-bottom: 24px;">
        <h3 style="margin: 0 0 24px; font-size: 18px; font-weight: 700; color: #1f2937;">Search Account</h3>
                <div class="form-group">
                    <label>Reason for Admin Inquiry <span class="required">*</span></label>
                    <textarea @bind="adminReason" class="form-control" rows="2" 
                        placeholder="Enter reason for this inquiry..."></textarea>
                </div>
                <hr />
                <div class="form-row">
                    <div class="form-group col-md-8">
                        <label>Account Number or Customer Name</label>
                        <input type="text" @bind="searchQuery" class="form-control" placeholder="Enter account number or customer name..." />
                    </div>
                    <div class="form-group col-md-4" style="display: flex; align-items: flex-end;">
                        <button class="btn btn-primary" @onclick="SearchAccount" style="width: 100%;">
                            <svg style="width: 16px; height: 16px; margin-right: 8px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="11" cy="11" r="8"></circle>
                                <path d="m21 21-4.35-4.35"></path>
                            </svg>
                            Search
                        </button>
                    </div>
                </div>
    </div>

    @if (accountFound)
    {
            <div class="admin-card" style="margin-top: 24px;">
                <div class="card-header">
                <h3>Account Details</h3>
            </div>
            <div class="card-body">
                <div class="account-details-grid">
                    <div class="detail-item">
                        <label>Account Number</label>
                        <span>@selectedAccount?.AccountNumber</span>
                    </div>
                    <div class="detail-item">
                        <label>Customer Name</label>
                        <span>@selectedAccount?.Customer?.FullName</span>
                    </div>
                    <div class="detail-item">
                        <label>Account Status</label>
                        <span>@selectedAccount?.Status</span>
                    </div>
                    <div class="detail-item">
                        <label>Current Balance</label>
                        <span style="color: #10b981; font-size: 1.5em; font-weight: 700;">₱@selectedAccount?.Balance.ToString("N2")</span>
                    </div>
                    <div class="detail-item">
                        <label>Status</label>
                        <span class="badge @GetStatusClass(selectedAccount?.IsActive == true ? "Active" : "Inactive")">
                            @(selectedAccount?.IsActive == true ? "Active" : "Inactive")
                        </span>
                    </div>
                    <div class="detail-item">
                        <label>Date Opened</label>
                        <span>@selectedAccount?.CreatedAt.ToString("MMMM dd, yyyy")</span>
                    </div>
                    <div class="detail-item">
                        <label>Last Transaction</label>
                        <span>
                            @(recentTransactions.Any() ? recentTransactions.First().CreatedAt.ToString("MMM dd, yyyy HH:mm") : "N/A")
                        </span>
                    </div>
                    <div class="detail-item">
                        <label>Currency</label>
                        <span>@selectedAccount?.Currency</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="admin-card" style="margin-top: 24px;">
            <div class="card-header">
                <h3>Recent Transactions</h3>
            </div>
            <div class="card-body">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Description</th>
                            <th>Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var txn in recentTransactions)
                        {
                            <tr>
                                <td>@txn.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                <td>@txn.TransactionType</td>
                                <td>@(txn.Description ?? txn.Reference ?? "-")</td>
                                <td class="@(txn.Amount > 0 ? "text-success" : "text-danger")">
                                    @(txn.Amount > 0 ? "+" : "")₱@Math.Abs(txn.Amount).ToString("N2")
                                </td>
                                <td>@txn.Status</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div> <!-- Close admin-page -->

<style>
    .account-details-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 24px;
    }
    .detail-item {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    .detail-item label {
        font-size: 0.85em;
        color: #6b7280;
        font-weight: 500;
    }
    .detail-item span {
        font-size: 1em;
        color: #1f2937;
        font-weight: 600;
    }
</style>

@code {
    private string searchQuery = "";
    private string adminReason = "";
    private bool accountFound = false;
    private CustomerAccount? selectedAccount;
    private List<CustomerTransaction> recentTransactions = new();

    protected override void OnInitialized()
    {
        if (!AuthService.HasRole(AuthService.Roles.SuperAdmin))
        {
            Navigation.NavigateTo("/admin/dashboard");
        }

        // Check for query parameter
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var accountParam = query["account"];
        if (!string.IsNullOrEmpty(accountParam))
        {
            searchQuery = accountParam;
            _ = SearchAccount();
        }
    }

    private async Task SearchAccount()
    {
        if (string.IsNullOrWhiteSpace(searchQuery)) return;

        try
        {
            using var context = await DbContextFactory.CreateDbContextAsync();
            
            // Search by account number or customer name
            selectedAccount = await context.CustomerAccounts
                .Include(ca => ca.Customer)
                .Where(ca => ca.AccountNumber.Contains(searchQuery) || 
                            (ca.Customer != null && ca.Customer.FullName.Contains(searchQuery)))
                .FirstOrDefaultAsync();

            if (selectedAccount != null)
            {
                var accountId = selectedAccount.AccountId;
                // Load recent transactions outside the context's using block
                recentTransactions = await CustomerTransactionService.GetByAccountIdAsync(accountId);
                accountFound = true;
            }
            else
            {
                accountFound = false;
                recentTransactions = new();
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error searching account: {ex.Message}");
            accountFound = false;
            recentTransactions = new();
        }
    }

    private string GetStatusClass(string status) => status switch
    {
        "Active" => "badge-success",
        "Inactive" => "badge-secondary",
        "Frozen" => "badge-danger",
        _ => "badge-secondary"
    };
}
