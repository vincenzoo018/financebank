@page "/admin/teller/cash-summary"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@using Microsoft.EntityFrameworkCore
@inject AuthService AuthService
@inject IDbContextFactory<BFASDbContext> DbContextFactory

<!-- Page Header -->
<!-- Header Title Card -->
<div
    style="background: linear-gradient(135deg, rgba(34, 197, 94, 0.1), rgba(22, 163, 74, 0.15)); border: 1px solid rgba(34, 197, 94, 0.3); border-radius: 16px; padding: 28px; margin-bottom: 20px; color: #15803d;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
                <svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <line x1="12" y1="1" x2="12" y2="23"></line>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                </svg>
            </div>
            <div>
                <h1 style="font-size: 22px; font-weight: 700; margin: 0;">Cash Summary (Admin)</h1>
                <p style="font-size: 14px; color: rgba(21,128,61,0.85); margin: 4px 0 0 0;">Cash position and
                    denomination - SuperAdmin Access</p>
            </div>
        </div>
        <div style="display: flex; gap: 12px;">
            <button @onclick="PrintSummary"
                style="display: flex; align-items: center; gap: 8px; padding: 10px 20px; background: rgba(255,255,255,0.2); border: 1px solid rgba(255,255,255,0.3); border-radius: 8px; color: #15803d; cursor: pointer; font-weight: 600;">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <polyline points="6 9 6 2 18 2 18 9"></polyline>
                    <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                    <rect x="6" y="14" width="12" height="8"></rect>
                </svg>
                Print
            </button>
        </div>
    </div>
</div>

<!-- Admin Notice -->
<div style="background: #fef3c7; border: 1px solid #f59e0b; border-radius: 12px; padding: 16px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 12px;">
        <span style="font-size: 24px;">⚠️</span>
        <div>
            <p style="margin: 0; font-weight: 600; color: #92400e;">Administrative Access</p>
            <p style="margin: 4px 0 0; font-size: 13px; color: #a16207;">You are viewing and managing cash summary as
                SuperAdmin</p>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div style="display: flex; justify-content: center; align-items: center; padding: 60px;">
        <div
            style="width: 40px; height: 40px; border: 4px solid #e5e7eb; border-top-color: #059669; border-radius: 50%; animation: spin 1s linear infinite;">
        </div>
    </div>
    <style>
        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }
    </style>
}
else
{
    <!-- Cash Position Summary -->
    <div
        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 24px;">
        <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb;">
            <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 8px;">Opening Cash</div>
            <div style="font-size: 32px; font-weight: 700; color: #2563eb; margin-bottom: 4px;">₱@openingCash.ToString("N2")
            </div>
            <div style="font-size: 12px; color: #6b7280;">Start of day balance</div>
        </div>
        <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb;">
            <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 8px;">Cash Received</div>
            <div style="font-size: 32px; font-weight: 700; color: #059669; margin-bottom: 4px;">
                ₱@cashReceived.ToString("N2")</div>
            <div style="font-size: 12px; color: #6b7280;">@depositCount deposits</div>
        </div>
        <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb;">
            <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 8px;">Cash Disbursed</div>
            <div style="font-size: 32px; font-weight: 700; color: #dc2626; margin-bottom: 4px;">
                ₱@cashDisbursed.ToString("N2")</div>
            <div style="font-size: 12px; color: #6b7280;">@withdrawalCount withdrawals</div>
        </div>
        <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb;">
            <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 8px;">Closing Cash</div>
            <div
                style="font-size: 32px; font-weight: 700; color: @(closingCash >= 0 ? "#059669" : "#dc2626"); margin-bottom: 4px;">
                ₱@closingCash.ToString("N2")</div>
            <div style="font-size: 12px; color: #6b7280;">Current balance</div>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 24px;">
        <!-- Cash Denomination -->
        <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
            <h2
                style="font-size: 18px; font-weight: 600; color: #111827; margin-bottom: 16px; display: flex; align-items: center; gap: 8px;">
                <svg width="20" height="20" fill="none" stroke="#059669" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </svg>
                Cash Denomination
            </h2>
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="background: #f9fafb; border-bottom: 1px solid #e5e7eb;">
                        <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280; font-weight: 600;">
                            DENOMINATION</th>
                        <th style="padding: 12px; text-align: center; font-size: 12px; color: #6b7280; font-weight: 600;">
                            COUNT</th>
                        <th style="padding: 12px; text-align: right; font-size: 12px; color: #6b7280; font-weight: 600;">
                            TOTAL</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var denom in denominations)
                    {
                        var denomValue = denom.Value;
                        <tr style="border-bottom: 1px solid #e5e7eb;">
                            <td style="padding: 12px; font-size: 14px; color: #111827; font-weight: 500;">
                                ₱@denom.Value.ToString("N0")</td>
                            <td style="padding: 12px; text-align: center;">
                                <input type="number" min="0" value="@denom.Count"
                                    @onchange="@(e => HandleDenominationChange(denomValue, e))"
                                    style="width: 80px; padding: 8px; border: 1px solid #e5e7eb; border-radius: 6px; text-align: center; font-size: 14px;" />
                            </td>
                            <td style="padding: 12px; text-align: right; font-size: 14px; color: #111827; font-weight: 600;">
                                ₱@((denom.Value * denom.Count).ToString("N0"))</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr style="background: #f0fdf4;">
                        <td colspan="2" style="padding: 12px; font-size: 14px; font-weight: 700; color: #111827;">TOTAL</td>
                        <td style="padding: 12px; text-align: right; font-size: 16px; font-weight: 700; color: #059669;">
                            ₱@totalDenomination.ToString("N0")</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- Cash Reconciliation -->
        <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
            <h2
                style="font-size: 18px; font-weight: 600; color: #111827; margin-bottom: 16px; display: flex; align-items: center; gap: 8px;">
                <svg width="20" height="20" fill="none" stroke="#2563eb" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"></path>
                    <rect x="9" y="3" width="6" height="4" rx="1" ry="1"></rect>
                    <path d="M9 12h6"></path>
                    <path d="M9 16h6"></path>
                </svg>
                Cash Reconciliation
            </h2>

            <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 20px;">
                <div
                    style="display: flex; justify-content: space-between; padding: 12px; background: #f9fafb; border-radius: 8px;">
                    <span style="color: #6b7280;">Expected Cash</span>
                    <span style="font-weight: 600; color: #111827;">₱@closingCash.ToString("N2")</span>
                </div>
                <div
                    style="display: flex; justify-content: space-between; padding: 12px; background: #f9fafb; border-radius: 8px;">
                    <span style="color: #6b7280;">Actual Cash (Counted)</span>
                    <span style="font-weight: 600; color: #111827;">₱@totalDenomination.ToString("N2")</span>
                </div>
                <div
                    style="display: flex; justify-content: space-between; padding: 12px; background: @(variance == 0 ? "#f0fdf4" : "#fef2f2"); border-radius: 8px;">
                    <span style="color: @(variance == 0 ? "#065f46" : "#991b1b"); font-weight: 600;">Variance</span>
                    <span
                        style="font-weight: 700; color: @(variance == 0 ? "#059669" : "#dc2626");">₱@variance.ToString("N2")</span>
                </div>
            </div>

            @if (variance == 0)
            {
                <div style="background: #d1fae5; border-radius: 12px; padding: 16px; text-align: center;">
                    <svg width="32" height="32" fill="none" stroke="#059669" stroke-width="2" viewBox="0 0 24 24"
                        style="margin: 0 auto 8px;">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                    <p style="color: #065f46; font-weight: 600; margin: 0;">Cash Balanced</p>
                    <p style="color: #047857; font-size: 13px; margin: 4px 0 0;">No variance detected</p>
                </div>
            }
            else
            {
                <div style="background: #fee2e2; border-radius: 12px; padding: 16px; text-align: center;">
                    <svg width="32" height="32" fill="none" stroke="#dc2626" stroke-width="2" viewBox="0 0 24 24"
                        style="margin: 0 auto 8px;">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    <p style="color: #991b1b; font-weight: 600; margin: 0;">Cash Imbalance</p>
                    <p style="color: #b91c1c; font-size: 13px; margin: 4px 0 0;">@(variance > 0 ? "Over" : "Short") by
                        ₱@Math.Abs(variance).ToString("N2")</p>
                </div>
            }

            <div style="margin-top: 20px;">
                <button @onclick="SaveReconciliation"
                    style="width: 100%; padding: 14px; background: linear-gradient(135deg, #059669, #047857); color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer;">
                    Save Reconciliation
                </button>
            </div>
        </div>
    </div>

    <!-- Transaction Breakdown -->
    <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
        <h2 style="font-size: 18px; font-weight: 600; color: #111827; margin-bottom: 16px;">Today's Cash Movement</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px;">
            <div style="background: #f0fdf4; border-radius: 12px; padding: 16px; border: 1px solid #bbf7d0;">
                <div style="font-size: 12px; font-weight: 600; color: #065f46; margin-bottom: 4px;">Cash Deposits</div>
                <div style="font-size: 24px; font-weight: 700; color: #059669;">₱@cashReceived.ToString("N0")</div>
            </div>
            <div style="background: #fef2f2; border-radius: 12px; padding: 16px; border: 1px solid #fecaca;">
                <div style="font-size: 12px; font-weight: 600; color: #991b1b; margin-bottom: 4px;">Cash Withdrawals</div>
                <div style="font-size: 24px; font-weight: 700; color: #dc2626;">₱@cashDisbursed.ToString("N0")</div>
            </div>
            <div style="background: #eff6ff; border-radius: 12px; padding: 16px; border: 1px solid #bfdbfe;">
                <div style="font-size: 12px; font-weight: 600; color: #1e40af; margin-bottom: 4px;">Loan Disbursements</div>
                <div style="font-size: 24px; font-weight: 700; color: #2563eb;">₱@loanDisbursements.ToString("N0")</div>
            </div>
            <div style="background: #fef3c7; border-radius: 12px; padding: 16px; border: 1px solid #fde68a;">
                <div style="font-size: 12px; font-weight: 600; color: #92400e; margin-bottom: 4px;">Loan Payments Received
                </div>
                <div style="font-size: 24px; font-weight: 700; color: #d97706;">₱@loanPaymentsReceived.ToString("N0")</div>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;

    private decimal openingCash = 100000;
    private decimal cashReceived = 0;
    private decimal cashDisbursed = 0;
    private decimal closingCash = 0;
    private decimal loanDisbursements = 0;
    private decimal loanPaymentsReceived = 0;

    private int depositCount = 0;
    private int withdrawalCount = 0;

    private List<DenominationItem> denominations = new()
{
new() { Value = 1000, Count = 50 },
new() { Value = 500, Count = 40 },
new() { Value = 200, Count = 30 },
new() { Value = 100, Count = 50 },
new() { Value = 50, Count = 40 },
new() { Value = 20, Count = 50 },
new() { Value = 10, Count = 30 },
new() { Value = 5, Count = 20 },
new() { Value = 1, Count = 50 }
};

    private decimal totalDenomination => denominations.Sum(d => d.Value * d.Count);
    private decimal variance => totalDenomination - closingCash;

    protected override async Task OnInitializedAsync()
    {
        await LoadCashData();
    }

    private async Task LoadCashData()
    {
        isLoading = true;
        try
        {
            using var context = await DbContextFactory.CreateDbContextAsync();
            var today = DateTime.Today;

            // Get today's deposits
            var deposits = await context.CustomerTransactions
            .Where(t => t.TransactionType == "Deposit" && t.CreatedAt.Date == today && t.Status == "Completed")
            .ToListAsync();
            cashReceived = deposits.Sum(t => t.Amount);
            depositCount = deposits.Count;

            // Get today's withdrawals
            var withdrawals = await context.CustomerTransactions
            .Where(t => t.TransactionType == "Withdrawal" && t.CreatedAt.Date == today && t.Status == "Completed")
            .ToListAsync();
            cashDisbursed = withdrawals.Sum(t => t.Amount);
            withdrawalCount = withdrawals.Count;

            // Get loan disbursements (from assessments)
            loanDisbursements = await context.LoanAssessments
            .Where(l => l.AssessmentDate.Date == today)
            .SumAsync(l => (decimal?)l.LoanAmount) ?? 0;

            // Get loan payments
            loanPaymentsReceived = await context.LoanPayments
            .Where(p => p.PaymentDate.Date == today)
            .SumAsync(p => (decimal?)p.PaymentAmount) ?? 0;

            // Calculate closing cash
            closingCash = openingCash + cashReceived + loanPaymentsReceived - cashDisbursed - loanDisbursements;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading cash data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void HandleDenominationChange(int denomValue, ChangeEventArgs e)
    {
        var countStr = e.Value?.ToString() ?? "0";
        if (int.TryParse(countStr, out int count))
        {
            UpdateDenomination(denomValue, count);
        }
    }

    private void UpdateDenomination(int value, int count)
    {
        var denom = denominations.FirstOrDefault(d => d.Value == value);
        if (denom != null)
        {
            denom.Count = count;
        }
    }

    private void PrintSummary()
    {
        // Print functionality
    }

    private void SaveReconciliation()
    {
        // Save reconciliation to database
    }

    private class DenominationItem
    {
        public int Value { get; set; }
        public int Count { get; set; }
    }
}