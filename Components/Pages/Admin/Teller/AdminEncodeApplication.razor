@page "/admin/teller/encode-application"
@layout AdminLayout
@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="admin-page">
    <div class="page-header">
        <h1 style="color: #10b981;">
            <svg style="width: 32px; height: 32px; margin-right: 12px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
            </svg>
            Encode Loan Application (Admin)
        </h1>
        <p class="page-subtitle">Process new loan applications with admin oversight</p>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success")">@message</div>
    }

    <div class="admin-card">
        <div class="card-header">
            <h3>New Loan Application</h3>
        </div>
        <div class="card-body">
            <div class="form-group">
                <label>Admin Reason <span class="required">*</span></label>
                <textarea @bind="adminReason" class="form-control" rows="2" 
                    placeholder="Enter reason for encoding this loan application..."></textarea>
            </div>
            <hr />
            
            <h5>Customer Information</h5>
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label>Customer Account Number</label>
                    <input type="text" @bind="customerAccount" class="form-control" placeholder="Enter customer account" />
                </div>
                <div class="form-group col-md-6">
                    <label>Customer Name</label>
                    <input type="text" @bind="customerName" class="form-control" placeholder="Full name" />
                </div>
            </div>
            
            <h5 style="margin-top: 24px;">Loan Details</h5>
            <div class="form-row">
                <div class="form-group col-md-4">
                    <label>Loan Type</label>
                    <select @bind="loanType" class="form-control">
                        <option value="">Select Loan Type</option>
                        <option value="Personal">Personal Loan</option>
                        <option value="Home">Home Loan</option>
                        <option value="Auto">Auto Loan</option>
                        <option value="Business">Business Loan</option>
                        <option value="Education">Education Loan</option>
                    </select>
                </div>
                <div class="form-group col-md-4">
                    <label>Requested Amount</label>
                    <div class="input-group">
                        <span class="input-group-text">₱</span>
                        <input type="number" @bind="requestedAmount" class="form-control" step="1000" min="0" />
                    </div>
                </div>
                <div class="form-group col-md-4">
                    <label>Term (Months)</label>
                    <select @bind="loanTerm" class="form-control">
                        <option value="12">12 Months</option>
                        <option value="24">24 Months</option>
                        <option value="36">36 Months</option>
                        <option value="48">48 Months</option>
                        <option value="60">60 Months</option>
                    </select>
                </div>
            </div>
            
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label>Purpose of Loan</label>
                    <textarea @bind="loanPurpose" class="form-control" rows="2" placeholder="Describe the purpose..."></textarea>
                </div>
                <div class="form-group col-md-6">
                    <label>Collateral (if any)</label>
                    <textarea @bind="collateral" class="form-control" rows="2" placeholder="Describe collateral..."></textarea>
                </div>
            </div>
            
            <h5 style="margin-top: 24px;">Employment Information</h5>
            <div class="form-row">
                <div class="form-group col-md-4">
                    <label>Employment Status</label>
                    <select @bind="employmentStatus" class="form-control">
                        <option value="Employed">Employed</option>
                        <option value="Self-Employed">Self-Employed</option>
                        <option value="Business Owner">Business Owner</option>
                    </select>
                </div>
                <div class="form-group col-md-4">
                    <label>Monthly Income</label>
                    <div class="input-group">
                        <span class="input-group-text">₱</span>
                        <input type="number" @bind="monthlyIncome" class="form-control" step="1000" min="0" />
                    </div>
                </div>
                <div class="form-group col-md-4">
                    <label>Years Employed</label>
                    <input type="number" @bind="yearsEmployed" class="form-control" min="0" />
                </div>
            </div>
            
            <div class="form-actions">
                <button class="btn btn-secondary" @onclick="ClearForm">Clear</button>
                <button class="btn btn-primary" @onclick="SubmitApplication" disabled="@isSubmitting">
                    @if (isSubmitting) { <span class="spinner-border spinner-border-sm"></span> }
                    Submit Application
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private string adminReason = "";
    private string customerAccount = "";
    private string customerName = "";
    private string loanType = "";
    private decimal requestedAmount = 0;
    private int loanTerm = 12;
    private string loanPurpose = "";
    private string collateral = "";
    private string employmentStatus = "Employed";
    private decimal monthlyIncome = 0;
    private int yearsEmployed = 0;
    
    private bool isSubmitting = false;
    private string message = "";
    private bool isError = false;

    protected override void OnInitialized()
    {
        if (!AuthService.HasRole(AuthService.Roles.SuperAdmin))
        {
            Navigation.NavigateTo("/admin/dashboard");
        }
    }

    private async Task SubmitApplication()
    {
        message = "";
        
        if (string.IsNullOrWhiteSpace(adminReason))
        {
            message = "Admin reason is required.";
            isError = true;
            return;
        }
        
        if (string.IsNullOrWhiteSpace(customerAccount) || string.IsNullOrWhiteSpace(loanType) || requestedAmount <= 0)
        {
            message = "Please fill in all required fields.";
            isError = true;
            return;
        }

        isSubmitting = true;
        try
        {
            await Task.Delay(1000); // Simulate API call
            message = "Loan application submitted successfully. Application ID: LA-" + DateTime.Now.Ticks.ToString().Substring(10);
            isError = false;
            ClearForm();
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
            isError = true;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ClearForm()
    {
        customerAccount = "";
        customerName = "";
        loanType = "";
        requestedAmount = 0;
        loanTerm = 12;
        loanPurpose = "";
        collateral = "";
        monthlyIncome = 0;
        yearsEmployed = 0;
    }
}
