@page "/admin/teller/encode-application"
@layout AdminLayout
@using Microsoft.EntityFrameworkCore
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IDbContextFactory<BFASDbContext> DbContextFactory

<div class="sidebar-content">
    <!-- Page Header - Matching Teller page style -->
    <div class="card" style="margin-bottom: 24px;">
        <div class="card-header"
            style="background: linear-gradient(135deg, #10b981, #059669); color: white; padding: 24px; border-radius: 12px 12px 0 0;">
            <div style="display: flex; align-items: center; gap: 16px;">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                </svg>
                <div>
                    <h1 style="font-size: 24px; font-weight: 700; margin: 0;">Encode Loan Application</h1>
                    <p style="margin: 4px 0 0; opacity: 0.9; font-size: 14px;">Process new loan applications</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Admin Notice -->
    <div
        style="background: #ede9fe; border: 1px solid #8b5cf6; border-radius: 12px; padding: 16px; margin-bottom: 24px;">
        <div style="display: flex; align-items: start; gap: 12px;">
            <span style="font-size: 24px;">🔐</span>
            <div style="flex: 1;">
                <p style="margin: 0; font-weight: 600; color: #5b21b6;">SuperAdmin Access - Teller Functions</p>
                <p style="margin: 4px 0 0; font-size: 13px; color: #7c3aed;">You are encoding a loan application as
                    SuperAdmin. All actions are logged for audit purposes.</p>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div
            style="background: @(isError ? "#fef2f2" : "#d1fae5"); border: 1px solid @(isError ? "#fecaca" : "#a7f3d0"); border-radius: 12px; padding: 16px; margin-bottom: 20px; color: @(isError ? "#dc2626" : "#059669");">
            @message
        </div>
    }

    <div class="card" style="border-radius: 16px; border: 1px solid #e5e7eb;">
        <div class="card-body" style="padding: 24px;">
            <div style="margin-bottom: 24px;">
                <label
                    style="display: block; font-size: 14px; font-weight: 600; margin-bottom: 8px; color: #374151;">Admin
                    Reason <span style="color: #dc2626;">*</span></label>
                <textarea @bind="adminReason"
                    style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;"
                    rows="2" placeholder="Enter reason for encoding this loan application..."></textarea>
            </div>

            <hr style="border: none; border-top: 1px solid #e5e7eb; margin: 24px 0;" />

            <h5 style="font-size: 16px; font-weight: 600; color: #111827; margin-bottom: 16px;">Customer Selection</h5>
            <div
                style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 16px; margin-bottom: 24px;">
                <div>
                    <label
                        style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: #6b7280;">Search
                        Customer</label>
                    <input type="text" @bind="customerSearch" @bind:event="oninput"
                        style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;"
                        placeholder="Search by name or account number..." />
                </div>
                <div>
                    <label
                        style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: #6b7280;">Select
                        Customer Account</label>
                    <select @bind="selectedAccountId"
                        style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;">
                        <option value="0">-- Select Customer --</option>
                        @foreach (var account in filteredAccounts)
                        {
                            <option value="@account.AccountId">@account.AccountNumber - @account.CustomerName</option>
                        }
                    </select>
                </div>
            </div>

            <h5 style="font-size: 16px; font-weight: 600; color: #111827; margin-bottom: 16px;">Loan Details</h5>
            <div
                style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">
                <div>
                    <label
                        style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: #6b7280;">Loan
                        Type</label>
                    <select @bind="loanType"
                        style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;">
                        <option value="">Select Loan Type</option>
                        <option value="Personal">Personal Loan</option>
                        <option value="Home">Home Loan</option>
                        <option value="Auto">Auto Loan</option>
                        <option value="Business">Business Loan</option>
                        <option value="Education">Education Loan</option>
                        <option value="Emergency">Emergency Loan</option>
                    </select>
                </div>
                <div>
                    <label
                        style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: #6b7280;">Requested
                        Amount</label>
                    <div style="display: flex; align-items: center;">
                        <span
                            style="background: #f3f4f6; padding: 10px 12px; border: 1px solid #e5e7eb; border-right: none; border-radius: 8px 0 0 8px; font-size: 14px;">₱</span>
                        <input type="number" @bind="requestedAmount"
                            style="flex: 1; padding: 10px; border: 1px solid #e5e7eb; border-radius: 0 8px 8px 0; font-size: 14px;"
                            step="1000" min="0" />
                    </div>
                </div>
                <div>
                    <label
                        style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: #6b7280;">Term
                        (Months)</label>
                    <select @bind="loanTerm"
                        style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;">
                        <option value="6">6 Months</option>
                        <option value="12">12 Months</option>
                        <option value="24">24 Months</option>
                        <option value="36">36 Months</option>
                        <option value="48">48 Months</option>
                        <option value="60">60 Months</option>
                    </select>
                </div>
            </div>

            <div
                style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">
                <div>
                    <label
                        style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: #6b7280;">Interest
                        Rate (%)</label>
                    <input type="number" @bind="interestRate"
                        style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;"
                        step="0.1" min="0" max="30" />
                </div>
                <div>
                    <label
                        style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: #6b7280;">Estimated
                        Monthly Payment</label>
                    <div style="display: flex; align-items: center;">
                        <span
                            style="background: #f3f4f6; padding: 10px 12px; border: 1px solid #e5e7eb; border-right: none; border-radius: 8px 0 0 8px; font-size: 14px;">₱</span>
                        <input type="text" value="@CalculateMonthlyPayment().ToString("N2")"
                            style="flex: 1; padding: 10px; border: 1px solid #e5e7eb; border-radius: 0 8px 8px 0; font-size: 14px; background: #f9fafb;"
                            readonly />
                    </div>
                </div>
                <div>
                    <label
                        style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: #6b7280;">Priority</label>
                    <select @bind="priority"
                        style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;">
                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>
                        <option value="Urgent">Urgent</option>
                    </select>
                </div>
            </div>

            <div
                style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 16px; margin-bottom: 24px;">
                <div>
                    <label
                        style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: #6b7280;">Purpose
                        of Loan</label>
                    <textarea @bind="loanPurpose"
                        style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;"
                        rows="2" placeholder="Describe the purpose..."></textarea>
                </div>
                <div>
                    <label
                        style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: #6b7280;">Notes
                        / Comments</label>
                    <textarea @bind="notes"
                        style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;"
                        rows="2" placeholder="Additional notes..."></textarea>
                </div>
            </div>

            <div style="display: flex; gap: 12px; justify-content: flex-end;">
                <button @onclick="ClearForm"
                    style="padding: 12px 24px; background: #f3f4f6; color: #374151; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer;">Clear</button>
                <button @onclick="SubmitApplication" disabled="@isSubmitting"
                    style="padding: 12px 24px; background: @(isSubmitting ? "#9ca3af" : "#10b981"); color: white; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: @(isSubmitting ? "not-allowed" : "pointer");">
                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    Submit Application
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private string adminReason = "";
    private string customerSearch = "";
    private int selectedAccountId = 0;
    private string loanType = "";
    private decimal requestedAmount = 0;
    private int loanTerm = 12;
    private decimal interestRate = 5.0m;
    private string priority = "Medium";
    private string loanPurpose = "";
    private string notes = "";

    private bool isSubmitting = false;
    private string message = "";
    private bool isError = false;

    private List<CustomerAccountInfo> customerAccounts = new();
    private List<CustomerAccountInfo> filteredAccounts => customerAccounts
    .Where(a => string.IsNullOrEmpty(customerSearch) ||
    a.CustomerName.Contains(customerSearch, StringComparison.OrdinalIgnoreCase) ||
    a.AccountNumber.Contains(customerSearch, StringComparison.OrdinalIgnoreCase))
    .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.HasRole(AuthService.Roles.SuperAdmin))
        {
            Navigation.NavigateTo("/admin/dashboard");
            return;
        }

        await LoadCustomerAccounts();
    }

    private async Task LoadCustomerAccounts()
    {
        try
        {
            using var context = DbContextFactory.CreateDbContext();
            customerAccounts = await context.CustomerAccounts
            .Where(a => a.IsActive)
            .Join(context.Users,
            a => a.CustomerId,
            u => u.UserId,
            (a, u) => new CustomerAccountInfo
            {
                AccountId = a.AccountId,
                CustomerId = a.CustomerId,
                AccountNumber = a.AccountNumber,
                CustomerName = u.FullName
            })
            .ToListAsync();
        }
        catch (Exception ex)
        {
            message = $"Error loading accounts: {ex.Message}";
            isError = true;
        }
    }

    private decimal CalculateMonthlyPayment()
    {
        if (requestedAmount <= 0 || loanTerm <= 0 || interestRate <= 0) return 0;

        var monthlyRate = interestRate / 100 / 12;
        var monthlyPayment = requestedAmount *
        (monthlyRate * (decimal)Math.Pow((double)(1 + monthlyRate), loanTerm)) /
        ((decimal)Math.Pow((double)(1 + monthlyRate), loanTerm) - 1);
        return monthlyPayment;
    }

    private async Task SubmitApplication()
    {
        message = "";

        if (string.IsNullOrWhiteSpace(adminReason))
        {
            message = "Admin reason is required.";
            isError = true;
            return;
        }

        if (selectedAccountId == 0 || string.IsNullOrWhiteSpace(loanType) || requestedAmount <= 0)
        {
            message = "Please select a customer and fill in all required loan fields.";
            isError = true;
            return;
        }

        isSubmitting = true;
        try
        {
            using var context = DbContextFactory.CreateDbContext();

            var account = await context.CustomerAccounts.FindAsync(selectedAccountId);
            if (account == null)
            {
                message = "Customer account not found.";
                isError = true;
                return;
            }

            // Generate unique loan number
            var loanNumber = $"LN-{DateTime.Now:yyyyMMdd}-{account.CustomerId}-{new Random().Next(1000, 9999)}";
            var monthlyPayment = CalculateMonthlyPayment();

            // Create loan record
            var loan = new Loan
            {
                AccountId = account.AccountId,
                LoanNumber = loanNumber,
                LoanType = loanType,
                LoanAmount = requestedAmount,
                OutstandingBalance = requestedAmount,
                InterestRate = interestRate,
                TermMonths = loanTerm,
                MonthlyPayment = monthlyPayment,
                StartDate = DateTime.Now,
                EndDate = DateTime.Now.AddMonths(loanTerm),
                NextDueDate = DateTime.Now.AddMonths(1),
                Status = "Pending",
                Purpose = loanPurpose,
                CreatedAt = DateTime.Now
            };

            context.Loans.Add(loan);
            await context.SaveChangesAsync();

            // Create approval queue entry
            var approval = new ApprovalQueueEntity
            {
                RequestType = "Loan",
                RequestId = loan.LoanId,
                RequestedBy = $"SuperAdmin: {AuthService.FullName ?? "Admin"}",
                Amount = requestedAmount,
                Status = "Pending",
                Priority = priority,
                Description = $"[Admin Encoded] {loanType} Loan - ₱{requestedAmount:N2} for {loanTerm} months. Purpose: {loanPurpose}. Admin Reason: {adminReason}",
                RequestedAt = DateTime.Now,
                ApprovalNotes = notes
            };

            context.ApprovalQueues.Add(approval);
            await context.SaveChangesAsync();

            message = $"Loan application submitted successfully. Loan #: {loanNumber}";
            isError = false;
            ClearForm();
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
            isError = true;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ClearForm()
    {
        selectedAccountId = 0;
        customerSearch = "";
        loanType = "";
        requestedAmount = 0;
        loanTerm = 12;
        interestRate = 5.0m;
        priority = "Medium";
        loanPurpose = "";
        notes = "";
    }

    private class CustomerAccountInfo
    {
        public int AccountId { get; set; }
        public int CustomerId { get; set; }
        public string AccountNumber { get; set; } = "";
        public string CustomerName { get; set; } = "";
    }
}