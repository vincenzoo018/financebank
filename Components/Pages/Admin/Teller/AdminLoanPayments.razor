@page "/admin/teller/loan-payments"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@using Microsoft.EntityFrameworkCore
@inject AuthService AuthService
@inject LoanProcessService LoanService
@inject BFASDbContext DbContext
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="admin-page">
    <div class="page-header">
        <h1 style="color: #10b981;">
            <svg style="width: 32px; height: 32px; margin-right: 12px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                <line x1="1" y1="10" x2="23" y2="10"></line>
            </svg>
            Loan Payments (Admin)
        </h1>
        <p class="page-subtitle">Process loan payment collections</p>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success")">@message</div>
    }

    <div class="admin-card">
        <div class="card-header">
            <h3>Record Loan Payment</h3>
        </div>
        <div class="card-body">
            <div class="form-group">
                <label>Admin Reason <span class="required">*</span></label>
                <textarea @bind="adminReason" class="form-control" rows="2" 
                    placeholder="Enter reason for processing this payment..."></textarea>
            </div>
            <hr />
            
            <div class="form-row">
                <div class="form-group col-md-4">
                    <label>Contract Number</label>
                    <input type="text" @bind="contractNumber" class="form-control" placeholder="Enter contract number" />
                </div>
                <div class="form-group col-md-4">
                    <label>Payment Amount</label>
                    <div class="input-group">
                        <span class="input-group-text">₱</span>
                        <input type="number" @bind="paymentAmount" class="form-control" step="0.01" />
                    </div>
                </div>
                <div class="form-group col-md-4">
                    <label>Payment Method</label>
                    <select @bind="paymentMethod" class="form-control">
                        <option value="Cash">Cash</option>
                        <option value="Check">Check</option>
                        <option value="BankTransfer">Bank Transfer</option>
                        <option value="AutoDebit">Auto Debit</option>
                    </select>
                </div>
            </div>
            
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label>Reference Number</label>
                    <input type="text" @bind="referenceNumber" class="form-control" placeholder="Payment reference" />
                </div>
                <div class="form-group col-md-6">
                    <label>Remarks</label>
                    <input type="text" @bind="remarks" class="form-control" placeholder="Optional remarks" />
                </div>
            </div>
            
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="ProcessPayment">
                    <svg style="width: 16px; height: 16px; margin-right: 8px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    Process Payment
                </button>
            </div>
        </div>
    </div>

    <div class="admin-card" style="margin-top: 24px;">
        <div class="card-header">
            <h3>Due Payments Today</h3>
        </div>
        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Contract No</th>
                        <th>Customer</th>
                        <th>Due Amount</th>
                        <th>Due Date</th>
                        <th>Outstanding Balance</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="7" class="text-center text-muted" style="padding: 40px;">Due payments tracking coming soon</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="admin-card" style="margin-top: 24px;">
        <div class="card-header">
            <h3>Recent Payments</h3>
        </div>
        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Contract No</th>
                        <th>Customer</th>
                        <th>Amount</th>
                        <th>Method</th>
                        <th>Processed By</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in recentPayments)
                    {
                        <tr>
                            <td>@payment.PaymentDate.ToString("MMM dd, yyyy HH:mm")</td>
                            <td>@(payment.Loan?.LoanNumber ?? "N/A")</td>
                            <td>@(payment.Loan?.Account?.Customer?.FullName ?? "N/A")</td>
                            <td style="color: #10b981;">₱@payment.PaymentAmount.ToString("N2")</td>
                            <td>@payment.PaymentMethod</td>
                            <td>@payment.ProcessedBy</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private string adminReason = "";
    private string contractNumber = "";
    private decimal paymentAmount = 0;
    private string paymentMethod = "Cash";
    private string referenceNumber = "";
    private string remarks = "";
    private string message = "";
    private bool isError = false;

    private CustomerAccount? selectedAccount;
    private List<Loan> activeLoans = new();
    private Loan? selectedLoan;
    private LoanPaymentSchedule? nextPayment;
    private bool isLoading = false;
    private List<LoanPayment> recentPayments = new();
    private string searchAccountNumber = "";

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.HasRole(AuthService.Roles.SuperAdmin))
        {
            Navigation.NavigateTo("/admin/dashboard");
            return;
        }
        await LoadRecentPayments();
    }

    private async Task LoadRecentPayments()
    {
        try
        {
            recentPayments = await DbContext.LoanPayments
                .Include(p => p.Loan)
                    .ThenInclude(l => l.Account)
                        .ThenInclude(a => a.Customer)
                .OrderByDescending(p => p.PaymentDate)
                .Take(10)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            message = $"Error loading payments: {ex.Message}";
            isError = true;
        }
    }

    private async Task SearchAccount()
    {
        if (string.IsNullOrWhiteSpace(contractNumber))
        {
            message = "Please enter account number";
            isError = true;
            return;
        }

        try
        {
            selectedAccount = await DbContext.CustomerAccounts
                .Include(a => a.Customer)
                .FirstOrDefaultAsync(a => a.AccountNumber == contractNumber);

            if (selectedAccount == null)
            {
                message = "Account not found";
                isError = true;
                return;
            }

            activeLoans = await LoanService.GetAccountLoansAsync(selectedAccount.AccountId);
            activeLoans = activeLoans.Where(l => l.Status == "ACTIVE" && l.OutstandingBalance > 0).ToList();
        }
        catch (Exception ex)
        {
            message = $"Error searching account: {ex.Message}";
            isError = true;
        }
    }

    private async Task ProcessPayment()
    {
        if (string.IsNullOrWhiteSpace(adminReason))
        {
            message = "Admin reason is required.";
            isError = true;
            return;
        }
        
        if (string.IsNullOrWhiteSpace(contractNumber) || paymentAmount <= 0)
        {
            message = "Please enter contract number and valid payment amount.";
            isError = true;
            return;
        }

        try
        {
            // Find loan by contract number
            var loan = await DbContext.Loans
                .Include(l => l.Account)
                    .ThenInclude(a => a.Customer)
                .FirstOrDefaultAsync(l => l.LoanNumber == contractNumber);

            if (loan == null)
            {
                message = "Loan not found.";
                isError = true;
                return;
            }

            // Create payment record
            var payment = new LoanPayment
            {
                LoanId = loan.LoanId,
                ScheduleId = 0, // Admin override payment
                PaymentAmount = paymentAmount,
                PaymentDate = DateTime.Now,
                PaymentMethod = paymentMethod,
                Reference = referenceNumber,
                ProcessedBy = AuthService.FullName ?? "Admin"
            };

            DbContext.LoanPayments.Add(payment);
            await DbContext.SaveChangesAsync();

            message = $"Payment of ₱{paymentAmount:N2} for {contractNumber} processed successfully!";
            isError = false;
            
            await LoadRecentPayments();
        }
        catch (Exception ex)
        {
            message = $"Error processing payment: {ex.Message}";
            isError = true;
        }
        
        // Reset form
        contractNumber = "";
        paymentAmount = 0;
        referenceNumber = "";
        remarks = "";
        adminReason = "";
    }
}
