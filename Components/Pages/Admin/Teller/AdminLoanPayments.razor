@page "/admin/teller/loan-payments"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@using Microsoft.EntityFrameworkCore
@inject AuthService AuthService
@inject LoanProcessService LoanService
@inject IDbContextFactory<BFASDbContext> DbFactory
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div style="padding: 24px;">
    <!-- Page Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <div>
            <h2 style="margin: 0; color: #1f2937; font-weight: 700; font-size: 24px;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2" style="margin-right: 10px; vertical-align: middle;">
                    <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                    <line x1="1" y1="10" x2="23" y2="10"></line>
                </svg>
                Loan Payments (Admin)
            </h2>
            <p style="margin: 4px 0 0 0; color: #6b7280; font-size: 14px;">Process loan payment collections</p>
        </div>
    </div>

    <!-- Admin Notice -->
    <div style="background: #fef3c7; border: 1px solid #f59e0b; border-radius: 12px; padding: 16px; margin-bottom: 24px;">
        <div style="display: flex; align-items: center; gap: 12px;">
            <span style="font-size: 24px;">⚠️</span>
            <div>
                <p style="margin: 0; font-weight: 600; color: #92400e;">Administrative Access</p>
                <p style="margin: 4px 0 0; font-size: 13px; color: #a16207;">You are processing loan payments as SuperAdmin. All actions are logged for audit purposes.</p>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">
        <div style="background: linear-gradient(135deg, #f0fdf4, #dcfce7); border-radius: 12px; padding: 20px; border: 1px solid #bbf7d0;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 48px; height: 48px; background: #059669; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                        <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                        <line x1="1" y1="10" x2="23" y2="10"></line>
                    </svg>
                </div>
                <div>
                    <p style="margin: 0; color: #059669; font-size: 12px; font-weight: 600; text-transform: uppercase;">Today's Payments</p>
                    <p style="margin: 4px 0 0 0; font-size: 28px; font-weight: 700; color: #065f46;">@recentPayments.Count(p => p.PaymentDate.Date == DateTime.Today)</p>
                </div>
            </div>
        </div>
        <div style="background: linear-gradient(135deg, #eff6ff, #dbeafe); border-radius: 12px; padding: 20px; border: 1px solid #bfdbfe;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 48px; height: 48px; background: #3b82f6; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                        <line x1="12" y1="1" x2="12" y2="23"></line>
                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                    </svg>
                </div>
                <div>
                    <p style="margin: 0; color: #3b82f6; font-size: 12px; font-weight: 600; text-transform: uppercase;">Total Collected</p>
                    <p style="margin: 4px 0 0 0; font-size: 22px; font-weight: 700; color: #1e40af;">₱@recentPayments.Where(p => p.PaymentDate.Date == DateTime.Today).Sum(p => p.PaymentAmount).ToString("N0")</p>
                </div>
            </div>
        </div>
        <div style="background: linear-gradient(135deg, #fefce8, #fef9c3); border-radius: 12px; padding: 20px; border: 1px solid #fde047;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 48px; height: 48px; background: #eab308; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                    </svg>
                </div>
                <div>
                    <p style="margin: 0; color: #ca8a04; font-size: 12px; font-weight: 600; text-transform: uppercase;">Recent Records</p>
                    <p style="margin: 4px 0 0 0; font-size: 28px; font-weight: 700; color: #854d0e;">@recentPayments.Count</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Alerts -->
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); border: 1px solid #6ee7b7; color: #065f46; padding: 16px 20px; border-radius: 12px; margin-bottom: 20px; display: flex; align-items: center; gap: 12px;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <span style="font-weight: 500;">@successMessage</span>
            <button @onclick="() => successMessage = string.Empty" style="margin-left: auto; background: none; border: none; color: #065f46; cursor: pointer; font-size: 18px;">×</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div style="background: #fee2e2; border: 1px solid #fecaca; color: #991b1b; padding: 16px 20px; border-radius: 12px; margin-bottom: 20px; display: flex; align-items: center; gap: 12px;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="15" y1="9" x2="9" y2="15"></line>
                <line x1="9" y1="9" x2="15" y2="15"></line>
            </svg>
            <span style="font-weight: 500;">@errorMessage</span>
            <button @onclick="() => errorMessage = string.Empty" style="margin-left: auto; background: none; border: none; color: #991b1b; cursor: pointer; font-size: 18px;">×</button>
        </div>
    }

    <!-- Record Payment Card -->
    <div style="background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden; margin-bottom: 24px;">
        <div style="background: linear-gradient(135deg, #059669, #10b981); color: white; padding: 20px 24px;">
            <h4 style="margin: 0; font-weight: 600; font-size: 18px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px; vertical-align: middle;">
                    <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                    <line x1="1" y1="10" x2="23" y2="10"></line>
                </svg>
                Record Loan Payment
            </h4>
            <p style="margin: 6px 0 0 0; opacity: 0.9; font-size: 13px;">Process physical cash/check payment</p>
        </div>

        <div style="padding: 24px;">
            <!-- Admin Reason -->
            <div style="background: #fef3c7; border: 2px solid #f59e0b; border-radius: 12px; padding: 16px; margin-bottom: 20px;">
                <label style="font-size: 14px; font-weight: 600; color: #92400e; display: block; margin-bottom: 8px;">
                    ⚠️ Admin Reason (Required)
                </label>
                <textarea @bind="adminReason" 
                          style="width: 100%; padding: 12px; border: 1px solid #fcd34d; border-radius: 8px; font-size: 14px; resize: vertical; min-height: 60px; background: #fffbeb;" 
                          placeholder="Enter reason for processing this payment as admin..."></textarea>
            </div>

            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-bottom: 20px;">
                <div>
                    <label style="font-size: 14px; font-weight: 600; color: #374151; display: block; margin-bottom: 8px;">Contract/Loan Number <span style="color: #ef4444;">*</span></label>
                    <input type="text" @bind="contractNumber" 
                           style="width: 100%; padding: 12px 16px; border: 2px solid #e5e7eb; border-radius: 10px; font-size: 14px;"
                           placeholder="Enter contract number" />
                </div>
                <div>
                    <label style="font-size: 14px; font-weight: 600; color: #374151; display: block; margin-bottom: 8px;">Payment Amount <span style="color: #ef4444;">*</span></label>
                    <div style="position: relative;">
                        <span style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #6b7280; font-weight: 600;">₱</span>
                        <input type="number" @bind="paymentAmount" step="0.01"
                               style="width: 100%; padding: 12px 16px 12px 32px; border: 2px solid #e5e7eb; border-radius: 10px; font-size: 14px;"
                               placeholder="0.00" />
                    </div>
                </div>
                <div>
                    <label style="font-size: 14px; font-weight: 600; color: #374151; display: block; margin-bottom: 8px;">Payment Method</label>
                    <select @bind="paymentMethod" style="width: 100%; padding: 12px 16px; border: 2px solid #e5e7eb; border-radius: 10px; font-size: 14px;">
                        <option value="Cash">Cash</option>
                        <option value="Check">Check</option>
                        <option value="BankTransfer">Bank Transfer</option>
                        <option value="AutoDebit">Auto Debit</option>
                    </select>
                </div>
                <div>
                    <label style="font-size: 14px; font-weight: 600; color: #374151; display: block; margin-bottom: 8px;">Reference Number</label>
                    <input type="text" @bind="referenceNumber" 
                           style="width: 100%; padding: 12px 16px; border: 2px solid #e5e7eb; border-radius: 10px; font-size: 14px;"
                           placeholder="Payment reference" />
                </div>
            </div>

            <div style="margin-bottom: 20px;">
                <label style="font-size: 14px; font-weight: 600; color: #374151; display: block; margin-bottom: 8px;">Remarks</label>
                <input type="text" @bind="remarks" 
                       style="width: 100%; padding: 12px 16px; border: 2px solid #e5e7eb; border-radius: 10px; font-size: 14px;"
                       placeholder="Optional remarks" />
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 12px;">
                <button style="background: #f1f5f9; color: #475569; border: none; padding: 12px 24px; border-radius: 10px; cursor: pointer; font-weight: 600; font-size: 14px;"
                        @onclick="ResetForm">Reset</button>
                <button style="background: linear-gradient(135deg, #059669, #10b981); color: white; border: none; padding: 12px 28px; border-radius: 10px; cursor: pointer; font-weight: 700; font-size: 14px; box-shadow: 0 4px 12px rgba(5, 150, 105, 0.3);"
                        @onclick="ProcessPayment" disabled="@isProcessing">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px; vertical-align: middle;">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    @(isProcessing ? "Processing..." : "Process Payment")
                </button>
            </div>
        </div>
    </div>

    <!-- Recent Payments Card -->
    <div style="background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden;">
        <div style="background: linear-gradient(135deg, #3b82f6, #1d4ed8); color: white; padding: 20px 24px;">
            <h4 style="margin: 0; font-weight: 600; font-size: 18px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px; vertical-align: middle;">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                Recent Payments
            </h4>
            <p style="margin: 6px 0 0 0; opacity: 0.9; font-size: 13px;">Latest loan payment transactions</p>
        </div>

        <div style="padding: 24px;">
            @if (isLoading)
            {
                <div style="text-align: center; padding: 60px;">
                    <div style="width: 48px; height: 48px; border: 4px solid #e5e7eb; border-top-color: #3b82f6; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto;"></div>
                    <p style="margin-top: 16px; color: #6b7280;">Loading payments...</p>
                </div>
            }
            else if (!recentPayments.Any())
            {
                <div style="text-align: center; padding: 60px; background: linear-gradient(135deg, #f9fafb, #f3f4f6); border-radius: 16px;">
                    <div style="width: 80px; height: 80px; background: #e5e7eb; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5">
                            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                        </svg>
                    </div>
                    <h5 style="color: #4b5563; margin-top: 20px; font-weight: 600;">No Payment Records</h5>
                    <p style="color: #9ca3af; font-size: 14px;">No loan payments have been recorded yet.</p>
                </div>
            }
            else
            {
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: separate; border-spacing: 0;">
                        <thead>
                            <tr style="background: linear-gradient(135deg, #f8fafc, #f1f5f9);">
                                <th style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">DATE</th>
                                <th style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">CONTRACT NO</th>
                                <th style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">CUSTOMER</th>
                                <th style="padding: 14px 16px; text-align: right; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">AMOUNT</th>
                                <th style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">METHOD</th>
                                <th style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">PROCESSED BY</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var payment in recentPayments)
                            {
                                <tr style="border-bottom: 1px solid #f1f5f9;" class="table-row-hover">
                                    <td style="padding: 14px 16px; color: #64748b;">@payment.PaymentDate.ToString("MMM dd, yyyy HH:mm")</td>
                                    <td style="padding: 14px 16px;">
                                        <span style="background: linear-gradient(135deg, #dbeafe, #bfdbfe); color: #1e40af; padding: 4px 12px; border-radius: 6px; font-weight: 600; font-size: 12px;">@(payment.Loan?.LoanNumber ?? "N/A")</span>
                                    </td>
                                    <td style="padding: 14px 16px; font-weight: 500; color: #1e293b;">@(payment.Loan?.Account?.Customer?.FullName ?? "N/A")</td>
                                    <td style="padding: 14px 16px; text-align: right;">
                                        <span style="font-weight: 700; color: #059669; font-size: 15px;">₱@payment.PaymentAmount.ToString("N2")</span>
                                    </td>
                                    <td style="padding: 14px 16px; color: #64748b;">@payment.PaymentMethod</td>
                                    <td style="padding: 14px 16px; color: #64748b;">@payment.ProcessedBy</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<style>
    @@keyframes spin { to { transform: rotate(360deg); } }
    .table-row-hover:hover { background: #f8fafc !important; }
    input:focus, select:focus, textarea:focus { outline: none; border-color: #059669 !important; box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.1); }
    button:hover:not(:disabled) { transform: translateY(-1px); }
    button:disabled { opacity: 0.6; cursor: not-allowed; }
</style>

@code {
    private string adminReason = "";
    private string contractNumber = "";
    private decimal paymentAmount = 0;
    private string paymentMethod = "Cash";
    private string referenceNumber = "";
    private string remarks = "";
    private string successMessage = "";
    private string errorMessage = "";
    private bool isLoading = true;
    private bool isProcessing = false;

    private List<LoanPayment> recentPayments = new();

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.HasRole(AuthService.Roles.SuperAdmin))
        {
            Navigation.NavigateTo("/admin/dashboard");
            return;
        }
        await LoadRecentPayments();
    }

    private async Task LoadRecentPayments()
    {
        isLoading = true;
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            recentPayments = await db.LoanPayments
                .Include(p => p.Loan)
                    .ThenInclude(l => l.Account)
                    .ThenInclude(a => a!.Customer)
                .OrderByDescending(p => p.PaymentDate)
                .Take(20)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading payments: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ProcessPayment()
    {
        if (string.IsNullOrWhiteSpace(adminReason))
        {
            errorMessage = "Admin reason is required.";
            return;
        }
        
        if (string.IsNullOrWhiteSpace(contractNumber) || paymentAmount <= 0)
        {
            errorMessage = "Please enter contract number and valid payment amount.";
            return;
        }

        isProcessing = true;
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            
            // Find loan by contract number
            var loan = await db.Loans
                .Include(l => l.Account)
                    .ThenInclude(a => a.Customer)
                .FirstOrDefaultAsync(l => l.LoanNumber == contractNumber);

            if (loan == null)
            {
                errorMessage = "Loan not found.";
                isProcessing = false;
                return;
            }

            // Create payment record
            var payment = new LoanPayment
            {
                LoanId = loan.LoanId,
                ScheduleId = 0,
                PaymentAmount = paymentAmount,
                PaymentDate = DateTime.Now,
                PaymentMethod = paymentMethod,
                Reference = referenceNumber,
                ProcessedBy = $"{AuthService.FullName ?? "Admin"} (Admin: {adminReason})"
            };

            db.LoanPayments.Add(payment);
            await db.SaveChangesAsync();

            successMessage = $"Payment of ₱{paymentAmount:N2} for {contractNumber} processed successfully!";
            ResetForm();
            await LoadRecentPayments();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error processing payment: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void ResetForm()
    {
        contractNumber = "";
        paymentAmount = 0;
        referenceNumber = "";
        remarks = "";
        adminReason = "";
    }
}
