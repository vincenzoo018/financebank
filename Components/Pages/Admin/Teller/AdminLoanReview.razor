@page "/admin/teller/loan-review"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@using Microsoft.EntityFrameworkCore
@inject AuthService AuthService
@inject LoanProcessService LoanService
@inject BFASDbContext DbContext
@inject NavigationManager Navigation

<div class="admin-page">
    <div class="page-header">
        <h1 style="color: #10b981;">
            <svg style="width: 32px; height: 32px; margin-right: 12px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.35-4.35"></path>
            </svg>
            Loan Review (Admin)
        </h1>
        <p class="page-subtitle">Review and assess loan applications</p>
    </div>

    <div class="admin-card">
        <div class="card-header">
            <h3>Applications Under Review</h3>
        </div>
        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Application ID</th>
                        <th>Customer</th>
                        <th>Loan Type</th>
                        <th>Amount</th>
                        <th>Term</th>
                        <th>Credit Score</th>
                        <th>Risk Level</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr><td colspan="8" style="text-align: center; padding: 40px;">Loading applications...</td></tr>
                    }
                    else if (!loansUnderReview.Any())
                    {
                        <tr><td colspan="8" style="text-align: center; padding: 40px;">No applications pending review</td></tr>
                    }
                    else
                    {
                        @foreach (var loan in loansUnderReview)
                        {
                            <tr>
                                <td><strong>@loan.ApplicationNumber</strong></td>
                                <td>@(loan.Account?.Customer?.FullName ?? "N/A")</td>
                                <td>@loan.LoanType</td>
                                <td>₱@loan.RequestedAmount.ToString("N2")</td>
                                <td>@loan.Purpose</td>
                                <td>@loan.ApplicationDate.ToString("MM/dd/yyyy")</td>
                                <td><span class="badge">@loan.Status</span></td>
                                <td>
                                    <button class="btn btn-sm btn-info" @onclick="() => ShowReviewModal(loan)">Review</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-content" @onclick:stopPropagation style="max-width: 700px;">
            <div class="modal-header">
                <h4>Loan Review - @selectedLoan?.ApplicationId</h4>
                <button class="close-btn" @onclick="CloseModal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Admin Reason <span class="required">*</span></label>
                    <textarea @bind="adminReason" class="form-control" rows="2" 
                        placeholder="Enter reason for this review action..."></textarea>
                </div>
                <hr />
                
                <div class="review-summary">
                    <div class="summary-item">
                        <label>Requested Amount</label>
                        <span>₱@selectedLoan?.RequestedAmount.ToString("N2")</span>
                    </div>
                    <div class="summary-item">
                        <label>Purpose</label>
                        <span>@(selectedLoan?.Purpose ?? "N/A")</span>
                    </div>
                    <div class="summary-item">
                        <label>Monthly Income</label>
                        <span>₱@((selectedLoan?.MonthlyIncome ?? 0).ToString("N2"))</span>
                    </div>
                    <div class="summary-item">
                        <label>Employment Status</label>
                        <span>@(selectedLoan?.EmploymentStatus ?? "N/A")</span>
                    </div>
                </div>
                
                <div class="form-group" style="margin-top: 16px;">
                    <label>Assessment Notes</label>
                    <textarea @bind="assessmentNotes" class="form-control" rows="4" 
                        placeholder="Enter your assessment..."></textarea>
                </div>
                
                <div class="form-group">
                    <label>Recommendation</label>
                    <select @bind="recommendation" class="form-control">
                        <option value="">Select Recommendation</option>
                        <option value="Approve">Recommend for Approval</option>
                        <option value="ApproveReduced">Approve with Reduced Amount</option>
                        <option value="AdditionalDocs">Request Additional Documents</option>
                        <option value="Reject">Recommend Rejection</option>
                    </select>
                </div>
                
                @if (recommendation == "ApproveReduced")
                {
                    <div class="form-group">
                        <label>Approved Amount</label>
                        <div class="input-group">
                            <span class="input-group-text">₱</span>
                            <input type="number" @bind="approvedAmount" class="form-control" />
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                <button class="btn btn-primary" @onclick="SubmitReview">Submit Review</button>
            </div>
        </div>
    </div>
}

<style>
    .review-summary {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        background: #f8fafc;
        padding: 16px;
        border-radius: 8px;
    }
    .summary-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    .summary-item label {
        font-size: 0.8em;
        color: #6b7280;
    }
    .summary-item span {
        font-weight: 600;
        color: #1f2937;
    }
</style>

@code {
    private bool showModal = false;
    private LoanApplication? selectedLoan;
    private string adminReason = "";
    private string assessmentNotes = "";
    private string recommendation = "";
    private decimal approvedAmount = 0;
    private bool isLoading = true;
    private bool isProcessing = false;
    private string successMessage = "";
    private string errorMessage = "";

    private List<LoanApplication> loansUnderReview = new();

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.HasRole(AuthService.Roles.SuperAdmin))
        {
            Navigation.NavigateTo("/admin/dashboard");
            return;
        }
        await LoadPendingApplications();
    }

    private async Task LoadPendingApplications()
    {
        isLoading = true;
        try
        {
            loansUnderReview = await LoanService.GetPendingApplicationsAsync("TELLER");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading applications: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowReviewModal(LoanApplication loan)
    {
        selectedLoan = loan;
        approvedAmount = loan.RequestedAmount;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        selectedLoan = null;
        adminReason = "";
        assessmentNotes = "";
        recommendation = "";
    }

    private async Task SubmitReview()
    {
        if (string.IsNullOrWhiteSpace(adminReason) || string.IsNullOrWhiteSpace(recommendation)) return;
        if (selectedLoan != null)
        {
            isProcessing = true;
            try
            {
                // Update application status based on recommendation
                if (recommendation == "Approve")
                {
                    selectedLoan.Status = "VERIFIED";
                    DbContext.Update(selectedLoan);
                    await DbContext.SaveChangesAsync();
                    successMessage = "Application approved and verified";
                }
                else
                {
                    selectedLoan.Status = "REJECTED";
                    selectedLoan.RejectionReason = assessmentNotes;
                    selectedLoan.RejectedAt = DateTime.Now;
                    DbContext.Update(selectedLoan);
                    await DbContext.SaveChangesAsync();
                    successMessage = "Application rejected";
                }
                CloseModal();
                await LoadPendingApplications();
            }
            catch (Exception ex)
            {
                errorMessage = $"Error processing review: {ex.Message}";
            }
            finally
            {
                isProcessing = false;
            }
            loansUnderReview.Remove(selectedLoan);
        }
        CloseModal();
    }

    private string GetRiskClass(string risk) => risk switch
    {
        "Low" => "badge-success",
        "Medium" => "badge-warning",
        "High" => "badge-danger",
        _ => "badge-secondary"
    };

    private class LoanReviewItem
    {
        public string ApplicationId { get; set; } = "";
        public string CustomerName { get; set; } = "";
        public string LoanType { get; set; } = "";
        public decimal Amount { get; set; }
        public int Term { get; set; }
        public int CreditScore { get; set; }
        public string RiskLevel { get; set; } = "";
    }
}
