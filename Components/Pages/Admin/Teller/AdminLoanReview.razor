@page "/admin/teller/loan-review"
@layout AdminLayout
@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="admin-page">
    <div class="page-header">
        <h1 style="color: #10b981;">
            <svg style="width: 32px; height: 32px; margin-right: 12px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.35-4.35"></path>
            </svg>
            Loan Review (Admin)
        </h1>
        <p class="page-subtitle">Review and assess loan applications</p>
    </div>

    <div class="admin-card">
        <div class="card-header">
            <h3>Applications Under Review</h3>
        </div>
        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Application ID</th>
                        <th>Customer</th>
                        <th>Loan Type</th>
                        <th>Amount</th>
                        <th>Term</th>
                        <th>Credit Score</th>
                        <th>Risk Level</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var loan in loansUnderReview)
                    {
                        <tr>
                            <td><strong>@loan.ApplicationId</strong></td>
                            <td>@loan.CustomerName</td>
                            <td>@loan.LoanType</td>
                            <td>₱@loan.Amount.ToString("N2")</td>
                            <td>@loan.Term months</td>
                            <td>@loan.CreditScore</td>
                            <td><span class="badge @GetRiskClass(loan.RiskLevel)">@loan.RiskLevel</span></td>
                            <td>
                                <button class="btn btn-sm btn-info" @onclick="() => ShowReviewModal(loan)">Review</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-content" @onclick:stopPropagation style="max-width: 700px;">
            <div class="modal-header">
                <h4>Loan Review - @selectedLoan?.ApplicationId</h4>
                <button class="close-btn" @onclick="CloseModal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Admin Reason <span class="required">*</span></label>
                    <textarea @bind="adminReason" class="form-control" rows="2" 
                        placeholder="Enter reason for this review action..."></textarea>
                </div>
                <hr />
                
                <div class="review-summary">
                    <div class="summary-item">
                        <label>Requested Amount</label>
                        <span>₱@selectedLoan?.Amount.ToString("N2")</span>
                    </div>
                    <div class="summary-item">
                        <label>Monthly Payment</label>
                        <span>₱@((selectedLoan?.Amount ?? 0) / (selectedLoan?.Term ?? 1) * 1.12m).ToString("N2")</span>
                    </div>
                    <div class="summary-item">
                        <label>Interest Rate</label>
                        <span>12% p.a.</span>
                    </div>
                    <div class="summary-item">
                        <label>Credit Score</label>
                        <span>@selectedLoan?.CreditScore</span>
                    </div>
                </div>
                
                <div class="form-group" style="margin-top: 16px;">
                    <label>Assessment Notes</label>
                    <textarea @bind="assessmentNotes" class="form-control" rows="4" 
                        placeholder="Enter your assessment..."></textarea>
                </div>
                
                <div class="form-group">
                    <label>Recommendation</label>
                    <select @bind="recommendation" class="form-control">
                        <option value="">Select Recommendation</option>
                        <option value="Approve">Recommend for Approval</option>
                        <option value="ApproveReduced">Approve with Reduced Amount</option>
                        <option value="AdditionalDocs">Request Additional Documents</option>
                        <option value="Reject">Recommend Rejection</option>
                    </select>
                </div>
                
                @if (recommendation == "ApproveReduced")
                {
                    <div class="form-group">
                        <label>Approved Amount</label>
                        <div class="input-group">
                            <span class="input-group-text">₱</span>
                            <input type="number" @bind="approvedAmount" class="form-control" />
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                <button class="btn btn-primary" @onclick="SubmitReview">Submit Review</button>
            </div>
        </div>
    </div>
}

<style>
    .review-summary {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        background: #f8fafc;
        padding: 16px;
        border-radius: 8px;
    }
    .summary-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    .summary-item label {
        font-size: 0.8em;
        color: #6b7280;
    }
    .summary-item span {
        font-weight: 600;
        color: #1f2937;
    }
</style>

@code {
    private bool showModal = false;
    private LoanReviewItem? selectedLoan;
    private string adminReason = "";
    private string assessmentNotes = "";
    private string recommendation = "";
    private decimal approvedAmount = 0;

    private List<LoanReviewItem> loansUnderReview = new()
    {
        new() { ApplicationId = "LA-2024001", CustomerName = "Juan Dela Cruz", LoanType = "Personal", Amount = 50000, Term = 12, CreditScore = 720, RiskLevel = "Low" },
        new() { ApplicationId = "LA-2024002", CustomerName = "Maria Santos", LoanType = "Home", Amount = 500000, Term = 60, CreditScore = 680, RiskLevel = "Medium" },
        new() { ApplicationId = "LA-2024003", CustomerName = "Pedro Garcia", LoanType = "Business", Amount = 200000, Term = 36, CreditScore = 620, RiskLevel = "High" }
    };

    protected override void OnInitialized()
    {
        if (!AuthService.HasRole(AuthService.Roles.SuperAdmin))
        {
            Navigation.NavigateTo("/admin/dashboard");
        }
    }

    private void ShowReviewModal(LoanReviewItem loan)
    {
        selectedLoan = loan;
        approvedAmount = loan.Amount;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        selectedLoan = null;
        adminReason = "";
        assessmentNotes = "";
        recommendation = "";
    }

    private void SubmitReview()
    {
        if (string.IsNullOrWhiteSpace(adminReason) || string.IsNullOrWhiteSpace(recommendation)) return;
        if (selectedLoan != null)
        {
            loansUnderReview.Remove(selectedLoan);
        }
        CloseModal();
    }

    private string GetRiskClass(string risk) => risk switch
    {
        "Low" => "badge-success",
        "Medium" => "badge-warning",
        "High" => "badge-danger",
        _ => "badge-secondary"
    };

    private class LoanReviewItem
    {
        public string ApplicationId { get; set; } = "";
        public string CustomerName { get; set; } = "";
        public string LoanType { get; set; } = "";
        public decimal Amount { get; set; }
        public int Term { get; set; }
        public int CreditScore { get; set; }
        public string RiskLevel { get; set; } = "";
    }
}
