@page "/admin/teller/transfers"
@page "/admin/teller/process-transfers"
@layout AdminLayout
@inject TellerBankingService TellerService
@inject AuthService AuthService
@inject NavigationManager Navigation

<!-- Header with Gradient -->
<div style="background: linear-gradient(135deg, #2563eb, #1e40af); border-radius: 16px; padding: 24px; margin-bottom: 24px; color: white;">
    <div style="display: flex; align-items: center; gap: 12px;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="17 1 21 5 17 9"></polyline>
            <path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
            <polyline points="7 23 3 19 7 15"></polyline>
            <path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
        </svg>
        <div>
            <h1 style="font-size: 20px; font-weight: 700; margin: 0;">Process Transfers (Admin)</h1>
            <p style="margin: 4px 0 0; opacity: 0.9; font-size: 13px;">Process fund transfers between accounts with admin oversight</p>
        </div>
    </div>
</div>

<!-- Admin Notice -->
<div style="background: #fef3c7; border: 1px solid #f59e0b; border-radius: 12px; padding: 16px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 12px;">
        <span style="font-size: 20px;">⚠️</span>
        <div>
            <p style="margin: 0; font-weight: 600; color: #92400e;">Administrative Access</p>
            <p style="margin: 4px 0 0; font-size: 13px; color: #a16207;">You are performing this action as SuperAdmin. A reason for this action is required for audit purposes.</p>
        </div>
    </div>
</div>

<!-- Transfer Form -->
<div style="background: white; border-radius: 16px; padding: 32px; border: 1px solid #e5e7eb; margin-bottom: 32px;">
    <h3 style="margin: 0 0 24px; font-size: 18px; font-weight: 700; color: #1f2937;">Transfer Funds</h3>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div style="background: #fee2e2; border: 1px solid #dc2626; border-radius: 8px; padding: 12px; margin-bottom: 20px; color: #991b1b;">
            ❌ @errorMessage
        </div>
    }
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div style="background: #d1fae5; border: 1px solid #10b981; border-radius: 8px; padding: 12px; margin-bottom: 20px; color: #065f46;">
            ✅ @successMessage
        </div>
    }
    
    <form @onsubmit="ProcessTransfer" @onsubmit:preventDefault>
        <!-- Admin Reason Field -->
        <div style="margin-bottom: 20px;">
            <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px; color: #dc2626;">
                ⚠️ Reason for Admin Action *
            </label>
            <textarea @bind="adminReason" style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px; min-height: 60px;" 
                placeholder="Enter reason for performing this action as admin..." rows="2"></textarea>
            <small style="font-size: 12px; color: #6b7280;">Required: This will be logged for audit purposes</small>
        </div>
        
        <div style="border-top: 1px solid #e5e7eb; padding-top: 20px; margin-bottom: 20px;"></div>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px;">
            <!-- From Account -->
            <!-- From Account -->
            <div>
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">From Account Number *</label>
                <input type="text" @bind="fromAccountNumber" style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;" 
                    placeholder="Enter source account number" />
            </div>
            
            <!-- To Account -->
            <div>
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">To Account Number *</label>
                <input type="text" @bind="toAccountNumber" style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;" 
                    placeholder="Enter destination account number" />
            </div>
            
            <!-- Amount -->
            <div>
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Amount (₱) *</label>
                <input type="number" @bind="amount" step="0.01" min="0" style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;" 
                    placeholder="0.00" />
            </div>
            
            <!-- Transfer Type -->
            <div>
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Transfer Type *</label>
                <select @bind="transferType" style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;">
                    <option value="Internal">Internal Transfer</option>
                    <option value="External">External Transfer</option>
                </select>
            </div>
            
            <!-- Remarks -->
            <div style="grid-column: 1 / -1;">
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Remarks</label>
                <textarea @bind="remarks" rows="2" style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;" 
                    placeholder="Optional remarks..."></textarea>
            </div>
        </div>
        
        <div style="display: flex; gap: 12px; justify-content: flex-end; margin-top: 24px;">
            <button type="submit" disabled="@isProcessing" 
                style="background: #2563eb; color: white; padding: 12px 24px; border: none; border-radius: 8px; font-weight: 600; cursor: @(isProcessing ? "not-allowed" : "pointer"); opacity: @(isProcessing ? "0.6" : "1");">
                @if (isProcessing)
                {
                    <span>Processing...</span>
                }
                else
                {
                    <span>Process Transfer</span>
                }
            </button>
        </div>
    </form>
</div>

<!-- Recent Transfers -->
<div style="background: white; border-radius: 16px; padding: 32px; border: 1px solid #e5e7eb;">
    <h3 style="margin: 0 0 24px; font-size: 18px; font-weight: 700; color: #1f2937;">Recent Transfers</h3>
    
    <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background: #f9fafb; border-bottom: 2px solid #e5e7eb;">
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280; font-weight: 600;">DATE</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280; font-weight: 600;">FROM ACCOUNT</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280; font-weight: 600;">TO ACCOUNT</th>
                    <th style="padding: 12px; text-align: right; font-size: 12px; color: #6b7280; font-weight: 600;">AMOUNT</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280; font-weight: 600;">TYPE</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280; font-weight: 600;">PROCESSED BY</th>
                    <th style="padding: 12px; text-align: center; font-size: 12px; color: #6b7280; font-weight: 600;">STATUS</th>
                </tr>
            </thead>
            <tbody>
                @if (recentTransfers.Any())
                {
                    @foreach (var transfer in recentTransfers)
                    {
                        <tr style="border-bottom: 1px solid #e5e7eb;">
                            <td style="padding: 12px; font-size: 13px; color: #111827;">@transfer.Date.ToString("MMM dd, yyyy HH:mm")</td>
                            <td style="padding: 12px; font-size: 13px; color: #3b82f6; font-weight: 500;">@transfer.FromAccount</td>
                            <td style="padding: 12px; font-size: 13px; color: #3b82f6; font-weight: 500;">@transfer.ToAccount</td>
                            <td style="padding: 12px; text-align: right; font-size: 13px; color: #111827; font-weight: 600;">₱@transfer.Amount.ToString("N2")</td>
                            <td style="padding: 12px; font-size: 13px; color: #6b7280;">@transfer.Type</td>
                            <td style="padding: 12px; font-size: 13px; color: #6b7280;">@transfer.ProcessedBy</td>
                            <td style="padding: 12px; text-align: center;">
                                <span style="display: inline-block; padding: 4px 12px; border-radius: 6px; font-size: 11px; font-weight: 600; background: @GetStatusBackground(transfer.Status); color: @GetStatusColor(transfer.Status);">
                                    @transfer.Status
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" style="padding: 48px; text-align: center; color: #6b7280;">No recent transfers</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private string adminReason = "";
    private string fromAccountNumber = "";
    private string toAccountNumber = "";
    private decimal amount = 0;
    private string transferType = "Internal";
    private string remarks = "";
    private bool isProcessing = false;
    private string errorMessage = "";
    private string successMessage = "";
    private List<TransferRecord> recentTransfers = new();

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.HasRole(AuthService.Roles.SuperAdmin))
        {
            Navigation.NavigateTo("/admin/dashboard");
            return;
        }
        await LoadRecentTransfers();
    }

    private async Task LoadRecentTransfers()
    {
        // Load from service - placeholder data for now
        recentTransfers = new List<TransferRecord>
        {
            new TransferRecord { Date = DateTime.Now.AddHours(-2), FromAccount = "SA-001234", ToAccount = "SA-005678", Amount = 5000, Type = "Internal", ProcessedBy = "Admin", Status = "Completed" },
            new TransferRecord { Date = DateTime.Now.AddDays(-1), FromAccount = "CA-009876", ToAccount = "SA-001111", Amount = 15000, Type = "Internal", ProcessedBy = "Admin", Status = "Completed" }
        };
        await Task.CompletedTask;
    }

    private async Task ProcessTransfer()
    {
        errorMessage = "";
        successMessage = "";

        if (string.IsNullOrWhiteSpace(adminReason))
        {
            errorMessage = "Admin reason is required for all admin actions.";
            return;
        }

        if (string.IsNullOrWhiteSpace(fromAccountNumber) || string.IsNullOrWhiteSpace(toAccountNumber))
        {
            errorMessage = "Both account numbers are required.";
            return;
        }

        if (amount <= 0)
        {
            errorMessage = "Amount must be greater than zero.";
            return;
        }

        isProcessing = true;
        try
        {
            // Process the transfer via service
            // Log admin action with reason
            successMessage = $"Transfer of ₱{amount:N2} from {fromAccountNumber} to {toAccountNumber} processed successfully.";
            
            // Reset form
            fromAccountNumber = "";
            toAccountNumber = "";
            amount = 0;
            remarks = "";
            adminReason = "";
            
            await LoadRecentTransfers();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error processing transfer: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private string GetStatusBackground(string status) => status switch
    {
        "Completed" => "#d1fae5",
        "Pending" => "#fef3c7",
        "Failed" => "#fee2e2",
        _ => "#f3f4f6"
    };

    private string GetStatusColor(string status) => status switch
    {
        "Completed" => "#065f46",
        "Pending" => "#92400e",
        "Failed" => "#991b1b",
        _ => "#4b5563"
    };

    private class TransferRecord
    {
        public DateTime Date { get; set; }
        public string FromAccount { get; set; } = "";
        public string ToAccount { get; set; } = "";
        public decimal Amount { get; set; }
        public string Type { get; set; } = "";
        public string ProcessedBy { get; set; } = "";
        public string Status { get; set; } = "";
    }
}
