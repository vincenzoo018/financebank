@page "/admin/teller/transfers"
@page "/admin/teller/process-transfers"
@layout AdminLayout
@inject TellerBankingService TellerService
@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="admin-page">
    <div class="page-header">
        <h1 style="color: #10b981;">
            <svg style="width: 32px; height: 32px; margin-right: 12px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="17 1 21 5 17 9"></polyline>
                <path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
                <polyline points="7 23 3 19 7 15"></polyline>
                <path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
            </svg>
            Process Transfers (Admin)
        </h1>
        <p class="page-subtitle">Process fund transfers between accounts with admin oversight</p>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success">@successMessage</div>
    }

    <div class="admin-card">
        <div class="card-header">
            <h3>Transfer Funds</h3>
        </div>
        <div class="card-body">
            <div class="form-group">
                <label>Reason for Admin Action <span class="required">*</span></label>
                <textarea @bind="adminReason" class="form-control" rows="2" 
                    placeholder="Enter reason for performing this action as admin..."></textarea>
                <small class="form-text text-muted">Required: This will be logged for audit purposes</small>
            </div>
            
            <hr />
            
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label>From Account Number</label>
                    <input type="text" @bind="fromAccountNumber" class="form-control" placeholder="Enter source account number" />
                </div>
                <div class="form-group col-md-6">
                    <label>To Account Number</label>
                    <input type="text" @bind="toAccountNumber" class="form-control" placeholder="Enter destination account number" />
                </div>
            </div>
            
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label>Amount</label>
                    <div class="input-group">
                        <span class="input-group-text">₱</span>
                        <input type="number" @bind="amount" class="form-control" step="0.01" min="0" />
                    </div>
                </div>
                <div class="form-group col-md-6">
                    <label>Transfer Type</label>
                    <select @bind="transferType" class="form-control">
                        <option value="Internal">Internal Transfer</option>
                        <option value="External">External Transfer</option>
                    </select>
                </div>
            </div>
            
            <div class="form-group">
                <label>Remarks</label>
                <textarea @bind="remarks" class="form-control" rows="2" placeholder="Optional remarks..."></textarea>
            </div>
            
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="ProcessTransfer" disabled="@isProcessing">
                    @if (isProcessing)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    Process Transfer
                </button>
            </div>
        </div>
    </div>

    <div class="admin-card" style="margin-top: 24px;">
        <div class="card-header">
            <h3>Recent Transfers</h3>
        </div>
        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>From Account</th>
                        <th>To Account</th>
                        <th>Amount</th>
                        <th>Type</th>
                        <th>Processed By</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (recentTransfers.Any())
                    {
                        @foreach (var transfer in recentTransfers)
                        {
                            <tr>
                                <td>@transfer.Date.ToString("MMM dd, yyyy HH:mm")</td>
                                <td>@transfer.FromAccount</td>
                                <td>@transfer.ToAccount</td>
                                <td>₱@transfer.Amount.ToString("N2")</td>
                                <td>@transfer.Type</td>
                                <td>@transfer.ProcessedBy</td>
                                <td><span class="badge @GetStatusClass(transfer.Status)">@transfer.Status</span></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted">No recent transfers</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private string adminReason = "";
    private string fromAccountNumber = "";
    private string toAccountNumber = "";
    private decimal amount = 0;
    private string transferType = "Internal";
    private string remarks = "";
    private bool isProcessing = false;
    private string errorMessage = "";
    private string successMessage = "";
    private List<TransferRecord> recentTransfers = new();

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.HasRole(AuthService.Roles.SuperAdmin))
        {
            Navigation.NavigateTo("/admin/dashboard");
            return;
        }
        await LoadRecentTransfers();
    }

    private async Task LoadRecentTransfers()
    {
        // Load from service - placeholder data for now
        recentTransfers = new List<TransferRecord>
        {
            new TransferRecord { Date = DateTime.Now.AddHours(-2), FromAccount = "SA-001234", ToAccount = "SA-005678", Amount = 5000, Type = "Internal", ProcessedBy = "Admin", Status = "Completed" },
            new TransferRecord { Date = DateTime.Now.AddDays(-1), FromAccount = "CA-009876", ToAccount = "SA-001111", Amount = 15000, Type = "Internal", ProcessedBy = "Admin", Status = "Completed" }
        };
        await Task.CompletedTask;
    }

    private async Task ProcessTransfer()
    {
        errorMessage = "";
        successMessage = "";

        if (string.IsNullOrWhiteSpace(adminReason))
        {
            errorMessage = "Admin reason is required for all admin actions.";
            return;
        }

        if (string.IsNullOrWhiteSpace(fromAccountNumber) || string.IsNullOrWhiteSpace(toAccountNumber))
        {
            errorMessage = "Both account numbers are required.";
            return;
        }

        if (amount <= 0)
        {
            errorMessage = "Amount must be greater than zero.";
            return;
        }

        isProcessing = true;
        try
        {
            // Process the transfer via service
            // Log admin action with reason
            successMessage = $"Transfer of ₱{amount:N2} from {fromAccountNumber} to {toAccountNumber} processed successfully.";
            
            // Reset form
            fromAccountNumber = "";
            toAccountNumber = "";
            amount = 0;
            remarks = "";
            adminReason = "";
            
            await LoadRecentTransfers();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error processing transfer: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private string GetStatusClass(string status) => status switch
    {
        "Completed" => "badge-success",
        "Pending" => "badge-warning",
        "Failed" => "badge-danger",
        _ => "badge-secondary"
    };

    private class TransferRecord
    {
        public DateTime Date { get; set; }
        public string FromAccount { get; set; } = "";
        public string ToAccount { get; set; } = "";
        public decimal Amount { get; set; }
        public string Type { get; set; } = "";
        public string ProcessedBy { get; set; } = "";
        public string Status { get; set; } = "";
    }
}
