@page "/admin/teller/deposits"
@page "/admin/teller/process-deposits"
@layout AdminLayout
@inject AuthService AuthService
@inject TellerBankingService TellerBankingService
@using System.Collections.Generic

<!-- Header Title Card -->
<div
    style="background: linear-gradient(135deg, rgba(34, 197, 94, 0.1), rgba(22, 163, 74, 0.15)); border: 1px solid rgba(34, 197, 94, 0.3); border-radius: 16px; padding: 32px; margin-bottom: 32px; color: #15803d;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
        <div>
            <h1 style="font-size: 28px; font-weight: 700; margin: 0;">Process Deposits (Admin)</h1>
            <p style="margin: 4px 0 0; opacity: 0.7; font-size: 14px;">Record customer cash deposits - SuperAdmin Access
            </p>
        </div>
    </div>
</div>

<!-- Admin Notice -->
<div style="background: #fef3c7; border: 1px solid #f59e0b; border-radius: 12px; padding: 16px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 12px;">
        <span style="font-size: 24px;">⚠️</span>
        <div>
            <p style="margin: 0; font-weight: 600; color: #92400e;">Administrative Access</p>
            <p style="margin: 4px 0 0; font-size: 13px; color: #a16207;">You are performing this action as SuperAdmin. A
                reason for this action is required for audit purposes.</p>
        </div>
    </div>
</div>

<!-- Deposit Form -->
<div style="background: white; border-radius: 16px; padding: 32px; border: 1px solid #e5e7eb; margin-bottom: 32px;">
    <h3 style="margin: 0 0 24px; font-size: 18px; font-weight: 700; color: #1f2937;">New Deposit Transaction</h3>

    <form @onsubmit="HandleDeposit" @onsubmit:preventDefault>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px;">
            <!-- Account Number -->
            <div>
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Account Number
                    *</label>
                <input type="text"
                    style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;"
                    @bind="accountNumber" @oninput="OnAccountNumberChanged" placeholder="Enter account number..." />
                @if (showError && string.IsNullOrEmpty(accountNumber))
                {
                    <span style="color: #dc2626; font-size: 12px;">Required</span>
                }
            </div>

            <!-- Customer Name -->
            <div>
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Customer
                    Name</label>
                <input type="text"
                    style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px; background: #f9fafb;"
                    @bind="customerName" placeholder="Auto-filled" readonly />
            </div>

            <!-- Current Balance -->
            <div>
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Current
                    Balance</label>
                <input type="text"
                    style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px; background: #f9fafb;"
                    @bind="currentBalance" placeholder="₱0.00" readonly />
            </div>

            <!-- Deposit Amount -->
            <div>
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Deposit Amount (₱)
                    *</label>
                <input type="number"
                    style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;"
                    @bind="depositAmount" placeholder="0.00" step="0.01" />
                @if (showError && depositAmount <= 0)
                {
                    <span style="color: #dc2626; font-size: 12px;">Amount must be greater than 0</span>
                }
            </div>

            <!-- Deposit Method -->
            <div>
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Deposit Method
                    *</label>
                <select
                    style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;"
                    @bind="depositMethod">
                    <option value="">Select method...</option>
                    <option value="OTC">Over-the-Counter (OTC)</option>
                    <option value="BankTransfer">Bank Transfer</option>
                    <option value="CDM">Cash Deposit Machine (CDM)</option>
                </select>
                @if (showError && string.IsNullOrEmpty(depositMethod))
                {
                    <span style="color: #dc2626; font-size: 12px;">Required</span>
                }
            </div>

            <!-- Reference Number -->
            <div>
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Reference
                    Number</label>
                <input type="text"
                    style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;"
                    @bind="referenceNumber" placeholder="Auto-generated" />
            </div>

            <!-- ADMIN REASON FIELD - Required for SuperAdmin -->
            <div style="grid-column: 1 / -1;">
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px; color: #dc2626;">
                    ⚠️ Reason for Action (Required) *
                </label>
                <textarea
                    style="width: 100%; padding: 12px; border: 2px solid #f59e0b; border-radius: 8px; font-size: 14px; font-family: inherit; resize: vertical; min-height: 80px; background: #fffbeb;"
                    @bind="adminReason"
                    placeholder="Enter the reason why you are performing this deposit as SuperAdmin..."></textarea>
                @if (showError && string.IsNullOrEmpty(adminReason))
                {
                    <span style="color: #dc2626; font-size: 12px;">Reason is required for administrative actions</span>
                }
            </div>

            <!-- Notes -->
            <div style="grid-column: 1 / -1;">
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Additional
                    Notes</label>
                <textarea
                    style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px; font-family: inherit; resize: vertical; min-height: 80px;"
                    @bind="notes" placeholder="Additional notes..."></textarea>
            </div>
        </div>

        <!-- Messages -->
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div
                style="padding: 16px; background: #fee2e2; border-radius: 8px; color: #991b1b; margin-bottom: 20px; font-size: 14px;">
                <strong>Error:</strong> @errorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div
                style="padding: 16px; background: #d1fae5; border-radius: 8px; color: #065f46; margin-bottom: 20px; font-size: 14px;">
                <strong>Success:</strong> @successMessage
                @if (!string.IsNullOrEmpty(lastReceiptNumber))
                {
                    <div style="margin-top: 12px; font-size: 13px;">
                        Receipt #: <strong>@lastReceiptNumber</strong>
                        <button type="button" @onclick="PrintReceipt"
                            style="margin-left: 12px; background: #059669; color: white; padding: 6px 12px; border-radius: 6px; border: none; cursor: pointer; font-weight: 600;">Print
                            Receipt</button>
                    </div>
                }
            </div>
        }

        <!-- Buttons -->
        <div style="display: flex; gap: 12px; justify-content: flex-end;">
            <button type="button"
                style="background: #f3f4f6; color: #374151; padding: 12px 24px; border-radius: 8px; border: none; font-weight: 600; cursor: pointer;"
                @onclick="ResetForm">
                Reset
            </button>
            <button type="submit"
                style="background: linear-gradient(135deg, #059669, #047857); color: white; padding: 12px 32px; border-radius: 8px; border: none; font-weight: 600; cursor: pointer;"
                disabled="@isLoading">
                @if (isLoading)
                {
                    <span>Processing...</span>
                }
                else
                {

                    <span>Process Deposit</span>
                }
            </button>
        </div>
    </form>
</div>

<!-- Real-Time Transactions Table -->
<div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
    <h3 style="margin: 0 0 20px; font-size: 18px; font-weight: 700; color: #1f2937;">Today's Deposits (Real-Time)</h3>

    @if (todayTransactions.Any())
    {
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="border-bottom: 2px solid #e5e7eb; background: #f9fafb;">
                        <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">
                            ACCOUNT #</th>
                        <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">
                            CUSTOMER</th>
                        <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">
                            AMOUNT</th>
                        <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">
                            METHOD</th>
                        <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">TIME
                        </th>
                        <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">
                            STATUS</th>
                        <th style="padding: 12px; text-align: center; font-size: 12px; font-weight: 700; color: #6b7280;">
                            ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var transaction in todayTransactions)
                    {
                        <tr style="border-bottom: 1px solid #e5e7eb; hover:background: #f9fafb;">
                            <td style="padding: 16px; font-weight: 600;">@transaction.AccountNumber</td>
                            <td style="padding: 16px;">@transaction.CustomerName</td>
                            <td style="padding: 16px; font-weight: 600; color: #059669;">₱@transaction.Amount.ToString("N2")
                            </td>
                            <td style="padding: 16px; font-size: 12px;">@transaction.Method</td>
                            <td style="padding: 16px; font-size: 12px; color: #6b7280;">@transaction.Time.ToString("hh:mm tt")
                            </td>
                            <td style="padding: 16px;"><span
                                    style="padding: 4px 12px; background: #d1fae5; color: #065f46; border-radius: 8px; font-size: 12px; font-weight: 600;">Completed</span>
                            </td>
                            <td style="padding: 16px; text-align: center;">
                                <button type="button" @onclick="@(() => ViewInvoice(transaction))"
                                    style="background: #059669; color: white; padding: 6px 12px; border-radius: 6px; border: none; cursor: pointer; font-weight: 600; font-size: 12px;">
                                    📄 Invoice
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div style="padding: 32px; text-align: center; color: #6b7280;">
            <p style="margin: 0; font-size: 14px;">No deposits recorded today yet.</p>
        </div>
    }
</div>

<!-- Invoice Modal -->
@if (showInvoiceModal && selectedTransaction != null)
{
    var trans = selectedTransaction;
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000;"
        @onclick="CloseInvoiceModal">
        <div style="background: white; border-radius: 16px; padding: 32px; max-width: 600px; width: 90%; max-height: 90vh; overflow-y: auto; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);"
            @onclick:stopPropagation>
            <!-- Modal Header -->
            <div
                style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; border-bottom: 2px solid #e5e7eb; padding-bottom: 16px;">
                <h2 style="margin: 0; font-size: 20px; font-weight: 700; color: #1f2937;">Deposit Invoice</h2>
                <button type="button" @onclick="CloseInvoiceModal"
                    style="background: none; border: none; font-size: 24px; cursor: pointer; color: #6b7280;">✕</button>
            </div>

            <!-- Invoice Content -->
            <div style="font-size: 14px; line-height: 1.8;">
                <!-- Header -->
                <div style="text-align: center; margin-bottom: 24px;">
                    <h3 style="margin: 0 0 8px; font-size: 18px; font-weight: 700; color: #059669;">DEPOSIT INVOICE</h3>
                    <p style="margin: 0; color: #6b7280; font-size: 12px;">FinanceBank System - Admin Transaction</p>
                </div>

                <!-- Customer Info -->
                <div style="background: #f9fafb; padding: 16px; border-radius: 8px; margin-bottom: 20px;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                        <div>
                            <p style="margin: 0 0 4px; color: #6b7280; font-size: 12px; font-weight: 600;">ACCOUNT NUMBER
                            </p>
                            <p style="margin: 0; font-weight: 600; color: #1f2937;">@trans.AccountNumber</p>
                        </div>
                        <div>
                            <p style="margin: 0 0 4px; color: #6b7280; font-size: 12px; font-weight: 600;">CUSTOMER NAME</p>
                            <p style="margin: 0; font-weight: 600; color: #1f2937;">@trans.CustomerName</p>
                        </div>
                        <div>
                            <p style="margin: 0 0 4px; color: #6b7280; font-size: 12px; font-weight: 600;">DATE & TIME</p>
                            <p style="margin: 0; color: #1f2937;">@trans.Time.ToString("yyyy-MM-dd HH:mm:ss")</p>
                        </div>
                        <div>
                            <p style="margin: 0 0 4px; color: #6b7280; font-size: 12px; font-weight: 600;">DEPOSIT METHOD
                            </p>
                            <p style="margin: 0; color: #1f2937;">@trans.Method</p>
                        </div>
                    </div>
                </div>

                <!-- Transaction Details -->
                <div
                    style="background: #f0fdf4; padding: 16px; border-radius: 8px; margin-bottom: 20px; border-left: 4px solid #059669;">
                    <p style="margin: 0 0 12px; color: #6b7280; font-size: 12px; font-weight: 600;">TRANSACTION DETAILS</p>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                        <div>
                            <p style="margin: 0 0 4px; color: #6b7280; font-size: 12px;">Deposit Amount</p>
                            <p style="margin: 0; font-size: 18px; font-weight: 700; color: #059669;">
                                ₱@trans.Amount.ToString("N2")</p>
                        </div>
                        <div>
                            <p style="margin: 0 0 4px; color: #6b7280; font-size: 12px;">Status</p>
                            <p style="margin: 0; font-weight: 600; color: #065f46;">✓ Completed</p>
                        </div>
                    </div>
                </div>

                <!-- Admin Action Info -->
                @if (!string.IsNullOrEmpty(trans.AdminReason))
                {
                    <div
                        style="background: #fef3c7; padding: 16px; border-radius: 8px; margin-bottom: 20px; border-left: 4px solid #f59e0b;">
                        <p style="margin: 0 0 8px; color: #92400e; font-size: 12px; font-weight: 600;">ADMIN ACTION REASON</p>
                        <p style="margin: 0; color: #78350f;">@trans.AdminReason</p>
                    </div>
                }

                <!-- Processing Info -->
                <div style="background: #f3f4f6; padding: 16px; border-radius: 8px;">
                    <p style="margin: 0 0 12px; color: #6b7280; font-size: 12px; font-weight: 600;">PROCESSING INFORMATION
                    </p>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                        <div>
                            <p style="margin: 0 0 4px; color: #6b7280; font-size: 12px;">Processed By</p>
                            <p style="margin: 0; color: #1f2937;">@AuthService.CurrentUser (SuperAdmin)</p>
                        </div>
                        <div>
                            <p style="margin: 0 0 4px; color: #6b7280; font-size: 12px;">Reference</p>
                            <p style="margin: 0; color: #1f2937;">@trans.Reference</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Buttons -->
            <div style="display: flex; gap: 12px; margin-top: 24px; padding-top: 16px; border-top: 1px solid #e5e7eb;">
                <button type="button" @onclick="PrintInvoice"
                    style="flex: 1; background: #059669; color: white; padding: 12px; border-radius: 8px; border: none; font-weight: 600; cursor: pointer;">
                    Print Invoice
                </button>
                <button type="button" @onclick="CloseInvoiceModal"
                    style="flex: 1; background: #f3f4f6; color: #374151; padding: 12px; border-radius: 8px; border: none; font-weight: 600; cursor: pointer;">
                    Close
                </button>
            </div>
        </div>
    </div>
}

@code {
    private string searchTerm = "";
    private List<(int AccountId, string AccountNumber, string CustomerName, decimal Balance)> searchResults = new();
    private bool showSearchResults = false;

    private string accountNumber = "";
    private string customerName = "";
    private string currentBalance = "₱0.00";
    private decimal depositAmount = 0;
    private string referenceNumber = "";
    private string depositMethod = "";
    private string notes = "";
    private string adminReason = ""; // Required for admin actions
    private bool showError = false;
    private bool isLoading = false;
    private string errorMessage = "";
    private string successMessage = "";
    private string lastReceiptNumber = "";

    // Transaction tracking
    private class TransactionRecord
    {
        public string AccountNumber { get; set; } = "";
        public string CustomerName { get; set; } = "";
        public decimal Amount { get; set; }
        public string Method { get; set; } = "";
        public DateTime Time { get; set; }
        public string Reference { get; set; } = "";
        public string AdminReason { get; set; } = "";
    }

    private List<TransactionRecord> todayTransactions = new();
    private bool showInvoiceModal = false;
    private TransactionRecord? selectedTransaction = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadTodayTransactions();
    }

    private async Task SearchCustomers(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";

        if (string.IsNullOrWhiteSpace(searchTerm) || searchTerm.Length < 2)
        {
            showSearchResults = false;
            searchResults.Clear();
            return;
        }

        searchResults = await TellerBankingService.SearchCustomersByNameAsync(searchTerm);
        showSearchResults = searchResults.Any();
    }

    private void SelectCustomer(string accNumber, string custName)
    {
        accountNumber = accNumber;
        customerName = custName;
        searchTerm = "";
        showSearchResults = false;
        searchResults.Clear();

        // Load account details
        LoadAccountDetails();
    }

    private async Task OnAccountNumberChanged(ChangeEventArgs e)
    {
        accountNumber = e.Value?.ToString() ?? "";
        await LoadAccountDetails();
    }

    private async Task LoadAccountDetails()
    {
        if (string.IsNullOrWhiteSpace(accountNumber))
        {
            customerName = "";
            currentBalance = "₱0.00";
            return;
        }

        var (success, account, message) = await TellerBankingService.GetAccountByNumberAsync(accountNumber);

        if (success && account != null)
        {
            customerName = account.Customer?.FullName ?? "";
            currentBalance = $"₱{account.Balance:N2}";
        }
        else
        {
            customerName = "";
            currentBalance = "₱0.00";
        }
    }

    private async Task LoadTodayTransactions()
    {
        try
        {
            var transactions = await TellerBankingService.GetTodayTransactionsAsync();
            todayTransactions = transactions
            .Where(t => t.Type == "Deposit")
            .Select(t => new TransactionRecord
            {
                AccountNumber = t.AccountNumber,
                CustomerName = t.CustomerName,
                Amount = t.Amount,
                Method = t.Type,
                Time = t.Time,
                Reference = "REF-" + t.Time.Ticks.ToString().Substring(0, 8)
            })
            .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading transactions: {ex.Message}");
        }
    }

    private void ViewInvoice(TransactionRecord transaction)
    {
        selectedTransaction = transaction;
        showInvoiceModal = true;
    }

    private void CloseInvoiceModal()
    {
        showInvoiceModal = false;
        selectedTransaction = null;
    }

    private void PrintInvoice()
    {
        if (selectedTransaction == null)
            return;

        var trans = selectedTransaction;
        var invoiceContent = $@"
========================================================
                    DEPOSIT INVOICE                    
           FinanceBank System - Admin Transaction        
========================================================

Date & Time: {trans.Time:yyyy-MM-dd HH:mm:ss}
Reference: {trans.Reference}

========================================================
                  CUSTOMER INFORMATION                
========================================================

Account Number: {trans.AccountNumber}
Customer Name: {trans.CustomerName}

========================================================
                  TRANSACTION DETAILS                 
========================================================

Deposit Amount: ₱{trans.Amount:N2}
Deposit Method: {trans.Method}
Status: COMPLETED

========================================================
                  ADMIN ACTION DETAILS                
========================================================

Reason: {trans.AdminReason}
Processed By: {AuthService.CurrentUser} (SuperAdmin)
Date: {DateTime.Now:yyyy-MM-dd HH:mm:ss}

========================================================
This transaction was processed by SuperAdmin.
Please keep this invoice for audit records.
========================================================
";

        // Copy to clipboard and trigger print
        var printWindow = System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
        {
            FileName = "notepad.exe",
            Arguments = "-",
            UseShellExecute = false,
            RedirectStandardInput = true,
            CreateNoWindow = true
        });

        if (printWindow != null)
        {
            printWindow.StandardInput.WriteLine(invoiceContent);
            printWindow.StandardInput.Close();
        }
    }

    private async Task HandleDeposit()
    {
        showError = true;
        errorMessage = "";
        successMessage = "";
        lastReceiptNumber = "";

        // Validation
        if (string.IsNullOrEmpty(accountNumber))
        {
            errorMessage = "Account number is required";
            return;
        }

        if (depositAmount <= 0)
        {
            errorMessage = "Deposit amount must be greater than 0";
            return;
        }

        if (string.IsNullOrEmpty(depositMethod))
        {
            errorMessage = "Deposit method is required";
            return;
        }

        // Admin reason validation
        if (string.IsNullOrEmpty(adminReason))
        {
            errorMessage = "Reason for action is required for administrative operations";
            return;
        }

        isLoading = true;

        try
        {
            // Include admin reason in notes for audit trail
            var auditNotes = $"[ADMIN ACTION by {AuthService.CurrentUser}] Reason: {adminReason}";
            if (!string.IsNullOrEmpty(notes))
            {
                auditNotes += $" | Additional Notes: {notes}";
            }

            var (success, message, transaction, receiptNumber) = await TellerBankingService.ProcessDepositAsync(
            accountNumber,
            depositAmount,
            depositMethod,
            referenceNumber,
            auditNotes
            );

            if (success)
            {
                lastReceiptNumber = receiptNumber;
                successMessage = message;

                // Add to real-time transactions list
                todayTransactions.Insert(0, new TransactionRecord
                {
                    AccountNumber = accountNumber,
                    CustomerName = customerName,
                    Amount = depositAmount,
                    Method = depositMethod,
                    Time = DateTime.Now,
                    Reference = referenceNumber,
                    AdminReason = adminReason
                });

                await Task.Delay(2000);
                ResetForm();
            }
            else
            {
                errorMessage = message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void PrintReceipt()
    {
        if (string.IsNullOrEmpty(lastReceiptNumber))
            return;

        var receiptContent = $@"
========================================================
                    DEPOSIT RECEIPT                    
           FinanceBank System - Admin Transaction        
========================================================

Receipt Number: {lastReceiptNumber}
Date & Time: {DateTime.Now:yyyy-MM-dd HH:mm:ss}

Account Number: {accountNumber}
Customer Name: {customerName}
Current Balance: {currentBalance}

Deposit Amount: ₱{depositAmount:N2}
Deposit Method: {depositMethod}
Reference: {referenceNumber}

========================================================
              ADMIN ACTION DETAILS                    
========================================================

Reason: {adminReason}
Processed By: {AuthService.CurrentUser} (SuperAdmin)
Notes: {notes}
Status: COMPLETED

========================================================
This transaction was processed by SuperAdmin.
Please keep this receipt for audit records.
========================================================
";

        // Copy to clipboard and trigger print
        var printWindow = System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
        {
            FileName = "notepad.exe",
            Arguments = "-",
            UseShellExecute = false,
            RedirectStandardInput = true,
            CreateNoWindow = true
        });

        if (printWindow != null)
        {
            printWindow.StandardInput.WriteLine(receiptContent);
            printWindow.StandardInput.Close();
        }
    }

