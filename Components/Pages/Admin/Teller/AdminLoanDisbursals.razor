@page "/admin/teller/loan-disbursals"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@using Microsoft.EntityFrameworkCore
@inject AuthService AuthService
@inject LoanProcessService LoanService
@inject IDbContextFactory<BFASDbContext> DbContextFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #059669, #10b981); border-radius: 16px; padding: 32px; margin-bottom: 32px; color: white;">
    <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 8px;">
        <div style="width: 48px; height: 48px; background: rgba(255,255,255,0.2); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
            <svg style="width: 28px; height: 28px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="1" x2="12" y2="23"></line>
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
        </div>
        <div>
            <h1 style="font-size: 28px; font-weight: 700; margin: 0;">Loan Disbursals</h1>
            <p style="font-size: 16px; opacity: 0.9; margin: 4px 0 0 0;">SuperAdmin: Process loan disbursements to customer accounts</p>
        </div>
    </div>
</div>

<!-- Admin Notice -->
<div style="background: #fef3c7; border: 1px solid #f59e0b; border-radius: 12px; padding: 16px 20px; margin-bottom: 24px; display: flex; align-items: flex-start; gap: 12px;">
    <svg style="width: 20px; height: 20px; color: #d97706; flex-shrink: 0; margin-top: 2px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
    </svg>
    <div>
        <p style="font-weight: 600; color: #92400e; margin: 0 0 4px 0;">SuperAdmin Override Mode</p>
        <p style="font-size: 14px; color: #a16207; margin: 0;">You are processing loan disbursals with elevated privileges. All actions require an admin reason and are logged.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div style="padding: 16px 20px; border-radius: 12px; margin-bottom: 24px; display: flex; align-items: center; gap: 12px; background: @(isError ? "#fef2f2" : "#f0fdf4"); border: 1px solid @(isError ? "#fecaca" : "#bbf7d0");">
        <svg style="width: 20px; height: 20px; color: @(isError ? "#dc2626" : "#16a34a");" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            @if (isError)
            {
                <path d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            }
            else
            {
                <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            }
        </svg>
        <span style="color: @(isError ? "#dc2626" : "#16a34a"); font-weight: 500;">@message</span>
    </div>
}

<!-- Stats Cards -->
<div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-bottom: 32px;">
    <div style="background: white; border-radius: 16px; padding: 24px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06);">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 56px; height: 56px; background: linear-gradient(135deg, #f59e0b, #fbbf24); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                <svg style="width: 28px; height: 28px; color: white;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
            <div>
                <p style="font-size: 14px; color: #6b7280; margin: 0;">Pending Disbursal</p>
                <p style="font-size: 32px; font-weight: 700; color: #1f2937; margin: 4px 0 0 0;">@pendingDisbursals.Count()</p>
            </div>
        </div>
    </div>
    
    <div style="background: white; border-radius: 16px; padding: 24px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06);">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 56px; height: 56px; background: linear-gradient(135deg, #10b981, #34d399); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                <svg style="width: 28px; height: 28px; color: white;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
            <div>
                <p style="font-size: 14px; color: #6b7280; margin: 0;">Disbursed Today</p>
                <p style="font-size: 32px; font-weight: 700; color: #1f2937; margin: 4px 0 0 0;">@completedDisbursals.Count(d => d.DisbursalDate.Date == DateTime.Today)</p>
            </div>
        </div>
    </div>
    
    <div style="background: white; border-radius: 16px; padding: 24px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06);">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 56px; height: 56px; background: linear-gradient(135deg, #3b82f6, #60a5fa); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                <svg style="width: 28px; height: 28px; color: white;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="1" x2="12" y2="23"></line>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                </svg>
            </div>
            <div>
                <p style="font-size: 14px; color: #6b7280; margin: 0;">Total Pending Value</p>
                <p style="font-size: 24px; font-weight: 700; color: #3b82f6; margin: 4px 0 0 0;">₱@pendingDisbursals.Sum(p => p.ApprovedAmount ?? 0).ToString("N0")</p>
            </div>
        </div>
    </div>
</div>

<!-- Pending Disbursals -->
<div style="background: white; border-radius: 16px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06); overflow: hidden; margin-bottom: 32px;">
    <div style="background: linear-gradient(135deg, #f59e0b, #fbbf24); padding: 20px 24px;">
        <h3 style="font-size: 18px; font-weight: 600; color: white; margin: 0;">Pending Disbursals</h3>
    </div>
    <div style="padding: 24px;">
        @if (isLoading)
        {
            <div style="text-align: center; padding: 40px;">
                <p style="color: #6b7280;">Loading approved loans...</p>
            </div>
        }
        else if (!pendingDisbursals.Any())
        {
            <div style="text-align: center; padding: 40px;">
                <svg style="width: 48px; height: 48px; color: #d1d5db; margin: 0 auto 12px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <p style="color: #6b7280; font-size: 16px;">No approved loans pending disbursal</p>
            </div>
        }
        else
        {
            <div style="display: grid; gap: 16px;">
                @foreach (var approval in pendingDisbursals)
                {
                    <div style="background: #f9fafb; border: 2px solid #e5e7eb; border-radius: 12px; padding: 20px; transition: all 0.2s;">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 20px;">
                            <div style="flex: 1;">
                                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
                                    <h3 style="font-size: 18px; font-weight: 700; color: #1f2937; margin: 0;">
                                        @approval.Application?.ApplicationNumber
                                    </h3>
                                    <span style="background: #f59e0b; color: white; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600;">
                                        PENDING DISBURSAL
                                    </span>
                                </div>
                                
                                <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;">
                                    <div>
                                        <span style="font-size: 13px; color: #6b7280; display: block; margin-bottom: 4px;">Customer</span>
                                        <span style="font-size: 15px; font-weight: 600; color: #1f2937;">@approval.Account?.Customer?.FullName</span>
                                    </div>
                                    <div>
                                        <span style="font-size: 13px; color: #6b7280; display: block; margin-bottom: 4px;">Account Number</span>
                                        <span style="font-size: 15px; font-weight: 600; color: #1f2937;">@approval.Account?.AccountNumber</span>
                                    </div>
                                    <div>
                                        <span style="font-size: 13px; color: #6b7280; display: block; margin-bottom: 4px;">Loan Type</span>
                                        <span style="font-size: 15px; font-weight: 600; color: #1f2937;">@approval.Application?.LoanType</span>
                                    </div>
                                    <div>
                                        <span style="font-size: 13px; color: #6b7280; display: block; margin-bottom: 4px;">Approved Amount</span>
                                        <span style="font-size: 18px; font-weight: 700; color: #059669;">₱@approval.ApprovedAmount?.ToString("N2")</span>
                                    </div>
                                </div>
                                
                                <div style="display: flex; gap: 24px; margin-top: 12px;">
                                    <div>
                                        <span style="font-size: 13px; color: #6b7280;">Approval Date:</span>
                                        <span style="font-size: 13px; font-weight: 500; color: #1f2937; margin-left: 6px;">@approval.ApprovalDate.ToString("MMM dd, yyyy")</span>
                                    </div>
                                    <div>
                                        <span style="font-size: 13px; color: #6b7280;">Term:</span>
                                        <span style="font-size: 13px; font-weight: 500; color: #1f2937; margin-left: 6px;">@approval.ApprovedTermMonths months</span>
                                    </div>
                                    <div>
                                        <span style="font-size: 13px; color: #6b7280;">Interest Rate:</span>
                                        <span style="font-size: 13px; font-weight: 500; color: #1f2937; margin-left: 6px;">@approval.ApprovedInterestRate%</span>
                                    </div>
                                </div>
                            </div>
                            
                            <button @onclick="() => ShowDisbursalModal(approval)"
                                    style="background: linear-gradient(135deg, #10b981, #34d399); color: white; border: none; padding: 12px 24px; border-radius: 8px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px;">
                                <svg style="width: 20px; height: 20px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <line x1="12" y1="1" x2="12" y2="23"></line>
                                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                                </svg>
                                Disburse
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Recent Disbursals -->
<div style="background: white; border-radius: 16px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06); overflow: hidden;">
    <div style="background: linear-gradient(135deg, #10b981, #34d399); padding: 20px 24px;">
        <h3 style="font-size: 18px; font-weight: 600; color: white; margin: 0;">Recent Disbursals</h3>
    </div>
    <div style="padding: 0;">
        @if (!completedDisbursals.Any())
        {
            <div style="text-align: center; padding: 40px;">
                <p style="color: #6b7280;">No recent disbursals found</p>
            </div>
        }
        else
        {
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="background: #f9fafb;">
                        <th style="padding: 16px; text-align: left; font-weight: 600; color: #374151; border-bottom: 2px solid #e5e7eb;">Application No</th>
                        <th style="padding: 16px; text-align: left; font-weight: 600; color: #374151; border-bottom: 2px solid #e5e7eb;">Customer</th>
                        <th style="padding: 16px; text-align: left; font-weight: 600; color: #374151; border-bottom: 2px solid #e5e7eb;">Amount</th>
                        <th style="padding: 16px; text-align: left; font-weight: 600; color: #374151; border-bottom: 2px solid #e5e7eb;">Method</th>
                        <th style="padding: 16px; text-align: left; font-weight: 600; color: #374151; border-bottom: 2px solid #e5e7eb;">Disbursed Date</th>
                        <th style="padding: 16px; text-align: left; font-weight: 600; color: #374151; border-bottom: 2px solid #e5e7eb;">Processed By</th>
                        <th style="padding: 16px; text-align: left; font-weight: 600; color: #374151; border-bottom: 2px solid #e5e7eb;">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var disbursal in completedDisbursals)
                    {
                        <tr style="border-bottom: 1px solid #e5e7eb;">
                            <td style="padding: 16px; color: #1f2937; font-weight: 600;">@disbursal.Approval?.Application?.ApplicationNumber</td>
                            <td style="padding: 16px; color: #4b5563;">@disbursal.Approval?.Account?.Customer?.FullName</td>
                            <td style="padding: 16px; color: #059669; font-weight: 600;">₱@disbursal.DisbursalAmount.ToString("N2")</td>
                            <td style="padding: 16px; color: #4b5563;">@disbursal.DisbursedTo</td>
                            <td style="padding: 16px; color: #4b5563;">@disbursal.DisbursalDate.ToString("MMM dd, yyyy HH:mm")</td>
                            <td style="padding: 16px; color: #4b5563;">@disbursal.ProcessedBy</td>
                            <td style="padding: 16px;">
                                <span style="background: #dcfce7; color: #16a34a; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600;">
                                    Disbursed
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@if (showModal && selectedApproval != null)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000;" @onclick="CloseModal">
        <div style="background: white; border-radius: 16px; width: 600px; max-height: 90vh; overflow-y: auto; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);" @onclick:stopPropagation>
            <!-- Modal Header -->
            <div style="background: linear-gradient(135deg, #059669, #10b981); padding: 24px; color: white;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <h3 style="font-size: 20px; font-weight: 700; margin: 0;">Process Disbursal</h3>
                        <p style="font-size: 14px; opacity: 0.9; margin: 8px 0 0 0;">@selectedApproval.Application?.ApplicationNumber</p>
                    </div>
                    <button @onclick="CloseModal" style="background: rgba(255,255,255,0.2); border: none; width: 32px; height: 32px; border-radius: 8px; color: white; cursor: pointer; font-size: 18px;">
                        ×
                    </button>
                </div>
                <!-- Step Indicator -->
                <div style="display: flex; justify-content: center; gap: 24px; margin-top: 20px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <div style="width: 28px; height: 28px; border-radius: 50%; background: @(modalStep == 1 ? "white" : "rgba(255,255,255,0.3)"); color: @(modalStep == 1 ? "#059669" : "white"); display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 14px;">1</div>
                        <span style="font-size: 14px; color: @(modalStep == 1 ? "white" : "rgba(255,255,255,0.7)");">Details</span>
                    </div>
                    <div style="width: 40px; height: 2px; background: rgba(255,255,255,0.3); margin-top: 14px;"></div>
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <div style="width: 28px; height: 28px; border-radius: 50%; background: @(modalStep == 2 ? "white" : "rgba(255,255,255,0.3)"); color: @(modalStep == 2 ? "#059669" : "white"); display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 14px;">2</div>
                        <span style="font-size: 14px; color: @(modalStep == 2 ? "white" : "rgba(255,255,255,0.7)");">Confirm</span>
                    </div>
                </div>
            </div>
            
            <div style="padding: 24px;">
                @if (modalStep == 1)
                {
                    <!-- Step 1: Disbursal Details -->
                    <div style="margin-bottom: 20px;">
                        <label style="display: block; font-weight: 600; color: #374151; margin-bottom: 8px;">
                            Admin Reason <span style="color: #dc2626;">*</span>
                        </label>
                        <textarea @bind="adminReason" rows="2"
                                  style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px; resize: vertical;"
                                  placeholder="Enter reason for processing this disbursal as admin..."></textarea>
                    </div>
                    
                    <!-- Loan Summary -->
                    <div style="background: #f0fdf4; border-radius: 12px; padding: 20px; margin-bottom: 20px;">
                        <h4 style="font-size: 16px; font-weight: 600; color: #059669; margin: 0 0 16px 0;">Disbursal Summary</h4>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                            <div>
                                <span style="font-size: 13px; color: #6b7280; display: block;">Customer Name</span>
                                <span style="font-size: 15px; font-weight: 600; color: #1f2937;">@selectedApproval.Account?.Customer?.FullName</span>
                            </div>
                            <div>
                                <span style="font-size: 13px; color: #6b7280; display: block;">Account Number</span>
                                <span style="font-size: 15px; font-weight: 600; color: #1f2937;">@selectedApproval.Account?.AccountNumber</span>
                            </div>
                            <div>
                                <span style="font-size: 13px; color: #6b7280; display: block;">Loan Type</span>
                                <span style="font-size: 15px; font-weight: 600; color: #1f2937;">@selectedApproval.Application?.LoanType</span>
                            </div>
                            <div>
                                <span style="font-size: 13px; color: #6b7280; display: block;">Term</span>
                                <span style="font-size: 15px; font-weight: 600; color: #1f2937;">@selectedApproval.ApprovedTermMonths months</span>
                            </div>
                        </div>
                        <div style="margin-top: 16px; padding-top: 16px; border-top: 1px solid #bbf7d0;">
                            <span style="font-size: 14px; color: #6b7280; display: block;">Disbursal Amount</span>
                            <span style="font-size: 28px; font-weight: 700; color: #059669;">₱@disbursalAmount.ToString("N2")</span>
                        </div>
                    </div>
                    
                    <!-- Form Fields -->
                    <div style="margin-bottom: 20px;">
                        <label style="display: block; font-weight: 600; color: #374151; margin-bottom: 8px;">Disbursal Method</label>
                        <select @bind="disbursalMethod"
                                style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px; background: white;">
                            <option value="DirectCredit">Direct Credit to Account</option>
                            <option value="Check">Check Issuance</option>
                            <option value="Cash">Cash Release</option>
                            <option value="WireTransfer">Wire Transfer</option>
                        </select>
                    </div>
                    
                    <div style="margin-bottom: 20px;">
                        <label style="display: block; font-weight: 600; color: #374151; margin-bottom: 8px;">Reference Number</label>
                        <input type="text" @bind="referenceNumber"
                               style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;"
                               placeholder="Enter reference number" />
                    </div>
                    
                    <div style="margin-bottom: 20px;">
                        <label style="display: block; font-weight: 600; color: #374151; margin-bottom: 8px;">Remarks (Optional)</label>
                        <textarea @bind="remarks" rows="2"
                                  style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px; resize: vertical;"
                                  placeholder="Additional notes..."></textarea>
                    </div>
                }
                else
                {
                    <!-- Step 2: Confirmation -->
                    <div style="background: #f0fdf4; border: 2px solid #10b981; border-radius: 12px; padding: 24px; margin-bottom: 20px;">
                        <div style="text-align: center; margin-bottom: 20px;">
                            <div style="width: 64px; height: 64px; background: #10b981; border-radius: 50%; margin: 0 auto 16px; display: flex; align-items: center; justify-content: center;">
                                <svg style="width: 32px; height: 32px; color: white;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <line x1="12" y1="1" x2="12" y2="23"></line>
                                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                                </svg>
                            </div>
                            <h4 style="font-size: 18px; font-weight: 700; color: #059669; margin: 0;">Confirm Disbursal</h4>
                        </div>
                        
                        <div style="display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #bbf7d0;">
                            <span style="color: #6b7280;">Customer</span>
                            <span style="font-weight: 600; color: #1f2937;">@selectedApproval.Account?.Customer?.FullName</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #bbf7d0;">
                            <span style="color: #6b7280;">Account</span>
                            <span style="font-weight: 600; color: #1f2937;">@selectedApproval.Account?.AccountNumber</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #bbf7d0;">
                            <span style="color: #6b7280;">Method</span>
                            <span style="font-weight: 600; color: #1f2937;">@disbursalMethod</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #bbf7d0;">
                            <span style="color: #6b7280;">Reference</span>
                            <span style="font-weight: 600; color: #1f2937;">@referenceNumber</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; padding: 16px 0;">
                            <span style="color: #6b7280; font-weight: 600;">Disbursal Amount</span>
                            <span style="font-weight: 700; color: #059669; font-size: 20px;">₱@disbursalAmount.ToString("N2")</span>
                        </div>
                    </div>
                    
                    <div style="background: #fef3c7; border-radius: 8px; padding: 12px 16px; margin-bottom: 20px;">
                        <p style="font-size: 14px; color: #92400e; margin: 0;"><strong>Admin Reason:</strong> @adminReason</p>
                    </div>
                    
                    <div style="margin-bottom: 20px;">
                        <label style="display: flex; align-items: center; gap: 12px; cursor: pointer;">
                            <input type="checkbox" @bind="confirmDisbursal" style="width: 20px; height: 20px; accent-color: #059669;" />
                            <span style="font-size: 14px; color: #374151;">I confirm that all documents are in order and authorize this disbursal</span>
                        </label>
                    </div>
                }
            </div>
            
            <!-- Modal Footer -->
            <div style="padding: 16px 24px; background: #f9fafb; border-top: 1px solid #e5e7eb; display: flex; justify-content: space-between;">
                @if (modalStep == 1)
                {
                    <button @onclick="CloseModal" style="padding: 12px 24px; background: #f3f4f6; color: #374151; border: none; border-radius: 8px; font-weight: 500; cursor: pointer;">
                        Cancel
                    </button>
                    <button @onclick="GoToStep2" disabled="@string.IsNullOrWhiteSpace(adminReason)"
                            style="padding: 12px 24px; background: @(string.IsNullOrWhiteSpace(adminReason) ? "#d1d5db" : "linear-gradient(135deg, #059669, #10b981)"); color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer;">
                        Continue →
                    </button>
                }
                else
                {
                    <button @onclick="GoToStep1" style="padding: 12px 24px; background: #f3f4f6; color: #374151; border: none; border-radius: 8px; font-weight: 500; cursor: pointer;">
                        ← Back
                    </button>
                    <button @onclick="ProcessDisbursal" disabled="@(!confirmDisbursal || isProcessing)"
                            style="padding: 12px 24px; background: @(!confirmDisbursal ? "#d1d5db" : "linear-gradient(135deg, #059669, #10b981)"); color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer;">
                        @if (isProcessing)
                        {
                            <span>Processing...</span>
                        }
                        else
                        {
                            <span>Process Disbursal</span>
                        }
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    private bool showModal = false;
    private int modalStep = 1;
    private LoanApproval? selectedApproval;
    private Loan? selectedLoan;
    private string adminReason = "";
    private string disbursalMethod = "DirectCredit";
    private string referenceNumber = "";
    private string remarks = "";
    private decimal disbursalAmount = 0;
    private bool confirmDisbursal = false;
    private string message = "";
    private bool isError = false;
    private bool isLoading = true;
    private bool isProcessing = false;

    private List<LoanApproval> approvedLoans = new();
    private List<LoanDisbursal> completedDisbursals = new();
    private List<int> disbursedLoanIds = new();

    private IEnumerable<LoanApproval> pendingDisbursals => approvedLoans
        .Where(a => {
            using var dbContext = DbContextFactory.CreateDbContext();
            var loanId = dbContext.Loans
                .Where(l => l.ApprovalId == a.ApprovalId)
                .Select(l => l.LoanId)
                .FirstOrDefault();
            return loanId == 0 || !disbursedLoanIds.Contains(loanId);
        });

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.HasRole(AuthService.Roles.SuperAdmin))
        {
            Navigation.NavigateTo("/admin/dashboard");
            return;
        }
        
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            using var dbContext = DbContextFactory.CreateDbContext();
            
            approvedLoans = await LoanService.GetApprovedLoansAsync();
            
            disbursedLoanIds = await dbContext.LoanDisbursals
                .Select(d => d.LoanId)
                .ToListAsync();
            
            completedDisbursals = await dbContext.LoanDisbursals
                .Include(d => d.Approval)
                    .ThenInclude(a => a.Application)
                .Include(d => d.Approval)
                    .ThenInclude(a => a.Account)
                        .ThenInclude(ac => ac.Customer)
                .OrderByDescending(d => d.DisbursalDate)
                .Take(10)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            message = $"Error loading data: {ex.Message}";
            isError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowDisbursalModal(LoanApproval approval)
    {
        using var dbContext = DbContextFactory.CreateDbContext();
        selectedApproval = approval;
        selectedLoan = dbContext.Loans.FirstOrDefault(l => l.ApprovalId == approval.ApprovalId);
        disbursalAmount = approval.ApprovedAmount ?? 0;
        referenceNumber = $"REF-{DateTime.Now:yyyyMMddHHmmss}";
        modalStep = 1;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        selectedApproval = null;
        selectedLoan = null;
        adminReason = "";
        remarks = "";
        confirmDisbursal = false;
        modalStep = 1;
    }

    private void GoToStep1() => modalStep = 1;
    private void GoToStep2() => modalStep = 2;

    private async Task ProcessDisbursal()
    {
        if (string.IsNullOrWhiteSpace(adminReason) || !confirmDisbursal || selectedApproval == null) return;
        
        isProcessing = true;
        try
        {
            using var dbContext = DbContextFactory.CreateDbContext();
            
            selectedLoan = await dbContext.Loans.FirstOrDefaultAsync(l => l.ApprovalId == selectedApproval.ApprovalId);
            
            if (selectedLoan == null)
            {
                message = "Error: Loan record not found";
                isError = true;
                isProcessing = false;
                return;
            }

            var disbursal = new LoanDisbursal
            {
                LoanId = selectedLoan.LoanId,
                ApprovalId = selectedApproval.ApprovalId,
                DisbursalAmount = disbursalAmount,
                DisbursalDate = DateTime.Now,
                DisbursalStatus = "RELEASED",
                DisbursedTo = disbursalMethod,
                Reference = $"{referenceNumber} | [ADMIN] {adminReason}" + (string.IsNullOrWhiteSpace(remarks) ? "" : $" | Remarks: {remarks}"),
                ProcessedBy = AuthService.FullName ?? "SuperAdmin"
            };

            dbContext.LoanDisbursals.Add(disbursal);
            await dbContext.SaveChangesAsync();

            message = $"Disbursal of ₱{disbursalAmount:N2} processed successfully!";
            isError = false;
            
            await LoadData();
            CloseModal();
        }
        catch (Exception ex)
        {
            message = $"Error processing disbursal: {ex.Message}";
            isError = true;
        }
        finally
        {
            isProcessing = false;
        }
    }
}
