@page "/admin/teller/loan-disbursals"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@using Microsoft.EntityFrameworkCore
@inject AuthService AuthService
@inject LoanProcessService LoanService
@inject BFASDbContext DbContext
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="admin-page">
    <div class="page-header">
        <h1 style="color: #10b981;">
            <svg style="width: 32px; height: 32px; margin-right: 12px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="1" x2="12" y2="23"></line>
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
            Loan Disbursals (Admin)
        </h1>
        <p class="page-subtitle">Process loan disbursements to customer accounts</p>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success")">@message</div>
    }

    <div class="admin-card">
        <div class="card-header">
            <h3>Pending Disbursals</h3>
        </div>
        <div class="card-body">
            @if (isLoading)
            {
                <div class="text-center" style="padding: 40px;">
                    <p style="color: #6b7280;">Loading approved loans...</p>
                </div>
            }
            else if (!pendingDisbursals.Any())
            {
                <div class="text-center" style="padding: 40px;">
                    <p style="color: #6b7280;">No approved loans pending disbursal</p>
                </div>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Application No</th>
                            <th>Customer</th>
                            <th>Disbursal Amount</th>
                            <th>Account Number</th>
                            <th>Approval Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var approval in pendingDisbursals)
                        {
                            <tr>
                                <td><strong>@approval.Application?.ApplicationNumber</strong></td>
                                <td>@approval.Account?.Customer?.FullName</td>
                                <td style="color: #10b981; font-weight: 600;">₱@approval.ApprovedAmount?.ToString("N2")</td>
                                <td>@approval.Account?.AccountNumber</td>
                                <td>@approval.ApprovalDate.ToString("MMM dd, yyyy")</td>
                                <td><span class="badge badge-warning">Pending Disbursal</span></td>
                                <td>
                                    <button class="btn btn-sm btn-success" @onclick="() => ShowDisbursalModal(approval)">Disburse</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div class="admin-card" style="margin-top: 24px;">
        <div class="card-header">
            <h3>Recent Disbursals</h3>
        </div>
        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Application No</th>
                        <th>Customer</th>
                        <th>Amount</th>
                        <th>Disbursed Date</th>
                        <th>Processed By</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var disbursal in completedDisbursals)
                    {
                        <tr>
                            <td>@disbursal.Approval?.Application?.ApplicationNumber</td>
                            <td>@disbursal.Approval?.Account?.Customer?.FullName</td>
                            <td>₱@disbursal.DisbursalAmount.ToString("N2")</td>
                            <td>@disbursal.DisbursalDate.ToString("MMM dd, yyyy HH:mm")</td>
                            <td>@disbursal.ProcessedBy</td>
                            <td><span class="badge badge-success">Disbursed</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (showModal && selectedApproval != null)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-content" @onclick:stopPropagation>
            <div class="modal-header">
                <h4>Process Disbursal - @selectedApproval.Application?.ApplicationNumber</h4>
                <button class="close-btn" @onclick="CloseModal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Admin Reason <span class="required">*</span></label>
                    <textarea @bind="adminReason" class="form-control" rows="2" 
                        placeholder="Enter reason for processing this disbursal..."></textarea>
                </div>
                <hr />
                
                <div class="disbursal-summary" style="background: #f0fdf4; padding: 20px; border-radius: 8px; margin-bottom: 16px;">
                    <h5 style="color: #10b981;">Disbursal Summary</h5>
                    <table class="table table-bordered">
                        <tr>
                            <td>Customer Name</td>
                            <td><strong>@selectedApproval.Account?.Customer?.FullName</strong></td>
                        </tr>
                        <tr>
                            <td>Account Number</td>
                            <td><strong>@selectedApproval.Account?.AccountNumber</strong></td>
                        </tr>
                        <tr>
                            <td>Disbursal Amount</td>
                            <td style="color: #10b981; font-size: 1.2em;"><strong>₱@disbursalAmount.ToString("N2")</strong></td>
                        </tr>
                    </table>
                </div>
                
                <div class="form-group">
                    <label>Disbursal Method</label>
                    <select @bind="disbursalMethod" class="form-control">
                        <option value="DirectCredit">Direct Credit to Account</option>
                        <option value="Check">Check Issuance</option>
                        <option value="Cash">Cash Release</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label>Reference Number</label>
                    <input type="text" @bind="referenceNumber" class="form-control" placeholder="Enter reference number" />
                </div>
                
                <div class="form-group">
                    <label class="checkbox-item">
                        <input type="checkbox" @bind="confirmDisbursal" />
                        I confirm that all documents are in order and authorize this disbursal
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                <button class="btn btn-success" @onclick="ProcessDisbursal" disabled="@(!confirmDisbursal || string.IsNullOrWhiteSpace(adminReason))">
                    Process Disbursal
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool showModal = false;
    private LoanApproval? selectedApproval;
    private Loan? selectedLoan;
    private string adminReason = "";
    private string disbursalMethod = "DirectCredit";
    private string referenceNumber = "";
    private decimal disbursalAmount = 0;
    private bool confirmDisbursal = false;
    private string message = "";
    private bool isError = false;
    private bool isLoading = true;

    private List<LoanApproval> approvedLoans = new();

    private IEnumerable<LoanApproval> pendingDisbursals => approvedLoans
        .Where(a => !DbContext.LoanDisbursals.Any(d => d.LoanId == DbContext.Loans
            .Where(l => l.ApprovalId == a.ApprovalId)
            .Select(l => l.LoanId)
            .FirstOrDefault()));

    private List<LoanDisbursal> completedDisbursals = new();

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.HasRole(AuthService.Roles.SuperAdmin))
        {
            Navigation.NavigateTo("/admin/dashboard");
            return;
        }
        
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            approvedLoans = await LoanService.GetApprovedLoansAsync();
            completedDisbursals = await DbContext.LoanDisbursals
                .Include(d => d.Approval)
                    .ThenInclude(a => a.Application)
                .Include(d => d.Approval)
                    .ThenInclude(a => a.Account)
                        .ThenInclude(ac => ac.Customer)
                .OrderByDescending(d => d.DisbursalDate)
                .Take(10)
                .ToListAsync();
        }
        catch
        {
            message = "Error loading data";
            isError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowDisbursalModal(LoanApproval approval)
    {
        selectedApproval = approval;
        selectedLoan = DbContext.Loans.FirstOrDefault(l => l.ApprovalId == approval.ApprovalId);
        disbursalAmount = approval.ApprovedAmount ?? 0;
        referenceNumber = $"REF-{DateTime.Now:yyyyMMddHHmmss}";
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        selectedApproval = null;
        selectedLoan = null;
        adminReason = "";
        confirmDisbursal = false;
    }

    private async Task ProcessDisbursal()
    {
        if (string.IsNullOrWhiteSpace(adminReason) || !confirmDisbursal || selectedApproval == null) return;
        
        try
        {
            if (selectedLoan == null)
            {
                message = "Error: Loan record not found";
                isError = true;
                return;
            }

            var disbursal = new LoanDisbursal
            {
                LoanId = selectedLoan.LoanId,
                ApprovalId = selectedApproval.ApprovalId,
                DisbursalAmount = disbursalAmount,
                DisbursalDate = DateTime.Now,
                DisbursalStatus = "RELEASED",
                DisbursedTo = disbursalMethod,
                Reference = $"{referenceNumber} | [ADMIN] {adminReason}",
                ProcessedBy = AuthService.FullName ?? "Admin"
            };

            DbContext.LoanDisbursals.Add(disbursal);
            await DbContext.SaveChangesAsync();

            message = $"Disbursal of ₱{disbursalAmount:N2} processed successfully!";
            isError = false;
            
            await LoadData();
            CloseModal();
        }
        catch (Exception ex)
        {
            message = $"Error processing disbursal: {ex.Message}";
            isError = true;
        }
    }
}
