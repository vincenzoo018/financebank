@page "/admin/teller/reports"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@using Microsoft.EntityFrameworkCore
@inject AuthService AuthService
@inject TellerBankingService TellerBankingService
@inject IDbContextFactory<BFASDbContext> DbContextFactory

<!-- Header with Gradient -->
<div style="background: linear-gradient(135deg, #3b82f6, #1d4ed8); border-radius: 16px; padding: 32px; margin-bottom: 32px; color: white;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="width: 48px; height: 48px; background: rgba(255,255,255,0.2); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
            <svg style="width: 28px; height: 28px;" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
        </div>
        <div>
            <h1 style="font-size: 28px; font-weight: 700; margin: 0;">Teller Reports</h1>
            <p style="margin: 4px 0 0; opacity: 0.9; font-size: 14px;">SuperAdmin: View comprehensive reports per teller user</p>
        </div>
    </div>
</div>

<!-- Admin Notice -->
<div style="background: #fef3c7; border: 1px solid #f59e0b; border-radius: 12px; padding: 16px 20px; margin-bottom: 24px; display: flex; align-items: flex-start; gap: 12px;">
    <svg style="width: 20px; height: 20px; color: #d97706; flex-shrink: 0; margin-top: 2px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
    </svg>
    <div>
        <p style="font-weight: 600; color: #92400e; margin: 0 0 4px 0;">Administrative Report Access</p>
        <p style="font-size: 14px; color: #a16207; margin: 0;">You have access to all teller transaction data. Filter by individual teller to view their performance reports.</p>
    </div>
</div>

<!-- Teller Performance Overview -->
<div style="background: white; border-radius: 16px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); overflow: hidden; margin-bottom: 32px;">
    <div style="background: linear-gradient(135deg, #059669, #10b981); padding: 20px 24px;">
        <h3 style="font-size: 18px; font-weight: 600; color: white; margin: 0;">Teller Performance Overview</h3>
    </div>
    <div style="padding: 24px;">
        @if (tellerPerformance.Any())
        {
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px;">
                @foreach (var teller in tellerPerformance)
                {
                    <div style="background: @(selectedTellerId == teller.EmployeeId ? "#dbeafe" : "#f9fafb"); border: 2px solid @(selectedTellerId == teller.EmployeeId ? "#3b82f6" : "#e5e7eb"); border-radius: 12px; padding: 20px; cursor: pointer; transition: all 0.2s;"
                         @onclick="() => FilterByTeller(teller.EmployeeId)">
                        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
                            <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #3b82f6, #1d4ed8); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 18px;">
                                @teller.FullName.Substring(0, 1).ToUpper()
                            </div>
                            <div>
                                <p style="font-weight: 700; color: #1f2937; margin: 0; font-size: 16px;">@teller.FullName</p>
                                <p style="font-size: 12px; color: #6b7280; margin: 4px 0 0 0;">@teller.Department</p>
                            </div>
                        </div>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                            <div>
                                <p style="font-size: 12px; color: #6b7280; margin: 0;">Transactions Today</p>
                                <p style="font-size: 20px; font-weight: 700; color: #1f2937; margin: 4px 0 0 0;">@teller.TransactionCount</p>
                            </div>
                            <div>
                                <p style="font-size: 12px; color: #6b7280; margin: 0;">Total Volume</p>
                                <p style="font-size: 16px; font-weight: 700; color: #059669; margin: 4px 0 0 0;">₱@teller.TotalVolume.ToString("N0")</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div style="text-align: center; padding: 40px; color: #6b7280;">
                <p>No teller data found for today.</p>
            </div>
        }
    </div>
</div>

<!-- Summary Cards -->
<div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-bottom: 32px;">
    <!-- Today's Deposits -->
    <div style="background: white; border-radius: 16px; padding: 24px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 56px; height: 56px; background: linear-gradient(135deg, #10b981, #34d399); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                <svg style="width: 28px; height: 28px; color: white;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path d="M12 4v16m8-8H4"/>
                </svg>
            </div>
            <div>
                <p style="font-size: 14px; color: #6b7280; margin: 0;">Total Deposits</p>
                <p style="font-size: 24px; font-weight: 700; color: #059669; margin: 4px 0 0 0;">₱@todayDeposits.ToString("N2")</p>
                <p style="font-size: 12px; color: #6b7280; margin: 4px 0 0 0;">@depositCount transactions</p>
            </div>
        </div>
    </div>

    <!-- Today's Withdrawals -->
    <div style="background: white; border-radius: 16px; padding: 24px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 56px; height: 56px; background: linear-gradient(135deg, #ef4444, #f87171); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                <svg style="width: 28px; height: 28px; color: white;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path d="M20 12H4"/>
                </svg>
            </div>
            <div>
                <p style="font-size: 14px; color: #6b7280; margin: 0;">Total Withdrawals</p>
                <p style="font-size: 24px; font-weight: 700; color: #dc2626; margin: 4px 0 0 0;">₱@todayWithdrawals.ToString("N2")</p>
                <p style="font-size: 12px; color: #6b7280; margin: 4px 0 0 0;">@withdrawalCount transactions</p>
            </div>
        </div>
    </div>

    <!-- Net Cash Flow -->
    <div style="background: white; border-radius: 16px; padding: 24px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 56px; height: 56px; background: linear-gradient(135deg, #3b82f6, #60a5fa); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                <svg style="width: 28px; height: 28px; color: white;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6"/>
                </svg>
            </div>
            <div>
                <p style="font-size: 14px; color: #6b7280; margin: 0;">Net Cash Flow</p>
                <p style="font-size: 24px; font-weight: 700; color: @(netCashFlow >= 0 ? "#059669" : "#dc2626"); margin: 4px 0 0 0;">@(netCashFlow >= 0 ? "+" : "")₱@netCashFlow.ToString("N2")</p>
                <p style="font-size: 12px; color: #6b7280; margin: 4px 0 0 0;">deposits - withdrawals</p>
            </div>
        </div>
    </div>

    <!-- Total Transactions -->
    <div style="background: white; border-radius: 16px; padding: 24px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 56px; height: 56px; background: linear-gradient(135deg, #f59e0b, #fbbf24); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                <svg style="width: 28px; height: 28px; color: white;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                </svg>
            </div>
            <div>
                <p style="font-size: 14px; color: #6b7280; margin: 0;">Total Transactions</p>
                <p style="font-size: 24px; font-weight: 700; color: #1f2937; margin: 4px 0 0 0;">@(depositCount + withdrawalCount)</p>
                <p style="font-size: 12px; color: #6b7280; margin: 4px 0 0 0;">processed today</p>
            </div>
        </div>
    </div>
</div>

<!-- Filter and Export Section -->
<div style="background: white; border-radius: 16px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); overflow: hidden; margin-bottom: 24px;">
    <div style="padding: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 16px;">
            <div style="display: flex; gap: 16px; align-items: flex-end; flex-wrap: wrap;">
                <div>
                    <label style="font-size: 13px; font-weight: 600; color: #374151; display: block; margin-bottom: 8px;">Teller</label>
                    <select @bind="selectedTellerId" @bind:after="ApplyFilters"
                            style="padding: 12px 16px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px; background: white; min-width: 200px;">
                        <option value="0">All Tellers</option>
                        @foreach (var teller in allTellers)
                        {
                            <option value="@teller.EmployeeId">@teller.FullName</option>
                        }
                    </select>
                </div>
                <div>
                    <label style="font-size: 13px; font-weight: 600; color: #374151; display: block; margin-bottom: 8px;">Date From</label>
                    <input type="date" @bind="dateFrom"
                           style="padding: 12px 16px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;" />
                </div>
                <div>
                    <label style="font-size: 13px; font-weight: 600; color: #374151; display: block; margin-bottom: 8px;">Date To</label>
                    <input type="date" @bind="dateTo"
                           style="padding: 12px 16px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;" />
                </div>
                <div>
                    <label style="font-size: 13px; font-weight: 600; color: #374151; display: block; margin-bottom: 8px;">Type</label>
                    <select @bind="filterType"
                            style="padding: 12px 16px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px; background: white;">
                        <option value="">All Types</option>
                        <option value="Deposit">Deposits</option>
                        <option value="Withdrawal">Withdrawals</option>
                    </select>
                </div>
                <button @onclick="ApplyFilters"
                        style="padding: 12px 24px; background: linear-gradient(135deg, #3b82f6, #1d4ed8); color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px;">
                    <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    Apply Filters
                </button>
            </div>
            
            <div style="display: flex; gap: 12px;">
                <button @onclick="ExportToExcel"
                        style="padding: 12px 24px; background: linear-gradient(135deg, #059669, #10b981); color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px;">
                    <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                    Export Excel
                </button>
                <button @onclick="ExportToPDF"
                        style="padding: 12px 24px; background: linear-gradient(135deg, #dc2626, #ef4444); color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px;">
                    <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                    </svg>
                    Export PDF
                </button>
            </div>
        </div>
    </div>
</div>

@if (selectedTellerId > 0 && GetSelectedTeller() != null)
{
    <!-- Selected Teller Details -->
    var selectedTeller = GetSelectedTeller()!;
    {
        <div style="background: linear-gradient(135deg, #dbeafe, #bfdbfe); border: 2px solid #3b82f6; border-radius: 16px; padding: 24px; margin-bottom: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div style="display: flex; align-items: center; gap: 16px;">
                    <div style="width: 64px; height: 64px; background: linear-gradient(135deg, #3b82f6, #1d4ed8); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 24px;">
                        @selectedTeller.FullName.Substring(0, 1).ToUpper()
                    </div>
                    <div>
                        <h3 style="font-size: 20px; font-weight: 700; color: #1e40af; margin: 0;">@selectedTeller.FullName</h3>
                        <p style="font-size: 14px; color: #3b82f6; margin: 4px 0 0 0;">@selectedTeller.Department • Employee ID: @selectedTeller.EmployeeId</p>
                    </div>
                </div>
                <button @onclick="ClearTellerFilter"
                        style="padding: 10px 20px; background: white; color: #3b82f6; border: 2px solid #3b82f6; border-radius: 8px; font-weight: 600; cursor: pointer;">
                    ✕ Clear Filter
                </button>
            </div>
        </div>
    }
}

<!-- Transactions Table -->
<div style="background: white; border-radius: 16px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); overflow: hidden;">
    <div style="background: linear-gradient(135deg, #3b82f6, #1d4ed8); padding: 20px 24px; display: flex; justify-content: space-between; align-items: center;">
        <h3 style="font-size: 18px; font-weight: 600; color: white; margin: 0;">
            Transaction History @(selectedTellerId > 0 ? $"- {allTellers.FirstOrDefault(t => t.EmployeeId == selectedTellerId)?.FullName}" : "- All Tellers")
        </h3>
        <span style="background: rgba(255,255,255,0.2); color: white; padding: 6px 16px; border-radius: 20px; font-size: 14px; font-weight: 500;">
            @transactions.Count transactions
        </span>
    </div>
    
    @if (isLoading)
    {
        <div style="padding: 60px; text-align: center; color: #6b7280;">
            <p style="margin: 0;">Loading transactions...</p>
        </div>
    }
    else if (transactions.Any())
    {
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="background: #f9fafb;">
                        <th style="padding: 16px; text-align: left; font-weight: 600; color: #374151; border-bottom: 2px solid #e5e7eb;">Date/Time</th>
                        <th style="padding: 16px; text-align: left; font-weight: 600; color: #374151; border-bottom: 2px solid #e5e7eb;">Account #</th>
                        <th style="padding: 16px; text-align: left; font-weight: 600; color: #374151; border-bottom: 2px solid #e5e7eb;">Customer</th>
                        <th style="padding: 16px; text-align: left; font-weight: 600; color: #374151; border-bottom: 2px solid #e5e7eb;">Type</th>
                        <th style="padding: 16px; text-align: left; font-weight: 600; color: #374151; border-bottom: 2px solid #e5e7eb;">Amount</th>
                        <th style="padding: 16px; text-align: left; font-weight: 600; color: #374151; border-bottom: 2px solid #e5e7eb;">Processed By</th>
                        <th style="padding: 16px; text-align: left; font-weight: 600; color: #374151; border-bottom: 2px solid #e5e7eb;">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var trans in transactions.Take(100))
                    {
                        <tr style="border-bottom: 1px solid #e5e7eb;">
                            <td style="padding: 16px; color: #4b5563; font-size: 14px;">@trans.Time.ToString("MM/dd/yyyy HH:mm")</td>
                            <td style="padding: 16px; font-weight: 600; color: #1f2937;">@trans.AccountNumber</td>
                            <td style="padding: 16px; color: #4b5563;">@trans.CustomerName</td>
                            <td style="padding: 16px;">
                                <span style="padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; 
                                             background: @(trans.Type == "Deposit" ? "#dcfce7" : "#fee2e2"); 
                                             color: @(trans.Type == "Deposit" ? "#16a34a" : "#dc2626");">
                                    @trans.Type
                                </span>
                            </td>
                            <td style="padding: 16px; font-weight: 600; color: @(trans.Type == "Deposit" ? "#059669" : "#dc2626");">
                                @(trans.Type == "Deposit" ? "+" : "-")₱@trans.Amount.ToString("N2")
                            </td>
                            <td style="padding: 16px; color: #4b5563; font-size: 14px;">@trans.ProcessedBy</td>
                            <td style="padding: 16px;">
                                <span style="padding: 4px 12px; background: #dcfce7; color: #16a34a; border-radius: 20px; font-size: 12px; font-weight: 600;">
                                    Completed
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        @if (transactions.Count > 100)
        {
            <div style="padding: 16px 24px; background: #f9fafb; text-align: center; color: #6b7280; font-size: 14px; border-top: 1px solid #e5e7eb;">
                Showing 100 of @transactions.Count transactions. Export to see all records.
            </div>
        }
    }
    else
    {
        <div style="padding: 60px; text-align: center; color: #6b7280;">
            <svg style="width: 48px; height: 48px; color: #d1d5db; margin: 0 auto 16px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
            <p style="margin: 0; font-size: 16px;">No transactions found for the selected filters.</p>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private decimal todayDeposits = 0;
    private decimal todayWithdrawals = 0;
    private decimal netCashFlow = 0;
    private int depositCount = 0;
    private int withdrawalCount = 0;
    
    private DateTime dateFrom = DateTime.Today;
    private DateTime dateTo = DateTime.Today;
    private string filterType = "";
    private int selectedTellerId = 0;
    
    private List<TransactionRecord> transactions = new();
    private List<TellerInfo> allTellers = new();
    private List<TellerPerformance> tellerPerformance = new();
    
    private class TransactionRecord
    {
        public string AccountNumber { get; set; } = "";
        public string CustomerName { get; set; } = "";
        public string Type { get; set; } = "";
        public decimal Amount { get; set; }
        public DateTime Time { get; set; }
        public int? ProcessedByEmployeeId { get; set; }
        public string ProcessedBy { get; set; } = "Teller";
    }
    
    private class TellerInfo
    {
        public int EmployeeId { get; set; }
        public string FullName { get; set; } = "";
        public string Department { get; set; } = "";
    }
    
    private class TellerPerformance
    {
        public int EmployeeId { get; set; }
        public string FullName { get; set; } = "";
        public string Department { get; set; } = "";
        public int TransactionCount { get; set; }
        public decimal TotalVolume { get; set; }
    }
    
    private TellerInfo? GetSelectedTeller()
    {
        return allTellers.FirstOrDefault(t => t.EmployeeId == selectedTellerId);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadTellers();
        await LoadData();
    }

    private async Task LoadTellers()
    {
        try
        {
            using var context = await DbContextFactory.CreateDbContextAsync();
            
            // Get all employees who are tellers (based on department or transactions processed)
            var employees = await context.Employees
                .Include(e => e.User)
                .Where(e => e.IsActive && (e.Department.Contains("Teller") || e.Position == "Teller"))
                .ToListAsync();
            
            // Also get employees who have processed transactions
            var tellerIds = await context.CustomerTransactions
                .Where(t => t.ProcessedByEmployeeId.HasValue)
                .Select(t => t.ProcessedByEmployeeId!.Value)
                .Distinct()
                .ToListAsync();
            
            var additionalEmployees = await context.Employees
                .Include(e => e.User)
                .Where(e => tellerIds.Contains(e.EmployeeId) && e.IsActive)
                .ToListAsync();
            
            var allEmployees = employees.Union(additionalEmployees).DistinctBy(e => e.EmployeeId);
            
            allTellers = allEmployees.Select(e => new TellerInfo
            {
                EmployeeId = e.EmployeeId,
                FullName = $"{e.FirstName} {e.LastName}",
                Department = e.Department
            }).OrderBy(t => t.FullName).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading tellers: {ex.Message}");
        }
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            using var context = await DbContextFactory.CreateDbContextAsync();
            var today = DateTime.Today;
            
            // Build query
            var query = context.CustomerTransactions
                .Include(ct => ct.Account)
                    .ThenInclude(ca => ca.Customer)
                .Include(ct => ct.ProcessedByEmployee)
                .Where(ct => ct.CreatedAt.Date >= dateFrom.Date && ct.CreatedAt.Date <= dateTo.Date);
            
            // Filter by teller if selected
            if (selectedTellerId > 0)
            {
                query = query.Where(ct => ct.ProcessedByEmployeeId == selectedTellerId);
            }
            
            // Filter by type if selected
            if (!string.IsNullOrEmpty(filterType))
            {
                query = query.Where(ct => ct.TransactionType == filterType);
            }
            
            var dbTransactions = await query
                .OrderByDescending(ct => ct.CreatedAt)
                .ToListAsync();
            
            transactions = dbTransactions.Select(t => new TransactionRecord
            {
                AccountNumber = t.Account?.AccountNumber ?? "",
                CustomerName = t.Account?.Customer?.FullName ?? "N/A",
                Type = t.TransactionType,
                Amount = t.Amount,
                Time = t.CreatedAt,
                ProcessedByEmployeeId = t.ProcessedByEmployeeId,
                ProcessedBy = t.ProcessedByEmployee != null 
                    ? $"{t.ProcessedByEmployee.FirstName} {t.ProcessedByEmployee.LastName}" 
                    : "System"
            }).ToList();
            
            // Calculate summary statistics
            var deposits = transactions.Where(t => t.Type == "Deposit").ToList();
            var withdrawals = transactions.Where(t => t.Type == "Withdrawal").ToList();
            
            todayDeposits = deposits.Sum(t => t.Amount);
            todayWithdrawals = withdrawals.Sum(t => t.Amount);
            netCashFlow = todayDeposits - todayWithdrawals;
            depositCount = deposits.Count;
            withdrawalCount = withdrawals.Count;
            
            // Calculate teller performance for today
            var todayTransactions = await context.CustomerTransactions
                .Include(ct => ct.ProcessedByEmployee)
                .Where(ct => ct.CreatedAt.Date == today && ct.ProcessedByEmployeeId.HasValue)
                .ToListAsync();
            
            tellerPerformance = todayTransactions
                .GroupBy(t => t.ProcessedByEmployeeId)
                .Select(g => new TellerPerformance
                {
                    EmployeeId = g.Key ?? 0,
                    FullName = g.First().ProcessedByEmployee != null 
                        ? $"{g.First().ProcessedByEmployee!.FirstName} {g.First().ProcessedByEmployee!.LastName}" 
                        : "Unknown",
                    Department = g.First().ProcessedByEmployee?.Department ?? "",
                    TransactionCount = g.Count(),
                    TotalVolume = g.Sum(t => t.Amount)
                })
                .OrderByDescending(t => t.TransactionCount)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task FilterByTeller(int tellerId)
    {
        selectedTellerId = tellerId;
        await ApplyFilters();
    }
    
    private async Task ClearTellerFilter()
    {
        selectedTellerId = 0;
        await ApplyFilters();
    }

    private async Task ApplyFilters()
    {
        await LoadData();
    }

    private void ExportToExcel()
    {
        var tellerName = selectedTellerId > 0 
            ? allTellers.FirstOrDefault(t => t.EmployeeId == selectedTellerId)?.FullName ?? "Unknown"
            : "All Tellers";
            
        var content = $"Teller Report - {tellerName}\n";
        content += $"Period: {dateFrom:yyyy-MM-dd} to {dateTo:yyyy-MM-dd}\n\n";
        content += "Date,Time,Account Number,Customer,Type,Amount,Processed By,Status\n";
        
        foreach (var trans in transactions)
        {
            content += $"{trans.Time:yyyy-MM-dd},{trans.Time:HH:mm:ss},{trans.AccountNumber},{trans.CustomerName},{trans.Type},{trans.Amount:N2},{trans.ProcessedBy},Completed\n";
        }
        
        Console.WriteLine("Excel export triggered");
    }

    private void ExportToPDF()
    {
        var tellerName = selectedTellerId > 0 
            ? allTellers.FirstOrDefault(t => t.EmployeeId == selectedTellerId)?.FullName ?? "Unknown"
            : "All Tellers";
            
        var content = $@"
========================================================
           TELLER TRANSACTION REPORT                   
              FinanceBank System                       
========================================================

Generated: {DateTime.Now:yyyy-MM-dd HH:mm:ss}
Generated By: {AuthService.CurrentUser} (SuperAdmin)

Teller: {tellerName}
Report Period: {dateFrom:yyyy-MM-dd} to {dateTo:yyyy-MM-dd}

========================================================
                     SUMMARY                           
========================================================

Total Deposits:    ₱{todayDeposits:N2} ({depositCount} transactions)
Total Withdrawals: ₱{todayWithdrawals:N2} ({withdrawalCount} transactions)
Net Cash Flow:     ₱{netCashFlow:N2}

========================================================
                 TRANSACTIONS                          
========================================================

";
        foreach (var trans in transactions.Take(100))
        {
            content += $"{trans.Time:yyyy-MM-dd HH:mm} | {trans.AccountNumber} | {trans.Type}: ₱{trans.Amount:N2} | By: {trans.ProcessedBy}\n";
        }
        
        content += @"
========================================================
              END OF REPORT                            
========================================================
";
        Console.WriteLine("PDF export triggered");
    }
