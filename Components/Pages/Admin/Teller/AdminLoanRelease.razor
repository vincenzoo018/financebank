@page "/admin/teller/loan-release"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@using Microsoft.EntityFrameworkCore
@inject AuthService AuthService
@inject LoanProcessService LoanService
@inject IDbContextFactory<BFASDbContext> DbFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div style="padding: 24px;">
    <!-- Page Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <div>
            <h2 style="margin: 0; color: #1f2937; font-weight: 700; font-size: 24px;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2"
                    style="margin-right: 10px; vertical-align: middle;">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                Loan Release (Admin)
            </h2>
            <p style="margin: 4px 0 0 0; color: #6b7280; font-size: 14px;">Mark fully paid loans as released and
                generate clearance</p>
        </div>
    </div>

    <!-- Admin Notice -->
    <div
        style="background: #fef3c7; border: 1px solid #f59e0b; border-radius: 12px; padding: 16px; margin-bottom: 24px;">
        <div style="display: flex; align-items: center; gap: 12px;">
            <span style="font-size: 24px;">⚠️</span>
            <div>
                <p style="margin: 0; font-weight: 600; color: #92400e;">Administrative Access</p>
                <p style="margin: 4px 0 0; font-size: 13px; color: #a16207;">You are performing loan release operations
                    as SuperAdmin. All actions are logged for audit purposes.</p>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div
        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">
        <div
            style="background: linear-gradient(135deg, #f0fdf4, #dcfce7); border-radius: 12px; padding: 20px; border: 1px solid #bbf7d0;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div
                    style="width: 48px; height: 48px; background: #059669; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                </div>
                <div>
                    <p style="margin: 0; color: #059669; font-size: 12px; font-weight: 600; text-transform: uppercase;">
                        Pending Release</p>
                    <p style="margin: 4px 0 0 0; font-size: 28px; font-weight: 700; color: #065f46;">
                        @loansForRelease.Count</p>
                </div>
            </div>
        </div>
        <div
            style="background: linear-gradient(135deg, #eff6ff, #dbeafe); border-radius: 12px; padding: 20px; border: 1px solid #bfdbfe;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div
                    style="width: 48px; height: 48px; background: #3b82f6; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                        <line x1="12" y1="1" x2="12" y2="23"></line>
                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                    </svg>
                </div>
                <div>
                    <p style="margin: 0; color: #3b82f6; font-size: 12px; font-weight: 600; text-transform: uppercase;">
                        Total Paid Amount</p>
                    <p style="margin: 4px 0 0 0; font-size: 22px; font-weight: 700; color: #1e40af;">
                        ₱@loansForRelease.Sum(l => l.LoanAmount - l.OutstandingBalance).ToString("N0")</p>
                </div>
            </div>
        </div>
        <div
            style="background: linear-gradient(135deg, #fefce8, #fef9c3); border-radius: 12px; padding: 20px; border: 1px solid #fde047;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div
                    style="width: 48px; height: 48px; background: #eab308; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                    </svg>
                </div>
                <div>
                    <p style="margin: 0; color: #ca8a04; font-size: 12px; font-weight: 600; text-transform: uppercase;">
                        Released Today</p>
                    <p style="margin: 4px 0 0 0; font-size: 28px; font-weight: 700; color: #854d0e;">
                        @releasedLoans.Count(l => l.CreatedAt.Date == DateTime.Today)</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Alerts -->
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div
            style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); border: 1px solid #6ee7b7; color: #065f46; padding: 16px 20px; border-radius: 12px; margin-bottom: 20px; display: flex; align-items: center; gap: 12px; box-shadow: 0 2px 8px rgba(16, 185, 129, 0.15);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <span style="font-weight: 500;">@successMessage</span>
            <button @onclick="() => successMessage = string.Empty"
                style="margin-left: auto; background: none; border: none; color: #065f46; cursor: pointer; font-size: 18px;">×</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div
            style="background: #fee2e2; border: 1px solid #fecaca; color: #991b1b; padding: 16px 20px; border-radius: 12px; margin-bottom: 20px; display: flex; align-items: center; gap: 12px;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="15" y1="9" x2="9" y2="15"></line>
                <line x1="9" y1="9" x2="15" y2="15"></line>
            </svg>
            <span style="font-weight: 500;">@errorMessage</span>
            <button @onclick="() => errorMessage = string.Empty"
                style="margin-left: auto; background: none; border: none; color: #991b1b; cursor: pointer; font-size: 18px;">×</button>
        </div>
    }

    <!-- Loans Ready for Release Card -->
    <div
        style="background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden; margin-bottom: 24px;">
        <div style="background: linear-gradient(135deg, #059669, #10b981); color: white; padding: 20px 24px;">
            <h4 style="margin: 0; font-weight: 600; font-size: 18px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    style="margin-right: 8px; vertical-align: middle;">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                Loans Ready for Release
            </h4>
            <p style="margin: 6px 0 0 0; opacity: 0.9; font-size: 13px;">Fully paid loans pending clearance release</p>
        </div>

        <div style="padding: 24px;">
            @if (isLoading)
            {
                <div style="text-align: center; padding: 60px;">
                    <div
                        style="width: 48px; height: 48px; border: 4px solid #e5e7eb; border-top-color: #059669; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto;">
                    </div>
                    <p style="margin-top: 16px; color: #6b7280; font-size: 15px;">Loading loans...</p>
                </div>
            }
            else if (!loansForRelease.Any())
            {
                <div
                    style="text-align: center; padding: 80px 20px; background: linear-gradient(135deg, #f9fafb, #f3f4f6); border-radius: 16px;">
                    <div
                        style="width: 80px; height: 80px; background: #e5e7eb; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    </div>
                    <h5 style="color: #4b5563; margin-top: 20px; font-size: 18px; font-weight: 600;">No Loans Pending
                        Release</h5>
                    <p style="color: #9ca3af; font-size: 14px; margin-top: 8px;">All fully paid loans have been released.
                    </p>
                </div>
            }
            else
            {
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: separate; border-spacing: 0;">
                        <thead>
                            <tr style="background: linear-gradient(135deg, #f8fafc, #f1f5f9);">
                                <th
                                    style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">
                                    CONTRACT NO</th>
                                <th
                                    style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">
                                    CUSTOMER</th>
                                <th
                                    style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">
                                    LOAN TYPE</th>
                                <th
                                    style="padding: 14px 16px; text-align: right; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">
                                    ORIGINAL AMOUNT</th>
                                <th
                                    style="padding: 14px 16px; text-align: right; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">
                                    TOTAL PAID</th>
                                <th
                                    style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">
                                    COMPLETED</th>
                                <th
                                    style="padding: 14px 16px; text-align: center; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">
                                    ACTION</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var loan in loansForRelease)
                            {
                                <tr style="border-bottom: 1px solid #f1f5f9; transition: all 0.2s;" class="table-row-hover">
                                    <td style="padding: 16px;">
                                        <span
                                            style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); color: #065f46; padding: 6px 14px; border-radius: 20px; font-weight: 600; font-size: 13px; display: inline-block;">
                                            @loan.LoanNumber
                                        </span>
                                    </td>
                                    <td style="padding: 16px;">
                                        <div style="font-weight: 600; color: #1e293b; font-size: 14px;">
                                            @(loan.Account?.Customer?.FullName ?? "N/A")</div>
                                        <div style="font-size: 12px; color: #64748b; margin-top: 2px;">
                                            @(loan.Account?.AccountNumber ?? "")</div>
                                    </td>
                                    <td style="padding: 16px; color: #475569; font-weight: 500;">@loan.LoanType</td>
                                    <td style="padding: 16px; text-align: right; font-weight: 600; color: #1e293b;">
                                        ₱@loan.LoanAmount.ToString("N2")</td>
                                    <td style="padding: 16px; text-align: right;">
                                        <span style="font-weight: 700; color: #059669; font-size: 15px;">₱@((loan.LoanAmount -
                                                                                loan.OutstandingBalance).ToString("N2"))</span>
                                    </td>
                                    <td style="padding: 16px; color: #64748b;">@loan.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td style="padding: 16px; text-align: center;">
                                        <button
                                            style="background: linear-gradient(135deg, #059669, #10b981); color: white; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 13px; box-shadow: 0 2px 8px rgba(5, 150, 105, 0.25); transition: all 0.2s;"
                                            @onclick="() => ShowReleaseModal(loan)">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                stroke-width="2" style="margin-right: 6px; vertical-align: middle;">
                                                <polyline points="20 6 9 17 4 12"></polyline>
                                            </svg>
                                            Release
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Recently Released Loans Card -->
    <div style="background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden;">
        <div style="background: linear-gradient(135deg, #3b82f6, #1d4ed8); color: white; padding: 20px 24px;">
            <h4 style="margin: 0; font-weight: 600; font-size: 18px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    style="margin-right: 8px; vertical-align: middle;">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                Recently Released Loans
            </h4>
            <p style="margin: 6px 0 0 0; opacity: 0.9; font-size: 13px;">History of loans that have been released</p>
        </div>

        <div style="padding: 24px;">
            @if (!releasedLoans.Any())
            {
                <div style="text-align: center; padding: 40px;">
                    <p style="color: #9ca3af; font-size: 14px;">No released loans yet.</p>
                </div>
            }
            else
            {
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: separate; border-spacing: 0;">
                        <thead>
                            <tr style="background: linear-gradient(135deg, #f8fafc, #f1f5f9);">
                                <th
                                    style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">
                                    CONTRACT NO</th>
                                <th
                                    style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">
                                    CUSTOMER</th>
                                <th
                                    style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">
                                    LOAN TYPE</th>
                                <th
                                    style="padding: 14px 16px; text-align: right; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">
                                    AMOUNT</th>
                                <th
                                    style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">
                                    RELEASED DATE</th>
                                <th
                                    style="padding: 14px 16px; text-align: center; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0;">
                                    ACTION</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var loan in releasedLoans)
                            {
                                <tr style="border-bottom: 1px solid #f1f5f9;" class="table-row-hover">
                                    <td style="padding: 14px 16px;">
                                        <span
                                            style="background: linear-gradient(135deg, #dbeafe, #bfdbfe); color: #1e40af; padding: 4px 12px; border-radius: 6px; font-weight: 600; font-size: 12px;">@loan.LoanNumber</span>
                                    </td>
                                    <td style="padding: 14px 16px; font-weight: 500; color: #1e293b;">
                                        @(loan.Account?.Customer?.FullName ?? "N/A")</td>
                                    <td style="padding: 14px 16px; color: #64748b;">@loan.LoanType</td>
                                    <td style="padding: 14px 16px; text-align: right; font-weight: 600; color: #059669;">
                                        ₱@loan.LoanAmount.ToString("N2")</td>
                                    <td style="padding: 14px 16px; color: #64748b;">@loan.CreatedAt.ToString("MMM dd, yyyy")
                                    </td>
                                    <td style="padding: 14px 16px; text-align: center;">
                                        <button
                                            style="background: linear-gradient(135deg, #6366f1, #4f46e5); color: white; border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-weight: 600; font-size: 12px;"
                                            @onclick="() => PrintClearance(loan)">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                stroke-width="2" style="margin-right: 4px; vertical-align: middle;">
                                                <polyline points="6 9 6 2 18 2 18 9"></polyline>
                                                <path
                                                    d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2">
                                                </path>
                                                <rect x="6" y="14" width="12" height="8"></rect>
                                            </svg>
                                            Print
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@if (showModal && selectedLoan != null)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.6); display: flex; align-items: center; justify-content: center; z-index: 1000; backdrop-filter: blur(4px);"
        @onclick="CloseModal">
        <div style="background: white; border-radius: 20px; width: 90%; max-width: 600px; max-height: 90vh; overflow-y: auto; box-shadow: 0 25px 60px rgba(0,0,0,0.3);"
            @onclick:stopPropagation>
            <div
                style="background: linear-gradient(135deg, #059669, #10b981); color: white; padding: 24px 28px; border-radius: 20px 20px 0 0;">
                <h4 style="margin: 0; font-weight: 700; font-size: 20px;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        style="margin-right: 10px; vertical-align: middle;">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    Release Loan
                </h4>
                <p style="margin: 6px 0 0 0; opacity: 0.9; font-size: 14px;">Contract: @selectedLoan.LoanNumber</p>
            </div>

            <div style="padding: 28px;">
                <!-- Admin Reason Section -->
                <div
                    style="background: #fef3c7; border: 2px solid #f59e0b; border-radius: 12px; padding: 16px; margin-bottom: 20px;">
                    <label style="font-size: 14px; font-weight: 600; color: #92400e; display: block; margin-bottom: 8px;">
                        ⚠️ Admin Reason (Required)
                    </label>
                    <textarea @bind="adminReason"
                        style="width: 100%; padding: 12px; border: 1px solid #fcd34d; border-radius: 8px; font-size: 14px; resize: vertical; min-height: 60px; background: #fffbeb;"
                        placeholder="Enter reason for releasing this loan as admin..."></textarea>
                </div>

                <!-- Loan Completion Summary -->
                <div
                    style="background: linear-gradient(135deg, #f0fdf4, #dcfce7); border-radius: 16px; padding: 24px; margin-bottom: 24px; border: 1px solid #bbf7d0;">
                    <h5
                        style="margin: 0 0 16px 0; color: #059669; font-size: 14px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                            style="margin-right: 8px; vertical-align: middle;">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        Loan Completion Summary
                    </h5>
                    <div style="display: grid; gap: 12px;">
                        <div
                            style="display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #bbf7d0;">
                            <span style="color: #6b7280;">Customer Name</span>
                            <span style="font-weight: 600; color: #1e293b;">@(selectedLoan.Account?.Customer?.FullName ??
                                                            "N/A")</span>
                        </div>
                        <div
                            style="display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #bbf7d0;">
                            <span style="color: #6b7280;">Loan Type</span>
                            <span style="font-weight: 600; color: #1e293b;">@selectedLoan.LoanType</span>
                        </div>
                        <div
                            style="display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #bbf7d0;">
                            <span style="color: #6b7280;">Original Amount</span>
                            <span style="font-weight: 600; color: #1e293b;">₱@selectedLoan.LoanAmount.ToString("N2")</span>
                        </div>
                        <div
                            style="display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #bbf7d0;">
                            <span style="color: #6b7280;">Total Amount Paid</span>
                            <span style="font-weight: 700; color: #059669; font-size: 16px;">₱@((selectedLoan.LoanAmount -
                                                            selectedLoan.OutstandingBalance).ToString("N2"))</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; padding: 10px 0;">
                            <span style="color: #6b7280;">Completion Date</span>
                            <span style="font-weight: 600; color: #1e293b;">@selectedLoan.CreatedAt.ToString("MMMM dd, yyyy")</span>
                        </div>
                    </div>
                </div>

                <!-- Collateral Section -->
                <div style="margin-bottom: 20px;">
                    <label
                        style="font-size: 14px; font-weight: 600; color: #374151; display: block; margin-bottom: 8px;">Collateral
                        Return (if applicable)</label>
                    <select @bind="collateralAction"
                        style="width: 100%; padding: 12px 16px; border: 2px solid #e5e7eb; border-radius: 10px; font-size: 14px;">
                        <option value="None">No Collateral</option>
                        <option value="Return">Return Collateral to Customer</option>
                        <option value="Pending">Collateral Pending Verification</option>
                    </select>
                </div>

                <!-- Confirmation Checkbox -->
                <div style="background: #f8fafc; padding: 16px; border-radius: 10px; margin-bottom: 24px;">
                    <label style="display: flex; align-items: center; gap: 12px; cursor: pointer;">
                        <input type="checkbox" @bind="confirmRelease"
                            style="width: 20px; height: 20px; accent-color: #059669;" />
                        <span style="color: #475569; font-size: 14px;">I confirm that all payments have been verified and
                            the loan is fully settled</span>
                    </label>
                </div>

                <!-- Action Buttons -->
                <div
                    style="display: flex; gap: 12px; justify-content: flex-end; padding-top: 20px; border-top: 1px solid #e5e7eb;">
                    <button
                        style="background: #f1f5f9; color: #475569; border: none; padding: 12px 24px; border-radius: 10px; cursor: pointer; font-weight: 600; font-size: 14px;"
                        @onclick="CloseModal">Cancel</button>
                    <button
                        style="background: linear-gradient(135deg, #059669, #10b981); color: white; border: none; padding: 12px 28px; border-radius: 10px; cursor: pointer; font-weight: 700; font-size: 14px; box-shadow: 0 4px 12px rgba(5, 150, 105, 0.3); opacity: @(confirmRelease && !string.IsNullOrWhiteSpace(adminReason) ? "1" : "0.6");"
                        @onclick="ReleaseLoan" disabled="@(!confirmRelease || string.IsNullOrWhiteSpace(adminReason))">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                            style="margin-right: 8px; vertical-align: middle;">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        Release Loan
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .table-row-hover:hover {
        background: #f8fafc !important;
    }

    button:hover:not(:disabled) {
        transform: translateY(-1px);
    }

    button:disabled {
        cursor: not-allowed;
    }
</style>

@code {
    private bool showModal = false;
    private Loan? selectedLoan;
    private string adminReason = "";
    private string collateralAction = "None";
    private bool confirmRelease = false;
    private string successMessage = "";
    private string errorMessage = "";

    private List<Loan> loansForRelease = new();
    private List<Loan> releasedLoans = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.HasRole(AuthService.Roles.SuperAdmin))
        {
            Navigation.NavigateTo("/admin/dashboard");
            return;
        }
        await LoadLoans();
    }

    private async Task LoadLoans()
    {
        isLoading = true;
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();

            loansForRelease = await db.Loans
            .Include(l => l.Account)
            .ThenInclude(a => a.Customer)
            .Where(l => (l.Status == "COMPLETED" || l.Status == "Paid") && l.OutstandingBalance == 0)
            .OrderByDescending(l => l.CreatedAt)
            .ToListAsync();

            releasedLoans = await db.Loans
            .Include(l => l.Account)
            .ThenInclude(a => a.Customer)
            .Where(l => l.Status == "RELEASED")
            .OrderByDescending(l => l.CreatedAt)
            .Take(10)
            .ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading loans: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowReleaseModal(Loan loan)
    {
        selectedLoan = loan;
        showModal = true;
        confirmRelease = false;
        adminReason = "";
    }

    private void CloseModal()
    {
        showModal = false;
        selectedLoan = null;
        adminReason = "";
        confirmRelease = false;
    }

    private async Task ReleaseLoan()
    {
        if (string.IsNullOrWhiteSpace(adminReason) || !confirmRelease || selectedLoan == null) return;

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var loan = await db.Loans.FindAsync(selectedLoan.LoanId);
            if (loan != null)
            {
                loan.Status = "RELEASED";
                await db.SaveChangesAsync();

                successMessage = $"Loan {selectedLoan.LoanNumber} released successfully!";
                CloseModal();
                await LoadLoans();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error releasing loan: {ex.Message}";
        }
    }

    private void PrintClearance(Loan loan)
    {
        successMessage = $"Clearance certificate for {loan.LoanNumber} is ready to print.";
    }
}