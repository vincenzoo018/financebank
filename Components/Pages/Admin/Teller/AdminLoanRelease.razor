@page "/admin/teller/loan-release"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@using Microsoft.EntityFrameworkCore
@inject AuthService AuthService
@inject LoanProcessService LoanService
@inject BFASDbContext DbContext
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="admin-page">
    <div class="page-header">
        <h1 style="color: #10b981;">
            <svg style="width: 32px; height: 32px; margin-right: 12px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Loan Release (Admin)
        </h1>
        <p class="page-subtitle">Mark fully paid loans as released and generate clearance</p>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success")">@message</div>
    }

    <div class="admin-card">
        <div class="card-header">
            <h3>Loans Ready for Release</h3>
        </div>
        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Contract No</th>
                        <th>Customer</th>
                        <th>Loan Type</th>
                        <th>Original Amount</th>
                        <th>Total Paid</th>
                        <th>Date Completed</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var loan in loansForRelease)
                    {
                        <tr>
                            <td><strong>@loan.LoanNumber</strong></td>
                            <td>@(loan.Account?.Customer?.FullName ?? "N/A")</td>
                            <td>@loan.LoanType</td>
                            <td>₱@loan.LoanAmount.ToString("N2")</td>
                            <td style="color: #10b981;">₱@((loan.LoanAmount - loan.OutstandingBalance).ToString("N2"))</td>
                            <td>@loan.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td>
                                <button class="btn btn-sm btn-success" @onclick="() => ShowReleaseModal(loan)">
                                    Release Loan
                                </button>
                            </td>
                        </tr>
                    }
                    @if (!loansForRelease.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted">No loans pending release</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="admin-card" style="margin-top: 24px;">
        <div class="card-header">
            <h3>Recently Released Loans</h3>
        </div>
        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Contract No</th>
                        <th>Customer</th>
                        <th>Loan Type</th>
                        <th>Amount</th>
                        <th>Release Date</th>
                        <th>Released By</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr><td colspan="7" class="text-center" style="padding: 40px;">Loading...</td></tr>
                    }
                    else if (!releasedLoans.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted">No released loans</td></tr>
                    }
                    else
                    {
                        @foreach (var loan in releasedLoans)
                        {
                            <tr>
                                <td>@loan.LoanNumber</td>
                                <td>@(loan.Account?.Customer?.FullName ?? "N/A")</td>
                                <td>@loan.LoanType</td>
                                <td>₱@loan.LoanAmount.ToString("N2")</td>
                                <td>@loan.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td>@(AuthService.FullName ?? "Admin")</td>
                                <td>
                                    <button class="btn btn-sm btn-info" @onclick="() => PrintClearance(loan)">
                                        Print Clearance
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-content" @onclick:stopPropagation style="max-width: 600px;">
            <div class="modal-header">
                <h4>Release Loan - @selectedLoan?.LoanNumber</h4>
                <button class="close-btn" @onclick="CloseModal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Admin Reason <span class="required">*</span></label>
                    <textarea @bind="adminReason" class="form-control" rows="2" 
                        placeholder="Enter reason for releasing this loan..."></textarea>
                </div>
                <hr />
                
                <div class="release-summary" style="background: #f0fdf4; padding: 20px; border-radius: 8px;">
                    <h5 style="color: #10b981; margin-bottom: 16px;">
                        <svg style="width: 20px; height: 20px; margin-right: 8px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        Loan Completion Summary
                    </h5>
                    <table class="table table-bordered" style="margin-bottom: 0;">
                        <tr>
                            <td>Customer Name</td>
                            <td><strong>@(selectedLoan?.Account?.Customer?.FullName ?? "N/A")</strong></td>
                        </tr>
                        <tr>
                            <td>Loan Type</td>
                            <td>@selectedLoan?.LoanType</td>
                        </tr>
                        <tr>
                            <td>Original Loan Amount</td>
                            <td>₱@selectedLoan?.LoanAmount.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td>Total Amount Paid</td>
                            <td style="color: #10b981; font-weight: 600;">₱@((selectedLoan?.LoanAmount - selectedLoan?.OutstandingBalance ?? 0).ToString("N2"))</td>
                        </tr>
                        <tr>
                            <td>Completion Date</td>
                            <td>@selectedLoan?.CreatedAt.ToString("MMMM dd, yyyy")</td>
                        </tr>
                    </table>
                </div>
                
                <div class="form-group" style="margin-top: 16px;">
                    <label>Collateral Return (if applicable)</label>
                    <select @bind="collateralAction" class="form-control">
                        <option value="None">No Collateral</option>
                        <option value="Return">Return Collateral to Customer</option>
                        <option value="Pending">Collateral Pending Verification</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label class="checkbox-item">
                        <input type="checkbox" @bind="confirmRelease" />
                        I confirm that all payments have been verified and the loan is fully settled
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                <button class="btn btn-success" @onclick="ReleaseLoan" disabled="@(!confirmRelease)">
                    <svg style="width: 16px; height: 16px; margin-right: 8px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    Release Loan
                </button>
            </div>
        </div>
    </div>
}

<style>
    .checkbox-item {
        display: flex;
        align-items: center;
        gap: 12px;
        cursor: pointer;
    }
</style>

@code {
    private bool showModal = false;
    private Loan? selectedLoan;
    private string adminReason = "";
    private string collateralAction = "None";
    private bool confirmRelease = false;
    private string message = "";
    private bool isError = false;

    private List<Loan> loansForRelease = new();
    private List<Loan> releasedLoans = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.HasRole(AuthService.Roles.SuperAdmin))
        {
            Navigation.NavigateTo("/admin/dashboard");
            return;
        }
        await LoadLoans();
    }

    private async Task LoadLoans()
    {
        isLoading = true;
        try
        {
            loansForRelease = await DbContext.Loans
                .Include(l => l.Account)
                    .ThenInclude(a => a.Customer)
                .Where(l => (l.Status == "COMPLETED" || l.Status == "Paid") && l.OutstandingBalance == 0)
                .OrderByDescending(l => l.CreatedAt)
                .ToListAsync();

            releasedLoans = await DbContext.Loans
                .Include(l => l.Account)
                    .ThenInclude(a => a.Customer)
                .Where(l => l.Status == "RELEASED")
                .OrderByDescending(l => l.CreatedAt)
                .Take(10)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            message = $"Error loading loans: {ex.Message}";
            isError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowReleaseModal(Loan loan)
    {
        selectedLoan = loan;
        showModal = true;
        confirmRelease = false;
    }

    private void CloseModal()
    {
        showModal = false;
        selectedLoan = null;
        adminReason = "";
        confirmRelease = false;
    }

    private async Task ReleaseLoan()
    {
        if (string.IsNullOrWhiteSpace(adminReason) || !confirmRelease) return;
        
        if (selectedLoan != null)
        {
            try
            {
                selectedLoan.Status = "RELEASED";
                DbContext.Update(selectedLoan);
                await DbContext.SaveChangesAsync();
                
                message = $"Loan {selectedLoan.LoanNumber} released successfully!";
                isError = false;
                CloseModal();
                await LoadLoans();
            }
            catch (Exception ex)
            {
                message = $"Error releasing loan: {ex.Message}";
                isError = true;
            }
        }
    }

    private void PrintClearance(Loan loan)
    {
        // Trigger print of clearance certificate
        message = $"Clearance certificate for {loan.LoanNumber} is ready to print.";
        isError = false;
    }
}

