@page "/admin/approvals/cards"
@layout AdminLayout
@using FinanceBank.Services
@inject CardApplicationService CardApplicationService
@inject AuthService AuthService

<div style="padding: 24px; max-width: 1400px; margin: 0 auto;">
    <!-- Header -->
    <div style="background: linear-gradient(135deg, #059669, #047857); border-radius: 16px; padding: 24px; margin-bottom: 24px; color: white;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 48px; height: 48px; background: rgba(255,255,255,0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M2 8h20M2 8c0-1.1.9-2 2-2h16c1.1 0 2 .9 2 2v8c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V8z"/>
                    <path d="M2 10h20"/>
                </svg>
            </div>
            <div style="flex: 1;">
                <h1 style="font-size: 24px; font-weight: 700; margin: 0;">Card Applications</h1>
                <p style="margin: 4px 0 0; opacity: 0.9; font-size: 14px;">Review and approve credit/debit card applications</p>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">
        <div style="background: white; border-radius: 12px; padding: 16px; border: 2px solid #d1fae5;">
            <div style="font-size: 24px; font-weight: 700; color: #059669;">@pendingCount</div>
            <div style="font-size: 12px; color: #6b7280; margin-top: 4px;">Pending Applications</div>
        </div>
        <div style="background: white; border-radius: 12px; padding: 16px; border: 2px solid #d1fae5;">
            <div style="font-size: 24px; font-weight: 700; color: #059669;">@approvedCount</div>
            <div style="font-size: 12px; color: #6b7280; margin-top: 4px;">Approved Today</div>
        </div>
        <div style="background: white; border-radius: 12px; padding: 16px; border: 2px solid #fee2e2;">
            <div style="font-size: 24px; font-weight: 700; color: #dc2626;">@rejectedCount</div>
            <div style="font-size: 12px; color: #6b7280; margin-top: 4px;">Rejected Today</div>
        </div>
    </div>

    <!-- Tabs -->
    <div style="background: white; border-radius: 12px; padding: 0; margin-bottom: 24px; border: 1px solid #e5e7eb; overflow: hidden;">
        <div style="display: flex; border-bottom: 2px solid #e5e7eb;">
            <button @onclick="@(() => SelectTab("pending"))" 
                    style="flex: 1; padding: 16px; background: @(selectedTab == "pending" ? "#f0fdf4" : "white"); border: none; border-bottom: @(selectedTab == "pending" ? "3px solid #059669" : "none"); color: @(selectedTab == "pending" ? "#059669" : "#6b7280"); font-weight: 600; cursor: pointer; font-size: 14px;">
                Pending (@pendingCount)
            </button>
            <button @onclick="@(() => SelectTab("approved"))" 
                    style="flex: 1; padding: 16px; background: @(selectedTab == "approved" ? "#f0fdf4" : "white"); border: none; border-bottom: @(selectedTab == "approved" ? "3px solid #059669" : "none"); color: @(selectedTab == "approved" ? "#059669" : "#6b7280"); font-weight: 600; cursor: pointer; font-size: 14px;">
                Approved
            </button>
            <button @onclick="@(() => SelectTab("rejected"))" 
                    style="flex: 1; padding: 16px; background: @(selectedTab == "rejected" ? "#f0fdf4" : "white"); border: none; border-bottom: @(selectedTab == "rejected" ? "3px solid #059669" : "none"); color: @(selectedTab == "rejected" ? "#059669" : "#6b7280"); font-weight: 600; cursor: pointer; font-size: 14px;">
                Rejected
            </button>
        </div>

        <!-- Pending Tab -->
        @if (selectedTab == "pending")
        {
            <div style="padding: 24px;">
                @if (pendingApplications.Any())
                {
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="border-bottom: 2px solid #e5e7eb; background: #f9fafb;">
                                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">CUSTOMER</th>
                                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">CARD TYPE</th>
                                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">DELIVERY</th>
                                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">APPLIED</th>
                                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">ACTION</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var app in pendingApplications)
                            {
                                <tr style="border-bottom: 1px solid #e5e7eb; transition: background-color 0.2s;">
                                    <td style="padding: 16px;">
                                        <div style="font-weight: 600; color: #1f2937;">@app.CustomerName</div>
                                        <div style="font-size: 12px; color: #6b7280;">@app.CustomerEmail</div>
                                    </td>
                                    <td style="padding: 16px;">
                                        <span style="padding: 6px 12px; background: @(app.CardType == "Credit" ? "#fef3c7" : "#dbeafe"); color: @(app.CardType == "Credit" ? "#92400e" : "#1e40af"); border-radius: 6px; font-weight: 500; font-size: 12px;">
                                            @app.CardType
                                        </span>
                                    </td>
                                    <td style="padding: 16px; font-size: 14px;">@app.DeliveryMethod</td>
                                    <td style="padding: 16px; font-size: 14px;">@app.RequestedAt.ToString("MMM dd, yyyy")</td>
                                    <td style="padding: 16px;">
                                        <div style="display: flex; gap: 8px;">
                                            <button @onclick="() => ShowApprovalModal(app)" style="background: #059669; color: white; padding: 6px 12px; border: none; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer;">Review</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div style="text-align: center; padding: 48px 24px; color: #6b7280;">
                        <div style="font-size: 48px; margin-bottom: 16px;">✓</div>
                        <p style="font-size: 16px; font-weight: 600;">No pending applications</p>
                        <p style="font-size: 14px;">All card applications have been reviewed</p>
                    </div>
                }
            </div>
        }

        <!-- Approved Tab -->
        @if (selectedTab == "approved")
        {
            <div style="padding: 24px;">
                @if (approvedApplications.Any())
                {
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="border-bottom: 2px solid #e5e7eb; background: #f9fafb;">
                                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">CUSTOMER</th>
                                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">CARD TYPE</th>
                                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">APPROVED BY</th>
                                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">APPROVED DATE</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var app in approvedApplications)
                            {
                                <tr style="border-bottom: 1px solid #e5e7eb;">
                                    <td style="padding: 16px;">
                                        <div style="font-weight: 600; color: #1f2937;">@app.CustomerName</div>
                                        <div style="font-size: 12px; color: #6b7280;">@app.CustomerEmail</div>
                                    </td>
                                    <td style="padding: 16px;">
                                        <span style="padding: 6px 12px; background: #d1fae5; color: #065f46; border-radius: 6px; font-weight: 500; font-size: 12px;">
                                            @app.CardType
                                        </span>
                                    </td>
                                    <td style="padding: 16px; font-size: 14px;">@(app.ProcessedBy ?? "System")</td>
                                    <td style="padding: 16px; font-size: 14px;">@(app.ProcessedAt?.ToString("MMM dd, yyyy") ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div style="text-align: center; padding: 48px 24px; color: #6b7280;">
                        <p style="font-size: 16px; font-weight: 600;">No approved applications</p>
                    </div>
                }
            </div>
        }

        <!-- Rejected Tab -->
        @if (selectedTab == "rejected")
        {
            <div style="padding: 24px;">
                @if (rejectedApplications.Any())
                {
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="border-bottom: 2px solid #e5e7eb; background: #f9fafb;">
                                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">CUSTOMER</th>
                                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">CARD TYPE</th>
                                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">REASON</th>
                                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">REJECTED DATE</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var app in rejectedApplications)
                            {
                                <tr style="border-bottom: 1px solid #e5e7eb;">
                                    <td style="padding: 16px;">
                                        <div style="font-weight: 600; color: #1f2937;">@app.CustomerName</div>
                                        <div style="font-size: 12px; color: #6b7280;">@app.CustomerEmail</div>
                                    </td>
                                    <td style="padding: 16px;">
                                        <span style="padding: 6px 12px; background: #fee2e2; color: #991b1b; border-radius: 6px; font-weight: 500; font-size: 12px;">
                                            @app.CardType
                                        </span>
                                    </td>
                                    <td style="padding: 16px; font-size: 14px;">@ExtractReason(app.Notes)</td>
                                    <td style="padding: 16px; font-size: 14px;">@(app.ProcessedAt?.ToString("MMM dd, yyyy") ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div style="text-align: center; padding: 48px 24px; color: #6b7280;">
                        <p style="font-size: 16px; font-weight: 600;">No rejected applications</p>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Approval Modal -->
@if (showApprovalModal && selectedApplication != null)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.7); display: flex; align-items: center; justify-content: center; z-index: 9999;" @onclick="CloseApprovalModal">
        <div style="background: white; border-radius: 16px; padding: 32px; max-width: 600px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,0.3);" @onclick:stopPropagation>
            <div style="text-align: center; margin-bottom: 24px;">
                <div style="width: 64px; height: 64px; background: linear-gradient(135deg, #059669, #047857); border-radius: 50%; margin: 0 auto 16px; display: flex; align-items: center; justify-content: center;">
                    <svg width="32" height="32" fill="none" stroke="white" stroke-width="2">
                        <path d="M2 8h20M2 8c0-1.1.9-2 2-2h16c1.1 0 2 .9 2 2v8c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V8z"/>
                        <path d="M2 10h20"/>
                    </svg>
                </div>
                <h2 style="font-size: 20px; font-weight: 700; margin: 0;">Review Card Application</h2>
                <p style="font-size: 14px; color: #6b7280; margin-top: 4px;">@selectedApplication.CardType Card Application</p>
            </div>

            <div style="background: #f9fafb; border-radius: 12px; padding: 20px; margin-bottom: 24px;">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div>
                        <div style="font-size: 11px; color: #6b7280; margin-bottom: 4px;">CUSTOMER NAME</div>
                        <div style="font-weight: 600;">@selectedApplication.CustomerName</div>
                    </div>
                    <div>
                        <div style="font-size: 11px; color: #6b7280; margin-bottom: 4px;">EMAIL</div>
                        <div style="font-weight: 600; font-size: 13px;">@selectedApplication.CustomerEmail</div>
                    </div>
                    <div>
                        <div style="font-size: 11px; color: #6b7280; margin-bottom: 4px;">CARD TYPE</div>
                        <div style="font-weight: 600;">@selectedApplication.CardType</div>
                    </div>
                    <div>
                        <div style="font-size: 11px; color: #6b7280; margin-bottom: 4px;">DELIVERY METHOD</div>
                        <div style="font-weight: 600;">@selectedApplication.DeliveryMethod</div>
                    </div>
                    <div>
                        <div style="font-size: 11px; color: #6b7280; margin-bottom: 4px;">APPLIED DATE</div>
                        <div style="font-weight: 600;">@selectedApplication.RequestedAt.ToString("MMM dd, yyyy")</div>
                    </div>
                    <div>
                        <div style="font-size: 11px; color: #6b7280; margin-bottom: 4px;">PRIORITY</div>
                        <div style="font-weight: 600;">@selectedApplication.Priority</div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(selectedApplication.Notes))
            {
                <div style="background: #f0fdf4; border-left: 4px solid #059669; padding: 12px; margin-bottom: 24px; border-radius: 4px;">
                    <div style="font-size: 11px; color: #6b7280; margin-bottom: 4px;">APPLICANT NOTES</div>
                    <div style="font-size: 14px; color: #1f2937;">@selectedApplication.Notes</div>
                </div>
            }

            <div style="margin-bottom: 24px;">
                <label style="display: block; font-size: 12px; font-weight: 600; margin-bottom: 8px;">Admin Notes (Optional)</label>
                <textarea @bind="adminNotes" style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px; resize: vertical;" rows="3" placeholder="Add notes for this decision..."></textarea>
            </div>

            <div style="display: flex; gap: 12px;">
                <button @onclick="CloseApprovalModal" style="flex: 1; padding: 12px; background: #f3f4f6; border: none; border-radius: 8px; color: #374151; font-size: 14px; font-weight: 600; cursor: pointer;">Cancel</button>
                <button @onclick="() => RejectApplication()" style="flex: 1; padding: 12px; background: #fee2e2; border: none; border-radius: 8px; color: #991b1b; font-size: 14px; font-weight: 600; cursor: pointer;">Reject</button>
                <button @onclick="() => ApproveApplication()" style="flex: 1; padding: 12px; background: linear-gradient(135deg, #059669, #047857); border: none; border-radius: 8px; color: white; font-size: 14px; font-weight: 600; cursor: pointer;">Approve</button>
            </div>
        </div>
    </div>
}

<!-- Rejection Modal -->
@if (showRejectionModal)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.7); display: flex; align-items: center; justify-content: center; z-index: 10000;" @onclick="CloseRejectionModal">
        <div style="background: white; border-radius: 16px; padding: 32px; max-width: 500px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,0.3);" @onclick:stopPropagation>
            <h2 style="font-size: 20px; font-weight: 700; margin: 0 0 16px;">Reject Application</h2>
            <p style="color: #6b7280; margin-bottom: 24px;">Please provide a reason for rejecting this application</p>

            <div style="margin-bottom: 24px;">
                <label style="display: block; font-size: 12px; font-weight: 600; margin-bottom: 8px;">Rejection Reason</label>
                <textarea @bind="rejectionReason" style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px; resize: vertical;" rows="4" placeholder="Explain why this application is being rejected..."></textarea>
            </div>

            <div style="display: flex; gap: 12px;">
                <button @onclick="CloseRejectionModal" style="flex: 1; padding: 12px; background: #f3f4f6; border: none; border-radius: 8px; color: #374151; font-size: 14px; font-weight: 600; cursor: pointer;">Cancel</button>
                <button @onclick="ConfirmRejection" disabled="@string.IsNullOrEmpty(rejectionReason)" style="flex: 1; padding: 12px; background: @(string.IsNullOrEmpty(rejectionReason) ? "#d1d5db" : "#dc2626"); border: none; border-radius: 8px; color: white; font-size: 14px; font-weight: 600; cursor: @(string.IsNullOrEmpty(rejectionReason) ? "not-allowed" : "pointer");">Confirm Rejection</button>
            </div>
        </div>
    </div>
}

@code {
    private List<CardApplicationDto> pendingApplications = new();
    private List<CardApplicationDto> approvedApplications = new();
    private List<CardApplicationDto> rejectedApplications = new();
    
    private CardApplicationDto? selectedApplication;
    private bool showApprovalModal = false;
    private bool showRejectionModal = false;
    private string adminNotes = "";
    private string rejectionReason = "";
    private string selectedTab = "pending";

    private int pendingCount => pendingApplications.Count;
    private int approvedCount => approvedApplications.Count;
    private int rejectedCount => rejectedApplications.Count;

    protected override async Task OnInitializedAsync()
    {
        await LoadApplications();
    }

    private async Task LoadApplications()
    {
        try
        {
            // Fetch card applications for the authenticated user
            pendingApplications = await CardApplicationService.GetAllCardApplicationsAsync("Pending");
            approvedApplications = await CardApplicationService.GetAllCardApplicationsAsync("Approved");
            rejectedApplications = await CardApplicationService.GetAllCardApplicationsAsync("Rejected");
        }
        catch
        {
        }
    }

    private void SelectTab(string tab)
    {
        selectedTab = tab;
    }

    private void ShowApprovalModal(CardApplicationDto application)
    {
        selectedApplication = application;
        adminNotes = "";
        showApprovalModal = true;
    }

    private void CloseApprovalModal()
    {
        showApprovalModal = false;
        selectedApplication = null;
        adminNotes = "";
    }

    private async Task ApproveApplication()
    {
        if (selectedApplication == null)
            return;

        var result = await CardApplicationService.ApproveCardApplicationAsync(
            selectedApplication.ApprovalId,
            adminNotes);

        if (result.success)
        {
            await LoadApplications();
            CloseApprovalModal();
        }
    }

    private void RejectApplication()
    {
        showRejectionModal = true;
    }

    private async Task ConfirmRejection()
    {
        if (selectedApplication == null || string.IsNullOrEmpty(rejectionReason))
            return;

        var result = await CardApplicationService.RejectCardApplicationAsync(
            selectedApplication.ApprovalId,
            rejectionReason);

        if (result.success)
        {
            await LoadApplications();
            CloseRejectionModal();
            CloseApprovalModal();
        }
    }

    private void CloseRejectionModal()
    {
        showRejectionModal = false;
        rejectionReason = "";
    }

    private string ExtractReason(string notes)
    {
        if (notes.StartsWith("Rejection Reason:"))
            return notes.Replace("Rejection Reason:", "").Trim();
        return notes;
    }
}
