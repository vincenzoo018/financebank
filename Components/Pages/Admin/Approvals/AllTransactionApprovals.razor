@page "/admin/approvals/all-transactions"
@using FinanceBank.Data
@using FinanceBank.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>All Transaction Approvals - FINSYS</PageTitle>

<div class="page-container">
    <div class="page-header">
        <div class="header-content">
            <h1>All Transaction Approvals</h1>
            <p class="header-subtitle">Comprehensive view of all pending transaction approvals</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="text-primary">@pendingCount</h3>
                    <p class="text-muted">Pending</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="text-success">@approvedCount</h3>
                    <p class="text-muted">Approved</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="text-danger">@rejectedCount</h3>
                    <p class="text-muted">Rejected</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="text-info">@totalCount</h3>
                    <p class="text-muted">Total</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <h3>All Transactions</h3>
                <select class="form-select" style="max-width: 200px;" @onchange="FilterByType">
                    <option value="">All Types</option>
                    <option value="Deposit">Deposits</option>
                    <option value="Withdrawal">Withdrawals</option>
                    <option value="Transfer">Transfers</option>
                    <option value="Bill">Bill Payments</option>
                </select>
            </div>
        </div>
        <div class="card-body">
            @if (transactions == null)
            {
                <div class="text-center py-4">
                    <p>Loading transactions...</p>
                </div>
            }
            else if (filteredTransactions.Count == 0)
            {
                <div class="text-center py-4">
                    <p class="text-muted">No transactions found</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Transaction ID</th>
                                <th>Type</th>
                                <th>From Account</th>
                                <th>To Account</th>
                                <th>Amount</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var transaction in filteredTransactions)
                            {
                                <tr>
                                    <td><strong>@transaction.TransactionId</strong></td>
                                    <td>
                                        <span class="badge @GetTypeBadgeClass(transaction.Type)">
                                            @transaction.Type
                                        </span>
                                    </td>
                                    <td>@transaction.FromAccount</td>
                                    <td>@transaction.ToAccount</td>
                                    <td class="text-end">@transaction.Amount.ToString("C")</td>
                                    <td>@transaction.Date.ToShortDateString()</td>
                                    <td>
                                        <span class="badge @(transaction.Status == "Pending" ? "bg-warning" : transaction.Status == "Approved" ? "bg-success" : "bg-danger")">
                                            @transaction.Status
                                        </span>
                                    </td>
                                    <td>
                                        @if (transaction.Status == "Pending")
                                        {
                                            <button class="btn btn-sm btn-success" @onclick="() => ApproveTransaction(transaction)">Approve</button>
                                            <button class="btn btn-sm btn-danger" @onclick="() => RejectTransaction(transaction)">Reject</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<TransactionModel> transactions = new();
    private List<TransactionModel> filteredTransactions = new();
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;
    private string selectedType = string.Empty;
    private int pendingCount = 0;
    private int approvedCount = 0;
    private int rejectedCount = 0;
    private int totalCount = 0;

    private class TransactionModel
    {
        public string TransactionId { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
        public string FromAccount { get; set; } = string.Empty;
        public string ToAccount { get; set; } = string.Empty;
        public decimal Amount { get; set; }
        public DateTime Date { get; set; }
        public string Status { get; set; } = "Pending";
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Check authorization
            if (!AuthService.HasRole(AuthService.Roles.SuperAdmin) && !AuthService.HasRole(AuthService.Roles.Accountant))
            {
                Navigation.NavigateTo("/admin/dashboard");
                return;
            }

            // Load mock transaction data
            transactions = new()
            {
                new() { TransactionId = "TRX001", Type = "Deposit", FromAccount = "N/A", ToAccount = "ACC001", Amount = 1000.00m, Date = DateTime.Now.AddDays(-1), Status = "Pending" },
                new() { TransactionId = "TRX002", Type = "Withdrawal", FromAccount = "ACC002", ToAccount = "N/A", Amount = 500.00m, Date = DateTime.Now.AddDays(-1), Status = "Pending" },
                new() { TransactionId = "TRX003", Type = "Transfer", FromAccount = "ACC001", ToAccount = "ACC003", Amount = 750.00m, Date = DateTime.Now.AddDays(-2), Status = "Approved" },
                new() { TransactionId = "TRX004", Type = "Bill", FromAccount = "ACC004", ToAccount = "BILL-001", Amount = 120.00m, Date = DateTime.Now.AddDays(-2), Status = "Pending" },
                new() { TransactionId = "TRX005", Type = "Deposit", FromAccount = "N/A", ToAccount = "ACC005", Amount = 2000.00m, Date = DateTime.Now.AddDays(-3), Status = "Rejected" }
            };

            filteredTransactions = transactions.ToList();
            CalculateStatistics();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading transactions: {ex.Message}";
        }
    }

    private void FilterByType(ChangeEventArgs e)
    {
        selectedType = e.Value?.ToString() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(selectedType))
        {
            filteredTransactions = transactions.ToList();
        }
        else
        {
            filteredTransactions = transactions
                .Where(t => t.Type.Equals(selectedType, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private void CalculateStatistics()
    {
        pendingCount = transactions.Count(t => t.Status == "Pending");
        approvedCount = transactions.Count(t => t.Status == "Approved");
        rejectedCount = transactions.Count(t => t.Status == "Rejected");
        totalCount = transactions.Count;
    }

    private async Task ApproveTransaction(TransactionModel transaction)
    {
        transaction.Status = "Approved";
        successMessage = $"Transaction {transaction.TransactionId} approved successfully";
        CalculateStatistics();
    }

    private async Task RejectTransaction(TransactionModel transaction)
    {
        transaction.Status = "Rejected";
        successMessage = $"Transaction {transaction.TransactionId} rejected";
        CalculateStatistics();
    }

    private string GetTypeBadgeClass(string type)
    {
        return type switch
        {
            "Deposit" => "bg-success",
            "Withdrawal" => "bg-warning",
            "Transfer" => "bg-info",
            "Bill" => "bg-secondary",
            _ => "bg-light"
        };
    }
}
