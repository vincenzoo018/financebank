@page "/admin/approvals/bill-approvals"
@layout AdminLayout
@using FinanceBank.Data
@using FinanceBank.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Bill Payment Approvals - FINSYS</PageTitle>

<div class="page-container">
    <div class="page-header">
        <div class="header-content">
            <h1>Bill Payment Approvals</h1>
            <p class="header-subtitle">Review and approve pending bill payments</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="text-primary">@pendingCount</h3>
                    <p class="text-muted">Pending Approval</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="text-success">@approvedCount</h3>
                    <p class="text-muted">Approved</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="text-danger">@rejectedCount</h3>
                    <p class="text-muted">Rejected</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="text-warning">@totalAmount.ToString("C")</h3>
                    <p class="text-muted">Total Amount</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3>Pending Bill Payments</h3>
        </div>
        <div class="card-body">
            @if (billPayments == null)
            {
                <div class="text-center py-4">
                    <p>Loading approvals...</p>
                </div>
            }
            else if (billPayments.Count == 0)
            {
                <div class="text-center py-4">
                    <p class="text-muted">No pending bill payments</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Bill ID</th>
                                <th>Biller</th>
                                <th>Customer</th>
                                <th>Amount</th>
                                <th>Due Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bill in billPayments)
                            {
                                <tr>
                                    <td><strong>@bill.BillId</strong></td>
                                    <td>@bill.BillerName</td>
                                    <td>@bill.CustomerName</td>
                                    <td class="text-end">@bill.Amount.ToString("C")</td>
                                    <td>@bill.DueDate.ToShortDateString()</td>
                                    <td>
                                        <span class="badge @(bill.Status == "Pending" ? "bg-warning" : bill.Status == "Approved" ? "bg-success" : "bg-danger")">
                                            @bill.Status
                                        </span>
                                    </td>
                                    <td>
                                        @if (bill.Status == "Pending")
                                        {
                                            <button class="btn btn-sm btn-success" @onclick="() => ApproveBill(bill)">Approve</button>
                                            <button class="btn btn-sm btn-danger" @onclick="() => RejectBill(bill)">Reject</button>
                                        }
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewDetails(bill)">Details</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<BillPaymentModel> billPayments = new();
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;
    private int pendingCount = 0;
    private int approvedCount = 0;
    private int rejectedCount = 0;
    private decimal totalAmount = 0;

    private class BillPaymentModel
    {
        public string BillId { get; set; } = string.Empty;
        public string BillerName { get; set; } = string.Empty;
        public string CustomerName { get; set; } = string.Empty;
        public decimal Amount { get; set; }
        public DateTime DueDate { get; set; }
        public string Status { get; set; } = "Pending";
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Check authorization
            if (!AuthService.HasRole(AuthService.Roles.SuperAdmin) && !AuthService.HasRole(AuthService.Roles.Accountant))
            {
                Navigation.NavigateTo("/admin/dashboard");
                return;
            }

            // Load mock bill payment data
            billPayments = new()
            {
                new() { BillId = "BILL001", BillerName = "Power Company", CustomerName = "John Doe", Amount = 250.00m, DueDate = DateTime.Now.AddDays(5), Status = "Pending" },
                new() { BillId = "BILL002", BillerName = "Water Department", CustomerName = "Jane Smith", Amount = 85.50m, DueDate = DateTime.Now.AddDays(3), Status = "Pending" },
                new() { BillId = "BILL003", BillerName = "Internet Provider", CustomerName = "Robert Johnson", Amount = 60.00m, DueDate = DateTime.Now.AddDays(7), Status = "Approved" },
                new() { BillId = "BILL004", BillerName = "Gas Company", CustomerName = "Maria Garcia", Amount = 120.00m, DueDate = DateTime.Now.AddDays(2), Status = "Pending" },
                new() { BillId = "BILL005", BillerName = "Phone Company", CustomerName = "Michael Brown", Amount = 45.00m, DueDate = DateTime.Now.AddDays(10), Status = "Rejected" }
            };

            CalculateStatistics();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading bill approvals: {ex.Message}";
        }
    }

    private void CalculateStatistics()
    {
        pendingCount = billPayments.Count(b => b.Status == "Pending");
        approvedCount = billPayments.Count(b => b.Status == "Approved");
        rejectedCount = billPayments.Count(b => b.Status == "Rejected");
        totalAmount = billPayments.Sum(b => b.Amount);
    }

    private async Task ApproveBill(BillPaymentModel bill)
    {
        bill.Status = "Approved";
        successMessage = $"Bill {bill.BillId} approved successfully";
        CalculateStatistics();
    }

    private async Task RejectBill(BillPaymentModel bill)
    {
        bill.Status = "Rejected";
        successMessage = $"Bill {bill.BillId} rejected";
        CalculateStatistics();
    }

    private void ViewDetails(BillPaymentModel bill)
    {
        successMessage = $"Viewing details for bill {bill.BillId}";
    }
}
