@page "/admin/banking/accounts"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@inject BankAccountService Service

<div class="section-header">
    <h2 class="section-title">Bank Accounts</h2>
    <p style="color: var(--text-secondary); font-size: 14px; margin-top: 8px;">Manage bank accounts</p>
    <div style="margin-top:12px; display:flex; gap:12px;">
        <button class="btn" style="background:#059669; color:white; padding:10px 18px; font-weight:600; border-radius:8px; font-size:14px;" @onclick="ShowCreate">+ New Account</button>
        <input class="form-control" placeholder="Search..." @bind="search" style="max-width:240px;" />
    </div>
    @if (showCreate)
    {
        <div style="margin-top:12px; background:white; border:1px solid var(--border); border-radius:12px; padding:16px; display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:12px;">
            <input class="form-control" placeholder="Account Number" @bind="draft.AccountNumber" />
            <input class="form-control" placeholder="Account Name" @bind="draft.AccountName" />
            <input class="form-control" placeholder="Account Type" @bind="draft.AccountType" />
            <input class="form-control" placeholder="Bank Name" @bind="draft.BankName" />
            <input class="form-control" placeholder="Currency" @bind="draft.Currency" />
            <input class="form-control" type="number" placeholder="Balance" @bind-value="draftBalance" />
            <div style="display:flex; gap:8px; align-items:center;">
                <button class="btn" style="background:#059669; color:white; padding:10px 18px; font-weight:600; border-radius:8px;" @onclick="Create">Save</button>
                <button class="btn" style="background:#e5e7eb; color:#111827; padding:10px 18px; font-weight:600; border-radius:8px;" @onclick="HideCreate">Cancel</button>
            </div>
        </div>
    }
</div>

<div style="background:white; border-radius:12px; border:1px solid var(--border);">
    <table style="width:100%; border-collapse:collapse;">
        <thead>
            <tr style="border-bottom:1px solid var(--border); background:#f9fafb;">
                <th style="padding:12px; text-align:left;">Account Number</th>
                <th style="padding:12px; text-align:left;">Account Name</th>
                <th style="padding:12px; text-align:left;">Type</th>
                <th style="padding:12px; text-align:left;">Bank</th>
                <th style="padding:12px; text-align:right;">Balance</th>
                <th style="padding:12px; text-align:center;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in filtered)
            {
                <tr style="border-bottom:1px solid var(--border);">
                    <td style="padding:12px;">@a.AccountNumber</td>
                    <td style="padding:12px;">@a.AccountName</td>
                    <td style="padding:12px;">@a.AccountType</td>
                    <td style="padding:12px;">@a.BankName</td>
                    <td style="padding:12px; text-align:right;">@a.Balance.ToString("N2")</td>
                    <td style="padding:12px; text-align:center;">
                        <button class="btn" style="background:#059669; color:white; padding:6px 12px; border-radius:6px; font-weight:600; font-size:12px;" @onclick="() => Edit(a)">Edit</button>
                        <button class="btn" style="background:#dc2626; color:white; padding:6px 12px; border-radius:6px; font-weight:600; font-size:12px;" @onclick="() => Delete(a.BankAccountId)">Delete</button>
                    </td>
                </tr>
                @if (editId == a.BankAccountId)
                {
                    <tr>
                        <td colspan="6" style="padding:12px; background:#f9fafb;">
                            <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:12px;">
                                <input class="form-control" @bind="edit.AccountNumber" />
                                <input class="form-control" @bind="edit.AccountName" />
                                <input class="form-control" @bind="edit.AccountType" />
                                <input class="form-control" @bind="edit.BankName" />
                                <input class="form-control" @bind="edit.Currency" />
                                <input class="form-control" type="number" @bind-value="editBalance" />
                                <div style="display:flex; gap:8px; align-items:center;">
                                    <button class="btn" style="background:#059669; color:white; padding:10px 18px; font-weight:600; border-radius:8px;" @onclick="SaveEdit">Save</button>
                                    <button class="btn" style="background:#e5e7eb; color:#111827; padding:10px 18px; font-weight:600; border-radius:8px;" @onclick="CancelEdit">Cancel</button>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    private List<BankAccount> items = new();
    private string search = string.Empty;
    private bool showCreate = false;
    private BankAccount draft = new();
    private decimal draftBalance;
    private int editId = 0;
    private BankAccount edit = new();
    private decimal editBalance;

    protected override async Task OnInitializedAsync()
    {
        items = await Service.GetAllAsync();
    }

    private IEnumerable<BankAccount> filtered => items.Where(x => string.IsNullOrWhiteSpace(search) || (x.AccountNumber?.Contains(search, StringComparison.OrdinalIgnoreCase) == true || x.AccountName?.Contains(search, StringComparison.OrdinalIgnoreCase) == true));

    private void ShowCreate()
    {
        draft = new BankAccount { Currency = "PHP" }; draftBalance = 0; showCreate = true;
    }

    private void HideCreate()
    {
        showCreate = false;
    }

    private async Task Create()
    {
        draft.Balance = draftBalance;
        var created = await Service.CreateAsync(draft);
        items.Add(created);
        showCreate = false;
    }

    private void Edit(BankAccount a)
    {
        edit = new BankAccount
        {
            BankAccountId = a.BankAccountId,
            AccountNumber = a.AccountNumber,
            AccountName = a.AccountName,
            AccountType = a.AccountType,
            BankName = a.BankName,
            Currency = a.Currency,
            Balance = a.Balance
        };
        editBalance = a.Balance;
        editId = a.BankAccountId;
    }

    private async Task SaveEdit()
    {
        edit.Balance = editBalance;
        var updated = await Service.UpdateAsync(edit);
        var idx = items.FindIndex(x => x.BankAccountId == updated.BankAccountId);
        if (idx >= 0) items[idx] = updated;
        editId = 0;
    }

    private void CancelEdit()
    {
        editId = 0;
    }

    private async Task Delete(int id)
    {
        var ok = await Service.DeleteAsync(id);
        if (ok)
        {
            var idx = items.FindIndex(x => x.BankAccountId == id);
            if (idx >= 0) items.RemoveAt(idx);
        }
    }
}

