@page "/admin/banking/loans"
@layout AdminLayout

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
            <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
        </div>
        <div>
            <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Loan Management</h1>
            <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Manage loan applications and portfolios</p>
        </div>
    </div>
</div>

@code {
    private bool showLoanDetailsModal = false;
    private bool showApprovalModal = false;
    private int selectedLoanId = 0;

    private void ShowLoanDetailsModal(int id) { selectedLoanId = id; showLoanDetailsModal = true; }
    private void CloseLoanDetailsModal() => showLoanDetailsModal = false;
    private void ShowApprovalModal(int id) { selectedLoanId = id; showApprovalModal = true; }
    private void CloseApprovalModal() => showApprovalModal = false;
}

