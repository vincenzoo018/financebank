@page "/admin/banking/loans"
@page "/admin/banking/loan-management"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@inject LoanManagementService LoanManagementService
@inject AuthService AuthService

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
            <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
        </div>
        <div>
            <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Loan Management</h1>
            <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Manage loan approvals and portfolios</p>
        </div>
    </div>
</div>

<!-- Status Filters and Summary -->
<div style="display:flex; flex-wrap:wrap; gap:12px; margin-bottom:16px; align-items:flex-end;">
    <div style="flex:1 1 220px;">
        <label style="display:block; font-size:12px; font-weight:600; color:#4b5563; margin-bottom:4px;">Filter by Approval Status</label>
        <select class="form-control" @bind="selectedStatus">
            <option value="all">All</option>
            <option value="Pending">Pending</option>
            <option value="Approved">Approved</option>
            <option value="Rejected">Rejected</option>
        </select>
    </div>
    <div style="flex:0 0 auto; display:flex; gap:8px;">
        <div style="background:white; border-radius:12px; border:1px solid #e5e7eb; padding:10px 14px; font-size:12px; color:#4b5563;">
            Pending: <span style="font-weight:600; color:#f59e0b;">@pendingCount</span>
        </div>
        <div style="background:white; border-radius:12px; border:1px solid #e5e7eb; padding:10px 14px; font-size:12px; color:#4b5563;">
            Approved: <span style="font-weight:600; color:#059669;">@approvedCount</span>
        </div>
        <div style="background:white; border-radius:12px; border:1px solid #e5e7eb; padding:10px 14px; font-size:12px; color:#4b5563;">
            Rejected: <span style="font-weight:600; color:#b91c1c;">@rejectedCount</span>
        </div>
    </div>
</div>

<!-- Loans Table -->
<div style="background:white; border-radius:16px; border:1px solid #e5e7eb; overflow:hidden;">
    <table style="width:100%; border-collapse:collapse;">
        <thead>
            <tr style="background:#f9fafb; border-bottom:1px solid #e5e7eb;">
                <th style="padding:12px; text-align:left; font-size:12px; color:#6b7280;">LOAN ID</th>
                <th style="padding:12px; text-align:left; font-size:12px; color:#6b7280;">CUSTOMER LOAN ID</th>
                <th style="padding:12px; text-align:left; font-size:12px; color:#6b7280;">STATUS</th>
                <th style="padding:12px; text-align:left; font-size:12px; color:#6b7280;">APPROVAL STATUS</th>
                <th style="padding:12px; text-align:left; font-size:12px; color:#6b7280;">APPROVED BY</th>
                <th style="padding:12px; text-align:left; font-size:12px; color:#6b7280;">APPROVED AT</th>
                <th style="padding:12px; text-align:center; font-size:12px; color:#6b7280;">ACTIONS</th>
            </tr>
        </thead>
        <tbody>
            @if (filteredLoans.Any())
            {
                @foreach (var loan in filteredLoans)
                {
                    <tr style="border-bottom:1px solid #e5e7eb;">
                        <td style="padding:12px; font-size:13px; color:#111827;">@loan.LoanMgmtId</td>
                        <td style="padding:12px; font-size:13px; color:#4b5563;">@loan.CustomerLoanId</td>
                        <td style="padding:12px; font-size:13px; color:#4b5563;">@loan.Status</td>
                        <td style="padding:12px;">
                            <span style="display:inline-flex; align-items:center; padding:4px 10px; border-radius:999px; font-size:12px; font-weight:600; background:@GetApprovalBadgeBg(loan.ApprovalStatus); color:@GetApprovalBadgeColor(loan.ApprovalStatus);">
                                @loan.ApprovalStatus
                            </span>
                        </td>
                        <td style="padding:12px; font-size:13px; color:#6b7280;">@loan.ApprovedBy</td>
                        <td style="padding:12px; font-size:13px; color:#6b7280;">@(loan.ApprovedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                        <td style="padding:12px; text-align:center;">
                            <button class="btn" style="background:#1f2937; color:white; padding:6px 12px; font-size:12px; border-radius:6px;" @onclick="() => OpenReviewModal(loan)">Review</button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" style="padding:24px; text-align:center; font-size:14px; color:#6b7280;">No loan management records found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (showReviewModal && selectedLoan != null)
{
    <div @onclick="CloseReviewModal" style="position:fixed; inset:0; background:rgba(0,0,0,0.5); display:flex; align-items:center; justify-content:center; z-index:1000; padding:20px;">
        <div @onclick:stopPropagation style="background:white; border-radius:16px; max-width:640px; width:100%; box-shadow:0 20px 60px rgba(0,0,0,0.3);">
            <div style="padding:20px 24px; border-bottom:1px solid #e5e7eb; display:flex; justify-content:space-between; align-items:center;">
                <div>
                    <h2 style="font-size:20px; font-weight:700; color:#111827; margin:0;">Review Loan @selectedLoan.CustomerLoanId</h2>
                    <p style="font-size:13px; color:#6b7280; margin:4px 0 0 0;">Status: @selectedLoan.Status · Approval: @selectedLoan.ApprovalStatus</p>
                </div>
                <button @onclick="CloseReviewModal" style="background:none; border:none; font-size:22px; color:#6b7280; cursor:pointer;">×</button>
            </div>

            <div style="padding:20px 24px; display:flex; flex-direction:column; gap:12px;">
                <div>
                    <label style="display:block; font-size:12px; font-weight:600; color:#374151; margin-bottom:4px;">Processing Notes</label>
                    <textarea class="form-control" rows="3" @bind="processingNotes"></textarea>
                </div>
                <div>
                    <label style="display:block; font-size:12px; font-weight:600; color:#374151; margin-bottom:4px;">Rejection Reason (required when rejecting)</label>
                    <textarea class="form-control" rows="2" @bind="rejectionReason"></textarea>
                </div>
            </div>

            <div style="padding:16px 24px; border-top:1px solid #e5e7eb; display:flex; justify-content:flex-end; gap:8px;">
                <button class="btn" style="background:#f3f4f6; color:#111827; padding:8px 16px; border-radius:8px; font-size:14px;" @onclick="CloseReviewModal">Cancel</button>
                <button class="btn" style="background:#b91c1c; color:white; padding:8px 16px; border-radius:8px; font-size:14px;" @onclick="Reject">Reject</button>
                <button class="btn" style="background:#059669; color:white; padding:8px 16px; border-radius:8px; font-size:14px;" @onclick="Approve">Approve</button>
            </div>
        </div>
    </div>
}

@code {
    private List<LoanManagementEntity> loans = new();
    private string selectedStatus = "all";

    private bool showReviewModal;
    private LoanManagementEntity? selectedLoan;
    private string processingNotes = string.Empty;
    private string rejectionReason = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        loans = await LoanManagementService.GetAllAsync();
    }

    private IEnumerable<LoanManagementEntity> filteredLoans => loans
        .Where(l => selectedStatus == "all" || l.ApprovalStatus == selectedStatus);

    private int pendingCount => loans.Count(l => l.ApprovalStatus == "Pending");
    private int approvedCount => loans.Count(l => l.ApprovalStatus == "Approved");
    private int rejectedCount => loans.Count(l => l.ApprovalStatus == "Rejected");

    private string GetApprovalBadgeBg(string status)
    {
        return status switch
        {
            "Approved" => "#d1fae5",
            "Rejected" => "#fee2e2",
            _ => "#fef3c7"
        };
    }

    private string GetApprovalBadgeColor(string status)
    {
        return status switch
        {
            "Approved" => "#065f46",
            "Rejected" => "#b91c1c",
            _ => "#92400e"
        };
    }

    private void OpenReviewModal(LoanManagementEntity loan)
    {
        selectedLoan = loan;
        processingNotes = loan.ProcessingNotes ?? string.Empty;
        rejectionReason = loan.RejectionReason ?? string.Empty;
        showReviewModal = true;
    }

    private void CloseReviewModal()
    {
        showReviewModal = false;
        selectedLoan = null;
        processingNotes = string.Empty;
        rejectionReason = string.Empty;
    }

    private async Task Approve()
    {
        if (selectedLoan == null)
            return;

        var user = AuthService.FullName ?? AuthService.CurrentUser ?? "system";
        var updated = await LoanManagementService.ApproveAsync(selectedLoan.LoanMgmtId, user, processingNotes);
        if (updated != null)
        {
            var index = loans.FindIndex(l => l.LoanMgmtId == updated.LoanMgmtId);
            if (index >= 0)
            {
                loans[index] = updated;
            }
        }

        CloseReviewModal();
    }

    private async Task Reject()
    {
        if (selectedLoan == null)
            return;

        if (string.IsNullOrWhiteSpace(rejectionReason))
            return;

        var user = AuthService.FullName ?? AuthService.CurrentUser ?? "system";
        var updated = await LoanManagementService.RejectAsync(selectedLoan.LoanMgmtId, user, rejectionReason, processingNotes);
        if (updated != null)
        {
            var index = loans.FindIndex(l => l.LoanMgmtId == updated.LoanMgmtId);
            if (index >= 0)
            {
                loans[index] = updated;
            }
        }

        CloseReviewModal();
    }
}

