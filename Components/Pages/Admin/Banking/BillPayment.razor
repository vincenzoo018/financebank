@page "/admin/banking/bill-payment"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #059669 0%, #047857 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
            <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path d="M3 3h18a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/>
                <path d="M3 9h18"/>
                <path d="M8 13h4M8 17h4"/>
            </svg>
        </div>
        <div>
            <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Bill Payments</h1>
            <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Manage customer bill payments and billers</p>
        </div>
    </div>
</div>

<!-- Filter & Search -->
<div style="display: flex; gap: 12px; margin-bottom: 24px; align-items: center;">
    <input type="text" placeholder="Search by biller name..." @bind="searchTerm" style="flex: 1; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;" />
    <button class="btn" style="background: #059669; color: white; padding: 10px 18px; font-weight: 600; border-radius: 8px; font-size: 14px; cursor: pointer;" @onclick="LoadBillPayments">Search</button>
    <button class="btn" style="background: #047857; color: white; padding: 10px 18px; font-weight: 600; border-radius: 8px; font-size: 14px; cursor: pointer;" @onclick="ShowCreateModal">+ New Bill Payment</button>
</div>

<!-- Create Modal -->
@if (showCreateModal)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000;" @onclick="HideCreateModal">
        <div style="background: white; border-radius: 16px; padding: 32px; width: 90%; max-width: 700px; box-shadow: 0 20px 25px rgba(0,0,0,0.1);" @onclick:stopPropagation="true">
            <h2 style="font-size: 20px; font-weight: 700; color: #111827; margin: 0 0 24px 0;">Create Bill Payment</h2>
            
            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-bottom: 16px;">
                <div>
                    <label style="display: block; font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 6px;">Biller</label>
                    <select @bind="newBillPayment.BillerName" style="width: 100%; padding: 10px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;">
                        <option value="">Select Biller</option>
                        <option value="MERALCO">MERALCO - Electricity</option>
                        <option value="MAYNILAD">Maynilad Water</option>
                        <option value="PLDT">PLDT - Telecom</option>
                        <option value="CONDO">Condo Association</option>
                    </select>
                </div>
                <div>
                    <label style="display: block; font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 6px;">Amount</label>
                    <input type="number" placeholder="0.00" @bind-value="billAmount" style="width: 100%; padding: 10px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;" />
                </div>
            </div>

            <div style="margin-bottom: 24px;">
                <label style="display: block; font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 6px;">Account Number</label>
                <input type="text" placeholder="Enter biller account number" @bind="newBillPayment.BillerAccountNumber" style="width: 100%; padding: 10px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;" />
            </div>

            <div style="display: flex; gap: 12px; justify-content: flex-end;">
                <button class="btn" style="background: #e5e7eb; color: #111827; padding: 10px 18px; font-weight: 600; border-radius: 8px; cursor: pointer;" @onclick="HideCreateModal">Cancel</button>
                <button class="btn" style="background: #059669; color: white; padding: 10px 18px; font-weight: 600; border-radius: 8px; cursor: pointer;" @onclick="CreateBillPayment">Create Payment</button>
            </div>
        </div>
    </div>
}

<!-- Table -->
<div style="background: white; border: 1px solid #e5e7eb; border-radius: 16px; overflow: hidden;">
    <table style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr style="border-bottom: 1px solid #e5e7eb; background: #f9fafb;">
                <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280; font-weight: 600;">BILLER NAME</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280; font-weight: 600;">ACCOUNT</th>
                <th style="padding: 12px; text-align: right; font-size: 12px; color: #6b7280; font-weight: 600;">AMOUNT</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280; font-weight: 600;">STATUS</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280; font-weight: 600;">DATE</th>
                <th style="padding: 12px; text-align: center; font-size: 12px; color: #6b7280; font-weight: 600;">ACTIONS</th>
            </tr>
        </thead>
        <tbody>
            @if (billPayments.Count == 0)
            {
                <tr>
                    <td colspan="6" style="padding: 24px; text-align: center; color: #6b7280; font-size: 14px;">No bill payments found</td>
                </tr>
            }
            @foreach (var payment in billPayments)
            {
                <tr style="border-bottom: 1px solid #e5e7eb;">
                    <td style="padding: 12px; font-size: 13px; color: #111827; font-weight: 600;">@payment.BillerName</td>
                    <td style="padding: 12px; font-size: 13px; color: #6b7280;">@(string.IsNullOrEmpty(payment.BillerAccountNumber) ? "N/A" : payment.BillerAccountNumber)</td>
                    <td style="padding: 12px; text-align: right; font-size: 13px; color: #111827; font-weight: 600;">₱@payment.Amount.ToString("N2")</td>
                    <td style="padding: 12px; font-size: 13px;">
                        <span style="display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 999px; font-size: 11px; font-weight: 600; background: @(payment.Status == "Completed" ? "#d1fae5" : payment.Status == "Pending" ? "#fef3c7" : "#fee2e2"); color: @(payment.Status == "Completed" ? "#065f46" : payment.Status == "Pending" ? "#92400e" : "#991b1b");">
                            @payment.Status
                        </span>
                    </td>
                    <td style="padding: 12px; font-size: 13px; color: #6b7280;">@payment.CreatedAt.ToShortDateString()</td>
                    <td style="padding: 12px; text-align: center;">
                        <button class="btn" style="background: #059669; color: white; padding: 6px 12px; border-radius: 6px; font-weight: 600; font-size: 12px; cursor: pointer;" disabled="@(payment.Status == "Completed")" @onclick="() => ApprovePayment(payment)">Approve</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<CustomerTransaction> billPayments = new();
    private string searchTerm = "";
    private bool showCreateModal = false;
    private CustomerTransaction newBillPayment = new();
    private decimal billAmount = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadBillPayments();
    }

    private async Task LoadBillPayments()
    {
        // Mock data - in real implementation, load from database
        billPayments = new List<CustomerTransaction>
        {
            new() { 
                TransactionNumber = "BILL001", 
                BillerName = "MERALCO", 
                BillerAccountNumber = "123456789",
                Amount = 2500, 
                Status = "Completed",
                CreatedAt = DateTime.Now.AddDays(-5)
            },
            new() { 
                TransactionNumber = "BILL002", 
                BillerName = "PLDT", 
                BillerAccountNumber = "987654321",
                Amount = 1200, 
                Status = "Pending",
                CreatedAt = DateTime.Now.AddDays(-2)
            }
        };
    }

    private void ShowCreateModal()
    {
        newBillPayment = new CustomerTransaction();
        billAmount = 0;
        showCreateModal = true;
    }

    private void HideCreateModal()
    {
        showCreateModal = false;
    }

    private async Task CreateBillPayment()
    {
        newBillPayment.Amount = billAmount;
        newBillPayment.TransactionType = "BillPayment";
        newBillPayment.Status = "Pending";
        newBillPayment.CreatedAt = DateTime.Now;
        newBillPayment.TransactionNumber = $"BILL{DateTime.Now.Ticks}";
        
        billPayments.Insert(0, newBillPayment);
        showCreateModal = false;
        await Task.CompletedTask;
    }

    private async Task ApprovePayment(CustomerTransaction payment)
    {
        var index = billPayments.IndexOf(payment);
        if (index >= 0)
        {
            billPayments[index].Status = "Completed";
            billPayments[index].ProcessedAt = DateTime.Now;
        }
        await Task.CompletedTask;
    }
}
