@page "/admin/banking/billers"
@layout AdminLayout

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
            <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
        </div>
        <div>
            <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Billers Management</h1>
            <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Manage billers and payment partners</p>
        </div>
    </div>
</div>

@code {
    private bool showAddBillerModal = false;
    private bool showEditBillerModal = false;
    private int selectedBillerId = 0;

    private void ShowAddBillerModal() => showAddBillerModal = true;
    private void CloseAddBillerModal() => showAddBillerModal = false;
    private void ShowEditBillerModal(int id) { selectedBillerId = id; showEditBillerModal = true; }
    private void CloseEditBillerModal() => showEditBillerModal = false;
}

