@page "/admin/banking/cards"
@page "/admin/banking/card-management"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@inject CardManagementService CardManagementService
@inject AuthService AuthService

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #059669 0%, #047857 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
            <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path d="M3 10h18M7 15h1m4 0h1m4 0h1M5 21h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v14a2 2 0 002 2z"/>
            </svg>
        </div>
        <div>
            <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Card Management</h1>
            <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Manage customer card actions and lifecycle</p>
        </div>
    </div>
</div>

<!-- Action Filters and Summary -->
<div style="display:flex; flex-wrap:wrap; gap:12px; margin-bottom:16px; align-items:flex-end;">
    <div style="flex:1 1 220px;">
        <label style="display:block; font-size:12px; font-weight:600; color:#4b5563; margin-bottom:4px;">Filter by Action</label>
        <select class="form-control" @bind="selectedAction">
            <option value="all">All Actions</option>
            <option value="Issue">Issue</option>
            <option value="Block">Block</option>
            <option value="Unblock">Unblock</option>
            <option value="Close">Close</option>
        </select>
    </div>
    <div style="flex:0 0 auto; display:flex; gap:8px;">
        <div style="background:white; border-radius:12px; border:1px solid #e5e7eb; padding:10px 14px; font-size:12px; color:#4b5563;">
            Issue: <span style="font-weight:600; color:#059669;">@issueCount</span>
        </div>
        <div style="background:white; border-radius:12px; border:1px solid #e5e7eb; padding:10px 14px; font-size:12px; color:#4b5563;">
            Block: <span style="font-weight:600; color:#f59e0b;">@blockCount</span>
        </div>
        <div style="background:white; border-radius:12px; border:1px solid #e5e7eb; padding:10px 14px; font-size:12px; color:#4b5563;">
            Unblock: <span style="font-weight:600; color:#0891b2;">@unblockCount</span>
        </div>
        <div style="background:white; border-radius:12px; border:1px solid #e5e7eb; padding:10px 14px; font-size:12px; color:#4b5563;">
            Close: <span style="font-weight:600; color:#b91c1c;">@closeCount</span>
        </div>
    </div>
</div>

<!-- Card Actions Table -->
<div style="background:white; border-radius:16px; border:1px solid #e5e7eb; overflow:hidden;">
    <table style="width:100%; border-collapse:collapse;">
        <thead>
            <tr style="background:#f9fafb; border-bottom:1px solid #e5e7eb;">
                <th style="padding:12px; text-align:left; font-size:12px; color:#6b7280;">CARD MGMT ID</th>
                <th style="padding:12px; text-align:left; font-size:12px; color:#6b7280;">CUSTOMER CARD ID</th>
                <th style="padding:12px; text-align:left; font-size:12px; color:#6b7280;">ACTION</th>
                <th style="padding:12px; text-align:left; font-size:12px; color:#6b7280;">REASON</th>
                <th style="padding:12px; text-align:left; font-size:12px; color:#6b7280;">ACTION BY</th>
                <th style="padding:12px; text-align:left; font-size:12px; color:#6b7280;">ACTION AT</th>
            </tr>
        </thead>
        <tbody>
            @if (filteredActions.Any())
            {
                @foreach (var action in filteredActions)
                {
                    <tr style="border-bottom:1px solid #e5e7eb;">
                        <td style="padding:12px; font-size:13px; color:#111827;">@action.CardMgmtId</td>
                        <td style="padding:12px; font-size:13px; color:#4b5563;">@action.CustomerCardId</td>
                        <td style="padding:12px;">
                            <span style="display:inline-flex; align-items:center; padding:4px 10px; border-radius:999px; font-size:12px; font-weight:600; background:@GetActionBadgeBg(action.Action); color:@GetActionBadgeColor(action.Action);">
                                @action.Action
                            </span>
                        </td>
                        <td style="padding:12px; font-size:13px; color:#6b7280;">@(action.Reason ?? "-")</td>
                        <td style="padding:12px; font-size:13px; color:#6b7280;">@action.ActionBy</td>
                        <td style="padding:12px; font-size:13px; color:#6b7280;">@action.ActionAt.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" style="padding:24px; text-align:center; font-size:14px; color:#6b7280;">No card management actions recorded yet.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- New Card Action Modal Trigger -->
<div style="margin-top:20px; display:flex; justify-content:flex-end;">
    <button class="btn" style="background:#7c3aed; color:white; padding:10px 20px; border-radius:8px; font-size:14px; font-weight:600;" @onclick="OpenNewActionModal">
        + Record Card Action
    </button>
</div>

<!-- New Card Action Modal -->
@if (showNewActionModal)
{
    <div @onclick="CloseNewActionModal" style="position:fixed; inset:0; background:rgba(0,0,0,0.5); display:flex; align-items:center; justify-content:center; z-index:1000; padding:20px;">
        <div @onclick:stopPropagation style="background:white; border-radius:16px; max-width:640px; width:100%; box-shadow:0 20px 60px rgba(0,0,0,0.3);">
            <div style="padding:20px 24px; border-bottom:1px solid #e5e7eb; display:flex; justify-content:space-between; align-items:center;">
                <div>
                    <h2 style="font-size:20px; font-weight:700; color:#111827; margin:0;">Record Card Action</h2>
                    <p style="font-size:13px; color:#6b7280; margin:4px 0 0 0;">Document a card management action</p>
                </div>
                <button @onclick="CloseNewActionModal" style="background:none; border:none; font-size:22px; color:#6b7280; cursor:pointer;">×</button>
            </div>

            <div style="padding:20px 24px; display:flex; flex-direction:column; gap:12px;">
                <div>
                    <label style="display:block; font-size:12px; font-weight:600; color:#374151; margin-bottom:4px;">Customer Card ID</label>
                    <input type="number" class="form-control" @bind="newCardId" placeholder="Enter customer card ID" />
                </div>
                <div>
                    <label style="display:block; font-size:12px; font-weight:600; color:#374151; margin-bottom:4px;">Action</label>
                    <select class="form-control" @bind="newAction">
                        <option value="">-- Select Action --</option>
                        <option value="Issue">Issue</option>
                        <option value="Block">Block</option>
                        <option value="Unblock">Unblock</option>
                        <option value="Close">Close</option>
                    </select>
                </div>
                <div>
                    <label style="display:block; font-size:12px; font-weight:600; color:#374151; margin-bottom:4px;">Reason (optional)</label>
                    <textarea class="form-control" rows="2" @bind="newReason" placeholder="Enter reason for this action"></textarea>
                </div>
            </div>

            <div style="padding:16px 24px; border-top:1px solid #e5e7eb; display:flex; justify-content:flex-end; gap:8px;">
                <button class="btn" style="background:#f3f4f6; color:#111827; padding:8px 16px; border-radius:8px; font-size:14px;" @onclick="CloseNewActionModal">Cancel</button>
                <button class="btn" style="background:#7c3aed; color:white; padding:8px 16px; border-radius:8px; font-size:14px;" @onclick="RecordAction">Record Action</button>
            </div>
        </div>
    </div>
}

@code {
    private List<CardManagementEntity> actions = new();
    private string selectedAction = "all";

    private bool showNewActionModal;
    private int newCardId;
    private string newAction = string.Empty;
    private string newReason = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        actions = await CardManagementService.GetAllAsync();
    }

    private IEnumerable<CardManagementEntity> filteredActions => actions
        .Where(a => selectedAction == "all" || a.Action == selectedAction);

    private int issueCount => actions.Count(a => a.Action == "Issue");
    private int blockCount => actions.Count(a => a.Action == "Block");
    private int unblockCount => actions.Count(a => a.Action == "Unblock");
    private int closeCount => actions.Count(a => a.Action == "Close");

    private string GetActionBadgeBg(string action)
    {
        return action switch
        {
            "Issue" => "#d1fae5",
            "Block" => "#fef3c7",
            "Unblock" => "#cffafe",
            "Close" => "#fee2e2",
            _ => "#f3f4f6"
        };
    }

    private string GetActionBadgeColor(string action)
    {
        return action switch
        {
            "Issue" => "#065f46",
            "Block" => "#92400e",
            "Unblock" => "#0c4a6e",
            "Close" => "#b91c1c",
            _ => "#4b5563"
        };
    }

    private void OpenNewActionModal()
    {
        showNewActionModal = true;
        newCardId = 0;
        newAction = string.Empty;
        newReason = string.Empty;
    }

    private void CloseNewActionModal()
    {
        showNewActionModal = false;
        newCardId = 0;
        newAction = string.Empty;
        newReason = string.Empty;
    }

    private async Task RecordAction()
    {
        if (newCardId <= 0 || string.IsNullOrWhiteSpace(newAction))
            return;

        var user = AuthService.FullName ?? AuthService.CurrentUser ?? "system";
        var recorded = await CardManagementService.RecordActionAsync(newCardId, newAction, user, newReason);
        
        actions.Insert(0, recorded);
        CloseNewActionModal();
    }
}
