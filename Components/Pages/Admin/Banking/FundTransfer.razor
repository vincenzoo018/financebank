@page "/admin/banking/fund-transfer"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@using FTModel = FinanceBank.Models.FundTransfer
@inject FundTransferService Service

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #059669 0%, #047857 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
            <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"/>
            </svg>
        </div>
        <div>
            <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Fund Transfers</h1>
            <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Manage bank transfer operations</p>
        </div>
    </div>
</div>

<div style="display:flex; justify-content:flex-end; align-items:center; margin-bottom:24px;">
    <button class="btn" style="background:#059669; color:white; padding:10px 18px; font-weight:600; border-radius:8px; font-size:14px;" @onclick="ShowCreate">+ New Transfer</button>
    @if (showCreate)
    {
        <div style="position:fixed; inset:0; background:rgba(0,0,0,0.5); display:flex; align-items:center; justify-content:center; z-index:1000;" @onclick="HideCreate">
            <div style="background:white; border-radius:16px; padding:32px; width:90%; max-width:600px; box-shadow: 0 20px 25px rgba(0,0,0,0.1);" @onclick:stopPropagation="true">
                <h2 style="font-size:20px; font-weight:700; color:#111827; margin:0 0 24px 0;">New Fund Transfer</h2>
                <div style="display:grid; grid-template-columns:repeat(2,1fr); gap:16px; margin-bottom:16px;">
                    <div>
                        <label style="display:block; font-size:12px; font-weight:600; color:#6b7280; margin-bottom:6px;">From Account ID</label>
                        <input class="form-control" type="number" placeholder="Enter account ID" @bind-value="draft.FromAccountId" style="width:100%; padding:10px 12px; border:1px solid #e5e7eb; border-radius:8px;" />
                    </div>
                    <div>
                        <label style="display:block; font-size:12px; font-weight:600; color:#6b7280; margin-bottom:6px;">To Account ID</label>
                        <input class="form-control" type="number" placeholder="Enter account ID" @bind-value="draft.ToAccountId" style="width:100%; padding:10px 12px; border:1px solid #e5e7eb; border-radius:8px;" />
                    </div>
                    <div>
                        <label style="display:block; font-size:12px; font-weight:600; color:#6b7280; margin-bottom:6px;">Amount</label>
                        <input class="form-control" type="number" placeholder="0.00" @bind-value="draftAmount" style="width:100%; padding:10px 12px; border:1px solid #e5e7eb; border-radius:8px;" />
                    </div>
                    <div>
                        <label style="display:block; font-size:12px; font-weight:600; color:#6b7280; margin-bottom:6px;">Fee</label>
                        <input class="form-control" type="number" placeholder="0.00" @bind-value="draftFee" style="width:100%; padding:10px 12px; border:1px solid #e5e7eb; border-radius:8px;" />
                    </div>
                </div>
                <div style="margin-bottom:24px;">
                    <label style="display:block; font-size:12px; font-weight:600; color:#6b7280; margin-bottom:6px;">Description</label>
                    <input class="form-control" placeholder="Enter description" @bind="draft.Description" style="width:100%; padding:10px 12px; border:1px solid #e5e7eb; border-radius:8px;" />
                </div>
                <div style="display:flex; gap:12px; justify-content:flex-end;">
                    <button class="btn" style="background:#e5e7eb; color:#111827; padding:10px 18px; font-weight:600; border-radius:8px;" @onclick="HideCreate">Cancel</button>
                    <button class="btn" style="background:#059669; color:white; padding:10px 18px; font-weight:600; border-radius:8px;" @onclick="Create">Save Transfer</button>
                </div>
            </div>
        </div>
    }
</div>

<div style="background:white; border:1px solid var(--border); border-radius:16px; overflow:hidden;">
    <table style="width:100%; border-collapse:collapse;">
        <thead>
            <tr style="border-bottom:1px solid var(--border); background:#f9fafb;">
                <th style="padding:12px; text-align:left; font-size:12px; color:#6b7280; font-weight:600;">NUMBER</th>
                <th style="padding:12px; text-align:right; font-size:12px; color:#6b7280; font-weight:600;">AMOUNT</th>
                <th style="padding:12px; text-align:right; font-size:12px; color:#6b7280; font-weight:600;">FEE</th>
                <th style="padding:12px; text-align:left; font-size:12px; color:#6b7280; font-weight:600;">FROM</th>
                <th style="padding:12px; text-align:left; font-size:12px; color:#6b7280; font-weight:600;">TO</th>
                <th style="padding:12px; text-align:left; font-size:12px; color:#6b7280; font-weight:600;">STATUS</th>
                <th style="padding:12px; text-align:center; font-size:12px; color:#6b7280; font-weight:600;">ACTIONS</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in items)
            {
                <tr style="border-bottom:1px solid #e5e7eb;">
                    <td style="padding:12px; font-size:13px; color:#111827;">@t.TransferNumber</td>
                    <td style="padding:12px; text-align:right; font-size:13px; color:#111827; font-weight:600;">@t.Amount.ToString("N2")</td>
                    <td style="padding:12px; text-align:right; font-size:13px; color:#6b7280;">@t.Fee.ToString("N2")</td>
                    <td style="padding:12px; font-size:13px; color:#6b7280;">@t.FromAccountId</td>
                    <td style="padding:12px; font-size:13px; color:#6b7280;">@t.ToAccountId</td>
                    <td style="padding:12px; font-size:13px;">
                        <span style="display:inline-flex; align-items:center; padding:4px 10px; border-radius:999px; font-size:11px; font-weight:600; background:@(t.Status=="Approved" ? "#d1fae5" : "#fef3c7"); color:@(t.Status=="Approved" ? "#065f46" : "#92400e");">
                            @t.Status
                        </span>
                    </td>
                    <td style="padding:12px; text-align:center;">
                        <button class="btn" style="background:#059669; color:white; padding:6px 12px; border-radius:6px; font-weight:600; font-size:12px;" disabled="@(t.Status=="Approved")" @onclick="() => Approve(t.TransferId)">Approve</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<FTModel> items = new();
    private bool showCreate;
    private FTModel draft = new();
    private decimal draftAmount;
    private decimal draftFee;

    protected override async Task OnInitializedAsync()
    {
        items = await Service.GetAllAsync();
    }

    private void ShowCreate()
    {
        draft = new FTModel { Amount = 0, Fee = 0 };
        draftAmount = 0; draftFee = 0; showCreate = true;
    }

    private void HideCreate()
    {
        showCreate = false;
    }

    private async Task Create()
    {
        draft.Amount = draftAmount; draft.Fee = draftFee;
        var created = await Service.CreateAsync(draft);
        items.Insert(0, created);
        showCreate = false;
    }

    private async Task Approve(int id)
    {
        var ok = await Service.ApproveAsync(id, "admin");
        if (ok)
        {
            var idx = items.FindIndex(x => x.TransferId == id);
            if (idx >= 0) items[idx].Status = "Approved";
            StateHasChanged();
        }
    }
}

