@page "/admin/finance/loan-approvals"
@page "/admin/finance-mgr/loan-approval"
@layout AdminLayout
@using FinanceBank.Models
@using FinanceBank.Services
@using FinanceBank.Data
@using Microsoft.EntityFrameworkCore
@inject LoanProcessService LoanService
@inject BFASDbContext DbContext
@inject AuthService AuthService
@inject NavigationManager Navigation

<!-- Toast Notification -->
@if (showToast)
{
    <div style="position: fixed; top: 20px; right: 20px; z-index: 9999; animation: slideIn 0.3s ease-out;">
        <div style="background: linear-gradient(135deg, @(toastType == "success" ? "#059669, #10b981" : "#dc2626, #ef4444")); color: white; padding: 16px 24px; border-radius: 12px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); display: flex; align-items: center; gap: 12px; min-width: 300px;">
            <span style="font-weight: 500;">@toastMessage</span>
            <button @onclick="() => showToast = false" style="background: none; border: none; color: white; cursor: pointer; margin-left: auto; font-size: 18px;">×</button>
        </div>
    </div>
}

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #4a7c59 0%, #5d8a6b 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; justify-content: space-between;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
                <svg width="28" height="28" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
            </div>
            <div>
                <h1 style="font-size: 26px; font-weight: 700; color: white; margin: 0;">Loan Approval Center (Admin)</h1>
                <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Review, approve or decline loan applications - SuperAdmin Access</p>
            </div>
        </div>
    </div>
</div>

<!-- Admin Notice -->
<div style="background: #fef3c7; border: 1px solid #f59e0b; border-radius: 12px; padding: 16px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 12px;">
        <span style="font-size: 24px;">⚠️</span>
        <div>
            <p style="margin: 0; font-weight: 600; color: #92400e;">Administrative Loan Approval Access</p>
            <p style="margin: 4px 0 0; font-size: 13px; color: #a16207;">All approval decisions made here will require an admin reason for audit purposes.</p>
        </div>
    </div>
</div>

<!-- Statistics Cards -->
<div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 24px;">
    <div style="background: white; border-radius: 16px; padding: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); border-left: 4px solid #f59e0b;">
        <div style="font-size: 13px; color: #92400e; font-weight: 600; margin-bottom: 8px; text-transform: uppercase;">⏳ Pending</div>
        <div style="font-size: 32px; font-weight: 700; color: #f59e0b;">@pendingCount</div>
    </div>
    <div style="background: white; border-radius: 16px; padding: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); border-left: 4px solid #059669;">
        <div style="font-size: 13px; color: #065f46; font-weight: 600; margin-bottom: 8px; text-transform: uppercase;">✓ Approved</div>
        <div style="font-size: 32px; font-weight: 700; color: #059669;">@approvedCount</div>
    </div>
    <div style="background: white; border-radius: 16px; padding: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); border-left: 4px solid #dc2626;">
        <div style="font-size: 13px; color: #991b1b; font-weight: 600; margin-bottom: 8px; text-transform: uppercase;">✗ Declined</div>
        <div style="font-size: 32px; font-weight: 700; color: #dc2626;">@declinedCount</div>
    </div>
    <div style="background: white; border-radius: 16px; padding: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); border-left: 4px solid #3b82f6;">
        <div style="font-size: 13px; color: #1e40af; font-weight: 600; margin-bottom: 8px; text-transform: uppercase;">💰 Total Value</div>
        <div style="font-size: 24px; font-weight: 700; color: #3b82f6;">₱@totalLoanValue.ToString("N0")</div>
    </div>
</div>

<!-- Pending Applications Table -->
<div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb; margin-bottom: 24px;">
    <h3 style="margin: 0 0 20px; font-size: 18px; font-weight: 700; color: #1f2937;">Pending Loan Applications</h3>
    
    @if (isLoading)
    {
        <div style="padding: 40px; text-align: center; color: #6b7280;">
            <p>Loading loan applications...</p>
        </div>
    }
    else if (pendingLoans.Any())
    {
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="border-bottom: 2px solid #e5e7eb; background: #f9fafb;">
                        <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">APPLICATION #</th>
                        <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">CUSTOMER</th>
                        <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">LOAN TYPE</th>
                        <th style="padding: 12px; text-align: right; font-size: 12px; font-weight: 700; color: #6b7280;">AMOUNT</th>
                        <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">DATE</th>
                        <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">STATUS</th>
                        <th style="padding: 12px; text-align: center; font-size: 12px; font-weight: 700; color: #6b7280;">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var loan in pendingLoans)
                    {
                        <tr style="border-bottom: 1px solid #e5e7eb;">
                            <td style="padding: 14px 12px; font-weight: 600;">@loan.ApplicationNumber</td>
                            <td style="padding: 14px 12px;">@loan.CustomerName</td>
                            <td style="padding: 14px 12px;">@loan.LoanType</td>
                            <td style="padding: 14px 12px; text-align: right; font-weight: 600; color: #059669;">₱@loan.Amount.ToString("N2")</td>
                            <td style="padding: 14px 12px; font-size: 13px; color: #6b7280;">@loan.ApplicationDate.ToString("MM/dd/yyyy")</td>
                            <td style="padding: 14px 12px;">
                                <span style="padding: 4px 10px; background: #fef3c7; color: #92400e; border-radius: 6px; font-size: 12px; font-weight: 600;">
                                    Pending
                                </span>
                            </td>
                            <td style="padding: 14px 12px; text-align: center;">
                                <div style="display: flex; gap: 8px; justify-content: center;">
                                    <button type="button" 
                                            @onclick="() => OpenApprovalModal(loan)"
                                            style="background: #059669; color: white; padding: 6px 12px; border-radius: 6px; border: none; cursor: pointer; font-weight: 600; font-size: 12px;">
                                        ✓ Approve
                                    </button>
                                    <button type="button" 
                                            @onclick="() => OpenDeclineModal(loan)"
                                            style="background: #dc2626; color: white; padding: 6px 12px; border-radius: 6px; border: none; cursor: pointer; font-weight: 600; font-size: 12px;">
                                        ✗ Decline
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div style="padding: 40px; text-align: center; color: #6b7280;">
            <p style="margin: 0; font-size: 14px;">No pending loan applications.</p>
        </div>
    }
</div>

<!-- Recent Approvals/Declines Table -->
<div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
    <h3 style="margin: 0 0 20px; font-size: 18px; font-weight: 700; color: #1f2937;">Recent Decisions</h3>
    
    @if (recentDecisions.Any())
    {
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="border-bottom: 2px solid #e5e7eb; background: #f9fafb;">
                        <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">APPLICATION #</th>
                        <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">CUSTOMER</th>
                        <th style="padding: 12px; text-align: right; font-size: 12px; font-weight: 700; color: #6b7280;">AMOUNT</th>
                        <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">DECISION</th>
                        <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">DECIDED BY</th>
                        <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">DATE</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var decision in recentDecisions.Take(10))
                    {
                        <tr style="border-bottom: 1px solid #e5e7eb;">
                            <td style="padding: 14px 12px; font-weight: 600;">@decision.ApplicationNumber</td>
                            <td style="padding: 14px 12px;">@decision.CustomerName</td>
                            <td style="padding: 14px 12px; text-align: right; font-weight: 600;">₱@decision.Amount.ToString("N2")</td>
                            <td style="padding: 14px 12px;">
                                <span style="padding: 4px 10px; background: @(decision.IsApproved ? "#d1fae5" : "#fee2e2"); color: @(decision.IsApproved ? "#065f46" : "#991b1b"); border-radius: 6px; font-size: 12px; font-weight: 600;">
                                    @(decision.IsApproved ? "Approved" : "Declined")
                                </span>
                            </td>
                            <td style="padding: 14px 12px; font-size: 13px;">@decision.DecidedBy</td>
                            <td style="padding: 14px 12px; font-size: 13px; color: #6b7280;">@decision.DecisionDate.ToString("MM/dd/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div style="padding: 40px; text-align: center; color: #6b7280;">
            <p style="margin: 0; font-size: 14px;">No recent decisions.</p>
        </div>
    }
</div>

<!-- Approval Modal -->
@if (showApprovalModal && selectedLoan != null)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000;" @onclick="CloseModals">
        <div style="background: white; border-radius: 12px; padding: 24px; width: 90%; max-width: 500px;" @onclick:stopPropagation>
            <h2 style="font-size: 20px; font-weight: 700; margin-bottom: 20px; color: #059669;">✓ Approve Loan Application</h2>
            
            <div style="background: #f0fdf4; border-radius: 8px; padding: 16px; margin-bottom: 20px;">
                <p style="margin: 0 0 8px; font-size: 14px;"><strong>Application:</strong> @selectedLoan.ApplicationNumber</p>
                <p style="margin: 0 0 8px; font-size: 14px;"><strong>Customer:</strong> @selectedLoan.CustomerName</p>
                <p style="margin: 0; font-size: 14px;"><strong>Amount:</strong> ₱@selectedLoan.Amount.ToString("N2")</p>
            </div>
            
            <!-- Admin Reason -->
            <div style="margin-bottom: 20px;">
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px; color: #dc2626;">
                    ⚠️ Reason for Admin Approval (Required) *
                </label>
                <textarea style="width: 100%; padding: 12px; border: 2px solid #f59e0b; border-radius: 8px; font-size: 14px; min-height: 80px; background: #fffbeb;" 
                          @bind="adminReason" placeholder="Enter the reason for approving this loan as SuperAdmin..."></textarea>
            </div>

            <div style="margin-bottom: 20px;">
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Approval Notes</label>
                <textarea style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px; min-height: 60px;" 
                          @bind="approvalNotes" placeholder="Additional notes..."></textarea>
            </div>

            <div style="display: flex; gap: 12px; justify-content: flex-end;">
                <button type="button" style="background: #f3f4f6; color: #374151; padding: 10px 20px; border-radius: 8px; border: none; font-weight: 600; cursor: pointer;" @onclick="CloseModals">
                    Cancel
                </button>
                <button type="button" style="background: #059669; color: white; padding: 10px 20px; border-radius: 8px; border: none; font-weight: 600; cursor: pointer;" 
                        @onclick="ConfirmApproval" disabled="@(string.IsNullOrEmpty(adminReason) || isProcessing)">
                    @(isProcessing ? "Processing..." : "Confirm Approval")
                </button>
            </div>
        </div>
    </div>
}

<!-- Decline Modal -->
@if (showDeclineModal && selectedLoan != null)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000;" @onclick="CloseModals">
        <div style="background: white; border-radius: 12px; padding: 24px; width: 90%; max-width: 500px;" @onclick:stopPropagation>
            <h2 style="font-size: 20px; font-weight: 700; margin-bottom: 20px; color: #dc2626;">✗ Decline Loan Application</h2>
            
            <div style="background: #fef2f2; border-radius: 8px; padding: 16px; margin-bottom: 20px;">
                <p style="margin: 0 0 8px; font-size: 14px;"><strong>Application:</strong> @selectedLoan.ApplicationNumber</p>
                <p style="margin: 0 0 8px; font-size: 14px;"><strong>Customer:</strong> @selectedLoan.CustomerName</p>
                <p style="margin: 0; font-size: 14px;"><strong>Amount:</strong> ₱@selectedLoan.Amount.ToString("N2")</p>
            </div>
            
            <!-- Admin Reason -->
            <div style="margin-bottom: 20px;">
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px; color: #dc2626;">
                    ⚠️ Reason for Admin Decline (Required) *
                </label>
                <textarea style="width: 100%; padding: 12px; border: 2px solid #f59e0b; border-radius: 8px; font-size: 14px; min-height: 80px; background: #fffbeb;" 
                          @bind="adminReason" placeholder="Enter the reason for declining this loan as SuperAdmin..."></textarea>
            </div>

            <div style="margin-bottom: 20px;">
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Decline Reason for Customer</label>
                <textarea style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px; min-height: 60px;" 
                          @bind="declineReason" placeholder="Reason to communicate to customer..."></textarea>
            </div>

            <div style="display: flex; gap: 12px; justify-content: flex-end;">
                <button type="button" style="background: #f3f4f6; color: #374151; padding: 10px 20px; border-radius: 8px; border: none; font-weight: 600; cursor: pointer;" @onclick="CloseModals">
                    Cancel
                </button>
                <button type="button" style="background: #dc2626; color: white; padding: 10px 20px; border-radius: 8px; border: none; font-weight: 600; cursor: pointer;" 
                        @onclick="ConfirmDecline" disabled="@(string.IsNullOrEmpty(adminReason) || isProcessing)">
                    @(isProcessing ? "Processing..." : "Confirm Decline")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool isProcessing = false;
    private bool showToast = false;
    private string toastMessage = "";
    private string toastType = "success";
    
    private bool showApprovalModal = false;
    private bool showDeclineModal = false;
    private string adminReason = "";
    private string approvalNotes = "";
    private string declineReason = "";
    
    private int pendingCount = 0;
    private int approvedCount = 0;
    private int declinedCount = 0;
    private decimal totalLoanValue = 0;
    
    private List<LoanViewModel> pendingLoans = new();
    private List<DecisionViewModel> recentDecisions = new();
    private LoanViewModel? selectedLoan;
    
    private class LoanViewModel
    {
        public int LoanId { get; set; }
        public string ApplicationNumber { get; set; } = "";
        public string CustomerName { get; set; } = "";
        public string LoanType { get; set; } = "";
        public decimal Amount { get; set; }
        public DateTime ApplicationDate { get; set; }
    }
    
    private class DecisionViewModel
    {
        public string ApplicationNumber { get; set; } = "";
        public string CustomerName { get; set; } = "";
        public decimal Amount { get; set; }
        public bool IsApproved { get; set; }
        public string DecidedBy { get; set; } = "";
        public DateTime DecisionDate { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            // Load pending applications
            var applications = await DbContext.LoanApplications
                .Include(a => a.Account)
                .ThenInclude(acc => acc.Customer)
                .Where(a => a.Status == "Pending" || a.Status == "UnderReview")
                .OrderByDescending(a => a.ApplicationDate)
                .ToListAsync();
            
            pendingLoans = applications.Select(a => new LoanViewModel
            {
                LoanId = a.ApplicationId,
                ApplicationNumber = a.ApplicationNumber ?? $"LOAN-{a.ApplicationId}",
                CustomerName = a.Account?.Customer?.FullName ?? "Unknown",
                LoanType = a.LoanType ?? "Personal",
                Amount = a.RequestedAmount,
                ApplicationDate = a.ApplicationDate
            }).ToList();
            
            pendingCount = pendingLoans.Count;
            totalLoanValue = pendingLoans.Sum(l => l.Amount);
            
            // Load recent decisions
            var approvals = await DbContext.LoanApprovals
                .Include(a => a.Application)
                .ThenInclude(app => app.Account)
                .ThenInclude(acc => acc.Customer)
                .OrderByDescending(a => a.ApprovalDate)
                .Take(20)
                .ToListAsync();
            
            recentDecisions = approvals.Select(a => new DecisionViewModel
            {
                ApplicationNumber = a.Application?.ApplicationNumber ?? "",
                CustomerName = a.Application?.Account?.Customer?.FullName ?? "Unknown",
                Amount = a.ApprovedAmount ?? 0,
                IsApproved = a.ApprovalStatus == "APPROVED",
                DecidedBy = a.ApprovedBy ?? "System",
                DecisionDate = a.ApprovalDate
            }).ToList();
            
            approvedCount = recentDecisions.Count(d => d.IsApproved);
            declinedCount = recentDecisions.Count(d => !d.IsApproved);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
            ShowToast($"Error loading data: {ex.Message}", "error");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenApprovalModal(LoanViewModel loan)
    {
        selectedLoan = loan;
        adminReason = "";
        approvalNotes = "";
        showApprovalModal = true;
    }

    private void OpenDeclineModal(LoanViewModel loan)
    {
        selectedLoan = loan;
        adminReason = "";
        declineReason = "";
        showDeclineModal = true;
    }

    private void CloseModals()
    {
        showApprovalModal = false;
        showDeclineModal = false;
        selectedLoan = null;
        adminReason = "";
        approvalNotes = "";
        declineReason = "";
    }

    private async Task ConfirmApproval()
    {
        if (selectedLoan == null || string.IsNullOrEmpty(adminReason))
            return;
        
        isProcessing = true;
        try
        {
            var application = await DbContext.LoanApplications.FindAsync(selectedLoan.LoanId);
            if (application != null)
            {
                application.Status = "Approved";
                
                var approval = new LoanApproval
                {
                    ApplicationId = application.ApplicationId,
                    AccountId = application.AccountId,
                    AssessmentId = 0, // Admin action - no assessment required
                    ApprovalDate = DateTime.Now,
                    ApprovedBy = $"{AuthService.CurrentUser} (SuperAdmin)",
                    ApprovedAmount = application.RequestedAmount,
                    ApprovalStatus = "APPROVED",
                    SpecialConditions = $"[ADMIN ACTION] Reason: {adminReason} | Notes: {approvalNotes}"
                };
                
                DbContext.LoanApprovals.Add(approval);
                await DbContext.SaveChangesAsync();
                
                ShowToast("Loan application approved successfully!", "success");
                CloseModals();
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Error approving loan: {ex.Message}", "error");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ConfirmDecline()
    {
        if (selectedLoan == null || string.IsNullOrEmpty(adminReason))
            return;
        
        isProcessing = true;
        try
        {
            var application = await DbContext.LoanApplications.FindAsync(selectedLoan.LoanId);
            if (application != null)
            {
                application.Status = "Declined";
                
                var approval = new LoanApproval
                {
                    ApplicationId = application.ApplicationId,
                    AccountId = application.AccountId,
                    AssessmentId = 0, // Admin action - no assessment required
                    ApprovalDate = DateTime.Now,
                    ApprovedBy = $"{AuthService.CurrentUser} (SuperAdmin)",
                    ApprovedAmount = 0,
                    ApprovalStatus = "DECLINED",
                    DeclinationReason = $"[ADMIN ACTION] Reason: {adminReason} | Customer Reason: {declineReason}"
                };
                
                DbContext.LoanApprovals.Add(approval);
                await DbContext.SaveChangesAsync();
                
                ShowToast("Loan application declined.", "success");
                CloseModals();
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Error declining loan: {ex.Message}", "error");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void ShowToast(string message, string type)
    {
        toastMessage = message;
        toastType = type;
        showToast = true;
        
        Task.Run(async () =>
        {
            await Task.Delay(3000);
            showToast = false;
            await InvokeAsync(StateHasChanged);
        });
    }
}
