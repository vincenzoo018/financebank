@page "/admin/finance/cashflow-reports"
@layout AdminLayout
@namespace FinanceBank.Components.Pages.Admin.Finance
@inject CashflowAnalysisService CashflowAnalysisService

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
            <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path d="M3 12a9 9 0 1 0 18 0A9 9 0 1 0 3 12Z"></path>
                <path d="M9 9h6v6H9z"></path>
            </svg>
        </div>
        <div>
            <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Cash Flow Reports</h1>
            <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Cash inflows, outflows, and liquidity analysis</p>
        </div>
    </div>
</div>

<!-- Summary Cards -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 24px;">
    <div style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); border-radius: 16px; padding: 24px; border: 2px solid #6ee7b7;">
        <div style="font-size: 13px; color: #065f46; font-weight: 600; margin-bottom: 8px;">TOTAL ENTRIES</div>
        <div style="font-size: 32px; font-weight: 700; color: #065f46;">@entries.Count</div>
        <div style="font-size: 12px; color: #065f46; margin-top: 4px;">Cash flow transactions</div>
    </div>
    <div style="background: linear-gradient(135deg, #e0f2fe, #bfdbfe); border-radius: 16px; padding: 24px; border: 2px solid #60a5fa;">
        <div style="font-size: 13px; color: #1e40af; font-weight: 600; margin-bottom: 8px;">TOTAL INFLOW</div>
        <div style="font-size: 32px; font-weight: 700; color: #1e40af;">₱@totalInflow.ToString("N2")</div>
        <div style="font-size: 12px; color: #1e40af; margin-top: 4px;">Cash received</div>
    </div>
    <div style="background: linear-gradient(135deg, #fee2e2, #fecaca); border-radius: 16px; padding: 24px; border: 2px solid #f87171;">
        <div style="font-size: 13px; color: #991b1b; font-weight: 600; margin-bottom: 8px;">TOTAL OUTFLOW</div>
        <div style="font-size: 32px; font-weight: 700; color: #991b1b;">₱@totalOutflow.ToString("N2")</div>
        <div style="font-size: 12px; color: #991b1b; margin-top: 4px;">Cash paid out</div>
    </div>
    <div style="background: linear-gradient(135deg, #dbeafe, #bfdbfe); border-radius: 16px; padding: 24px; border: 2px solid #60a5fa;">
        <div style="font-size: 13px; color: #1e40af; font-weight: 600; margin-bottom: 8px;">NET CASH FLOW</div>
        <div style="font-size: 32px; font-weight: 700; color: @(netCashflow >= 0 ? "#1e40af" : "#b91c1c");">₱@netCashflow.ToString("N2")</div>
        <div style="font-size: 12px; color: #1e40af; margin-top: 4px;">Inflow minus outflow</div>
    </div>
</div>

<!-- Cash Flow Entries Report -->
<div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
    <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 20px;">Cash Flow Entries Report</h3>

    <table style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr style="border-bottom: 2px solid #e5e7eb; background: #f9fafb;">
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">DATE</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">TYPE</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">CATEGORY</th>
                <th style="padding: 12px; text-align: right; font-size: 12px; font-weight: 700;">AMOUNT</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">DESCRIPTION</th>
                <th style="padding: 12px; text-align: center; font-size: 12px; font-weight: 700;">ACTIONS</th>
            </tr>
        </thead>
        <tbody>
            @if (entries == null || entries.Count == 0)
            {
                <tr>
                    <td colspan="6" style="padding: 16px; text-align: center; color: #6b7280; font-size: 14px;">No cash flow entries found.</td>
                </tr>
            }
            else
            {
                @foreach (var e in entries.OrderByDescending(x => x.TransactionDate))
                {
                    var isInflow = string.Equals(e.EntryType, "Inflow", StringComparison.OrdinalIgnoreCase);
                    <tr style="border-bottom: 1px solid #e5e7eb; transition: background 0.2s;">
                        <td style="padding: 16px; font-size: 14px;">@e.TransactionDate.ToString("MMM dd, yyyy")</td>
                        <td style="padding: 16px; font-size: 13px; font-weight: 600; color: @(isInflow ? "#16a34a" : "#b91c1c");">@e.EntryType</td>
                        <td style="padding: 16px; font-size: 13px;">@e.Category</td>
                        <td style="padding: 16px; text-align: right; font-size: 14px; font-weight: 700; color: @(isInflow ? "#16a34a" : "#b91c1c");">₱@e.Amount.ToString("N2")</td>
                        <td style="padding: 16px; font-size: 13px; color: #6b7280; max-width: 280px;">@e.Description</td>
                        <td style="padding: 16px; text-align: center;">
                            <button class="btn" style="background: white; border: 2px solid #e5e7eb; color: #374151; padding: 6px 12px; font-size: 13px; margin-right: 4px;" @onclick='() => ViewEntryDetails(e)'>View</button>
                            <button class="btn" style="background: white; border: 2px solid #e5e7eb; color: #374151; padding: 6px 12px; font-size: 13px; margin-right: 4px;" @onclick='() => EditEntry(e)'>Edit</button>
                            <button class="btn" style="background: white; border: 2px solid #e5e7eb; color: #374151; padding: 6px 12px; font-size: 13px;" @onclick='() => DeleteEntry(e.CashflowId)'>Delete</button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- View Entry Details Modal -->
<div style="display: @(showDetailsModal ? "flex" : "none"); position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000;">
    <div style="background: white; border-radius: 16px; padding: 32px; max-width: 520px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
        <h2 style="font-size: 20px; font-weight: 700; margin: 0 0 24px 0;">Entry Details</h2>

        @if (selectedEntry != null)
        {
            var isInflow = string.Equals(selectedEntry.EntryType, "Inflow", StringComparison.OrdinalIgnoreCase);
            <div style="display: grid; grid-template-columns: 1fr; gap: 12px; font-size: 14px; color: #374151; margin-bottom: 24px;">
                <div style="display: grid; grid-template-columns: auto 1fr; gap: 8px;"><strong>Date:</strong> <span>@selectedEntry.TransactionDate.ToString("yyyy-MM-dd")</span></div>
                <div style="display: grid; grid-template-columns: auto 1fr; gap: 8px;"><strong>Type:</strong> <span style="color: @(isInflow ? "#16a34a" : "#b91c1c"); font-weight: 600;">@selectedEntry.EntryType</span></div>
                <div style="display: grid; grid-template-columns: auto 1fr; gap: 8px;"><strong>Category:</strong> <span>@selectedEntry.Category</span></div>
                <div style="display: grid; grid-template-columns: auto 1fr; gap: 8px;"><strong>Amount:</strong> <span style="font-weight: 700;">₱@selectedEntry.Amount.ToString("N2")</span></div>
                <div style="display: grid; grid-template-columns: auto 1fr; gap: 8px;"><strong>Description:</strong> <span>@selectedEntry.Description</span></div>
            </div>
        }

        <div style="display: flex; justify-content: flex-end;">
            <button class="btn" style="background: #e5e7eb; color: #374151; padding: 8px 18px; font-weight: 600;" @onclick="CloseDetailsModal">Close</button>
        </div>
    </div>
</div>

<!-- Edit Entry Modal -->
<div style="display: @(showEditModal ? "flex" : "none"); position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000;">
    <div style="background: white; border-radius: 16px; padding: 32px; max-width: 520px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
        <h2 style="font-size: 20px; font-weight: 700; margin: 0 0 24px 0;">Edit Entry</h2>

        @if (editingEntry != null)
        {
            <div style="display: grid; grid-template-columns: 1fr; gap: 12px; margin-bottom: 24px;">
                <div class="form-group">
                    <label class="form-label">Entry Type</label>
                    <select class="form-control" @bind="editingEntry.EntryType">
                        <option value="Inflow">Inflow</option>
                        <option value="Outflow">Outflow</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Category</label>
                    <input type="text" class="form-control" @bind="editingEntry.Category" />
                </div>
                <div class="form-group">
                    <label class="form-label">Amount</label>
                    <input type="number" class="form-control" @bind-value="editingEntry.Amount" step="0.01" />
                </div>
                <div class="form-group">
                    <label class="form-label">Transaction Date</label>
                    <input type="date" class="form-control" @bind="editingEntry.TransactionDate" />
                </div>
                <div class="form-group">
                    <label class="form-label">Description</label>
                    <textarea class="form-control" @bind="editingEntry.Description" style="min-height: 80px;"></textarea>
                </div>
            </div>
        }

        <div style="display: flex; gap: 12px; justify-content: flex-end;">
            <button class="btn" style="background: #e5e7eb; color: #374151; padding: 10px 20px; font-weight: 600;" @onclick="CloseEditModal">Cancel</button>
            <button class="btn" style="background: #f59e0b; color: white; padding: 10px 20px; font-weight: 600;" @onclick="SaveEntryChanges">Save Changes</button>
        </div>
    </div>
</div>

@code {
    private List<CashflowEntry> entries = new();
    private bool showDetailsModal = false;
    private bool showEditModal = false;
    private CashflowEntry? selectedEntry;
    private CashflowEntry? editingEntry;

    private decimal totalInflow;
    private decimal totalOutflow;
    private decimal netCashflow;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            entries = await CashflowAnalysisService.GetAllAsync();
            CalculateSummary();
        }
        catch
        {
        }
    }

    private void CalculateSummary()
    {
        totalInflow = entries
            .Where(e => string.Equals(e.EntryType, "Inflow", StringComparison.OrdinalIgnoreCase))
            .Sum(e => e.Amount);
        totalOutflow = entries
            .Where(e => string.Equals(e.EntryType, "Outflow", StringComparison.OrdinalIgnoreCase))
            .Sum(e => e.Amount);
        netCashflow = totalInflow - totalOutflow;
    }

    private void ViewEntryDetails(CashflowEntry entry)
    {
        selectedEntry = entry;
        showDetailsModal = true;
    }

    private void CloseDetailsModal()
    {
        showDetailsModal = false;
        selectedEntry = null;
    }

    private void EditEntry(CashflowEntry entry)
    {
        editingEntry = new CashflowEntry
        {
            CashflowId = entry.CashflowId,
            EntryType = entry.EntryType,
            Category = entry.Category,
            Amount = entry.Amount,
            TransactionDate = entry.TransactionDate,
            Description = entry.Description
        };
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        editingEntry = null;
    }

    private async Task SaveEntryChanges()
    {
        if (editingEntry != null)
        {
            try
            {
                await CashflowAnalysisService.UpdateAsync(editingEntry);
                entries = await CashflowAnalysisService.GetAllAsync();
                CalculateSummary();
                showEditModal = false;
                editingEntry = null;
            }
            catch
            {
            }
        }
    }

    private async Task DeleteEntry(int entryId)
    {
        try
        {
            var ok = await CashflowAnalysisService.DeleteAsync(entryId);
            if (ok)
            {
                entries = await CashflowAnalysisService.GetAllAsync();
                CalculateSummary();
            }
        }
        catch
        {
        }
    }
}
