@page "/admin/finance-mgr/cashflow-reports"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@using Microsoft.EntityFrameworkCore
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IDbContextFactory<BFASDbContext> DbContextFactory

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #0891b2 0%, #0e7490 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; justify-content: space-between;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                    <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                </svg>
            </div>
            <div>
                <h1 style="font-size: 28px; font-weight: 700; color: white; margin: 0;">Cashflow Reports (Admin)</h1>
                <p style="color: rgba(255,255,255,0.8); margin: 4px 0 0 0;">Monitor cash inflows, outflows, and liquidity</p>
            </div>
        </div>
        <div style="background: rgba(255,255,255,0.2); padding: 10px 16px; border-radius: 8px;">
            <span style="font-size: 13px; color: white;">🔐 Admin Mode</span>
        </div>
    </div>
</div>

<!-- Admin Notice -->
<div style="background: #fef3c7; border: 1px solid #f59e0b; border-radius: 12px; padding: 16px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 12px;">
        <span style="font-size: 24px;">📊</span>
        <div>
            <p style="margin: 0; font-weight: 600; color: #92400e;">Administrative Cashflow Reports Access</p>
            <p style="margin: 4px 0 0; font-size: 13px; color: #b45309;">All actions are logged for audit purposes.</p>
        </div>
    </div>
</div>

<!-- Report Filters -->
<div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb; margin-bottom: 24px;">
    <div style="display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-end;">
        <div style="flex: 1; min-width: 150px;">
            <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Period</label>
            <select @bind="selectedPeriod" style="width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px;">
                <option value="daily">Daily</option>
                <option value="weekly">Weekly</option>
                <option value="monthly">Monthly</option>
                <option value="quarterly">Quarterly</option>
            </select>
        </div>
        <div style="flex: 1; min-width: 150px;">
            <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">From Date</label>
            <input type="date" @bind="fromDate" style="width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px;" />
        </div>
        <div style="flex: 1; min-width: 150px;">
            <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">To Date</label>
            <input type="date" @bind="toDate" style="width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px;" />
        </div>
        <div style="display: flex; gap: 8px;">
            <button @onclick="GenerateReport" style="background: linear-gradient(135deg, #0891b2, #0e7490); color: white; padding: 10px 20px; border: none; border-radius: 8px; font-weight: 600; cursor: pointer;">
                Generate
            </button>
            <button @onclick="ExportReport" style="background: white; color: #0891b2; padding: 10px 20px; border: 2px solid #0891b2; border-radius: 8px; font-weight: 600; cursor: pointer;">
                Export
            </button>
        </div>
    </div>
</div>

<!-- Summary Stats -->
<div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 24px;">
    <div style="background: white; border-radius: 16px; padding: 20px; text-align: center; border: 2px solid #6ee7b7;">
        <div style="font-size: 12px; color: #047857; font-weight: 600; margin-bottom: 8px;">CASH INFLOWS</div>
        <div style="font-size: 24px; font-weight: 700; color: #047857;">₱@totalInflows.ToString("N2")</div>
    </div>
    <div style="background: white; border-radius: 16px; padding: 20px; text-align: center; border: 2px solid #fca5a5;">
        <div style="font-size: 12px; color: #dc2626; font-weight: 600; margin-bottom: 8px;">CASH OUTFLOWS</div>
        <div style="font-size: 24px; font-weight: 700; color: #dc2626;">₱@totalOutflows.ToString("N2")</div>
    </div>
    <div style="background: white; border-radius: 16px; padding: 20px; text-align: center; border: 2px solid #93c5fd;">
        <div style="font-size: 12px; color: #1e40af; font-weight: 600; margin-bottom: 8px;">NET CASHFLOW</div>
        <div style="font-size: 24px; font-weight: 700; color: #1e40af;">₱@netCashflow.ToString("N2")</div>
    </div>
    <div style="background: white; border-radius: 16px; padding: 20px; text-align: center; border: 2px solid #a5f3fc;">
        <div style="font-size: 12px; color: #0891b2; font-weight: 600; margin-bottom: 8px;">LIQUIDITY RATIO</div>
        <div style="font-size: 24px; font-weight: 700; color: #0891b2;">@liquidityRatio</div>
    </div>
</div>

<!-- Cashflow Details -->
<div style="background: white; border-radius: 16px; border: 1px solid #e5e7eb; overflow: hidden;">
    <div style="background: linear-gradient(135deg, #0891b2, #0e7490); padding: 16px 24px;">
        <h3 style="font-size: 16px; font-weight: 700; color: white; margin: 0;">Cashflow Statement</h3>
    </div>
    <div style="padding: 24px;">
        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background: #f9fafb; border-bottom: 2px solid #e5e7eb;">
                    <th style="padding: 12px; text-align: left; font-size: 13px; font-weight: 600; color: #374151;">Date</th>
                    <th style="padding: 12px; text-align: left; font-size: 13px; font-weight: 600; color: #374151;">Description</th>
                    <th style="padding: 12px; text-align: right; font-size: 13px; font-weight: 600; color: #374151;">Inflow</th>
                    <th style="padding: 12px; text-align: right; font-size: 13px; font-weight: 600; color: #374151;">Outflow</th>
                    <th style="padding: 12px; text-align: right; font-size: 13px; font-weight: 600; color: #374151;">Balance</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in cashflowItems)
                {
                    <tr style="border-bottom: 1px solid #e5e7eb;">
                        <td style="padding: 12px; font-size: 14px; color: #6b7280;">@item.Date.ToString("MMM dd")</td>
                        <td style="padding: 12px; font-size: 14px; color: #111827; font-weight: 500;">@item.Description</td>
                        <td style="padding: 12px; text-align: right; font-size: 14px; color: #10b981;">@(item.Inflow > 0 ? $"₱{item.Inflow:N2}" : "-")</td>
                        <td style="padding: 12px; text-align: right; font-size: 14px; color: #ef4444;">@(item.Outflow > 0 ? $"₱{item.Outflow:N2}" : "-")</td>
                        <td style="padding: 12px; text-align: right; font-size: 14px; font-weight: 700; color: #0891b2;">₱@item.Balance.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private string selectedPeriod = "monthly";
    private DateTime fromDate = DateTime.Now.AddMonths(-1);
    private DateTime toDate = DateTime.Now;
    private bool isLoading = true;

    private decimal totalInflows = 0;
    private decimal totalOutflows = 0;
    private decimal netCashflow = 0;
    private string liquidityRatio = "0.00";

    private List<CashflowItem> cashflowItems = new();

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }
        await LoadCashflowData();
    }

    private async Task LoadCashflowData()
    {
        isLoading = true;
        try
        {
            using var context = await DbContextFactory.CreateDbContextAsync();
            
            // Get deposits (inflows)
            var deposits = await context.CustomerTransactions
                .Where(t => t.TransactionType == "Deposit" && t.CreatedAt >= fromDate && t.CreatedAt <= toDate && t.Status == "Completed")
                .ToListAsync();
            var totalDeposits = deposits.Sum(t => t.Amount);
            
            // Get loan payments (inflows)
            var loanPayments = await context.LoanPayments
                .Where(p => p.PaymentDate >= fromDate && p.PaymentDate <= toDate)
                .ToListAsync();
            var totalLoanPayments = loanPayments.Sum(p => p.PaymentAmount);
            
            // Get withdrawals (outflows)
            var withdrawals = await context.CustomerTransactions
                .Where(t => t.TransactionType == "Withdrawal" && t.CreatedAt >= fromDate && t.CreatedAt <= toDate && t.Status == "Completed")
                .ToListAsync();
            var totalWithdrawals = withdrawals.Sum(t => t.Amount);
            
            // Get loan disbursements (outflows)
            var disbursements = await context.LoanDisbursals
                .Where(d => d.DisbursalDate >= fromDate && d.DisbursalDate <= toDate)
                .ToListAsync();
            var totalDisbursements = disbursements.Sum(d => d.DisbursalAmount);
            
            // Calculate totals
            totalInflows = totalDeposits + totalLoanPayments;
            totalOutflows = totalWithdrawals + totalDisbursements;
            netCashflow = totalInflows - totalOutflows;
            
            // Calculate liquidity ratio
            var totalAssets = await context.CustomerAccounts.SumAsync(a => (decimal?)a.Balance) ?? 0;
            var totalLoans = await context.LoanAssessments
                .Where(l => l.AssessmentStatus == "FORWARDED" || l.AssessmentStatus == "ASSESSED")
                .SumAsync(l => (decimal?)l.LoanAmount) ?? 0;
            liquidityRatio = totalLoans > 0 ? (totalAssets / totalLoans).ToString("F2") : "N/A";
            
            // Build cashflow items
            cashflowItems = new List<CashflowItem>();
            decimal runningBalance = 0;
            
            if (deposits.Any())
            {
                runningBalance += totalDeposits;
                cashflowItems.Add(new CashflowItem 
                { 
                    Date = DateTime.Now, 
                    Description = "Customer Deposits", 
                    Inflow = totalDeposits, 
                    Outflow = 0, 
                    Balance = runningBalance 
                });
            }
            
            if (loanPayments.Any())
            {
                runningBalance += totalLoanPayments;
                cashflowItems.Add(new CashflowItem 
                { 
                    Date = DateTime.Now, 
                    Description = "Loan Repayments", 
                    Inflow = totalLoanPayments, 
                    Outflow = 0, 
                    Balance = runningBalance 
                });
            }
            
            if (withdrawals.Any())
            {
                runningBalance -= totalWithdrawals;
                cashflowItems.Add(new CashflowItem 
                { 
                    Date = DateTime.Now, 
                    Description = "Customer Withdrawals", 
                    Inflow = 0, 
                    Outflow = totalWithdrawals, 
                    Balance = runningBalance 
                });
            }
            
            if (disbursements.Any())
            {
                runningBalance -= totalDisbursements;
                cashflowItems.Add(new CashflowItem 
                { 
                    Date = DateTime.Now, 
                    Description = "Loan Disbursements", 
                    Inflow = 0, 
                    Outflow = totalDisbursements, 
                    Balance = runningBalance 
                });
            }
            
            // Add fee income
            var feeIncome = deposits.Sum(t => t.Fee) + withdrawals.Sum(t => t.Fee);
            if (feeIncome > 0)
            {
                runningBalance += feeIncome;
                cashflowItems.Add(new CashflowItem 
                { 
                    Date = DateTime.Now, 
                    Description = "Transaction Fees", 
                    Inflow = feeIncome, 
                    Outflow = 0, 
                    Balance = runningBalance 
                });
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading cashflow data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task GenerateReport() 
    { 
        await LoadCashflowData();
    }
    
    private void ExportReport() { }

    private class CashflowItem
    {
        public DateTime Date { get; set; }
        public string Description { get; set; } = "";
        public decimal Inflow { get; set; }
        public decimal Outflow { get; set; }
        public decimal Balance { get; set; }
    }
}
