@page "/admin/finance-mgr/budget-reports"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@using Microsoft.EntityFrameworkCore
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IDbContextFactory<BFASDbContext> DbContextFactory

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                </svg>
            </div>
            <div>
                <h1 style="font-size: 28px; font-weight: 700; color: white; margin: 0;">Budget Reports (Admin)</h1>
                <p style="color: rgba(255,255,255,0.8); margin: 4px 0 0 0;">Generate and download budget vs actual analysis reports</p>
            </div>
        </div>
        <div style="background: rgba(255,255,255,0.2); padding: 10px 16px; border-radius: 8px;">
            <span style="font-size: 13px; color: white;">🔐 Admin Mode</span>
        </div>
    </div>
</div>

<!-- Admin Notice -->
<div style="background: #fef3c7; border: 1px solid #f59e0b; border-radius: 12px; padding: 16px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 12px;">
        <span style="font-size: 24px;">📊</span>
        <div>
            <p style="margin: 0; font-weight: 600; color: #92400e;">Administrative Budget Reports Access</p>
            <p style="margin: 4px 0 0; font-size: 13px; color: #b45309;">All actions are logged for audit purposes.</p>
        </div>
    </div>
</div>

<!-- Report Configuration -->
<div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb; margin-bottom: 24px;">
    <h2 style="font-size: 18px; font-weight: 700; color: #111827; margin: 0 0 20px 0;">📊 Report Configuration</h2>
    
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 24px;">
        <div>
            <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Report Period</label>
            <select @bind="reportPeriod" style="width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px;">
                <option value="month">Current Month</option>
                <option value="quarter">Current Quarter</option>
                <option value="year">Current Year</option>
            </select>
        </div>
        <div>
            <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Department</label>
            <select @bind="selectedDepartment" style="width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px;">
                <option value="">All Departments</option>
                <option value="operations">Operations</option>
                <option value="hr">Human Resources</option>
                <option value="it">IT</option>
            </select>
        </div>
        <div>
            <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Format</label>
            <select @bind="reportFormat" style="width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px;">
                <option value="pdf">PDF</option>
                <option value="csv">CSV</option>
            </select>
        </div>
    </div>

    <div style="display: flex; gap: 12px;">
        <button @onclick="GenerateReport" style="padding: 12px 24px; background: linear-gradient(135deg, #f59e0b, #d97706); color: white; border: none; border-radius: 10px; font-weight: 600; cursor: pointer;">
            📥 Generate & Download
        </button>
        <button style="padding: 12px 24px; background: #f3f4f6; color: #374151; border: none; border-radius: 10px; font-weight: 600; cursor: pointer;">
            👁️ Preview
        </button>
    </div>
</div>

<!-- Summary Cards -->
<div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px;">
    <div style="background: #f0fdf4; border-radius: 12px; padding: 20px; text-align: center; border: 2px solid #6ee7b7;">
        <div style="font-size: 12px; color: #047857; font-weight: 600; margin-bottom: 8px;">TOTAL ALLOCATED</div>
        <div style="font-size: 24px; font-weight: 700; color: #047857;">₱@totalAllocated.ToString("N2")</div>
    </div>
    <div style="background: #dbeafe; border-radius: 12px; padding: 20px; text-align: center; border: 2px solid #93c5fd;">
        <div style="font-size: 12px; color: #1e40af; font-weight: 600; margin-bottom: 8px;">TOTAL SPENT</div>
        <div style="font-size: 24px; font-weight: 700; color: #1e40af;">₱@totalSpent.ToString("N2")</div>
    </div>
    <div style="background: #fef3c7; border-radius: 12px; padding: 20px; text-align: center; border: 2px solid #fcd34d;">
        <div style="font-size: 12px; color: #92400e; font-weight: 600; margin-bottom: 8px;">REMAINING</div>
        <div style="font-size: 24px; font-weight: 700; color: #92400e;">₱@remaining.ToString("N2")</div>
    </div>
    <div style="background: #ede9fe; border-radius: 12px; padding: 20px; text-align: center; border: 2px solid #c4b5fd;">
        <div style="font-size: 12px; color: #7c3aed; font-weight: 600; margin-bottom: 8px;">UTILIZATION</div>
        <div style="font-size: 24px; font-weight: 700; color: #7c3aed;">@utilization%</div>
    </div>
</div>

<!-- Budget Details -->
<div style="background: white; border-radius: 16px; border: 1px solid #e5e7eb; overflow: hidden;">
    <div style="background: linear-gradient(135deg, #f59e0b, #d97706); padding: 16px 24px;">
        <h3 style="font-size: 16px; font-weight: 700; color: white; margin: 0;">Budget vs Actual</h3>
    </div>
    <div style="padding: 24px;">
        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background: #f9fafb; border-bottom: 2px solid #e5e7eb;">
                    <th style="padding: 12px; text-align: left; font-size: 13px; font-weight: 600; color: #374151;">Department</th>
                    <th style="padding: 12px; text-align: right; font-size: 13px; font-weight: 600; color: #374151;">Allocated</th>
                    <th style="padding: 12px; text-align: right; font-size: 13px; font-weight: 600; color: #374151;">Spent</th>
                    <th style="padding: 12px; text-align: right; font-size: 13px; font-weight: 600; color: #374151;">Remaining</th>
                    <th style="padding: 12px; text-align: center; font-size: 13px; font-weight: 600; color: #374151;">%</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in budgetItems)
                {
                    <tr style="border-bottom: 1px solid #e5e7eb;">
                        <td style="padding: 12px; font-size: 14px; color: #111827; font-weight: 600;">@item.Department</td>
                        <td style="padding: 12px; text-align: right; font-size: 14px; color: #047857;">₱@item.Allocated.ToString("N2")</td>
                        <td style="padding: 12px; text-align: right; font-size: 14px; color: #1e40af;">₱@item.Spent.ToString("N2")</td>
                        <td style="padding: 12px; text-align: right; font-size: 14px; color: #92400e;">₱@item.Remaining.ToString("N2")</td>
                        <td style="padding: 12px; text-align: center;">
                            <span style="padding: 4px 12px; border-radius: 6px; font-size: 13px; font-weight: 600; background: @(item.Percentage > 90 ? "#fee2e2" : "#dcfce7"); color: @(item.Percentage > 90 ? "#dc2626" : "#047857");">
                                @item.Percentage%
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private string reportPeriod = "month";
    private string selectedDepartment = "";
    private string reportFormat = "pdf";
    private bool isLoading = true;
    
    private decimal totalAllocated = 0;
    private decimal totalSpent = 0;
    private decimal remaining = 0;
    private int utilization = 0;

    private List<BudgetItem> budgetItems = new();

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }
        await LoadBudgetData();
    }

    private async Task LoadBudgetData()
    {
        isLoading = true;
        try
        {
            using var context = await DbContextFactory.CreateDbContextAsync();
            
            // Get budgets from database
            var budgets = await context.Budgets.ToListAsync();
            
            if (budgets.Any())
            {
                totalAllocated = budgets.Sum(b => b.AllocatedAmount);
                totalSpent = budgets.Sum(b => b.SpentAmount);
                remaining = totalAllocated - totalSpent;
                utilization = totalAllocated > 0 ? (int)((totalSpent / totalAllocated) * 100) : 0;
                
                budgetItems = budgets
                    .GroupBy(b => b.Department)
                    .Select(g => new BudgetItem
                    {
                        Department = g.Key,
                        Allocated = g.Sum(b => b.AllocatedAmount),
                        Spent = g.Sum(b => b.SpentAmount),
                        Remaining = g.Sum(b => b.AllocatedAmount) - g.Sum(b => b.SpentAmount),
                        Percentage = g.Sum(b => b.AllocatedAmount) > 0 
                            ? (int)((g.Sum(b => b.SpentAmount) / g.Sum(b => b.AllocatedAmount)) * 100) 
                            : 0
                    })
                    .OrderByDescending(b => b.Allocated)
                    .ToList();
            }
            else
            {
                // If no budgets exist, show departments with estimated allocations based on transactions
                var employees = await context.Employees
                    .GroupBy(e => e.Department)
                    .Select(g => new { Department = g.Key, Count = g.Count() })
                    .ToListAsync();
                
                budgetItems = employees.Select(e => new BudgetItem
                {
                    Department = e.Department,
                    Allocated = 500000, // Default allocation
                    Spent = 0,
                    Remaining = 500000,
                    Percentage = 0
                }).ToList();
                
                totalAllocated = budgetItems.Sum(b => b.Allocated);
                totalSpent = 0;
                remaining = totalAllocated;
                utilization = 0;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading budget data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task GenerateReport() 
    { 
        await LoadBudgetData();
    }

    private class BudgetItem
    {
        public string Department { get; set; } = "";
        public decimal Allocated { get; set; }
        public decimal Spent { get; set; }
        public decimal Remaining { get; set; }
        public int Percentage { get; set; }
    }
}
