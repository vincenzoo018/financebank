@page "/admin/finance-mgr/budget-reports"
@layout AdminLayout
@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="admin-page finance-mgr-page">
    <div class="page-header">
        <h1>
            <span class="role-badge finance">Finance Mgr</span>
            Budget Reports
        </h1>
        <p class="page-subtitle">View comprehensive budget analysis and reports</p>
    </div>

    <!-- Admin Action Reason -->
    <div class="admin-action-card">
        <div class="alert alert-warning">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 24px; height: 24px;">
                <path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
            <span>You are accessing Finance Manager functions as SuperAdmin. All actions are logged.</span>
        </div>
        <div class="form-group">
            <label for="adminReason">Reason for Admin Action (Required)</label>
            <textarea id="adminReason" @bind="adminActionReason" class="form-control" 
                placeholder="Document why you are performing this action as admin..." rows="2"></textarea>
        </div>
    </div>

    <div class="report-controls" style="margin-top: 24px;">
        <div class="control-group">
            <label>Report Period</label>
            <select class="form-select" @bind="selectedPeriod">
                <option value="monthly">Monthly</option>
                <option value="quarterly">Quarterly</option>
                <option value="yearly">Yearly</option>
            </select>
        </div>
        <div class="control-group">
            <label>Year</label>
            <select class="form-select" @bind="selectedYear">
                <option value="2024">2024</option>
                <option value="2023">2023</option>
                <option value="2022">2022</option>
            </select>
        </div>
        <div class="control-group">
            <label>Department</label>
            <select class="form-select" @bind="selectedDepartment">
                <option value="">All Departments</option>
                <option value="operations">Operations</option>
                <option value="hr">Human Resources</option>
                <option value="it">Information Technology</option>
                <option value="finance">Finance</option>
            </select>
        </div>
        <button class="btn btn-primary" @onclick="GenerateReport">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 16px; height: 16px;">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
            Generate Report
        </button>
        <button class="btn btn-outline" @onclick="ExportReport">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 16px; height: 16px;">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Export
        </button>
    </div>

    <div class="budget-overview" style="margin-top: 24px;">
        <div class="overview-card">
            <h4>Total Budget</h4>
            <div class="amount">₱@totalBudget.ToString("N0")</div>
            <div class="label">Annual Allocation</div>
        </div>
        <div class="overview-card">
            <h4>Utilized</h4>
            <div class="amount used">₱@utilized.ToString("N0")</div>
            <div class="label">@utilizationPercentage% of Budget</div>
        </div>
        <div class="overview-card">
            <h4>Remaining</h4>
            <div class="amount remaining">₱@remaining.ToString("N0")</div>
            <div class="label">Available Funds</div>
        </div>
        <div class="overview-card">
            <h4>Variance</h4>
            <div class="amount @(variance >= 0 ? "positive" : "negative")">
                @(variance >= 0 ? "+" : "")₱@variance.ToString("N0")
            </div>
            <div class="label">vs. Projected</div>
        </div>
    </div>

    <div class="admin-card" style="margin-top: 24px;">
        <div class="card-header">
            <h3>Budget vs Actual by Department</h3>
        </div>
        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Department</th>
                        <th>Budget</th>
                        <th>Actual</th>
                        <th>Variance</th>
                        <th>% Used</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dept in departmentBudgets)
                    {
                        <tr>
                            <td><strong>@dept.Department</strong></td>
                            <td>₱@dept.Budget.ToString("N0")</td>
                            <td>₱@dept.Actual.ToString("N0")</td>
                            <td class="@(dept.Variance >= 0 ? "text-success" : "text-danger")">
                                @(dept.Variance >= 0 ? "+" : "")₱@dept.Variance.ToString("N0")
                            </td>
                            <td>
                                <div class="progress-bar">
                                    <div class="progress-fill @GetProgressClass(dept.PercentUsed)" style="width: @Math.Min(dept.PercentUsed, 100)%;"></div>
                                </div>
                                <span class="percent-label">@dept.PercentUsed%</span>
                            </td>
                            <td>
                                <span class="badge @GetStatusBadge(dept.PercentUsed)">@GetStatusText(dept.PercentUsed)</span>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="total-row">
                        <td><strong>TOTAL</strong></td>
                        <td><strong>₱@departmentBudgets.Sum(d => d.Budget).ToString("N0")</strong></td>
                        <td><strong>₱@departmentBudgets.Sum(d => d.Actual).ToString("N0")</strong></td>
                        <td class="@(departmentBudgets.Sum(d => d.Variance) >= 0 ? "text-success" : "text-danger")">
                            <strong>@(departmentBudgets.Sum(d => d.Variance) >= 0 ? "+" : "")₱@departmentBudgets.Sum(d => d.Variance).ToString("N0")</strong>
                        </td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="reports-grid" style="margin-top: 24px;">
        <div class="admin-card">
            <div class="card-header">
                <h3>Monthly Trend</h3>
            </div>
            <div class="card-body">
                <div class="trend-chart">
                    @foreach (var month in monthlyTrend)
                    {
                        <div class="trend-bar">
                            <div class="bar-budget" style="height: @(month.Budget / 10000)px;" title="Budget: ₱@month.Budget.ToString("N0")"></div>
                            <div class="bar-actual" style="height: @(month.Actual / 10000)px;" title="Actual: ₱@month.Actual.ToString("N0")"></div>
                            <span class="month-label">@month.Month</span>
                        </div>
                    }
                </div>
                <div class="chart-legend">
                    <span class="legend-item"><span class="legend-color budget"></span> Budget</span>
                    <span class="legend-item"><span class="legend-color actual"></span> Actual</span>
                </div>
            </div>
        </div>

        <div class="admin-card">
            <div class="card-header">
                <h3>Budget Alerts</h3>
            </div>
            <div class="card-body">
                <div class="alerts-list">
                    @foreach (var alert in budgetAlerts)
                    {
                        <div class="alert-item @alert.Severity">
                            <div class="alert-icon">
                                @if (alert.Severity == "critical")
                                {
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 20px; height: 20px;">
                                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                                        <line x1="12" y1="9" x2="12" y2="13"></line>
                                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                    </svg>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 20px; height: 20px;">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <line x1="12" y1="8" x2="12" y2="12"></line>
                                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                    </svg>
                                }
                            </div>
                            <div class="alert-content">
                                <strong>@alert.Title</strong>
                                <p>@alert.Message</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .finance-mgr-page .role-badge.finance {
        background: linear-gradient(135deg, #f59e0b, #d97706);
    }
    .report-controls {
        display: flex;
        gap: 16px;
        align-items: flex-end;
        background: white;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }
    .control-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }
    .control-group label {
        font-size: 0.85em;
        color: #6b7280;
    }
    .budget-overview {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
    }
    .overview-card {
        background: white;
        padding: 24px;
        border-radius: 12px;
        text-align: center;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }
    .overview-card h4 {
        font-size: 0.9em;
        color: #6b7280;
        margin-bottom: 8px;
    }
    .overview-card .amount {
        font-size: 1.8em;
        font-weight: 700;
        color: #1f2937;
    }
    .overview-card .amount.used { color: #3b82f6; }
    .overview-card .amount.remaining { color: #10b981; }
    .overview-card .amount.positive { color: #10b981; }
    .overview-card .amount.negative { color: #ef4444; }
    .overview-card .label {
        font-size: 0.85em;
        color: #9ca3af;
        margin-top: 4px;
    }
    .progress-bar {
        width: 100px;
        height: 8px;
        background: #e5e7eb;
        border-radius: 4px;
        overflow: hidden;
        display: inline-block;
        vertical-align: middle;
    }
    .progress-fill {
        height: 100%;
        border-radius: 4px;
    }
    .progress-fill.safe { background: #10b981; }
    .progress-fill.warning { background: #f59e0b; }
    .progress-fill.danger { background: #ef4444; }
    .percent-label {
        font-size: 0.85em;
        margin-left: 8px;
    }
    .text-success { color: #10b981; }
    .text-danger { color: #ef4444; }
    .total-row {
        background: #f8fafc;
    }
    .reports-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }
    .trend-chart {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        height: 200px;
        padding: 20px 0;
    }
    .trend-bar {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
    }
    .bar-budget, .bar-actual {
        width: 20px;
        border-radius: 4px 4px 0 0;
    }
    .bar-budget { background: #e0e7ff; }
    .bar-actual { background: #3b82f6; }
    .month-label {
        font-size: 0.75em;
        color: #6b7280;
    }
    .chart-legend {
        display: flex;
        justify-content: center;
        gap: 24px;
        margin-top: 16px;
    }
    .legend-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.85em;
    }
    .legend-color {
        width: 16px;
        height: 16px;
        border-radius: 4px;
    }
    .legend-color.budget { background: #e0e7ff; }
    .legend-color.actual { background: #3b82f6; }
    .alerts-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .alert-item {
        display: flex;
        gap: 12px;
        padding: 12px;
        border-radius: 8px;
    }
    .alert-item.critical {
        background: #fee2e2;
    }
    .alert-item.warning {
        background: #fef3c7;
    }
    .alert-item .alert-icon {
        color: currentColor;
    }
    .alert-item.critical .alert-icon { color: #dc2626; }
    .alert-item.warning .alert-icon { color: #d97706; }
    .alert-content strong {
        display: block;
        margin-bottom: 4px;
    }
    .alert-content p {
        font-size: 0.85em;
        color: #6b7280;
        margin: 0;
    }
</style>

@code {
    private string adminActionReason = "";
    private string selectedPeriod = "monthly";
    private string selectedYear = "2024";
    private string selectedDepartment = "";

    private decimal totalBudget = 12000000;
    private decimal utilized = 8500000;
    private decimal remaining = 3500000;
    private decimal variance = 250000;
    private int utilizationPercentage = 71;

    private List<DepartmentBudget> departmentBudgets = new()
    {
        new() { Department = "Operations", Budget = 3500000, Actual = 3200000, Variance = 300000, PercentUsed = 91 },
        new() { Department = "Human Resources", Budget = 4000000, Actual = 3800000, Variance = 200000, PercentUsed = 95 },
        new() { Department = "Information Technology", Budget = 2500000, Actual = 2700000, Variance = -200000, PercentUsed = 108 },
        new() { Department = "Finance", Budget = 1500000, Actual = 1350000, Variance = 150000, PercentUsed = 90 },
        new() { Department = "Marketing", Budget = 500000, Actual = 450000, Variance = 50000, PercentUsed = 90 }
    };

    private List<MonthlyData> monthlyTrend = new()
    {
        new() { Month = "Jan", Budget = 1000000, Actual = 950000 },
        new() { Month = "Feb", Budget = 1000000, Actual = 980000 },
        new() { Month = "Mar", Budget = 1000000, Actual = 1100000 },
        new() { Month = "Apr", Budget = 1000000, Actual = 920000 },
        new() { Month = "May", Budget = 1000000, Actual = 1050000 },
        new() { Month = "Jun", Budget = 1000000, Actual = 970000 }
    };

    private List<BudgetAlert> budgetAlerts = new()
    {
        new() { Title = "IT Department Over Budget", Message = "IT department has exceeded allocated budget by 8%", Severity = "critical" },
        new() { Title = "HR Budget Nearly Depleted", Message = "Human Resources has used 95% of annual allocation", Severity = "warning" },
        new() { Title = "Q3 Projections Alert", Message = "Current spending rate may exceed Q3 budget by 5%", Severity = "warning" }
    };

    protected override void OnInitialized()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
        }
    }

    private string GetProgressClass(int percent) => percent switch
    {
        <= 80 => "safe",
        <= 100 => "warning",
        _ => "danger"
    };

    private string GetStatusBadge(int percent) => percent switch
    {
        <= 80 => "badge-success",
        <= 100 => "badge-warning",
        _ => "badge-danger"
    };

    private string GetStatusText(int percent) => percent switch
    {
        <= 80 => "On Track",
        <= 100 => "Near Limit",
        _ => "Over Budget"
    };

    private void GenerateReport() { }
    private void ExportReport() { }

    private class DepartmentBudget
    {
        public string Department { get; set; } = "";
        public decimal Budget { get; set; }
        public decimal Actual { get; set; }
        public decimal Variance { get; set; }
        public int PercentUsed { get; set; }
    }

    private class MonthlyData
    {
        public string Month { get; set; } = "";
        public decimal Budget { get; set; }
        public decimal Actual { get; set; }
    }

    private class BudgetAlert
    {
        public string Title { get; set; } = "";
        public string Message { get; set; } = "";
        public string Severity { get; set; } = "";
    }
}
