@page "/admin/finance/receivables"
@layout AdminLayout
@inject AccountsReceivableService AccountsReceivableService

<div class="section-header">
    <h2 class="section-title">💳 Accounts Receivable</h2>
    <p style="color: var(--text-secondary); font-size: 14px; margin-top: 8px;">
        Track customer invoices, payments, and outstanding receivables
    </p>
</div>

<!-- Action Bar -->
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <div style="display: flex; gap: 12px;">
        <button class="btn" style="background: #10b981; color: white; padding: 12px 24px; font-weight: 600;" @onclick="() => showNewInvoiceModal = true">
            ➕ New Invoice
        </button>
        <button class="btn" style="background: #3b82f6; color: white; padding: 12px 24px;" disabled>
            💰 Record Payment
        </button>
    </div>
    <div style="display: flex; gap: 12px;">
        <button class="btn" style="background: white; border: 2px solid var(--border); color: #374151; padding: 12px 24px;">
            📊 Aging Report
        </button>
        <button class="btn" style="background: white; border: 2px solid var(--border); color: #374151; padding: 12px 24px;">
            📥 Export
        </button>
    </div>
</div>

<!-- Summary Cards -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 24px;">
    <div style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); border-radius: 16px; padding: 24px; border: 2px solid #6ee7b7;">
        <div style="font-size: 13px; color: #065f46; font-weight: 600; margin-bottom: 8px;">💰 TOTAL RECEIVABLES</div>
        <div style="font-size: 32px; font-weight: 700; color: #065f46;">₱@totalOutstanding.ToString("N2")</div>
        <div style="font-size: 12px; color: #065f46; margin-top: 4px;">Outstanding balance</div>
    </div>
    <div style="background: linear-gradient(135deg, #dbeafe, #bfdbfe); border-radius: 16px; padding: 24px; border: 2px solid #93c5fd;">
        <div style="font-size: 13px; color: #1e40af; font-weight: 600; margin-bottom: 8px;">📅 DUE THIS WEEK</div>
        <div style="font-size: 32px; font-weight: 700; color: #1e40af;">₱@dueThisWeekAmount.ToString("N2")</div>
        <div style="font-size: 12px; color: #1e40af; margin-top: 4px;">@dueThisWeekCount invoices due</div>
    </div>
    <div style="background: linear-gradient(135deg, #fee2e2, #fecaca); border-radius: 16px; padding: 24px; border: 2px solid #f87171;">
        <div style="font-size: 13px; color: #991b1b; font-weight: 600; margin-bottom: 8px;">🚨 OVERDUE</div>
        <div style="font-size: 32px; font-weight: 700; color: #991b1b;">₱@overdueAmount.ToString("N2")</div>
        <div style="font-size: 12px; color: #991b1b; margin-top: 4px;">@overdueCount overdue invoices</div>
    </div>
    <div style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); border-radius: 16px; padding: 24px; border: 2px solid #34d399;">
        <div style="font-size: 13px; color: #065f46; font-weight: 600; margin-bottom: 8px;">✅ COLLECTED THIS MONTH</div>
        <div style="font-size: 32px; font-weight: 700; color: #065f46;">₱@collectedThisMonthAmount.ToString("N2")</div>
        <div style="font-size: 12px; color: #065f46; margin-top: 4px;">@collectedThisMonthCount invoices paid</div>
    </div>
</div>

<!-- Filters -->
<div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid var(--border); margin-bottom: 24px;">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px;">
        <div class="form-group">
            <label class="form-label">Status</label>
            <select class="form-control">
                <option>All Statuses</option>
                <option>Unpaid</option>
                <option>Partially Paid</option>
                <option>Paid</option>
                <option>Overdue</option>
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">Customer</label>
            <select class="form-control">
                <option>All Customers</option>
                <option>Corporate Client A</option>
                <option>Business Partner B</option>
                <option>Enterprise Customer C</option>
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">Due Date</label>
            <select class="form-control">
                <option>All Dates</option>
                <option>Due This Week</option>
                <option>Due This Month</option>
                <option>Overdue</option>
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">Amount Range</label>
            <select class="form-control">
                <option>All Amounts</option>
                <option>Under ₱10,000</option>
                <option>₱10,000 - ₱100,000</option>
                <option>Over ₱100,000</option>
            </select>
        </div>
    </div>
</div>

<!-- Receivables Table -->
<div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid var(--border);">
    <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 20px;">Outstanding Receivables</h3>

    <table style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr style="border-bottom: 2px solid var(--border); background: #f9fafb;">
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">INVOICE NO.</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">CUSTOMER</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">INVOICE DATE</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">DUE DATE</th>
                <th style="padding: 12px; text-align: right; font-size: 12px; font-weight: 700;">INVOICE AMOUNT</th>
                <th style="padding: 12px; text-align: right; font-size: 12px; font-weight: 700;">AMOUNT RECEIVED</th>
                <th style="padding: 12px; text-align: right; font-size: 12px; font-weight: 700;">BALANCE DUE</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">STATUS</th>
                <th style="padding: 12px; text-align: center; font-size: 12px; font-weight: 700;">ACTIONS</th>
            </tr>
        </thead>
        <tbody>
            @if (receivables == null || receivables.Count == 0)
            {
                <tr>
                    <td colspan="9" style="padding: 16px; text-align: center; color: #6b7280; font-size: 14px;">No receivables found.</td>
                </tr>
            }
            else
            {
                @foreach (var invoice in receivables)
                {
                    var isOverdue = invoice.DueDate.Date < DateTime.Today && invoice.OutstandingAmount > 0;
                    var isPaid = string.Equals(invoice.Status, "Paid", StringComparison.OrdinalIgnoreCase) || invoice.OutstandingAmount <= 0;
                    var status = invoice.Status;
                    var statusColor = isPaid ? "#d1fae5" : isOverdue ? "#fee2e2" : "#dbeafe";
                    var statusText = isPaid ? "#065f46" : isOverdue ? "#991b1b" : "#1e40af";

                    <tr style="border-bottom: 1px solid var(--border); transition: background 0.2s;">
                        <td style="padding: 16px; font-family: monospace; font-weight: 600; color: #10b981;">@invoice.InvoiceNumber</td>
                        <td style="padding: 16px;">
                            <div style="font-weight: 600; margin-bottom: 2px;">@invoice.CustomerName</div>
                            <div style="font-size: 12px; color: #6b7280;">@invoice.Description</div>
                        </td>
                        <td style="padding: 16px; font-size: 14px;">@invoice.InvoiceDate.ToString("MMM dd, yyyy")</td>
                        <td style="padding: 16px; font-size: 14px; font-weight: @(isOverdue ? "700" : "400"); color: @(isOverdue ? "#dc2626" : "#111827");">
                            @invoice.DueDate.ToString("MMM dd, yyyy")
                            @if (isOverdue)
                            {
                                var daysOverdue = (DateTime.Today - invoice.DueDate.Date).Days;
                                <div style="font-size: 11px; color: #dc2626;">⚠️ @daysOverdue days overdue</div>
                            }
                        </td>
                        <td style="padding: 16px; text-align: right; font-size: 15px; font-weight: 700;">₱@invoice.Amount.ToString("N2")</td>
                        <td style="padding: 16px; text-align: right; font-size: 14px; color: #10b981;">₱@invoice.ReceivedAmount.ToString("N2")</td>
                        <td style="padding: 16px; text-align: right; font-size: 16px; font-weight: 700; color: @(invoice.OutstandingAmount > 0 ? "#dc2626" : "#10b981");">₱@invoice.OutstandingAmount.ToString("N2")</td>
                        <td style="padding: 16px;">
                            <span style="padding: 4px 10px; background: @statusColor; color: @statusText; border-radius: 6px; font-size: 12px; font-weight: 600;">@status</span>
                        </td>
                        <td style="padding: 16px; text-align: center;">
                            <div style="display: flex; gap: 8px; justify-content: center;">
                                @if (!isPaid)
                                {
                                    <button class="btn" style="background: #10b981; color: white; padding: 6px 12px; font-size: 13px; font-weight: 600;" @onclick="() => OpenReceiptModal(invoice)">
                                        💰 Record Receipt
                                    </button>
                                }
                                <button class="btn" style="background: white; border: 2px solid #e5e7eb; color: #374151; padding: 6px 12px; font-size: 13px;">
                                    👁️ View
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <!-- Pagination -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--border);">
        <div style="font-size: 14px; color: #6b7280;">
            Showing <strong>1-12</strong> of <strong>94</strong> invoices
        </div>
        <div style="display: flex; gap: 8px;">
            <button class="btn" style="background: #f3f4f6; color: #9ca3af; padding: 8px 16px;">← Previous</button>
            <button class="btn" style="background: #10b981; color: white; padding: 8px 16px;">1</button>
            <button class="btn" style="background: #f3f4f6; color: #374151; padding: 8px 16px;">2</button>
            <button class="btn" style="background: #f3f4f6; color: #374151; padding: 8px 16px;">3</button>
            <button class="btn" style="background: #f3f4f6; color: #374151; padding: 8px 16px;">Next →</button>
        </div>
    </div>
</div>

<!-- New Invoice Modal -->
<div style="display: @(showNewInvoiceModal ? "flex" : "none"); position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000;">
    <div style="background: white; border-radius: 16px; padding: 32px; max-width: 500px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
        <h2 style="font-size: 20px; font-weight: 700; margin: 0 0 24px 0;">➕ New Invoice</h2>
        
        <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label">Customer Name</label>
            <input type="text" class="form-control" @bind="newInvoice_CustomerName" placeholder="e.g., Corporate Client A" />
        </div>
        
        <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label">Invoice Number</label>
            <input type="text" class="form-control" @bind="newInvoice_InvoiceNumber" placeholder="e.g., INV-2025-001" />
        </div>
        
        <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label">Invoice Date</label>
            <input type="date" class="form-control" @bind="newInvoice_InvoiceDate" />
        </div>
        
        <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label">Due Date</label>
            <input type="date" class="form-control" @bind="newInvoice_DueDate" />
        </div>
        
        <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label">Amount (₱)</label>
            <input type="number" class="form-control" @bind="newInvoice_Amount" placeholder="0.00" step="0.01" />
        </div>
        
        <div class="form-group" style="margin-bottom: 24px;">
            <label class="form-label">Description</label>
            <textarea class="form-control" @bind="newInvoice_Description" placeholder="Optional notes" style="min-height: 80px;"></textarea>
        </div>
        
        <div style="display: flex; gap: 12px; justify-content: flex-end;">
            <button class="btn" style="background: #e5e7eb; color: #374151; padding: 10px 20px; font-weight: 600;" @onclick="() => showNewInvoiceModal = false">Cancel</button>
            <button class="btn" style="background: #10b981; color: white; padding: 10px 20px; font-weight: 600;" @onclick="CreateNewInvoice">Create Invoice</button>
        </div>
    </div>
</div>

<!-- Record Receipt Modal -->
<div style="display: @(showReceiptModal ? "flex" : "none"); position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000;">
    <div style="background: white; border-radius: 16px; padding: 32px; max-width: 500px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
        <h2 style="font-size: 20px; font-weight: 700; margin: 0 0 24px 0;">💰 Record Receipt</h2>
        
        <div style="background: #f3f4f6; border-radius: 12px; padding: 16px; margin-bottom: 24px;">
            <div style="font-size: 12px; color: #6b7280; margin-bottom: 4px;">Invoice</div>
            <div style="font-size: 16px; font-weight: 700; color: #111827;">@selectedReceivable?.InvoiceNumber</div>
            <div style="font-size: 14px; color: #6b7280; margin-top: 8px;">Outstanding: ₱@selectedReceivable?.OutstandingAmount.ToString("N2")</div>
        </div>
        
        <div class="form-group" style="margin-bottom: 24px;">
            <label class="form-label">Receipt Amount (₱)</label>
            <input type="number" class="form-control" @bind="receiptAmount" placeholder="0.00" step="0.01" />
        </div>
        
        <div style="display: flex; gap: 12px; justify-content: flex-end;">
            <button class="btn" style="background: #e5e7eb; color: #374151; padding: 10px 20px; font-weight: 600;" @onclick="() => showReceiptModal = false">Cancel</button>
            <button class="btn" style="background: #10b981; color: white; padding: 10px 20px; font-weight: 600;" @onclick="RecordReceipt">Record Receipt</button>
        </div>
    </div>
</div>

@code {
    // UI Only - No backend logic

    private List<FinanceBank.Models.AccountsReceivable> receivables = new();

    private decimal totalOutstanding;
    private decimal dueThisWeekAmount;
    private int dueThisWeekCount;
    private decimal overdueAmount;
    private int overdueCount;
    private decimal collectedThisMonthAmount;
    private int collectedThisMonthCount;

    // Modal state
    private bool showNewInvoiceModal = false;
    private bool showReceiptModal = false;
    private FinanceBank.Models.AccountsReceivable? selectedReceivable;

    // New invoice form
    private string newInvoice_CustomerName = "";
    private string newInvoice_InvoiceNumber = "";
    private DateTime newInvoice_InvoiceDate = DateTime.Today;
    private DateTime newInvoice_DueDate = DateTime.Today.AddDays(45);
    private decimal newInvoice_Amount = 0;
    private string newInvoice_Description = "";

    // Receipt form
    private decimal receiptAmount = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            receivables = await AccountsReceivableService.GetAllAsync();
            CalculateSummary();
        }
        catch
        {
        }
    }

    private void CalculateSummary()
    {
        var today = DateTime.Today;
        var weekLimit = today.AddDays(7);
        var monthStart = new DateTime(today.Year, today.Month, 1);

        totalOutstanding = receivables.Sum(r => r.OutstandingAmount);

        var dueThisWeek = receivables
            .Where(r => r.DueDate.Date >= today && r.DueDate.Date <= weekLimit && r.OutstandingAmount > 0)
            .ToList();
        dueThisWeekAmount = dueThisWeek.Sum(r => r.OutstandingAmount);
        dueThisWeekCount = dueThisWeek.Count;

        var overdue = receivables
            .Where(r => r.DueDate.Date < today && r.OutstandingAmount > 0)
            .ToList();
        overdueAmount = overdue.Sum(r => r.OutstandingAmount);
        overdueCount = overdue.Count;

        var collectedThisMonth = receivables
            .Where(r => r.Status == "Paid" && r.InvoiceDate.Date >= monthStart && r.InvoiceDate.Date <= today)
            .ToList();
        collectedThisMonthAmount = collectedThisMonth.Sum(r => r.ReceivedAmount);
        collectedThisMonthCount = collectedThisMonth.Count;
    }

    private async Task CreateNewInvoice()
    {
        if (string.IsNullOrWhiteSpace(newInvoice_CustomerName) || string.IsNullOrWhiteSpace(newInvoice_InvoiceNumber) || newInvoice_Amount <= 0)
        {
            return;
        }

        var newReceivable = new FinanceBank.Models.AccountsReceivable
        {
            CustomerName = newInvoice_CustomerName,
            InvoiceNumber = newInvoice_InvoiceNumber,
            InvoiceDate = newInvoice_InvoiceDate,
            DueDate = newInvoice_DueDate,
            Amount = newInvoice_Amount,
            ReceivedAmount = 0,
            OutstandingAmount = newInvoice_Amount,
            Status = "Pending",
            Description = newInvoice_Description,
            CreatedBy = "Admin"
        };

        try
        {
            await AccountsReceivableService.CreateAsync(newReceivable);
            receivables = await AccountsReceivableService.GetAllAsync();
            CalculateSummary();
            
            // Reset form
            newInvoice_CustomerName = "";
            newInvoice_InvoiceNumber = "";
            newInvoice_InvoiceDate = DateTime.Today;
            newInvoice_DueDate = DateTime.Today.AddDays(45);
            newInvoice_Amount = 0;
            newInvoice_Description = "";
            showNewInvoiceModal = false;
        }
        catch
        {
        }
    }

    private async Task RecordReceipt()
    {
        if (selectedReceivable == null || receiptAmount <= 0)
        {
            return;
        }

        try
        {
            await AccountsReceivableService.RecordReceiptAsync(selectedReceivable.ReceivableId, receiptAmount, "Admin");
            receivables = await AccountsReceivableService.GetAllAsync();
            CalculateSummary();
            
            receiptAmount = 0;
            showReceiptModal = false;
            selectedReceivable = null;
        }
        catch
        {
        }
    }

    private void OpenReceiptModal(FinanceBank.Models.AccountsReceivable receivable)
    {
        selectedReceivable = receivable;
        receiptAmount = 0;
        showReceiptModal = true;
    }
}

