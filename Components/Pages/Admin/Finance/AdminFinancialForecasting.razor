@page "/admin/finance-mgr/financial-forecasting"
@layout AdminLayout
@inject AuthService AuthService
@inject NavigationManager Navigation

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; justify-content: space-between;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                    <path d="M3 3v18h18"></path>
                    <path d="M18 17V9"></path>
                    <path d="M13 17V5"></path>
                    <path d="M8 17v-3"></path>
                </svg>
            </div>
            <div>
                <h1 style="font-size: 28px; font-weight: 700; color: white; margin: 0;">Financial Forecasting (Admin)</h1>
                <p style="color: rgba(255,255,255,0.8); margin: 4px 0 0 0;">View financial projections and forecasts</p>
            </div>
        </div>
        <select @bind="forecastPeriod" style="padding: 10px 16px; border-radius: 8px; border: none; background: rgba(255,255,255,0.2); color: white; font-weight: 500;">
            <option value="3" style="color: #111;">Next 3 Months</option>
            <option value="6" style="color: #111;">Next 6 Months</option>
            <option value="12" style="color: #111;">Next 12 Months</option>
        </select>
    </div>
</div>

<!-- Admin Notice -->
<div style="background: #fef3c7; border: 1px solid #f59e0b; border-radius: 12px; padding: 16px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 12px;">
        <span style="font-size: 24px;">📈</span>
        <div>
            <p style="margin: 0; font-weight: 600; color: #92400e;">Administrative Financial Forecasting Access</p>
            <p style="margin: 4px 0 0; font-size: 13px; color: #b45309;">All forecast views are logged for audit purposes.</p>
        </div>
    </div>
</div>

<!-- Forecast Summary -->
<div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 24px;">
    <div style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); border-radius: 16px; padding: 24px; border: 2px solid #6ee7b7;">
        <div style="font-size: 13px; color: #047857; font-weight: 600; margin-bottom: 8px;">AVG REVENUE</div>
        <div style="font-size: 24px; font-weight: 700; color: #047857;">₱@avgRevenue.ToString("N2")</div>
        <div style="font-size: 12px; color: #059669; margin-top: 4px;">Per period</div>
    </div>
    <div style="background: linear-gradient(135deg, #fef3c7, #fde68a); border-radius: 16px; padding: 24px; border: 2px solid #fcd34d;">
        <div style="font-size: 13px; color: #92400e; font-weight: 600; margin-bottom: 8px;">AVG EXPENSES</div>
        <div style="font-size: 24px; font-weight: 700; color: #92400e;">₱@avgExpenses.ToString("N2")</div>
        <div style="font-size: 12px; color: #d97706; margin-top: 4px;">Per period</div>
    </div>
    <div style="background: linear-gradient(135deg, #dbeafe, #bfdbfe); border-radius: 16px; padding: 24px; border: 2px solid #93c5fd;">
        <div style="font-size: 13px; color: #1e40af; font-weight: 600; margin-bottom: 8px;">NET INCOME</div>
        <div style="font-size: 24px; font-weight: 700; color: #1e40af;">₱@avgNetIncome.ToString("N2")</div>
        <div style="font-size: 12px; color: #3b82f6; margin-top: 4px;">Projected</div>
    </div>
    <div style="background: linear-gradient(135deg, #e9d5ff, #d8b4fe); border-radius: 16px; padding: 24px; border: 2px solid #c084fc;">
        <div style="font-size: 13px; color: #6d28d9; font-weight: 600; margin-bottom: 8px;">GROWTH RATE</div>
        <div style="font-size: 24px; font-weight: 700; color: #6d28d9;">@growthRate%</div>
        <div style="font-size: 12px; color: #8b5cf6; margin-top: 4px;">Average</div>
    </div>
</div>

<!-- Forecast Table -->
<div style="background: white; border-radius: 16px; border: 1px solid #e5e7eb; overflow: hidden;">
    <div style="background: linear-gradient(135deg, #8b5cf6, #6d28d9); padding: 16px 24px;">
        <h3 style="font-size: 16px; font-weight: 700; color: white; margin: 0;">Revenue & Expense Forecast</h3>
    </div>
    <div style="padding: 24px;">
        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background: #f9fafb; border-bottom: 2px solid #e5e7eb;">
                    <th style="padding: 12px; text-align: left; font-size: 13px; font-weight: 600; color: #374151;">Period</th>
                    <th style="padding: 12px; text-align: right; font-size: 13px; font-weight: 600; color: #374151;">Revenue</th>
                    <th style="padding: 12px; text-align: right; font-size: 13px; font-weight: 600; color: #374151;">Expenses</th>
                    <th style="padding: 12px; text-align: right; font-size: 13px; font-weight: 600; color: #374151;">Net Income</th>
                    <th style="padding: 12px; text-align: right; font-size: 13px; font-weight: 600; color: #374151;">Growth %</th>
                    <th style="padding: 12px; text-align: center; font-size: 13px; font-weight: 600; color: #374151;">Confidence</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var forecast in forecasts.Take(forecastPeriod))
                {
                    <tr style="border-bottom: 1px solid #e5e7eb;">
                        <td style="padding: 12px; font-size: 14px; color: #111827; font-weight: 600;">@forecast.Period</td>
                        <td style="padding: 12px; text-align: right; font-size: 14px; color: #10b981; font-weight: 600;">₱@forecast.Revenue.ToString("N2")</td>
                        <td style="padding: 12px; text-align: right; font-size: 14px; color: #ef4444;">₱@forecast.Expenses.ToString("N2")</td>
                        <td style="padding: 12px; text-align: right; font-size: 14px; font-weight: 700; color: @(forecast.NetIncome >= 0 ? "#10b981" : "#ef4444");">₱@forecast.NetIncome.ToString("N2")</td>
                        <td style="padding: 12px; text-align: right; font-size: 14px; color: #8b5cf6; font-weight: 600;">@forecast.GrowthPercent%</td>
                        <td style="padding: 12px; text-align: center;">
                            <span style="padding: 4px 12px; border-radius: 6px; font-size: 12px; font-weight: 600; background: @GetConfidenceBg(forecast.Confidence); color: @GetConfidenceColor(forecast.Confidence);">
                                @forecast.Confidence
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private int forecastPeriod = 6;
    private decimal avgRevenue = 12500000;
    private decimal avgExpenses = 9500000;
    private decimal avgNetIncome = 3000000;
    private decimal growthRate = 8.5m;

    private List<ForecastItem> forecasts = new()
    {
        new() { Period = "Jan 2025", Revenue = 11000000, Expenses = 8500000, NetIncome = 2500000, GrowthPercent = 5.5m, Confidence = "High" },
        new() { Period = "Feb 2025", Revenue = 11500000, Expenses = 8800000, NetIncome = 2700000, GrowthPercent = 6.2m, Confidence = "High" },
        new() { Period = "Mar 2025", Revenue = 12000000, Expenses = 9000000, NetIncome = 3000000, GrowthPercent = 7.0m, Confidence = "High" },
        new() { Period = "Apr 2025", Revenue = 12500000, Expenses = 9300000, NetIncome = 3200000, GrowthPercent = 7.8m, Confidence = "Medium" },
        new() { Period = "May 2025", Revenue = 13000000, Expenses = 9500000, NetIncome = 3500000, GrowthPercent = 8.5m, Confidence = "Medium" },
        new() { Period = "Jun 2025", Revenue = 13500000, Expenses = 9800000, NetIncome = 3700000, GrowthPercent = 9.2m, Confidence = "Medium" },
        new() { Period = "Jul 2025", Revenue = 14000000, Expenses = 10000000, NetIncome = 4000000, GrowthPercent = 10.0m, Confidence = "Low" },
        new() { Period = "Aug 2025", Revenue = 14500000, Expenses = 10300000, NetIncome = 4200000, GrowthPercent = 10.5m, Confidence = "Low" },
        new() { Period = "Sep 2025", Revenue = 15000000, Expenses = 10500000, NetIncome = 4500000, GrowthPercent = 11.0m, Confidence = "Low" },
        new() { Period = "Oct 2025", Revenue = 15500000, Expenses = 10800000, NetIncome = 4700000, GrowthPercent = 11.5m, Confidence = "Low" },
        new() { Period = "Nov 2025", Revenue = 16000000, Expenses = 11000000, NetIncome = 5000000, GrowthPercent = 12.0m, Confidence = "Low" },
        new() { Period = "Dec 2025", Revenue = 16500000, Expenses = 11300000, NetIncome = 5200000, GrowthPercent = 12.5m, Confidence = "Low" }
    };

    protected override void OnInitialized()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
        }
    }

    private string GetConfidenceBg(string confidence) => confidence switch
    {
        "High" => "#dcfce7",
        "Medium" => "#fef3c7",
        "Low" => "#fee2e2",
        _ => "#f3f4f6"
    };

    private string GetConfidenceColor(string confidence) => confidence switch
    {
        "High" => "#047857",
        "Medium" => "#92400e",
        "Low" => "#dc2626",
        _ => "#374151"
    };

    private class ForecastItem
    {
        public string Period { get; set; } = "";
        public decimal Revenue { get; set; }
        public decimal Expenses { get; set; }
        public decimal NetIncome { get; set; }
        public decimal GrowthPercent { get; set; }
        public string Confidence { get; set; } = "";
    }
}
