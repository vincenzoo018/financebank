@page "/admin/finance/budget-reports"
@layout AdminLayout
@namespace FinanceBank.Components.Pages.Admin.Finance
@inject BudgetManagementService BudgetManagementService

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
            <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
            </svg>
        </div>
        <div>
            <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Budget Reports</h1>
            <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Budget allocation, spending analysis, and forecasts</p>
        </div>
    </div>
</div>

<!-- Summary Cards -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 24px;">
    <div style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); border-radius: 16px; padding: 24px; border: 2px solid #6ee7b7;">
        <div style="font-size: 13px; color: #065f46; font-weight: 600; margin-bottom: 8px;">TOTAL BUDGETS</div>
        <div style="font-size: 32px; font-weight: 700; color: #065f46;">@budgets.Count</div>
        <div style="font-size: 12px; color: #065f46; margin-top: 4px;">Active budget allocations</div>
    </div>
    <div style="background: linear-gradient(135deg, #bfdbfe, #93c5fd); border-radius: 16px; padding: 24px; border: 2px solid #60a5fa;">
        <div style="font-size: 13px; color: #1e40af; font-weight: 600; margin-bottom: 8px;">TOTAL ALLOCATED</div>
        <div style="font-size: 32px; font-weight: 700; color: #1e40af;">₱@totalAllocated.ToString("N2")</div>
        <div style="font-size: 12px; color: #1e40af; margin-top: 4px;">Total budget amount</div>
    </div>
    <div style="background: linear-gradient(135deg, #fecaca, #f87171); border-radius: 16px; padding: 24px; border: 2px solid #f87171;">
        <div style="font-size: 13px; color: #991b1b; font-weight: 600; margin-bottom: 8px;">TOTAL SPENT</div>
        <div style="font-size: 32px; font-weight: 700; color: #991b1b;">₱@totalSpent.ToString("N2")</div>
        <div style="font-size: 12px; color: #991b1b; margin-top: 4px;">Actual spending</div>
    </div>
    <div style="background: linear-gradient(135deg, #dbeafe, #bfdbfe); border-radius: 16px; padding: 24px; border: 2px solid #60a5fa;">
        <div style="font-size: 13px; color: #1e40af; font-weight: 600; margin-bottom: 8px;">TOTAL REMAINING</div>
        <div style="font-size: 32px; font-weight: 700; color: #1e40af;">₱@totalRemaining.ToString("N2")</div>
        <div style="font-size: 12px; color: #1e40af; margin-top: 4px;">Available budget</div>
    </div>
</div>

<!-- Budget Reports Table -->
<div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
    <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 20px;">Budget Performance Report</h3>

    <table style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr style="border-bottom: 2px solid #e5e7eb; background: #f9fafb;">
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">BUDGET NAME</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">DEPARTMENT</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">CATEGORY</th>
                <th style="padding: 12px; text-align: right; font-size: 12px; font-weight: 700;">ALLOCATED</th>
                <th style="padding: 12px; text-align: right; font-size: 12px; font-weight: 700;">SPENT</th>
                <th style="padding: 12px; text-align: right; font-size: 12px; font-weight: 700;">REMAINING</th>
                <th style="padding: 12px; text-align: center; font-size: 12px; font-weight: 700;">UTILIZATION</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">STATUS</th>
                <th style="padding: 12px; text-align: center; font-size: 12px; font-weight: 700;">ACTIONS</th>
            </tr>
        </thead>
        <tbody>
            @if (budgets == null || budgets.Count == 0)
            {
                <tr>
                    <td colspan="9" style="padding: 16px; text-align: center; color: #6b7280; font-size: 14px;">No budget reports found.</td>
                </tr>
            }
            else
            {
                @foreach (var b in budgets.OrderByDescending(x => x.CreatedAt))
                {
                    var utilization = b.AllocatedAmount > 0 ? (b.SpentAmount / b.AllocatedAmount * 100) : 0;
                    var utilizationColor = utilization >= 80 ? "#b91c1c" : (utilization >= 60 ? "#d97706" : "#16a34a");
                    <tr style="border-bottom: 1px solid #e5e7eb; transition: background 0.2s;">
                        <td style="padding: 16px; font-size: 14px; font-weight: 600;">@b.BudgetName</td>
                        <td style="padding: 16px; font-size: 13px;">@b.Department</td>
                        <td style="padding: 16px; font-size: 13px;">@b.Category</td>
                        <td style="padding: 16px; text-align: right; font-size: 14px;">₱@b.AllocatedAmount.ToString("N2")</td>
                        <td style="padding: 16px; text-align: right; font-size: 14px;">₱@b.SpentAmount.ToString("N2")</td>
                        <td style="padding: 16px; text-align: right; font-size: 14px; font-weight: 700;">₱@b.RemainingAmount.ToString("N2")</td>
                        <td style="padding: 16px; text-align: center; font-size: 13px; font-weight: 600; color: @utilizationColor;">@utilization.ToString("N1")%</td>
                        <td style="padding: 16px; font-size: 13px;">
                            <span style="background: @(string.Equals(b.Status, "Active", StringComparison.OrdinalIgnoreCase) ? "#dcfce7" : "#f3f4f6"); color: @(string.Equals(b.Status, "Active", StringComparison.OrdinalIgnoreCase) ? "#166534" : "#6b7280"); padding: 4px 12px; border-radius: 20px; display: inline-block;">
                                @b.Status
                            </span>
                        </td>
                        <td style="padding: 16px; text-align: center;">
                            <button class="btn" style="background: white; border: 2px solid #e5e7eb; color: #374151; padding: 6px 12px; font-size: 13px; margin-right: 4px;" @onclick='() => ViewBudgetDetails(b)'>View</button>
                            <button class="btn" style="background: white; border: 2px solid #e5e7eb; color: #374151; padding: 6px 12px; font-size: 13px; margin-right: 4px;" @onclick='() => EditBudget(b)'>Edit</button>
                            <button class="btn" style="background: white; border: 2px solid #e5e7eb; color: #374151; padding: 6px 12px; font-size: 13px;" @onclick='() => DeleteBudget(b.BudgetId)'>Delete</button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- Budget Details Modal -->
<div style="display: @(showDetailsModal ? "flex" : "none"); position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000;">
    <div style="background: white; border-radius: 16px; padding: 32px; max-width: 520px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
        <h2 style="font-size: 20px; font-weight: 700; margin: 0 0 24px 0;">Budget Details</h2>

        @if (selectedBudget != null)
        {
            var utilization = selectedBudget.AllocatedAmount > 0 ? (selectedBudget.SpentAmount / selectedBudget.AllocatedAmount * 100) : 0;
            <div style="display: grid; grid-template-columns: 1fr; gap: 12px; font-size: 14px; color: #374151; margin-bottom: 24px;">
                <div style="display: grid; grid-template-columns: auto 1fr; gap: 8px;"><strong>Budget Name:</strong> <span>@selectedBudget.BudgetName</span></div>
                <div style="display: grid; grid-template-columns: auto 1fr; gap: 8px;"><strong>Department:</strong> <span>@selectedBudget.Department</span></div>
                <div style="display: grid; grid-template-columns: auto 1fr; gap: 8px;"><strong>Category:</strong> <span>@selectedBudget.Category</span></div>
                <div style="display: grid; grid-template-columns: auto 1fr; gap: 8px;"><strong>Allocated Amount:</strong> <span>₱@selectedBudget.AllocatedAmount.ToString("N2")</span></div>
                <div style="display: grid; grid-template-columns: auto 1fr; gap: 8px;"><strong>Spent Amount:</strong> <span>₱@selectedBudget.SpentAmount.ToString("N2")</span></div>
                <div style="display: grid; grid-template-columns: auto 1fr; gap: 8px;"><strong>Remaining Amount:</strong> <span style="font-weight: 700;">₱@selectedBudget.RemainingAmount.ToString("N2")</span></div>
                <div style="display: grid; grid-template-columns: auto 1fr; gap: 8px;"><strong>Utilization:</strong> <span>@utilization.ToString("N1")%</span></div>
                <div style="display: grid; grid-template-columns: auto 1fr; gap: 8px;"><strong>Start Date:</strong> <span>@selectedBudget.StartDate.ToString("yyyy-MM-dd")</span></div>
                <div style="display: grid; grid-template-columns: auto 1fr; gap: 8px;"><strong>End Date:</strong> <span>@selectedBudget.EndDate.ToString("yyyy-MM-dd")</span></div>
                <div style="display: grid; grid-template-columns: auto 1fr; gap: 8px;"><strong>Status:</strong> <span>@selectedBudget.Status</span></div>
                <div style="display: grid; grid-template-columns: auto 1fr; gap: 8px;"><strong>Description:</strong> <span>@selectedBudget.Description</span></div>
            </div>
        }

        <div style="display: flex; justify-content: flex-end;">
            <button class="btn" style="background: #e5e7eb; color: #374151; padding: 8px 18px; font-weight: 600;" @onclick="CloseDetailsModal">Close</button>
        </div>
    </div>
</div>

<!-- Edit Budget Modal -->
<div style="display: @(showEditModal ? "flex" : "none"); position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000;">
    <div style="background: white; border-radius: 16px; padding: 32px; max-width: 520px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
        <h2 style="font-size: 20px; font-weight: 700; margin: 0 0 24px 0;">Edit Budget</h2>

        @if (editingBudget != null)
        {
            <div style="display: grid; grid-template-columns: 1fr; gap: 12px; margin-bottom: 24px;">
                <div class="form-group">
                    <label class="form-label">Budget Name</label>
                    <input type="text" class="form-control" @bind="editingBudget.BudgetName" />
                </div>
                <div class="form-group">
                    <label class="form-label">Department</label>
                    <input type="text" class="form-control" @bind="editingBudget.Department" />
                </div>
                <div class="form-group">
                    <label class="form-label">Category</label>
                    <input type="text" class="form-control" @bind="editingBudget.Category" />
                </div>
                <div class="form-group">
                    <label class="form-label">Allocated Amount</label>
                    <input type="number" class="form-control" @bind-value="editingBudget.AllocatedAmount" step="0.01" />
                </div>
                <div class="form-group">
                    <label class="form-label">Spent Amount</label>
                    <input type="number" class="form-control" @bind-value="editingBudget.SpentAmount" step="0.01" />
                </div>
                <div class="form-group">
                    <label class="form-label">Start Date</label>
                    <input type="date" class="form-control" @bind="editingBudget.StartDate" />
                </div>
                <div class="form-group">
                    <label class="form-label">End Date</label>
                    <input type="date" class="form-control" @bind="editingBudget.EndDate" />
                </div>
                <div class="form-group">
                    <label class="form-label">Status</label>
                    <select class="form-control" @bind="editingBudget.Status">
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                        <option value="Completed">Completed</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Description</label>
                    <textarea class="form-control" @bind="editingBudget.Description" style="min-height: 80px;"></textarea>
                </div>
            </div>
        }

        <div style="display: flex; gap: 12px; justify-content: flex-end;">
            <button class="btn" style="background: #e5e7eb; color: #374151; padding: 10px 20px; font-weight: 600;" @onclick="CloseEditModal">Cancel</button>
            <button class="btn" style="background: #10b981; color: white; padding: 10px 20px; font-weight: 600;" @onclick="SaveBudgetChanges">Save Changes</button>
        </div>
    </div>
</div>

@code {
    private List<Budget> budgets = new();
    private bool showDetailsModal = false;
    private bool showEditModal = false;
    private Budget? selectedBudget;
    private Budget? editingBudget;

    private decimal totalAllocated;
    private decimal totalSpent;
    private decimal totalRemaining;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            budgets = await BudgetManagementService.GetAllAsync();
            CalculateSummary();
        }
        catch
        {
        }
    }

    private void CalculateSummary()
    {
        totalAllocated = budgets.Sum(b => b.AllocatedAmount);
        totalSpent = budgets.Sum(b => b.SpentAmount);
        totalRemaining = budgets.Sum(b => b.RemainingAmount);
    }

    private void ViewBudgetDetails(Budget budget)
    {
        selectedBudget = budget;
        showDetailsModal = true;
    }

    private void CloseDetailsModal()
    {
        showDetailsModal = false;
        selectedBudget = null;
    }

    private void EditBudget(Budget budget)
    {
        editingBudget = new Budget
        {
            BudgetId = budget.BudgetId,
            BudgetName = budget.BudgetName,
            Department = budget.Department,
            Category = budget.Category,
            AllocatedAmount = budget.AllocatedAmount,
            SpentAmount = budget.SpentAmount,
            StartDate = budget.StartDate,
            EndDate = budget.EndDate,
            Status = budget.Status,
            Description = budget.Description
        };
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        editingBudget = null;
    }

    private async Task SaveBudgetChanges()
    {
        if (editingBudget != null)
        {
            try
            {
                await BudgetManagementService.UpdateAsync(editingBudget);
                budgets = await BudgetManagementService.GetAllAsync();
                CalculateSummary();
                showEditModal = false;
                editingBudget = null;
            }
            catch
            {
            }
        }
    }

    private async Task DeleteBudget(int budgetId)
    {
        try
        {
            var ok = await BudgetManagementService.DeleteAsync(budgetId);
            if (ok)
            {
                budgets = await BudgetManagementService.GetAllAsync();
                CalculateSummary();
            }
        }
        catch
        {
        }
    }
}
