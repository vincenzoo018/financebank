@page "/admin/finance-mgr/approval-queue"
@layout AdminLayout
@using Microsoft.EntityFrameworkCore
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IDbContextFactory<BFASDbContext> DbContextFactory

<div style="padding: 24px; max-width: 1400px; margin: 0 auto;">
    <!-- Header - Matching Finance Manager style -->
    <div style="background: linear-gradient(135deg, #059669, #047857); border-radius: 16px; padding: 24px; margin-bottom: 24px; color: white;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 48px; height: 48px; background: rgba(255,255,255,0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
            </div>
            <div style="flex: 1;">
                <h1 style="font-size: 24px; font-weight: 700; margin: 0;">Approval Queue</h1>
                <p style="margin: 4px 0 0; opacity: 0.9; font-size: 14px;">Review and process pending approvals</p>
            </div>
            <div style="background: rgba(255,255,255,0.2); padding: 10px 16px; border-radius: 8px;">
                <div style="font-size: 11px; opacity: 0.9;">Queue Size</div>
                <div style="font-size: 20px; font-weight: 700;">@pendingApprovals.Count</div>
            </div>
        </div>
    </div>

    <!-- Admin Notice -->
    <div style="background: #fef3c7; border: 1px solid #f59e0b; border-radius: 12px; padding: 16px; margin-bottom: 24px;">
        <div style="display: flex; align-items: start; gap: 12px;">
            <span style="font-size: 24px;">🔐</span>
            <div style="flex: 1;">
                <p style="margin: 0; font-weight: 600; color: #92400e;">SuperAdmin Access - Finance Manager Functions</p>
                <p style="margin: 4px 0 8px; font-size: 13px; color: #b45309;">All actions are logged for audit purposes.</p>
                <div style="margin-top: 8px;">
                    <label style="display: block; font-size: 12px; font-weight: 600; margin-bottom: 6px; color: #92400e;">Reason for Admin Action (Required)</label>
                    <textarea @bind="adminActionReason" style="width: 100%; padding: 10px; border: 1px solid #fcd34d; border-radius: 8px; font-size: 14px;" rows="2" placeholder="Document why you are performing this action as admin..."></textarea>
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div style="background: white; border-radius: 16px; padding: 60px; text-align: center; border: 1px solid #e5e7eb;">
            <div class="spinner-border text-primary" role="status"></div>
            <p style="margin-top: 16px; color: #6b7280;">Loading approval queue...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 12px; padding: 16px; color: #dc2626;">
            @errorMessage
        </div>
    }
    else
    {
        <!-- Filter Bar -->
        <div style="background: white; border-radius: 12px; padding: 16px; margin-bottom: 24px; border: 1px solid #e5e7eb;">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px;">
                <div>
                    <label style="display: block; font-size: 12px; font-weight: 600; margin-bottom: 6px; color: #6b7280;">Type</label>
                    <select @bind="filterType" style="width: 100%; padding: 8px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;">
                        <option value="">All Types</option>
                        <option value="Deposit">Deposit</option>
                        <option value="Withdrawal">Withdrawal</option>
                        <option value="Transfer">Transfer</option>
                        <option value="Loan">Loan</option>
                    </select>
                </div>
                <div>
                    <label style="display: block; font-size: 12px; font-weight: 600; margin-bottom: 6px; color: #6b7280;">Priority</label>
                    <select @bind="filterPriority" style="width: 100%; padding: 8px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;">
                        <option value="">All Priorities</option>
                        <option value="Urgent">Urgent</option>
                        <option value="High">High</option>
                        <option value="Medium">Medium</option>
                        <option value="Low">Low</option>
                    </select>
                </div>
                <div style="display: flex; align-items: flex-end; gap: 8px;">
                    <button @onclick="ApplyFilters" style="flex: 1; padding: 8px; background: #059669; color: white; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer;">Apply</button>
                    <button @onclick="LoadData" style="padding: 8px 12px; background: #f3f4f6; border: none; border-radius: 8px; font-size: 14px; cursor: pointer;">Refresh</button>
                </div>
            </div>
        </div>

        <!-- Approval Items -->
        <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
            @{
                var filteredApprovals = pendingApprovals.Where(a => 
                    (string.IsNullOrEmpty(filterType) || a.RequestType == filterType) &&
                    (string.IsNullOrEmpty(filterPriority) || a.Priority == filterPriority)
                ).ToList();
            }
            <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 20px;">Pending Approvals (@filteredApprovals.Count)</h3>
            
            @if (!filteredApprovals.Any())
            {
                <div style="text-align: center; padding: 40px; color: #6b7280;">
                    <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" style="margin: 0 auto 16px; opacity: 0.5;">
                        <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <p>No pending approvals found.</p>
                </div>
            }
            else
            {
                <div style="display: grid; gap: 16px;">
                    @foreach (var item in filteredApprovals)
                    {
                        <div style="border: 1px solid #e5e7eb; border-radius: 12px; padding: 20px; transition: all 0.2s;">
                            <div style="display: flex; justify-content: space-between; align-items: start; flex-wrap: wrap; gap: 16px;">
                                <div style="flex: 1; min-width: 280px;">
                                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px; flex-wrap: wrap;">
                                        <span style="padding: 4px 8px; background: @GetTypeColor(item.RequestType ?? ""); border-radius: 6px; font-size: 11px; font-weight: 600; color: white;">@item.RequestType</span>
                                        <span style="padding: 4px 8px; background: @GetPriorityColor(item.Priority); border-radius: 6px; font-size: 11px; font-weight: 600;">@item.Priority</span>
                                    </div>
                                    <h4 style="font-size: 16px; font-weight: 700; margin-bottom: 4px;">@item.RequestType Request #@item.RequestId</h4>
                                    <p style="font-size: 14px; color: #6b7280; margin-bottom: 8px;">@item.Description</p>
                                    <div style="display: flex; gap: 16px; font-size: 12px; color: #9ca3af; flex-wrap: wrap;">
                                        <span>ID: @item.ApprovalId</span>
                                        <span>Requested by: @item.RequestedBy</span>
                                        <span>Submitted: @item.RequestedAt.ToString("MMM dd, yyyy HH:mm")</span>
                                    </div>
                                </div>
                                <div style="text-align: right;">
                                    <div style="font-size: 18px; font-weight: 700; color: #f59e0b; margin-bottom: 8px;">₱@item.Amount.ToString("N2")</div>
                                    <div style="display: flex; gap: 8px;">
                                        <button @onclick="() => ApproveRequest(item)" disabled="@(string.IsNullOrWhiteSpace(adminActionReason) || isProcessing)" style="background: @(string.IsNullOrWhiteSpace(adminActionReason) ? "#9ca3af" : "#059669"); color: white; padding: 8px 16px; border: none; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: @(string.IsNullOrWhiteSpace(adminActionReason) ? "not-allowed" : "pointer");">Approve</button>
                                        <button @onclick="() => RejectRequest(item)" disabled="@(string.IsNullOrWhiteSpace(adminActionReason) || isProcessing)" style="background: @(string.IsNullOrWhiteSpace(adminActionReason) ? "#9ca3af" : "#dc2626"); color: white; padding: 8px 16px; border: none; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: @(string.IsNullOrWhiteSpace(adminActionReason) ? "not-allowed" : "pointer");">Reject</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
        
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div style="background: #d1fae5; border: 1px solid #a7f3d0; border-radius: 12px; padding: 16px; margin-top: 16px; color: #059669;">
                @successMessage
            </div>
        }
    }
</div>

@code {
    private string adminActionReason = "";
    private string filterType = "";
    private string filterPriority = "";
    private bool isLoading = true;
    private bool isProcessing = false;
    private string errorMessage = "";
    private string successMessage = "";
    
    private List<ApprovalQueueEntity> pendingApprovals = new();

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }
        
        await LoadData();
    }
    
    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = "";
        successMessage = "";
        
        try
        {
            using var context = DbContextFactory.CreateDbContext();
            pendingApprovals = await context.ApprovalQueues
                .Where(a => a.Status == "Pending")
                .OrderByDescending(a => a.Priority == "Urgent")
                .ThenByDescending(a => a.Priority == "High")
                .ThenByDescending(a => a.RequestedAt)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading approvals: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
    
    private void ApplyFilters()
    {
        // Filters are applied inline in the view
        StateHasChanged();
    }

    private async Task ApproveRequest(ApprovalQueueEntity approval)
    {
        if (string.IsNullOrWhiteSpace(adminActionReason)) return;
        
        isProcessing = true;
        try
        {
            using var context = DbContextFactory.CreateDbContext();
            var entity = await context.ApprovalQueues.FindAsync(approval.ApprovalId);
            if (entity != null)
            {
                entity.Status = "Approved";
                entity.ProcessedAt = DateTime.Now;
                entity.ProcessedBy = $"SuperAdmin: {AuthService.FullName ?? "Admin"}";
                entity.ApprovalNotes = $"[Admin Action] {adminActionReason}";
                await context.SaveChangesAsync();
                
                successMessage = $"Request #{approval.RequestId} approved successfully.";
                adminActionReason = "";
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error approving request: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task RejectRequest(ApprovalQueueEntity approval)
    {
        if (string.IsNullOrWhiteSpace(adminActionReason)) return;
        
        isProcessing = true;
        try
        {
            using var context = DbContextFactory.CreateDbContext();
            var entity = await context.ApprovalQueues.FindAsync(approval.ApprovalId);
            if (entity != null)
            {
                entity.Status = "Rejected";
                entity.ProcessedAt = DateTime.Now;
                entity.ProcessedBy = $"SuperAdmin: {AuthService.FullName ?? "Admin"}";
                entity.ApprovalNotes = $"[Admin Rejection] {adminActionReason}";
                await context.SaveChangesAsync();
                
                successMessage = $"Request #{approval.RequestId} rejected.";
                adminActionReason = "";
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error rejecting request: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private string GetTypeColor(string type) => type switch
    {
        "Loan" => "#4f46e5",
        "Transfer" => "#059669",
        "Deposit" => "#d97706",
        "Withdrawal" => "#dc2626",
        _ => "#6b7280"
    };
    
    private string GetPriorityColor(string? priority) => priority?.ToLower() switch
    {
        "urgent" or "high" => "#fee2e2",
        "medium" => "#fef3c7",
        "low" => "#d1fae5",
        _ => "#f3f4f6"
    };
}
