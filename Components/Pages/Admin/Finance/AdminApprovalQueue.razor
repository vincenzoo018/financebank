@page "/admin/finance-mgr/approval-queue"
@layout AdminLayout
@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="admin-page finance-mgr-page">
    <div class="page-header">
        <h1>
            <span class="role-badge finance">Finance Mgr</span>
            Approval Queue
        </h1>
        <p class="page-subtitle">Review and approve pending financial transactions</p>
    </div>

    <!-- Admin Action Reason -->
    <div class="admin-action-card">
        <div class="alert alert-warning">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 24px; height: 24px;">
                <path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
            <span>You are accessing Finance Manager functions as SuperAdmin. All actions are logged.</span>
        </div>
        <div class="form-group">
            <label for="adminReason">Reason for Admin Action (Required)</label>
            <textarea id="adminReason" @bind="adminActionReason" class="form-control" 
                placeholder="Document why you are performing this action as admin..." rows="2"></textarea>
        </div>
    </div>

    <div class="queue-tabs" style="margin-top: 24px;">
        <button class="tab-btn @(activeTab == "loans" ? "active" : "")" @onclick='() => activeTab = "loans"'>
            Loan Approvals
            <span class="badge">@loanApprovals.Count</span>
        </button>
        <button class="tab-btn @(activeTab == "expenses" ? "active" : "")" @onclick='() => activeTab = "expenses"'>
            Expense Approvals
            <span class="badge">@expenseApprovals.Count</span>
        </button>
        <button class="tab-btn @(activeTab == "disbursements" ? "active" : "")" @onclick='() => activeTab = "disbursements"'>
            Disbursements
            <span class="badge">@disbursementApprovals.Count</span>
        </button>
        <button class="tab-btn @(activeTab == "overrides" ? "active" : "")" @onclick='() => activeTab = "overrides"'>
            Override Requests
            <span class="badge">@overrideRequests.Count</span>
        </button>
    </div>

    <div class="admin-card" style="margin-top: 24px;">
        @if (activeTab == "loans")
        {
            <div class="card-header">
                <h3>Pending Loan Approvals</h3>
            </div>
            <div class="card-body">
                @foreach (var loan in loanApprovals)
                {
                    <div class="approval-item">
                        <div class="approval-info">
                            <div class="approval-header">
                                <strong>@loan.ApplicantName</strong>
                                <span class="loan-type">@loan.LoanType</span>
                            </div>
                            <div class="approval-details">
                                <span>Amount: ₱@loan.Amount.ToString("N2")</span>
                                <span>Term: @loan.Term months</span>
                                <span>Rate: @loan.InterestRate%</span>
                            </div>
                            <div class="approval-meta">
                                Submitted: @loan.SubmittedDate.ToString("MMM dd, yyyy") by @loan.SubmittedBy
                            </div>
                        </div>
                        <div class="approval-actions">
                            <button class="btn btn-success" @onclick="() => ApproveLoan(loan)" disabled="@string.IsNullOrWhiteSpace(adminActionReason)">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 16px; height: 16px;">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                Approve
                            </button>
                            <button class="btn btn-danger" @onclick="() => RejectLoan(loan)" disabled="@string.IsNullOrWhiteSpace(adminActionReason)">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 16px; height: 16px;">
                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                </svg>
                                Reject
                            </button>
                            <button class="btn btn-outline" @onclick="() => ViewLoanDetails(loan)">
                                View Details
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else if (activeTab == "expenses")
        {
            <div class="card-header">
                <h3>Pending Expense Approvals</h3>
            </div>
            <div class="card-body">
                @foreach (var expense in expenseApprovals)
                {
                    <div class="approval-item">
                        <div class="approval-info">
                            <div class="approval-header">
                                <strong>@expense.Description</strong>
                                <span class="expense-category">@expense.Category</span>
                            </div>
                            <div class="approval-details">
                                <span>Amount: ₱@expense.Amount.ToString("N2")</span>
                                <span>Department: @expense.Department</span>
                            </div>
                            <div class="approval-meta">
                                Requested: @expense.RequestedDate.ToString("MMM dd, yyyy") by @expense.RequestedBy
                            </div>
                        </div>
                        <div class="approval-actions">
                            <button class="btn btn-success" @onclick="() => ApproveExpense(expense)" disabled="@string.IsNullOrWhiteSpace(adminActionReason)">
                                Approve
                            </button>
                            <button class="btn btn-danger" @onclick="() => RejectExpense(expense)" disabled="@string.IsNullOrWhiteSpace(adminActionReason)">
                                Reject
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else if (activeTab == "disbursements")
        {
            <div class="card-header">
                <h3>Pending Disbursements</h3>
            </div>
            <div class="card-body">
                @foreach (var disbursement in disbursementApprovals)
                {
                    <div class="approval-item">
                        <div class="approval-info">
                            <div class="approval-header">
                                <strong>@disbursement.Beneficiary</strong>
                                <span class="disbursement-type">@disbursement.Type</span>
                            </div>
                            <div class="approval-details">
                                <span>Amount: ₱@disbursement.Amount.ToString("N2")</span>
                                <span>Account: @disbursement.AccountNumber</span>
                            </div>
                            <div class="approval-meta">
                                Requested: @disbursement.RequestedDate.ToString("MMM dd, yyyy")
                            </div>
                        </div>
                        <div class="approval-actions">
                            <button class="btn btn-success" @onclick="() => ApproveDisbursement(disbursement)" disabled="@string.IsNullOrWhiteSpace(adminActionReason)">
                                Authorize
                            </button>
                            <button class="btn btn-danger" @onclick="() => RejectDisbursement(disbursement)" disabled="@string.IsNullOrWhiteSpace(adminActionReason)">
                                Reject
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else if (activeTab == "overrides")
        {
            <div class="card-header">
                <h3>Override Requests</h3>
            </div>
            <div class="card-body">
                @foreach (var request in overrideRequests)
                {
                    <div class="approval-item override">
                        <div class="approval-info">
                            <div class="approval-header">
                                <strong>@request.RequestType</strong>
                                <span class="priority @request.Priority.ToLower()">@request.Priority</span>
                            </div>
                            <div class="approval-details">
                                <span>@request.Description</span>
                            </div>
                            <div class="approval-meta">
                                Requested: @request.RequestedDate.ToString("MMM dd, yyyy HH:mm") by @request.RequestedBy
                            </div>
                        </div>
                        <div class="approval-actions">
                            <button class="btn btn-success" @onclick="() => ApproveOverride(request)" disabled="@string.IsNullOrWhiteSpace(adminActionReason)">
                                Grant Override
                            </button>
                            <button class="btn btn-danger" @onclick="() => DenyOverride(request)" disabled="@string.IsNullOrWhiteSpace(adminActionReason)">
                                Deny
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .finance-mgr-page .role-badge.finance {
        background: linear-gradient(135deg, #f59e0b, #d97706);
    }
    .queue-tabs {
        display: flex;
        gap: 8px;
        background: white;
        padding: 8px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }
    .tab-btn {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 20px;
        border: none;
        background: transparent;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 500;
        color: #6b7280;
        transition: all 0.2s;
    }
    .tab-btn:hover {
        background: #f3f4f6;
    }
    .tab-btn.active {
        background: #f59e0b;
        color: white;
    }
    .tab-btn .badge {
        background: rgba(0,0,0,0.1);
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 0.8em;
    }
    .tab-btn.active .badge {
        background: rgba(255,255,255,0.3);
    }
    .approval-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        margin-bottom: 16px;
        background: #fafafa;
    }
    .approval-item:last-child {
        margin-bottom: 0;
    }
    .approval-info {
        flex: 1;
    }
    .approval-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 8px;
    }
    .loan-type, .expense-category, .disbursement-type {
        padding: 4px 10px;
        background: #e0e7ff;
        color: #4f46e5;
        border-radius: 6px;
        font-size: 0.8em;
    }
    .approval-details {
        display: flex;
        gap: 20px;
        color: #6b7280;
        font-size: 0.9em;
        margin-bottom: 8px;
    }
    .approval-meta {
        font-size: 0.85em;
        color: #9ca3af;
    }
    .approval-actions {
        display: flex;
        gap: 10px;
    }
    .priority {
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.8em;
        font-weight: 600;
    }
    .priority.high {
        background: #fee2e2;
        color: #dc2626;
    }
    .priority.medium {
        background: #fef3c7;
        color: #d97706;
    }
    .priority.low {
        background: #d1fae5;
        color: #059669;
    }
</style>

@code {
    private string adminActionReason = "";
    private string activeTab = "loans";

    private List<LoanApproval> loanApprovals = new()
    {
        new() { ApplicantName = "Juan Dela Cruz", LoanType = "Personal Loan", Amount = 150000, Term = 24, InterestRate = 12, SubmittedDate = DateTime.Now.AddDays(-2), SubmittedBy = "Teller 1" },
        new() { ApplicantName = "Maria Santos", LoanType = "Business Loan", Amount = 500000, Term = 36, InterestRate = 10, SubmittedDate = DateTime.Now.AddDays(-1), SubmittedBy = "Teller 2" },
        new() { ApplicantName = "Pedro Reyes", LoanType = "Emergency Loan", Amount = 50000, Term = 12, InterestRate = 15, SubmittedDate = DateTime.Now, SubmittedBy = "Teller 1" }
    };

    private List<ExpenseApproval> expenseApprovals = new()
    {
        new() { Description = "Office Equipment", Category = "Capital", Amount = 85000, Department = "Operations", RequestedDate = DateTime.Now.AddDays(-1), RequestedBy = "Admin" },
        new() { Description = "Staff Training", Category = "HR", Amount = 25000, Department = "Human Resources", RequestedDate = DateTime.Now, RequestedBy = "HR Manager" }
    };

    private List<DisbursementApproval> disbursementApprovals = new()
    {
        new() { Beneficiary = "Ana Garcia", Type = "Loan Release", Amount = 200000, AccountNumber = "1234-5678-90", RequestedDate = DateTime.Now.AddDays(-1) },
        new() { Beneficiary = "Jose Rizal", Type = "Loan Release", Amount = 75000, AccountNumber = "0987-6543-21", RequestedDate = DateTime.Now }
    };

    private List<OverrideRequest> overrideRequests = new()
    {
        new() { RequestType = "Transaction Limit Override", Description = "Customer needs to withdraw ₱500,000 (limit: ₱200,000)", Priority = "High", RequestedDate = DateTime.Now.AddHours(-2), RequestedBy = "Teller 3" },
        new() { RequestType = "Fee Waiver", Description = "Waive penalty fee for customer with good standing", Priority = "Medium", RequestedDate = DateTime.Now.AddHours(-4), RequestedBy = "Teller 1" }
    };

    protected override void OnInitialized()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
        }
    }

    private void ApproveLoan(LoanApproval loan) { loanApprovals.Remove(loan); }
    private void RejectLoan(LoanApproval loan) { loanApprovals.Remove(loan); }
    private void ViewLoanDetails(LoanApproval loan) { }
    private void ApproveExpense(ExpenseApproval expense) { expenseApprovals.Remove(expense); }
    private void RejectExpense(ExpenseApproval expense) { expenseApprovals.Remove(expense); }
    private void ApproveDisbursement(DisbursementApproval disbursement) { disbursementApprovals.Remove(disbursement); }
    private void RejectDisbursement(DisbursementApproval disbursement) { disbursementApprovals.Remove(disbursement); }
    private void ApproveOverride(OverrideRequest request) { overrideRequests.Remove(request); }
    private void DenyOverride(OverrideRequest request) { overrideRequests.Remove(request); }

    private class LoanApproval
    {
        public string ApplicantName { get; set; } = "";
        public string LoanType { get; set; } = "";
        public decimal Amount { get; set; }
        public int Term { get; set; }
        public decimal InterestRate { get; set; }
        public DateTime SubmittedDate { get; set; }
        public string SubmittedBy { get; set; } = "";
    }

    private class ExpenseApproval
    {
        public string Description { get; set; } = "";
        public string Category { get; set; } = "";
        public decimal Amount { get; set; }
        public string Department { get; set; } = "";
        public DateTime RequestedDate { get; set; }
        public string RequestedBy { get; set; } = "";
    }

    private class DisbursementApproval
    {
        public string Beneficiary { get; set; } = "";
        public string Type { get; set; } = "";
        public decimal Amount { get; set; }
        public string AccountNumber { get; set; } = "";
        public DateTime RequestedDate { get; set; }
    }

    private class OverrideRequest
    {
        public string RequestType { get; set; } = "";
        public string Description { get; set; } = "";
        public string Priority { get; set; } = "";
        public DateTime RequestedDate { get; set; }
        public string RequestedBy { get; set; } = "";
    }
}
