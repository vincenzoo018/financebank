@page "/admin/finance-mgr/expenses"
@layout AdminLayout
@using Microsoft.EntityFrameworkCore
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IDbContextFactory<BFASDbContext> DbContextFactory

<!-- Page Header - Matching Finance Manager Expenses style -->
<div style="background: linear-gradient(135deg, #059669 0%, #047857 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
            <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="1" />
                <path d="M19.07 4.93l-2.58 2.58A8 8 0 1 0 20.5 12z" />
            </svg>
        </div>
        <div>
            <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Expenses</h1>
            <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Track and manage business expenses</p>
        </div>
    </div>
</div>

<!-- Admin Notice -->
<div style="background: #ede9fe; border: 1px solid #8b5cf6; border-radius: 12px; padding: 16px; margin-bottom: 24px;">
    <div style="display: flex; align-items: start; gap: 12px;">
        <span style="font-size: 24px;">🔐</span>
        <div style="flex: 1;">
            <p style="margin: 0; font-weight: 600; color: #5b21b6;">SuperAdmin Access - Finance Manager Functions</p>
            <p style="margin: 4px 0 8px; font-size: 13px; color: #7c3aed;">All actions are logged for audit purposes.</p>
            <div style="margin-top: 8px;">
                <label style="display: block; font-size: 12px; font-weight: 600; margin-bottom: 6px; color: #5b21b6;">Reason for Admin Action (Required)</label>
                <textarea @bind="adminActionReason" style="width: 100%; padding: 10px; border: 1px solid #c4b5fd; border-radius: 8px; font-size: 14px;" rows="2" placeholder="Document why you are performing this action as admin..."></textarea>
            </div>
        </div>
    </div>
</div>

    @if (isLoading)
    {
        <div style="background: white; border-radius: 16px; padding: 60px; text-align: center; border: 1px solid #e5e7eb;">
            <div class="spinner-border text-primary" role="status"></div>
            <p style="margin-top: 16px; color: #6b7280;">Loading expenses...</p>
        </div>
    }
    else
    {
        <!-- Summary Cards - Matching Finance Manager style -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 24px;">
            <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb;">
                <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 8px;">Total This Month</div>
                <div style="font-size: 32px; font-weight: 700; color: #f59e0b; margin-bottom: 4px;">₱@totalThisMonth.ToString("N2")</div>
                <div style="font-size: 12px; color: #6b7280;">@expenses.Count expense records</div>
            </div>
            <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb;">
                <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 8px;">Pending Approval</div>
                <div style="font-size: 32px; font-weight: 700; color: #dc2626; margin-bottom: 4px;">₱@pendingAmount.ToString("N2")</div>
                <div style="font-size: 12px; color: #6b7280;">@pendingCount awaiting approval</div>
            </div>
            <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb;">
                <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 8px;">Approved/Paid</div>
                <div style="font-size: 32px; font-weight: 700; color: #10b981; margin-bottom: 4px;">₱@approvedAmount.ToString("N2")</div>
                <div style="font-size: 12px; color: #6b7280;">@approvedCount processed</div>
            </div>
        </div>

        <!-- Expenses Table -->
        <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
                <h2 style="font-size: 18px; font-weight: 600; color: #111827; margin: 0;">Expense Records</h2>
                <button style="background: #f3f4f6; color: #374151; padding: 10px 18px; border-radius: 8px; font-size: 14px; font-weight: 600; border: none; cursor: pointer;" @onclick="LoadData">🔄 Refresh</button>
            </div>

            <!-- Filter Bar -->
            <div style="display: flex; gap: 12px; margin-bottom: 20px; flex-wrap: wrap;">
                <input type="text" @bind="searchQuery" @bind:event="oninput" placeholder="Search expenses..." style="flex: 1; min-width: 200px; padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;" />
                <select @bind="statusFilter" style="padding: 10px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;">
                    <option value="">All Statuses</option>
                    <option value="Pending">Pending</option>
                    <option value="Approved">Approved</option>
                    <option value="Paid">Paid</option>
                    <option value="Overdue">Overdue</option>
                </select>
            </div>

            <div style="overflow-x: auto;">
                @if (!filteredExpenses.Any())
                {
                    <div style="text-align: center; padding: 40px; color: #6b7280;">
                        <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" style="margin: 0 auto 16px; opacity: 0.5;">
                            <path d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        <p>No expense records found.</p>
                    </div>
                }
                else
                {
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="background: #f9fafb; border-bottom: 1px solid #e5e7eb;">
                                <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">DATE</th>
                                <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">VENDOR</th>
                                <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">INVOICE #</th>
                                <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">CATEGORY</th>
                                <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">AMOUNT</th>
                                <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">DUE DATE</th>
                                <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">STATUS</th>
                                <th style="padding: 12px; text-align: center; font-size: 12px; color: #6b7280;">ACTIONS</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var expense in filteredExpenses)
                            {
                                <tr style="border-bottom: 1px solid #e5e7eb;">
                                    <td style="padding: 12px; font-size: 13px; color: #111827;">@expense.InvoiceDate.ToString("MMM dd, yyyy")</td>
                                    <td style="padding: 12px; font-size: 13px; color: #111827; font-weight: 600;">@expense.VendorName</td>
                                    <td style="padding: 12px; font-size: 13px; color: #4b5563;">@expense.InvoiceNumber</td>
                                    <td style="padding: 12px;">
                                        <span style="display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; background: @GetCategoryBg(DetermineCategory(expense.Description ?? expense.VendorName)); color: @GetCategoryColor(DetermineCategory(expense.Description ?? expense.VendorName));">
                                            @DetermineCategory(expense.Description ?? expense.VendorName)
                                        </span>
                                    </td>
                                    <td style="padding: 12px; font-size: 13px; color: #111827; font-weight: 600;">₱@expense.Amount.ToString("N2")</td>
                                    <td style="padding: 12px; font-size: 13px; color: #4b5563;">@expense.DueDate.ToString("MMM dd, yyyy")</td>
                                    <td style="padding: 12px;">
                                        <span style="display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; background: @GetStatusBg(expense.Status); color: @GetStatusColor(expense.Status);">
                                            @expense.Status
                                        </span>
                                    </td>
                                    <td style="padding: 12px; text-align: center;">
                                        @if (expense.Status == "Pending")
                                        {
                                            <button @onclick="() => ApproveExpense(expense)" disabled="@(string.IsNullOrWhiteSpace(adminActionReason) || isProcessing)"
                                                    style="background: @(string.IsNullOrWhiteSpace(adminActionReason) ? "#9ca3af" : "#059669"); color: white; padding: 6px 12px; font-size: 12px; border-radius: 6px; font-weight: 600; border: none; cursor: @(string.IsNullOrWhiteSpace(adminActionReason) ? "not-allowed" : "pointer"); margin-right: 4px;">
                                                Approve
                                            </button>
                                            <button @onclick="() => MarkAsPaid(expense)" disabled="@(string.IsNullOrWhiteSpace(adminActionReason) || isProcessing)"
                                                    style="background: @(string.IsNullOrWhiteSpace(adminActionReason) ? "#9ca3af" : "#3b82f6"); color: white; padding: 6px 12px; font-size: 12px; border-radius: 6px; font-weight: 600; border: none; cursor: @(string.IsNullOrWhiteSpace(adminActionReason) ? "not-allowed" : "pointer");">
                                                Pay
                                            </button>
                                        }
                                        @if (expense.Status == "Approved")
                                        {
                                            <button @onclick="() => MarkAsPaid(expense)" disabled="@(string.IsNullOrWhiteSpace(adminActionReason) || isProcessing)"
                                                    style="background: @(string.IsNullOrWhiteSpace(adminActionReason) ? "#9ca3af" : "#3b82f6"); color: white; padding: 6px 12px; font-size: 12px; border-radius: 6px; font-weight: 600; border: none; cursor: @(string.IsNullOrWhiteSpace(adminActionReason) ? "not-allowed" : "pointer");">
                                                Mark Paid
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
        
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div style="background: #d1fae5; border: 1px solid #a7f3d0; border-radius: 12px; padding: 16px; margin-top: 16px; color: #059669;">
                @successMessage
            </div>
        }
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 12px; padding: 16px; margin-top: 16px; color: #dc2626;">
                @errorMessage
            </div>
        }
    }

@code {
    private string adminActionReason = "";
    private string searchQuery = "";
    private string statusFilter = "";
    private bool isLoading = true;
    private bool isProcessing = false;
    private string successMessage = "";
    private string errorMessage = "";

    private decimal totalThisMonth = 0;
    private decimal approvedAmount = 0;
    private decimal pendingAmount = 0;

    private List<AccountsPayable> expenses = new();
    private List<AccountsPayable> filteredExpenses => expenses
        .Where(e => 
            (string.IsNullOrEmpty(searchQuery) || 
             (e.VendorName?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) || 
             (e.InvoiceNumber?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
             (e.Description?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false)) &&
            (string.IsNullOrEmpty(statusFilter) || e.Status == statusFilter))
        .OrderByDescending(e => e.InvoiceDate)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }
        
        await LoadData();
    }
    
    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = "";
        successMessage = "";
        
        try
        {
            using var context = DbContextFactory.CreateDbContext();
            expenses = await context.AccountsPayables
                .OrderByDescending(ap => ap.InvoiceDate)
                .ToListAsync();
            
            CalculateStats();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading expenses: {ex.Message}";
            expenses = new List<AccountsPayable>();
        }
        finally
        {
            isLoading = false;
        }
    }
    
    private void CalculateStats()
    {
        var today = DateTime.Today;
        var monthStart = new DateTime(today.Year, today.Month, 1);
        var monthEnd = monthStart.AddMonths(1).AddDays(-1);

        totalThisMonth = expenses.Where(e => e.InvoiceDate >= monthStart && e.InvoiceDate <= monthEnd).Sum(e => e.Amount);
        pendingAmount = expenses.Where(e => e.Status == "Pending").Sum(e => e.Amount);
        approvedAmount = expenses.Where(e => e.Status == "Paid" || e.Status == "Approved").Sum(e => e.Amount);
    }
    
    private async Task ApproveExpense(AccountsPayable expense)
    {
        if (string.IsNullOrWhiteSpace(adminActionReason)) return;
        
        isProcessing = true;
        try
        {
            using var context = DbContextFactory.CreateDbContext();
            var entity = await context.AccountsPayables.FindAsync(expense.PayableId);
            if (entity != null)
            {
                entity.Status = "Approved";
                entity.Description = $"[Admin Approved] {adminActionReason} | " + (entity.Description ?? "");
                await context.SaveChangesAsync();
                
                successMessage = $"Expense #{expense.InvoiceNumber} approved.";
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error approving expense: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }
    
    private async Task MarkAsPaid(AccountsPayable expense)
    {
        if (string.IsNullOrWhiteSpace(adminActionReason)) return;
        
        isProcessing = true;
        try
        {
            using var context = DbContextFactory.CreateDbContext();
            var entity = await context.AccountsPayables.FindAsync(expense.PayableId);
            if (entity != null)
            {
                entity.Status = "Paid";
                entity.PaidAmount = entity.Amount;
                entity.OutstandingAmount = 0;
                entity.Description = $"[Admin Marked Paid] {adminActionReason} | " + (entity.Description ?? "");
                await context.SaveChangesAsync();
                
                successMessage = $"Expense #{expense.InvoiceNumber} marked as paid.";
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error marking expense as paid: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private string DetermineCategory(string description)
    {
        var desc = description.ToLower();
        if (desc.Contains("office") || desc.Contains("supplies")) return "Supplies";
        if (desc.Contains("utility") || desc.Contains("electric") || desc.Contains("water")) return "Utilities";
        if (desc.Contains("salary") || desc.Contains("payroll") || desc.Contains("wage")) return "Salaries";
        if (desc.Contains("rent") || desc.Contains("lease")) return "Rent";
        if (desc.Contains("maintenance") || desc.Contains("repair")) return "Maintenance";
        if (desc.Contains("marketing") || desc.Contains("advertising")) return "Marketing";
        return "Operations";
    }

    private string GetCategoryColor(string category) => category switch
    {
        "Operations" => "#92400e",
        "Salaries" => "#1e40af",
        "Utilities" => "#065f46",
        "Maintenance" => "#5b21b6",
        "Supplies" => "#991b1b",
        "Rent" => "#155e75",
        "Marketing" => "#9d174d",
        _ => "#4b5563"
    };
    
    private string GetCategoryBg(string category) => category switch
    {
        "Operations" => "#fef3c7",
        "Salaries" => "#dbeafe",
        "Utilities" => "#d1fae5",
        "Maintenance" => "#ede9fe",
        "Supplies" => "#fee2e2",
        "Rent" => "#cffafe",
        "Marketing" => "#fce7f3",
        _ => "#f3f4f6"
    };

    private string GetStatusBg(string status) => status switch
    {
        "Pending" => "#fef3c7",
        "Approved" => "#dbeafe",
        "Paid" => "#d1fae5",
        "Overdue" => "#fee2e2",
        _ => "#f3f4f6"
    };
    
    private string GetStatusColor(string status) => status switch
    {
        "Pending" => "#92400e",
        "Approved" => "#1e40af",
        "Paid" => "#065f46",
        "Overdue" => "#991b1b",
        _ => "#4b5563"
    };
    
    private int pendingCount => expenses.Count(e => e.Status == "Pending");
    private int approvedCount => expenses.Count(e => e.Status == "Paid" || e.Status == "Approved");
}
