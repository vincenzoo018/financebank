@page "/admin/finance-mgr/expenses"
@layout AdminLayout
@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="admin-page finance-mgr-page">
    <div class="page-header">
        <h1>
            <span class="role-badge finance">Finance Mgr</span>
            Expense Management
        </h1>
        <p class="page-subtitle">Track and manage operational expenses</p>
    </div>

    <!-- Admin Action Reason -->
    <div class="admin-action-card">
        <div class="alert alert-warning">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 24px; height: 24px;">
                <path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
            <span>You are accessing Finance Manager functions as SuperAdmin. All actions are logged.</span>
        </div>
        <div class="form-group">
            <label for="adminReason">Reason for Admin Action (Required)</label>
            <textarea id="adminReason" @bind="adminActionReason" class="form-control" 
                placeholder="Document why you are performing this action as admin..." rows="2"></textarea>
        </div>
    </div>

    <div class="expense-summary" style="margin-top: 24px;">
        <div class="summary-card">
            <div class="summary-icon" style="background: #3b82f6;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 24px; height: 24px;">
                    <line x1="12" y1="1" x2="12" y2="23"></line>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                </svg>
            </div>
            <div class="summary-content">
                <div class="summary-label">Total This Month</div>
                <div class="summary-value">₱@totalThisMonth.ToString("N0")</div>
            </div>
        </div>
        <div class="summary-card">
            <div class="summary-icon" style="background: #10b981;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 24px; height: 24px;">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
            <div class="summary-content">
                <div class="summary-label">Approved</div>
                <div class="summary-value">₱@approvedAmount.ToString("N0")</div>
            </div>
        </div>
        <div class="summary-card">
            <div class="summary-icon" style="background: #f59e0b;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 24px; height: 24px;">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
            </div>
            <div class="summary-content">
                <div class="summary-label">Pending</div>
                <div class="summary-value">₱@pendingAmount.ToString("N0")</div>
            </div>
        </div>
        <div class="summary-card">
            <div class="summary-icon" style="background: #8b5cf6;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 24px; height: 24px;">
                    <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                    <line x1="9" y1="9" x2="15" y2="9"></line>
                    <line x1="9" y1="15" x2="15" y2="15"></line>
                </svg>
            </div>
            <div class="summary-content">
                <div class="summary-label">Budget Remaining</div>
                <div class="summary-value">₱@budgetRemaining.ToString("N0")</div>
            </div>
        </div>
    </div>

    <div class="admin-card" style="margin-top: 24px;">
        <div class="card-header">
            <h3>Expense Records</h3>
            <button class="btn btn-primary" @onclick="NewExpense">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 16px; height: 16px;">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Record Expense
            </button>
        </div>
        <div class="card-body">
            <div class="table-filters">
                <div class="filter-group">
                    <input type="text" class="form-control" placeholder="Search expenses..." @bind="searchQuery" />
                </div>
                <div class="filter-group">
                    <select class="form-select" @bind="categoryFilter">
                        <option value="">All Categories</option>
                        <option value="operations">Operations</option>
                        <option value="salaries">Salaries</option>
                        <option value="utilities">Utilities</option>
                        <option value="maintenance">Maintenance</option>
                        <option value="supplies">Supplies</option>
                        <option value="other">Other</option>
                    </select>
                </div>
                <div class="filter-group">
                    <select class="form-select" @bind="statusFilter">
                        <option value="">All Statuses</option>
                        <option value="pending">Pending</option>
                        <option value="approved">Approved</option>
                        <option value="rejected">Rejected</option>
                        <option value="paid">Paid</option>
                    </select>
                </div>
            </div>

            <table class="table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Description</th>
                        <th>Category</th>
                        <th>Amount</th>
                        <th>Requested By</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var expense in expenses)
                    {
                        <tr>
                            <td>@expense.Date.ToString("MMM dd, yyyy")</td>
                            <td><strong>@expense.Description</strong></td>
                            <td>
                                <span class="category-tag" style="background: @GetCategoryColor(expense.Category);">
                                    @expense.Category
                                </span>
                            </td>
                            <td>₱@expense.Amount.ToString("N2")</td>
                            <td>@expense.RequestedBy</td>
                            <td>
                                <span class="badge @GetStatusBadgeClass(expense.Status)">@expense.Status</span>
                            </td>
                            <td>
                                <div class="action-buttons">
                                    <button class="btn btn-sm btn-outline" @onclick="() => ViewExpense(expense)" title="View">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 14px; height: 14px;">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                            <circle cx="12" cy="12" r="3"></circle>
                                        </svg>
                                    </button>
                                    @if (expense.Status == "Pending")
                                    {
                                        <button class="btn btn-sm btn-success" @onclick="() => ApproveExpense(expense)" 
                                            disabled="@string.IsNullOrWhiteSpace(adminActionReason)" title="Approve">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 14px; height: 14px;">
                                                <polyline points="20 6 9 17 4 12"></polyline>
                                            </svg>
                                        </button>
                                        <button class="btn btn-sm btn-danger" @onclick="() => RejectExpense(expense)"
                                            disabled="@string.IsNullOrWhiteSpace(adminActionReason)" title="Reject">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 14px; height: 14px;">
                                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                                <line x1="6" y1="6" x2="18" y2="18"></line>
                                            </svg>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="admin-card" style="margin-top: 24px;">
        <div class="card-header">
            <h3>Expense by Category</h3>
        </div>
        <div class="card-body">
            <div class="category-breakdown">
                @foreach (var category in categoryBreakdown)
                {
                    <div class="category-item">
                        <div class="category-info">
                            <span class="category-name">@category.Name</span>
                            <span class="category-amount">₱@category.Amount.ToString("N0")</span>
                        </div>
                        <div class="category-bar">
                            <div class="category-fill" style="width: @category.Percentage%; background: @category.Color;"></div>
                        </div>
                        <span class="category-percent">@category.Percentage%</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .finance-mgr-page .role-badge.finance {
        background: linear-gradient(135deg, #f59e0b, #d97706);
    }
    .expense-summary {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
    }
    .summary-card {
        display: flex;
        align-items: center;
        gap: 16px;
        background: white;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }
    .summary-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
    }
    .summary-label {
        font-size: 0.85em;
        color: #6b7280;
    }
    .summary-value {
        font-size: 1.5em;
        font-weight: 700;
        color: #1f2937;
    }
    .table-filters {
        display: flex;
        gap: 16px;
        margin-bottom: 20px;
    }
    .filter-group {
        flex: 1;
        max-width: 250px;
    }
    .category-tag {
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.8em;
        color: white;
    }
    .action-buttons {
        display: flex;
        gap: 8px;
    }
    .btn-sm {
        padding: 4px 8px;
        font-size: 0.85em;
    }
    .category-breakdown {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }
    .category-item {
        display: flex;
        align-items: center;
        gap: 16px;
    }
    .category-info {
        width: 200px;
        display: flex;
        justify-content: space-between;
    }
    .category-name {
        font-weight: 500;
    }
    .category-amount {
        color: #6b7280;
    }
    .category-bar {
        flex: 1;
        height: 24px;
        background: #f3f4f6;
        border-radius: 6px;
        overflow: hidden;
    }
    .category-fill {
        height: 100%;
        border-radius: 6px;
    }
    .category-percent {
        width: 50px;
        text-align: right;
        font-weight: 600;
        color: #6b7280;
    }
</style>

@code {
    private string adminActionReason = "";
    private string searchQuery = "";
    private string categoryFilter = "";
    private string statusFilter = "";

    private decimal totalThisMonth = 485000;
    private decimal approvedAmount = 320000;
    private decimal pendingAmount = 165000;
    private decimal budgetRemaining = 515000;

    private List<ExpenseItem> expenses = new()
    {
        new() { Date = DateTime.Now, Description = "Office Supplies Purchase", Category = "Supplies", Amount = 15000, RequestedBy = "Admin", Status = "Pending" },
        new() { Date = DateTime.Now.AddDays(-1), Description = "Monthly Electricity Bill", Category = "Utilities", Amount = 45000, RequestedBy = "Facilities", Status = "Approved" },
        new() { Date = DateTime.Now.AddDays(-2), Description = "Staff Salaries", Category = "Salaries", Amount = 250000, RequestedBy = "HR", Status = "Paid" },
        new() { Date = DateTime.Now.AddDays(-3), Description = "AC Maintenance", Category = "Maintenance", Amount = 12000, RequestedBy = "Facilities", Status = "Approved" },
        new() { Date = DateTime.Now.AddDays(-5), Description = "Security Services", Category = "Operations", Amount = 35000, RequestedBy = "Admin", Status = "Paid" }
    };

    private List<CategoryBreakdown> categoryBreakdown = new()
    {
        new() { Name = "Salaries", Amount = 250000, Percentage = 52, Color = "#3b82f6" },
        new() { Name = "Utilities", Amount = 45000, Percentage = 9, Color = "#10b981" },
        new() { Name = "Operations", Amount = 85000, Percentage = 18, Color = "#f59e0b" },
        new() { Name = "Maintenance", Amount = 55000, Percentage = 11, Color = "#8b5cf6" },
        new() { Name = "Supplies", Amount = 50000, Percentage = 10, Color = "#ef4444" }
    };

    protected override void OnInitialized()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
        }
    }

    private string GetCategoryColor(string category) => category switch
    {
        "Operations" => "#f59e0b",
        "Salaries" => "#3b82f6",
        "Utilities" => "#10b981",
        "Maintenance" => "#8b5cf6",
        "Supplies" => "#ef4444",
        _ => "#6b7280"
    };

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Pending" => "badge-warning",
        "Approved" => "badge-info",
        "Rejected" => "badge-danger",
        "Paid" => "badge-success",
        _ => "badge-secondary"
    };

    private void NewExpense() { }
    private void ViewExpense(ExpenseItem expense) { }
    private void ApproveExpense(ExpenseItem expense) { expense.Status = "Approved"; }
    private void RejectExpense(ExpenseItem expense) { expense.Status = "Rejected"; }

    private class ExpenseItem
    {
        public DateTime Date { get; set; }
        public string Description { get; set; } = "";
        public string Category { get; set; } = "";
        public decimal Amount { get; set; }
        public string RequestedBy { get; set; } = "";
        public string Status { get; set; } = "";
    }

    private class CategoryBreakdown
    {
        public string Name { get; set; } = "";
        public decimal Amount { get; set; }
        public int Percentage { get; set; }
        public string Color { get; set; } = "";
    }
}
