@page "/admin/finance/cashflow-analysis"
@layout AdminLayout
@inject CashflowAnalysisService CashflowAnalysisService

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #0891b2 0%, #0e7490 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
            <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"/>
            </svg>
        </div>
        <div>
            <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Cashflow Analysis</h1>
            <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Monitor cash inflows and outflows</p>
        </div>
    </div>
</div>

<!-- Action Bar & Filters -->
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <div style="display: flex; gap: 12px;">
        <button class="btn" style="background: #10b981; color: white; padding: 10px 20px; font-weight: 600;" @onclick='() => SetPeriod("Today")'>
            Today
        </button>
        <button class="btn" style="background: #0ea5e9; color: white; padding: 10px 20px; font-weight: 600;" @onclick='() => SetPeriod("ThisWeek")'>
            This Week
        </button>
        <button class="btn" style="background: #6366f1; color: white; padding: 10px 20px; font-weight: 600;" @onclick='() => SetPeriod("ThisMonth")'>
            This Month
        </button>
        <button class="btn" style="background: white; border: 2px solid var(--border); color: #374151; padding: 10px 20px; font-weight: 600;" @onclick='() => SetPeriod("All")'>
            All Time
        </button>
    </div>
    <button class="btn" style="background: #0891b2; color: white; padding: 10px 20px; font-weight: 600;" @onclick="ShowCreateEntryModal">
        ➕ New Entry
    </button>
</div>

<!-- Summary Cards -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 24px;">
    <div style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); border-radius: 16px; padding: 24px; border: 2px solid #6ee7b7;">
        <div style="font-size: 13px; color: #065f46; font-weight: 600; margin-bottom: 8px;">NET CASHFLOW (@selectedPeriodLabel)</div>
        <div style="font-size: 32px; font-weight: 700; color: @(netCashflow >= 0 ? "#065f46" : "#b91c1c");">₱@netCashflow.ToString("N2")</div>
        <div style="font-size: 12px; color: #065f46; margin-top: 4px;">Inflow minus outflow</div>
    </div>
    <div style="background: linear-gradient(135deg, #e0f2fe, #bfdbfe); border-radius: 16px; padding: 24px; border: 2px solid #60a5fa;">
        <div style="font-size: 13px; color: #1e40af; font-weight: 600; margin-bottom: 8px;">TOTAL INFLOW</div>
        <div style="font-size: 32px; font-weight: 700; color: #1e40af;">₱@totalInflow.ToString("N2")</div>
        <div style="font-size: 12px; color: #1e40af; margin-top: 4px;">Cash coming in</div>
    </div>
    <div style="background: linear-gradient(135deg, #fee2e2, #fecaca); border-radius: 16px; padding: 24px; border: 2px solid #f87171;">
        <div style="font-size: 13px; color: #991b1b; font-weight: 600; margin-bottom: 8px;">TOTAL OUTFLOW</div>
        <div style="font-size: 32px; font-weight: 700; color: #991b1b;">₱@totalOutflow.ToString("N2")</div>
        <div style="font-size: 12px; color: #991b1b; margin-top: 4px;">Cash going out</div>
    </div>
</div>

<!-- Cashflow Table -->
<div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid var(--border);">
    <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 20px;">Cashflow Entries</h3>

    <table style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr style="border-bottom: 2px solid var(--border); background: #f9fafb;">
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">DATE</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">TYPE</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">CATEGORY</th>
                <th style="padding: 12px; text-align: right; font-size: 12px; font-weight: 700;">AMOUNT</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">DESCRIPTION</th>
                <th style="padding: 12px; text-align: center; font-size: 12px; font-weight: 700;">ACTIONS</th>
            </tr>
        </thead>
        <tbody>
            @if (entries == null || entries.Count == 0)
            {
                <tr>
                    <td colspan="6" style="padding: 16px; text-align: center; color: #6b7280; font-size: 14px;">No cashflow entries found.</td>
                </tr>
            }
            else
            {
                @foreach (var item in GetFilteredEntries())
                {
                    var isInflow = string.Equals(item.EntryType, "Inflow", StringComparison.OrdinalIgnoreCase);
                    <tr style="border-bottom: 1px solid var(--border); transition: background 0.2s;">
                        <td style="padding: 16px; font-size: 14px;">@item.TransactionDate.ToString("MMM dd, yyyy")</td>
                        <td style="padding: 16px; font-size: 13px; font-weight: 600; color: @(isInflow ? "#16a34a" : "#b91c1c");">@item.EntryType</td>
                        <td style="padding: 16px; font-size: 14px;">@item.Category</td>
                        <td style="padding: 16px; text-align: right; font-size: 15px; font-weight: 700; color: @(isInflow ? "#16a34a" : "#b91c1c");">₱@item.Amount.ToString("N2")</td>
                        <td style="padding: 16px; font-size: 13px; color: #6b7280; max-width: 280px;">@item.Description</td>
                        <td style="padding: 16px; text-align: center;">
                            <button class="btn" style="background: white; border: 2px solid #e5e7eb; color: #374151; padding: 6px 12px; font-size: 13px;" @onclick='() => OpenDetails(item)'>
                                View
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- Details Modal -->
<div style="display: @(showAnalysisDetailsModal ? "flex" : "none"); position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000;">
    <div style="background: white; border-radius: 16px; padding: 32px; max-width: 480px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
        <h2 style="font-size: 20px; font-weight: 700; margin: 0 0 16px 0;">Cashflow Details</h2>

        @if (selectedEntry != null)
        {
            var isInflow = string.Equals(selectedEntry.EntryType, "Inflow", StringComparison.OrdinalIgnoreCase);
            <div style="display: grid; grid-template-columns: 1fr; gap: 8px; font-size: 14px; color: #374151; margin-bottom: 16px;">
                <div><strong>Date:</strong> @selectedEntry.TransactionDate.ToString("yyyy-MM-dd")</div>
                <div><strong>Type:</strong> @selectedEntry.EntryType</div>
                <div><strong>Category:</strong> @selectedEntry.Category</div>
                <div><strong>Amount:</strong> ₱@selectedEntry.Amount.ToString("N2")</div>
                <div><strong>Description:</strong> @selectedEntry.Description</div>
            </div>
        }

        <div style="display: flex; justify-content: flex-end;">
            <button class="btn" style="background: #e5e7eb; color: #374151; padding: 8px 18px; font-weight: 600;" @onclick="CloseAnalysisDetailsModal">Close</button>
        </div>
    </div>
</div>

<!-- Create Entry Modal -->
<div style="display: @(showCreateEntryModal ? "flex" : "none"); position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000;">
    <div style="background: white; border-radius: 16px; padding: 32px; max-width: 520px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
        <h2 style="font-size: 20px; font-weight: 700; margin: 0 0 24px 0;">➕ New Cashflow Entry</h2>

        <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label">Entry Type</label>
            <select class="form-control" @bind="newEntry_Type">
                <option value="Inflow">Inflow</option>
                <option value="Outflow">Outflow</option>
            </select>
        </div>

        <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label">Category</label>
            <input type="text" class="form-control" @bind="newEntry_Category" placeholder="e.g., Sales, Operating Expenses, Loan" />
        </div>

        <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label">Amount (₱)</label>
            <input type="number" class="form-control" @bind="newEntry_Amount" step="0.01" placeholder="0.00" />
        </div>

        <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label">Transaction Date</label>
            <input type="date" class="form-control" @bind="newEntry_TransactionDate" />
        </div>

        <div class="form-group" style="margin-bottom: 24px;">
            <label class="form-label">Description</label>
            <textarea class="form-control" @bind="newEntry_Description" placeholder="Describe the transaction" style="min-height: 80px;"></textarea>
        </div>

        <div style="display: flex; gap: 12px; justify-content: flex-end;">
            <button class="btn" style="background: #e5e7eb; color: #374151; padding: 10px 20px; font-weight: 600;" @onclick="CloseCreateEntryModal">Cancel</button>
            <button class="btn" style="background: #0891b2; color: white; padding: 10px 20px; font-weight: 600;" @onclick="CreateEntry">Create Entry</button>
        </div>
    </div>
</div>

@code {
    private List<CashflowEntry> entries = new();
    private bool showAnalysisDetailsModal = false;
    private bool showCreateEntryModal = false;
    private string selectedPeriod = "ThisMonth";
    private string selectedPeriodLabel = "This Month";

    private decimal totalInflow;
    private decimal totalOutflow;
    private decimal netCashflow;

    private CashflowEntry? selectedEntry;

    private string newEntry_Type = "Inflow";
    private string newEntry_Category = string.Empty;
    private decimal newEntry_Amount = 0;
    private DateTime newEntry_TransactionDate = DateTime.Today;
    private string newEntry_Description = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            entries = await CashflowAnalysisService.GetAllAsync();
            CalculateSummary();
        }
        catch
        {
        }
    }

    private void SetPeriod(string period)
    {
        selectedPeriod = period;
        selectedPeriodLabel = period switch
        {
            "Today" => "Today",
            "ThisWeek" => "This Week",
            "ThisMonth" => "This Month",
            _ => "All Time"
        };
        CalculateSummary();
    }

    private IEnumerable<CashflowEntry> GetFilteredEntries()
    {
        if (entries == null || entries.Count == 0) return Enumerable.Empty<CashflowEntry>();

        var today = DateTime.Today;
        DateTime start = selectedPeriod switch
        {
            "Today" => today,
            "ThisWeek" => today.AddDays(-7),
            "ThisMonth" => new DateTime(today.Year, today.Month, 1),
            _ => DateTime.MinValue
        };

        return entries
            .Where(e => e.TransactionDate.Date >= start && e.TransactionDate.Date <= today)
            .OrderByDescending(e => e.TransactionDate)
            .ThenByDescending(e => e.CreatedAt);
    }

    private void CalculateSummary()
    {
        var filtered = GetFilteredEntries().ToList();
        totalInflow = filtered
            .Where(e => string.Equals(e.EntryType, "Inflow", StringComparison.OrdinalIgnoreCase))
            .Sum(e => e.Amount);
        totalOutflow = filtered
            .Where(e => string.Equals(e.EntryType, "Outflow", StringComparison.OrdinalIgnoreCase))
            .Sum(e => e.Amount);
        netCashflow = totalInflow - totalOutflow;
    }

    private void OpenDetails(CashflowEntry entry)
    {
        selectedEntry = entry;
        showAnalysisDetailsModal = true;
    }

    private void CloseAnalysisDetailsModal()
    {
        showAnalysisDetailsModal = false;
        selectedEntry = null;
    }

    private void ShowCreateEntryModal()
    {
        newEntry_Type = "Inflow";
        newEntry_Category = string.Empty;
        newEntry_Amount = 0;
        newEntry_TransactionDate = DateTime.Today;
        newEntry_Description = string.Empty;
        showCreateEntryModal = true;
    }

    private void CloseCreateEntryModal()
    {
        showCreateEntryModal = false;
    }

    private async Task CreateEntry()
    {
        if (string.IsNullOrWhiteSpace(newEntry_Category) || newEntry_Amount <= 0)
        {
            return;
        }

        var entry = new CashflowEntry
        {
            EntryType = newEntry_Type,
            Category = newEntry_Category,
            Amount = newEntry_Amount,
            TransactionDate = newEntry_TransactionDate,
            Description = newEntry_Description,
            CreatedBy = "FinanceManager"
        };

        try
        {
            await CashflowAnalysisService.CreateAsync(entry);
            entries = await CashflowAnalysisService.GetAllAsync();
            CalculateSummary();

            newEntry_Type = "Inflow";
            newEntry_Category = string.Empty;
            newEntry_Amount = 0;
            newEntry_TransactionDate = DateTime.Today;
            newEntry_Description = string.Empty;

            showCreateEntryModal = false;
        }
        catch
        {
        }
    }
}

