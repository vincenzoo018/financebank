@page "/admin/finance/payables"
@layout AdminLayout
@inject AccountsPayableService AccountsPayableService

<div class="section-header">
    <h2 class="section-title">💰 Accounts Payable</h2>
    <p style="color: var(--text-secondary); font-size: 14px; margin-top: 8px;">
        Manage vendor bills, payments, and outstanding payables
    </p>
</div>

<!-- Action Bar -->
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <div style="display: flex; gap: 12px;">
        <button class="btn" style="background: #10b981; color: white; padding: 12px 24px; font-weight: 600;" @onclick="() => showNewBillModal = true">
            ➕ New Bill
        </button>
        <button class="btn" style="background: #3b82f6; color: white; padding: 12px 24px;" disabled>
            💳 Record Payment
        </button>
    </div>
    <div style="display: flex; gap: 12px;">
        <button class="btn" style="background: white; border: 2px solid var(--border); color: #374151; padding: 12px 24px;">
            📊 Aging Report
        </button>
        <button class="btn" style="background: white; border: 2px solid var(--border); color: #374151; padding: 12px 24px;">
            📥 Export
        </button>
    </div>
</div>

<!-- Summary Cards -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 24px;">
    <div style="background: linear-gradient(135deg, #fee2e2, #fecaca); border-radius: 16px; padding: 24px; border: 2px solid #fca5a5;">
        <div style="font-size: 13px; color: #991b1b; font-weight: 600; margin-bottom: 8px;">💸 TOTAL PAYABLES</div>
        <div style="font-size: 32px; font-weight: 700; color: #991b1b;">₱@totalOutstanding.ToString("N2")</div>
        <div style="font-size: 12px; color: #991b1b; margin-top: 4px;">Outstanding balance</div>
    </div>
    <div style="background: linear-gradient(135deg, #fef3c7, #fde68a); border-radius: 16px; padding: 24px; border: 2px solid #fcd34d;">
        <div style="font-size: 13px; color: #92400e; font-weight: 600; margin-bottom: 8px;">⏰ DUE THIS WEEK</div>
        <div style="font-size: 32px; font-weight: 700; color: #92400e;">₱@dueThisWeekAmount.ToString("N2")</div>
        <div style="font-size: 12px; color: #92400e; margin-top: 4px;">@dueThisWeekCount bills due</div>
    </div>
    <div style="background: linear-gradient(135deg, #fee2e2, #fecaca); border-radius: 16px; padding: 24px; border: 2px solid #f87171;">
        <div style="font-size: 13px; color: #991b1b; font-weight: 600; margin-bottom: 8px;">🚨 OVERDUE</div>
        <div style="font-size: 32px; font-weight: 700; color: #991b1b;">₱@overdueAmount.ToString("N2")</div>
        <div style="font-size: 12px; color: #991b1b; margin-top: 4px;">@overdueCount overdue bills</div>
    </div>
    <div style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); border-radius: 16px; padding: 24px; border: 2px solid #6ee7b7;">
        <div style="font-size: 13px; color: #065f46; font-weight: 600; margin-bottom: 8px;">✅ PAID THIS MONTH</div>
        <div style="font-size: 32px; font-weight: 700; color: #065f46;">₱@paidThisMonthAmount.ToString("N2")</div>
        <div style="font-size: 12px; color: #065f46; margin-top: 4px;">@paidThisMonthCount bills paid</div>
    </div>
</div>

<!-- Filters -->
<div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid var(--border); margin-bottom: 24px;">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px;">
        <div class="form-group">
            <label class="form-label">Status</label>
            <select class="form-control">
                <option>All Statuses</option>
                <option>Unpaid</option>
                <option>Partially Paid</option>
                <option>Paid</option>
                <option>Overdue</option>
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">Vendor</label>
            <select class="form-control">
                <option>All Vendors</option>
                <option>ABC Supplies Co.</option>
                <option>Tech Solutions Inc.</option>
                <option>Office Equipment Ltd.</option>
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">Due Date</label>
            <select class="form-control">
                <option>All Dates</option>
                <option>Due This Week</option>
                <option>Due This Month</option>
                <option>Overdue</option>
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">Amount Range</label>
            <select class="form-control">
                <option>All Amounts</option>
                <option>Under ₱10,000</option>
                <option>₱10,000 - ₱50,000</option>
                <option>Over ₱50,000</option>
            </select>
        </div>
    </div>
</div>

<!-- Payables Table -->
<div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid var(--border);">
    <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 20px;">Outstanding Payables</h3>

    <table style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr style="border-bottom: 2px solid var(--border); background: #f9fafb;">
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">BILL NO.</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">VENDOR</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">BILL DATE</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">DUE DATE</th>
                <th style="padding: 12px; text-align: right; font-size: 12px; font-weight: 700;">BILL AMOUNT</th>
                <th style="padding: 12px; text-align: right; font-size: 12px; font-weight: 700;">AMOUNT PAID</th>
                <th style="padding: 12px; text-align: right; font-size: 12px; font-weight: 700;">BALANCE DUE</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">STATUS</th>
                <th style="padding: 12px; text-align: center; font-size: 12px; font-weight: 700;">ACTIONS</th>
            </tr>
        </thead>
        <tbody>
            @if (payables == null || payables.Count == 0)
            {
                <tr>
                    <td colspan="9" style="padding: 16px; text-align: center; color: #6b7280; font-size: 14px;">No payables found.</td>
                </tr>
            }
            else
            {
                @foreach (var bill in payables)
                {
                    var isOverdue = bill.DueDate.Date < DateTime.Today && bill.OutstandingAmount > 0;
                    var isPaid = string.Equals(bill.Status, "Paid", StringComparison.OrdinalIgnoreCase) || bill.OutstandingAmount <= 0;
                    var status = bill.Status;
                    var statusColor = isPaid ? "#d1fae5" : isOverdue ? "#fee2e2" : "#fef3c7";
                    var statusText = isPaid ? "#065f46" : isOverdue ? "#991b1b" : "#92400e";

                    <tr style="border-bottom: 1px solid var(--border); transition: background 0.2s;">
                        <td style="padding: 16px; font-family: monospace; font-weight: 600; color: #3b82f6;">@bill.InvoiceNumber</td>
                        <td style="padding: 16px;">
                            <div style="font-weight: 600; margin-bottom: 2px;">@bill.VendorName</div>
                            <div style="font-size: 12px; color: #6b7280;">@bill.Description</div>
                        </td>
                        <td style="padding: 16px; font-size: 14px;">@bill.InvoiceDate.ToString("MMM dd, yyyy")</td>
                        <td style="padding: 16px; font-size: 14px; font-weight: @(isOverdue ? "700" : "400"); color: @(isOverdue ? "#dc2626" : "#111827");">
                            @bill.DueDate.ToString("MMM dd, yyyy")
                            @if (isOverdue)
                            {
                                var daysOverdue = (DateTime.Today - bill.DueDate.Date).Days;
                                <div style="font-size: 11px; color: #dc2626;">⚠️ @daysOverdue days overdue</div>
                            }
                        </td>
                        <td style="padding: 16px; text-align: right; font-size: 15px; font-weight: 700;">₱@bill.Amount.ToString("N2")</td>
                        <td style="padding: 16px; text-align: right; font-size: 14px; color: #10b981;">₱@bill.PaidAmount.ToString("N2")</td>
                        <td style="padding: 16px; text-align: right; font-size: 16px; font-weight: 700; color: @(bill.OutstandingAmount > 0 ? "#dc2626" : "#10b981");">₱@bill.OutstandingAmount.ToString("N2")</td>
                        <td style="padding: 16px;">
                            <span style="padding: 4px 10px; background: @statusColor; color: @statusText; border-radius: 6px; font-size: 12px; font-weight: 600;">@status</span>
                        </td>
                        <td style="padding: 16px; text-align: center;">
                            <div style="display: flex; gap: 8px; justify-content: center;">
                                @if (!isPaid)
                                {
                                    <button class="btn" style="background: #10b981; color: white; padding: 6px 12px; font-size: 13px; font-weight: 600;" @onclick="() => OpenPaymentModal(bill)">
                                        💳 Pay
                                    </button>
                                }
                                <button class="btn" style="background: white; border: 2px solid #e5e7eb; color: #374151; padding: 6px 12px; font-size: 13px;">
                                    👁️ View
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <!-- Pagination -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--border);">
        <div style="font-size: 14px; color: #6b7280;">
            Showing <strong>1-12</strong> of <strong>85</strong> bills
        </div>
        <div style="display: flex; gap: 8px;">
            <button class="btn" style="background: #f3f4f6; color: #9ca3af; padding: 8px 16px;">← Previous</button>
            <button class="btn" style="background: #10b981; color: white; padding: 8px 16px;">1</button>
            <button class="btn" style="background: #f3f4f6; color: #374151; padding: 8px 16px;">2</button>
            <button class="btn" style="background: #f3f4f6; color: #374151; padding: 8px 16px;">3</button>
            <button class="btn" style="background: #f3f4f6; color: #374151; padding: 8px 16px;">Next →</button>
        </div>
    </div>
</div>

<!-- New Bill Modal -->
<div style="display: @(showNewBillModal ? "flex" : "none"); position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000;">
    <div style="background: white; border-radius: 16px; padding: 32px; max-width: 500px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
        <h2 style="font-size: 20px; font-weight: 700; margin: 0 0 24px 0;">➕ New Bill</h2>
        
        <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label">Vendor Name</label>
            <input type="text" class="form-control" @bind="newBill_VendorName" placeholder="e.g., ABC Supplies Co." />
        </div>
        
        <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label">Invoice Number</label>
            <input type="text" class="form-control" @bind="newBill_InvoiceNumber" placeholder="e.g., INV-2025-001" />
        </div>
        
        <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label">Invoice Date</label>
            <input type="date" class="form-control" @bind="newBill_InvoiceDate" />
        </div>
        
        <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label">Due Date</label>
            <input type="date" class="form-control" @bind="newBill_DueDate" />
        </div>
        
        <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label">Amount (₱)</label>
            <input type="number" class="form-control" @bind="newBill_Amount" placeholder="0.00" step="0.01" />
        </div>
        
        <div class="form-group" style="margin-bottom: 24px;">
            <label class="form-label">Description</label>
            <textarea class="form-control" @bind="newBill_Description" placeholder="Optional notes" style="min-height: 80px;"></textarea>
        </div>
        
        <div style="display: flex; gap: 12px; justify-content: flex-end;">
            <button class="btn" style="background: #e5e7eb; color: #374151; padding: 10px 20px; font-weight: 600;" @onclick="() => showNewBillModal = false">Cancel</button>
            <button class="btn" style="background: #10b981; color: white; padding: 10px 20px; font-weight: 600;" @onclick="CreateNewBill">Create Bill</button>
        </div>
    </div>
</div>

<!-- Record Payment Modal -->
<div style="display: @(showPaymentModal ? "flex" : "none"); position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000;">
    <div style="background: white; border-radius: 16px; padding: 32px; max-width: 500px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
        <h2 style="font-size: 20px; font-weight: 700; margin: 0 0 24px 0;">💳 Record Payment</h2>
        
        <div style="background: #f3f4f6; border-radius: 12px; padding: 16px; margin-bottom: 24px;">
            <div style="font-size: 12px; color: #6b7280; margin-bottom: 4px;">Bill</div>
            <div style="font-size: 16px; font-weight: 700; color: #111827;">@selectedPayable?.InvoiceNumber</div>
            <div style="font-size: 14px; color: #6b7280; margin-top: 8px;">Outstanding: ₱@selectedPayable?.OutstandingAmount.ToString("N2")</div>
        </div>
        
        <div class="form-group" style="margin-bottom: 24px;">
            <label class="form-label">Payment Amount (₱)</label>
            <input type="number" class="form-control" @bind="paymentAmount" placeholder="0.00" step="0.01" />
        </div>
        
        <div style="display: flex; gap: 12px; justify-content: flex-end;">
            <button class="btn" style="background: #e5e7eb; color: #374151; padding: 10px 20px; font-weight: 600;" @onclick="() => showPaymentModal = false">Cancel</button>
            <button class="btn" style="background: #10b981; color: white; padding: 10px 20px; font-weight: 600;" @onclick="RecordPayment">Record Payment</button>
        </div>
    </div>
</div>

@code {
    // UI Only - No backend logic

    private List<FinanceBank.Models.AccountsPayable> payables = new();

    private decimal totalOutstanding;
    private decimal dueThisWeekAmount;
    private int dueThisWeekCount;
    private decimal overdueAmount;
    private int overdueCount;
    private decimal paidThisMonthAmount;
    private int paidThisMonthCount;

    // Modal state
    private bool showNewBillModal = false;
    private bool showPaymentModal = false;
    private FinanceBank.Models.AccountsPayable? selectedPayable;

    // New bill form
    private string newBill_VendorName = "";
    private string newBill_InvoiceNumber = "";
    private DateTime newBill_InvoiceDate = DateTime.Today;
    private DateTime newBill_DueDate = DateTime.Today.AddDays(30);
    private decimal newBill_Amount = 0;
    private string newBill_Description = "";

    // Payment form
    private decimal paymentAmount = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            payables = await AccountsPayableService.GetAllAsync();
            CalculateSummary();
        }
        catch
        {
        }
    }

    private void CalculateSummary()
    {
        var today = DateTime.Today;
        var weekLimit = today.AddDays(7);
        var monthStart = new DateTime(today.Year, today.Month, 1);

        totalOutstanding = payables.Sum(p => p.OutstandingAmount);

        var dueThisWeek = payables
            .Where(p => p.DueDate.Date >= today && p.DueDate.Date <= weekLimit && p.OutstandingAmount > 0)
            .ToList();
        dueThisWeekAmount = dueThisWeek.Sum(p => p.OutstandingAmount);
        dueThisWeekCount = dueThisWeek.Count;

        var overdue = payables
            .Where(p => p.DueDate.Date < today && p.OutstandingAmount > 0)
            .ToList();
        overdueAmount = overdue.Sum(p => p.OutstandingAmount);
        overdueCount = overdue.Count;

        var paidThisMonth = payables
            .Where(p => p.Status == "Paid" && p.InvoiceDate.Date >= monthStart && p.InvoiceDate.Date <= today)
            .ToList();
        paidThisMonthAmount = paidThisMonth.Sum(p => p.PaidAmount);
        paidThisMonthCount = paidThisMonth.Count;
    }

    private async Task CreateNewBill()
    {
        if (string.IsNullOrWhiteSpace(newBill_VendorName) || string.IsNullOrWhiteSpace(newBill_InvoiceNumber) || newBill_Amount <= 0)
        {
            return;
        }

        var newPayable = new FinanceBank.Models.AccountsPayable
        {
            VendorName = newBill_VendorName,
            InvoiceNumber = newBill_InvoiceNumber,
            InvoiceDate = newBill_InvoiceDate,
            DueDate = newBill_DueDate,
            Amount = newBill_Amount,
            PaidAmount = 0,
            OutstandingAmount = newBill_Amount,
            Status = "Pending",
            Description = newBill_Description,
            CreatedBy = "Admin"
        };

        try
        {
            await AccountsPayableService.CreateAsync(newPayable);
            payables = await AccountsPayableService.GetAllAsync();
            CalculateSummary();
            
            // Reset form
            newBill_VendorName = "";
            newBill_InvoiceNumber = "";
            newBill_InvoiceDate = DateTime.Today;
            newBill_DueDate = DateTime.Today.AddDays(30);
            newBill_Amount = 0;
            newBill_Description = "";
            showNewBillModal = false;
        }
        catch
        {
        }
    }

    private async Task RecordPayment()
    {
        if (selectedPayable == null || paymentAmount <= 0)
        {
            return;
        }

        try
        {
            await AccountsPayableService.RecordPaymentAsync(selectedPayable.PayableId, paymentAmount, "Admin");
            payables = await AccountsPayableService.GetAllAsync();
            CalculateSummary();
            
            paymentAmount = 0;
            showPaymentModal = false;
            selectedPayable = null;
        }
        catch
        {
        }
    }

    private void OpenPaymentModal(FinanceBank.Models.AccountsPayable payable)
    {
        selectedPayable = payable;
        paymentAmount = 0;
        showPaymentModal = true;
    }
}

