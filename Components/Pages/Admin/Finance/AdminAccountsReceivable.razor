@page "/admin/finance-mgr/accounts-receivable"
@layout AdminLayout
@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="admin-page finance-mgr-page">
    <div class="page-header">
        <h1>
            <span class="role-badge finance">Finance Mgr</span>
            Accounts Receivable
        </h1>
        <p class="page-subtitle">Track and manage incoming payments and receivables</p>
    </div>

    <!-- Admin Action Reason -->
    <div class="admin-action-card">
        <div class="alert alert-warning">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 24px; height: 24px;">
                <path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
            <span>You are accessing Finance Manager functions as SuperAdmin. All actions are logged.</span>
        </div>
        <div class="form-group">
            <label for="adminReason">Reason for Admin Action (Required)</label>
            <textarea id="adminReason" @bind="adminActionReason" class="form-control" 
                placeholder="Document why you are performing this action as admin..." rows="2"></textarea>
        </div>
    </div>

    <div class="stats-row" style="margin-top: 24px;">
        <div class="stat-card">
            <div class="stat-label">Total Receivables</div>
            <div class="stat-value">₱@totalReceivables.ToString("N0")</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Collected This Month</div>
            <div class="stat-value success">₱@collectedThisMonth.ToString("N0")</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Outstanding > 30 Days</div>
            <div class="stat-value warning">₱@outstanding30Days.ToString("N0")</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Outstanding > 90 Days</div>
            <div class="stat-value danger">₱@outstanding90Days.ToString("N0")</div>
        </div>
    </div>

    <div class="admin-card" style="margin-top: 24px;">
        <div class="card-header">
            <h3>Receivable Transactions</h3>
            <div class="header-actions">
                <button class="btn btn-outline" @onclick="ExportReport">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 16px; height: 16px;">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    Export
                </button>
                <button class="btn btn-primary" @onclick="RecordReceivable">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 16px; height: 16px;">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Record Receivable
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="table-filters">
                <div class="filter-group">
                    <input type="text" class="form-control" placeholder="Search customer or invoice..." @bind="searchQuery" />
                </div>
                <div class="filter-group">
                    <select class="form-select" @bind="statusFilter">
                        <option value="">All Statuses</option>
                        <option value="current">Current</option>
                        <option value="30days">30+ Days</option>
                        <option value="60days">60+ Days</option>
                        <option value="90days">90+ Days</option>
                    </select>
                </div>
                <div class="filter-group">
                    <select class="form-select" @bind="typeFilter">
                        <option value="">All Types</option>
                        <option value="loan">Loan Payment</option>
                        <option value="interest">Interest</option>
                        <option value="fee">Service Fee</option>
                    </select>
                </div>
            </div>

            <table class="table">
                <thead>
                    <tr>
                        <th>Reference #</th>
                        <th>Customer</th>
                        <th>Type</th>
                        <th>Amount</th>
                        <th>Due Date</th>
                        <th>Days Outstanding</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in receivables)
                    {
                        <tr>
                            <td><strong>@item.ReferenceNumber</strong></td>
                            <td>@item.CustomerName</td>
                            <td>@item.Type</td>
                            <td>₱@item.Amount.ToString("N2")</td>
                            <td>@item.DueDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                <span class="@GetDaysOutstandingClass(item.DaysOutstanding)">
                                    @(item.DaysOutstanding > 0 ? $"{item.DaysOutstanding} days" : "Current")
                                </span>
                            </td>
                            <td>
                                <div class="action-buttons">
                                    <button class="btn btn-sm btn-outline" @onclick="() => ViewDetails(item)" title="View">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 14px; height: 14px;">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                            <circle cx="12" cy="12" r="3"></circle>
                                        </svg>
                                    </button>
                                    <button class="btn btn-sm btn-success" @onclick="() => RecordPayment(item)" title="Record Payment">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 14px; height: 14px;">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                    </button>
                                    <button class="btn btn-sm btn-warning" @onclick="() => SendReminder(item)" title="Send Reminder">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 14px; height: 14px;">
                                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                            <polyline points="22,6 12,13 2,6"></polyline>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="admin-card" style="margin-top: 24px;">
        <div class="card-header">
            <h3>Aging Summary</h3>
        </div>
        <div class="card-body">
            <div class="aging-chart">
                <div class="aging-bar">
                    <div class="aging-segment current" style="width: 45%;">
                        <span>Current (45%)</span>
                    </div>
                    <div class="aging-segment days30" style="width: 25%;">
                        <span>30 Days (25%)</span>
                    </div>
                    <div class="aging-segment days60" style="width: 18%;">
                        <span>60 Days (18%)</span>
                    </div>
                    <div class="aging-segment days90" style="width: 12%;">
                        <span>90+ Days (12%)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .finance-mgr-page .role-badge.finance {
        background: linear-gradient(135deg, #f59e0b, #d97706);
    }
    .stats-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
    }
    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }
    .stat-label {
        font-size: 0.85em;
        color: #6b7280;
        margin-bottom: 8px;
    }
    .stat-value {
        font-size: 1.5em;
        font-weight: 700;
        color: #1f2937;
    }
    .stat-value.success { color: #10b981; }
    .stat-value.warning { color: #f59e0b; }
    .stat-value.danger { color: #ef4444; }
    .header-actions {
        display: flex;
        gap: 12px;
    }
    .table-filters {
        display: flex;
        gap: 16px;
        margin-bottom: 20px;
    }
    .filter-group {
        flex: 1;
        max-width: 250px;
    }
    .action-buttons {
        display: flex;
        gap: 8px;
    }
    .btn-sm {
        padding: 4px 8px;
        font-size: 0.85em;
    }
    .days-current { color: #10b981; }
    .days-warning { color: #f59e0b; }
    .days-danger { color: #ef4444; }
    .aging-chart {
        padding: 20px 0;
    }
    .aging-bar {
        display: flex;
        height: 40px;
        border-radius: 8px;
        overflow: hidden;
    }
    .aging-segment {
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 0.85em;
        font-weight: 500;
    }
    .aging-segment.current { background: #10b981; }
    .aging-segment.days30 { background: #f59e0b; }
    .aging-segment.days60 { background: #f97316; }
    .aging-segment.days90 { background: #ef4444; }
</style>

@code {
    private string adminActionReason = "";
    private string searchQuery = "";
    private string statusFilter = "";
    private string typeFilter = "";
    
    private decimal totalReceivables = 2850000;
    private decimal collectedThisMonth = 1250000;
    private decimal outstanding30Days = 450000;
    private decimal outstanding90Days = 125000;

    private List<ReceivableItem> receivables = new()
    {
        new() { ReferenceNumber = "AR-2024-001", CustomerName = "Juan Dela Cruz", Type = "Loan Payment", Amount = 15000, DueDate = DateTime.Now.AddDays(-5), DaysOutstanding = 5 },
        new() { ReferenceNumber = "AR-2024-002", CustomerName = "Maria Santos", Type = "Interest", Amount = 2500, DueDate = DateTime.Now.AddDays(3), DaysOutstanding = 0 },
        new() { ReferenceNumber = "AR-2024-003", CustomerName = "Pedro Reyes", Type = "Loan Payment", Amount = 25000, DueDate = DateTime.Now.AddDays(-35), DaysOutstanding = 35 },
        new() { ReferenceNumber = "AR-2024-004", CustomerName = "Ana Garcia", Type = "Service Fee", Amount = 500, DueDate = DateTime.Now.AddDays(-95), DaysOutstanding = 95 },
        new() { ReferenceNumber = "AR-2024-005", CustomerName = "Jose Rizal", Type = "Loan Payment", Amount = 18000, DueDate = DateTime.Now.AddDays(7), DaysOutstanding = 0 }
    };

    protected override void OnInitialized()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
        }
    }

    private string GetDaysOutstandingClass(int days) => days switch
    {
        0 => "days-current",
        <= 30 => "days-warning",
        _ => "days-danger"
    };

    private void ExportReport() { }
    private void RecordReceivable() { }
    private void ViewDetails(ReceivableItem item) { }
    private void RecordPayment(ReceivableItem item) { }
    private void SendReminder(ReceivableItem item) { }

    private class ReceivableItem
    {
        public string ReferenceNumber { get; set; } = "";
        public string CustomerName { get; set; } = "";
        public string Type { get; set; } = "";
        public decimal Amount { get; set; }
        public DateTime DueDate { get; set; }
        public int DaysOutstanding { get; set; }
    }
}
