@page "/admin/finance-mgr/accounts-receivable"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@inject AuthService AuthService
@inject AccountsReceivableService AccountsReceivableService
@inject NavigationManager Navigation

<div style="padding: 24px;">
    <!-- Page Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <div>
            <h2 style="margin: 0; color: #1f2937; font-weight: 700; font-size: 24px;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2"
                    style="margin-right: 10px; vertical-align: middle;">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                </svg>
                Accounts Receivable (Admin)
            </h2>
            <p style="margin: 4px 0 0 0; color: #6b7280; font-size: 14px;">SuperAdmin - Track and manage incoming payments</p>
        </div>
        <div style="display: flex; gap: 12px;">
            <button @onclick="LoadReceivables"
                style="display: flex; align-items: center; gap: 8px; background: linear-gradient(135deg, #059669, #10b981); color: white; border: none; padding: 12px 20px; border-radius: 10px; cursor: pointer; font-weight: 600; font-size: 14px; box-shadow: 0 4px 12px rgba(5, 150, 105, 0.3);">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M23 4v6h-6M1 20v-6h6M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15" />
                </svg>
                Refresh
            </button>
            <button @onclick="ExportReport"
                style="display: flex; align-items: center; gap: 8px; background: linear-gradient(135deg, #3b82f6, #2563eb); color: white; border: none; padding: 12px 20px; border-radius: 10px; cursor: pointer; font-weight: 600; font-size: 14px; box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                Export
            </button>
        </div>
    </div>

    <!-- Admin Notice -->
    <div style="background: #fef3c7; border: 1px solid #f59e0b; border-radius: 12px; padding: 16px; margin-bottom: 24px;">
        <div style="display: flex; align-items: center; gap: 12px;">
            <span style="font-size: 24px;">⚠️</span>
            <div style="flex: 1;">
                <p style="margin: 0; font-weight: 600; color: #92400e;">Administrative Access</p>
                <p style="margin: 4px 0 0; font-size: 13px; color: #a16207;">You are accessing Finance Manager functions as SuperAdmin. All actions are logged.</p>
            </div>
        </div>
        <div style="margin-top: 12px;">
            <label style="font-size: 13px; font-weight: 600; color: #92400e; display: block; margin-bottom: 6px;">Reason for Admin Action (Required)</label>
            <textarea @bind="adminActionReason" placeholder="Document why you are performing this action as admin..."
                style="width: 100%; padding: 10px 12px; border: 1px solid #fcd34d; border-radius: 8px; font-size: 13px; resize: vertical; min-height: 60px;"></textarea>
        </div>
    </div>

    <!-- Stats Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">
        <div style="background: linear-gradient(135deg, #eff6ff, #dbeafe); border-radius: 12px; padding: 20px; border: 1px solid #bfdbfe;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 48px; height: 48px; background: #3b82f6; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                        <path d="M12 2v20M2 12h20"></path>
                    </svg>
                </div>
                <div>
                    <p style="margin: 0; color: #3b82f6; font-size: 12px; font-weight: 600; text-transform: uppercase;">Total Receivables</p>
                    <p style="margin: 4px 0 0 0; font-size: 24px; font-weight: 700; color: #1e40af;">₱@totalReceivables.ToString("N2")</p>
                </div>
            </div>
            <p style="margin: 12px 0 0 0; font-size: 12px; color: #2563eb;">@receivables.Count invoices total</p>
        </div>
        <div style="background: linear-gradient(135deg, #f0fdf4, #dcfce7); border-radius: 12px; padding: 20px; border: 1px solid #bbf7d0;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 48px; height: 48px; background: #10b981; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                </div>
                <div>
                    <p style="margin: 0; color: #059669; font-size: 12px; font-weight: 600; text-transform: uppercase;">Collected This Month</p>
                    <p style="margin: 4px 0 0 0; font-size: 24px; font-weight: 700; color: #065f46;">₱@collectedThisMonth.ToString("N2")</p>
                </div>
            </div>
            <p style="margin: 12px 0 0 0; font-size: 12px; color: #047857;">Payments received</p>
        </div>
        <div style="background: linear-gradient(135deg, #fefce8, #fef9c3); border-radius: 12px; padding: 20px; border: 1px solid #fde047;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 48px; height: 48px; background: #eab308; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                    </svg>
                </div>
                <div>
                    <p style="margin: 0; color: #ca8a04; font-size: 12px; font-weight: 600; text-transform: uppercase;">Outstanding 30 Days</p>
                    <p style="margin: 4px 0 0 0; font-size: 24px; font-weight: 700; color: #854d0e;">₱@outstanding30Days.ToString("N2")</p>
                </div>
            </div>
            <p style="margin: 12px 0 0 0; font-size: 12px; color: #a16207;">Needs follow-up</p>
        </div>
        <div style="background: linear-gradient(135deg, #fef2f2, #fee2e2); border-radius: 12px; padding: 20px; border: 1px solid #fecaca;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 48px; height: 48px; background: #dc2626; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                </div>
                <div>
                    <p style="margin: 0; color: #dc2626; font-size: 12px; font-weight: 600; text-transform: uppercase;">Outstanding 90+ Days</p>
                    <p style="margin: 4px 0 0 0; font-size: 24px; font-weight: 700; color: #991b1b;">₱@outstanding90Days.ToString("N2")</p>
                </div>
            </div>
            <p style="margin: 12px 0 0 0; font-size: 12px; color: #b91c1c;">Critical attention</p>
        </div>
    </div>

    <!-- Filter Bar -->
    <div style="display: flex; gap: 16px; margin-bottom: 24px; align-items: center; flex-wrap: wrap;">
        <div style="flex: 1; max-width: 280px;">
            <input type="text" placeholder="Search customer or invoice..." @bind="searchQuery" @bind:event="oninput"
                style="width: 100%; padding: 10px 14px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;" />
        </div>
        <select @bind="statusFilter" style="padding: 10px 14px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px; background: white;">
            <option value="">All Statuses</option>
            <option value="Pending">Pending</option>
            <option value="Paid">Paid</option>
            <option value="Overdue">Overdue</option>
        </select>
        <select @bind="typeFilter" style="padding: 10px 14px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px; background: white;">
            <option value="">All Types</option>
            <option value="Loan Payment">Loan Payment</option>
            <option value="Interest">Interest</option>
            <option value="Service Fee">Service Fee</option>
        </select>
    </div>

    <!-- Receivables Table -->
    <div style="background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden;">
        <div style="background: linear-gradient(135deg, #3b82f6, #2563eb); color: white; padding: 20px 24px;">
            <h4 style="margin: 0; font-weight: 600; font-size: 18px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    style="margin-right: 8px; vertical-align: middle;">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                </svg>
                📥 Receivable Transactions
            </h4>
            <p style="margin: 6px 0 0 0; opacity: 0.9; font-size: 13px;">@FilteredReceivables.Count() transactions found</p>
        </div>
        <div style="padding: 0;">
            @if (isLoading)
            {
                <div style="text-align: center; padding: 60px;">
                    <div style="width: 48px; height: 48px; border: 4px solid #e5e7eb; border-top-color: #3b82f6; border-radius: 50%; margin: 0 auto 16px; animation: spin 1s linear infinite;"></div>
                    <p style="color: #6b7280;">Loading receivables...</p>
                </div>
            }
            else if (!FilteredReceivables.Any())
            {
                <div style="text-align: center; padding: 60px; color: #6b7280;">
                    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin: 0 auto 16px; opacity: 0.5;">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                    </svg>
                    <p style="font-size: 16px; font-weight: 500; margin: 0;">No receivables found</p>
                    <p style="font-size: 14px; margin: 8px 0 0 0;">Try adjusting your search or filters</p>
                </div>
            }
            else
            {
                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background: #f9fafb;">
                            <th style="padding: 14px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #6b7280; text-transform: uppercase; border-bottom: 2px solid #e5e7eb;">Invoice #</th>
                            <th style="padding: 14px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #6b7280; text-transform: uppercase; border-bottom: 2px solid #e5e7eb;">Customer</th>
                            <th style="padding: 14px 16px; text-align: right; font-size: 12px; font-weight: 600; color: #6b7280; text-transform: uppercase; border-bottom: 2px solid #e5e7eb;">Amount</th>
                            <th style="padding: 14px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #6b7280; text-transform: uppercase; border-bottom: 2px solid #e5e7eb;">Due Date</th>
                            <th style="padding: 14px 16px; text-align: center; font-size: 12px; font-weight: 600; color: #6b7280; text-transform: uppercase; border-bottom: 2px solid #e5e7eb;">Status</th>
                            <th style="padding: 14px 16px; text-align: center; font-size: 12px; font-weight: 600; color: #6b7280; text-transform: uppercase; border-bottom: 2px solid #e5e7eb;">Days Outstanding</th>
                            <th style="padding: 14px 16px; text-align: center; font-size: 12px; font-weight: 600; color: #6b7280; text-transform: uppercase; border-bottom: 2px solid #e5e7eb;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in FilteredReceivables)
                        {
                            var daysOutstanding = (DateTime.Today - item.DueDate).Days;
                            <tr style="border-bottom: 1px solid #f3f4f6; transition: background 0.15s;" onmouseover="this.style.background='#f9fafb'" onmouseout="this.style.background='white'">
                                <td style="padding: 16px;"><strong style="color: #1f2937;">@item.InvoiceNumber</strong></td>
                                <td style="padding: 16px; color: #4b5563;">@item.CustomerName</td>
                                <td style="padding: 16px; text-align: right; font-weight: 600; color: #3b82f6;">₱@item.Amount.ToString("N2")</td>
                                <td style="padding: 16px; color: #6b7280;">@item.DueDate.ToString("MMM dd, yyyy")</td>
                                <td style="padding: 16px; text-align: center;">
                                    <span style="padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; background: @GetStatusBg(item.Status); color: @GetStatusColor(item.Status);">
                                        @item.Status
                                    </span>
                                </td>
                                <td style="padding: 16px; text-align: center;">
                                    <span style="font-weight: 600; color: @GetDaysColor(daysOutstanding);">
                                        @(daysOutstanding > 0 ? $"{daysOutstanding} days" : "Current")
                                    </span>
                                </td>
                                <td style="padding: 16px; text-align: center;">
                                    <div style="display: flex; gap: 8px; justify-content: center;">
                                        <button @onclick="() => ViewDetails(item)" title="View Details"
                                            style="padding: 6px 10px; border: 1px solid #d1d5db; background: white; border-radius: 6px; cursor: pointer;">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="2">
                                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                                <circle cx="12" cy="12" r="3"></circle>
                                            </svg>
                                        </button>
                                        <button @onclick="() => RecordPayment(item)" title="Record Payment"
                                            style="padding: 6px 10px; background: linear-gradient(135deg, #10b981, #059669); color: white; border: none; border-radius: 6px; cursor: pointer;">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <polyline points="20 6 9 17 4 12"></polyline>
                                            </svg>
                                        </button>
                                        <button @onclick="() => SendReminder(item)" title="Send Reminder"
                                            style="padding: 6px 10px; background: linear-gradient(135deg, #f59e0b, #d97706); color: white; border: none; border-radius: 6px; cursor: pointer;">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                                <polyline points="22,6 12,13 2,6"></polyline>
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <!-- Aging Summary -->
    <div style="background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden; margin-top: 24px;">
        <div style="background: linear-gradient(135deg, #8b5cf6, #7c3aed); color: white; padding: 20px 24px;">
            <h4 style="margin: 0; font-weight: 600; font-size: 18px;">📊 Aging Summary</h4>
        </div>
        <div style="padding: 24px;">
            <div style="display: flex; height: 40px; border-radius: 8px; overflow: hidden;">
                <div style="background: #10b981; flex: 45; display: flex; align-items: center; justify-content: center; color: white; font-size: 13px; font-weight: 500;">Current (45%)</div>
                <div style="background: #f59e0b; flex: 25; display: flex; align-items: center; justify-content: center; color: white; font-size: 13px; font-weight: 500;">30 Days (25%)</div>
                <div style="background: #f97316; flex: 18; display: flex; align-items: center; justify-content: center; color: white; font-size: 13px; font-weight: 500;">60 Days (18%)</div>
                <div style="background: #ef4444; flex: 12; display: flex; align-items: center; justify-content: center; color: white; font-size: 13px; font-weight: 500;">90+ (12%)</div>
            </div>
        </div>
    </div>
</div>

@code {
    private string adminActionReason = "";
    private string searchQuery = "";
    private string statusFilter = "";
    private string typeFilter = "";
    private bool isLoading = true;

    private decimal totalReceivables = 0;
    private decimal collectedThisMonth = 0;
    private decimal outstanding30Days = 0;
    private decimal outstanding90Days = 0;

    private List<FinanceBank.Models.AccountsReceivable> receivables = new();

    private IEnumerable<FinanceBank.Models.AccountsReceivable> FilteredReceivables => receivables
        .Where(r => string.IsNullOrEmpty(searchQuery) || 
            r.CustomerName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
            r.InvoiceNumber.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        .Where(r => string.IsNullOrEmpty(statusFilter) || r.Status == statusFilter)
        .OrderByDescending(r => r.DueDate);

    protected override async Task OnInitializedAsync()
    {
        await LoadReceivables();
    }

    private async Task LoadReceivables()
    {
        isLoading = true;
        try
        {
            receivables = await AccountsReceivableService.GetAllAsync();
            CalculateStats();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading receivables: {ex.Message}");
            receivables = new List<FinanceBank.Models.AccountsReceivable>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void CalculateStats()
    {
        var today = DateTime.Today;
        var monthStart = new DateTime(today.Year, today.Month, 1);
        totalReceivables = receivables.Sum(r => r.Amount);
        collectedThisMonth = receivables.Where(r => r.Status == "Paid" && r.CreatedAt >= monthStart).Sum(r => r.ReceivedAmount);
        outstanding30Days = receivables.Where(r => (today - r.DueDate).Days > 0 && (today - r.DueDate).Days <= 30).Sum(r => r.OutstandingAmount);
        outstanding90Days = receivables.Where(r => (today - r.DueDate).Days > 90).Sum(r => r.OutstandingAmount);
    }

    protected override void OnInitialized()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
        }
    }

    private string GetStatusBg(string status) => status switch
    {
        "Paid" => "#d1fae5",
        "Pending" => "#fef3c7",
        "Overdue" => "#fee2e2",
        _ => "#f3f4f6"
    };

    private string GetStatusColor(string status) => status switch
    {
        "Paid" => "#065f46",
        "Pending" => "#92400e",
        "Overdue" => "#991b1b",
        _ => "#6b7280"
    };

    private string GetDaysColor(int days) => days switch
    {
        <= 0 => "#10b981",
        <= 30 => "#f59e0b",
        _ => "#ef4444"
    };

    private void ExportReport() { }
    private void RecordReceivable() { }
    private void ViewDetails(FinanceBank.Models.AccountsReceivable item) { }
    
    private async Task RecordPayment(FinanceBank.Models.AccountsReceivable item)
    {
        if (!string.IsNullOrWhiteSpace(adminActionReason))
        {
            item.Status = "Paid";
            await LoadReceivables();
        }
    }
    
    private void SendReminder(FinanceBank.Models.AccountsReceivable item) { }
}