@page "/admin/finance-mgr/accounts-payable"
@layout AdminLayout
@using FinanceBank.Services
@using FinanceBank.Models
@inject AuthService AuthService
@inject AccountsPayableService AccountsPayableService
@inject NavigationManager Navigation

<div style="padding: 24px;">
    <!-- Page Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <div>
            <h2 style="margin: 0; color: #1f2937; font-weight: 700; font-size: 24px;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2"
                    style="margin-right: 10px; vertical-align: middle;">
                    <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                    <path d="M12 9v6"></path>
                    <path d="M9 12h6"></path>
                </svg>
                Accounts Payable (Admin)
            </h2>
            <p style="margin: 4px 0 0 0; color: #6b7280; font-size: 14px;">SuperAdmin - Manage bank liabilities</p>
        </div>
        <div style="display: flex; gap: 12px;">
            <button @onclick="LoadPayables"
                style="display: flex; align-items: center; gap: 8px; background: linear-gradient(135deg, #059669, #10b981); color: white; border: none; padding: 12px 20px; border-radius: 10px; cursor: pointer; font-weight: 600; font-size: 14px; box-shadow: 0 4px 12px rgba(5, 150, 105, 0.3);">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M23 4v6h-6M1 20v-6h6M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15" />
                </svg>
                Refresh
            </button>
            <button @onclick="NewPayable"
                style="display: flex; align-items: center; gap: 8px; background: linear-gradient(135deg, #3b82f6, #2563eb); color: white; border: none; padding: 12px 20px; border-radius: 10px; cursor: pointer; font-weight: 600; font-size: 14px; box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                New Payable
            </button>
        </div>
    </div>

    <!-- Admin Notice -->
    <div style="background: #fef3c7; border: 1px solid #f59e0b; border-radius: 12px; padding: 16px; margin-bottom: 24px;">
        <div style="display: flex; align-items: center; gap: 12px;">
            <span style="font-size: 24px;">⚠️</span>
            <div style="flex: 1;">
                <p style="margin: 0; font-weight: 600; color: #92400e;">Administrative Access</p>
                <p style="margin: 4px 0 0; font-size: 13px; color: #a16207;">You are accessing Finance Manager functions as SuperAdmin. All actions are logged.</p>
            </div>
        </div>
        <div style="margin-top: 12px;">
            <label style="font-size: 13px; font-weight: 600; color: #92400e; display: block; margin-bottom: 6px;">Reason for Admin Action (Required)</label>
            <textarea @bind="adminActionReason" placeholder="Document why you are performing this action as admin..."
                style="width: 100%; padding: 10px 12px; border: 1px solid #fcd34d; border-radius: 8px; font-size: 13px; resize: vertical; min-height: 60px;"></textarea>
        </div>
    </div>

    <!-- Stats Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">
        <div style="background: linear-gradient(135deg, #fef2f2, #fee2e2); border-radius: 12px; padding: 20px; border: 1px solid #fecaca;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 48px; height: 48px; background: #dc2626; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                        <path d="M12 2v20M2 12h20"></path>
                    </svg>
                </div>
                <div>
                    <p style="margin: 0; color: #dc2626; font-size: 12px; font-weight: 600; text-transform: uppercase;">Total Outstanding</p>
                    <p style="margin: 4px 0 0 0; font-size: 24px; font-weight: 700; color: #991b1b;">₱@totalPending.ToString("N2")</p>
                </div>
            </div>
            <p style="margin: 12px 0 0 0; font-size: 12px; color: #b91c1c;">@payables.Count(p => p.Status == "Pending Review") bills pending</p>
        </div>
        <div style="background: linear-gradient(135deg, #fefce8, #fef9c3); border-radius: 12px; padding: 20px; border: 1px solid #fde047;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 48px; height: 48px; background: #eab308; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                </div>
                <div>
                    <p style="margin: 0; color: #ca8a04; font-size: 12px; font-weight: 600; text-transform: uppercase;">Due This Week</p>
                    <p style="margin: 4px 0 0 0; font-size: 24px; font-weight: 700; color: #854d0e;">₱@dueThisWeek.ToString("N2")</p>
                </div>
            </div>
            <p style="margin: 12px 0 0 0; font-size: 12px; color: #a16207;">Bills due soon</p>
        </div>
        <div style="background: linear-gradient(135deg, #f0fdf4, #dcfce7); border-radius: 12px; padding: 20px; border: 1px solid #bbf7d0;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 48px; height: 48px; background: #059669; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                </div>
                <div>
                    <p style="margin: 0; color: #059669; font-size: 12px; font-weight: 600; text-transform: uppercase;">Overdue</p>
                    <p style="margin: 4px 0 0 0; font-size: 24px; font-weight: 700; color: #065f46;">₱@overdue.ToString("N2")</p>
                </div>
            </div>
            <p style="margin: 12px 0 0 0; font-size: 12px; color: #047857;">Requires attention</p>
        </div>
    </div>

    <!-- Filter Bar -->
    <div style="display: flex; gap: 16px; margin-bottom: 24px; align-items: center;">
        <div style="flex: 1; max-width: 300px;">
            <input type="text" placeholder="Search vendor or invoice..." @bind="searchQuery" @bind:event="oninput"
                style="width: 100%; padding: 10px 14px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;" />
        </div>
        <select @bind="statusFilter" style="padding: 10px 14px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px; background: white;">
            <option value="">All Statuses</option>
            <option value="Pending Review">Pending Review</option>
            <option value="Approved">Approved</option>
            <option value="Paid">Paid</option>
            <option value="Overdue">Overdue</option>
        </select>
    </div>

    <!-- Payables Table -->
    <div style="background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden;">
        <div style="background: linear-gradient(135deg, #059669, #10b981); color: white; padding: 20px 24px;">
            <h4 style="margin: 0; font-weight: 600; font-size: 18px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    style="margin-right: 8px; vertical-align: middle;">
                    <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                    <path d="M12 9v6"></path>
                    <path d="M9 12h6"></path>
                </svg>
                💳 Payable Transactions
            </h4>
            <p style="margin: 6px 0 0 0; opacity: 0.9; font-size: 13px;">@FilteredPayables.Count() transactions found</p>
        </div>
        <div style="padding: 0;">
            @if (isLoading)
            {
                <div style="text-align: center; padding: 60px;">
                    <div style="width: 48px; height: 48px; border: 4px solid #e5e7eb; border-top-color: #059669; border-radius: 50%; margin: 0 auto 16px; animation: spin 1s linear infinite;"></div>
                    <p style="color: #6b7280;">Loading payables...</p>
                </div>
            }
            else if (!FilteredPayables.Any())
            {
                <div style="text-align: center; padding: 60px; color: #6b7280;">
                    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin: 0 auto 16px; opacity: 0.5;">
                        <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                        <path d="M12 9v6"></path>
                        <path d="M9 12h6"></path>
                    </svg>
                    <p style="font-size: 16px; font-weight: 500; margin: 0;">No payables found</p>
                    <p style="font-size: 14px; margin: 8px 0 0 0;">Try adjusting your search or filters</p>
                </div>
            }
            else
            {
                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background: #f9fafb;">
                            <th style="padding: 14px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #6b7280; text-transform: uppercase; border-bottom: 2px solid #e5e7eb;">Invoice #</th>
                            <th style="padding: 14px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #6b7280; text-transform: uppercase; border-bottom: 2px solid #e5e7eb;">Vendor</th>
                            <th style="padding: 14px 16px; text-align: right; font-size: 12px; font-weight: 600; color: #6b7280; text-transform: uppercase; border-bottom: 2px solid #e5e7eb;">Amount</th>
                            <th style="padding: 14px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #6b7280; text-transform: uppercase; border-bottom: 2px solid #e5e7eb;">Due Date</th>
                            <th style="padding: 14px 16px; text-align: center; font-size: 12px; font-weight: 600; color: #6b7280; text-transform: uppercase; border-bottom: 2px solid #e5e7eb;">Status</th>
                            <th style="padding: 14px 16px; text-align: center; font-size: 12px; font-weight: 600; color: #6b7280; text-transform: uppercase; border-bottom: 2px solid #e5e7eb;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payable in FilteredPayables)
                        {
                            <tr style="border-bottom: 1px solid #f3f4f6; transition: background 0.15s;" onmouseover="this.style.background='#f9fafb'" onmouseout="this.style.background='white'">
                                <td style="padding: 16px;"><strong style="color: #1f2937;">@payable.InvoiceNumber</strong></td>
                                <td style="padding: 16px; color: #4b5563;">@payable.VendorName</td>
                                <td style="padding: 16px; text-align: right; font-weight: 600; color: #059669;">₱@payable.Amount.ToString("N2")</td>
                                <td style="padding: 16px; color: #6b7280;">@payable.DueDate.ToString("MMM dd, yyyy")</td>
                                <td style="padding: 16px; text-align: center;">
                                    <span style="padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; background: @GetStatusBg(payable.Status); color: @GetStatusColor(payable.Status);">
                                        @payable.Status
                                    </span>
                                </td>
                                <td style="padding: 16px; text-align: center;">
                                    <div style="display: flex; gap: 8px; justify-content: center;">
                                        <button @onclick="() => ViewDetails(payable)" title="View Details"
                                            style="padding: 6px 10px; border: 1px solid #d1d5db; background: white; border-radius: 6px; cursor: pointer;">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="2">
                                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                                <circle cx="12" cy="12" r="3"></circle>
                                            </svg>
                                        </button>
                                        @if (payable.Status == "Pending Review")
                                        {
                                            <button @onclick="() => ApprovePayable(payable)" title="Approve"
                                                style="padding: 6px 10px; background: linear-gradient(135deg, #059669, #10b981); color: white; border: none; border-radius: 6px; cursor: pointer;">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <polyline points="20 6 9 17 4 12"></polyline>
                                                </svg>
                                            </button>
                                        }
                                        @if (payable.Status == "Approved")
                                        {
                                            <button @onclick="() => ProcessPayment(payable)" title="Process Payment"
                                                style="padding: 6px 10px; background: linear-gradient(135deg, #3b82f6, #2563eb); color: white; border: none; border-radius: 6px; cursor: pointer;">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <line x1="12" y1="1" x2="12" y2="23"></line>
                                                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                                                </svg>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@code {
    private string adminActionReason = "";
    private string searchQuery = "";
    private string statusFilter = "";
    private bool isLoading = true;
    
    private decimal totalPending = 0;
    private decimal dueThisWeek = 0;
    private decimal overdue = 0;

    private List<FinanceBank.Models.AccountsPayable> payables = new();

    private IEnumerable<FinanceBank.Models.AccountsPayable> FilteredPayables => payables
        .Where(p => string.IsNullOrEmpty(searchQuery) || 
            p.VendorName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
            p.InvoiceNumber.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        .Where(p => string.IsNullOrEmpty(statusFilter) || p.Status == statusFilter)
        .OrderByDescending(p => p.DueDate);

    protected override async Task OnInitializedAsync()
    {
        await LoadPayables();
    }

    private async Task LoadPayables()
    {
        isLoading = true;
        try
        {
            payables = await AccountsPayableService.GetAllAsync();
            CalculateStats();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading payables: {ex.Message}");
            payables = new List<FinanceBank.Models.AccountsPayable>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void CalculateStats()
    {
        var today = DateTime.Today;
        var weekEnd = today.AddDays(7);
        totalPending = payables.Where(p => p.Status == "Pending Review").Sum(p => p.Amount);
        dueThisWeek = payables.Where(p => p.DueDate <= weekEnd && p.DueDate >= today).Sum(p => p.Amount);
        overdue = payables.Where(p => p.DueDate < today && p.Status != "Paid").Sum(p => p.Amount);
    }

    protected override void OnInitialized()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
        }
    }

    private string GetStatusBg(string status) => status switch
    {
        "Pending Review" => "#fef3c7",
        "Approved" => "#dbeafe",
        "Paid" => "#d1fae5",
        "Overdue" => "#fee2e2",
        _ => "#f3f4f6"
    };

    private string GetStatusColor(string status) => status switch
    {
        "Pending Review" => "#92400e",
        "Approved" => "#1e40af",
        "Paid" => "#065f46",
        "Overdue" => "#991b1b",
        _ => "#6b7280"
    };

    private void NewPayable()
    {
        // TODO: Open new payable modal
    }

    private void ViewDetails(FinanceBank.Models.AccountsPayable payable)
    {
        // TODO: View payable details
    }

    private async Task ApprovePayable(FinanceBank.Models.AccountsPayable payable)
    {
        if (string.IsNullOrWhiteSpace(adminActionReason))
        {
            return;
        }
        payable.Status = "Approved";
        await LoadPayables();
    }

    private async Task ProcessPayment(FinanceBank.Models.AccountsPayable payable)
    {
        if (string.IsNullOrWhiteSpace(adminActionReason))
        {
            return;
        }
        payable.Status = "Paid";
        await LoadPayables();
    }
}
