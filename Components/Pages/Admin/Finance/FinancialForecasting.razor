@page "/admin/finance/financial-forecasting"
@layout AdminLayout
@inject FinancialForecastService FinancialForecastService

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
            <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
            </svg>
        </div>
        <div>
            <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Financial Forecasting</h1>
            <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Project future financial performance</p>
        </div>
    </div>
</div>

<!-- Action Bar -->
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <div></div>
    <div style="display: flex; gap: 12px;">
        <button class="btn" style="background: #6366f1; color: white; padding: 10px 20px; font-weight: 600;" @onclick="ShowCreateForecastModal">
            ➕ New Forecast
        </button>
    </div>
</div>

<!-- Summary Cards -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 24px;">
    <div style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); border-radius: 16px; padding: 24px; border: 2px solid #6ee7b7;">
        <div style="font-size: 13px; color: #065f46; font-weight: 600; margin-bottom: 8px;">PROJECTED REVENUE</div>
        <div style="font-size: 32px; font-weight: 700; color: #065f46;">₱@totalProjectedRevenue.ToString("N2")</div>
        <div style="font-size: 12px; color: #065f46; margin-top: 4px;">Sum of all revenue forecasts</div>
    </div>
    <div style="background: linear-gradient(135deg, #fee2e2, #fecaca); border-radius: 16px; padding: 24px; border: 2px solid #f87171;">
        <div style="font-size: 13px; color: #991b1b; font-weight: 600; margin-bottom: 8px;">PROJECTED EXPENSES</div>
        <div style="font-size: 32px; font-weight: 700; color: #991b1b;">₱@totalProjectedExpense.ToString("N2")</div>
        <div style="font-size: 12px; color: #991b1b; margin-top: 4px;">Sum of all expense forecasts</div>
    </div>
    <div style="background: linear-gradient(135deg, #e0f2fe, #bfdbfe); border-radius: 16px; padding: 24px; border: 2px solid #60a5fa;">
        <div style="font-size: 13px; color: #1e40af; font-weight: 600; margin-bottom: 8px;">NET PROJECTED RESULT</div>
        <div style="font-size: 32px; font-weight: 700; color: @(totalProjectedNet >= 0 ? "#1e40af" : "#b91c1c");">₱@totalProjectedNet.ToString("N2")</div>
        <div style="font-size: 12px; color: #1e40af; margin-top: 4px;">Revenue minus expenses</div>
    </div>
</div>

<!-- Forecasts Table -->
<div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid var(--border);">
    <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 20px;">Financial Forecasts</h3>

    <table style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr style="border-bottom: 2px solid var(--border); background: #f9fafb;">
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">NAME</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">TYPE</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">PERIOD</th>
                <th style="padding: 12px; text-align: right; font-size: 12px; font-weight: 700;">PROJECTED</th>
                <th style="padding: 12px; text-align: right; font-size: 12px; font-weight: 700;">ACTUAL</th>
                <th style="padding: 12px; text-align: right; font-size: 12px; font-weight: 700;">VARIANCE</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700;">CREATED BY</th>
                <th style="padding: 12px; text-align: center; font-size: 12px; font-weight: 700;">ACTIONS</th>
            </tr>
        </thead>
        <tbody>
            @if (forecasts == null || forecasts.Count == 0)
            {
                <tr>
                    <td colspan="8" style="padding: 16px; text-align: center; color: #6b7280; font-size: 14px;">No forecasts found.</td>
                </tr>
            }
            else
            {
                @foreach (var f in forecasts.OrderByDescending(x => x.CreatedAt))
                {
                    var isRevenue = string.Equals(f.ForecastType, "Revenue", StringComparison.OrdinalIgnoreCase);
                    <tr style="border-bottom: 1px solid var(--border); transition: background 0.2s;">
                        <td style="padding: 16px; font-size: 14px; font-weight: 600;">@f.ForecastName</td>
                        <td style="padding: 16px; font-size: 13px; font-weight: 600; color: @(isRevenue ? "#16a34a" : "#b91c1c");">@f.ForecastType</td>
                        <td style="padding: 16px; font-size: 13px;">@f.PeriodStart.ToString("MMM yyyy") - @f.PeriodEnd.ToString("MMM yyyy")</td>
                        <td style="padding: 16px; text-align: right; font-size: 14px; font-weight: 700;">₱@f.ProjectedAmount.ToString("N2")</td>
                        <td style="padding: 16px; text-align: right; font-size: 14px;">₱@f.ActualAmount.ToString("N2")</td>
                        <td style="padding: 16px; text-align: right; font-size: 14px; color: @(f.Variance >= 0 ? "#16a34a" : "#b91c1c");">@f.Variance.ToString("N2")%</td>
                        <td style="padding: 16px; font-size: 13px;">
                            <div>@f.CreatedBy</div>
                            <div style="font-size: 11px; color: #6b7280;">@f.CreatedAt.ToString("MMM dd, yyyy")</div>
                        </td>
                        <td style="padding: 16px; text-align: center;">
                            <button class="btn" style="background: white; border: 2px solid #e5e7eb; color: #374151; padding: 6px 12px; font-size: 13px;" @onclick='() => ShowForecastDetailsModal(f)'>
                                View
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- New Forecast Modal -->
<div style="display: @(showCreateForecastModal ? "flex" : "none"); position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000;">
    <div style="background: white; border-radius: 16px; padding: 32px; max-width: 520px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
        <h2 style="font-size: 20px; font-weight: 700; margin: 0 0 24px 0;">➕ New Financial Forecast</h2>

        <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label">Forecast Name</label>
            <input type="text" class="form-control" @bind="newForecast_Name" placeholder="e.g., 2025 Annual Revenue Forecast" />
        </div>

        <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label">Forecast Type</label>
            <select class="form-control" @bind="newForecast_Type">
                <option value="Revenue">Revenue</option>
                <option value="Expense">Expense</option>
                <option value="Cashflow">Cashflow</option>
            </select>
        </div>

        <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label">Period Start</label>
            <input type="date" class="form-control" @bind="newForecast_PeriodStart" />
        </div>

        <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label">Period End</label>
            <input type="date" class="form-control" @bind="newForecast_PeriodEnd" />
        </div>

        <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label">Projected Amount (₱)</label>
            <input type="number" class="form-control" @bind="newForecast_ProjectedAmount" step="0.01" placeholder="0.00" />
        </div>

        <div class="form-group" style="margin-bottom: 24px;">
            <label class="form-label">Key Assumptions</label>
            <textarea class="form-control" @bind="newForecast_Assumptions" placeholder="Briefly describe the assumptions used" style="min-height: 80px;"></textarea>
        </div>

        <div style="display: flex; gap: 12px; justify-content: flex-end;">
            <button class="btn" style="background: #e5e7eb; color: #374151; padding: 10px 20px; font-weight: 600;" @onclick="CloseCreateForecastModal">Cancel</button>
            <button class="btn" style="background: #6366f1; color: white; padding: 10px 20px; font-weight: 600;" @onclick="CreateForecast">Create Forecast</button>
        </div>
    </div>
</div>

<!-- Forecast Details Modal -->
<div style="display: @(showForecastDetailsModal ? "flex" : "none"); position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000;">
    <div style="background: white; border-radius: 16px; padding: 32px; max-width: 520px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
        <h2 style="font-size: 20px; font-weight: 700; margin: 0 0 24px 0;">Forecast Details</h2>

        @if (selectedForecast != null)
        {
            <div style="display: grid; grid-template-columns: 1fr; gap: 8px; font-size: 14px; color: #374151; margin-bottom: 16px;">
                <div><strong>Name:</strong> @selectedForecast.ForecastName</div>
                <div><strong>Type:</strong> @selectedForecast.ForecastType</div>
                <div><strong>Period:</strong> @selectedForecast.PeriodStart:yyyy-MM-dd - @selectedForecast.PeriodEnd:yyyy-MM-dd</div>
                <div><strong>Projected Amount:</strong> ₱@selectedForecast.ProjectedAmount.ToString("N2")</div>
                <div><strong>Actual Amount:</strong> ₱@selectedForecast.ActualAmount.ToString("N2")</div>
                <div><strong>Variance:</strong> @selectedForecast.Variance.ToString("N2")%</div>
                <div><strong>Created By:</strong> @selectedForecast.CreatedBy</div>
                <div><strong>Created At:</strong> @selectedForecast.CreatedAt:yyyy-MM-dd HH:mm</div>
                <div><strong>Assumptions:</strong> @selectedForecast.Assumptions</div>
            </div>
        }

        <div style="display: flex; justify-content: flex-end;">
            <button class="btn" style="background: #e5e7eb; color: #374151; padding: 8px 18px; font-weight: 600;" @onclick="CloseForecastDetailsModal">Close</button>
        </div>
    </div>
</div>

@code {
    private List<FinancialForecast> forecasts = new();

    private bool showCreateForecastModal = false;
    private bool showForecastDetailsModal = false;
    private FinancialForecast? selectedForecast;

    private string newForecast_Name = string.Empty;
    private string newForecast_Type = "Revenue";
    private DateTime newForecast_PeriodStart = new DateTime(DateTime.Today.Year, 1, 1);
    private DateTime newForecast_PeriodEnd = new DateTime(DateTime.Today.Year, 12, 31);
    private decimal newForecast_ProjectedAmount = 0;
    private string newForecast_Assumptions = string.Empty;

    private decimal totalProjectedRevenue;
    private decimal totalProjectedExpense;
    private decimal totalProjectedNet;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            forecasts = await FinancialForecastService.GetAllAsync();
            CalculateSummary();
        }
        catch
        {
        }
    }

    private void ShowCreateForecastModal() => showCreateForecastModal = true;

    private void CloseCreateForecastModal()
    {
        showCreateForecastModal = false;
    }

    private void ShowForecastDetailsModal(FinancialForecast forecast)
    {
        selectedForecast = forecast;
        showForecastDetailsModal = true;
    }

    private void CloseForecastDetailsModal()
    {
        showForecastDetailsModal = false;
        selectedForecast = null;
    }

    private async Task CreateForecast()
    {
        if (string.IsNullOrWhiteSpace(newForecast_Name) || newForecast_ProjectedAmount <= 0)
        {
            return;
        }

        var forecast = new FinancialForecast
        {
            ForecastName = newForecast_Name,
            ForecastType = newForecast_Type,
            PeriodStart = newForecast_PeriodStart,
            PeriodEnd = newForecast_PeriodEnd,
            ProjectedAmount = newForecast_ProjectedAmount,
            ActualAmount = 0,
            Variance = 0,
            Assumptions = newForecast_Assumptions,
            CreatedBy = "FinanceManager"
        };

        try
        {
            await FinancialForecastService.CreateAsync(forecast);
            forecasts = await FinancialForecastService.GetAllAsync();
            CalculateSummary();

            newForecast_Name = string.Empty;
            newForecast_Type = "Revenue";
            newForecast_PeriodStart = new DateTime(DateTime.Today.Year, 1, 1);
            newForecast_PeriodEnd = new DateTime(DateTime.Today.Year, 12, 31);
            newForecast_ProjectedAmount = 0;
            newForecast_Assumptions = string.Empty;

            showCreateForecastModal = false;
        }
        catch
        {
        }
    }

    private void CalculateSummary()
    {
        totalProjectedRevenue = forecasts
            .Where(f => string.Equals(f.ForecastType, "Revenue", StringComparison.OrdinalIgnoreCase))
            .Sum(f => f.ProjectedAmount);
        totalProjectedExpense = forecasts
            .Where(f => string.Equals(f.ForecastType, "Expense", StringComparison.OrdinalIgnoreCase))
            .Sum(f => f.ProjectedAmount);
        totalProjectedNet = totalProjectedRevenue - totalProjectedExpense;
    }
}

