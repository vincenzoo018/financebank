                            <input type="checkbox" @onchange="() => showPin = !showPin" />
                            Show PIN
                        </label>
                    </div>
                    <div>
                        <label
                            style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Confirm
                            PIN *</label>
                        <input type="@(showPin ? "text" : "password")" @bind="confirmPin"
                            placeholder="Confirm 4-digit PIN" maxlength="4" required
                            style="width: 100%; padding: 12px 16px; border: 1px solid @(showError && string.IsNullOrEmpty(confirmPin) ? "#dc2626" : "#e5e7eb"); border-radius: 10px; font-size: 14px; box-sizing: border-box; letter-spacing: 6px; text-align: center;" />
                        @if (showError && string.IsNullOrEmpty(confirmPin))
                        {
                            <span
                                style="color: #dc2626; font-size: 12px;">Confirm PIN is required</span>
                        }
                        <div
                            style="margin-top: 8px; padding: 10px; background: #fef3c7; border-radius: 6px; border: 1px solid #fde68a;">
                            <p style="font-size: 11px; color: #92400e; margin: 0; font-weight: 600;">⚠️ PIN
                                Requirements:</p>
                            <ul style="font-size: 11px; color: #92400e; margin: 4px 0 0; padding-left: 20px;">
                                <li>Exactly 4 digits</li>
                                <li>Used for fund transfers</li>
                                <li>Keep it secure!</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Messages -->
