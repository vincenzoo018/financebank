                                <li>At least 1 lowercase letter (a-z)</li>
                                <li>At least 1 number (0-9)</li>
                                <li>At least 1 special character (!@@#$%^&*)</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Transfer PIN -->
            <div style="margin-bottom: 32px;">
                <h4
                    style="font-size: 16px; font-weight: 700; color: #1f2937; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
                    <span
                        style="width: 28px; height: 28px; background: #d1fae5; border-radius: 6px; display: flex; align-items: center; justify-content: center; color: #047857; font-size: 14px;">6</span>
