@page "/registrar/register-customer"
@layout RegistrarLayout
@using FinanceBank.Services
@using FinanceBank.Models
@using FinanceBank.Data
@using FinanceBank.Components
@using Microsoft.EntityFrameworkCore
@using Microsoft.Data.SqlClient
@inject AuthService AuthService
@inject IDbContextFactory<BFASDbContext> DbContextFactory
@inject PasswordHashingService PasswordHasher
@inject NavigationManager Navigation

<Toast @ref="toastComponent" />

<div style="padding: 24px; max-width: 900px; margin: 0 auto;">
    <!-- Header with Gradient -->
    <div
        style="background: linear-gradient(135deg, #047857, #065f46); border-radius: 16px; padding: 32px; margin-bottom: 32px; color: white;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div
                style="width: 56px; height: 56px; background: rgba(255,255,255,0.2); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="8.5" cy="7" r="4"></circle>
                    <line x1="20" y1="8" x2="20" y2="14"></line>
                    <line x1="23" y1="11" x2="17" y2="11"></line>
                </svg>
            </div>
            <div>
                <h1 style="font-size: 28px; font-weight: 700; margin: 0;">Register New Customer</h1>
                <p style="margin: 4px 0 0; opacity: 0.9; font-size: 14px;">Create a new customer account with banking
                    access</p>
            </div>
        </div>
    </div>

    <!-- Registration Form -->
    <div style="background: white; border-radius: 16px; padding: 32px; border: 1px solid #e5e7eb;">
        <form @onsubmit="HandleRegistration" @onsubmit:preventDefault>
            <!-- Personal Information -->
            <div style="margin-bottom: 32px;">
                <h4
                    style="font-size: 16px; font-weight: 700; color: #1f2937; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
                    <span
                        style="width: 28px; height: 28px; background: #d1fae5; border-radius: 6px; display: flex; align-items: center; justify-content: center; color: #047857; font-size: 14px;">1</span>
                    Personal Information
                </h4>
                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px;">
                    <div>
                        <label
                            style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Last
                            Name *</label>
                        <input type="text" @bind="lastName" placeholder="Enter last name" required
                            style="width: 100%; padding: 12px 16px; border: 1px solid @(showError && string.IsNullOrEmpty(lastName) ? "#dc2626" : "#e5e7eb"); border-radius: 10px; font-size: 14px; box-sizing: border-box;" />
                        @if (showError && string.IsNullOrEmpty(lastName))
                        {
                            <span
                                style="color: #dc2626; font-size: 12px;">Required</span>
                        }
                    </div>
                    <div>
                        <label
                            style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">First
                            Name *</label>
                        <input type="text" @bind="firstName" placeholder="Enter first name" required
                            style="width: 100%; padding: 12px 16px; border: 1px solid @(showError && string.IsNullOrEmpty(firstName) ? "#dc2626" : "#e5e7eb"); border-radius: 10px; font-size: 14px; box-sizing: border-box;" />
                        @if (showError && string.IsNullOrEmpty(firstName))
                        {
                            <span
                                style="color: #dc2626; font-size: 12px;">Required</span>
                        }
                    </div>
                    <div>
                        <label
                            style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Middle
                            Name</label>
                        <input type="text" @bind="middleName" placeholder="Enter middle name (optional)"
                            style="width: 100%; padding: 12px 16px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 14px; box-sizing: border-box;" />
                    </div>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px;">
                    <div>
                        <label
                            style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Email
                            Address *</label>
                        <input type="email" @bind="email" placeholder="customer@example.com" required
                            style="width: 100%; padding: 12px 16px; border: 1px solid @(showError && string.IsNullOrEmpty(email) ? "#dc2626" : "#e5e7eb"); border-radius: 10px; font-size: 14px; box-sizing: border-box;" />
                        @if (showError && string.IsNullOrEmpty(email))
                        {
                            <span
                                style="color: #dc2626; font-size: 12px;">Required</span>
                        }
                    </div>
                    <div>
                        <label
                            style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Phone
                            Number * (11 digits)</label>
                        <input type="tel" @bind="phoneNumber" placeholder="09XXXXXXXXX" maxlength="11" required
                            style="width: 100%; padding: 12px 16px; border: 1px solid @(showError && !string.IsNullOrEmpty(phoneNumberError) ? "#dc2626" : "#e5e7eb"); border-radius: 10px; font-size: 14px; box-sizing: border-box;" />
                        @if (showError && string.IsNullOrEmpty(phoneNumber))
                        {
                            <span
                                style="color: #dc2626; font-size: 12px;">Required</span>
                        }
                        @if (!string.IsNullOrEmpty(phoneNumberError))
                        {
                            <span
                                style="color: #dc2626; font-size: 12px; display: block;">@phoneNumberError</span>
                        }
                    </div>
                    <div>
                        <label
                            style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Address
                            *</label>
                        <input type="text" @bind="address" placeholder="Enter complete address" required
                            style="width: 100%; padding: 12px 16px; border: 1px solid @(showError && string.IsNullOrEmpty(address) ? "#dc2626" : "#e5e7eb"); border-radius: 10px; font-size: 14px; box-sizing: border-box;" />
                        @if (showError && string.IsNullOrEmpty(address))
                        {
                            <span
                                style="color: #dc2626; font-size: 12px;">Required</span>
                        }
                    </div>
                    <div>
                        <label
                            style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Date
                            of Birth * (Must be 18+)</label>
                        <input type="date"
                            @onchange="@((ChangeEventArgs e) => ValidateBirthDate(e.Value?.ToString() ?? ""))"
                            value="@dateOfBirthString"
                            style="width: 100%; padding: 12px 16px; border: 1px solid @(showError && !string.IsNullOrEmpty(birthDateError) ? "#dc2626" : "#e5e7eb"); border-radius: 10px; font-size: 14px; box-sizing: border-box;" />
                        @if (!string.IsNullOrEmpty(birthDateError))
                        {
                            <span
                                style="color: #dc2626; font-size: 12px; display: block;">@birthDateError</span>
                        }
                    </div>
                    <div>
                        <label
                            style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Gender</label>
                        <select @bind="gender"
                            style="width: 100%; padding: 12px 16px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 14px; box-sizing: border-box;">
                            <option value="">Select gender...</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div>
                        <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Civil Status *</label>
                        <select @bind="civilStatus" required
                            style="width: 100%; padding: 12px 16px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 14px; box-sizing: border-box;">
                            <option value="">Select civil status...</option>
                            <option value="Single">Single</option>
                            <option value="Married">Married</option>
                            <option value="Widowed">Widowed</option>
                            <option value="Separated">Separated</option>
                        </select>
                    </div>
                    <div>
                        <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Mother's Maiden Name</label>
                        <input type="text" @bind="motherMaidenName" placeholder="Enter mother's maiden name"
                            style="width: 100%; padding: 12px 16px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 14px; box-sizing: border-box;" />
                    </div>
                </div>
            </div>

            <!-- Employment Information (Required for Account Eligibility) -->
            <div style="margin-bottom: 32px;">
                <h4 style="font-size: 16px; font-weight: 700; color: #1f2937; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
                    <span style="width: 28px; height: 28px; background: #fef3c7; border-radius: 6px; display: flex; align-items: center; justify-content: center; color: #92400e; font-size: 14px;">2</span>
                    Employment & Income Information
                    <span style="font-size: 11px; font-weight: 500; color: #dc2626; background: #fee2e2; padding: 2px 8px; border-radius: 4px; margin-left: 8px;">Required for Account Eligibility</span>
                </h4>
                
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                    <div>
                        <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Employment Status *</label>
                        <select @bind="employmentStatus" required
                            style="width: 100%; padding: 12px 16px; border: 1px solid @(showError && string.IsNullOrEmpty(employmentStatus) ? "#dc2626" : "#e5e7eb"); border-radius: 10px; font-size: 14px; box-sizing: border-box;">
                            <option value="">Select employment status...</option>
                            <option value="Employed">Employed</option>
                            <option value="Self-Employed">Self-Employed</option>
                            <option value="Business Owner">Business Owner</option>
                            <option value="OFW">OFW (Overseas Filipino Worker)</option>
                            <option value="Freelancer">Freelancer</option>
                            <option value="Government Employee">Government Employee</option>
                            <option value="Retired">Retired</option>
                            <option value="Student">Student</option>
                            <option value="Unemployed">Unemployed</option>
                        </select>
                        @if (showError && string.IsNullOrEmpty(employmentStatus))
                        {
                            <span style="color: #dc2626; font-size: 12px;">Required</span>
                        }
                    </div>
                    <div>
                        <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Monthly Gross Income *</label>
                        <input type="number" @bind="monthlyGrossIncome" placeholder="Enter monthly income" min="0" step="0.01" required
                            style="width: 100%; padding: 12px 16px; border: 1px solid @(showError && monthlyGrossIncome <= 0 ? "#dc2626" : "#e5e7eb"); border-radius: 10px; font-size: 14px; box-sizing: border-box;" />
                        @if (showError && monthlyGrossIncome <= 0)
                        {
                            <span style="color: #dc2626; font-size: 12px;">Required</span>
                        }
                    </div>
                </div>

                @if (employmentStatus == "Employed" || employmentStatus == "Government Employee" || employmentStatus == "OFW")
                {
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px;">
                        <div>
                            <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Employer Name *</label>
                            <input type="text" @bind="employerName" placeholder="Enter employer/company name"
                                style="width: 100%; padding: 12px 16px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 14px; box-sizing: border-box;" />
                        </div>
                        <div>
                            <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Job Title/Position *</label>
                            <input type="text" @bind="jobTitle" placeholder="Enter job title"
                                style="width: 100%; padding: 12px 16px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 14px; box-sizing: border-box;" />
                        </div>
                        <div style="grid-column: span 2;">
                            <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Employer Address</label>
                            <input type="text" @bind="employerAddress" placeholder="Enter employer address"
                                style="width: 100%; padding: 12px 16px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 14px; box-sizing: border-box;" />
                        </div>
                        <div>
                            <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Employer Contact Number</label>
                            <input type="tel" @bind="employerContactNumber" placeholder="Enter employer phone"
                                style="width: 100%; padding: 12px 16px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 14px; box-sizing: border-box;" />
                        </div>
                        <div>
                            <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Years at Current Job</label>
                            <div style="display: flex; gap: 10px;">
                                <input type="number" @bind="yearsAtCurrentJob" placeholder="Years" min="0" max="50"
                                    style="width: 50%; padding: 12px 16px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 14px; box-sizing: border-box;" />
                                <input type="number" @bind="monthsAtCurrentJob" placeholder="Months" min="0" max="11"
                                    style="width: 50%; padding: 12px 16px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 14px; box-sizing: border-box;" />
                            </div>
                        </div>
                    </div>
                }

                @if (employmentStatus == "Self-Employed" || employmentStatus == "Business Owner" || employmentStatus == "Freelancer")
                {
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px;">
                        <div>
                            <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Business/Trade Name</label>
                            <input type="text" @bind="employerName" placeholder="Enter business name"
                                style="width: 100%; padding: 12px 16px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 14px; box-sizing: border-box;" />
                        </div>
                        <div>
                            <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Nature of Business</label>
                            <input type="text" @bind="jobTitle" placeholder="Enter nature of business"
                                style="width: 100%; padding: 12px 16px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 14px; box-sizing: border-box;" />
                        </div>
                        <div style="grid-column: span 2;">
                            <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Business Address</label>
                            <input type="text" @bind="employerAddress" placeholder="Enter business address"
                                style="width: 100%; padding: 12px 16px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 14px; box-sizing: border-box;" />
                        </div>
                        <div>
                            <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Years in Business</label>
                            <input type="number" @bind="yearsAtCurrentJob" placeholder="Years" min="0" max="50"
                                style="width: 100%; padding: 12px 16px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 14px; box-sizing: border-box;" />
                        </div>
                    </div>
                }

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px;">
                    <div>
                        <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Other Income Source</label>
                        <input type="text" @bind="otherIncomeSource" placeholder="e.g., Rental, Investments, Pension"
                            style="width: 100%; padding: 12px 16px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 14px; box-sizing: border-box;" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Other Income Amount (Monthly)</label>
                        <input type="number" @bind="otherIncomeAmount" placeholder="Enter amount" min="0" step="0.01"
                            style="width: 100%; padding: 12px 16px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 14px; box-sizing: border-box;" />
                    </div>
                </div>

                <!-- Government IDs -->
                <div style="margin-top: 24px; padding-top: 20px; border-top: 1px solid #e5e7eb;">
                    <p style="font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 16px;">Government IDs (At least one required)</p>
                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 16px;">
                        <div>
                            <label style="display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 6px;">TIN (Tax ID)</label>
                            <input type="text" @bind="taxIdentificationNumber" placeholder="XXX-XXX-XXX-XXX" maxlength="15"
                                style="width: 100%; padding: 10px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 13px; box-sizing: border-box;" />
                        </div>
                        <div>
                            <label style="display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 6px;">SSS Number</label>
                            <input type="text" @bind="sssNumber" placeholder="XX-XXXXXXX-X" maxlength="12"
                                style="width: 100%; padding: 10px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 13px; box-sizing: border-box;" />
                        </div>
                        <div>
                            <label style="display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 6px;">Pag-IBIG Number</label>
                            <input type="text" @bind="pagIbigNumber" placeholder="XXXX-XXXX-XXXX" maxlength="14"
                                style="width: 100%; padding: 10px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 13px; box-sizing: border-box;" />
                        </div>
                        <div>
                            <label style="display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 6px;">PhilHealth Number</label>
                            <input type="text" @bind="philHealthNumber" placeholder="XX-XXXXXXXXX-X" maxlength="14"
                                style="width: 100%; padding: 10px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 13px; box-sizing: border-box;" />
                        </div>
                    </div>
                </div>

                <!-- Spouse Information (if married) -->
                @if (civilStatus == "Married")
                {
                    <div style="margin-top: 24px; padding-top: 20px; border-top: 1px solid #e5e7eb;">
                        <p style="font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 16px;">Spouse Information</p>
                        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px;">
                            <div>
                                <label style="display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 6px;">Spouse Full Name</label>
                                <input type="text" @bind="spouseName" placeholder="Enter spouse's full name"
                                    style="width: 100%; padding: 10px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 13px; box-sizing: border-box;" />
                            </div>
                            <div>
                                <label style="display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 6px;">Spouse Employer</label>
                                <input type="text" @bind="spouseEmployer" placeholder="Enter spouse's employer"
                                    style="width: 100%; padding: 10px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 13px; box-sizing: border-box;" />
                            </div>
                            <div>
                                <label style="display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 6px;">Spouse Monthly Income</label>
                                <input type="number" @bind="spouseIncome" placeholder="Enter income" min="0" step="0.01"
                                    style="width: 100%; padding: 10px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 13px; box-sizing: border-box;" />
                            </div>
                        </div>
                    </div>
                }

                <!-- Eligibility Notice -->
                <div style="margin-top: 20px; padding: 16px; background: #eff6ff; border-radius: 10px; border: 1px solid #bfdbfe;">
                    <div style="display: flex; align-items: start; gap: 12px;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="16" x2="12" y2="12"></line>
                            <line x1="12" y1="8" x2="12.01" y2="8"></line>
                        </svg>
                        <div>
                            <p style="font-size: 13px; font-weight: 600; color: #1e40af; margin: 0 0 4px;">Account & Loan Eligibility</p>
                            <p style="font-size: 12px; color: #3b82f6; margin: 0;">Employment and income information is required to determine account eligibility and future loan qualification. Customers with verified employment may qualify for loan products.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Profile Picture Upload -->
            <div style="margin-bottom: 32px;">
                <h4
                    style="font-size: 16px; font-weight: 700; color: #1f2937; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
                    <span
                        style="width: 28px; height: 28px; background: #dbeafe; border-radius: 6px; display: flex; align-items: center; justify-content: center; color: #1e40af; font-size: 14px;">3</span>
                    Profile Picture
                </h4>
                <div
                    style="background: #f9fafb; border: 2px dashed #e5e7eb; border-radius: 12px; padding: 32px; text-align: center;">
                    <p style="margin: 0 0 16px; font-size: 14px; font-weight: 600; color: #1f2937;">Upload Profile
                        Picture</p>
                    <InputFile OnChange="HandleProfilePictureUpload" accept="image/*" style="display: none;"
                        id="profilePictureInput" />
                    <label for="profilePictureInput"
                        style="background: linear-gradient(135deg, #2563eb, #1e40af); color: white; padding: 12px 24px; border-radius: 8px; font-weight: 600; cursor: pointer; display: inline-block;">
                        Choose Picture
                    </label>
                    @if (!string.IsNullOrEmpty(profilePicturePreview))
                    {
                        <div style="margin-top: 20px;">
                            <p style="margin: 0 0 12px; font-size: 13px; color: #059669; font-weight: 600;">Profile Preview
                            </p>
                            <img src="@profilePicturePreview"
                                style="max-width: 200px; max-height: 200px; border-radius: 12px; border: 3px solid #2563eb; object-fit: cover;"
                                alt="Profile Preview" />
                            <button type="button" @onclick="RemoveProfilePicture"
                                style="display: block; margin: 12px auto 0; background: #dc2626; color: white; border: none; padding: 8px 16px; border-radius: 6px; font-size: 13px; cursor: pointer;">
                                Remove
                            </button>
                        </div>
                    }
                    <p style="margin: 16px 0 0; font-size: 12px; color: #6b7280;">Max file size: 2MB (JPG, PNG, GIF)</p>
                </div>
            </div>

            <!-- Valid ID Upload -->
            <div style="margin-bottom: 32px;">
                <h4
                    style="font-size: 16px; font-weight: 700; color: #1f2937; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
                    <span
                        style="width: 28px; height: 28px; background: #d1fae5; border-radius: 6px; display: flex; align-items: center; justify-content: center; color: #047857; font-size: 14px;">4</span>
                    Valid ID Upload
                </h4>
                <div
                    style="background: #f9fafb; border: 2px dashed #e5e7eb; border-radius: 12px; padding: 32px; text-align: center;">
                    <p style="margin: 0 0 16px; font-size: 14px; font-weight: 600; color: #1f2937;">Upload Valid ID</p>
                    <InputFile OnChange="HandleIDUpload" accept="image/*,.pdf" style="display: none;" id="idUpload" />
                    <label for="idUpload"
