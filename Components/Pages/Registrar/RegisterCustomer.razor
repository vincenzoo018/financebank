    private void ValidateBirthDate(string dateValue)
    {
        dateOfBirthString = dateValue;
        birthDateError = "";

        if (!string.IsNullOrEmpty(dateValue) && DateTime.TryParse(dateValue, out var birthDate))
        {
            var age = DateTime.Today.Year - birthDate.Year;
            if (birthDate.Date > DateTime.Today.AddYears(-age)) age--;

            if (age < 18)
            {
                birthDateError = "Customer must be at least 18 years old";
            }
        }
    }

    private bool ValidatePhoneNumber()
    {
        phoneNumberError = "";

        if (string.IsNullOrEmpty(phoneNumber))
        {
            phoneNumberError = "Phone number is required";
            return false;
        }

        // Remove any spaces or dashes
        var cleanNumber = phoneNumber.Replace(" ", "").Replace("-", "");

        if (cleanNumber.Length != 11)
        {
            phoneNumberError = "Phone number must be exactly 11 digits";
            return false;
        }

        if (!cleanNumber.All(char.IsDigit))
        {
            phoneNumberError = "Phone number must contain only digits";
            return false;
        }

        return true;
    }

    private async Task HandleRegistration()
    {
        showError = true;
        errorMessage = "";
        successMessage = "";
        passwordError = "";
        pinError = "";
        phoneNumberError = "";

        // Validate required fields (name is now split into parts)
        if (string.IsNullOrWhiteSpace(lastName) || string.IsNullOrWhiteSpace(firstName) ||
        string.IsNullOrWhiteSpace(email) ||
        string.IsNullOrWhiteSpace(phoneNumber) || string.IsNullOrWhiteSpace(address) ||
        string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(initialPassword))
        {
            errorMessage = "Please fill in all required personal information fields";
            return;
        }

        // Validate employment fields (required for loan applications)
        if (string.IsNullOrWhiteSpace(employmentStatus))
        {
            errorMessage = "Employment Status is required. Please select your employment status.";
            return;
        }

        if (monthlyGrossIncome <= 0)
        {
            errorMessage = "Monthly Gross Income is required. Please enter your income.";
            return;
        }

        // Validate phone number (11 digits)
        if (!ValidatePhoneNumber())
        {
            errorMessage = "Phone number must be exactly 11 digits";
            return;
        }

        // Validate birthdate (18+ years old)
        if (!string.IsNullOrEmpty(dateOfBirthString))
        {
            if (DateTime.TryParse(dateOfBirthString, out var birthDate))
            {
                var age = DateTime.Today.Year - birthDate.Year;
                if (birthDate.Date > DateTime.Today.AddYears(-age)) age--;

                if (age < 18)
                {
                    birthDateError = "Customer must be at least 18 years old";
                    errorMessage = "Customer must be at least 18 years old to register";
                    return;
                }
            }
        }

        // Validate password strength (minimum 12 characters)
        var (isValid, validationError) = PasswordHasher.ValidatePasswordStrength(initialPassword);
        if (!isValid)
        {
            passwordError = validationError;
            errorMessage = "Password does not meet security requirements";
            return;
        }

        // Validate PIN
        if (string.IsNullOrWhiteSpace(transferPin) || string.IsNullOrWhiteSpace(confirmPin))
        {
            pinError = "Transfer PIN is required";
            errorMessage = "Please enter and confirm your Transfer PIN";
            return;
        }

        if (transferPin.Length != 4 || !transferPin.All(char.IsDigit))
        {
            pinError = "PIN must be exactly 4 digits";
            errorMessage = "Transfer PIN must be exactly 4 digits";
            return;
        }

        if (transferPin != confirmPin)
        {
            pinError = "PINs do not match";
            errorMessage = "Transfer PIN and Confirm PIN must match";
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            using var context = await DbContextFactory.CreateDbContextAsync();

            // Check if username already exists
            var existingUser = await context.Users.FirstOrDefaultAsync(u => u.Username == username);
            if (existingUser != null)
            {
                errorMessage = "Username already exists. Please choose a different username.";
                isLoading = false;
                return;
            }

            // Check if email already exists
            var existingEmail = await context.Users.FirstOrDefaultAsync(u => u.Email == email);
            if (existingEmail != null)
            {
                errorMessage = "Email already exists. Please use a different email address.";
                isLoading = false;
                return;
            }

            // Get the maximum UserId from local database to ensure positive IDs
            var maxLocalUserId = await context.Users.MaxAsync(u => (int?)u.UserId) ?? 0;

            // Also check cloud database max ID to prevent conflicts
            int maxCloudUserId = 0;
            try
            {
                using var cloudConn = new SqlConnection("Server=db34283.public.databaseasp.net,1433;Database=db34283;User Id=db34283;Password=Zx6=2+fXCm8!;Encrypt=True;TrustServerCertificate=True;Connection Timeout=10;");
                await cloudConn.OpenAsync();
                using var cmd = new SqlCommand("SELECT ISNULL(MAX(UserId), 0) FROM Users", cloudConn);
                var result = await cmd.ExecuteScalarAsync();
                maxCloudUserId = Convert.ToInt32(result);
            }
            catch
            {
                // Cloud unavailable - continue with local max
            }

            // Reseed the IDENTITY if needed to ensure we get a positive ID higher than both local and cloud
            var nextSafeId = Math.Max(maxLocalUserId, maxCloudUserId) + 1;
            if (nextSafeId > maxLocalUserId + 1)
            {
                // Reseed local IDENTITY to avoid conflicts
                try
                {
                    await context.Database.ExecuteSqlRawAsync($"DBCC CHECKIDENT ('Users', RESEED, {nextSafeId - 1})");
                }
                catch
                {
                    // Reseeding failed - continue anyway, EF will handle it
                }
            }

            // Hash the password and PIN
            var hashedPassword = PasswordHasher.HashPassword(initialPassword);
            var hashedPin = PasswordHasher.HashPin(transferPin);

            // Create User record with Customer role
            var newUser = new AuthUser
            {
                Username = username,
                PasswordHash = hashedPassword,
                TransferPinHash = hashedPin,
                Role = "Customer",
                FullName = fullName,
                Email = email,
                PhoneNumber = phoneNumber,
                IsActive = true,
                CreatedAt = DateTime.Now,
                ValidIdDocument = validIdBytes,
                ValidIdFileName = uploadedIdFileName,
                ValidIdContentType = validIdContentType,
                ProfilePicture = profilePictureData,
                ProfilePictureFileName = string.IsNullOrEmpty(profilePicturePreview) ? null : "profile.jpg",
                ProfilePictureContentType = profilePictureContentType,
                // Employment Information
                EmploymentStatus = employmentStatus,
                EmployerName = employerName,
                EmployerAddress = employerAddress,
                EmployerContactNumber = employerContactNumber,
                JobTitle = jobTitle,
                YearsAtCurrentJob = yearsAtCurrentJob > 0 ? yearsAtCurrentJob : null,
                MonthsAtCurrentJob = monthsAtCurrentJob > 0 ? monthsAtCurrentJob : null,
                // Income Information
                MonthlyGrossIncome = monthlyGrossIncome > 0 ? monthlyGrossIncome : null,
                OtherIncomeSource = otherIncomeSource,
                OtherIncomeAmount = otherIncomeAmount > 0 ? otherIncomeAmount : null,
                TotalMonthlyIncome = monthlyGrossIncome + otherIncomeAmount,
                AnnualIncome = (monthlyGrossIncome + otherIncomeAmount) * 12,
                // Government IDs
                TaxIdentificationNumber = taxIdentificationNumber,
                SSSNumber = sssNumber,
                PagIbigNumber = pagIbigNumber,
                PhilHealthNumber = philHealthNumber,
                // Personal Details
                DateOfBirth = DateTime.TryParse(dateOfBirthString, out var dob) ? dob : null,
                Gender = !string.IsNullOrEmpty(gender) ? gender : null,
                CivilStatus = !string.IsNullOrEmpty(civilStatus) ? civilStatus : null,
                Nationality = "Filipino",
                MotherMaidenName = !string.IsNullOrEmpty(motherMaidenName) ? motherMaidenName : null,
                PermanentAddress = address,
                PresentAddress = address,
                SpouseName = spouseName,
                SpouseEmployer = spouseEmployer,
                SpouseIncome = spouseIncome > 0 ? spouseIncome : null
            };
            context.Users.Add(newUser);
            await context.SaveChangesAsync();

            // Also check cloud max AccountId to prevent conflicts
            int maxCloudAccountId = 0;
            try
            {
                using var cloudConn = new SqlConnection("Server=db34283.public.databaseasp.net,1433;Database=db34283;User Id=db34283;Password=Zx6=2+fXCm8!;Encrypt=True;TrustServerCertificate=True;Connection Timeout=10;");
                await cloudConn.OpenAsync();
                using var cmd = new SqlCommand("SELECT ISNULL(MAX(AccountId), 0) FROM CustomerAccounts", cloudConn);
                var result = await cmd.ExecuteScalarAsync();
                maxCloudAccountId = Convert.ToInt32(result);

                // Reseed CustomerAccounts IDENTITY if needed
                var maxLocalAccountId = await context.CustomerAccounts.MaxAsync(a => (int?)a.AccountId) ?? 0;
                var nextSafeAccountId = Math.Max(maxLocalAccountId, maxCloudAccountId) + 1;
                if (nextSafeAccountId > maxLocalAccountId + 1)
                {
                    await context.Database.ExecuteSqlRawAsync($"DBCC CHECKIDENT ('CustomerAccounts', RESEED, {nextSafeAccountId - 1})");
                }
            }
            catch
            {
                // Cloud unavailable - continue
            }

            // Create CustomerAccount for the user
            createdAccountNumber = CustomerAccount.GenerateAccountNumber();
            var customerAccount = new CustomerAccount
            {
                AccountNumber = createdAccountNumber,
                CustomerId = newUser.UserId,
                Balance = 0,
                AvailableBalance = 0,
                Currency = "PHP",
                Status = "ACTIVE",
                IsActive = true,
                CreatedAt = DateTime.Now
            };
            context.CustomerAccounts.Add(customerAccount);
            await context.SaveChangesAsync();

            successMessage = "Customer registered successfully!";

            if (toastComponent != null)
            {
                await toastComponent.Show("Success", $"Customer {fullName} registered successfully!\nAccount Number: {createdAccountNumber}");
            }

            // Clear form after brief delay
            await Task.Delay(1500);
        }
        catch (Exception ex)
        {
            // Check if it's a connection/database error
            if (ex.Message.Contains("connection") || ex.Message.Contains("network") ||
            ex.Message.Contains("SQL Server") || ex.Message.Contains("database") ||
            ex.Message.Contains("timeout") || ex.InnerException?.Message?.Contains("connection") == true)
            {
                errorMessage = "Unable to register customer - database connection unavailable. Please check your network connection and ensure the database server is running.";
            }
            else
            {
                errorMessage = $"Error: {ex.Message}";
            }
            System.Diagnostics.Debug.WriteLine($"Registration error: {ex}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

