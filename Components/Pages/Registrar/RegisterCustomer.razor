@page "/registrar/register-customer"
@layout RegistrarLayout
@using FinanceBank.Services
@using FinanceBank.Models
@using FinanceBank.Data
@using FinanceBank.Components
@using Microsoft.EntityFrameworkCore
@inject AuthService AuthService
@inject IDbContextFactory<BFASDbContext> DbContextFactory
@inject PasswordHashingService PasswordHasher
@inject NavigationManager Navigation

<Toast @ref="toastComponent" />

<div style="padding: 24px; max-width: 900px; margin: 0 auto;">
    <!-- Header with Gradient -->
    <div style="background: linear-gradient(135deg, #047857, #065f46); border-radius: 16px; padding: 32px; margin-bottom: 32px; color: white;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 56px; height: 56px; background: rgba(255,255,255,0.2); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="8.5" cy="7" r="4"></circle>
                    <line x1="20" y1="8" x2="20" y2="14"></line>
                    <line x1="23" y1="11" x2="17" y2="11"></line>
                </svg>
            </div>
            <div>
                <h1 style="font-size: 28px; font-weight: 700; margin: 0;">Register New Customer</h1>
                <p style="margin: 4px 0 0; opacity: 0.9; font-size: 14px;">Create a new customer account with banking access</p>
            </div>
        </div>
    </div>

    <!-- Registration Form -->
    <div style="background: white; border-radius: 16px; padding: 32px; border: 1px solid #e5e7eb;">
        <form @onsubmit="HandleRegistration" @onsubmit:preventDefault>
            <!-- Personal Information -->
            <div style="margin-bottom: 32px;">
                <h4 style="font-size: 16px; font-weight: 700; color: #1f2937; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
                    <span style="width: 28px; height: 28px; background: #d1fae5; border-radius: 6px; display: flex; align-items: center; justify-content: center; color: #047857; font-size: 14px;">1</span>
                    Personal Information
                </h4>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                    <div>
                        <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Full Name *</label>
                        <input type="text" @bind="fullName" placeholder="Enter full name" required
                            style="width: 100%; padding: 12px 16px; border: 1px solid @(showError && string.IsNullOrEmpty(fullName) ? "#dc2626" : "#e5e7eb"); border-radius: 10px; font-size: 14px; box-sizing: border-box;" />
                        @if (showError && string.IsNullOrEmpty(fullName)) { <span style="color: #dc2626; font-size: 12px;">Required</span> }
                    </div>
                    <div>
                        <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Email Address *</label>
                        <input type="email" @bind="email" placeholder="customer@example.com" required
                            style="width: 100%; padding: 12px 16px; border: 1px solid @(showError && string.IsNullOrEmpty(email) ? "#dc2626" : "#e5e7eb"); border-radius: 10px; font-size: 14px; box-sizing: border-box;" />
                        @if (showError && string.IsNullOrEmpty(email)) { <span style="color: #dc2626; font-size: 12px;">Required</span> }
                    </div>
                    <div>
                        <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Phone Number *</label>
                        <input type="tel" @bind="phoneNumber" placeholder="+63 9XX XXX XXXX" required
                            style="width: 100%; padding: 12px 16px; border: 1px solid @(showError && string.IsNullOrEmpty(phoneNumber) ? "#dc2626" : "#e5e7eb"); border-radius: 10px; font-size: 14px; box-sizing: border-box;" />
                        @if (showError && string.IsNullOrEmpty(phoneNumber)) { <span style="color: #dc2626; font-size: 12px;">Required</span> }
                    </div>
                    <div>
                        <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Address *</label>
                        <input type="text" @bind="address" placeholder="Enter complete address" required
                            style="width: 100%; padding: 12px 16px; border: 1px solid @(showError && string.IsNullOrEmpty(address) ? "#dc2626" : "#e5e7eb"); border-radius: 10px; font-size: 14px; box-sizing: border-box;" />
                        @if (showError && string.IsNullOrEmpty(address)) { <span style="color: #dc2626; font-size: 12px;">Required</span> }
                    </div>
                    <div>
                        <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Date of Birth</label>
                        <input type="date" @onchange="@((ChangeEventArgs e) => dateOfBirthString = e.Value?.ToString() ?? "")" value="@dateOfBirthString"
                            style="width: 100%; padding: 12px 16px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 14px; box-sizing: border-box;" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Gender</label>
                        <select @bind="gender" style="width: 100%; padding: 12px 16px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 14px; box-sizing: border-box;">
                            <option value="">Select gender...</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Profile Picture Upload -->
            <div style="margin-bottom: 32px;">
                <h4 style="font-size: 16px; font-weight: 700; color: #1f2937; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
                    <span style="width: 28px; height: 28px; background: #dbeafe; border-radius: 6px; display: flex; align-items: center; justify-content: center; color: #1e40af; font-size: 14px;">2</span>
                    Profile Picture
                </h4>
                <div style="background: #f9fafb; border: 2px dashed #e5e7eb; border-radius: 12px; padding: 32px; text-align: center;">
                    <p style="margin: 0 0 16px; font-size: 14px; font-weight: 600; color: #1f2937;">Upload Profile Picture</p>
                    <InputFile OnChange="HandleProfilePictureUpload" accept="image/*" style="display: none;" id="profilePictureInput" />
                    <label for="profilePictureInput" style="background: linear-gradient(135deg, #2563eb, #1e40af); color: white; padding: 12px 24px; border-radius: 8px; font-weight: 600; cursor: pointer; display: inline-block;">
                        Choose Picture
                    </label>
                    @if (!string.IsNullOrEmpty(profilePicturePreview))
                    {
                        <div style="margin-top: 20px;">
                            <p style="margin: 0 0 12px; font-size: 13px; color: #059669; font-weight: 600;">Profile Preview</p>
                            <img src="@profilePicturePreview" style="max-width: 200px; max-height: 200px; border-radius: 12px; border: 3px solid #2563eb; object-fit: cover;" alt="Profile Preview" />
                            <button type="button" @onclick="RemoveProfilePicture" style="display: block; margin: 12px auto 0; background: #dc2626; color: white; border: none; padding: 8px 16px; border-radius: 6px; font-size: 13px; cursor: pointer;">
                                Remove
                            </button>
                        </div>
                    }
                    <p style="margin: 16px 0 0; font-size: 12px; color: #6b7280;">Max file size: 2MB (JPG, PNG, GIF)</p>
                </div>
            </div>

            <!-- Valid ID Upload -->
            <div style="margin-bottom: 32px;">
                <h4 style="font-size: 16px; font-weight: 700; color: #1f2937; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
                    <span style="width: 28px; height: 28px; background: #d1fae5; border-radius: 6px; display: flex; align-items: center; justify-content: center; color: #047857; font-size: 14px;">3</span>
                    Valid ID Upload
                </h4>
                <div style="background: #f9fafb; border: 2px dashed #e5e7eb; border-radius: 12px; padding: 32px; text-align: center;">
                    <p style="margin: 0 0 16px; font-size: 14px; font-weight: 600; color: #1f2937;">Upload Valid ID</p>
                    <InputFile OnChange="HandleIDUpload" accept="image/*,.pdf" style="display: none;" id="idUpload" />
                    <label for="idUpload" style="background: linear-gradient(135deg, #047857, #059669); color: white; padding: 12px 24px; border-radius: 8px; font-weight: 600; cursor: pointer; display: inline-block;">
                        Choose File
                    </label>
                    @if (!string.IsNullOrEmpty(uploadedIdFileName))
                    {
                        <div style="margin-top: 16px; padding: 12px; background: #d1fae5; border-radius: 8px; color: #065f46; font-size: 13px;">
                            ✓ @uploadedIdFileName
                        </div>
                    }
                </div>
            </div>

            <!-- Account Credentials -->
            <div style="margin-bottom: 32px;">
                <h4 style="font-size: 16px; font-weight: 700; color: #1f2937; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
                    <span style="width: 28px; height: 28px; background: #d1fae5; border-radius: 6px; display: flex; align-items: center; justify-content: center; color: #047857; font-size: 14px;">4</span>
                    Account Credentials
                </h4>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                    <div>
                        <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Username *</label>
                        <input type="text" @bind="username" placeholder="Choose a username" required
                            style="width: 100%; padding: 12px 16px; border: 1px solid @(showError && string.IsNullOrEmpty(username) ? "#dc2626" : "#e5e7eb"); border-radius: 10px; font-size: 14px; box-sizing: border-box;" />
                        @if (showError && string.IsNullOrEmpty(username)) { <span style="color: #dc2626; font-size: 12px;">Required</span> }
                    </div>
                    <div>
                        <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Password *</label>
                        <input type="@(showPassword ? "text" : "password")" @bind="initialPassword" placeholder="Minimum 12 characters" required
                            style="width: 100%; padding: 12px 16px; border: 1px solid @(showError && string.IsNullOrEmpty(initialPassword) ? "#dc2626" : "#e5e7eb"); border-radius: 10px; font-size: 14px; box-sizing: border-box;" />
                        @if (showError && string.IsNullOrEmpty(initialPassword)) { <span style="color: #dc2626; font-size: 12px;">Password is required</span> }
                        @if (!string.IsNullOrEmpty(passwordError)) { <span style="color: #dc2626; font-size: 12px; display: block; margin-top: 4px;">@passwordError</span> }
                        <label style="font-size: 12px; margin-top: 8px; display: flex; align-items: center; gap: 4px; cursor: pointer;">
                            <input type="checkbox" @onchange="() => showPassword = !showPassword" />
                            Show Password
                        </label>
                        <div style="margin-top: 8px; padding: 10px; background: #f0fdf4; border-radius: 6px; border: 1px solid #bbf7d0;">
                            <p style="font-size: 11px; color: #047857; margin: 0 0 4px; font-weight: 600;">Password Requirements:</p>
                            <ul style="font-size: 11px; color: #047857; margin: 0; padding-left: 20px;">
                                <li>Minimum 12 characters</li>
                                <li>At least 1 uppercase letter (A-Z)</li>
                                <li>At least 1 lowercase letter (a-z)</li>
                                <li>At least 1 number (0-9)</li>
                                <li>At least 1 special character (!@@#$%^&*)</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Transfer PIN -->
            <div style="margin-bottom: 32px;">
                <h4 style="font-size: 16px; font-weight: 700; color: #1f2937; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
                    <span style="width: 28px; height: 28px; background: #d1fae5; border-radius: 6px; display: flex; align-items: center; justify-content: center; color: #047857; font-size: 14px;">5</span>
                    Transfer PIN
                </h4>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                    <div>
                        <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Transfer PIN *</label>
                        <input type="@(showPin ? "text" : "password")" @bind="transferPin" placeholder="Enter 4-digit PIN" maxlength="4" required
                            style="width: 100%; padding: 12px 16px; border: 1px solid @(showError && string.IsNullOrEmpty(transferPin) ? "#dc2626" : "#e5e7eb"); border-radius: 10px; font-size: 14px; box-sizing: border-box; letter-spacing: 6px; text-align: center;" />
                        @if (showError && string.IsNullOrEmpty(transferPin)) { <span style="color: #dc2626; font-size: 12px;">PIN is required</span> }
                        @if (!string.IsNullOrEmpty(pinError)) { <span style="color: #dc2626; font-size: 12px; display: block; margin-top: 4px;">@pinError</span> }
                        <label style="font-size: 12px; margin-top: 8px; display: flex; align-items: center; gap: 4px; cursor: pointer;">
                            <input type="checkbox" @onchange="() => showPin = !showPin" />
                            Show PIN
                        </label>
                    </div>
                    <div>
                        <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">Confirm PIN *</label>
                        <input type="@(showPin ? "text" : "password")" @bind="confirmPin" placeholder="Confirm 4-digit PIN" maxlength="4" required
                            style="width: 100%; padding: 12px 16px; border: 1px solid @(showError && string.IsNullOrEmpty(confirmPin) ? "#dc2626" : "#e5e7eb"); border-radius: 10px; font-size: 14px; box-sizing: border-box; letter-spacing: 6px; text-align: center;" />
                        @if (showError && string.IsNullOrEmpty(confirmPin)) { <span style="color: #dc2626; font-size: 12px;">Confirm PIN is required</span> }
                        <div style="margin-top: 8px; padding: 10px; background: #fef3c7; border-radius: 6px; border: 1px solid #fde68a;">
                            <p style="font-size: 11px; color: #92400e; margin: 0; font-weight: 600;">⚠️ PIN Requirements:</p>
                            <ul style="font-size: 11px; color: #92400e; margin: 4px 0 0; padding-left: 20px;">
                                <li>Exactly 4 digits</li>
                                <li>Used for fund transfers</li>
                                <li>Keep it secure!</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Messages -->
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div style="padding: 16px; background: #fee2e2; border-radius: 12px; color: #991b1b; margin-bottom: 20px; display: flex; align-items: center; gap: 12px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="15" y1="9" x2="9" y2="15"></line>
                        <line x1="9" y1="9" x2="15" y2="15"></line>
                    </svg>
                    @errorMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div style="padding: 20px; background: #d1fae5; border-radius: 12px; color: #065f46; margin-bottom: 20px;">
                    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        <strong>Customer Registered Successfully!</strong>
                    </div>
                    <div style="background: white; border-radius: 8px; padding: 16px; font-size: 14px;">
                        <p style="margin: 0 0 8px;"><strong>Account Number:</strong> @createdAccountNumber</p>
                        <p style="margin: 0 0 8px;"><strong>Username:</strong> @username</p>
                        <p style="margin: 0;"><strong>Customer:</strong> @fullName</p>
                    </div>
                </div>
            }

            <!-- Buttons -->
            <div style="display: flex; gap: 12px; justify-content: flex-end; padding-top: 20px; border-top: 2px solid #e5e7eb;">
                <button type="button" @onclick="ClearForm"
                    style="background: #f3f4f6; color: #374151; padding: 12px 24px; border-radius: 10px; border: none; font-weight: 600; cursor: pointer; font-size: 14px;">
                    Clear Form
                </button>
                <button type="submit" disabled="@isLoading"
                    style="background: linear-gradient(135deg, #047857, #059669); color: white; padding: 12px 32px; border-radius: 10px; border: none; font-weight: 600; cursor: pointer; font-size: 14px; display: flex; align-items: center; gap: 8px;">
                    @if (isLoading)
                    {
                        <span style="width: 16px; height: 16px; border: 2px solid rgba(255,255,255,0.3); border-top-color: white; border-radius: 50%; animation: spin 1s linear infinite;"></span>
                        <span>Registering...</span>
                    }
                    else
                    {
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="8.5" cy="7" r="4"></circle>
                            <line x1="20" y1="8" x2="20" y2="14"></line>
                            <line x1="23" y1="11" x2="17" y2="11"></line>
                        </svg>
                        <span>Register Customer</span>
                    }
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    @@keyframes spin { to { transform: rotate(360deg); } }
</style>

@code {
    private Toast? toastComponent;
    
    // Personal Information
    private string fullName = "";
    private string email = "";
    private string phoneNumber = "";
    private string address = "";
    private string dateOfBirthString = "";
    private string gender = "";
    private string uploadedIdFileName = "";
    private byte[]? validIdBytes;
    private string validIdContentType = "";
    
    // Profile Picture
    private string profilePicturePreview = "";
    private byte[]? profilePictureData;
    private string profilePictureContentType = "";
    
    // Account Credentials
    private string username = "";
    private string initialPassword = "";
    private bool showPassword = false;
    
    // Transfer PIN
    private string transferPin = "";
    private string confirmPin = "";
    private bool showPin = false;
    
    // State
    private bool showError = false;
    private bool isLoading = false;
    private string errorMessage = "";
    private string successMessage = "";
    private string passwordError = "";
    private string pinError = "";
    private string createdAccountNumber = "";

    private async Task HandleRegistration()
    {
        showError = true;
        errorMessage = "";
        successMessage = "";
        passwordError = "";
        pinError = "";

        // Validate required fields
        if (string.IsNullOrWhiteSpace(fullName) || string.IsNullOrWhiteSpace(email) || 
            string.IsNullOrWhiteSpace(phoneNumber) || string.IsNullOrWhiteSpace(address) ||
            string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(initialPassword))
        {
            errorMessage = "Please fill in all required fields";
            return;
        }

        // Validate password strength (minimum 12 characters)
        var (isValid, validationError) = PasswordHasher.ValidatePasswordStrength(initialPassword);
        if (!isValid)
        {
            passwordError = validationError;
            errorMessage = "Password does not meet security requirements";
            return;
        }

        // Validate PIN
        if (string.IsNullOrWhiteSpace(transferPin) || string.IsNullOrWhiteSpace(confirmPin))
        {
            pinError = "Transfer PIN is required";
            errorMessage = "Please enter and confirm your Transfer PIN";
            return;
        }

        if (transferPin.Length != 4 || !transferPin.All(char.IsDigit))
        {
            pinError = "PIN must be exactly 4 digits";
            errorMessage = "Transfer PIN must be exactly 4 digits";
            return;
        }

        if (transferPin != confirmPin)
        {
            pinError = "PINs do not match";
            errorMessage = "Transfer PIN and Confirm PIN must match";
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            using var context = await DbContextFactory.CreateDbContextAsync();
            
            // Check if username already exists
            var existingUser = await context.Users.FirstOrDefaultAsync(u => u.Username == username);
            if (existingUser != null)
            {
                errorMessage = "Username already exists. Please choose a different username.";
                isLoading = false;
                return;
            }

            // Check if email already exists
            var existingEmail = await context.Users.FirstOrDefaultAsync(u => u.Email == email);
            if (existingEmail != null)
            {
                errorMessage = "Email already exists. Please use a different email address.";
                isLoading = false;
                return;
            }

            // Hash the password and PIN
            var hashedPassword = PasswordHasher.HashPassword(initialPassword);
            var hashedPin = PasswordHasher.HashPin(transferPin);

            // Create User record with Customer role
            var newUser = new AuthUser
            {
                Username = username,
                PasswordHash = hashedPassword,
                TransferPinHash = hashedPin,
                Role = "Customer",
                FullName = fullName,
                Email = email,
                PhoneNumber = phoneNumber,
                IsActive = true,
                CreatedAt = DateTime.Now,
                ValidIdDocument = validIdBytes,
                ValidIdFileName = uploadedIdFileName,
                ValidIdContentType = validIdContentType,
                ProfilePicture = profilePictureData,
                ProfilePictureFileName = string.IsNullOrEmpty(profilePicturePreview) ? null : "profile.jpg",
                ProfilePictureContentType = profilePictureContentType
            };
            context.Users.Add(newUser);
            await context.SaveChangesAsync();

            // Create CustomerAccount for the user
            createdAccountNumber = CustomerAccount.GenerateAccountNumber();
            var customerAccount = new CustomerAccount
            {
                AccountNumber = createdAccountNumber,
                CustomerId = newUser.UserId,
                Balance = 0,
                AvailableBalance = 0,
                Currency = "PHP",
                Status = "ACTIVE",
                IsActive = true,
                CreatedAt = DateTime.Now
            };
            context.CustomerAccounts.Add(customerAccount);
            await context.SaveChangesAsync();

            successMessage = "Customer registered successfully!";
            
            if (toastComponent != null)
            {
                await toastComponent.Show("Success", $"Customer {fullName} registered successfully!\nAccount Number: {createdAccountNumber}");
            }

            // Clear form after brief delay
            await Task.Delay(1500);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            Console.WriteLine($"Registration error: {ex}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ClearForm()
    {
        fullName = "";
        email = "";
        phoneNumber = "";
        address = "";
        dateOfBirthString = "";
        gender = "";
        username = "";
        initialPassword = "";
        transferPin = "";
        confirmPin = "";
        uploadedIdFileName = "";
        showError = false;
        showPassword = false;
        showPin = false;
        errorMessage = "";
        successMessage = "";
        passwordError = "";
        pinError = "";
        createdAccountNumber = "";
    }

    private async Task HandleIDUpload(InputFileChangeEventArgs e)
    {
        try
        {
            errorMessage = "";
            
            if (e.FileCount == 0) return;

            var file = e.GetMultipleFiles(1).FirstOrDefault();
            if (file == null) return;

            // Validate file size (5MB max)
            const long maxFileSize = 5 * 1024 * 1024;
            if (file.Size > maxFileSize)
            {
                errorMessage = "File size must not exceed 5MB";
                StateHasChanged();
                return;
            }

            // Validate file extension
            var allowedExtensions = new[] { ".jpg", ".jpeg", ".png", ".pdf" };
            var fileName = file.Name.ToLower();
            var hasValidExtension = allowedExtensions.Any(ext => fileName.EndsWith(ext));
            
            if (!hasValidExtension)
            {
                errorMessage = "Only JPG, PNG, and PDF files are allowed";
                StateHasChanged();
                return;
            }

            // Read file into byte array
            using var memoryStream = new MemoryStream();
            await file.OpenReadStream(maxFileSize).CopyToAsync(memoryStream);
            validIdBytes = memoryStream.ToArray();
            
            // File is valid
            uploadedIdFileName = file.Name;
            validIdContentType = file.ContentType;
            errorMessage = "";
            
            if (toastComponent != null)
            {
                await toastComponent.Show("ID Upload", $"File uploaded: {file.Name}");
            }
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error uploading file: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task HandleProfilePictureUpload(InputFileChangeEventArgs e)
    {
        try
        {
            errorMessage = "";
            
            if (e.FileCount == 0) return;

            var file = e.GetMultipleFiles(1).FirstOrDefault();
            if (file == null) return;

            // Validate file size (2MB max for profile pictures)
            const long maxFileSize = 2 * 1024 * 1024;
            if (file.Size > maxFileSize)
            {
                errorMessage = "Profile picture size must not exceed 2MB";
                StateHasChanged();
                return;
            }

            // Validate file extension
            var allowedExtensions = new[] { ".jpg", ".jpeg", ".png", ".gif" };
            var fileName = file.Name.ToLower();
            var hasValidExtension = allowedExtensions.Any(ext => fileName.EndsWith(ext));
            
            if (!hasValidExtension)
            {
                errorMessage = "Only JPG, PNG, and GIF image files are allowed for profile pictures";
                StateHasChanged();
                return;
            }

            // Read file into byte array and create preview
            using var memoryStream = new MemoryStream();
            await file.OpenReadStream(maxFileSize).CopyToAsync(memoryStream);
            profilePictureData = memoryStream.ToArray();
            
            // Create base64 preview
            var base64 = Convert.ToBase64String(profilePictureData);
            profilePicturePreview = $"data:{file.ContentType};base64,{base64}";
            profilePictureContentType = file.ContentType;
            
            errorMessage = "";
            
            if (toastComponent != null)
            {
                await toastComponent.Show("Profile Picture Uploaded", $"File: {file.Name}");
            }
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error uploading profile picture: {ex.Message}";
            StateHasChanged();
        }
    }

    private void RemoveProfilePicture()
    {
        profilePicturePreview = "";
        profilePictureData = null;
        profilePictureContentType = "";
        StateHasChanged();
    }
}
