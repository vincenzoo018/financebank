            {
                <div
                    style="padding: 16px; background: #fee2e2; border-radius: 12px; color: #991b1b; margin-bottom: 20px; display: flex; align-items: center; gap: 12px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
