@page "/registrar/customers"
@layout RegistrarLayout
@using FinanceBank.Services
@using FinanceBank.Models
@using FinanceBank.Data
@using Microsoft.EntityFrameworkCore
@inject AuthService AuthService
@inject IDbContextFactory<BFASDbContext> DbContextFactory
@inject NavigationManager Navigation

<div style="padding: 24px;">
    <!-- Header Section -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px;">
        <div>
            <h1 style="font-size: 28px; font-weight: 600; color: #2B2B2B; margin: 0 0 8px;">Customer List</h1>
            <p style="color: #6B6B6B; margin: 0; font-size: 14px;">View and manage all registered customers</p>
        </div>
        <button @onclick="@(() => Navigation.NavigateTo("/registrar/register-customer"))"
            style="background: linear-gradient(135deg, #2F3E2A, #5F6F52); color: white; padding: 12px 24px; border-radius: 10px; border: none; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 14px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="8.5" cy="7" r="4"></circle>
                <line x1="20" y1="8" x2="20" y2="14"></line>
                <line x1="23" y1="11" x2="17" y2="11"></line>
            </svg>
            Register New Customer
        </button>
    </div>

    <!-- Stats Cards -->
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 32px;">
        <div style="background: #FFFFFF; border-radius: 14px; padding: 24px; border: 1px solid #E2E2DC;">
            <div style="display: flex; align-items: center; gap: 16px;">
                <div
                    style="width: 48px; height: 48px; background: rgba(95, 111, 82, 0.15); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#5F6F52" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                </div>
                <div>
                    <p style="font-size: 13px; color: #6B6B6B; margin: 0;">Total Customers</p>
                    <p style="font-size: 28px; font-weight: 600; color: #2B2B2B; margin: 0;">@totalCustomers</p>
                </div>
            </div>
        </div>
        <div style="background: #FFFFFF; border-radius: 14px; padding: 24px; border: 1px solid #E2E2DC;">
            <div style="display: flex; align-items: center; gap: 16px;">
                <div
                    style="width: 48px; height: 48px; background: rgba(95, 111, 82, 0.2); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2F3E2A" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                </div>
                <div>
                    <p style="font-size: 13px; color: #6B6B6B; margin: 0;">Active Accounts</p>
                    <p style="font-size: 28px; font-weight: 600; color: #2F3E2A; margin: 0;">@activeAccounts</p>
                </div>
            </div>
        </div>
        <div style="background: #FFFFFF; border-radius: 14px; padding: 24px; border: 1px solid #E2E2DC;">
            <div style="display: flex; align-items: center; gap: 16px;">
                <div
                    style="width: 48px; height: 48px; background: rgba(196, 154, 58, 0.15); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C49A3A" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                </div>
                <div>
                    <p style="font-size: 13px; color: #6B6B6B; margin: 0;">Pending Accounts</p>
                    <p style="font-size: 28px; font-weight: 600; color: #C49A3A; margin: 0;">@pendingAccounts</p>
                </div>
            </div>
        </div>
        <div style="background: #FFFFFF; border-radius: 14px; padding: 24px; border: 1px solid #E2E2DC;">
            <div style="display: flex; align-items: center; gap: 16px;">
                <div
                    style="width: 48px; height: 48px; background: rgba(139, 90, 43, 0.12); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#8B5A2B" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                </div>
                <div>
                    <p style="font-size: 13px; color: #6B6B6B; margin: 0;">New This Month</p>
                    <p style="font-size: 28px; font-weight: 600; color: #8B5A2B; margin: 0;">@newThisMonth</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Search and Filter -->
    <div
        style="background: #FFFFFF; border-radius: 14px; padding: 20px; margin-bottom: 24px; border: 1px solid #E2E2DC;">
        <div style="display: flex; gap: 16px; align-items: center;">
            <div style="flex: 1; position: relative;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6B6B6B" stroke-width="2"
                    style="position: absolute; left: 16px; top: 50%; transform: translateY(-50%);">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.35-4.35"></path>
                </svg>
                <input type="text" @bind="searchQuery" @bind:event="oninput" @onkeyup="HandleSearch"
                    placeholder="Search by name, email, account number..."
                    style="width: 100%; padding: 12px 16px 12px 48px; border: 1px solid #E2E2DC; border-radius: 10px; font-size: 14px; box-sizing: border-box;" />
            </div>
            <select @bind="statusFilter" @bind:after="FilterCustomers"
                style="padding: 12px 16px; border: 1px solid #E2E2DC; border-radius: 10px; font-size: 14px; min-width: 150px; background: #FFFFFF; cursor: pointer;">
                <option value="">All Status</option>
                <option value="ACTIVE">Active</option>
                <option value="PENDING">Pending</option>
                <option value="INACTIVE">Inactive</option>
            </select>
            <button @onclick="RefreshData"
                style="padding: 12px 20px; border: 1px solid #E2E2DC; border-radius: 10px; background: #FFFFFF; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 14px; color: #2B2B2B;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="23 4 23 10 17 10"></polyline>
                    <polyline points="1 20 1 14 7 14"></polyline>
                    <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                </svg>
                Refresh
            </button>
        </div>
    </div>

    <!-- Customer Table -->
    <div style="background: #FFFFFF; border-radius: 14px; border: 1px solid #E2E2DC; overflow: hidden;">
        @if (isLoading)
        {
            <div style="padding: 60px; text-align: center;">
                <div
                    style="width: 48px; height: 48px; border: 3px solid #E2E2DC; border-top-color: #2F3E2A; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto 16px;">
                </div>
                <p style="color: #6B6B6B; margin: 0;">Loading customers...</p>
            </div>
        }
        else if (filteredCustomers == null || filteredCustomers.Count == 0)
        {
            <div style="padding: 60px; text-align: center;">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#E2E2DC" stroke-width="2"
                    style="margin: 0 auto 16px; display: block;">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
                <h3 style="color: #6B6B6B; margin: 0 0 8px;">No customers found</h3>
                <p style="color: #6B6B6B; margin: 0 0 20px;">@(string.IsNullOrEmpty(searchQuery) ? "Start by registering a new customer" : "Try adjusting your search or filters")</p>
                <button @onclick="@(() => Navigation.NavigateTo("/registrar/register-customer"))"
                    style="background: #2F3E2A; color: #FFFFFF; padding: 10px 20px; border-radius: 10px; border: none; font-weight: 600; cursor: pointer;">
                    Register First Customer
                </button>
            </div>
        }
        else
        {
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="background: #F7F7F4;">
                        <th
                            style="text-align: left; padding: 16px 20px; font-size: 12px; font-weight: 600; color: #6B6B6B; text-transform: uppercase; border-bottom: 1px solid #E2E2DC;">
                            Customer</th>
                        <th
                            style="text-align: left; padding: 16px 20px; font-size: 12px; font-weight: 600; color: #6B6B6B; text-transform: uppercase; border-bottom: 1px solid #E2E2DC;">
                            Account Number</th>
                        <th
                            style="text-align: left; padding: 16px 20px; font-size: 12px; font-weight: 600; color: #6B6B6B; text-transform: uppercase; border-bottom: 1px solid #E2E2DC;">
                            Contact</th>
                        <th
                            style="text-align: left; padding: 16px 20px; font-size: 12px; font-weight: 600; color: #6B6B6B; text-transform: uppercase; border-bottom: 1px solid #E2E2DC;">
                            Balance</th>
                        <th
                            style="text-align: left; padding: 16px 20px; font-size: 12px; font-weight: 600; color: #6B6B6B; text-transform: uppercase; border-bottom: 1px solid #E2E2DC;">
                            Status</th>
                        <th
                            style="text-align: left; padding: 16px 20px; font-size: 12px; font-weight: 600; color: #6B6B6B; text-transform: uppercase; border-bottom: 1px solid #E2E2DC;">
                            Registered</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in filteredCustomers)
                    {
                        <tr style="border-bottom: 1px solid #E2E2DC; transition: background 0.15s;"
                            onmouseover="this.style.background='#F7F7F4'" onmouseout="this.style.background='#FFFFFF'">
                            <td style="padding: 16px 20px;">
                                <div style="display: flex; align-items: center; gap: 12px;">
                                    <div
                                        style="width: 40px; height: 40px; background: rgba(95, 111, 82, 0.2); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-weight: 600; color: #2F3E2A; font-size: 14px;">
                                        @GetInitials(customer.CustomerName)
                                    </div>
                                    <div>
                                        <p style="margin: 0; font-weight: 600; color: #2B2B2B;">@customer.CustomerName</p>
                                        <p style="margin: 2px 0 0; font-size: 12px; color: #6B6B6B;">@@customer.Username</p>
                                    </div>
                                </div>
                            </td>
                            <td style="padding: 16px 20px;">
                                <span
                                    style="font-family: monospace; font-size: 14px; color: #2B2B2B; background: #F7F7F4; padding: 4px 10px; border-radius: 6px;">@customer.AccountNumber</span>
                            </td>
                            <td style="padding: 16px 20px;">
                                <p style="margin: 0; font-size: 14px; color: #2B2B2B;">@customer.Email</p>
                                <p style="margin: 2px 0 0; font-size: 12px; color: #6B6B6B;">@customer.Phone</p>
                            </td>
                            <td style="padding: 16px 20px;">
                                <span
                                    style="font-size: 14px; font-weight: 600; color: #2F3E2A;">₱@customer.Balance.ToString("N2")</span>
                            </td>
                            <td style="padding: 16px 20px;">
                                <span
                                    style="padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; @GetStatusStyle(customer.Status)">
                                    @customer.Status
                                </span>
                            </td>
                            <td style="padding: 16px 20px;">
                                <span style="font-size: 13px; color: #6B6B6B;">@customer.RegisteredAt.ToString("MMM dd, yyyy")</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Pagination -->
            <div
                style="padding: 16px 20px; background: #F7F7F4; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #E2E2DC;">
                <span style="font-size: 13px; color: #6B6B6B;">Showing @filteredCustomers.Count of @allCustomers.Count
                    customers</span>
                <div style="display: flex; gap: 8px;">
                    <button disabled="@(currentPage == 1)" @onclick="PreviousPage"
                        style="padding: 8px 16px; border: 1px solid #E2E2DC; border-radius: 10px; background: #FFFFFF; cursor: pointer; font-size: 13px; color: #2B2B2B; opacity: @(currentPage == 1 ? "0.5" : "1");">
                        Previous
                    </button>
                    <span style="padding: 8px 16px; font-size: 13px; color: #6B6B6B;">Page @currentPage of
                        @totalPages</span>
                    <button disabled="@(currentPage >= totalPages)" @onclick="NextPage"
                        style="padding: 8px 16px; border: 1px solid #E2E2DC; border-radius: 10px; background: #FFFFFF; cursor: pointer; font-size: 13px; color: #2B2B2B; opacity: @(currentPage >= totalPages ? "0.5" : "1");">
                        Next
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<style>
    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

@code {
    private List<CustomerViewModel> allCustomers = new();
    private List<CustomerViewModel> filteredCustomers = new();

    private string searchQuery = "";
    private string statusFilter = "";
    private bool isLoading = true;

    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages => (int)Math.Ceiling((double)allCustomers.Count / pageSize);

    private int totalCustomers = 0;
    private int activeAccounts = 0;
    private int pendingAccounts = 0;
    private int newThisMonth = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            using var context = await DbContextFactory.CreateDbContextAsync();

            // Get all customers (users with Customer role) and their accounts
            var customers = await (from user in context.Users
                                   where user.Role == "Customer"
                                   join account in context.CustomerAccounts on user.UserId equals account.CustomerId into accountGroup
                                   from acc in accountGroup.DefaultIfEmpty()
                                   select new CustomerViewModel
                                   {
                                       UserId = user.UserId,
                                       CustomerName = user.FullName ?? user.Username,
                                       Username = user.Username,
                                       Email = user.Email ?? "",
                                       Phone = user.PhoneNumber ?? "",
                                       AccountNumber = acc != null ? acc.AccountNumber : "N/A",
                                       Balance = acc != null ? acc.Balance : 0,
                                       Status = acc != null ? acc.Status : (user.IsActive ? "ACTIVE" : "INACTIVE"),
                                       RegisteredAt = user.CreatedAt
                                   }).ToListAsync();

            allCustomers = customers.OrderByDescending(c => c.RegisteredAt).ToList();

            // Calculate stats
            totalCustomers = allCustomers.Count;
            activeAccounts = allCustomers.Count(c => c.Status == "ACTIVE");
            pendingAccounts = allCustomers.Count(c => c.Status == "PENDING");

            var startOfMonth = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
            newThisMonth = allCustomers.Count(c => c.RegisteredAt >= startOfMonth);

            FilterCustomers();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading customers: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void FilterCustomers()
    {
        var filtered = allCustomers.AsQueryable();

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var query = searchQuery.ToLower();
            filtered = filtered.Where(c =>
            c.CustomerName.ToLower().Contains(query) ||
            c.Email.ToLower().Contains(query) ||
            c.AccountNumber.ToLower().Contains(query) ||
            c.Username.ToLower().Contains(query));
        }

        if (!string.IsNullOrWhiteSpace(statusFilter))
        {
            filtered = filtered.Where(c => c.Status == statusFilter);
        }

        filteredCustomers = filtered
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

        StateHasChanged();
    }

    private void HandleSearch(KeyboardEventArgs e)
    {
        currentPage = 1;
        FilterCustomers();
    }

    private async Task RefreshData()
    {
        currentPage = 1;
        searchQuery = "";
        statusFilter = "";
        await LoadData();
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            FilterCustomers();
        }
    }

    private void NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            FilterCustomers();
        }
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrEmpty(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return name.Substring(0, Math.Min(2, name.Length)).ToUpper();
    }

    private string GetStatusStyle(string status) => status switch
    {
        "ACTIVE" => "background: rgba(95, 111, 82, 0.2); color: #2F3E2A;",
        "PENDING" => "background: rgba(196, 154, 58, 0.15); color: #C49A3A;",
        "INACTIVE" => "background: rgba(155, 58, 58, 0.1); color: #9B3A3A;",
        _ => "background: #F7F7F4; color: #2B2B2B;"
    };

    private class CustomerViewModel
    {
        public int UserId { get; set; }
        public string CustomerName { get; set; } = "";
        public string Username { get; set; } = "";
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
        public string AccountNumber { get; set; } = "";
        public decimal Balance { get; set; }
        public string Status { get; set; } = "";
        public DateTime RegisteredAt { get; set; }
    }
}