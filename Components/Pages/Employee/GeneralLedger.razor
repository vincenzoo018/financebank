@page "/employee/ledger"
@layout EmployeeLayout
@using FinanceBank.Services
@using FinanceBank.Models
@inject AuthService AuthService
@inject GeneralLedgerService GeneralLedgerService

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #059669 0%, #047857 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
            <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path d="M3 12h18M3 6h18M3 18h18"/>
            </svg>
        </div>
        <div>
            <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">General Ledger</h1>
            <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">View all account transactions</p>
        </div>
    </div>
</div>

<!-- Filters -->
<div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb; margin-bottom: 20px; display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end;">
    <div style="flex: 1 1 200px;">
        <label style="display:block; font-size:12px; font-weight:600; color:#374151; margin-bottom:4px;">Account</label>
        <select class="form-control" @bind="selectedAccount">
            <option value="">All Accounts</option>
            @foreach (var account in accounts)
            {
                <option value="@account">@account</option>
            }
        </select>
    </div>
    <div style="flex: 1 1 200px;">
        <label style="display:block; font-size:12px; font-weight:600; color:#374151; margin-bottom:4px;">Date From</label>
        <input type="date" class="form-control" @bind="dateFrom" />
    </div>
    <div style="flex: 1 1 200px;">
        <label style="display:block; font-size:12px; font-weight:600; color:#374151; margin-bottom:4px;">Date To</label>
        <input type="date" class="form-control" @bind="dateTo" />
    </div>
    <div style="flex: 0 0 auto; display:flex; gap:8px;">
        <button class="btn" style="background:#059669; color:white; padding:10px 18px; border-radius:8px; font-size:14px; font-weight:600;" @onclick="ApplyFilters">Filter</button>
    </div>
</div>

<!-- Ledger Table -->
<div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
    <h2 style="font-size: 18px; font-weight: 600; color: #111827; margin-bottom: 20px;">Ledger Entries</h2>

    <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background: #f9fafb; border-bottom: 1px solid #e5e7eb;">
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">DATE</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">REFERENCE</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">ACCOUNT</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">DESCRIPTION</th>
                    <th style="padding: 12px; text-align: right; font-size: 12px; color: #6b7280;">DEBIT</th>
                    <th style="padding: 12px; text-align: right; font-size: 12px; color: #6b7280;">CREDIT</th>
                    <th style="padding: 12px; text-align: right; font-size: 12px; color: #6b7280;">BALANCE</th>
                </tr>
            </thead>
            <tbody>
                @if (filteredEntries.Any())
                {
                    @foreach (var entry in filteredEntries.OrderBy(e => e.TransactionDate))
                    {
                        <tr style="border-bottom: 1px solid #e5e7eb;">
                            <td style="padding: 12px; font-size: 13px; color: #111827;">@entry.TransactionDate.ToString("yyyy-MM-dd")</td>
                            <td style="padding: 12px; font-size: 13px; color: #4b5563;">@entry.Reference</td>
                            <td style="padding: 12px; font-size: 13px; color: #4b5563;">@entry.AccountName</td>
                            <td style="padding: 12px; font-size: 13px; color: #4b5563;">@entry.Description</td>
                            <td style="padding: 12px; text-align: right; font-size: 13px; color: #111827; font-weight: 600;">@(entry.DebitAmount > 0 ? "₱" + entry.DebitAmount.ToString("N2") : "")</td>
                            <td style="padding: 12px; text-align: right; font-size: 13px; color: #111827; font-weight: 600;">@(entry.CreditAmount > 0 ? "₱" + entry.CreditAmount.ToString("N2") : "")</td>
                            <td style="padding: 12px; text-align: right; font-size: 13px; color: #111827; font-weight: 600;">₱@CalculateBalance(entry).ToString("N2")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" style="padding: 24px; text-align: center; font-size: 14px; color: #6b7280;">No entries found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<GeneralLedgerEntry> allEntries = new();
    private List<string> accounts = new();
    private string selectedAccount = "";
    private DateTime dateFrom = DateTime.Today.AddMonths(-1);
    private DateTime dateTo = DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        await LoadLedger();
    }

    private async Task LoadLedger()
    {
        try
        {
            allEntries = await GeneralLedgerService.GetAllAsync();
            accounts = allEntries.Select(e => e.AccountName).Distinct().ToList();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error loading ledger: {ex.Message}");
            allEntries = new List<GeneralLedgerEntry>();
        }
    }

    private IEnumerable<GeneralLedgerEntry> filteredEntries => allEntries
        .Where(e => string.IsNullOrEmpty(selectedAccount) || e.AccountName == selectedAccount)
        .Where(e => e.TransactionDate >= dateFrom && e.TransactionDate <= dateTo);

    private decimal CalculateBalance(GeneralLedgerEntry entry)
    {
        var previousBalance = allEntries
            .Where(e => e.AccountName == entry.AccountName && e.TransactionDate < entry.TransactionDate)
            .Sum(e => e.DebitAmount - e.CreditAmount);

        return previousBalance + (entry.DebitAmount - entry.CreditAmount);
    }

    private async Task ApplyFilters()
    {
        // Filters are applied via the filteredEntries property
        await Task.CompletedTask;
    }
}
