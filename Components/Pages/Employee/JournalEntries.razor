@page "/employee/journal"
@layout EmployeeLayout
@using FinanceBank.Services
@using FinanceBank.Models
@inject AuthService AuthService
@inject JournalEntryService JournalEntryService

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
            <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="12" y1="13" x2="12" y2="17"/>
                <line x1="9" y1="15" x2="15" y2="15"/>
            </svg>
        </div>
        <div>
            <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Journal Entries</h1>
            <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Create and manage journal entries</p>
        </div>
    </div>
</div>

<!-- Summary Cards -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 24px;">
    <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb;">
        <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 8px;">Total Entries</div>
        <div style="font-size: 32px; font-weight: 700; color: #8b5cf6; margin-bottom: 4px;">@entries.Count</div>
        <div style="font-size: 12px; color: #6b7280;">All time</div>
    </div>
    <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb;">
        <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 8px;">Posted This Month</div>
        <div style="font-size: 32px; font-weight: 700; color: #10b981; margin-bottom: 4px;">@postedThisMonth</div>
        <div style="font-size: 12px; color: #6b7280;">entries posted</div>
    </div>
    <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb;">
        <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 8px;">Pending Review</div>
        <div style="font-size: 32px; font-weight: 700; color: #f59e0b; margin-bottom: 4px;">@pendingCount</div>
        <div style="font-size: 12px; color: #6b7280;">awaiting approval</div>
    </div>
</div>

<!-- Entries Table -->
<div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h2 style="font-size: 18px; font-weight: 600; color: #111827; margin: 0;">Journal Entries</h2>
        <button class="btn" style="background: #8b5cf6; color: white; padding: 8px 16px; border-radius: 8px; font-size: 14px;" @onclick="ShowNewEntryModal">+ New Entry</button>
    </div>

    <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background: #f9fafb; border-bottom: 1px solid #e5e7eb;">
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">DATE</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">REFERENCE</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">ACCOUNT</th>
                    <th style="padding: 12px; text-align: right; font-size: 12px; color: #6b7280;">DEBIT</th>
                    <th style="padding: 12px; text-align: right; font-size: 12px; color: #6b7280;">CREDIT</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">STATUS</th>
                    <th style="padding: 12px; text-align: center; font-size: 12px; color: #6b7280;">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @if (entries.Any())
                {
                    @foreach (var entry in entries.OrderByDescending(e => e.TransactionDate))
                    {
                        <tr style="border-bottom: 1px solid #e5e7eb;">
                            <td style="padding: 12px; font-size: 13px; color: #111827;">@entry.TransactionDate.ToString("yyyy-MM-dd")</td>
                            <td style="padding: 12px; font-size: 13px; color: #4b5563;">@entry.JournalNumber</td>
                            <td style="padding: 12px; font-size: 13px; color: #4b5563;">@entry.Description</td>
                            <td style="padding: 12px; text-align: right; font-size: 13px; color: #111827; font-weight: 600;">@(entry.TotalDebit > 0 ? "₱" + entry.TotalDebit.ToString("N2") : "")</td>
                            <td style="padding: 12px; text-align: right; font-size: 13px; color: #111827; font-weight: 600;">@(entry.TotalCredit > 0 ? "₱" + entry.TotalCredit.ToString("N2") : "")</td>
                            <td style="padding: 12px;">
                                <span style="display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; background: @GetStatusBg(entry.Status); color: @GetStatusColor(entry.Status);">
                                    @entry.Status
                                </span>
                            </td>
                            <td style="padding: 12px; text-align: center;">
                                @if (entry.Status == "Draft")
                                {
                                    <button class="btn" style="background: #f3f4f6; color: #111827; padding: 6px 12px; font-size: 12px; border-radius: 6px;" @onclick="() => EditEntry(entry)">Edit</button>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" style="padding: 24px; text-align: center; font-size: 14px; color: #6b7280;">No entries found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<JournalEntry> entries = new();
    private int postedThisMonth = 0;
    private int pendingCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadEntries();
    }

    private async Task LoadEntries()
    {
        try
        {
            entries = await JournalEntryService.GetAllAsync();
            CalculateStats();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error loading entries: {ex.Message}");
            entries = new List<JournalEntry>();
        }
    }

    private void CalculateStats()
    {
        var today = DateTime.Today;
        var monthStart = new DateTime(today.Year, today.Month, 1);
        var monthEnd = monthStart.AddMonths(1).AddDays(-1);

        postedThisMonth = entries.Count(e => e.TransactionDate >= monthStart && e.TransactionDate <= monthEnd && e.Status == "Posted");
        pendingCount = entries.Count(e => e.Status == "Draft");
    }

    private string GetStatusBg(string status)
    {
        return status switch
        {
            "Posted" => "#d1fae5",
            "Draft" => "#fef3c7",
            "Rejected" => "#fee2e2",
            _ => "#f3f4f6"
        };
    }

    private string GetStatusColor(string status)
    {
        return status switch
        {
            "Posted" => "#065f46",
            "Draft" => "#92400e",
            "Rejected" => "#b91c1c",
            _ => "#4b5563"
        };
    }

    private void ShowNewEntryModal()
    {
        // TODO: Implement new entry modal
    }

    private void EditEntry(JournalEntry entry)
    {
        // TODO: Implement edit entry modal
    }
}
