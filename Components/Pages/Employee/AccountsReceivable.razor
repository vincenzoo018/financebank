@page "/employee/receivables"
@layout EmployeeLayout
@using FinanceBank.Services
@using FinanceBank.Models
@inject AuthService AuthService
@inject AccountsReceivableService AccountsReceivableService

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
            <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
        </div>
        <div>
            <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Accounts Receivable</h1>
            <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Track customer invoices and payments</p>
        </div>
    </div>
</div>

<!-- Summary Cards -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 24px;">
    <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb;">
        <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 8px;">Total Outstanding</div>
        <div style="font-size: 32px; font-weight: 700; color: #dc2626; margin-bottom: 4px;">₱@totalOutstanding.ToString("N2")</div>
        <div style="font-size: 12px; color: #6b7280;">@pendingInvoices invoices pending</div>
    </div>
    <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb;">
        <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 8px;">Due This Month</div>
        <div style="font-size: 32px; font-weight: 700; color: #f59e0b; margin-bottom: 4px;">₱@dueThisMonth.ToString("N2")</div>
        <div style="font-size: 12px; color: #6b7280;">@dueSoonCount invoices due soon</div>
    </div>
    <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb;">
        <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 8px;">Collected This Month</div>
        <div style="font-size: 32px; font-weight: 700; color: #10b981; margin-bottom: 4px;">₱@collectedThisMonth.ToString("N2")</div>
        <div style="font-size: 12px; color: #6b7280;">@collectedCount payments received</div>
    </div>
</div>

<!-- Invoices Table -->
<div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h2 style="font-size: 18px; font-weight: 600; color: #111827; margin: 0;">Outstanding Invoices</h2>
        <button class="btn" style="background: #10b981; color: white; padding: 8px 16px; border-radius: 8px; font-size: 14px;" @onclick="ShowNewInvoiceModal">+ New Invoice</button>
    </div>

    <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background: #f9fafb; border-bottom: 1px solid #e5e7eb;">
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">INVOICE ID</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">CUSTOMER</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">AMOUNT</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">DUE DATE</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">STATUS</th>
                    <th style="padding: 12px; text-align: center; font-size: 12px; color: #6b7280;">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @if (invoices.Any())
                {
                    @foreach (var invoice in invoices)
                    {
                        <tr style="border-bottom: 1px solid #e5e7eb;">
                            <td style="padding: 12px; font-size: 13px; color: #111827;">@invoice.InvoiceNumber</td>
                            <td style="padding: 12px; font-size: 13px; color: #4b5563;">@invoice.CustomerName</td>
                            <td style="padding: 12px; font-size: 13px; color: #111827; font-weight: 600;">₱@invoice.Amount.ToString("N2")</td>
                            <td style="padding: 12px; font-size: 13px; color: #6b7280;">@invoice.DueDate.ToString("yyyy-MM-dd")</td>
                            <td style="padding: 12px;">
                                <span style="display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; background: @GetStatusBg(invoice.Status); color: @GetStatusColor(invoice.Status);">
                                    @invoice.Status
                                </span>
                            </td>
                            <td style="padding: 12px; text-align: center;">
                                <button class="btn" style="background: #f3f4f6; color: #111827; padding: 6px 12px; font-size: 12px; border-radius: 6px;" @onclick="() => RecordPayment(invoice)">Receive</button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="padding: 24px; text-align: center; font-size: 14px; color: #6b7280;">No invoices found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<Models.AccountsReceivable> invoices = new();
    private decimal totalOutstanding = 0;
    private decimal dueThisMonth = 0;
    private decimal collectedThisMonth = 0;
    private int pendingInvoices = 0;
    private int dueSoonCount = 0;
    private int collectedCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadInvoices();
    }

    private async Task LoadInvoices()
    {
        try
        {
            invoices = await AccountsReceivableService.GetAllAsync();
            CalculateStats();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error loading invoices: {ex.Message}");
            invoices = new List<Models.AccountsReceivable>();
        }
    }

    private void CalculateStats()
    {
        var today = DateTime.Today;
        var monthStart = new DateTime(today.Year, today.Month, 1);
        var monthEnd = monthStart.AddMonths(1).AddDays(-1);

        totalOutstanding = invoices.Where(i => i.Status != "Paid").Sum(i => i.Amount);
        pendingInvoices = invoices.Count(i => i.Status != "Paid");
        dueThisMonth = invoices.Where(i => i.DueDate >= monthStart && i.DueDate <= monthEnd && i.Status != "Paid").Sum(i => i.Amount);
        dueSoonCount = invoices.Count(i => i.DueDate >= today && i.DueDate <= today.AddDays(7) && i.Status != "Paid");
        collectedThisMonth = invoices.Where(i => i.Status == "Paid" && i.CreatedAt >= monthStart && i.CreatedAt <= monthEnd).Sum(i => i.ReceivedAmount);
        collectedCount = invoices.Count(i => i.Status == "Paid");
    }

    private string GetStatusBg(string status)
    {
        return status switch
        {
            "Paid" => "#d1fae5",
            "Pending" => "#fef3c7",
            "Overdue" => "#fee2e2",
            _ => "#f3f4f6"
        };
    }

    private string GetStatusColor(string status)
    {
        return status switch
        {
            "Paid" => "#065f46",
            "Pending" => "#92400e",
            "Overdue" => "#b91c1c",
            _ => "#4b5563"
        };
    }

    private void ShowNewInvoiceModal()
    {
        // TODO: Implement new invoice modal
    }

    private void RecordPayment(Models.AccountsReceivable invoice)
    {
        // TODO: Implement payment recording
    }
}
