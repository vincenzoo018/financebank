@page "/employee/payables"
@layout EmployeeLayout
@using FinanceBank.Services
@using FinanceBank.Models
@inject AuthService AuthService
@inject AccountsPayableService AccountsPayableService

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #059669 0%, #047857 100%); border-radius: 16px; padding: 32px; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 12px;">
            <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path d="M12 2v20M2 12h20"/>
            </svg>
        </div>
        <div>
            <h1 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Accounts Payable</h1>
            <p style="font-size: 14px; color: rgba(255,255,255,0.9); margin: 4px 0 0 0;">Manage bills and vendor payments</p>
        </div>
    </div>
</div>

<!-- Summary Cards -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 24px;">
    <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb; border-left: 4px solid #dc2626;">
        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 16px;">
            <div>
                <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 4px;">💰 TOTAL OUTSTANDING</div>
                <div style="font-size: 28px; font-weight: 800; color: #dc2626;">₱@totalOutstanding.ToString("N2")</div>
            </div>
            <div style="width: 44px; height: 44px; background: #fef2f2; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px;">💼</div>
        </div>
        <div style="font-size: 12px; color: #6b7280;">@pendingBills bills pending</div>
    </div>
    <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb; border-left: 4px solid #f59e0b;">
        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 16px;">
            <div>
                <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 4px;">📅 DUE THIS MONTH</div>
                <div style="font-size: 28px; font-weight: 800; color: #f59e0b;">₱@dueThisMonth.ToString("N2")</div>
            </div>
            <div style="width: 44px; height: 44px; background: #fef3c7; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px;">📋</div>
        </div>
        <div style="font-size: 12px; color: #6b7280;">@dueSoonCount bills due soon</div>
    </div>
    <div style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e5e7eb; border-left: 4px solid #059669;">
        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 16px;">
            <div>
                <div style="font-size: 12px; font-weight: 600; color: #6b7280; margin-bottom: 4px;">✓ PAID THIS MONTH</div>
                <div style="font-size: 28px; font-weight: 800; color: #059669;">₱@paidThisMonth.ToString("N2")</div>
            </div>
            <div style="width: 44px; height: 44px; background: #f0fdf4; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px;">✓</div>
        </div>
        <div style="font-size: 12px; color: #6b7280;">@paidCount payments made</div>
    </div>
</div>

<!-- Bills Table -->
<div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h2 style="font-size: 18px; font-weight: 600; color: #111827; margin: 0;">Outstanding Bills</h2>
        <button class="btn" style="background: #059669; color: white; padding: 8px 16px; border-radius: 8px; font-size: 14px;" @onclick="ShowNewBillModal">+ New Bill</button>
    </div>

    <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background: #f9fafb; border-bottom: 1px solid #e5e7eb;">
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">BILL ID</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">VENDOR</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">AMOUNT</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">DUE DATE</th>
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #6b7280;">STATUS</th>
                    <th style="padding: 12px; text-align: center; font-size: 12px; color: #6b7280;">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @if (bills.Any())
                {
                    @foreach (var bill in bills)
                    {
                        <tr style="border-bottom: 1px solid #e5e7eb;">
                            <td style="padding: 12px; font-size: 13px; color: #111827;">@bill.InvoiceNumber</td>
                            <td style="padding: 12px; font-size: 13px; color: #4b5563;">@bill.VendorName</td>
                            <td style="padding: 12px; font-size: 13px; color: #111827; font-weight: 600;">₱@bill.Amount.ToString("N2")</td>
                            <td style="padding: 12px; font-size: 13px; color: #6b7280;">@bill.DueDate.ToString("yyyy-MM-dd")</td>
                            <td style="padding: 12px;">
                                <span style="display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; background: @GetStatusBg(bill.Status); color: @GetStatusColor(bill.Status);">
                                    @bill.Status
                                </span>
                            </td>
                            <td style="padding: 12px; text-align: center;">
                                <button class="btn" style="background: #059669; color: white; padding: 6px 12px; font-size: 12px; border-radius: 6px; margin-right: 4px; font-weight: 600;" @onclick="() => EditBill(bill)">Edit</button>
                                <button class="btn" style="background: #10b981; color: white; padding: 6px 12px; font-size: 12px; border-radius: 6px; margin-right: 4px; font-weight: 600;" @onclick="() => RecordPayment(bill)">Pay</button>
                                <button class="btn" style="background: #dc2626; color: white; padding: 6px 12px; font-size: 12px; border-radius: 6px; font-weight: 600;" @onclick="() => DeleteBill(bill)">Delete</button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="padding: 24px; text-align: center; font-size: 14px; color: #6b7280;">No bills found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- New/Edit Bill Modal -->
@if (showBillModal)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 50;" @onclick="CloseBillModal">
        <div style="background: white; border-radius: 16px; padding: 32px; width: 100%; max-width: 500px; box-shadow: 0 20px 25px rgba(0,0,0,0.1);" @onclick:stopPropagation="true">
            <h2 style="font-size: 20px; font-weight: 700; color: #111827; margin: 0 0 24px 0;">@(isEditingBill ? "Edit Bill" : "New Bill")</h2>
            
            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 6px;">Vendor Name *</label>
                <input type="text" @bind="newBill.VendorName" placeholder="Enter vendor name" style="width: 100%; padding: 8px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px;">
            </div>

            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 6px;">Invoice Number *</label>
                <input type="text" @bind="newBill.InvoiceNumber" placeholder="Enter invoice number" style="width: 100%; padding: 8px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px;">
            </div>

            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 6px;">Amount *</label>
                <input type="number" step="0.01" @bind="newBill.Amount" placeholder="0.00" style="width: 100%; padding: 8px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px;">
            </div>

            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 6px;">Due Date *</label>
                <input type="date" @bind="newBill.DueDate" style="width: 100%; padding: 8px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px;">
            </div>

            <div style="margin-bottom: 24px;">
                <label style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 6px;">Description</label>
                <textarea @bind="newBill.Description" placeholder="Enter bill description" style="width: 100%; padding: 8px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px; min-height: 80px;"></textarea>
            </div>

            <div style="display: flex; gap: 12px;">
                <button class="btn" style="flex: 1; background: #059669; color: white; padding: 10px; border-radius: 8px; font-weight: 600;" @onclick="SaveBill">Save Bill</button>
                <button class="btn" style="flex: 1; background: #e5e7eb; color: #111827; padding: 10px; border-radius: 8px; font-weight: 600;" @onclick="CloseBillModal">Cancel</button>
            </div>
        </div>
    </div>
}

<!-- Payment Modal -->
@if (showPaymentModal)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 50;" @onclick="ClosePaymentModal">
        <div style="background: white; border-radius: 16px; padding: 32px; width: 100%; max-width: 500px; box-shadow: 0 20px 25px rgba(0,0,0,0.1);" @onclick:stopPropagation="true">
            <h2 style="font-size: 20px; font-weight: 700; color: #111827; margin: 0 0 24px 0;">Record Payment</h2>
            
            <div style="background: #f3f4f6; padding: 16px; border-radius: 8px; margin-bottom: 16px;">
                <div style="font-size: 12px; color: #6b7280; margin-bottom: 4px;">Bill: @selectedBill?.InvoiceNumber</div>
                <div style="font-size: 12px; color: #6b7280; margin-bottom: 4px;">Vendor: @selectedBill?.VendorName</div>
                <div style="font-size: 14px; font-weight: 600; color: #111827;">Outstanding: ₱@selectedBill?.OutstandingAmount.ToString("N2")</div>
            </div>

            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 6px;">Payment Amount *</label>
                <input type="number" step="0.01" @bind="paymentAmount" placeholder="0.00" style="width: 100%; padding: 8px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px;">
            </div>

            <div style="margin-bottom: 24px;">
                <label style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 6px;">Payment Date *</label>
                <input type="date" @bind="paymentDate" style="width: 100%; padding: 8px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px;">
            </div>

            <div style="display: flex; gap: 12px;">
                <button class="btn" style="flex: 1; background: #059669; color: white; padding: 10px; border-radius: 8px; font-weight: 600;" @onclick="ConfirmPayment">Confirm Payment</button>
                <button class="btn" style="flex: 1; background: #e5e7eb; color: #111827; padding: 10px; border-radius: 8px; font-weight: 600;" @onclick="ClosePaymentModal">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    private List<Models.AccountsPayable> bills = new();
    private decimal totalOutstanding = 0;
    private decimal dueThisMonth = 0;
    private decimal paidThisMonth = 0;
    private int pendingBills = 0;
    private int dueSoonCount = 0;
    private int paidCount = 0;

    // Modal states
    private bool showBillModal = false;
    private bool showPaymentModal = false;
    private bool isEditingBill = false;
    private Models.AccountsPayable newBill = new();
    private Models.AccountsPayable selectedBill = null;
    private decimal paymentAmount = 0;
    private DateTime paymentDate = DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        await LoadBills();
    }

    private async Task LoadBills()
    {
        try
        {
            bills = await AccountsPayableService.GetAllAsync();
            CalculateStats();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error loading bills: {ex.Message}");
            bills = new List<Models.AccountsPayable>();
        }
    }

    private void CalculateStats()
    {
        var today = DateTime.Today;
        var monthStart = new DateTime(today.Year, today.Month, 1);
        var monthEnd = monthStart.AddMonths(1).AddDays(-1);

        totalOutstanding = bills.Where(b => b.Status != "Paid").Sum(b => b.OutstandingAmount);
        pendingBills = bills.Count(b => b.Status != "Paid");
        dueThisMonth = bills.Where(b => b.DueDate >= monthStart && b.DueDate <= monthEnd && b.Status != "Paid").Sum(b => b.Amount);
        dueSoonCount = bills.Count(b => b.DueDate >= today && b.DueDate <= today.AddDays(7) && b.Status != "Paid");
        paidThisMonth = bills.Where(b => b.Status == "Paid" && b.CreatedAt >= monthStart && b.CreatedAt <= monthEnd).Sum(b => b.PaidAmount);
        paidCount = bills.Count(b => b.Status == "Paid");
    }

    private string GetStatusBg(string status)
    {
        return status switch
        {
            "Paid" => "#d1fae5",
            "Pending" => "#fef3c7",
            "Overdue" => "#fee2e2",
            _ => "#f3f4f6"
        };
    }

    private string GetStatusColor(string status)
    {
        return status switch
        {
            "Paid" => "#065f46",
            "Pending" => "#92400e",
            "Overdue" => "#b91c1c",
            _ => "#4b5563"
        };
    }

    private void ShowNewBillModal()
    {
        newBill = new Models.AccountsPayable 
        { 
            DueDate = DateTime.Today.AddDays(30),
            CreatedAt = DateTime.Now
        };
        isEditingBill = false;
        showBillModal = true;
    }

    private void EditBill(Models.AccountsPayable bill)
    {
        newBill = new Models.AccountsPayable
        {
            PayableId = bill.PayableId,
            VendorName = bill.VendorName,
            InvoiceNumber = bill.InvoiceNumber,
            Amount = bill.Amount,
            DueDate = bill.DueDate,
            Description = bill.Description,
            Status = bill.Status
        };
        isEditingBill = true;
        showBillModal = true;
    }

    private async Task SaveBill()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(newBill.VendorName) || string.IsNullOrWhiteSpace(newBill.InvoiceNumber) || newBill.Amount <= 0)
            {
                System.Diagnostics.Debug.WriteLine("Please fill all required fields");
                return;
            }

            if (isEditingBill && newBill.PayableId > 0)
            {
                newBill.Status = bills.First(b => b.PayableId == newBill.PayableId).Status;
                await AccountsPayableService.UpdateAsync(newBill);
            }
            else
            {
                newBill.Status = "Pending";
                newBill.OutstandingAmount = newBill.Amount;
                newBill.PaidAmount = 0;
                await AccountsPayableService.CreateAsync(newBill);
            }

            await LoadBills();
            CloseBillModal();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error saving bill: {ex.Message}");
        }
    }

    private void CloseBillModal()
    {
        showBillModal = false;
        newBill = new();
        isEditingBill = false;
    }

    private void RecordPayment(Models.AccountsPayable bill)
    {
        selectedBill = bill;
        paymentAmount = bill.OutstandingAmount;
        paymentDate = DateTime.Today;
        showPaymentModal = true;
    }

    private async Task ConfirmPayment()
    {
        try
        {
            if (paymentAmount <= 0 || paymentAmount > selectedBill.OutstandingAmount)
            {
                System.Diagnostics.Debug.WriteLine("Invalid payment amount");
                return;
            }

            selectedBill.PaidAmount += paymentAmount;
            selectedBill.OutstandingAmount -= paymentAmount;

            if (selectedBill.OutstandingAmount <= 0)
            {
                selectedBill.Status = "Paid";
                selectedBill.OutstandingAmount = 0;
            }

            await AccountsPayableService.UpdateAsync(selectedBill);
            await LoadBills();
            ClosePaymentModal();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error recording payment: {ex.Message}");
        }
    }

    private void ClosePaymentModal()
    {
        showPaymentModal = false;
        selectedBill = null;
        paymentAmount = 0;
    }

    private void DeleteBill(Models.AccountsPayable bill)
    {
        try
        {
            if (bill.Status == "Paid")
            {
                System.Diagnostics.Debug.WriteLine("Cannot delete paid bills");
                return;
            }

            // Remove from list and reload
            bills.Remove(bill);
            CalculateStats();
            System.Diagnostics.Debug.WriteLine($"Bill {bill.InvoiceNumber} marked for deletion");
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error deleting bill: {ex.Message}");
        }
    }
}
