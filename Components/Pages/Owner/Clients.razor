@code {
    private List<SaaSClient> clients = new();
    private SaaSClient editClient = new();
    private bool showModal = false;
    private bool isEditing = false;
    private string searchTerm = "";
    private string statusFilter = "";
    private int selectedPlanId = 2;

    // Module Selection
    private List<ModuleItem> availableModules = new();
    private HashSet<int> selectedModuleIds = new();
    private int setupStep = 1;
    private string billingCycle = "Monthly";
    private decimal setupFee = 5000;
    private int contractDuration = 12;
    private DateTime contractStartDate = DateTime.Now;
    private int discountPercent = 0;
    private bool contractAgreed = false;

    private IEnumerable<SaaSClient> FilteredClients => clients
    .Where(c => string.IsNullOrEmpty(searchTerm) ||
    c.CompanyName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
    c.PrimaryEmail.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
    .Where(c => string.IsNullOrEmpty(statusFilter) || c.Status == statusFilter);

    protected override async Task OnInitializedAsync()
    {
        await LoadClientsFromDatabase();
        await LoadModulesFromDatabase();
    }

    private async Task LoadClientsFromDatabase()
    {
        try
        {
            clients = await ClientService.GetAllClientsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading clients: {ex.Message}");
            clients = new List<SaaSClient>();
        }
    }

    private async Task LoadModulesFromDatabase()
    {
        try
        {
            var dbModules = await ModuleService.GetAllModulesAsync();
            if (dbModules != null && dbModules.Any())
            {
                availableModules = dbModules.Select(m => new ModuleItem
                {
                    ModuleId = m.ModuleId,
                    ModuleName = m.ModuleName,
                    Description = m.Description ?? string.Empty,
                    MonthlyPrice = m.MonthlyPrice,
                    IsCore = m.IsCore
                }).ToList();
            }
            else
            {
                // Fallback to default modules and save them to database
                LoadDefaultModules();
                await SaveDefaultModulesToDatabase();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading modules: {ex.Message}");
            LoadDefaultModules();
        }

        // Auto-select core modules
        foreach (var module in availableModules.Where(m => m.IsCore))
        {
            selectedModuleIds.Add(module.ModuleId);
        }
    }

    private void LoadDefaultModules()
    {
        availableModules = new List<ModuleItem>
{
new ModuleItem { ModuleId = 1, ModuleName = "Core System", Description = "Essential system foundation", MonthlyPrice =
0, IsCore = true },
new ModuleItem { ModuleId = 2, ModuleName = "Teller Operations", Description = "Cash transactions, deposits, withdrawals", MonthlyPrice = 500 },
new ModuleItem { ModuleId = 3, ModuleName = "Loan Management", Description = "Loan applications, approvals, payments",
MonthlyPrice = 1000 },
new ModuleItem { ModuleId = 4, ModuleName = "Savings Accounts", Description = "Savings account management", MonthlyPrice
= 500 },
new ModuleItem { ModuleId = 5, ModuleName = "General Ledger", Description = "Chart of accounts, journal entries",
MonthlyPrice = 800 },
new ModuleItem { ModuleId = 6, ModuleName = "Financial Reports", Description = "Balance sheets, income statements",
MonthlyPrice = 500 },
new ModuleItem { ModuleId = 7, ModuleName = "User Administration", Description = "User management, roles, permissions",
MonthlyPrice = 300 },
new ModuleItem { ModuleId = 8, ModuleName = "Audit Trail", Description = "System audit logs and security", MonthlyPrice
= 400 }
};
    }

    private async Task SaveDefaultModulesToDatabase()
    {
        try
        {
            foreach (var module in availableModules)
            {
                var systemModule = new SystemModule
                {
                    ModuleCode = module.ModuleName.Replace(" ", "").ToUpper(),
                    ModuleName = module.ModuleName,
                    Description = module.Description,
                    MonthlyPrice = module.MonthlyPrice,
                    BasePrice = module.MonthlyPrice,
                    YearlyPrice = module.MonthlyPrice * 10,
                    IsCore = module.IsCore,
                    IsActive = true,
                    SortOrder = module.ModuleId
                };
                await ModuleService.CreateModuleAsync(systemModule);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving default modules: {ex.Message}");
        }
    }

    private void ShowAddClient()
    {
        editClient = new SaaSClient { Status = "Trial", BillingCycle = "Monthly" };
        isEditing = false;
        setupStep = 1;
        selectedModuleIds.Clear();
        foreach (var module in availableModules.Where(m => m.IsCore))
        {
            selectedModuleIds.Add(module.ModuleId);
        }
        billingCycle = "Monthly";
        setupFee = 5000;
        contractDuration = 12;
        contractStartDate = DateTime.Now;
        discountPercent = 0;
        contractAgreed = false;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        setupStep = 1;
    }

    private void ViewClient(int clientId)
    {
        Navigation.NavigateTo($"/owner/client/{clientId}");
    }

    private void EditClient(SaaSClient client)
    {
        editClient = new SaaSClient
        {
            ClientId = client.ClientId,
            CompanyName = client.CompanyName,
            TradeName = client.TradeName,
            BusinessType = client.BusinessType,
            PrimaryEmail = client.PrimaryEmail,
            Phone = client.Phone,
            Mobile = client.Mobile,
            Address = client.Address,
            City = client.City,
            Province = client.Province,
            ContactPersonName = client.ContactPersonName,
            ContactPersonTitle = client.ContactPersonTitle,
            Notes = client.Notes,
            Status = client.Status,
            BillingCycle = client.BillingCycle
        };
        isEditing = true;
        showModal = true;
    }

    private void ToggleModule(ModuleItem module)
    {
        if (module.IsCore) return;

        if (selectedModuleIds.Contains(module.ModuleId))
            selectedModuleIds.Remove(module.ModuleId);
        else
            selectedModuleIds.Add(module.ModuleId);
    }

    private void SelectBasicPlan()
    {
        selectedModuleIds.Clear();
        var basicModules = new[] { 1, 2, 4, 6 }; // Core, Teller, Savings, Reports
        foreach (var id in basicModules)
            selectedModuleIds.Add(id);
    }

    private void SelectProPlan()
    {
        selectedModuleIds.Clear();
        var proModules = new[] { 1, 2, 3, 4, 5, 6, 7 }; // All except Audit
        foreach (var id in proModules)
            selectedModuleIds.Add(id);
    }

    private void SelectEnterprisePlan()
    {
        selectedModuleIds.Clear();
        foreach (var module in availableModules)
            selectedModuleIds.Add(module.ModuleId);
    }

    private void ClearModules()
    {
        selectedModuleIds.Clear();
        foreach (var module in availableModules.Where(m => m.IsCore))
            selectedModuleIds.Add(module.ModuleId);
    }

    private decimal CalculateMonthlySubscription()
    {
        return availableModules
        .Where(m => selectedModuleIds.Contains(m.ModuleId))
        .Sum(m => m.MonthlyPrice);
    }

    private decimal GetFirstSubscriptionAmount()
    {
        var monthly = CalculateMonthlySubscription();
        return billingCycle == "Yearly" ? monthly * 10 : monthly;
    }

    private decimal GetDiscountAmount()
    {
        return (setupFee + GetFirstSubscriptionAmount()) * (discountPercent / 100m);
    }

    private decimal GetTotalFirstPayment()
    {
        return setupFee + GetFirstSubscriptionAmount() - GetDiscountAmount();
    }

    private bool CanProceed()
    {
        return setupStep switch
        {
            1 => !string.IsNullOrWhiteSpace(editClient.CompanyName) && !string.IsNullOrWhiteSpace(editClient.PrimaryEmail),
            2 => selectedModuleIds.Count > 0,
            3 => true,
            4 => contractAgreed,
            _ => true
        };
    }

    private void NextStep()
    {
        if (CanProceed() && setupStep < 4)
            setupStep++;
    }

    private void PreviousStep()
    {
        if (setupStep > 1)
            setupStep--;
    }

    private async Task SaveClient()
    {
        try
        {
            if (isEditing)
            {
                // Update existing client
                await ClientService.UpdateClientAsync(editClient);
            }
            else
            {
                // Create new client with subscription and invoice
                editClient.Status = "Active";
                editClient.BillingCycle = billingCycle;
                editClient.SubscriptionStartDate = contractStartDate;
                editClient.SubscriptionEndDate = contractStartDate.AddMonths(contractDuration);
                editClient.OutstandingBalance = GetTotalFirstPayment() * 1.12m; // With VAT

                // Save client to database
                var savedClient = await ClientService.CreateClientAsync(editClient);

                // Create subscription for selected modules
                var subscription = new ClientSubscription
                {
                    ClientId = savedClient.ClientId,
                    StartDate = contractStartDate,
                    EndDate = contractStartDate.AddMonths(contractDuration),
                    BillingCycle = billingCycle,
                    BasePrice = setupFee,
                    AdditionalModulesPrice = CalculateMonthlySubscription(),
                    Discount = GetDiscountAmount(),
                    DiscountType = discountPercent > 0 ? "Percentage" : null,
                    TotalPrice = GetTotalFirstPayment(),
                    Status = "Active",
                    AutoRenew = true
                };
                await ClientService.CreateSubscriptionAsync(savedClient.ClientId, subscription);

                // Create client modules
                foreach (var moduleId in selectedModuleIds)
                {
                    var module = availableModules.FirstOrDefault(m => m.ModuleId == moduleId);
                    if (module != null)
                    {
                        await ClientService.AddModuleToClientAsync(savedClient.ClientId, moduleId, module.MonthlyPrice);
                    }
                }

                // Create initial invoice
                var invoice = await InvoiceService.CreateInvoiceAsync(savedClient.ClientId, "Subscription", GetTotalFirstPayment() *
                1.12m, contractStartDate.AddDays(15));

                // Update client's outstanding balance
                savedClient.OutstandingBalance = GetTotalFirstPayment() * 1.12m;
                await ClientService.UpdateClientAsync(savedClient);
            }

            // Reload clients list
            clients = await ClientService.GetAllClientsAsync();
            CloseModal();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving client: {ex.Message}");
        }
    }

