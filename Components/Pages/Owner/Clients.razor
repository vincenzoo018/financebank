    private async Task SuspendClient(SaaSClient client)
    {
        client.Status = "Suspended";
        await ClientService.UpdateClientAsync(client);
        clients = await ClientService.GetAllClientsAsync();
    }

    private async Task ActivateClient(SaaSClient client)
    {
        client.Status = "Active";
        await ClientService.UpdateClientAsync(client);
        clients = await ClientService.GetAllClientsAsync();
    }

    private string GetPlanName(string clientCode)
    {
        return clientCode switch
        {
            "FINEBANK001" => "Professional",
            "DEMO001" => "Basic",
            "METRO001" => "Professional",
            "RURAL001" => "Trial",
            "ISLAND001" => "Basic",
            _ => "Basic"
        };
    }

    private string GetPlanClass(string clientCode)
    {
        return clientCode switch
        {
            "FINEBANK001" => "pro",
            "METRO001" => "pro",
            _ => "basic"
        };
    }

    private string GetNextBilling(SaaSClient client)
    {
        if (client.Status == "Trial") return "Trial ends in 14 days";
        if (client.Status == "Suspended") return "—";
        return DateTime.Now.AddDays(15).ToString("MMM dd, yyyy");
    }

