@code {
    private List<SaaSTransaction> transactions = new();
    private List<SaaSTransaction> pendingTransactions = new();
    private List<SaaSClient> clients = new();
    private List<PaymentMethod> paymentMethods = new();
    private SaaSTransaction newTransaction = new();
    private SaaSTransaction? viewTransaction;
    private bool showRecordPayment = false;
    private bool autoApprove = false;
    private string searchTerm = "";
    private string typeFilter = "";
    private string statusFilter = "";
    private string? uploadedProofBase64;
    private DateTime paymentDate = DateTime.Now;
    private InputFile? proofInputFile;

    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;

    private int pendingCount => transactions.Count(t => t.Status == "Pending");
    private decimal pendingAmount => transactions.Where(t => t.Status == "Pending").Sum(t => t.Amount);
    private int approvedCount => transactions.Count(t => t.Status == "Approved" && t.TransactionDate.Month == DateTime.Now.Month);
    private decimal approvedAmount => transactions.Where(t => t.Status == "Approved" && t.TransactionType != "Refund" && t.TransactionDate.Month == DateTime.Now.Month).Sum(t => t.Amount);
    private int refundCount => transactions.Count(t => t.TransactionType == "Refund" && t.TransactionDate.Month == DateTime.Now.Month);
    private decimal refundAmount => transactions.Where(t => t.TransactionType == "Refund" && t.TransactionDate.Month == DateTime.Now.Month).Sum(t => t.Amount);

    private IEnumerable<SaaSTransaction> FilteredTransactions => transactions
        .Where(t => string.IsNullOrEmpty(searchTerm) ||
            (t.TransactionRef?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (t.Client?.CompanyName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false))
        .Where(t => string.IsNullOrEmpty(typeFilter) || t.TransactionType == typeFilter)
        .Where(t => string.IsNullOrEmpty(statusFilter) || t.Status == statusFilter)
        .OrderByDescending(t => t.TransactionDate);

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        transactions = await PaymentService.GetAllTransactionsAsync();
        pendingTransactions = await PaymentService.GetPendingApprovalsAsync();
        clients = await ClientService.GetAllClientsAsync();
        paymentMethods = await PaymentService.GetPaymentMethodsAsync();
    }

    private void ShowRecordPayment()
    {
        newTransaction = new SaaSTransaction
        {
            TransactionDate = DateTime.Now,
            TransactionType = "Subscription",
            Status = "Pending"
        };
        autoApprove = false;
        uploadedProofBase64 = null;
        paymentDate = DateTime.Now;
        showRecordPayment = true;
    }

    private void HideRecordPayment()
    {
        showRecordPayment = false;
        uploadedProofBase64 = null;
    }

    private async Task HandleProofUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            try
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024); // 5MB max
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var bytes = ms.ToArray();
                var base64 = Convert.ToBase64String(bytes);
                uploadedProofBase64 = $"data:{file.ContentType};base64,{base64}";
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error uploading file: {ex.Message}");
            }
        }
    }

    private async Task TriggerFileInput()
    {
        // Use JS to click the hidden file input
        await JSRuntime.InvokeVoidAsync("eval", "document.querySelector('input[type=file]').click()");
    }

    private void RemoveProof()
    {
        uploadedProofBase64 = null;
    }

    private async Task RecordPayment()
    {
        try
        {
            newTransaction.TransactionDate = paymentDate;
            newTransaction.ProofImageBase64 = uploadedProofBase64;
            
            await PaymentService.RecordPaymentAsync(
                newTransaction.ClientId,
                newTransaction.InvoiceId,
                newTransaction.Amount,
                newTransaction.PaymentMethodId ?? 0,
                newTransaction.ReferenceNumber ?? "",
                uploadedProofBase64,
                newTransaction.Description,
                newTransaction.Notes
            );
            
            if (autoApprove)
            {
                var allTxns = await PaymentService.GetAllTransactionsAsync();
                var latestTxn = allTxns.OrderByDescending(t => t.TransactionId).FirstOrDefault();
                if (latestTxn != null)
                {
                    await PaymentService.ApprovePaymentAsync(latestTxn.TransactionId, 1);
                }
            }
            
            await LoadData();
            HideRecordPayment();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error recording payment: {ex.Message}");
        }
    }

    private async Task ViewTransactionDetails(SaaSTransaction txn)
    {
        viewTransaction = await PaymentService.GetTransactionByIdAsync(txn.TransactionId);
    }

    private void CloseTransactionView()
    {
        viewTransaction = null;
    }

    private async Task ApproveTransaction(int transactionId)
    {
        await PaymentService.ApprovePaymentAsync(transactionId, 1);
        await LoadData();
        CloseTransactionView();
    }

    private async Task RejectTransaction(int transactionId)
    {
        await PaymentService.RejectPaymentAsync(transactionId, 1, "Rejected by owner");
        await LoadData();
        CloseTransactionView();
    }
}
