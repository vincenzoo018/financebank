@page "/owner/modules"
@layout OwnerLayout

<div class="modules-page">
    <!-- Header -->
    <div class="page-header">
        <div class="header-left">
            <h2>System Modules</h2>
            <span class="subtitle">Manage available modules and pricing</span>
        </div>
        <div class="header-right">
            <button class="btn btn-primary" @onclick="ShowAddModule">
                <span class="icon">➕</span> Add New Module
            </button>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-icon">📦</div>
            <div class="stat-info">
                <span class="stat-value">@modules.Count</span>
                <span class="stat-label">Total Modules</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">✅</div>
            <div class="stat-info">
                <span class="stat-value">@modules.Count(m => m.IsActive)</span>
                <span class="stat-label">Active</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">🔌</div>
            <div class="stat-info">
                <span class="stat-value">@modules.Count(m => m.IsAddon)</span>
                <span class="stat-label">Add-ons</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">💰</div>
            <div class="stat-info">
                <span class="stat-value">₱@modules.Where(m => m.IsAddon).Sum(m => m.MonthlyPrice).ToString("N0")</span>
                <span class="stat-label">Add-on Revenue</span>
            </div>
        </div>
    </div>

    <!-- Modules Grid -->
    <div class="modules-grid">
        @foreach (var module in modules)
        {
            <div class="module-card @(module.IsActive ? "" : "inactive")">
                <div class="module-icon" style="background: @module.IconColor;">@module.Icon</div>
                <div class="module-info">
                    <h3>@module.ModuleName</h3>
                    <p>@module.Description</p>
                </div>
                <div class="module-meta">
                    <span class="module-code">@module.ModuleCode</span>
                    @if (module.IsAddon)
                    {
                        <span class="badge addon">Add-on</span>
                    }
                    else
                    {
                        <span class="badge core">Core</span>
                    }
                    @if (module.IsActive)
                    {
                        <span class="badge active">Active</span>
                    }
                    else
                    {
                        <span class="badge inactive-badge">Inactive</span>
                    }
                </div>
                @if (module.IsAddon)
                {
                    <div class="module-pricing">
                        <span class="price">₱@module.MonthlyPrice.ToString("N0")</span>
                        <span class="period">/month</span>
                    </div>
                }
                <div class="module-usage">
                    <div class="usage-bar-bg">
                        <div class="usage-bar" style="width: @(module.ClientsUsing * 10)%;"></div>
                    </div>
                    <span class="usage-text">@module.ClientsUsing clients using</span>
                </div>
                <div class="module-actions">
                    <button class="btn btn-sm btn-secondary" @onclick="() => EditModule(module)">✏️ Edit</button>
                    <button class="btn btn-sm @(module.IsActive ? "btn-danger" : "btn-success")" 
                            @onclick="() => ToggleActive(module)">
                        @(module.IsActive ? "🔴 Disable" : "🟢 Enable")
                    </button>
                </div>
            </div>
        }
    </div>

    <!-- Plans Assignment -->
    <div class="plans-section">
        <h3>Module Assignment by Plan</h3>
        <div class="assignment-grid">
            <div class="assignment-header">
                <div class="col-module">Module</div>
                <div class="col-plan">Basic</div>
                <div class="col-plan">Professional</div>
                <div class="col-plan">Enterprise</div>
            </div>
            @foreach (var module in modules)
            {
                <div class="assignment-row">
                    <div class="col-module">
                        <span class="mini-icon" style="background: @module.IconColor;">@module.Icon</span>
                        @module.ModuleName
                    </div>
                    <div class="col-plan">
                        <input type="checkbox" checked="@module.IncludedInBasic" 
                               @onchange='() => TogglePlan(module, "Basic")' />
                    </div>
                    <div class="col-plan">
                        <input type="checkbox" checked="@module.IncludedInPro" 
                               @onchange='() => TogglePlan(module, "Pro")' />
                    </div>
                    <div class="col-plan">
                        <input type="checkbox" checked="@module.IncludedInEnterprise" 
                               @onchange='() => TogglePlan(module, "Enterprise")' />
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Edit Module Modal -->
    @if (showModal)
    {
        <div class="modal-overlay" @onclick="CloseModal">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h3>@(isEditing ? "Edit Module" : "Add New Module")</h3>
                    <button class="close-btn" @onclick="CloseModal">✕</button>
                </div>
                <div class="modal-body">
                    <div class="form-row">
                        <div class="form-group">
                            <label>Module Name *</label>
                            <input type="text" @bind="editModule.ModuleName" placeholder="e.g., Loan Management" />
                        </div>
                        <div class="form-group">
                            <label>Module Code *</label>
                            <input type="text" @bind="editModule.ModuleCode" placeholder="e.g., LOANS" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Description</label>
                        <textarea @bind="editModule.Description" rows="2"></textarea>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Icon (emoji)</label>
                            <input type="text" @bind="editModule.Icon" placeholder="💰" />
                        </div>
                        <div class="form-group">
                            <label>Icon Background</label>
                            <input type="color" @bind="editModule.IconColor" />
                        </div>
                    </div>
                    <div class="form-group checkbox-group">
                        <label>
                            <input type="checkbox" @bind="editModule.IsAddon" />
                            This is an Add-on Module (requires separate pricing)
                        </label>
                    </div>
                    @if (editModule.IsAddon)
                    {
                        <div class="form-row">
                            <div class="form-group">
                                <label>Monthly Price (₱)</label>
                                <input type="number" @bind="editModule.MonthlyPrice" step="0.01" />
                            </div>
                            <div class="form-group">
                                <label>Setup Fee (₱)</label>
                                <input type="number" @bind="editModule.SetupFee" step="0.01" />
                            </div>
                        </div>
                    }
                    <div class="form-group checkbox-group">
                        <label>
                            <input type="checkbox" @bind="editModule.IsActive" />
                            Active
                        </label>
                    </div>
                    <div class="plan-checkboxes">
                        <label>Include in Plans:</label>
                        <div class="checkbox-row">
                            <label><input type="checkbox" @bind="editModule.IncludedInBasic" /> Basic</label>
                            <label><input type="checkbox" @bind="editModule.IncludedInPro" /> Professional</label>
                            <label><input type="checkbox" @bind="editModule.IncludedInEnterprise" /> Enterprise</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveModule">@(isEditing ? "Update Module" : "Create Module")</button>
                </div>
            </div>
        </div>
    }
</div>

<style>
