    }

    .assignment-row {
        display: grid;
        grid-template-columns: 2fr repeat(3, 1fr);
        border-bottom: 1px solid #f3f4f6;
    }

    .assignment-row:last-child { border-bottom: none; }

    .assignment-row > div {
        padding: 12px 16px;
        display: flex;
        align-items: center;
    }

    .col-module {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 14px;
