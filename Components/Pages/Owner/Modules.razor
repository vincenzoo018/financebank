        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .modal-content {
        background: white;
        border-radius: 16px;
        width: 90%;
        max-width: 600px;
        max-height: 90vh;
        overflow: auto;
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 24px;
        border-bottom: 1px solid #e5e7eb;
    }

    .modal-header h3 { margin: 0; font-size: 18px; }
    .close-btn { background: none; border: none; font-size: 20px; cursor: pointer; color: #6b7280; }
    .modal-body { padding: 24px; }
    .modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding: 16px 24px;
        border-top: 1px solid #e5e7eb;
    }

    .form-row { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; font-size: 13px; font-weight: 500; color: #374151; margin-bottom: 6px; }
    .form-group input, .form-group select, .form-group textarea {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        font-size: 14px;
    }

    .checkbox-group label { display: flex; align-items: center; gap: 8px; cursor: pointer; }
    .checkbox-group input[type="checkbox"] { width: auto; }

    .plan-checkboxes { margin-top: 16px; }
    .checkbox-row { display: flex; gap: 24px; margin-top: 8px; }
    .checkbox-row label { display: flex; align-items: center; gap: 6px; font-size: 14px; cursor: pointer; }
</style>

@code {
    private List<ModuleData> modules = new();
    private ModuleData editModule = new();
    private bool showModal = false;
    private bool isEditing = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadSampleData();
    }

    private async Task LoadSampleData()
    {
        await Task.Delay(100);
        modules = new List<ModuleData>
        {
            new ModuleData { 
                ModuleId = 1, ModuleCode = "CORE", ModuleName = "Core System",
                Description = "Essential system functions, user management, settings",
                Icon = "⚙️", IconColor = "#6366f1",
                IsActive = true, IsAddon = false,
                IncludedInBasic = true, IncludedInPro = true, IncludedInEnterprise = true,
                ClientsUsing = 10
            },
            new ModuleData { 
                ModuleId = 2, ModuleCode = "TELLER", ModuleName = "Teller Operations",
                Description = "Cash-in, cash-out, deposits, withdrawals",
                Icon = "💳", IconColor = "#10b981",
                IsActive = true, IsAddon = false,
                IncludedInBasic = true, IncludedInPro = true, IncludedInEnterprise = true,
                ClientsUsing = 10
            },
            new ModuleData { 
                ModuleId = 3, ModuleCode = "SAVINGS", ModuleName = "Savings Accounts",
                Description = "Savings account management, interest computation",
                Icon = "🏦", IconColor = "#3b82f6",
                IsActive = true, IsAddon = false,
                IncludedInBasic = true, IncludedInPro = true, IncludedInEnterprise = true,
                ClientsUsing = 10
            },
            new ModuleData { 
                ModuleId = 4, ModuleCode = "LOANS", ModuleName = "Loan Management",
                Description = "Loan applications, approvals, disbursements, collections",
                Icon = "💰", IconColor = "#f59e0b",
                IsActive = true, IsAddon = false,
                IncludedInBasic = false, IncludedInPro = true, IncludedInEnterprise = true,
                ClientsUsing = 7
            },
            new ModuleData { 
                ModuleId = 5, ModuleCode = "GL", ModuleName = "General Ledger",
                Description = "Chart of accounts, journal entries, trial balance",
                Icon = "📊", IconColor = "#8b5cf6",
                IsActive = true, IsAddon = false,
                IncludedInBasic = false, IncludedInPro = true, IncludedInEnterprise = true,
                ClientsUsing = 7
            },
            new ModuleData { 
                ModuleId = 6, ModuleCode = "REPORTS", ModuleName = "Advanced Reports",
                Description = "Custom reports, analytics, data exports",
                Icon = "📈", IconColor = "#ec4899",
                IsActive = true, IsAddon = false,
                IncludedInBasic = false, IncludedInPro = true, IncludedInEnterprise = true,
                ClientsUsing = 7
            },
            new ModuleData { 
                ModuleId = 7, ModuleCode = "AUDIT", ModuleName = "Audit Trail",
                Description = "Complete activity logging and audit reports",
                Icon = "🔍", IconColor = "#14b8a6",
                IsActive = true, IsAddon = false,
                IncludedInBasic = false, IncludedInPro = true, IncludedInEnterprise = true,
                ClientsUsing = 7
            },
            new ModuleData { 
                ModuleId = 8, ModuleCode = "API", ModuleName = "API Access",
                Description = "REST API for third-party integrations",
                Icon = "🔌", IconColor = "#6366f1",
                IsActive = true, IsAddon = true, MonthlyPrice = 999, SetupFee = 2500,
                IncludedInBasic = false, IncludedInPro = false, IncludedInEnterprise = true,
                ClientsUsing = 2
            },
            new ModuleData { 
                ModuleId = 9, ModuleCode = "SMS", ModuleName = "SMS Notifications",
                Description = "SMS alerts for transactions, payments, reminders",
                Icon = "📱", IconColor = "#22c55e",
                IsActive = true, IsAddon = true, MonthlyPrice = 499, SetupFee = 0,
                IncludedInBasic = false, IncludedInPro = false, IncludedInEnterprise = false,
                ClientsUsing = 4
            },
            new ModuleData { 
                ModuleId = 10, ModuleCode = "MOBILE", ModuleName = "Mobile App",
                Description = "Member mobile app for account access",
                Icon = "📲", IconColor = "#0ea5e9",
                IsActive = true, IsAddon = true, MonthlyPrice = 1499, SetupFee = 5000,
                IncludedInBasic = false, IncludedInPro = false, IncludedInEnterprise = false,
                ClientsUsing = 1
            }
        };
    }

    private void ShowAddModule()
    {
        editModule = new ModuleData { IsActive = true, Icon = "📦", IconColor = "#6366f1" };
        isEditing = false;
        showModal = true;
    }

    private void EditModule(ModuleData module)
    {
        editModule = new ModuleData
        {
            ModuleId = module.ModuleId,
            ModuleCode = module.ModuleCode,
            ModuleName = module.ModuleName,
            Description = module.Description,
            Icon = module.Icon,
            IconColor = module.IconColor,
            IsActive = module.IsActive,
            IsAddon = module.IsAddon,
            MonthlyPrice = module.MonthlyPrice,
            SetupFee = module.SetupFee,
            IncludedInBasic = module.IncludedInBasic,
            IncludedInPro = module.IncludedInPro,
            IncludedInEnterprise = module.IncludedInEnterprise
        };
        isEditing = true;
        showModal = true;
    }

    private void CloseModal() { showModal = false; }

    private void SaveModule()
    {
        if (isEditing)
        {
            var existing = modules.FirstOrDefault(m => m.ModuleId == editModule.ModuleId);
            if (existing != null)
            {
                existing.ModuleName = editModule.ModuleName;
                existing.ModuleCode = editModule.ModuleCode;
                existing.Description = editModule.Description;
                existing.Icon = editModule.Icon;
                existing.IconColor = editModule.IconColor;
                existing.IsActive = editModule.IsActive;
                existing.IsAddon = editModule.IsAddon;
                existing.MonthlyPrice = editModule.MonthlyPrice;
                existing.SetupFee = editModule.SetupFee;
                existing.IncludedInBasic = editModule.IncludedInBasic;
                existing.IncludedInPro = editModule.IncludedInPro;
                existing.IncludedInEnterprise = editModule.IncludedInEnterprise;
            }
        }
        else
        {
            editModule.ModuleId = modules.Max(m => m.ModuleId) + 1;
            modules.Add(editModule);
        }
        CloseModal();
    }

    private void ToggleActive(ModuleData module)
    {
        module.IsActive = !module.IsActive;
    }

    private void TogglePlan(ModuleData module, string plan)
    {
        switch (plan)
        {
            case "Basic": module.IncludedInBasic = !module.IncludedInBasic; break;
            case "Pro": module.IncludedInPro = !module.IncludedInPro; break;
            case "Enterprise": module.IncludedInEnterprise = !module.IncludedInEnterprise; break;
        }
    }

    private class ModuleData
    {
        public int ModuleId { get; set; }
        public string ModuleCode { get; set; } = "";
        public string ModuleName { get; set; } = "";
        public string Description { get; set; } = "";
        public string Icon { get; set; } = "";
        public string IconColor { get; set; } = "";
        public bool IsActive { get; set; }
        public bool IsAddon { get; set; }
        public decimal MonthlyPrice { get; set; }
        public decimal SetupFee { get; set; }
        public bool IncludedInBasic { get; set; }
        public bool IncludedInPro { get; set; }
        public bool IncludedInEnterprise { get; set; }
        public int ClientsUsing { get; set; }
    }
}
