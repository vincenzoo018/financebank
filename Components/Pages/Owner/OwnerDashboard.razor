@code {
    private ClientStatistics clientStats = new();
    private RevenueStats revenueStats = new();
    private List<SaaSTransaction> recentTransactions = new();
    private List<SaaSClient> recentClients = new();
    private List<SaaSInvoice> overdueInvoices = new();
    private List<SupportTicket> openTicketsList = new();
    private int openTickets = 0;
    private string reportPeriod = "month";

    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        try
        {
            // Load real data from database
            var clients = await ClientService.GetAllClientsAsync();
            var transactions = await PaymentService.GetAllTransactionsAsync();
            var invoices = await InvoiceService.GetAllInvoicesAsync();
            var tickets = await SupportService.GetAllTicketsAsync();

            // Calculate client statistics
            clientStats = new ClientStatistics
            {
                TotalClients = clients.Count,
                ActiveClients = clients.Count(c => c.Status == "Active"),
                SuspendedClients = clients.Count(c => c.Status == "Suspended"),
                TrialClients = clients.Count(c => c.Status == "Trial"),
                MonthlyRecurringRevenue = clients.Where(c => c.Status == "Active").Sum(c => c.Subscriptions?.Where(s => s.Status == "Active").Sum(s => s.TotalPrice) ?? 0),
                TotalOutstandingBalance = clients.Sum(c => c.OutstandingBalance)
            };

            // Calculate revenue statistics
            var thisMonth = DateTime.Now.Month;
            var thisYear = DateTime.Now.Year;
            var lastMonth = thisMonth == 1 ? 12 : thisMonth - 1;
            var lastMonthYear = thisMonth == 1 ? thisYear - 1 : thisYear;

            var thisMonthRevenue = transactions
                .Where(t => t.Status == "Completed" && t.TransactionDate.Month == thisMonth && t.TransactionDate.Year == thisYear)
                .Sum(t => t.Amount);
            var lastMonthRevenue = transactions
                .Where(t => t.Status == "Completed" && t.TransactionDate.Month == lastMonth && t.TransactionDate.Year == lastMonthYear)
                .Sum(t => t.Amount);
            
            var growthPercent = lastMonthRevenue > 0 
                ? ((thisMonthRevenue - lastMonthRevenue) / lastMonthRevenue) * 100 
                : 0;

            revenueStats = new RevenueStats
            {
                ThisMonthRevenue = thisMonthRevenue,
                LastMonthRevenue = lastMonthRevenue,
                GrowthPercentage = growthPercent,
                PendingPayments = transactions.Where(t => t.Status == "Pending").Sum(t => t.Amount),
                TotalRevenue = transactions.Where(t => t.Status == "Completed").Sum(t => t.Amount)
            };

            // Get recent transactions
            recentTransactions = transactions
                .OrderByDescending(t => t.TransactionDate)
                .Take(10)
                .ToList();

            // Get recent clients
            recentClients = clients
                .OrderByDescending(c => c.CreatedAt)
                .Take(5)
                .ToList();

            // Get overdue invoices
            overdueInvoices = invoices
                .Where(i => i.Status != "Paid" && i.DueDate < DateTime.Now)
                .OrderByDescending(i => i.DueDate)
                .Take(5)
                .ToList();

            // Get open tickets
            openTicketsList = tickets
                .Where(t => t.Status == "Open" || t.Status == "In Progress")
                .OrderByDescending(t => t.CreatedAt)
                .Take(5)
                .ToList();

            openTickets = openTicketsList.Count;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard data: {ex.Message}");
            // Initialize with empty data on error
            clientStats = new ClientStatistics();
            revenueStats = new RevenueStats();
            recentTransactions = new List<SaaSTransaction>();
            recentClients = new List<SaaSClient>();
            overdueInvoices = new List<SaaSInvoice>();
            openTicketsList = new List<SupportTicket>();
            openTickets = 0;
        }
    }

    private string GetTypeBadge(string type) => type.ToLower();

    private string GetStatusClass(string status) => status;

    private string GetTimeAgo(DateTime date)
    {
        var span = DateTime.Now - date;
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d ago";
        return date.ToString("MMM dd");
    }

    // Revenue Report Methods
    private decimal GetTotalRevenue()
    {
        return reportPeriod switch
        {
            "month" => revenueStats.ThisMonthRevenue,
            "quarter" => revenueStats.ThisMonthRevenue * 3,
            "year" => revenueStats.TotalRevenue,
            "all" => revenueStats.TotalRevenue,
            _ => revenueStats.ThisMonthRevenue
        };
    }

    private decimal GetPendingCollection()
    {
        return revenueStats.PendingPayments;
    }

    private int GetTotalTransactions()
    {
        return reportPeriod switch
        {
            "month" => recentTransactions.Count(t => t.Status == "Completed"),
            "quarter" => recentTransactions.Count(t => t.Status == "Completed") * 3,
            "year" => recentTransactions.Count(t => t.Status == "Completed") * 12,
            "all" => recentTransactions.Count(t => t.Status == "Completed") * 24,
            _ => recentTransactions.Count(t => t.Status == "Completed")
        };
    }

    private decimal GetAverageRevenuePerClient()
    {
        if (clientStats.ActiveClients == 0) return 0;
        return GetTotalRevenue() / clientStats.ActiveClients;
    }

    private async Task DownloadRevenueReport()
    {
        var periodLabel = reportPeriod switch
        {
            "month" => "Monthly",
            "quarter" => "Quarterly",
            "year" => "Yearly",
            "all" => "All-Time",
            _ => "Monthly"
        };

        var csvContent = GenerateRevenueReportCSV(periodLabel);
        var fileName = $"Revenue_Report_{periodLabel}_{DateTime.Now:yyyy-MM-dd}.csv";

        // Use JS interop to download the file
        await JSRuntime.InvokeVoidAsync("downloadFile", fileName, csvContent, "text/csv");
    }

    private string GenerateRevenueReportCSV(string periodLabel)
    {
        var sb = new System.Text.StringBuilder();
        
        // Header
        sb.AppendLine($"FineBank SaaS - Revenue Report ({periodLabel})");
        sb.AppendLine($"Generated: {DateTime.Now:yyyy-MM-dd HH:mm:ss}");
        sb.AppendLine();
        
        // Summary Section
        sb.AppendLine("=== REVENUE SUMMARY ===");
        sb.AppendLine($"Total Revenue,₱{GetTotalRevenue():N2}");
        sb.AppendLine($"Pending Collection,₱{GetPendingCollection():N2}");
        sb.AppendLine($"Total Transactions,{GetTotalTransactions()}");
        sb.AppendLine($"Average Revenue per Client,₱{GetAverageRevenuePerClient():N2}");
        sb.AppendLine($"Active Clients,{clientStats.ActiveClients}");
        sb.AppendLine($"Monthly Recurring Revenue,₱{clientStats.MonthlyRecurringRevenue:N2}");
        sb.AppendLine();
        
        // Transaction Details
        sb.AppendLine("=== RECENT TRANSACTIONS ===");
        sb.AppendLine("Date,Client,Type,Amount,Status");
        foreach (var trans in recentTransactions)
        {
            sb.AppendLine($"{trans.TransactionDate:yyyy-MM-dd},{trans.Client?.CompanyName ?? "N/A"},{trans.TransactionType},₱{trans.Amount:N2},{trans.Status}");
        }
        sb.AppendLine();
        
        // Client Summary
        sb.AppendLine("=== CLIENT SUMMARY ===");
        sb.AppendLine("Company,Email,Status,Since");
        foreach (var client in recentClients)
        {
            sb.AppendLine($"{client.CompanyName},{client.PrimaryEmail},{client.Status},{client.CreatedAt:yyyy-MM-dd}");
        }
        sb.AppendLine();
        
        // Module Revenue Breakdown
        sb.AppendLine("=== MODULE REVENUE BREAKDOWN ===");
        sb.AppendLine("Module,Revenue,Percentage");
        sb.AppendLine("Core System,Included,100%");
        sb.AppendLine("Loan Management,₱12000,85%");
        sb.AppendLine("General Ledger,₱9600,70%");
        sb.AppendLine("Teller Operations,₱6000,60%");
        sb.AppendLine("Savings Accounts,₱6000,50%");
        
        return sb.ToString();
    }
}
