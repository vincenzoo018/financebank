    private void ShowCreateInvoice()
    {
        newInvoice = new InvoiceData
        {
            InvoiceDate = DateTime.Today,
            DueDate = DateTime.Today.AddDays(15),
            PeriodStart = DateTime.Today.AddMonths(-1),
            PeriodEnd = DateTime.Today
        };
        invoiceItems = new List<InvoiceItemData>
        {
            new InvoiceItemData { Description = "Monthly Subscription", Quantity = 1, UnitPrice = 5999, Amount = 5999 }
        };
        CalculateTotals();
        showCreateModal = true;
    }

    private void CloseModal()
    {
        showCreateModal = false;
    }

    private void OnClientSelected()
    {
        var client = clients.FirstOrDefault(c => c.ClientId == newInvoice.ClientId);
        if (client != null)
        {
            newInvoice.ClientName = client.CompanyName;
        }
    }

    private void AddItem()
    {
        invoiceItems.Add(new InvoiceItemData { Quantity = 1, UnitPrice = 0 });
    }

    private void RemoveItem(InvoiceItemData item)
    {
        invoiceItems.Remove(item);
        CalculateTotals();
    }

    private void CalculateTotals()
    {
        foreach (var item in invoiceItems)
        {
            item.Amount = item.Quantity * item.UnitPrice;
        }
        subtotal = invoiceItems.Sum(i => i.Amount);
        tax = subtotal * 0.12m;
        total = subtotal + tax;
    }

    private void SaveInvoice()
    {
        var nextNum = invoices.Max(i => i.InvoiceId) + 1;
        newInvoice.InvoiceId = nextNum;
        newInvoice.InvoiceNumber = $"INV-2024-{nextNum:D3}";
        newInvoice.Subtotal = subtotal;
        newInvoice.Tax = tax;
        newInvoice.TotalAmount = total;
        newInvoice.BalanceDue = total;
        newInvoice.Status = "Pending";
        invoices.Insert(0, newInvoice);
        CloseModal();
    }

    private void ViewInvoice(InvoiceData invoice)
    {
        selectedInvoice = invoice;
        showViewModal = true;
    }

    private void RecordPayment(InvoiceData invoice)
    {
        selectedInvoice = invoice;
        paymentAmount = invoice.BalanceDue;
        paymentReference = "";
        paymentNotes = "";
        paymentDate = DateTime.Today;
        showPaymentModal = true;
    }

    private void SavePayment()
    {
        if (selectedInvoice != null)
        {
            selectedInvoice.AmountPaid += paymentAmount;
            selectedInvoice.BalanceDue -= paymentAmount;
            if (selectedInvoice.BalanceDue <= 0)
            {
                selectedInvoice.Status = "Paid";
                selectedInvoice.BalanceDue = 0;
            }
        }
        showPaymentModal = false;
    }

