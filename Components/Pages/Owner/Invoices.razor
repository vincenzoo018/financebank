@page "/owner/invoices"
@layout OwnerLayout
@using FinanceBank.Models.SaaS
@inject NavigationManager Navigation

<div class="invoices-page">
    <!-- Header -->
    <div class="page-header">
        <div class="header-left">
            <h2>Invoice Management</h2>
            <span class="subtitle">Manage all client invoices</span>
        </div>
        <div class="header-right">
            <button class="btn btn-primary" @onclick="ShowCreateInvoice">
                <span class="icon">➕</span> Create Invoice
            </button>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="stats-row">
        <div class="stat-card">
            <span class="stat-value">@invoices.Count</span>
            <span class="stat-label">Total Invoices</span>
        </div>
        <div class="stat-card pending">
            <span class="stat-value">@invoices.Count(i => i.Status == "Pending")</span>
            <span class="stat-label">Pending</span>
        </div>
        <div class="stat-card overdue">
            <span class="stat-value">@invoices.Count(i => i.Status == "Overdue")</span>
            <span class="stat-label">Overdue</span>
        </div>
        <div class="stat-card paid">
            <span class="stat-value">₱@invoices.Where(i => i.Status == "Paid").Sum(i => i.TotalAmount).ToString("N0")</span>
            <span class="stat-label">Collected This Month</span>
        </div>
    </div>

    <!-- Filters -->
    <div class="filters-bar">
        <div class="search-box">
            <span class="search-icon">🔍</span>
            <input type="text" placeholder="Search invoices..." @bind="searchTerm" @bind:event="oninput" />
        </div>
        <select @bind="statusFilter">
            <option value="">All Status</option>
            <option value="Pending">Pending</option>
            <option value="Sent">Sent</option>
            <option value="Paid">Paid</option>
            <option value="Overdue">Overdue</option>
            <option value="Cancelled">Cancelled</option>
        </select>
        <select @bind="clientFilter">
            <option value="">All Clients</option>
            @foreach (var client in clients)
            {
                <option value="@client.ClientId">@client.CompanyName</option>
            }
        </select>
    </div>

    <!-- Invoices Table -->
    <div class="table-card">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Invoice #</th>
                    <th>Client</th>
                    <th>Period</th>
                    <th>Amount</th>
                    <th>Balance</th>
                    <th>Due Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var invoice in FilteredInvoices)
                {
                    <tr>
                        <td><strong>@invoice.InvoiceNumber</strong></td>
                        <td>
                            <div class="client-cell">
                                <span class="client-name">@invoice.ClientName</span>
                            </div>
                        </td>
                        <td>@invoice.PeriodStart?.ToString("MMM yyyy")</td>
                        <td>₱@invoice.TotalAmount.ToString("N2")</td>
                        <td class="@(invoice.BalanceDue > 0 ? "text-danger" : "text-success")">
                            ₱@invoice.BalanceDue.ToString("N2")
                        </td>
                        <td class="@(invoice.DueDate < DateTime.Now && invoice.Status != "Paid" ? "text-danger" : "")">
                            @invoice.DueDate.ToString("MMM dd, yyyy")
                            @if (invoice.DueDate < DateTime.Now && invoice.Status != "Paid")
                            {
                                <span class="overdue-badge">@((DateTime.Now - invoice.DueDate).Days)d overdue</span>
                            }
                        </td>
                        <td><span class="status-badge @invoice.Status.ToLower()">@invoice.Status</span></td>
                        <td>
                            <div class="action-buttons">
                                <button class="action-btn" @onclick="() => ViewInvoice(invoice)" title="View">👁️</button>
                                @if (invoice.Status == "Pending" || invoice.Status == "Sent")
                                {
                                    <button class="action-btn" @onclick="() => RecordPayment(invoice)" title="Record Payment">💳</button>
                                }
                                <button class="action-btn" @onclick="() => PrintInvoice(invoice)" title="Print">🖨️</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Create Invoice Modal -->
    @if (showCreateModal)
    {
        <div class="modal-overlay" @onclick="CloseModal">
            <div class="modal-content large" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h3>Create Invoice</h3>
                    <button class="close-btn" @onclick="CloseModal">✕</button>
                </div>
                <div class="modal-body">
                    <div class="form-row">
                        <div class="form-group">
                            <label>Client *</label>
                            <select @bind="newInvoice.ClientId" @bind:after="OnClientSelected">
                                <option value="0">Select Client</option>
                                @foreach (var client in clients)
                                {
                                    <option value="@client.ClientId">@client.CompanyName</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Invoice Date</label>
                            <input type="date" @bind="newInvoice.InvoiceDate" />
                        </div>
                        <div class="form-group">
                            <label>Due Date</label>
                            <input type="date" @bind="newInvoice.DueDate" />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Billing Period Start</label>
                            <input type="date" @bind="newInvoice.PeriodStart" />
                        </div>
                        <div class="form-group">
                            <label>Billing Period End</label>
                            <input type="date" @bind="newInvoice.PeriodEnd" />
                        </div>
                    </div>

                    <h4>Invoice Items</h4>
                    <table class="items-table">
                        <thead>
                            <tr>
                                <th>Description</th>
                                <th>Qty</th>
                                <th>Unit Price</th>
                                <th>Amount</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in invoiceItems)
                            {
                                <tr>
                                    <td><input type="text" @bind="item.Description" placeholder="Description" /></td>
                                    <td><input type="number" @bind="item.Quantity" min="1" style="width:60px" @bind:after="CalculateTotals" /></td>
                                    <td><input type="number" @bind="item.UnitPrice" step="0.01" style="width:100px" @bind:after="CalculateTotals" /></td>
                                    <td>₱@item.Amount.ToString("N2")</td>
                                    <td><button class="remove-btn" @onclick="() => RemoveItem(item)">✕</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <button class="btn btn-secondary btn-sm" @onclick="AddItem">+ Add Item</button>

                    <div class="totals-section">
                        <div class="total-row">
                            <span>Subtotal</span>
                            <span>₱@subtotal.ToString("N2")</span>
                        </div>
                        <div class="total-row">
                            <span>Tax (12%)</span>
                            <span>₱@tax.ToString("N2")</span>
                        </div>
                        <div class="total-row total">
                            <span>Total Amount</span>
                            <span>₱@total.ToString("N2")</span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Notes</label>
                        <textarea @bind="newInvoice.Notes" rows="2" placeholder="Additional notes..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveInvoice">Create Invoice</button>
                </div>
            </div>
        </div>
    }

    <!-- Record Payment Modal -->
    @if (showPaymentModal)
    {
        <div class="modal-overlay" @onclick="() => showPaymentModal = false">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h3>Record Payment for @selectedInvoice?.InvoiceNumber</h3>
                    <button class="close-btn" @onclick="() => showPaymentModal = false">✕</button>
                </div>
                <div class="modal-body">
                    <div class="payment-info">
                        <p>Client: <strong>@selectedInvoice?.ClientName</strong></p>
                        <p>Balance Due: <strong class="text-danger">₱@selectedInvoice?.BalanceDue.ToString("N2")</strong></p>
                    </div>
                    <div class="form-group">
                        <label>Payment Method</label>
                        <select @bind="paymentMethod">
                            <option value="GCash">GCash</option>
                            <option value="PayMaya">PayMaya</option>
                            <option value="BDO">BDO Bank Transfer</option>
                            <option value="BPI">BPI Bank Transfer</option>
                            <option value="Cash">Cash</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Amount</label>
                        <input type="number" @bind="paymentAmount" step="0.01" />
                    </div>
                    <div class="form-group">
                        <label>Reference Number</label>
                        <input type="text" @bind="paymentReference" placeholder="GCash Ref #, Receipt #, etc." />
                    </div>
                    <div class="form-group">
                        <label>Payment Date</label>
                        <input type="date" @bind="paymentDate" />
                    </div>
                    <div class="form-group">
                        <label>Notes</label>
                        <textarea @bind="paymentNotes" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showPaymentModal = false">Cancel</button>
                    <button class="btn btn-success" @onclick="SavePayment">✓ Record Payment</button>
                </div>
            </div>
        </div>
    }

    <!-- View Invoice Modal -->
    @if (showViewModal && selectedInvoice != null)
    {
        <div class="modal-overlay" @onclick="() => showViewModal = false">
            <div class="modal-content large" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h3>Invoice @selectedInvoice.InvoiceNumber</h3>
                    <button class="close-btn" @onclick="() => showViewModal = false">✕</button>
                </div>
                <div class="modal-body invoice-preview">
                    <div class="invoice-header-section">
                        <div class="company-info">
                            <h2>ERP Solutions Provider</h2>
                            <p>Your trusted banking software partner</p>
                        </div>
                        <div class="invoice-info">
                            <h3>INVOICE</h3>
                            <p><strong>@selectedInvoice.InvoiceNumber</strong></p>
                            <p>Date: @selectedInvoice.InvoiceDate.ToString("MMM dd, yyyy")</p>
                            <p>Due: @selectedInvoice.DueDate.ToString("MMM dd, yyyy")</p>
                        </div>
                    </div>

                    <div class="bill-to">
                        <h4>Bill To:</h4>
                        <p><strong>@selectedInvoice.ClientName</strong></p>
                        <p>Billing Period: @selectedInvoice.PeriodStart?.ToString("MMM dd") - @selectedInvoice.PeriodEnd?.ToString("MMM dd, yyyy")</p>
                    </div>

                    <table class="invoice-items-table">
                        <thead>
                            <tr>
                                <th>Description</th>
                                <th>Qty</th>
                                <th>Unit Price</th>
                                <th>Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Monthly Subscription - Professional Plan</td>
                                <td>1</td>
                                <td>₱5,999.00</td>
                                <td>₱5,999.00</td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3">Subtotal</td>
                                <td>₱@selectedInvoice.Subtotal.ToString("N2")</td>
                            </tr>
                            <tr>
                                <td colspan="3">Tax (12%)</td>
                                <td>₱@selectedInvoice.Tax.ToString("N2")</td>
                            </tr>
                            <tr class="total-row">
                                <td colspan="3"><strong>Total</strong></td>
                                <td><strong>₱@selectedInvoice.TotalAmount.ToString("N2")</strong></td>
                            </tr>
                            <tr>
                                <td colspan="3">Amount Paid</td>
                                <td>₱@selectedInvoice.AmountPaid.ToString("N2")</td>
                            </tr>
                            <tr class="balance-row">
                                <td colspan="3"><strong>Balance Due</strong></td>
                                <td><strong class="@(selectedInvoice.BalanceDue > 0 ? "text-danger" : "text-success")">₱@selectedInvoice.BalanceDue.ToString("N2")</strong></td>
                            </tr>
                        </tfoot>
                    </table>

                    <div class="payment-instructions">
                        <h4>Payment Methods:</h4>
                        <ul>
                            <li><strong>GCash:</strong> 0917-XXX-XXXX</li>
                            <li><strong>BDO:</strong> 1234-5678-9012 (ERP Solutions Provider)</li>
                            <li><strong>BPI:</strong> 1234-5678-9012 (ERP Solutions Provider)</li>
                        </ul>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showViewModal = false">Close</button>
                    <button class="btn btn-primary" @onclick="() => PrintInvoice(selectedInvoice)">🖨️ Print</button>
                </div>
            </div>
        </div>
    }
</div>

<style>
