    }

    .payment-instructions ul {
        margin: 0;
        padding-left: 20px;
    }

    .payment-info {
        background: #f9fafb;
        padding: 16px;
        border-radius: 8px;
        margin-bottom: 16px;
    }

    .payment-info p {
        margin: 4px 0;
    }
</style>

@code {
    private List<InvoiceData> invoices = new();
    private List<ClientData> clients = new();
    private string searchTerm = "";
    private string statusFilter = "";
    private int clientFilter = 0;

    private bool showCreateModal = false;
    private bool showPaymentModal = false;
    private bool showViewModal = false;
    private InvoiceData? selectedInvoice;
    private InvoiceData newInvoice = new();
    private List<InvoiceItemData> invoiceItems = new();

    private decimal subtotal = 0;
    private decimal tax = 0;
    private decimal total = 0;

    // Payment form
    private string paymentMethod = "GCash";
    private decimal paymentAmount = 0;
    private string paymentReference = "";
    private DateTime paymentDate = DateTime.Today;
    private string paymentNotes = "";

    private IEnumerable<InvoiceData> FilteredInvoices => invoices
        .Where(i => string.IsNullOrEmpty(searchTerm) || 
            i.InvoiceNumber.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            i.ClientName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        .Where(i => string.IsNullOrEmpty(statusFilter) || i.Status == statusFilter)
        .Where(i => clientFilter == 0 || i.ClientId == clientFilter)
        .OrderByDescending(i => i.InvoiceDate);

    protected override async Task OnInitializedAsync()
    {
        await LoadSampleData();
    }

    private async Task LoadSampleData()
    {
        await Task.Delay(100);

        clients = new List<ClientData>
        {
            new ClientData { ClientId = 1, CompanyName = "FineBank Cooperative" },
            new ClientData { ClientId = 2, CompanyName = "Demo Company Inc." },
            new ClientData { ClientId = 3, CompanyName = "Metro Credit Union" },
            new ClientData { ClientId = 4, CompanyName = "Rural Bank Corp" },
        };

        invoices = new List<InvoiceData>
        {
