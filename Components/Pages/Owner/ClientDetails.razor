            new ModuleInfo { ModuleId = 8, ModuleName = "Audit Trail", Description = "Security logs", Icon = "🔒", IsEnabled = true },
        };

        paymentAmount = client.OutstandingBalance;
    }

    private void GoBack() => Navigation.NavigateTo("/owner/clients");
    private void EditClient() => Navigation.NavigateTo($"/owner/clients");
    private void SuspendClient() => client.Status = "Suspended";
    private void ActivateClient() => client.Status = "Active";
    private void CreateInvoice() { }

    private void RecordPayment(InvoiceInfo invoice)
    {
        paymentInvoiceId = invoice.InvoiceId;
        paymentAmount = invoice.BalanceDue;
        showPaymentModal = true;
    }

    private void ShowRecordPayment()
    {
        paymentInvoiceId = 0;
        paymentAmount = 0;
        showPaymentModal = true;
    }

    private void SavePayment()
    {
        var newPayment = new PaymentInfo
        {
            TransactionNumber = $"TXN-2024-{(payments.Count + 1):D3}",
            TransactionDate = paymentDate,
            PaymentMethodName = paymentMethod,
            Amount = paymentAmount,
            Status = "Completed",
            PaymentReference = paymentReference
        };
        payments.Insert(0, newPayment);

        // Update invoice
        var invoice = invoices.FirstOrDefault(i => i.InvoiceId == paymentInvoiceId);
        if (invoice != null)
        {
            invoice.Status = "Paid";
            invoice.BalanceDue = 0;
        }

        client.OutstandingBalance -= paymentAmount;
        client.TotalPaid += paymentAmount;
        showPaymentModal = false;
    }

    private void ToggleModule(ModuleInfo module)
    {
        module.IsEnabled = !module.IsEnabled;
    }

    private string GetMemberDuration()
    {
        var months = (DateTime.Now - client.CreatedAt).Days / 30;
        return months == 1 ? "1 month" : $"{months} months";
    }

