@page "/owner/client/{ClientId:int}"
@layout OwnerLayout
@using FinanceBank.Models.SaaS
@inject NavigationManager Navigation

<div class="client-details-page">
    <!-- Header -->
    <div class="page-header">
        <div class="header-left">
            <button class="back-btn" @onclick="GoBack">← Back to Clients</button>
            <h2>@client.CompanyName</h2>
            <span class="status-badge @client.Status.ToLower()">@client.Status</span>
        </div>
        <div class="header-right">
            <button class="btn btn-secondary" @onclick="EditClient">✏️ Edit</button>
            @if (client.Status == "Active")
            {
                <button class="btn btn-danger" @onclick="SuspendClient">⏸️ Suspend</button>
            }
            else
            {
                <button class="btn btn-success" @onclick="ActivateClient">▶️ Activate</button>
            }
        </div>
    </div>

    <!-- Info Cards Row -->
    <div class="info-row">
        <div class="info-card">
            <div class="info-icon">📋</div>
            <div class="info-content">
                <span class="info-label">Subscription Plan</span>
                <span class="info-value">@subscription.PlanName</span>
                <span class="info-sub">@subscription.BillingCycle</span>
            </div>
        </div>
        <div class="info-card">
            <div class="info-icon">💰</div>
            <div class="info-content">
                <span class="info-label">Monthly Fee</span>
                <span class="info-value">₱@subscription.MonthlyPrice.ToString("N2")</span>
                <span class="info-sub">Next: @subscription.NextBilling</span>
            </div>
        </div>
        <div class="info-card">
            <div class="info-icon">💳</div>
            <div class="info-content">
                <span class="info-label">Outstanding Balance</span>
                <span class="info-value @(client.OutstandingBalance > 0 ? "text-danger" : "text-success")">₱@client.OutstandingBalance.ToString("N2")</span>
                <span class="info-sub">Total Paid: ₱@client.TotalPaid.ToString("N0")</span>
            </div>
        </div>
        <div class="info-card">
            <div class="info-icon">📅</div>
            <div class="info-content">
                <span class="info-label">Client Since</span>
                <span class="info-value">@client.CreatedAt.ToString("MMM dd, yyyy")</span>
                <span class="info-sub">@GetMemberDuration()</span>
            </div>
        </div>
    </div>

    <!-- Main Content Tabs -->
    <div class="tabs-container">
        <div class="tabs-header">
            <button class="tab-btn @(activeTab == "details" ? "active" : "")" @onclick='() => activeTab = "details"'>Details</button>
            <button class="tab-btn @(activeTab == "invoices" ? "active" : "")" @onclick='() => activeTab = "invoices"'>Invoices (@invoices.Count)</button>
            <button class="tab-btn @(activeTab == "payments" ? "active" : "")" @onclick='() => activeTab = "payments"'>Payments (@payments.Count)</button>
            <button class="tab-btn @(activeTab == "modules" ? "active" : "")" @onclick='() => activeTab = "modules"'>Modules (@modules.Count)</button>
        </div>

        <div class="tab-content">
            @if (activeTab == "details")
            {
                <div class="details-tab">
                    <div class="detail-section">
                        <h4>Company Information</h4>
                        <div class="detail-grid">
                            <div class="detail-item">
                                <span class="detail-label">Company Name</span>
                                <span class="detail-value">@client.CompanyName</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Client Code</span>
                                <span class="detail-value">@client.ClientCode</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Business Type</span>
                                <span class="detail-value">@(client.BusinessType ?? "Cooperative")</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Tax ID</span>
                                <span class="detail-value">@(client.TaxId ?? "—")</span>
                            </div>
                        </div>
                    </div>

                    <div class="detail-section">
                        <h4>Contact Information</h4>
                        <div class="detail-grid">
                            <div class="detail-item">
                                <span class="detail-label">Primary Email</span>
                                <span class="detail-value">@client.PrimaryEmail</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Phone</span>
                                <span class="detail-value">@(client.Phone ?? "—")</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Mobile</span>
                                <span class="detail-value">@(client.Mobile ?? "—")</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Address</span>
                                <span class="detail-value">@(client.Address ?? "—"), @(client.City ?? "")</span>
                            </div>
                        </div>
                    </div>

                    <div class="detail-section">
                        <h4>Contact Person</h4>
                        <div class="detail-grid">
                            <div class="detail-item">
                                <span class="detail-label">Name</span>
                                <span class="detail-value">@(client.ContactPersonName ?? "—")</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Title</span>
                                <span class="detail-value">@(client.ContactPersonTitle ?? "—")</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (activeTab == "invoices")
            {
                <div class="invoices-tab">
                    <div class="tab-actions">
                        <button class="btn btn-primary btn-sm" @onclick="CreateInvoice">➕ Create Invoice</button>
                    </div>
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Invoice #</th>
                                <th>Period</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Due Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inv in invoices)
                            {
                                <tr>
                                    <td><strong>@inv.InvoiceNumber</strong></td>
                                    <td>@inv.PeriodStart?.ToString("MMM yyyy")</td>
                                    <td>₱@inv.TotalAmount.ToString("N2")</td>
                                    <td><span class="status-badge @inv.Status.ToLower()">@inv.Status</span></td>
                                    <td>@inv.DueDate.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <button class="action-btn" title="View">👁️</button>
                                        @if (inv.Status == "Pending")
                                        {
                                            <button class="action-btn" @onclick="() => RecordPayment(inv)" title="Record Payment">💳</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (activeTab == "payments")
            {
                <div class="payments-tab">
                    <div class="tab-actions">
                        <button class="btn btn-primary btn-sm" @onclick="ShowRecordPayment">➕ Record Payment</button>
                    </div>
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Transaction #</th>
                                <th>Date</th>
                                <th>Method</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Reference</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pmt in payments)
                            {
                                <tr>
                                    <td><strong>@pmt.TransactionNumber</strong></td>
                                    <td>@pmt.TransactionDate.ToString("MMM dd, yyyy")</td>
                                    <td>@pmt.PaymentMethodName</td>
                                    <td class="text-success">₱@pmt.Amount.ToString("N2")</td>
                                    <td><span class="status-badge @pmt.Status.ToLower()">@pmt.Status</span></td>
                                    <td>@pmt.PaymentReference</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (activeTab == "modules")
            {
                <div class="modules-tab">
                    <div class="modules-grid">
                        @foreach (var mod in modules)
                        {
                            <div class="module-card @(mod.IsEnabled ? "enabled" : "disabled")">
                                <div class="module-icon">@mod.Icon</div>
                                <div class="module-info">
                                    <span class="module-name">@mod.ModuleName</span>
                                    <span class="module-desc">@mod.Description</span>
                                </div>
                                <div class="module-toggle">
                                    <label class="switch">
                                        <input type="checkbox" checked="@mod.IsEnabled" @onchange="() => ToggleModule(mod)" />
                                        <span class="slider"></span>
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Record Payment Modal -->
    @if (showPaymentModal)
    {
        <div class="modal-overlay" @onclick="() => showPaymentModal = false">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h3>Record Payment</h3>
                    <button class="close-btn" @onclick="() => showPaymentModal = false">✕</button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label>Invoice</label>
                        <select @bind="paymentInvoiceId">
                            <option value="0">Select Invoice</option>
                            @foreach (var inv in invoices.Where(i => i.Status == "Pending"))
                            {
                                <option value="@inv.InvoiceId">@inv.InvoiceNumber - ₱@inv.BalanceDue.ToString("N2")</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Payment Method</label>
                        <select @bind="paymentMethod">
                            <option value="GCash">GCash</option>
                            <option value="PayMaya">PayMaya</option>
                            <option value="BDO">BDO Bank Transfer</option>
                            <option value="BPI">BPI Bank Transfer</option>
                            <option value="Cash">Cash</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Amount</label>
                        <input type="number" @bind="paymentAmount" step="0.01" />
                    </div>
                    <div class="form-group">
                        <label>Reference Number</label>
                        <input type="text" @bind="paymentReference" placeholder="Transaction/Receipt number" />
                    </div>
                    <div class="form-group">
                        <label>Payment Date</label>
                        <input type="date" @bind="paymentDate" />
                    </div>
                    <div class="form-group">
                        <label>Notes</label>
                        <textarea @bind="paymentNotes" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showPaymentModal = false">Cancel</button>
                    <button class="btn btn-primary" @onclick="SavePayment">Record Payment</button>
                </div>
            </div>
        </div>
    }
</div>

