@page "/owner/plans"
@layout OwnerLayout

<div class="plans-page">
    <!-- Header -->
    <div class="page-header">
        <div class="header-left">
            <h2>Subscription Plans</h2>
            <span class="subtitle">Manage your pricing plans</span>
        </div>
        <div class="header-right">
            <button class="btn btn-primary" @onclick="ShowAddPlan">
                <span class="icon">➕</span> Add New Plan
            </button>
        </div>
    </div>

    <!-- Plans Grid -->
    <div class="plans-grid">
        @foreach (var plan in plans)
        {
            <div class="plan-card @(plan.IsPopular ? "popular" : "")">
                @if (plan.IsPopular)
                {
                    <div class="popular-badge">⭐ Most Popular</div>
                }
                <div class="plan-header">
                    <h3>@plan.PlanName</h3>
                    <p class="plan-desc">@plan.Description</p>
                </div>
                <div class="plan-pricing">
                    <div class="price-row">
                        <span class="price">₱@plan.MonthlyPrice.ToString("N0")</span>
                        <span class="period">/month</span>
                    </div>
                    <div class="yearly-price">
                        or ₱@plan.YearlyPrice.ToString("N0")/year (save 17%)
                    </div>
                </div>
                <div class="plan-features">
                    <h4>Features:</h4>
                    <ul>
                        @foreach (var feature in plan.FeatureList)
                        {
                            <li>✓ @feature</li>
                        }
                    </ul>
                </div>
                <div class="plan-limits">
                    <div class="limit-item">
                        <span class="limit-icon">👥</span>
                        <span>@plan.MaxUsers Users</span>
                    </div>
                    <div class="limit-item">
                        <span class="limit-icon">🏢</span>
                        <span>@plan.MaxBranches Branch@(plan.MaxBranches > 1 ? "es" : "")</span>
                    </div>
                    <div class="limit-item">
                        <span class="limit-icon">💾</span>
                        <span>@plan.MaxStorageGB GB Storage</span>
                    </div>
                </div>
                <div class="plan-stats">
                    <div class="stat">
                        <span class="stat-value">@plan.ActiveSubscribers</span>
                        <span class="stat-label">Active Subscribers</span>
                    </div>
                    <div class="stat">
                        <span class="stat-value">₱@plan.MonthlyRevenue.ToString("N0")</span>
                        <span class="stat-label">Monthly Revenue</span>
                    </div>
                </div>
                <div class="plan-actions">
                    <button class="btn btn-secondary btn-sm" @onclick="() => EditPlan(plan)">✏️ Edit</button>
                    <button class="btn btn-secondary btn-sm" @onclick="() => ViewSubscribers(plan)">👥 Subscribers</button>
                </div>
            </div>
        }
    </div>

    <!-- Edit Plan Modal -->
    @if (showModal)
    {
        <div class="modal-overlay" @onclick="CloseModal">
            <div class="modal-content large" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h3>@(isEditing ? "Edit Plan" : "Add New Plan")</h3>
                    <button class="close-btn" @onclick="CloseModal">✕</button>
                </div>
                <div class="modal-body">
                    <div class="form-row">
                        <div class="form-group">
                            <label>Plan Name *</label>
                            <input type="text" @bind="editPlan.PlanName" placeholder="e.g., Professional Plan" />
                        </div>
                        <div class="form-group">
                            <label>Plan Code *</label>
                            <input type="text" @bind="editPlan.PlanCode" placeholder="e.g., PRO" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Description</label>
                        <textarea @bind="editPlan.Description" rows="2"></textarea>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Monthly Price (₱)</label>
                            <input type="number" @bind="editPlan.MonthlyPrice" step="0.01" />
                        </div>
                        <div class="form-group">
                            <label>Yearly Price (₱)</label>
                            <input type="number" @bind="editPlan.YearlyPrice" step="0.01" />
                        </div>
                        <div class="form-group">
                            <label>Setup Fee (₱)</label>
                            <input type="number" @bind="editPlan.SetupFee" step="0.01" />
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Max Users</label>
                            <input type="number" @bind="editPlan.MaxUsers" min="1" />
                        </div>
                        <div class="form-group">
                            <label>Max Branches</label>
                            <input type="number" @bind="editPlan.MaxBranches" min="1" />
                        </div>
                        <div class="form-group">
                            <label>Storage (GB)</label>
                            <input type="number" @bind="editPlan.MaxStorageGB" min="1" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Features (one per line)</label>
                        <textarea @bind="featuresText" rows="5" placeholder="Core System&#10;Teller Operations&#10;Loan Management"></textarea>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Support Level</label>
                            <select @bind="editPlan.SupportLevel">
                                <option value="Email">Email Support</option>
                                <option value="Priority Email">Priority Email</option>
                                <option value="24/7 Phone & Email">24/7 Phone & Email</option>
                            </select>
                        </div>
                        <div class="form-group checkbox-group">
                            <label>
                                <input type="checkbox" @bind="editPlan.IsPopular" />
                                Mark as Popular
                            </label>
                            <label>
                                <input type="checkbox" @bind="editPlan.IsActive" />
                                Active
                            </label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                    <button class="btn btn-primary" @onclick="SavePlan">@(isEditing ? "Update Plan" : "Create Plan")</button>
                </div>
            </div>
        </div>
    }
</div>

