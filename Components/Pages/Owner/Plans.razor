            },
            new PlanData { 
                PlanId = 2, 
                PlanCode = "PRO", 
                PlanName = "Professional Plan", 
                Description = "Complete solution for growing cooperatives",
                MonthlyPrice = 5999,
                YearlyPrice = 59990,
                SetupFee = 10000,
                MaxUsers = 15,
                MaxBranches = 3,
                MaxStorageGB = 25,
                Features = "All Basic Features,Loan Management,General Ledger,Advanced Reports,Audit Trail",
                SupportLevel = "Priority Email",
                IsActive = true,
                IsPopular = true,
                ActiveSubscribers = 5,
                MonthlyRevenue = 29995
            },
            new PlanData { 
                PlanId = 3, 
                PlanCode = "ENTERPRISE", 
                PlanName = "Enterprise Plan", 
                Description = "Full-featured solution for large organizations",
                MonthlyPrice = 9999,
                YearlyPrice = 99990,
                SetupFee = 20000,
                MaxUsers = 50,
                MaxBranches = 10,
                MaxStorageGB = 100,
                Features = "All Pro Features,Multi-Branch Support,Custom Reports,API Access,Dedicated Support,Custom Integrations",
                SupportLevel = "24/7 Phone & Email",
                IsActive = true,
                IsPopular = false,
                ActiveSubscribers = 2,
                MonthlyRevenue = 19998
            }
        };
    }

    private void ShowAddPlan()
    {
        editPlan = new PlanData { IsActive = true, MaxUsers = 5, MaxBranches = 1, MaxStorageGB = 5 };
        featuresText = "";
        isEditing = false;
        showModal = true;
    }

    private void EditPlan(PlanData plan)
    {
        editPlan = new PlanData
        {
            PlanId = plan.PlanId,
            PlanCode = plan.PlanCode,
            PlanName = plan.PlanName,
            Description = plan.Description,
            MonthlyPrice = plan.MonthlyPrice,
            YearlyPrice = plan.YearlyPrice,
            SetupFee = plan.SetupFee,
            MaxUsers = plan.MaxUsers,
            MaxBranches = plan.MaxBranches,
            MaxStorageGB = plan.MaxStorageGB,
            Features = plan.Features,
            SupportLevel = plan.SupportLevel,
            IsActive = plan.IsActive,
            IsPopular = plan.IsPopular
        };
        featuresText = plan.Features.Replace(",", "\n");
        isEditing = true;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private void SavePlan()
    {
        editPlan.Features = featuresText.Replace("\n", ",").Replace("\r", "");
        
        if (isEditing)
        {
            var existing = plans.FirstOrDefault(p => p.PlanId == editPlan.PlanId);
            if (existing != null)
            {
                existing.PlanName = editPlan.PlanName;
                existing.PlanCode = editPlan.PlanCode;
                existing.Description = editPlan.Description;
                existing.MonthlyPrice = editPlan.MonthlyPrice;
                existing.YearlyPrice = editPlan.YearlyPrice;
                existing.SetupFee = editPlan.SetupFee;
                existing.MaxUsers = editPlan.MaxUsers;
                existing.MaxBranches = editPlan.MaxBranches;
                existing.MaxStorageGB = editPlan.MaxStorageGB;
                existing.Features = editPlan.Features;
                existing.SupportLevel = editPlan.SupportLevel;
                existing.IsActive = editPlan.IsActive;
                existing.IsPopular = editPlan.IsPopular;
            }
        }
        else
        {
            editPlan.PlanId = plans.Max(p => p.PlanId) + 1;
            plans.Add(editPlan);
        }
        CloseModal();
    }

    private void ViewSubscribers(PlanData plan)
    {
        // Navigate to clients filtered by this plan
    }

    private class PlanData
    {
        public int PlanId { get; set; }
        public string PlanCode { get; set; } = "";
        public string PlanName { get; set; } = "";
        public string Description { get; set; } = "";
        public decimal MonthlyPrice { get; set; }
        public decimal YearlyPrice { get; set; }
        public decimal SetupFee { get; set; }
        public int MaxUsers { get; set; }
        public int MaxBranches { get; set; }
        public int MaxStorageGB { get; set; }
        public string Features { get; set; } = "";
        public string SupportLevel { get; set; } = "";
        public bool IsActive { get; set; }
        public bool IsPopular { get; set; }
        public int ActiveSubscribers { get; set; }
        public decimal MonthlyRevenue { get; set; }

        public List<string> FeatureList => Features.Split(',', StringSplitOptions.RemoveEmptyEntries).ToList();
    }
}
