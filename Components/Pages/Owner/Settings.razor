        };

        security = new SecuritySettings
        {
            TwoFactorEnabled = false
        };
    }

    private async Task SaveProfile()
    {
        await ShowSuccess();
    }

    private async Task SaveCompany()
    {
        await ShowSuccess();
    }

    private async Task SavePaymentMethods()
    {
        await ShowSuccess();
    }

    private async Task SaveNotifications()
    {
        await ShowSuccess();
    }

    private async Task ChangePassword()
    {
        if (security.NewPassword == security.ConfirmPassword)
        {
            await ShowSuccess();
            security.CurrentPassword = "";
            security.NewPassword = "";
            security.ConfirmPassword = "";
        }
    }

    private void ToggleTwoFactor()
    {
        security.TwoFactorEnabled = !security.TwoFactorEnabled;
    }

    private async Task ShowSuccess()
    {
        showSaveSuccess = true;
        StateHasChanged();
        await Task.Delay(3000);
        showSaveSuccess = false;
        StateHasChanged();
    }

    private class ProfileData
    {
        public string FullName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
    }

    private class CompanyData
    {
        public string Name { get; set; } = "";
        public string Address { get; set; } = "";
        public string TIN { get; set; } = "";
        public string SECReg { get; set; } = "";
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Website { get; set; } = "";
    }

    private class PaymentMethodData
