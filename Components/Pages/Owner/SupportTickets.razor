@page "/owner/tickets"
@layout OwnerLayout

<div class="tickets-page">
    <!-- Header -->
    <div class="page-header">
        <div class="header-left">
            <h2>Support Tickets</h2>
            <span class="subtitle">View and respond to client support requests</span>
        </div>
        <div class="header-right">
            <select class="filter-select" @bind="statusFilter">
                <option value="">All Status</option>
                <option value="Open">Open</option>
                <option value="In Progress">In Progress</option>
                <option value="Resolved">Resolved</option>
                <option value="Closed">Closed</option>
            </select>
            <select class="filter-select" @bind="priorityFilter">
                <option value="">All Priority</option>
                <option value="High">High</option>
                <option value="Medium">Medium</option>
                <option value="Low">Low</option>
            </select>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="stats-row">
        <div class="stat-card orange">
            <div class="stat-icon">🎫</div>
            <div class="stat-info">
                <span class="stat-value">@tickets.Count(t => t.Status == "Open")</span>
                <span class="stat-label">Open Tickets</span>
            </div>
        </div>
        <div class="stat-card blue">
            <div class="stat-icon">🔧</div>
            <div class="stat-info">
                <span class="stat-value">@tickets.Count(t => t.Status == "In Progress")</span>
                <span class="stat-label">In Progress</span>
            </div>
        </div>
        <div class="stat-card red">
            <div class="stat-icon">🔥</div>
            <div class="stat-info">
                <span class="stat-value">@tickets.Count(t => t.Priority == "High" && t.Status != "Closed")</span>
                <span class="stat-label">High Priority</span>
            </div>
        </div>
        <div class="stat-card green">
            <div class="stat-icon">✅</div>
            <div class="stat-info">
                <span class="stat-value">@tickets.Count(t => t.Status == "Resolved" || t.Status == "Closed")</span>
                <span class="stat-label">Resolved</span>
            </div>
        </div>
    </div>

    <!-- Tickets List -->
    <div class="tickets-list">
        @foreach (var ticket in FilteredTickets)
        {
            <div
                class="ticket-card @(ticket.Status == "Open" ? "unread" : "") @(ticket.Priority == "High" ? "high-priority" : "")">
                <div class="ticket-left">
                    <div class="ticket-avatar" style="background: @GetAvatarColor(ticket.ClientName);">
                        @ticket.ClientName[0]
                    </div>
                </div>
                <div class="ticket-main">
                    <div class="ticket-header-row">
                        <h4>#@ticket.TicketId - @ticket.Subject</h4>
                        <div class="ticket-badges">
                            <span class="badge priority-@ticket.Priority.ToLower()">@ticket.Priority</span>
                            <span class="badge status-@ticket.Status.ToLower().Replace(" ", "-")">@ticket.Status</span>
                        </div>
                    </div>
                    <p class="ticket-message">@ticket.LastMessage</p>
                    <div class="ticket-meta">
                        <span class="client-name">@ticket.ClientName</span>
                        <span class="separator">•</span>
                        <span class="category">@ticket.Category</span>
                        <span class="separator">•</span>
                        <span class="date">@ticket.LastUpdated.ToString("MMM dd, yyyy h:mm tt")</span>
                        @if (ticket.Replies > 0)
                        {
                            <span class="separator">•</span>
                            <span class="replies">💬 @ticket.Replies replies</span>
                        }
                    </div>
                </div>
                <div class="ticket-actions">
                    <button class="btn btn-primary btn-sm" @onclick="() => ViewTicket(ticket)">View</button>
                    @if (ticket.Status == "Open")
                    {
                        <button class="btn btn-secondary btn-sm" @onclick="() => AssignTicket(ticket)">Assign</button>
                    }
                </div>
            </div>
        }
    </div>

    <!-- View Ticket Modal -->
    @if (showViewModal)
    {
        <div class="modal-overlay" @onclick="CloseModal">
            <div class="modal-content large" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <div>
                        <h3>#@selectedTicket.TicketId - @selectedTicket.Subject</h3>
                        <div class="modal-badges">
                            <span class="badge priority-@selectedTicket.Priority.ToLower()">@selectedTicket.Priority</span>
                            <span
                                class="badge status-@selectedTicket.Status.ToLower().Replace(" ", "-")">@selectedTicket.Status</span>
                        </div>
                    </div>
                    <button class="close-btn" @onclick="CloseModal">✕</button>
                </div>
                <div class="modal-body">
                    <div class="ticket-info">
                        <div class="info-row">
                            <span class="info-label">Client:</span>
                            <span class="info-value">@selectedTicket.ClientName</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Category:</span>
                            <span class="info-value">@selectedTicket.Category</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Created:</span>
                            <span class="info-value">@selectedTicket.CreatedDate.ToString("MMM dd, yyyy h:mm tt")</span>
                        </div>
                    </div>

                    <div class="conversation">
                        @foreach (var message in ticketMessages)
                        {
                            <div class="message @(message.IsOwner ? "owner" : "client")">
                                <div class="message-avatar"
                                    style="background: @(message.IsOwner ? "#5F6F52" : GetAvatarColor(selectedTicket.ClientName));">
                                    @(message.IsOwner ? "S" : selectedTicket.ClientName[0])
                                </div>
                                <div class="message-content">
                                    <div class="message-header">
                                        <span class="sender">@(message.IsOwner ? "Support Team" :
                                                                                selectedTicket.ClientName)</span>
                                        <span class="time">@message.Timestamp.ToString("MMM dd, h:mm tt")</span>
                                    </div>
                                    <p>@message.Text</p>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="reply-section">
                        <textarea @bind="replyText" rows="3" placeholder="Type your reply..."></textarea>
                        <div class="reply-actions">
                            <select @bind="newStatus">
                                <option value="">Keep Status</option>
                                <option value="In Progress">Mark In Progress</option>
                                <option value="Resolved">Mark Resolved</option>
                                <option value="Closed">Close Ticket</option>
                            </select>
                            <button class="btn btn-primary" @onclick="SendReply">Send Reply</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
