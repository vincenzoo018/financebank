    }

    .badge.priority-high {
        background: rgba(155, 58, 58, 0.1);
        color: #9B3A3A;
    }

    .badge.priority-medium {
        background: rgba(196, 154, 58, 0.15);
        color: #C49A3A;
    }

    .badge.priority-low {
        background: rgba(95, 122, 106, 0.15);
        color: #5F7A6A;
    }

    .badge.status-open {
        background: rgba(95, 122, 106, 0.15);
        color: #5F7A6A;
    }

    .badge.status-in-progress {
        background: rgba(196, 154, 58, 0.15);
        color: #C49A3A;
    }

    .badge.status-resolved {
        background: rgba(79, 111, 82, 0.15);
        color: #4F6F52;
    }

    .badge.status-closed {
        background: #E2E2DC;
