@code {
    [Parameter] public int ClientId { get; set; }

    private List<SaaSClient> clients = new();
    private List<SubscriptionPlan> plans = new();
    private SaaSClient? selectedClient;
    private SaaSClient editClient = new();
    private bool showForm = false;
    private bool isEditing = false;
    private string searchTerm = "";
    private string statusFilter = "";
    private int selectedPlanId = 0;

    private IEnumerable<SaaSClient> FilteredClients => clients
    .Where(c => string.IsNullOrEmpty(searchTerm) ||
    c.CompanyName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
    c.ClientCode.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
    c.PrimaryEmail.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
    .Where(c => string.IsNullOrEmpty(statusFilter) || c.Status == statusFilter);

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    protected override async Task OnParametersSetAsync()
    {
        var path = Navigation.Uri.ToLower();
        if (path.EndsWith("/new"))
        {
            ShowAddForm();
        }
        else if (ClientId > 0)
        {
            await SelectClientById(ClientId);
        }
    }

    private async Task LoadData()
    {
        clients = await ClientService.GetAllClientsAsync();
        plans = await PlanService.GetAllPlansAsync();
    }

    private void ShowAddForm()
    {
        editClient = new SaaSClient { Status = "Trial", BillingCycle = "Monthly" };
        isEditing = false;
        showForm = true;
        selectedClient = null;
    }

    private void HideForm()
    {
        showForm = false;
        Navigation.NavigateTo("/owner/clients");
    }

    private async Task SelectClient(SaaSClient client)
    {
        selectedClient = await ClientService.GetClientByIdAsync(client.ClientId);
    }

    private async Task SelectClientById(int clientId)
    {
        selectedClient = await ClientService.GetClientByIdAsync(clientId);
    }

    private void ClearSelection()
    {
        selectedClient = null;
        Navigation.NavigateTo("/owner/clients");
    }

    private void EditClient(SaaSClient client)
    {
        editClient = new SaaSClient
        {
            ClientId = client.ClientId,
            CompanyName = client.CompanyName,
            TradeName = client.TradeName,
            BusinessType = client.BusinessType,
            TaxId = client.TaxId,
            Address = client.Address,
            City = client.City,
            Province = client.Province,
            PostalCode = client.PostalCode,
            PrimaryEmail = client.PrimaryEmail,
            SecondaryEmail = client.SecondaryEmail,
            Phone = client.Phone,
            Mobile = client.Mobile,
            Website = client.Website,
            ContactPersonName = client.ContactPersonName,
            ContactPersonTitle = client.ContactPersonTitle,
            ContactPersonEmail = client.ContactPersonEmail,
            ContactPersonPhone = client.ContactPersonPhone,
            Notes = client.Notes,
            Status = client.Status,
            BillingCycle = client.BillingCycle
        };
        isEditing = true;
        showForm = true;
    }

    private async Task SaveClient()
    {
        try
        {
            if (isEditing)
            {
                await ClientService.UpdateClientAsync(editClient);
            }
            else
            {
                var newClient = await ClientService.CreateClientAsync(editClient);

                // Subscribe to plan if selected
                if (selectedPlanId > 0)
                {
                    await PlanService.SubscribeClientToPlanAsync(newClient.ClientId, selectedPlanId, editClient.BillingCycle);
                }
            }

            await LoadData();
            HideForm();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving client: {ex.Message}");
        }
    }

    private async Task SuspendClient(int clientId)
    {
        await ClientService.SuspendClientAsync(clientId, "Suspended by owner");
        await LoadData();
        selectedClient = await ClientService.GetClientByIdAsync(clientId);
    }

    private async Task ActivateClient(int clientId)
    {
        await ClientService.ActivateClientAsync(clientId);
        await LoadData();
        selectedClient = await ClientService.GetClientByIdAsync(clientId);
    }

    private void ShowSubscribeModal(int clientId)
    {
        // TODO: Show modal to select plan
    }

    private void ShowModuleManager(int clientId)
    {
        Navigation.NavigateTo($"/owner/clients/{clientId}/modules");
    }
}