@code {
    private List<SaaSInvoice> invoices = new();
    private List<SaaSClient> clients = new();
    private SaaSInvoice newInvoice = new();
    private SaaSInvoice? viewInvoice;
    private List<SaaSInvoiceItem> invoiceItems = new();
    private bool showCreateForm = false;
    private string searchTerm = "";
    private string statusFilter = "";

    private IEnumerable<SaaSInvoice> FilteredInvoices => invoices
    .Where(i => string.IsNullOrEmpty(searchTerm) ||
    i.InvoiceNumber.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
    i.Client?.CompanyName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true)
    .Where(i => string.IsNullOrEmpty(statusFilter) || i.Status == statusFilter)
    .OrderByDescending(i => i.IssueDate);

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        invoices = await InvoiceService.GetAllInvoicesAsync();
        clients = await ClientService.GetAllClientsAsync();

        // Check for overdue invoices
        foreach (var invoice in invoices.Where(i => i.Status == "Sent" && i.DueDate < DateTime.Now))
        {
            await InvoiceService.MarkOverdueAsync(invoice.InvoiceId);
        }

        invoices = await InvoiceService.GetAllInvoicesAsync();
    }

    private void ShowCreateForm()
    {
        newInvoice = new SaaSInvoice
        {
            InvoiceDate = DateTime.Now,
            DueDate = DateTime.Now.AddDays(30),
            Status = "Draft",
            TaxRate = 0
        };
        invoiceItems = new List<SaaSInvoiceItem>
{
new SaaSInvoiceItem { Description = "", Quantity = 1, UnitPrice = 0 }
};
        showCreateForm = true;
    }

    private void HideCreateForm()
    {
        showCreateForm = false;
    }

    private void AddItem()
    {
        invoiceItems.Add(new SaaSInvoiceItem { Description = "", Quantity = 1, UnitPrice = 0 });
    }

    private void RemoveItem(SaaSInvoiceItem item)
    {
        if (invoiceItems.Count > 1)
        {
            invoiceItems.Remove(item);
        }
    }

    private async Task CreateInvoice()
    {
        try
        {
            var subtotal = invoiceItems.Sum(i => i.Quantity * i.UnitPrice);
            newInvoice.Subtotal = subtotal;
            newInvoice.Tax = subtotal * (newInvoice.TaxRate / 100);
            newInvoice.TotalAmount = subtotal + newInvoice.Tax;
            newInvoice.BalanceDue = newInvoice.TotalAmount;

            // Create line items list
            var items = invoiceItems.Select(i => (i.Description, i.Quantity, i.UnitPrice)).ToList();

            await InvoiceService.CreateInvoiceAsync(newInvoice, items);
            await LoadData();
            HideCreateForm();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating invoice: {ex.Message}");
        }
    }

    private async Task ViewInvoice(SaaSInvoice invoice)
    {
        viewInvoice = await InvoiceService.GetInvoiceByIdAsync(invoice.InvoiceId);
    }

    private void CloseInvoiceView()
    {
        viewInvoice = null;
    }

    private async Task SendInvoice(int invoiceId)
    {
        await InvoiceService.SendInvoiceAsync(invoiceId);
        await LoadData();
        if (viewInvoice?.InvoiceId == invoiceId)
        {
            viewInvoice = await InvoiceService.GetInvoiceByIdAsync(invoiceId);
        }
    }

    private async Task MarkAsPaid(int invoiceId)
    {
        var invoice = await InvoiceService.GetInvoiceByIdAsync(invoiceId);
        if (invoice != null)
        {
            await InvoiceService.RecordPaymentAsync(invoiceId, invoice.AmountDue);
        }
        await LoadData();
        CloseInvoiceView();
    }

    private async Task CancelInvoice(int invoiceId)
    {
        await InvoiceService.CancelInvoiceAsync(invoiceId);
        await LoadData();
        CloseInvoiceView();
    }
}