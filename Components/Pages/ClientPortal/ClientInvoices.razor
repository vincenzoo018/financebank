@page "/client/invoices"
@layout MainLayout

<div class="client-invoices">
    <!-- Header -->
    <div class="page-header">
        <div class="header-left">
            <h2>My Invoices</h2>
            <span class="subtitle">View and download your invoices</span>
        </div>
        <div class="header-right">
            <select class="filter-select" @bind="statusFilter">
                <option value="">All Status</option>
                <option value="Pending">Pending</option>
                <option value="Paid">Paid</option>
                <option value="Overdue">Overdue</option>
            </select>
        </div>
    </div>

    <!-- Stats -->
    <div class="stats-row">
        <div class="stat-card pending">
            <span class="stat-value">₱@invoices.Where(i => i.Status == "Pending").Sum(i => i.Amount).ToString("N0")</span>
            <span class="stat-label">Pending Payment</span>
        </div>
        <div class="stat-card paid">
            <span class="stat-value">₱@invoices.Where(i => i.Status == "Paid").Sum(i => i.Amount).ToString("N0")</span>
            <span class="stat-label">Total Paid</span>
        </div>
        <div class="stat-card overdue">
            <span class="stat-value">@invoices.Count(i => i.Status == "Overdue")</span>
            <span class="stat-label">Overdue</span>
        </div>
    </div>

    <!-- Invoices List -->
    <div class="invoices-list">
        @foreach (var invoice in FilteredInvoices)
        {
            <div class="invoice-card">
                <div class="invoice-left">
                    <div class="invoice-icon @invoice.Status.ToLower()">📄</div>
                </div>
                <div class="invoice-main">
                    <div class="invoice-header">
                        <h4>@invoice.InvoiceNumber</h4>
                        <span class="status @invoice.Status.ToLower()">@invoice.Status</span>
                    </div>
                    <p class="invoice-description">@invoice.Description</p>
                    <div class="invoice-meta">
                        <span>📅 Issue Date: @invoice.IssueDate.ToString("MMM dd, yyyy")</span>
                        <span>⏰ Due Date: @invoice.DueDate.ToString("MMM dd, yyyy")</span>
                        @if (invoice.Status == "Paid")
                        {
                            <span>✅ Paid: @invoice.PaidDate?.ToString("MMM dd, yyyy")</span>
                        }
                    </div>
                </div>
                <div class="invoice-right">
                    <div class="invoice-amount">
                        <span class="amount">₱@invoice.Amount.ToString("N2")</span>
                    </div>
                    <div class="invoice-actions">
                        <button class="btn btn-primary btn-sm" @onclick="() => ViewInvoice(invoice)">👁️ View</button>
                        <button class="btn btn-secondary btn-sm" @onclick="() => DownloadPdf(invoice)">📥 PDF</button>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- View Invoice Modal -->
    @if (showViewModal && selectedInvoice != null)
    {
        <div class="modal-overlay" @onclick="CloseModal">
            <div class="modal-content large" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h3>Invoice @selectedInvoice.InvoiceNumber</h3>
                    <div class="header-actions">
                        <button class="btn btn-secondary btn-sm" @onclick="() => PrintInvoice(selectedInvoice)">🖨️ Print</button>
                        <button class="btn btn-secondary btn-sm" @onclick="() => DownloadPdf(selectedInvoice)">📥 Download PDF</button>
                        <button class="close-btn" @onclick="CloseModal">✕</button>
                    </div>
                </div>
                <div class="modal-body">
                    <div class="invoice-preview">
                        <!-- Invoice Header -->
                        <div class="preview-header">
                            <div class="company-info">
                                <h2>FineBank Software Solutions</h2>
                                <p>123 Business Park, Makati City</p>
                                <p>Metro Manila, Philippines 1200</p>
                                <p>TIN: 123-456-789-000</p>
                            </div>
                            <div class="invoice-info">
                                <h1>INVOICE</h1>
                                <div class="info-row">
                                    <span>Invoice #:</span>
                                    <strong>@selectedInvoice.InvoiceNumber</strong>
                                </div>
                                <div class="info-row">
                                    <span>Issue Date:</span>
                                    <strong>@selectedInvoice.IssueDate.ToString("MMM dd, yyyy")</strong>
                                </div>
                                <div class="info-row">
                                    <span>Due Date:</span>
                                    <strong>@selectedInvoice.DueDate.ToString("MMM dd, yyyy")</strong>
                                </div>
                                <div class="info-row status">
                                    <span>Status:</span>
                                    <strong class="@selectedInvoice.Status.ToLower()">@selectedInvoice.Status</strong>
                                </div>
                            </div>
                        </div>

                        <!-- Bill To -->
                        <div class="bill-to">
                            <h4>Bill To:</h4>
                            <p><strong>@clientName</strong></p>
                            <p>123 Client Address, City</p>
                            <p>client@example.com</p>
                        </div>

                        <!-- Line Items -->
                        <table class="items-table">
                            <thead>
                                <tr>
                                    <th>Description</th>
                                    <th>Qty</th>
                                    <th>Rate</th>
                                    <th>Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in selectedInvoice.Items)
                                {
                                    <tr>
                                        <td>@item.Description</td>
                                        <td>@item.Quantity</td>
                                        <td>₱@item.Rate.ToString("N2")</td>
                                        <td>₱@item.Amount.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <!-- Totals -->
                        <div class="invoice-totals">
                            <div class="total-row">
                                <span>Subtotal:</span>
                                <span>₱@selectedInvoice.Subtotal.ToString("N2")</span>
                            </div>
                            <div class="total-row">
                                <span>VAT (12%):</span>
                                <span>₱@selectedInvoice.Tax.ToString("N2")</span>
                            </div>
                            <div class="total-row grand">
                                <span>Total Due:</span>
                                <span>₱@selectedInvoice.Amount.ToString("N2")</span>
                            </div>
                        </div>

                        <!-- Payment Info -->
                        <div class="payment-info">
                            <h4>Payment Methods:</h4>
                            <div class="payment-options">
                                <div class="payment-option">
                                    <strong>GCash:</strong> 0917-123-4567 (FineBank Solutions)
                                </div>
                                <div class="payment-option">
                                    <strong>BDO:</strong> 1234-5678-9012 (FineBank Solutions Inc.)
                                </div>
                                <div class="payment-option">
                                    <strong>BPI:</strong> 9876-5432-1098 (FineBank Solutions Inc.)
                                </div>
                            </div>
                            <p class="note">Please send payment proof via support ticket or email after payment.</p>
                        </div>

                        @if (selectedInvoice.Status == "Paid")
                        {
                            <div class="paid-stamp">
                                <span>PAID</span>
                                <span class="date">@selectedInvoice.PaidDate?.ToString("MMM dd, yyyy")</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .client-invoices { padding: 0; }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .header-left h2 { font-size: 24px; font-weight: 700; color: #1f2937; margin: 0; }
    .header-left .subtitle { font-size: 14px; color: #6b7280; }

    .filter-select {
        padding: 10px 16px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        font-size: 14px;
        background: white;
    }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        border-top: 4px solid;
    }

    .stat-card.pending { border-color: #f59e0b; }
    .stat-card.paid { border-color: #10b981; }
    .stat-card.overdue { border-color: #ef4444; }

    .stat-value { display: block; font-size: 28px; font-weight: 700; color: #1f2937; }
    .stat-label { font-size: 13px; color: #6b7280; }

    .invoices-list { display: flex; flex-direction: column; gap: 12px; }

    .invoice-card {
        display: flex;
        gap: 16px;
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        transition: all 0.2s;
    }

    .invoice-card:hover {
        box-shadow: 0 4px 16px rgba(0,0,0,0.1);
    }

    .invoice-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .invoice-icon.pending { background: #fef3c7; }
    .invoice-icon.paid { background: #d1fae5; }
    .invoice-icon.overdue { background: #fee2e2; }

    .invoice-main { flex: 1; }

    .invoice-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 8px;
    }

    .invoice-header h4 { margin: 0; font-size: 16px; font-weight: 600; }

    .status {
        font-size: 11px;
        padding: 4px 10px;
        border-radius: 20px;
        font-weight: 500;
    }

    .status.pending { background: #fef3c7; color: #92400e; }
    .status.paid { background: #d1fae5; color: #059669; }
    .status.overdue { background: #fee2e2; color: #dc2626; }

    .invoice-description {
        font-size: 14px;
        color: #4b5563;
        margin: 0 0 12px 0;
    }

    .invoice-meta {
        display: flex;
        gap: 24px;
        font-size: 13px;
        color: #6b7280;
    }

    .invoice-right {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 12px;
    }

    .invoice-amount .amount {
        font-size: 24px;
        font-weight: 700;
        color: #1f2937;
    }

    .invoice-actions { display: flex; gap: 8px; }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 500;
        cursor: pointer;
        border: none;
        transition: all 0.2s;
    }

    .btn-primary { background: linear-gradient(135deg, #6366f1, #8b5cf6); color: white; }
    .btn-secondary { background: #f3f4f6; color: #374151; }
    .btn-sm { padding: 8px 14px; font-size: 13px; }

    /* Modal */
    .modal-overlay {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .modal-content {
        background: white;
        border-radius: 16px;
        width: 90%;
        max-width: 800px;
        max-height: 90vh;
        overflow: auto;
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 24px;
        border-bottom: 1px solid #e5e7eb;
    }

    .modal-header h3 { margin: 0; font-size: 18px; }
    .header-actions { display: flex; gap: 8px; align-items: center; }
    .close-btn { background: none; border: none; font-size: 20px; cursor: pointer; color: #6b7280; margin-left: 12px; }
    .modal-body { padding: 24px; }

    /* Invoice Preview */
    .invoice-preview {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 32px;
        position: relative;
    }

    .preview-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 32px;
    }

    .company-info h2 { margin: 0; color: #6366f1; font-size: 20px; }
    .company-info p { margin: 4px 0 0 0; font-size: 13px; color: #6b7280; }

    .invoice-info { text-align: right; }
    .invoice-info h1 { margin: 0; font-size: 28px; color: #1f2937; }
    .invoice-info .info-row { display: flex; justify-content: flex-end; gap: 8px; margin-top: 4px; font-size: 13px; }
    .invoice-info .info-row span { color: #6b7280; }
    .invoice-info .info-row strong { color: #1f2937; }
    .invoice-info .status strong.pending { color: #f59e0b; }
    .invoice-info .status strong.paid { color: #10b981; }

    .bill-to {
        margin-bottom: 24px;
        padding: 16px;
        background: #f9fafb;
        border-radius: 8px;
    }

    .bill-to h4 { margin: 0 0 8px 0; font-size: 13px; color: #6b7280; }
    .bill-to p { margin: 4px 0; font-size: 14px; color: #374151; }

    .items-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 24px;
    }

    .items-table th {
        text-align: left;
        padding: 12px;
        background: #f9fafb;
        font-size: 13px;
        font-weight: 600;
        color: #374151;
        border-bottom: 2px solid #e5e7eb;
    }

    .items-table td {
        padding: 12px;
        font-size: 14px;
        border-bottom: 1px solid #f3f4f6;
    }

    .invoice-totals {
        width: 300px;
        margin-left: auto;
        margin-bottom: 24px;
    }

    .total-row {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        font-size: 14px;
    }

    .total-row.grand {
        border-top: 2px solid #e5e7eb;
        padding-top: 12px;
        font-size: 18px;
        font-weight: 700;
        color: #1f2937;
    }

    .payment-info {
        padding: 16px;
        background: #f5f3ff;
        border-radius: 8px;
    }

    .payment-info h4 { margin: 0 0 12px 0; font-size: 14px; color: #6366f1; }
    .payment-options { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 12px; }
    .payment-option { font-size: 13px; color: #374151; }
    .payment-info .note { font-size: 12px; color: #6b7280; margin: 0; font-style: italic; }

    .paid-stamp {
        position: absolute;
        top: 50%;
        right: 40px;
        transform: rotate(-15deg) translateY(-50%);
        border: 4px solid #10b981;
        border-radius: 12px;
        padding: 16px 32px;
        color: #10b981;
        text-align: center;
        opacity: 0.3;
    }

    .paid-stamp span:first-child {
        display: block;
        font-size: 36px;
        font-weight: 800;
    }

    .paid-stamp .date { font-size: 14px; }
</style>

