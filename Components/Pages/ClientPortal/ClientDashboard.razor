@page "/client"
@page "/client/dashboard"
@layout MainLayout

<div class="client-dashboard">
    <!-- Welcome Header -->
    <div class="welcome-header">
        <div class="welcome-text">
            <h2>Welcome back, @clientName!</h2>
            <p>Here's your subscription overview</p>
        </div>
        <div class="subscription-badge">
            <span class="plan-name">@subscription.PlanName</span>
            <span class="plan-status @subscription.StatusClass">@subscription.Status</span>
        </div>
    </div>

    <!-- Subscription Card -->
    <div class="subscription-card">
        <div class="sub-header">
            <div class="sub-icon">📋</div>
            <div class="sub-title">
                <h3>Current Subscription</h3>
                <p>@subscription.PlanName Plan</p>
            </div>
            <div class="sub-period">
                <span class="label">Billing Period</span>
                <span class="value">@subscription.BillingCycle</span>
            </div>
        </div>
        <div class="sub-details">
            <div class="detail-item">
                <span class="detail-icon">📅</span>
                <div class="detail-info">
                    <span class="label">Next Renewal</span>
                    <span class="value">@subscription.NextRenewal.ToString("MMM dd, yyyy")</span>
                </div>
            </div>
            <div class="detail-item">
                <span class="detail-icon">💰</span>
                <div class="detail-info">
                    <span class="label">Monthly Rate</span>
                    <span class="value">₱@subscription.MonthlyRate.ToString("N2")</span>
                </div>
            </div>
            <div class="detail-item">
                <span class="detail-icon">👥</span>
                <div class="detail-info">
                    <span class="label">Users</span>
                    <span class="value">@subscription.UsersUsed / @subscription.MaxUsers</span>
                </div>
            </div>
            <div class="detail-item">
                <span class="detail-icon">🏢</span>
                <div class="detail-info">
                    <span class="label">Branches</span>
                    <span class="value">@subscription.BranchesUsed / @subscription.MaxBranches</span>
                </div>
            </div>
        </div>
        <div class="sub-progress">
            <div class="progress-header">
                <span>Days until renewal</span>
                <span>@subscription.DaysRemaining days</span>
            </div>
            <div class="progress-bar">
                <div class="progress-fill" style="width: @(100 - (subscription.DaysRemaining * 100 / 30))%;"></div>
            </div>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-icon pending">📄</div>
            <div class="stat-info">
                <span class="stat-value">@pendingInvoices</span>
                <span class="stat-label">Pending Invoices</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon success">✅</div>
            <div class="stat-info">
                <span class="stat-value">₱@totalPaid.ToString("N0")</span>
                <span class="stat-label">Total Paid</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon info">🎫</div>
            <div class="stat-info">
                <span class="stat-value">@openTickets</span>
                <span class="stat-label">Open Tickets</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon modules">📦</div>
            <div class="stat-info">
                <span class="stat-value">@activeModules</span>
                <span class="stat-label">Active Modules</span>
            </div>
        </div>
    </div>

    <!-- Two Column Layout -->
    <div class="dashboard-grid">
        <!-- Recent Invoices -->
        <div class="dashboard-card">
            <div class="card-header">
                <h3>📄 Recent Invoices</h3>
                <a href="/client/invoices" class="view-all">View All →</a>
            </div>
            <div class="card-content">
                @foreach (var invoice in recentInvoices)
                {
                    <div class="invoice-item">
                        <div class="invoice-info">
                            <span class="invoice-number">@invoice.InvoiceNumber</span>
                            <span class="invoice-date">@invoice.DueDate.ToString("MMM dd, yyyy")</span>
                        </div>
                        <div class="invoice-amount">
                            <span class="amount">₱@invoice.Amount.ToString("N2")</span>
                            <span class="status @invoice.StatusClass">@invoice.Status</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Active Modules -->
        <div class="dashboard-card">
            <div class="card-header">
                <h3>📦 Your Modules</h3>
            </div>
            <div class="card-content modules-grid">
                @foreach (var module in modules)
                {
                    <div class="module-item @(module.IsActive ? "" : "inactive")">
                        <span class="module-icon">@module.Icon</span>
                        <span class="module-name">@module.Name</span>
                        @if (!module.IsActive)
                        {
                            <span class="module-badge">Add-on</span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Payment Methods Info -->
    <div class="payment-info-card">
        <div class="card-header">
            <h3>💳 Payment Information</h3>
        </div>
        <div class="card-content">
            <p class="payment-note">To pay your invoices, please send payment to any of these accounts and contact support with your payment receipt:</p>
            <div class="payment-methods-grid">
                @foreach (var method in paymentMethods)
                {
                    <div class="payment-method">
                        <div class="method-icon" style="background: @method.Color;">@method.Icon</div>
                        <div class="method-details">
                            <span class="method-name">@method.Name</span>
                            <span class="method-account">@method.AccountNumber</span>
                            <span class="method-holder">@method.AccountName</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .client-dashboard { padding: 0; }

    .welcome-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .welcome-text h2 { font-size: 24px; font-weight: 700; color: #1f2937; margin: 0; }
    .welcome-text p { font-size: 14px; color: #6b7280; margin: 4px 0 0 0; }

    .subscription-badge {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .plan-name {
        font-size: 14px;
        font-weight: 600;
        color: #6366f1;
        padding: 8px 16px;
        background: #f5f3ff;
        border-radius: 8px;
    }

    .plan-status {
        font-size: 12px;
        font-weight: 500;
        padding: 6px 12px;
        border-radius: 20px;
    }

    .plan-status.active { background: #d1fae5; color: #059669; }
    .plan-status.trial { background: #fef3c7; color: #92400e; }

    .subscription-card {
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        border-radius: 16px;
        padding: 24px;
        color: white;
        margin-bottom: 24px;
    }

    .sub-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
    }

    .sub-icon {
        font-size: 32px;
        width: 56px;
        height: 56px;
        background: rgba(255,255,255,0.2);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .sub-title { flex: 1; }
    .sub-title h3 { margin: 0; font-size: 18px; font-weight: 600; }
    .sub-title p { margin: 4px 0 0 0; opacity: 0.8; font-size: 14px; }

    .sub-period {
        text-align: right;
    }

    .sub-period .label { font-size: 12px; opacity: 0.8; display: block; }
    .sub-period .value { font-size: 16px; font-weight: 600; }

    .sub-details {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 20px;
    }

    .detail-item {
        display: flex;
        align-items: center;
        gap: 12px;
        background: rgba(255,255,255,0.15);
        padding: 12px 16px;
        border-radius: 10px;
    }

    .detail-icon { font-size: 20px; }
    .detail-info { display: flex; flex-direction: column; }
    .detail-info .label { font-size: 11px; opacity: 0.8; }
    .detail-info .value { font-size: 15px; font-weight: 600; }

    .sub-progress {
        background: rgba(255,255,255,0.15);
        padding: 12px 16px;
        border-radius: 10px;
    }

    .progress-header {
        display: flex;
        justify-content: space-between;
        font-size: 13px;
        margin-bottom: 8px;
    }

    .progress-bar {
        height: 8px;
        background: rgba(255,255,255,0.3);
        border-radius: 4px;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        background: white;
        border-radius: 4px;
    }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 16px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .stat-icon.pending { background: #fef3c7; }
    .stat-icon.success { background: #d1fae5; }
    .stat-icon.info { background: #dbeafe; }
    .stat-icon.modules { background: #f3e8ff; }

    .stat-info { display: flex; flex-direction: column; }
    .stat-value { font-size: 24px; font-weight: 700; color: #1f2937; }
    .stat-label { font-size: 13px; color: #6b7280; }

    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
        margin-bottom: 24px;
    }

    .dashboard-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        overflow: hidden;
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 20px;
        border-bottom: 1px solid #f3f4f6;
    }

    .card-header h3 { margin: 0; font-size: 16px; font-weight: 600; }
    .view-all { font-size: 13px; color: #6366f1; text-decoration: none; }

    .card-content { padding: 16px 20px; }

    .invoice-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid #f3f4f6;
    }

    .invoice-item:last-child { border-bottom: none; }

    .invoice-info { display: flex; flex-direction: column; }
    .invoice-number { font-size: 14px; font-weight: 500; color: #1f2937; }
    .invoice-date { font-size: 12px; color: #6b7280; }

    .invoice-amount { display: flex; flex-direction: column; align-items: flex-end; }
    .amount { font-size: 14px; font-weight: 600; color: #1f2937; }
    .status { font-size: 11px; padding: 4px 8px; border-radius: 12px; font-weight: 500; }
    .status.paid { background: #d1fae5; color: #059669; }
    .status.pending { background: #fef3c7; color: #92400e; }
    .status.overdue { background: #fee2e2; color: #dc2626; }

    .modules-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .module-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px;
        background: #f9fafb;
        border-radius: 8px;
        font-size: 14px;
    }

    .module-item.inactive { opacity: 0.5; }
    .module-icon { font-size: 18px; }
    .module-name { flex: 1; }
    .module-badge {
        font-size: 10px;
        padding: 2px 6px;
        background: #e5e7eb;
        border-radius: 4px;
        color: #6b7280;
    }

    .payment-info-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .payment-note {
        font-size: 14px;
        color: #6b7280;
        margin: 0 0 16px 0;
    }

    .payment-methods-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
    }

    .payment-method {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px;
        background: #f9fafb;
        border-radius: 12px;
    }

    .method-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .method-details { display: flex; flex-direction: column; }
    .method-name { font-size: 14px; font-weight: 600; color: #1f2937; }
    .method-account { font-size: 13px; color: #6366f1; font-weight: 500; }
    .method-holder { font-size: 11px; color: #6b7280; }
</style>

@code {
    private string clientName = "FineBank Corporation";
    private SubscriptionData subscription = new();
    private int pendingInvoices = 1;
    private decimal totalPaid = 35994m;
    private int openTickets = 2;
    private int activeModules = 6;
    private List<InvoiceData> recentInvoices = new();
    private List<ModuleData> modules = new();
    private List<PaymentMethodData> paymentMethods = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadSampleData();
    }

    private async Task LoadSampleData()
    {
        await Task.Delay(100);

        subscription = new SubscriptionData
        {
            PlanName = "Professional",
            Status = "Active",
            StatusClass = "active",
            BillingCycle = "Monthly",
            NextRenewal = DateTime.Now.AddDays(18),
            MonthlyRate = 5999,
            UsersUsed = 8,
            MaxUsers = 15,
            BranchesUsed = 2,
            MaxBranches = 3,
            DaysRemaining = 18
        };

        recentInvoices = new List<InvoiceData>
        {
            new InvoiceData { InvoiceNumber = "INV-2025-0018", DueDate = DateTime.Now.AddDays(12), Amount = 5999, Status = "Pending", StatusClass = "pending" },
            new InvoiceData { InvoiceNumber = "INV-2025-0012", DueDate = DateTime.Now.AddDays(-18), Amount = 5999, Status = "Paid", StatusClass = "paid" },
            new InvoiceData { InvoiceNumber = "INV-2025-0006", DueDate = DateTime.Now.AddDays(-48), Amount = 5999, Status = "Paid", StatusClass = "paid" }
        };

        modules = new List<ModuleData>
        {
            new ModuleData { Name = "Core System", Icon = "⚙️", IsActive = true },
            new ModuleData { Name = "Teller", Icon = "💳", IsActive = true },
            new ModuleData { Name = "Savings", Icon = "🏦", IsActive = true },
            new ModuleData { Name = "Loans", Icon = "💰", IsActive = true },
            new ModuleData { Name = "General Ledger", Icon = "📊", IsActive = true },
            new ModuleData { Name = "Reports", Icon = "📈", IsActive = true },
            new ModuleData { Name = "SMS Alerts", Icon = "📱", IsActive = false },
            new ModuleData { Name = "Mobile App", Icon = "📲", IsActive = false }
        };

        paymentMethods = new List<PaymentMethodData>
        {
            new PaymentMethodData { Name = "GCash", Icon = "📱", Color = "#0d6efd", AccountNumber = "0917-123-4567", AccountName = "FineBank Solutions" },
            new PaymentMethodData { Name = "PayMaya", Icon = "💳", Color = "#10b981", AccountNumber = "0918-765-4321", AccountName = "FineBank Solutions" },
            new PaymentMethodData { Name = "BDO", Icon = "🏦", Color = "#0066a1", AccountNumber = "1234-5678-9012", AccountName = "FineBank Solutions Inc." },
            new PaymentMethodData { Name = "BPI", Icon = "🏛️", Color = "#a51c30", AccountNumber = "9876-5432-1098", AccountName = "FineBank Solutions Inc." }
        };
    }

    private class SubscriptionData
    {
        public string PlanName { get; set; } = "";
        public string Status { get; set; } = "";
        public string StatusClass { get; set; } = "";
        public string BillingCycle { get; set; } = "";
        public DateTime NextRenewal { get; set; }
        public decimal MonthlyRate { get; set; }
        public int UsersUsed { get; set; }
        public int MaxUsers { get; set; }
        public int BranchesUsed { get; set; }
        public int MaxBranches { get; set; }
        public int DaysRemaining { get; set; }
    }

    private class InvoiceData
    {
        public string InvoiceNumber { get; set; } = "";
        public DateTime DueDate { get; set; }
        public decimal Amount { get; set; }
        public string Status { get; set; } = "";
        public string StatusClass { get; set; } = "";
    }

    private class ModuleData
    {
        public string Name { get; set; } = "";
        public string Icon { get; set; } = "";
        public bool IsActive { get; set; }
    }

    private class PaymentMethodData
    {
        public string Name { get; set; } = "";
        public string Icon { get; set; } = "";
        public string Color { get; set; } = "";
        public string AccountNumber { get; set; } = "";
        public string AccountName { get; set; } = "";
    }
}
