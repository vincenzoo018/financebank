@page "/teller/asset-history"
@layout TellerLayout
@using FinanceBank.Models
@using FinanceBank.Services
@using FinanceBank.Data
@using Microsoft.EntityFrameworkCore
@inject AssetMarketplaceService AssetService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IDbContextFactory<BFASDbContext> DbContextFactory

<div class="sidebar-content">
    <div class="card">
        <div class="card-header" style="background: #2F3E2A; color: white; padding: 20px;">
            <h4 style="margin: 0; font-weight: 500;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    style="margin-right: 8px; vertical-align: middle;">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                Asset Application History
            </h4>
            <p style="margin: 8px 0 0 0; opacity: 0.9; font-size: 14px;">View all forwarded and released asset
                applications with contracts</p>
        </div>

        <div class="card-body" style="padding: 24px;">
            <!-- Filter Section -->
            <div style="background: #F7F7F4; padding: 20px; border-radius: 14px; margin-bottom: 24px;">
                <h6 style="margin: 0 0 16px 0; color: #2B2B2B; font-weight: 500;">🔍 Filter History</h6>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px;">
                    <div>
                        <label style="font-size: 13px; color: #6B6B6B; display: block; margin-bottom: 4px;">Action
                            Type</label>
                        <select @bind="filterActionType"
                            style="width: 100%; padding: 10px; border: 1px solid #E2E2DC; border-radius: 10px; font-size: 14px;">
                            <option value="">All Actions</option>
                            <option value="FORWARDED_TO_ACCOUNTANT">📤 Forwarded to Accountant</option>
                            <option value="FORWARDED_TO_FINANCEMANAGER">📤 Forwarded to Finance Manager</option>
                            <option value="APPROVED">✅ Approved</option>
                            <option value="RELEASED">🎉 Released</option>
                            <option value="REJECTED">❌ Rejected</option>
                        </select>
                    </div>
                    <div>
                        <label style="font-size: 13px; color: #6B6B6B; display: block; margin-bottom: 4px;">From
                            Date</label>
                        <input type="date" @bind="filterFromDate"
                            style="width: 100%; padding: 10px; border: 1px solid #E2E2DC; border-radius: 10px; font-size: 14px;" />
                    </div>
                    <div>
                        <label style="font-size: 13px; color: #6B6B6B; display: block; margin-bottom: 4px;">To
                            Date</label>
                        <input type="date" @bind="filterToDate"
                            style="width: 100%; padding: 10px; border: 1px solid #E2E2DC; border-radius: 10px; font-size: 14px;" />
                    </div>
                </div>
                <div style="margin-top: 16px; display: flex; gap: 12px;">
                    <button @onclick="ApplyFilters"
                        style="padding: 10px 24px; background: #2F3E2A; color: white; border: none; border-radius: 10px; cursor: pointer; font-weight: 500;">
                        Apply Filters
                    </button>
                    <button @onclick="ClearFilters"
                        style="padding: 10px 24px; background: #A9B388; color: #2F3E2A; border: none; border-radius: 10px; cursor: pointer; font-weight: 500;">
                        Clear
                    </button>
                </div>
            </div>

            <!-- Quick Stats -->
            <div
                style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 16px; margin-bottom: 24px;">
                <div
                    style="background: rgba(79, 111, 82, 0.15); padding: 16px; border-radius: 14px; text-align: center;">
                    <div style="font-size: 24px; font-weight: 600; color: #4F6F52;">@forwardedCount</div>
                    <div style="font-size: 12px; color: #4F6F52;">📤 Forwarded</div>
                </div>
                <div
                    style="background: rgba(79, 111, 82, 0.15); padding: 16px; border-radius: 14px; text-align: center;">
                    <div style="font-size: 24px; font-weight: 600; color: #4F6F52;">@approvedCount</div>
                    <div style="font-size: 12px; color: #4F6F52;">✅ Approved</div>
                </div>
                <div
                    style="background: rgba(95, 122, 106, 0.15); padding: 16px; border-radius: 14px; text-align: center;">
                    <div style="font-size: 24px; font-weight: 600; color: #5F7A6A;">@releasedCount</div>
                    <div style="font-size: 12px; color: #5F7A6A;">🎉 Released</div>
                </div>
                <div
                    style="background: rgba(155, 58, 58, 0.15); padding: 16px; border-radius: 14px; text-align: center;">
                    <div style="font-size: 24px; font-weight: 600; color: #9B3A3A;">@rejectedCount</div>
                    <div style="font-size: 12px; color: #9B3A3A;">❌ Rejected</div>
                </div>
            </div>

            @if (isLoading)
            {
                <div style="text-align: center; padding: 40px;">
                    <div
                        style="width: 40px; height: 40px; border: 3px solid #E2E2DC; border-top-color: #2F3E2A; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto;">
                    </div>
                    <p style="margin-top: 16px; color: #6B6B6B;">Loading history...</p>
                </div>
            }
            else if (historyList == null || historyList.Count == 0)
            {
                <div style="text-align: center; padding: 60px 20px; background: #F7F7F4; border-radius: 14px;">
                    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#E2E2DC" stroke-width="1.5"
                        style="margin: 0 auto;">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <h5 style="color: #6B6B6B; margin-top: 16px;">No History Found</h5>
                    <p style="color: #6B6B6B; font-size: 14px;">No workflow events match your filters.</p>
                </div>
            }
            else
            {
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="background: #F7F7F4; border-bottom: 2px solid #E2E2DC;">
                                <th style="padding: 12px; text-align: left; font-weight: 500; color: #2B2B2B;">Date/Time
                                </th>
                                <th style="padding: 12px; text-align: left; font-weight: 500; color: #2B2B2B;">Application
                                </th>
                                <th style="padding: 12px; text-align: left; font-weight: 500; color: #2B2B2B;">Asset</th>
                                <th style="padding: 12px; text-align: center; font-weight: 500; color: #2B2B2B;">Action</th>
                                <th style="padding: 12px; text-align: left; font-weight: 500; color: #2B2B2B;">By</th>
                                <th style="padding: 12px; text-align: left; font-weight: 500; color: #2B2B2B;">Contract</th>
                                <th style="padding: 12px; text-align: right; font-weight: 500; color: #2B2B2B;">Amount</th>
                                <th style="padding: 12px; text-align: center; font-weight: 500; color: #2B2B2B;">Details
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var history in historyList)
                            {
                                <tr style="border-bottom: 1px solid #E2E2DC; transition: background 0.2s;"
                                    class="table-row-hover">
                                    <td style="padding: 14px 12px;">
                                        <div style="font-weight: 500; color: #2B2B2B;">@history.ActionDate.ToString("MMM dd, yyyy")</div>
                                        <div style="font-size: 12px; color: #6B6B6B;">@history.ActionDate.ToString("hh:mm tt")
                                        </div>
                                    </td>
                                    <td style="padding: 14px 12px;">
                                        <span
                                            style="background: rgba(79, 111, 82, 0.15); color: #4F6F52; padding: 4px 10px; border-radius: 10px; font-weight: 500; font-size: 11px;">
                                            @history.Application?.ApplicationNumber
                                        </span>
                                    </td>
                                    <td style="padding: 14px 12px;">
                                        <div style="font-weight: 500; color: #2B2B2B; font-size: 13px;">
                                            @(history.Application?.Asset?.DisplayTitle ?? "N/A")</div>
                                        <div style="font-size: 11px; color: #6B6B6B;">@history.Application?.Asset?.AssetType
                                        </div>
                                    </td>
                                    <td style="padding: 14px 12px; text-align: center;">
                                        @{
                                            var (actionColor, actionBg, actionIcon) = GetActionStyle(history.ActionType);
                                        }
                                        <span
                                            style="background: @actionBg; color: @actionColor; padding: 5px 12px; border-radius: 16px; font-size: 11px; font-weight: 600;">
                                            @actionIcon @GetActionLabel(history.ActionType)
                                        </span>
                                    </td>
                                    <td style="padding: 14px 12px;">
                                        <div style="font-weight: 500; color: #2B2B2B; font-size: 13px;">@history.ActionBy</div>
                                        <div style="font-size: 11px; color: #6B6B6B;">@history.ActionByRole</div>
                                    </td>
                                    <td style="padding: 14px 12px;">
                                        @if (!string.IsNullOrEmpty(history.ContractNumber))
                                        {
                                            <div style="font-weight: 500; color: #4F6F52; font-size: 13px;">@history.ContractNumber
                                            </div>
                                            <div style="font-size: 11px; color: #6B6B6B;">
                                                @history.ContractDate?.ToString("MM/dd/yyyy")</div>
                                        }
                                        else
                                        {
                                            <span style="color: #6B6B6B; font-size: 12px;">-</span>
                                        }
                                    </td>
                                    <td style="padding: 14px 12px; text-align: right;">
                                        @if (history.AssetPrice > 0)
                                        {
                                            <div style="font-weight: 600; color: #2B2B2B;">₱@history.AssetPrice?.ToString("N2")
                                            </div>
                                        }
                                        else
                                        {
                                            <span style="color: #6B6B6B;">-</span>
                                        }
                                    </td>
                                    <td style="padding: 14px 12px; text-align: center;">
                                        <button @onclick="() => ShowHistoryDetails(history)"
                                            style="padding: 6px 14px; background: #2F3E2A; color: white; border: none; border-radius: 10px; cursor: pointer; font-size: 12px; font-weight: 500;">
                                            View
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- History Details Modal -->
@if (showDetailsModal && selectedHistory != null)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(47, 62, 42, 0.6); display: flex; align-items: center; justify-content: center; z-index: 1000;"
        @onclick="CloseModal">
        <div style="background: #FFFFFF; border-radius: 16px; width: 90%; max-width: 650px; max-height: 90vh; overflow-y: auto; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);"
            @onclick:stopPropagation>
            <div
                style="padding: 20px; border-bottom: 1px solid #E2E2DC; background: #2F3E2A; border-radius: 16px 16px 0 0;">
                <h4 style="margin: 0; color: white; font-weight: 500;">📜 History Details</h4>
                <p style="margin: 8px 0 0 0; color: rgba(255,255,255,0.9); font-size: 14px;">
                    @selectedHistory.Application?.ApplicationNumber</p>
            </div>

            <div style="padding: 24px;">
                <!-- Action Info -->
                <div style="background: #F7F7F4; padding: 16px; border-radius: 14px; margin-bottom: 16px;">
                    <h6 style="margin: 0 0 12px 0; color: #2B2B2B; font-weight: 500; font-size: 14px;">Action Information
                    </h6>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        <div>
                            <label style="font-size: 11px; color: #6B6B6B; text-transform: uppercase;">Action Type</label>
                            <div style="font-weight: 500; color: #2B2B2B; margin-top: 2px; font-size: 14px;">
                                @GetActionLabel(selectedHistory.ActionType)</div>
                        </div>
                        <div>
                            <label style="font-size: 11px; color: #6B6B6B; text-transform: uppercase;">Date & Time</label>
                            <div style="font-weight: 500; color: #2B2B2B; margin-top: 2px; font-size: 14px;">
                                @selectedHistory.ActionDate.ToString("MMM dd, yyyy hh:mm tt")</div>
                        </div>
                        <div>
                            <label style="font-size: 11px; color: #6B6B6B; text-transform: uppercase;">Performed By</label>
                            <div style="font-weight: 500; color: #2B2B2B; margin-top: 2px; font-size: 14px;">
                                @selectedHistory.ActionBy (@selectedHistory.ActionByRole)</div>
                        </div>
                        <div>
                            <label style="font-size: 11px; color: #6B6B6B; text-transform: uppercase;">Status Change</label>
                            <div style="font-weight: 500; color: #2B2B2B; margin-top: 2px; font-size: 14px;">
                                @(selectedHistory.PreviousStatus ?? "-") → @(selectedHistory.NewStatus ?? "-")</div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(selectedHistory.Remarks))
                    {
                        <div style="margin-top: 12px;">
                            <label style="font-size: 11px; color: #6B6B6B; text-transform: uppercase;">Remarks</label>
                            <div
                                style="font-weight: 500; color: #2B2B2B; margin-top: 4px; padding: 10px; background: #FFFFFF; border-radius: 10px; border: 1px solid #E2E2DC; font-size: 13px;">
                                @selectedHistory.Remarks
                            </div>
                        </div>
                    }
                </div>

                <!-- Contract Info (if released) -->
                @if (!string.IsNullOrEmpty(selectedHistory.ContractNumber))
                {
                    <div
                        style="background: rgba(79, 111, 82, 0.15); padding: 16px; border-radius: 14px; margin-bottom: 16px; border: 1px solid rgba(79, 111, 82, 0.3);">
                        <h6 style="margin: 0 0 12px 0; color: #4F6F52; font-weight: 500; font-size: 14px;">📄 Contract
                            Information</h6>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                            <div>
                                <label style="font-size: 11px; color: #6B6B6B; text-transform: uppercase;">Contract
                                    Number</label>
                                <div style="font-weight: 600; color: #4F6F52; margin-top: 2px; font-size: 15px;">
                                    @selectedHistory.ContractNumber</div>
                            </div>
                            <div>
                                <label style="font-size: 11px; color: #6B6B6B; text-transform: uppercase;">Contract Date</label>
                                <div style="font-weight: 500; color: #2B2B2B; margin-top: 2px; font-size: 14px;">
                                    @selectedHistory.ContractDate?.ToString("MMM dd, yyyy")</div>
                            </div>
                            @if (!string.IsNullOrEmpty(selectedHistory.DeedOfSaleNumber))
                            {
                                <div>
                                    <label style="font-size: 11px; color: #6B6B6B; text-transform: uppercase;">Deed of Sale</label>
                                    <div style="font-weight: 500; color: #2B2B2B; margin-top: 2px; font-size: 14px;">
                                        @selectedHistory.DeedOfSaleNumber</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(selectedHistory.ORNumber))
                            {
                                <div>
                                    <label style="font-size: 11px; color: #6B6B6B; text-transform: uppercase;">OR Number</label>
                                    <div style="font-weight: 500; color: #2B2B2B; margin-top: 2px; font-size: 14px;">
                                        @selectedHistory.ORNumber</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(selectedHistory.CRNumber))
                            {
                                <div>
                                    <label style="font-size: 11px; color: #6B6B6B; text-transform: uppercase;">CR Number</label>
                                    <div style="font-weight: 500; color: #2B2B2B; margin-top: 2px; font-size: 14px;">
                                        @selectedHistory.CRNumber</div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Financial Details -->
                @if (selectedHistory.AssetPrice > 0)
                {
                    <div
                        style="background: rgba(196, 154, 58, 0.15); padding: 16px; border-radius: 14px; border: 1px solid rgba(196, 154, 58, 0.3);">
                        <h6 style="margin: 0 0 12px 0; color: #C49A3A; font-weight: 500; font-size: 14px;">💰 Financial Details
                        </h6>
                        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px;">
                            <div>
                                <label style="font-size: 11px; color: #6B6B6B; text-transform: uppercase;">Asset Price</label>
                                <div style="font-weight: 600; color: #2B2B2B; margin-top: 2px; font-size: 14px;">
                                    ₱@selectedHistory.AssetPrice?.ToString("N2")</div>
                            </div>
                            <div>
                                <label style="font-size: 11px; color: #6B6B6B; text-transform: uppercase;">Down Payment</label>
                                <div style="font-weight: 500; color: #2B2B2B; margin-top: 2px; font-size: 14px;">
                                    ₱@selectedHistory.DownPaymentAmount?.ToString("N2")</div>
                            </div>
                            <div>
                                <label style="font-size: 11px; color: #6B6B6B; text-transform: uppercase;">Loan Amount</label>
                                <div style="font-weight: 500; color: #2B2B2B; margin-top: 2px; font-size: 14px;">
                                    ₱@selectedHistory.LoanAmount?.ToString("N2")</div>
                            </div>
                            <div>
                                <label style="font-size: 11px; color: #6B6B6B; text-transform: uppercase;">Term</label>
                                <div style="font-weight: 500; color: #2B2B2B; margin-top: 2px; font-size: 14px;">
                                    @selectedHistory.TermMonths months</div>
                            </div>
                            <div>
                                <label style="font-size: 11px; color: #6B6B6B; text-transform: uppercase;">Interest</label>
                                <div style="font-weight: 500; color: #2B2B2B; margin-top: 2px; font-size: 14px;">
                                    @selectedHistory.InterestRate?.ToString("N2")%</div>
                            </div>
                            <div>
                                <label style="font-size: 11px; color: #6B6B6B; text-transform: uppercase;">Monthly</label>
                                <div style="font-weight: 600; color: #4F6F52; margin-top: 2px; font-size: 14px;">
                                    ₱@selectedHistory.MonthlyPayment?.ToString("N2")</div>
                            </div>
                        </div>
                    </div>
                }

                @if (selectedHistory.LinkedLoanId.HasValue)
                {
                    <div
                        style="background: rgba(79, 111, 82, 0.15); padding: 12px; border-radius: 10px; text-align: center; margin-top: 16px;">
                        <span style="color: #4F6F52; font-weight: 500; font-size: 13px;">📋 Linked Loan ID:
                            @selectedHistory.LinkedLoanId</span>
                    </div>
                }

                <div style="text-align: right; margin-top: 20px;">
                    <button @onclick="CloseModal"
                        style="padding: 10px 28px; background: #2F3E2A; color: white; border: none; border-radius: 10px; cursor: pointer; font-weight: 500;">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .table-row-hover:hover {
        background: #F7F7F4;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

@code {
    private List<FinanceBank.Models.AssetHistory>? historyList;
    private List<FinanceBank.Models.AssetHistory>? allHistory;
    private bool isLoading = true;

    // Filter fields
    private string filterActionType = "";
    private DateTime? filterFromDate;
    private DateTime? filterToDate;

    // Modal
    private bool showDetailsModal = false;
    private FinanceBank.Models.AssetHistory? selectedHistory;

    // Statistics
    private int forwardedCount => allHistory?.Count(h => h.ActionType == "FORWARDED_TO_ACCOUNTANT" || h.ActionType ==
    "FORWARDED_TO_FINANCEMANAGER") ?? 0;
    private int approvedCount => allHistory?.Count(h => h.ActionType == "APPROVED") ?? 0;
    private int releasedCount => allHistory?.Count(h => h.ActionType == "RELEASED") ?? 0;
    private int rejectedCount => allHistory?.Count(h => h.ActionType == "REJECTED") ?? 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadHistory();
    }

    private async Task LoadHistory()
    {
        isLoading = true;
        try
        {
            allHistory = await AssetService.GetAllHistoryAsync();
            historyList = allHistory;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading history: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApplyFilters()
    {
        isLoading = true;
        try
        {
            historyList = await AssetService.GetAllHistoryAsync(
            filterFromDate,
            filterToDate,
            string.IsNullOrEmpty(filterActionType) ? null : filterActionType,
            null);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ClearFilters()
    {
        filterActionType = "";
        filterFromDate = null;
        filterToDate = null;
        historyList = allHistory;
    }

    private void ShowHistoryDetails(FinanceBank.Models.AssetHistory history)
    {
        selectedHistory = history;
        showDetailsModal = true;
    }

    private void CloseModal()
    {
        showDetailsModal = false;
        selectedHistory = null;
    }

    private (string color, string bg, string icon) GetActionStyle(string actionType)
    {
        return actionType switch
        {
            "FORWARDED_TO_ACCOUNTANT" => ("#4F6F52", "rgba(79, 111, 82, 0.15)", "📤"),
            "FORWARDED_TO_FINANCEMANAGER" => ("#C49A3A", "rgba(196, 154, 58, 0.15)", "📤"),
            "APPROVED" => ("#4F6F52", "rgba(79, 111, 82, 0.15)", "✅"),
            "RELEASED" => ("#5F7A6A", "rgba(95, 122, 106, 0.15)", "🎉"),
            "REJECTED" => ("#9B3A3A", "rgba(155, 58, 58, 0.15)", "❌"),
            "SUBMITTED" => ("#6B6B6B", "rgba(107, 107, 107, 0.15)", "📋"),
            _ => ("#2B2B2B", "rgba(43, 43, 43, 0.1)", "📄")
        };
    }

    private string GetActionLabel(string actionType)
    {
        return actionType switch
        {
            "FORWARDED_TO_ACCOUNTANT" => "Forwarded to Accountant",
            "FORWARDED_TO_FINANCEMANAGER" => "Forwarded to FM",
            "APPROVED" => "Approved",
            "RELEASED" => "Released",
            "REJECTED" => "Rejected",
            "SUBMITTED" => "Submitted",
            "CANCELLED" => "Cancelled",
            _ => actionType
        };
    }
}