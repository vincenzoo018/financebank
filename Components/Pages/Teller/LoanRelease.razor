                    </div>
                </div>

                <div style="border: 2px solid #e2e8f0; border-radius: 12px; overflow: hidden; margin-bottom: 24px;">
                    <div style="background: #f8fafc; padding: 12px 18px; border-bottom: 1px solid #e2e8f0;">
                        <h6 style="margin: 0; color: #475569; font-size: 12px; text-transform: uppercase; font-weight: 700;">Transaction Details</h6>
                    </div>
                    <div style="padding: 18px;">
                        <table style="width: 100%; font-size: 14px;">
                            <tr><td style="padding: 8px 0; color: #64748b;">Principal Amount</td><td style="text-align: right; font-weight: 600; color: #1e293b;">₱@selectedInvoice.PrincipalAmount.ToString("N2")</td></tr>
                            <tr><td style="padding: 8px 0; color: #64748b;">Interest Amount</td><td style="text-align: right; font-weight: 600; color: #1e293b;">₱@selectedInvoice.InterestAmount.ToString("N2")</td></tr>
                            <tr><td style="padding: 8px 0; color: #64748b;">Fees</td><td style="text-align: right; font-weight: 600; color: #1e293b;">₱@selectedInvoice.FeesAmount.ToString("N2")</td></tr>
                            <tr style="border-top: 2px solid #e2e8f0;">
                                <td style="padding: 12px 0; font-weight: 700; color: #1e293b; font-size: 16px;">Total Released</td>
                                <td style="text-align: right; font-weight: 800; color: #059669; font-size: 20px;">₱@selectedInvoice.TotalAmount.ToString("N2")</td>
                            </tr>
                        </table>
                    </div>
                </div>

                @if (selectedInvoice.BalanceBefore.HasValue || selectedInvoice.BalanceAfter.HasValue)
                {
                    <div style="background: #fef3c7; padding: 16px 20px; border-radius: 10px; margin-bottom: 24px; border: 1px solid #fde68a;">
                        <h6 style="margin: 0 0 10px 0; color: #92400e; font-size: 12px; text-transform: uppercase; font-weight: 700;">Account Balance</h6>
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <div><span style="font-size: 12px; color: #a16207;">Before</span><p style="margin: 2px 0 0 0; font-weight: 600; color: #854d0e;">₱@(selectedInvoice.BalanceBefore?.ToString("N2") ?? "0.00")</p></div>
                            <div style="color: #d97706; font-size: 20px;">→</div>
                            <div><span style="font-size: 12px; color: #a16207;">After</span><p style="margin: 2px 0 0 0; font-weight: 700; color: #059669;">₱@(selectedInvoice.BalanceAfter?.ToString("N2") ?? "0.00")</p></div>
                        </div>
                    </div>
                }

                <div style="text-align: center; padding: 16px; background: #f8fafc; border-radius: 10px;">
                    <span style="font-size: 12px; color: #64748b;">Processed By</span>
                    <p style="margin: 4px 0 0 0; font-weight: 600; color: #1e293b;">@selectedInvoice.ProcessedBy</p>
                    <p style="margin: 4px 0 0 0; font-size: 12px; color: #94a3b8;">@selectedInvoice.InvoiceDate.ToString("hh:mm tt")</p>
                </div>

                <div style="display: flex; gap: 12px; justify-content: center; margin-top: 24px;">
                    <button @onclick="CloseInvoiceModal" style="background: #f1f5f9; color: #475569; border: none; padding: 12px 28px; border-radius: 10px; cursor: pointer; font-weight: 600; font-size: 14px;">Close</button>
                    <button style="background: linear-gradient(135deg, #059669, #10b981); color: white; border: none; padding: 12px 28px; border-radius: 10px; cursor: pointer; font-weight: 700; font-size: 14px; box-shadow: 0 4px 12px rgba(5, 150, 105, 0.3);">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 6px; vertical-align: middle;">
                            <polyline points="6 9 6 2 18 2 18 9"></polyline>
                            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                            <rect x="6" y="14" width="12" height="8"></rect>
                        </svg>
                        Print Invoice
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    @@keyframes spin { to { transform: rotate(360deg); } }
    .table-row-hover:hover { background: #f8fafc !important; }
    input:focus { outline: none; border-color: #059669 !important; box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.1); }
    button:hover:not(:disabled) { transform: translateY(-1px); }
    button:disabled { opacity: 0.6; cursor: not-allowed; }
</style>

@code {
    private List<LoanApproval>? approvedLoans;
    private List<LoanInvoice>? releaseInvoices;
    private LoanApproval? selectedApproval;
    private LoanInvoice? selectedInvoice;
    
    private bool showReleaseModal = false;
    private bool showHistoryModal = false;
    private bool showInvoiceModal = false;
    private bool showContractModal = false;
    private bool isLoading = true;
    private bool isLoadingHistory = false;
    private bool isProcessing = false;
    
    private int currentStep = 1;
    private int todayReleasesCount = 0;
    
    private string disbursedTo = "";
    private string contractReference = "";
    private string successMessage = "";
    private string errorMessage = "";
    private string contractHtmlContent = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadApprovedLoans();
        await LoadTodayReleasesCount();
    }

    private async Task LoadApprovedLoans()
    {
        isLoading = true;
        try { approvedLoans = await LoanService.GetApprovedLoansForReleaseAsync(); }
        catch (Exception ex) { errorMessage = $"Error loading approved loans: {ex.Message}"; }
        finally { isLoading = false; }
    }

    private async Task LoadTodayReleasesCount()
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var today = DateTime.Today;
            todayReleasesCount = await db.Set<LoanInvoice>().Where(i => i.InvoiceType == "RELEASE" && i.InvoiceDate.Date == today).CountAsync();
        }
        catch { todayReleasesCount = 0; }
    }

    private async Task LoadReleaseHistory()
    {
        isLoadingHistory = true;
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            releaseInvoices = await db.Set<LoanInvoice>().Where(i => i.InvoiceType == "RELEASE").OrderByDescending(i => i.InvoiceDate).Take(100).ToListAsync();
        }
        catch (Exception ex) { errorMessage = $"Error loading history: {ex.Message}"; }
        finally { isLoadingHistory = false; }
    }

    private void OpenReleaseModal(LoanApproval approval)
    {
        selectedApproval = approval;
        disbursedTo = approval.Assessment?.Application?.Account?.Customer?.FullName ?? "";
        contractReference = "";
        currentStep = 1;
        showReleaseModal = true;
    }

    private void CloseModal() { showReleaseModal = false; selectedApproval = null; currentStep = 1; }

    private async Task OpenHistoryModal() { showHistoryModal = true; await LoadReleaseHistory(); }

    private void CloseHistoryModal() { showHistoryModal = false; releaseInvoices = null; }

    private void ViewInvoice(LoanInvoice invoice) { selectedInvoice = invoice; showInvoiceModal = true; }

    private void CloseInvoiceModal() { showInvoiceModal = false; selectedInvoice = null; }

    private void GoToStep2() { if (!string.IsNullOrWhiteSpace(disbursedTo)) currentStep = 2; }

    private decimal CalculateMonthlyPayment()
    {
        if (selectedApproval?.ApprovedAmount == null || selectedApproval?.ApprovedInterestRate == null || selectedApproval?.ApprovedTermMonths == null) return 0;
        var principal = selectedApproval.ApprovedAmount.Value;
        var rate = selectedApproval.ApprovedInterestRate.Value / 100 / 12;
        var term = selectedApproval.ApprovedTermMonths.Value;
        if (rate == 0) return principal / term;
        return principal * (rate * (decimal)Math.Pow(1 + (double)rate, term)) / ((decimal)Math.Pow(1 + (double)rate, term) - 1);
    }

    private async Task ReleaseFunds()
    {
        if (selectedApproval == null) return;
        isProcessing = true;
        errorMessage = "";
        try
        {
            var result = await LoanService.TellerReleaseFundsAsync(selectedApproval.ApprovalId, selectedApproval.ApplicationId, selectedApproval.AccountId, selectedApproval.ApprovedAmount ?? 0, disbursedTo, AuthService.CurrentUser ?? "teller", contractReference);
            var loan = result.Item1;
            var disbursal = result.Item2;
            successMessage = $"Loan {loan.LoanNumber} has been released successfully! ₱{disbursal.DisbursalAmount:N2} has been credited to the customer's account.";
            CloseModal();
            await LoadApprovedLoans();
            await LoadTodayReleasesCount();
        }
        catch (Exception ex) { errorMessage = $"Error releasing funds: {ex.Message}"; }
        finally { isProcessing = false; }
    }

    private async Task DownloadContract()
    {
        if (selectedApproval == null) return;
        try
        {
            var customer = selectedApproval.Assessment?.Application?.Account?.Customer;
            var account = selectedApproval.Assessment?.Application?.Account;
            var monthlyPayment = CalculateMonthlyPayment();
            var totalPayable = monthlyPayment * (selectedApproval.ApprovedTermMonths ?? 12);
            var totalInterest = totalPayable - (selectedApproval.ApprovedAmount ?? 0);
            
            var contractData = new LoanContractData
            {
                ContractReference = string.IsNullOrEmpty(contractReference) ? $"REL-{DateTime.Now:yyyyMMddHHmmss}" : contractReference,
                ContractDate = DateTime.Now,
                ApplicationNumber = selectedApproval.Assessment?.Application?.ApplicationNumber ?? $"APP-{selectedApproval.ApplicationId}",
                BorrowerName = disbursedTo,
                AccountNumber = account?.AccountNumber ?? "N/A",
                ContactNumber = customer?.PhoneNumber ?? "N/A",
                EmailAddress = customer?.Email ?? "N/A",
                Address = customer?.EmployerAddress ?? "On File",
                PrincipalAmount = selectedApproval.ApprovedAmount ?? 0,
                InterestRate = selectedApproval.ApprovedInterestRate ?? 0,
                TermMonths = selectedApproval.ApprovedTermMonths ?? 12,
                MonthlyPayment = monthlyPayment,
                FirstDueDate = DateTime.Now.AddMonths(1),
                FinalDueDate = DateTime.Now.AddMonths(selectedApproval.ApprovedTermMonths ?? 12),
                TotalInterest = totalInterest,
                TotalPayable = totalPayable,
                BankRepresentative = AuthService.CurrentUser ?? "Teller"
            };
            
            contractHtmlContent = ContractService.GenerateLoanContractHtml(contractData);
            showContractModal = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error generating contract: {ex.Message}";
        }
    }

    private async Task PrintContract()
    {
        if (!string.IsNullOrEmpty(contractHtmlContent))
        {
            await JSRuntime.InvokeVoidAsync("printContractInline", contractHtmlContent);
        }
    }

    private async Task DownloadContractAsHtml()
    {
        if (!string.IsNullOrEmpty(contractHtmlContent))
        {
            var fileName = $"LoanContract_{selectedApproval?.Assessment?.Application?.ApplicationNumber ?? "Contract"}_{DateTime.Now:yyyyMMdd}.html";
            await JSRuntime.InvokeVoidAsync("downloadHtmlAsFile", fileName, contractHtmlContent);
        }
    }

    private void CloseContractModal()
    {
        showContractModal = false;
        contractHtmlContent = "";
    }
}
