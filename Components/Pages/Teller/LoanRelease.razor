            </div>

            <div style="padding: 28px;">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px;">
                    <div style="background: #f8fafc; padding: 14px 18px; border-radius: 10px;">
                        <span style="font-size: 11px; color: #64748b; text-transform: uppercase; font-weight: 600;">Invoice Number</span>
                        <p style="margin: 4px 0 0 0; font-weight: 700; color: #1e293b; font-size: 16px;">@selectedInvoice.InvoiceNumber</p>
                    </div>
                    <div style="background: #f8fafc; padding: 14px 18px; border-radius: 10px;">
                        <span style="font-size: 11px; color: #64748b; text-transform: uppercase; font-weight: 600;">Invoice Date</span>
                        <p style="margin: 4px 0 0 0; font-weight: 600; color: #1e293b; font-size: 15px;">@selectedInvoice.InvoiceDate.ToString("MMMM dd, yyyy")</p>
