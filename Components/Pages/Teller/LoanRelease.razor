                    <button @onclick="DownloadContractAsHtml"
                            style="background: #f3f4f6; color: #374151; border: 1px solid #d1d5db; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="7 10 12 15 17 10"></polyline>
                            <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                        Download HTML
                    </button>
                    <button @onclick="PrintContract"
                            style="background: linear-gradient(135deg, #059669, #10b981); color: white; border: none; padding: 10px 24px; border-radius: 8px; cursor: pointer; font-weight: 600; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 12px rgba(5,150,105,0.3);">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="6 9 6 2 18 2 18 9"></polyline>
                            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                            <rect x="6" y="14" width="12" height="8"></rect>
                        </svg>
                        🖨️ Print / Save as PDF
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* History Modal *@
@if (showHistoryModal)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.6); display: flex; align-items: center; justify-content: center; z-index: 1000; backdrop-filter: blur(4px);" @onclick="CloseHistoryModal">
        <div style="background: white; border-radius: 20px; width: 95%; max-width: 1100px; max-height: 90vh; overflow: hidden; box-shadow: 0 25px 60px rgba(0,0,0,0.3); display: flex; flex-direction: column;" @onclick:stopPropagation>
            <div style="background: linear-gradient(135deg, #059669, #10b981); color: white; padding: 24px 28px; display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h4 style="margin: 0; font-weight: 700; font-size: 20px;">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 10px; vertical-align: middle;">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                        Release History & Invoices
                    </h4>
                    <p style="margin: 6px 0 0 0; opacity: 0.9; font-size: 14px;">View all loan releases and download invoices</p>
                </div>
                <button @onclick="CloseHistoryModal" style="background: rgba(255,255,255,0.2); border: none; color: white; width: 36px; height: 36px; border-radius: 50%; cursor: pointer; font-size: 20px;">×</button>
            </div>

            <div style="padding: 24px; overflow-y: auto; flex: 1;">
                @if (isLoadingHistory)
                {
                    <div style="text-align: center; padding: 60px;">
                        <div style="width: 48px; height: 48px; border: 4px solid #e5e7eb; border-top-color: #059669; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto;"></div>
                        <p style="margin-top: 16px; color: #6b7280;">Loading release history...</p>
                    </div>
                }
                else if (releaseInvoices == null || releaseInvoices.Count == 0)
                {
                    <div style="text-align: center; padding: 60px;">
                        <div style="width: 80px; height: 80px; background: #f1f5f9; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            </svg>
                        </div>
                        <h5 style="color: #475569; margin-top: 20px; font-weight: 600;">No Release History</h5>
                        <p style="color: #94a3b8; font-size: 14px;">No loan releases have been recorded yet.</p>
                    </div>
                }
                else
                {
                    <div style="overflow-x: auto;">
                        <table style="width: 100%; border-collapse: separate; border-spacing: 0; font-size: 14px;">
                            <thead>
                                <tr style="background: linear-gradient(135deg, #f8fafc, #f1f5f9);">
                                    <th style="padding: 14px 12px; text-align: left; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">Invoice #</th>
                                    <th style="padding: 14px 12px; text-align: left; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">Customer</th>
                                    <th style="padding: 14px 12px; text-align: left; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">Account</th>
                                    <th style="padding: 14px 12px; text-align: right; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">Amount</th>
                                    <th style="padding: 14px 12px; text-align: left; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">Processed By</th>
                                    <th style="padding: 14px 12px; text-align: left; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">Date</th>
                                    <th style="padding: 14px 12px; text-align: center; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">Invoice</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var invoice in releaseInvoices)
                                {
                                    <tr style="border-bottom: 1px solid #f1f5f9;" class="table-row-hover">
                                        <td style="padding: 14px 12px;">
                                            <span style="background: linear-gradient(135deg, #dbeafe, #bfdbfe); color: #1e40af; padding: 4px 10px; border-radius: 6px; font-weight: 600; font-size: 12px;">@invoice.InvoiceNumber</span>
                                        </td>
                                        <td style="padding: 14px 12px; font-weight: 500; color: #1e293b;">@invoice.CustomerName</td>
                                        <td style="padding: 14px 12px; color: #64748b; font-family: monospace; font-size: 13px;">@invoice.AccountNumber</td>
                                        <td style="padding: 14px 12px; text-align: right; font-weight: 700; color: #059669; font-size: 15px;">₱@invoice.PrincipalAmount.ToString("N2")</td>
                                        <td style="padding: 14px 12px; color: #475569;">@invoice.ProcessedBy</td>
                                        <td style="padding: 14px 12px; color: #64748b;">@invoice.InvoiceDate.ToString("MMM dd, yyyy hh:mm tt")</td>
                                        <td style="padding: 14px 12px; text-align: center;">
                                            <button @onclick="() => ViewInvoice(invoice)" 
                                                    style="background: linear-gradient(135deg, #3b82f6, #2563eb); color: white; border: none; padding: 8px 14px; border-radius: 6px; cursor: pointer; font-weight: 600; font-size: 12px; box-shadow: 0 2px 6px rgba(59, 130, 246, 0.3);">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px; vertical-align: middle;">
                                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                                </svg>
                                                View
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
}

@* Invoice Detail Modal *@
@if (showInvoiceModal && selectedInvoice != null)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.7); display: flex; align-items: center; justify-content: center; z-index: 1100; backdrop-filter: blur(4px);" @onclick="CloseInvoiceModal">
        <div style="background: white; border-radius: 20px; width: 90%; max-width: 600px; max-height: 90vh; overflow-y: auto; box-shadow: 0 30px 80px rgba(0,0,0,0.35);" @onclick:stopPropagation>
            <div style="background: linear-gradient(135deg, #1e293b, #334155); color: white; padding: 28px; border-radius: 20px 20px 0 0; text-align: center;">
                <div style="width: 60px; height: 60px; background: white; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px;">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
