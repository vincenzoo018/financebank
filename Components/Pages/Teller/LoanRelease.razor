                    <h6 style="margin: 0 0 12px 0; color: #059669; font-size: 12px; text-transform: uppercase; font-weight: 700;">Customer Information</h6>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        <div>
                            <span style="font-size: 12px; color: #6b7280;">Customer Name</span>
                            <p style="margin: 2px 0 0 0; font-weight: 600; color: #1e293b;">@selectedInvoice.CustomerName</p>
                        </div>
                        <div>
                            <span style="font-size: 12px; color: #6b7280;">Account Number</span>
                            <p style="margin: 2px 0 0 0; font-weight: 600; color: #1e293b; font-family: monospace;">@selectedInvoice.AccountNumber</p>
