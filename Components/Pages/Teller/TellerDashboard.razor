@code {
    private TellerDashboardAnalytics? analytics;
    private bool isLoading = true;
    private string selectedPeriod = "today";

    // Report Modal
    private bool showReportModal = false;
    private string reportPeriod = "today";
    private string reportFormat = "pdf";
    private DateTime reportStartDate = DateTime.Today.AddDays(-7);
    private DateTime reportEndDate = DateTime.Today;
    private bool isDownloading = false;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated || AuthService.CurrentRole != AuthService.Roles.Teller)
        {
            return;
        }

        await LoadAnalytics();
    }

    private async Task LoadAnalytics()
    {
        isLoading = true;
        try
        {
            var (start, end) = GetDateRange(selectedPeriod);
            analytics = await ReportService.GetDashboardAnalyticsAsync(start, end);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading analytics: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnPeriodChanged()
    {
        await LoadAnalytics();
    }

    private (DateTime start, DateTime end) GetDateRange(string period)
    {
        return period switch
        {
            "today" => (DateTime.Today, DateTime.Today.AddDays(1).AddSeconds(-1)),
            "week" => (DateTime.Today.AddDays(-(int)DateTime.Today.DayOfWeek), DateTime.Today.AddDays(1).AddSeconds(-1)),
            "month" => (new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1), DateTime.Today.AddDays(1).AddSeconds(-1)),
            _ => (DateTime.Today, DateTime.Today.AddDays(1).AddSeconds(-1))
        };
    }

    private (string bgColor, string textColor, string prefix) GetTransactionStyle(string type)
    {
        return type switch
        {
            "Deposit" => ("#D4E6D4", "#2F3E2A", "+"),
            "Withdrawal" => ("#F5E6E6", "#9B3A3A", "-"),
            "Loan Payment" => ("#E8F0E8", "#5F6F52", "+"),
            "Loan Release" => ("#F5EFE0", "#8B5A2B", "-"),
            _ => ("#f3f4f6", "#374151", "")
        };
    }

    private void OpenReportModal()
    {
        reportPeriod = selectedPeriod;
        showReportModal = true;
    }

    private void CloseReportModal()
    {
        showReportModal = false;
    }

    private async Task DownloadReport()
    {
        isDownloading = true;
        try
        {
            var (start, end) = reportPeriod == "custom"
            ? (reportStartDate, reportEndDate.AddDays(1).AddSeconds(-1))
            : GetDateRange(reportPeriod);

            if (reportFormat == "excel")
            {
                // Generate CSV for Excel
                var csvContent = await ReportService.GenerateCsvReportAsync(start, end);
                var fileName = $"TellerReport_{start:yyyyMMdd}_{end:yyyyMMdd}.csv";
                await DownloadFile(fileName, csvContent, "text/csv");
            }
            else
            {
                // Generate HTML for PDF (user can print to PDF)
                var htmlContent = await ReportService.GenerateHtmlReportAsync(start, end);
                var fileName = $"TellerReport_{start:yyyyMMdd}_{end:yyyyMMdd}.html";
                await DownloadFile(fileName, htmlContent, "text/html");
            }

            CloseReportModal();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error generating report: {ex.Message}");
        }
        finally
        {
            isDownloading = false;
        }
    }

    private async Task DownloadFile(string fileName, string content, string mimeType)
    {
        var bytes = System.Text.Encoding.UTF8.GetBytes(content);
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("eval", $@"
var link = document.createElement('a');
link.href = 'data:{mimeType};base64,{base64}';
link.download = '{fileName}';
document.body.appendChild(link);
link.click();
document.body.removeChild(link);
");
    }
}