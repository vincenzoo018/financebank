@page "/teller/encode-application"
@using Microsoft.AspNetCore.Authorization
@using FinanceBank.Services
@using FinanceBank.Models
@layout TellerLayout
@inject LoanProcessService LoanProcessService
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Teller")]

<div class="card shadow">
        <div class="card-header bg-info text-white">
            <h4 class="mb-0"><i class="bi bi-file-earmark-text"></i> Encode Loan Application</h4>
        </div>
        <div class="card-body">
            @if (successMessage != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @successMessage
                    <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
                </div>
            }

            @if (errorMessage != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
                </div>
            }

            @if (verifiedApplications == null)
            {
                <div class="text-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else if (verifiedApplications.Count == 0)
            {
                <div class="alert alert-info">No verified applications to encode.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Application #</th>
                                <th>Customer</th>
                                <th>Loan Type</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var app in verifiedApplications)
                            {
                                <tr>
                                    <td><span class="badge bg-primary">@app.ApplicationNumber</span></td>
                                    <td>@app.Account?.Customer?.FullName</td>
                                    <td>@app.LoanType</td>
                                    <td>₱@app.RequestedAmount.ToString("N2")</td>
                                    <td><span class="badge bg-warning">@app.Status</span></td>
                                    <td>
                                        <button class="btn btn-sm btn-primary" @onclick="() => EncodeAsync(app.ApplicationId)">
                                            <i class="bi bi-pencil-square"></i> Encode
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

@code {
    private List<LoanApplication>? verifiedApplications;
    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadVerifiedApplicationsAsync();
    }

    private async Task LoadVerifiedApplicationsAsync()
    {
        try
        {
            verifiedApplications = await LoanProcessService.GetPendingApplicationsAsync("TELLER");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading applications: {ex.Message}";
        }
    }

    private async Task EncodeAsync(int applicationId)
    {
        try
        {
            await LoanProcessService.EncodeApplicationAsync(applicationId, "teller-user");
            successMessage = "Application encoded successfully!";
            await LoadVerifiedApplicationsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error encoding application: {ex.Message}";
        }
    }
}
