@page "/teller/deposits"
@layout TellerLayout
@inject AuthService AuthService

<!-- Header with Gradient -->
<div style="background: linear-gradient(135deg, #059669, #047857); border-radius: 16px; padding: 32px; margin-bottom: 32px; color: white;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <div>
            <h1 style="font-size: 28px; font-weight: 700; margin: 0;">Process Deposits</h1>
            <p style="margin: 4px 0 0; opacity: 0.9; font-size: 14px;">Record customer cash deposits</p>
        </div>
    </div>
</div>

<!-- Deposit Form -->
<div style="background: white; border-radius: 16px; padding: 32px; border: 1px solid #e5e7eb; margin-bottom: 32px;">
    <h3 style="margin: 0 0 24px; font-size: 18px; font-weight: 700; color: #1f2937;">New Deposit Transaction</h3>
    
    <form @onsubmit="HandleDeposit" @onsubmit:preventDefault>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px;">
            <!-- Account Number -->
            <div>
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Account Number *</label>
                <input type="text" style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;" 
                       @bind="accountNumber" placeholder="ACC-2025-001" />
                @if (showError && string.IsNullOrEmpty(accountNumber)) 
                { 
                    <span style="color: #dc2626; font-size: 12px;">Required</span> 
                }
            </div>

            <!-- Customer Name -->
            <div>
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Customer Name</label>
                <input type="text" style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px; background: #f9fafb;" 
                       @bind="customerName" placeholder="Auto-filled" readonly />
            </div>

            <!-- Deposit Amount -->
            <div>
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Deposit Amount (₱) *</label>
                <input type="number" style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;" 
                       @bind="depositAmount" placeholder="0.00" step="0.01" />
                @if (showError && depositAmount <= 0) 
                { 
                    <span style="color: #dc2626; font-size: 12px;">Amount must be greater than 0</span> 
                }
            </div>

            <!-- Reference Number -->
            <div>
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Reference Number</label>
                <input type="text" style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;" 
                       @bind="referenceNumber" placeholder="REF-20250118-001" />
            </div>

            <!-- Deposit Method -->
            <div>
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Deposit Method *</label>
                <select style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;" @bind="depositMethod">
                    <option value="">Select method...</option>
                    <option value="OTC">Over-the-Counter (OTC)</option>
                    <option value="BankTransfer">Bank Transfer</option>
                    <option value="CDM">Cash Deposit Machine (CDM)</option>
                </select>
                @if (showError && string.IsNullOrEmpty(depositMethod)) 
                { 
                    <span style="color: #dc2626; font-size: 12px;">Required</span> 
                }
            </div>

            <!-- Notes -->
            <div style="grid-column: 1 / -1;">
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Notes</label>
                <textarea style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px; font-family: inherit; resize: vertical; min-height: 80px;" 
                          @bind="notes" placeholder="Additional notes..."></textarea>
            </div>
        </div>

        <!-- Messages -->
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div style="padding: 16px; background: #fee2e2; border-radius: 8px; color: #991b1b; margin-bottom: 20px; font-size: 14px;">
                <strong>Error:</strong> @errorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div style="padding: 16px; background: #d1fae5; border-radius: 8px; color: #065f46; margin-bottom: 20px; font-size: 14px;">
                <strong>Success:</strong> @successMessage
            </div>
        }

        <!-- Buttons -->
        <div style="display: flex; gap: 12px; justify-content: flex-end;">
            <button type="button" style="background: #f3f4f6; color: #374151; padding: 12px 24px; border-radius: 8px; border: none; font-weight: 600; cursor: pointer;" @onclick="ResetForm">
                Reset
            </button>
            <button type="submit" style="background: linear-gradient(135deg, #059669, #047857); color: white; padding: 12px 32px; border-radius: 8px; border: none; font-weight: 600; cursor: pointer;" disabled="@isLoading">
                @if (isLoading) { <span>Processing...</span> } else { <span>Process Deposit</span> }
            </button>
        </div>
    </form>
</div>

<!-- Recent Deposits -->
<div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
    <h3 style="margin: 0 0 20px; font-size: 18px; font-weight: 700; color: #1f2937;">Today's Deposits</h3>
    <table style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr style="border-bottom: 2px solid #e5e7eb; background: #f9fafb;">
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">ACCOUNT #</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">CUSTOMER</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">AMOUNT</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">METHOD</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">TIME</th>
                <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">STATUS</th>
            </tr>
        </thead>
        <tbody>
            <tr style="border-bottom: 1px solid #e5e7eb;">
                <td style="padding: 16px; font-weight: 600;">ACC-2025-001</td>
                <td style="padding: 16px;">Juan Dela Cruz</td>
                <td style="padding: 16px; font-weight: 600; color: #059669;">₱5,000.00</td>
                <td style="padding: 16px; font-size: 12px;">OTC</td>
                <td style="padding: 16px; font-size: 12px; color: #6b7280;">10:30 AM</td>
                <td style="padding: 16px;"><span style="padding: 4px 12px; background: #d1fae5; color: #065f46; border-radius: 8px; font-size: 12px; font-weight: 600;">Completed</span></td>
            </tr>
            <tr style="border-bottom: 1px solid #e5e7eb;">
                <td style="padding: 16px; font-weight: 600;">ACC-2025-003</td>
                <td style="padding: 16px;">Pedro Garcia</td>
                <td style="padding: 16px; font-weight: 600; color: #059669;">₱8,750.00</td>
                <td style="padding: 16px; font-size: 12px;">Bank Transfer</td>
                <td style="padding: 16px; font-size: 12px; color: #6b7280;">09:15 AM</td>
                <td style="padding: 16px;"><span style="padding: 4px 12px; background: #d1fae5; color: #065f46; border-radius: 8px; font-size: 12px; font-weight: 600;">Completed</span></td>
            </tr>
        </tbody>
    </table>
</div>

@code {
    private string accountNumber = "";
    private string customerName = "";
    private decimal depositAmount = 0;
    private string referenceNumber = "";
    private string depositMethod = "";
    private string notes = "";
    private bool showError = false;
    private bool isLoading = false;
    private string errorMessage = "";
    private string successMessage = "";

    private async Task HandleDeposit()
    {
        showError = true;
        errorMessage = "";
        successMessage = "";

        // Validation
        if (string.IsNullOrEmpty(accountNumber))
        {
            errorMessage = "Account number is required";
            return;
        }

        if (depositAmount <= 0)
        {
            errorMessage = "Deposit amount must be greater than 0";
            return;
        }

        if (string.IsNullOrEmpty(depositMethod))
        {
            errorMessage = "Deposit method is required";
            return;
        }

        isLoading = true;
        await Task.Delay(1500);
        isLoading = false;

        successMessage = $"Deposit of ₱{depositAmount:N2} processed successfully for account {accountNumber}!";
        await Task.Delay(3000);
        ResetForm();
        successMessage = "";
    }

    private void ResetForm()
    {
        accountNumber = "";
        customerName = "";
        depositAmount = 0;
        referenceNumber = "";
        depositMethod = "";
        notes = "";
        showError = false;
        errorMessage = "";
    }
}
