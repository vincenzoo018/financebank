    private void ShowConfirmation()
    {
        showError = true;
        errorMessage = "";
        successMessage = "";

        // Validation with specific error messages
        if (string.IsNullOrWhiteSpace(accountNumber))
        {
            errorMessage = "⚠️ Account number is required. Please enter a valid account number.";
            return;
        }

        if (string.IsNullOrWhiteSpace(customerName))
        {
            errorMessage = "⚠️ Invalid account number. Customer not found.";
            return;
        }

        if (depositAmount <= 0)
        {
            errorMessage = "⚠️ Deposit amount must be greater than ₱0.00";
            return;
        }

        if (string.IsNullOrWhiteSpace(depositMethod))
        {
            errorMessage = "⚠️ Please select a deposit method";
            return;
        }

        if (!tellerPinVerified)
        {
            errorMessage = "⚠️ Teller PIN verification is required before processing";
            return;
        }

        // Show confirmation modal
        showConfirmationModal = true;
    }

    private void CancelConfirmation()
    {
        showConfirmationModal = false;
    }

    private async Task HandleDeposit()
    {
        showConfirmationModal = false;
        lastReceiptNumber = "";

        isLoading = true;

        try
        {
            var (success, message, transaction, receiptNumber) = await TellerBankingService.ProcessDepositAsync(
            accountNumber,
            depositAmount,
            depositMethod,
            referenceNumber,
            notes
            );

            if (success)
            {
                lastReceiptNumber = receiptNumber;
                successMessage = message;

                // Add to real-time transactions list
                todayTransactions.Insert(0, new TransactionRecord
                {
                    AccountNumber = accountNumber,
                    CustomerName = customerName,
                    Amount = depositAmount,
                    Method = depositMethod,
                    Date = DateTime.Now,
                    Reference = referenceNumber
                });

                await Task.Delay(2000);
                ResetForm();
            }
            else
            {
                errorMessage = message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

