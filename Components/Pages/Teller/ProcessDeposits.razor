    private void ResetForm()
    {
        accountNumber = "";
        customerName = "";
        currentBalance = "₱0.00";
        depositAmount = 0;
        depositMethod = "";
        notes = "";
        showError = false;
        errorMessage = "";
        successMessage = "";
        lastReceiptNumber = "";

        // Reset PIN verification
        tellerPin = "";
        tellerPinError = "";
        tellerPinAttempts = 0;
        tellerPinVerified = false;

        // Generate new reference number
        GenerateReferenceNumber();
    }
}