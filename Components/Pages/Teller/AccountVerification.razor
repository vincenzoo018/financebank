@page "/teller/verification"
@layout TellerLayout

<div style="padding: 24px; max-width: 900px; margin: 0 auto;">
    <div style="background: linear-gradient(135deg, var(--accent), #0ea5e9); border-radius: 16px; padding: 24px; margin-bottom: 24px; color: white;">
        <h1 style="font-size: 24px; font-weight: 700; margin: 0 0 4px 0;">Account Verification</h1>
        <p style="font-size: 14px; opacity: 0.9; margin: 0;">Lookup and verify customer accounts before processing transactions.</p>
    </div>

    <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb; margin-bottom: 20px;">
        <h2 style="font-size: 16px; font-weight: 600; margin-bottom: 16px;">Search Account</h2>
        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 12px;">
            <input type="text" class="form-control" placeholder="Enter account number or customer name..." />
            <button class="btn" style="background: var(--accent); color: white;">Search</button>
        </div>
    </div>

    <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
        <h2 style="font-size: 16px; font-weight: 600; margin-bottom: 8px;">Results</h2>
        <p style="font-size: 13px; color: #6b7280;">No account selected. Use the search above to verify an account.</p>
    </div>
</div>
