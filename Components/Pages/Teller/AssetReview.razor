@page "/teller/asset-review"
@layout TellerLayout
@using FinanceBank.Models
@using FinanceBank.Services
@using FinanceBank.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@inject AssetMarketplaceService AssetService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IDbContextFactory<BFASDbContext> DbContextFactory

<div class="sidebar-content">
    <div class="card">
        <div class="card-header" style="background: #2F3E2A; color: white; padding: 20px;">
            <h4 style="margin: 0; font-weight: 500;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    style="margin-right: 8px; vertical-align: middle;">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
                Asset Application Review
            </h4>
            <p style="margin: 8px 0 0 0; opacity: 0.9; font-size: 14px;">Review asset purchase/loan applications and
                verify documents</p>
        </div>

        <div class="card-body" style="padding: 24px;">
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div
                    style="background: #D4E6D4; border: 1px solid #A9B388; color: #2F3E2A; padding: 16px; border-radius: 8px; margin-bottom: 20px; display: flex; align-items: center; gap: 12px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                    @successMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div
                    style="background: #F5E6E6; border: 1px solid #C4A5A5; color: #9B3A3A; padding: 16px; border-radius: 8px; margin-bottom: 20px;">
                    @errorMessage
                </div>
            }

            <!-- Status Filter Tabs -->
            <div style="display: flex; gap: 12px; margin-bottom: 24px; flex-wrap: wrap;">
                <button @onclick="() => SetFilter(Filters.Pending)"
                    style="padding: 10px 20px; border-radius: 10px; border: none; cursor: pointer; font-weight: 500; background: @(currentFilter == Filters.Pending ? "#2F3E2A" : "#F7F7F4"); color: @(currentFilter == Filters.Pending ? "white" : "#6B6B6B");">
                    📋 Pending Review (@pendingCount)
                </button>
                <button @onclick="() => SetFilter(Filters.Verified)"
                    style="padding: 10px 20px; border-radius: 10px; border: none; cursor: pointer; font-weight: 500; background: @(currentFilter == Filters.Verified ? "#2F3E2A" : "#F7F7F4"); color: @(currentFilter == Filters.Verified ? "white" : "#6B6B6B");">
                    ✅ Verified (@verifiedCount)
                </button>
                <button @onclick="() => SetFilter(Filters.Approved)"
                    style="padding: 10px 20px; border-radius: 10px; border: none; cursor: pointer; font-weight: 500; background: @(currentFilter == Filters.Approved ? "#C49A3A" : "#F7F7F4"); color: @(currentFilter == Filters.Approved ? "white" : "#6B6B6B");">
                    🎯 Ready for Release (@approvedCount)
                </button>
            </div>

            @if (isLoading)
            {
                <div style="text-align: center; padding: 40px;">
                    <div
                        style="width: 40px; height: 40px; border: 3px solid #E2E2DC; border-top-color: #2F3E2A; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto;">
                    </div>
                    <p style="margin-top: 16px; color: #6B6B6B;">Loading applications...</p>
                </div>
            }
            else if (filteredApplications == null || filteredApplications.Count == 0)
            {
                <div style="text-align: center; padding: 60px 20px; background: #F7F7F4; border-radius: 14px;">
                    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#E2E2DC" stroke-width="1.5"
                        style="margin: 0 auto;">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                    <h5 style="color: #6B6B6B; margin-top: 16px;">No Applications Found</h5>
                    <p style="color: #6B6B6B; font-size: 14px;">There are no asset applications in this status.</p>
                </div>
            }
            else
            {
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="background: #F7F7F4; border-bottom: 2px solid #E2E2DC;">
                                <th style="padding: 12px; text-align: left; font-weight: 500; color: #2B2B2B;">Application #
                                </th>
                                <th style="padding: 12px; text-align: left; font-weight: 500; color: #2B2B2B;">Customer</th>
                                <th style="padding: 12px; text-align: left; font-weight: 500; color: #2B2B2B;">Asset</th>
                                <th style="padding: 12px; text-align: left; font-weight: 500; color: #2B2B2B;">Type</th>
                                <th style="padding: 12px; text-align: right; font-weight: 500; color: #2B2B2B;">Amount</th>
                                <th style="padding: 12px; text-align: center; font-weight: 500; color: #2B2B2B;">Status</th>
                                <th style="padding: 12px; text-align: center; font-weight: 500; color: #2B2B2B;">Actions
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var app in filteredApplications)
                            {
                                <tr style="border-bottom: 1px solid #E2E2DC; transition: background 0.2s;"
                                    class="table-row-hover">
                                    <td style="padding: 16px 12px;">
                                        <span
                                            style="background: rgba(79, 111, 82, 0.15); color: #4F6F52; padding: 4px 12px; border-radius: 10px; font-weight: 500; font-size: 13px;">
                                            @app.ApplicationNumber
                                        </span>
                                    </td>
                                    <td style="padding: 16px 12px;">
                                        <div style="font-weight: 500; color: #2B2B2B;">@app.CustomerName</div>
                                        <div style="font-size: 12px; color: #6B6B6B;">@app.CustomerEmail</div>
                                    </td>
                                    <td style="padding: 16px 12px;">
                                        <div style="font-weight: 500; color: #2B2B2B;">@(app.Asset?.AssetName ?? "N/A")</div>
                                        <div style="font-size: 12px; color: #6B6B6B;">@(app.Asset?.AssetType ?? "")</div>
                                    </td>
                                    <td style="padding: 16px 12px;">
                                        <span
                                            style="background: @(app.PurchaseType == "Cash" ? "rgba(196, 154, 58, 0.15)" : "rgba(79, 111, 82, 0.15)"); color: @(app.PurchaseType == "Cash" ? "#C49A3A" : "#4F6F52"); padding: 4px 10px; border-radius: 10px; font-size: 12px; font-weight: 500;">
                                            @(app.PurchaseType == "Cash" ? "💰 Cash" : "💳 Loan")
                                        </span>
                                    </td>
                                    <td style="padding: 16px 12px; text-align: right; font-weight: 500; color: #4F6F52;">
                                        ₱@app.AssetPrice.ToString("N2")</td>
                                    <td style="padding: 16px 12px; text-align: center;">
                                        @{
                                            var (statusBg, statusColor, statusText) = GetStatusStyle(app.Status);
                                        }
                                        <span
                                            style="background: @statusBg; color: @statusColor; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 500;">
                                            @statusText
                                        </span>
                                    </td>
                                    <td style="padding: 16px 12px; text-align: center;">
                                        @if (app.Status == "SUBMITTED")
                                        {
                                            <button
                                                style="background: #2F3E2A; color: white; border: none; padding: 8px 16px; border-radius: 10px; cursor: pointer; font-weight: 500;"
                                                @onclick="() => OpenReviewModal(app)">
                                                Review
                                            </button>
                                        }
                                        else if (app.Status == "APPROVED")
                                        {
                                            <button
                                                style="background: #2F3E2A; color: white; border: none; padding: 8px 16px; border-radius: 10px; cursor: pointer; font-weight: 500;"
                                                @onclick="() => OpenReleaseModal(app)">
                                                Release
                                            </button>
                                        }
                                        else
                                        {
                                            <button
                                                style="background: #6B6B6B; color: white; border: none; padding: 8px 12px; border-radius: 10px; cursor: pointer; font-weight: 500; font-size: 12px;"
                                                @onclick="() => ViewDetails(app)">
                                                View
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Review Modal -->
@if (showReviewModal && selectedApplication != null)
{
    <div
        style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(47, 62, 42, 0.6); display: flex; align-items: center; justify-content: center; z-index: 1000; padding: 20px;">
        <div
            style="background: #FFFFFF; border-radius: 16px; width: 100%; max-width: 1100px; max-height: 90vh; overflow-y: auto;">
            <!-- Modal Header -->
            <div style="background: #2F3E2A; color: white; padding: 20px; border-radius: 16px 16px 0 0;">
                <h4 style="margin: 0;">📋 Review Asset Application</h4>
                <p style="margin: 8px 0 0 0; opacity: 0.9; font-size: 14px;">Application #:
                    @selectedApplication.ApplicationNumber</p>
            </div>

            <div style="padding: 24px;">
                <!-- Asset Image Slideshow -->
                @if (selectedApplication.Asset?.Images != null && selectedApplication.Asset.Images.Any())
                {
                    <div style="margin-bottom: 24px; background: #F7F7F4; border-radius: 14px; padding: 16px;">
                        <h5 style="margin: 0 0 12px 0; color: #2B2B2B; font-weight: 600;">🖼️ Asset Images</h5>
                        <div style="position: relative;">
                            <div style="display: flex; align-items: center; justify-content: center; min-height: 250px;">
                                @{
                                    var images = selectedApplication.Asset.Images.OrderBy(i => i.DisplayOrder).ToList();
                                    var currentImage = images.ElementAtOrDefault(currentImageIndex);
                                }
                                @if (currentImage != null && currentImage.ImageData != null)
                                {
                                    <img src="data:@currentImage.ContentType;base64,@Convert.ToBase64String(currentImage.ImageData)"
                                        style="max-width: 100%; max-height: 250px; border-radius: 8px; object-fit: contain;" />
                                }
                                else
                                {
                                    <div style="text-align: center; color: #6B6B6B;">No image available</div>
                                }
                            </div>
                            @if (images.Count > 1)
                            {
                                <button @onclick="PrevImage"
                                    style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); background: rgba(47, 62, 42, 0.6); color: white; border: none; border-radius: 50%; width: 40px; height: 40px; cursor: pointer; font-size: 20px;">
                                    ◀
                                </button>
                                <button @onclick="NextImage"
                                    style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: rgba(47, 62, 42, 0.6); color: white; border: none; border-radius: 50%; width: 40px; height: 40px; cursor: pointer; font-size: 20px;">
                                    ▶
                                </button>
                                <div style="text-align: center; margin-top: 12px;">
                                    @for (int i = 0; i < images.Count; i++)
                                    {
                                        var idx = i;
                                        <span @onclick="() => SetImageIndex(idx)"
                                            style="display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin: 0 4px; cursor: pointer; background: @(currentImageIndex == idx ? "#2F3E2A" : "#E2E2DC");"></span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Application Info Grid -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 24px;">
                    <!-- Customer Info -->
                    <div style="background: #F7F7F4; border-radius: 14px; padding: 16px;">
                        <h5 style="margin: 0 0 12px 0; color: #2B2B2B; font-weight: 600;">👤 Customer Information</h5>
                        <div style="display: grid; gap: 8px; font-size: 14px;">
                            <div><span style="color: #6B6B6B;">Name:</span>
                                <strong>@selectedApplication.CustomerName</strong></div>
                            <div><span style="color: #6B6B6B;">Email:</span> @selectedApplication.CustomerEmail</div>
                            <div><span style="color: #6B6B6B;">Phone:</span> @selectedApplication.CustomerPhone</div>
                            <div><span style="color: #6B6B6B;">Address:</span> @selectedApplication.CustomerAddress</div>
                            <div><span style="color: #6B6B6B;">Employment:</span> @selectedApplication.EmploymentStatus
                            </div>
                            <div><span style="color: #6B6B6B;">Monthly Income:</span> <strong
                                    style="color: #4F6F52;">₱@(selectedApplication.MonthlyIncome?.ToString("N2") ??
                                                                    "N/A")</strong></div>
                        </div>
                    </div>

                    <!-- Asset & Financial Info -->
                    <div
                        style="background: rgba(79, 111, 82, 0.15); border-radius: 14px; padding: 16px; border: 1px solid rgba(79, 111, 82, 0.3);">
                        <h5 style="margin: 0 0 12px 0; color: #4F6F52; font-weight: 600;">💰 Financial Summary</h5>
                        <div style="display: grid; gap: 8px; font-size: 14px;">
                            <div><span style="color: #6B6B6B;">Asset:</span> <strong>@(selectedApplication.Asset?.AssetName
                                                                    ?? "N/A")</strong></div>
                            <div><span style="color: #6B6B6B;">Type:</span> @selectedApplication.PurchaseType</div>
                            <div><span style="color: #6B6B6B;">Total Price:</span> <strong
                                    style="color: #4F6F52;">₱@selectedApplication.AssetPrice.ToString("N2")</strong></div>
                            <div><span style="color: #6B6B6B;">Down Payment:</span>
                                ₱@selectedApplication.DownPaymentAmount.ToString("N2")</div>
                            @if (selectedApplication.PurchaseType == "Loan")
                            {
                                <div><span style="color: #6b7280;">Loan Amount:</span>
                                    ₱@selectedApplication.LoanAmount.ToString("N2")</div>
                                <div><span style="color: #6b7280;">Monthly Payment:</span>
                                    <strong>₱@selectedApplication.MonthlyPayment.ToString("N2")</strong></div>
                                <div><span style="color: #6b7280;">Term:</span> @selectedApplication.TermMonths months</div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Document Verification Checklist -->
                <div
                    style="background: rgba(79, 111, 82, 0.15); border-radius: 14px; padding: 20px; margin-bottom: 24px; border: 1px solid rgba(79, 111, 82, 0.3);">
                    <h5 style="margin: 0 0 16px 0; color: #4F6F52; font-weight: 600;">📄 Document Verification Checklist
                    </h5>
                    <p style="color: #6B6B6B; font-size: 13px; margin-bottom: 16px;">Verify that the customer has submitted
                        the following required documents:</p>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        @if (selectedApplication.ValidIdRequired)
                        {
                            <label
                                style="display: flex; align-items: center; gap: 10px; padding: 10px; background: #FFFFFF; border-radius: 10px; cursor: pointer;">
                                <input type="checkbox" @bind="verifyValidId"
                                    style="width: 18px; height: 18px; accent-color: #2F3E2A;" />
                                <span>Valid Government ID ✅</span>
                            </label>
                        }
                        @if (selectedApplication.ProofOfIncomeRequired)
                        {
                            <label
                                style="display: flex; align-items: center; gap: 10px; padding: 10px; background: #FFFFFF; border-radius: 10px; cursor: pointer;">
                                <input type="checkbox" @bind="verifyProofOfIncome"
                                    style="width: 18px; height: 18px; accent-color: #2F3E2A;" />
                                <span>Proof of Income 📄</span>
                            </label>
                        }
                        @if (selectedApplication.ProofOfBillingRequired)
                        {
                            <label
                                style="display: flex; align-items: center; gap: 10px; padding: 10px; background: #FFFFFF; border-radius: 10px; cursor: pointer;">
                                <input type="checkbox" @bind="verifyProofOfBilling"
                                    style="width: 18px; height: 18px; accent-color: #2F3E2A;" />
                                <span>Proof of Billing 📬</span>
                            </label>
                        }
                        @if (selectedApplication.BankStatementRequired)
                        {
                            <label
                                style="display: flex; align-items: center; gap: 10px; padding: 10px; background: #FFFFFF; border-radius: 10px; cursor: pointer;">
                                <input type="checkbox" @bind="verifyBankStatement"
                                    style="width: 18px; height: 18px; accent-color: #2F3E2A;" />
                                <span>Bank Statement 🏦</span>
                            </label>
                        }
                        @if (selectedApplication.COERequired)
                        {
                            <label
                                style="display: flex; align-items: center; gap: 10px; padding: 10px; background: #FFFFFF; border-radius: 10px; cursor: pointer;">
                                <input type="checkbox" @bind="verifyCOE"
                                    style="width: 18px; height: 18px; accent-color: #2F3E2A;" />
                                <span>Certificate of Employment 📋</span>
                            </label>
                        }
                        @if (selectedApplication.BusinessPermitRequired)
                        {
                            <label
                                style="display: flex; align-items: center; gap: 10px; padding: 10px; background: #FFFFFF; border-radius: 10px; cursor: pointer;">
                                <input type="checkbox" @bind="verifyBusinessPermit"
                                    style="width: 18px; height: 18px; accent-color: #2F3E2A;" />
                                <span>Business Permit 🏪</span>
                            </label>
                        }
                        @if (selectedApplication.TitleDeedRequired)
                        {
                            <label
                                style="display: flex; align-items: center; gap: 10px; padding: 10px; background: #FFFFFF; border-radius: 10px; cursor: pointer;">
                                <input type="checkbox" @bind="verifyTitleDeed"
                                    style="width: 18px; height: 18px; accent-color: #2F3E2A;" />
                                <span>Title Deed 🏠</span>
                            </label>
                        }
                        @if (selectedApplication.TaxDeclarationRequired)
                        {
                            <label
                                style="display: flex; align-items: center; gap: 10px; padding: 10px; background: #FFFFFF; border-radius: 10px; cursor: pointer;">
                                <input type="checkbox" @bind="verifyTaxDeclaration"
                                    style="width: 18px; height: 18px; accent-color: #2F3E2A;" />
                                <span>Tax Declaration 📑</span>
                            </label>
                        }
                        @if (selectedApplication.ORCRRequired)
                        {
                            <label
                                style="display: flex; align-items: center; gap: 10px; padding: 10px; background: #FFFFFF; border-radius: 10px; cursor: pointer;">
                                <input type="checkbox" @bind="verifyORCR"
                                    style="width: 18px; height: 18px; accent-color: #2F3E2A;" />
                                <span>OR/CR 🚗</span>
                            </label>
                        }
                    </div>

                    <!-- Additional verification checkboxes -->
                    <div style="margin-top: 16px; padding-top: 16px; border-top: 1px solid rgba(79, 111, 82, 0.3);">
                        <label
                            style="display: flex; align-items: center; gap: 10px; padding: 10px; background: #FFFFFF; border-radius: 10px; cursor: pointer; margin-bottom: 8px;">
                            <input type="checkbox" @bind="verifyAddress"
                                style="width: 18px; height: 18px; accent-color: #2F3E2A;" />
                            <span>Address Verified 📍</span>
                        </label>
                        <label
                            style="display: flex; align-items: center; gap: 10px; padding: 10px; background: #FFFFFF; border-radius: 10px; cursor: pointer;">
                            <input type="checkbox" @bind="verifyEmployment"
                                style="width: 18px; height: 18px; accent-color: #2F3E2A;" />
                            <span>Employment Verified 💼</span>
                        </label>
                    </div>
                </div>

                <!-- Document Upload Section -->
                <div
                    style="background: rgba(196, 154, 58, 0.15); border-radius: 14px; padding: 20px; margin-bottom: 24px; border: 1px solid rgba(196, 154, 58, 0.3);">
                    <h5 style="margin: 0 0 16px 0; color: #C49A3A; font-weight: 600;">📤 Upload Customer Documents</h5>
                    <p style="color: #C49A3A; font-size: 13px; margin-bottom: 16px;">Upload scanned copies of customer's
                        submitted documents:</p>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        @if (selectedApplication.ValidIdRequired)
                        {
                            <div style="background: #FFFFFF; padding: 12px; border-radius: 10px;">
                                <label style="display: block; margin-bottom: 6px; font-weight: 500; font-size: 13px;">Valid
                                    ID</label>
                                <InputFile OnChange="@(e => OnDocumentUpload(e, "ValidId"))" accept="image/*,.pdf"
                                    style="font-size: 12px; width: 100%;" />
                                @if (uploadedDocuments.ContainsKey("ValidId"))
                                {
                                    <span style="color: #4F6F52; font-size: 11px;">✅ Uploaded</span>
                                }
                            </div>
                        }
                        @if (selectedApplication.ProofOfIncomeRequired)
                        {
                            <div style="background: #FFFFFF; padding: 12px; border-radius: 10px;">
                                <label style="display: block; margin-bottom: 6px; font-weight: 500; font-size: 13px;">Proof of
                                    Income</label>
                                <InputFile OnChange="@(e => OnDocumentUpload(e, "ProofOfIncome"))" accept="image/*,.pdf"
                                    style="font-size: 12px; width: 100%;" />
                                @if (uploadedDocuments.ContainsKey("ProofOfIncome"))
                                {
                                    <span style="color: #4F6F52; font-size: 11px;">✅ Uploaded</span>
                                }
                            </div>
                        }
                        @if (selectedApplication.ProofOfBillingRequired)
                        {
                            <div style="background: #FFFFFF; padding: 12px; border-radius: 10px;">
                                <label style="display: block; margin-bottom: 6px; font-weight: 500; font-size: 13px;">Proof of
                                    Billing</label>
                                <InputFile OnChange="@(e => OnDocumentUpload(e, "ProofOfBilling"))" accept="image/*,.pdf"
                                    style="font-size: 12px; width: 100%;" />
                                @if (uploadedDocuments.ContainsKey("ProofOfBilling"))
                                {
                                    <span style="color: #4F6F52; font-size: 11px;">✅ Uploaded</span>
                                }
                            </div>
                        }
                        @if (selectedApplication.BankStatementRequired)
                        {
                            <div style="background: #FFFFFF; padding: 12px; border-radius: 10px;">
                                <label style="display: block; margin-bottom: 6px; font-weight: 500; font-size: 13px;">Bank
                                    Statement</label>
                                <InputFile OnChange="@(e => OnDocumentUpload(e, "BankStatement"))" accept="image/*,.pdf"
                                    style="font-size: 12px; width: 100%;" />
                                @if (uploadedDocuments.ContainsKey("BankStatement"))
                                {
                                    <span style="color: #4F6F52; font-size: 11px;">✅ Uploaded</span>
                                }
                            </div>
                        }
                        @if (selectedApplication.COERequired)
                        {
                            <div style="background: #FFFFFF; padding: 12px; border-radius: 10px;">
                                <label
                                    style="display: block; margin-bottom: 6px; font-weight: 500; font-size: 13px;">Certificate
                                    of Employment</label>
                                <InputFile OnChange="@(e => OnDocumentUpload(e, "COE"))" accept="image/*,.pdf"
                                    style="font-size: 12px; width: 100%;" />
                                @if (uploadedDocuments.ContainsKey("COE"))
                                {
                                    <span style="color: #4F6F52; font-size: 11px;">✅ Uploaded</span>
                                }
                            </div>
                        }
                        @if (selectedApplication.TitleDeedRequired)
                        {
                            <div style="background: #FFFFFF; padding: 12px; border-radius: 10px;">
                                <label style="display: block; margin-bottom: 6px; font-weight: 500; font-size: 13px;">Title
                                    Deed</label>
                                <InputFile OnChange="@(e => OnDocumentUpload(e, "TitleDeed"))" accept="image/*,.pdf"
                                    style="font-size: 12px; width: 100%;" />
                                @if (uploadedDocuments.ContainsKey("TitleDeed"))
                                {
                                    <span style="color: #4F6F52; font-size: 11px;">✅ Uploaded</span>
                                }
                            </div>
                        }
                        @if (selectedApplication.ORCRRequired)
                        {
                            <div style="background: #FFFFFF; padding: 12px; border-radius: 10px;">
                                <label
                                    style="display: block; margin-bottom: 6px; font-weight: 500; font-size: 13px;">OR/CR</label>
                                <InputFile OnChange="@(e => OnDocumentUpload(e, "ORCR"))" accept="image/*,.pdf"
                                    style="font-size: 12px; width: 100%;" />
                                @if (uploadedDocuments.ContainsKey("ORCR"))
                                {
                                    <span style="color: #4F6F52; font-size: 11px;">✅ Uploaded</span>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Teller Remarks -->
                <div style="margin-bottom: 24px;">
                    <label style="display: block; margin-bottom: 8px; color: #2B2B2B; font-weight: 600;">📝 Teller
                        Remarks</label>
                    <textarea @bind="tellerRemarks" rows="3" placeholder="Enter your review notes and observations..."
                        style="width: 100%; padding: 12px; border: 2px solid #E2E2DC; border-radius: 10px; resize: vertical;"></textarea>
                </div>

                <!-- Action Buttons -->
                <div style="display: flex; gap: 12px; justify-content: flex-end;">
                    <button @onclick="CloseModal"
                        style="background: #FFFFFF; border: 2px solid #E2E2DC; color: #2B2B2B; padding: 12px 24px; border-radius: 10px; cursor: pointer; font-weight: 500;">
                        Cancel
                    </button>
                    <button @onclick="RejectApplication"
                        style="background: #9B3A3A; color: white; border: none; padding: 12px 24px; border-radius: 10px; cursor: pointer; font-weight: 500;">
                        ❌ Reject
                    </button>
                    <button @onclick="VerifyAndForward" disabled="@isProcessing"
                        style="background: #2F3E2A; color: white; border: none; padding: 12px 24px; border-radius: 10px; cursor: pointer; font-weight: 500;">
                        @(isProcessing ? "Processing..." : "✅ Verify & Forward to Accountant")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

