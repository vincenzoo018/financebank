@code {
    private enum Filters { Pending, Verified, Approved }
    private Filters currentFilter = Filters.Pending;

    private List<AssetApplication>? allApplications;
    private List<AssetApplication>? filteredApplications;
    private AssetApplication? selectedApplication;

    private bool isLoading = true;
    private bool isProcessing = false;
    private string successMessage = "";
    private string errorMessage = "";

    private bool showReviewModal = false;
    private bool showReleaseModal = false;
    private bool showDetailsModal = false;

    // Image slideshow
    private int currentImageIndex = 0;

    // Document upload
    private Dictionary<string, byte[]> uploadedDocuments = new Dictionary<string, byte[]>();

    // Review verification checkboxes
    private bool verifyValidId = false;
    private bool verifyProofOfIncome = false;
    private bool verifyProofOfBilling = false;
    private bool verifyBankStatement = false;
    private bool verifyCOE = false;
    private bool verifyBusinessPermit = false;
    private bool verifyTitleDeed = false;
    private bool verifyTaxDeclaration = false;
    private bool verifyORCR = false;
    private bool verifyAddress = false;
    private bool verifyEmployment = false;
    private string tellerRemarks = "";

    // Release checklist
    private bool confirmDownPayment = false;
    private bool confirmContractSigned = false;
    private bool confirmDocumentsComplete = false;
    private string contractNumber = "";
    private string releaseRemarks = "";
    private string deedOfSaleNumber = "";
    private string orNumber = "";
    private string crNumber = "";
    private int? linkedAccountId = null;

    // Account search for linking
    private string searchAccountNumber = "";
    private CustomerAccount? foundAccount = null;
    private string accountSearchError = "";

    private bool CanRelease => confirmDownPayment && confirmContractSigned && confirmDocumentsComplete;

    private int pendingCount => allApplications?.Count(a => a.Status == "SUBMITTED") ?? 0;
    private int verifiedCount => allApplications?.Count(a => a.Status == "VERIFIED" || a.Status == "ASSESSED") ?? 0;
    private int approvedCount => allApplications?.Count(a => a.Status == "APPROVED") ?? 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadApplications();
    }

    private async Task LoadApplications()
    {
        isLoading = true;
        try
        {
            using var db = await DbContextFactory.CreateDbContextAsync();
            allApplications = await db.AssetApplications
            .Include(a => a.Asset)
            .OrderByDescending(a => a.SubmittedAt)
            .ToListAsync();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading applications: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetFilter(Filters filter)
    {
        currentFilter = filter;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        filteredApplications = currentFilter switch
        {
            Filters.Pending => allApplications?.Where(a => a.Status == "SUBMITTED").ToList(),
            Filters.Verified => allApplications?.Where(a => a.Status == "VERIFIED" || a.Status == "ASSESSED").ToList(),
            Filters.Approved => allApplications?.Where(a => a.Status == "APPROVED").ToList(),
            _ => allApplications
        };
    }

    private void OpenReviewModal(AssetApplication app)
    {
        selectedApplication = app;
        ResetVerificationFlags();
        showReviewModal = true;
    }

    private void OpenReleaseModal(AssetApplication app)
    {
        selectedApplication = app;
        ResetReleaseFlags();
        showReleaseModal = true;
    }

    private void ViewDetails(AssetApplication app)
    {
        selectedApplication = app;
        showDetailsModal = true;
    }

    private void CloseModal()
    {
        showReviewModal = false;
        showReleaseModal = false;
        showDetailsModal = false;
        selectedApplication = null;
    }

    private void ResetVerificationFlags()
    {
        verifyValidId = false;
        verifyProofOfIncome = false;
        verifyProofOfBilling = false;
        verifyBankStatement = false;
        verifyCOE = false;
        verifyBusinessPermit = false;
        verifyTitleDeed = false;
        verifyTaxDeclaration = false;
        verifyORCR = false;
        verifyAddress = false;
        verifyEmployment = false;
        tellerRemarks = "";
    }

    private void ResetReleaseFlags()
    {
        confirmDownPayment = false;
        confirmContractSigned = false;
        confirmDocumentsComplete = false;
        contractNumber = AssetApplication.GenerateContractNumber();
        releaseRemarks = "";
        deedOfSaleNumber = "";
        orNumber = "";
        crNumber = "";
        linkedAccountId = null;
    }

    // Image slideshow methods
    private void PrevImage()
    {
        if (selectedApplication?.Asset?.Images != null)
        {
            var count = selectedApplication.Asset.Images.Count;
            currentImageIndex = (currentImageIndex - 1 + count) % count;
        }
    }

    private void NextImage()
    {
        if (selectedApplication?.Asset?.Images != null)
        {
            var count = selectedApplication.Asset.Images.Count;
            currentImageIndex = (currentImageIndex + 1) % count;
        }
    }

    private void SetImageIndex(int index)
    {
        currentImageIndex = index;
    }

    // Document upload method
    private async Task OnDocumentUpload(InputFileChangeEventArgs e, string documentType)
    {
        try
        {
            var file = e.File;
            if (file != null && file.Size > 0)
            {
                using var ms = new MemoryStream();
                await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);
                uploadedDocuments[documentType] = ms.ToArray();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error uploading {documentType}: {ex.Message}";
        }
    }

    private async Task VerifyAndForward()
    {
        if (selectedApplication == null) return;

        isProcessing = true;
        errorMessage = "";
        try
        {
            using var db = await DbContextFactory.CreateDbContextAsync();
            var app = await db.AssetApplications.FindAsync(selectedApplication.ApplicationId);
            if (app == null) throw new Exception("Application not found");

            var currentUser = AuthService.CurrentUser;
            app.Status = "VERIFIED";
            app.TellerReviewedBy = currentUser ?? "Teller";
            app.TellerReviewedAt = DateTime.Now;
            app.TellerRemarks = tellerRemarks;

            // Update document verification flags
            app.ValidIdSubmitted = verifyValidId;
            app.ProofOfIncomeSubmitted = verifyProofOfIncome;
            app.ProofOfBillingSubmitted = verifyProofOfBilling;
            app.BankStatementSubmitted = verifyBankStatement;
            app.COESubmitted = verifyCOE;
            app.BusinessPermitSubmitted = verifyBusinessPermit;
            app.TitleDeedSubmitted = verifyTitleDeed;
            app.TaxDeclarationSubmitted = verifyTaxDeclaration;
            app.ORCRSubmitted = verifyORCR;
            app.TellerVerifiedId = verifyValidId;
            app.TellerVerifiedIncome = verifyProofOfIncome;
            app.TellerVerifiedEmployment = verifyEmployment;
            app.TellerVerifiedAddress = verifyAddress;
            app.TellerVerifiedDocuments = true;

            // Save uploaded documents as JSON
            if (uploadedDocuments.Any())
            {
                var docInfo = uploadedDocuments.Select(d => new { Type = d.Key, Size = d.Value.Length }).ToList();
                app.UploadedDocuments = System.Text.Json.JsonSerializer.Serialize(docInfo);
            }

            await db.SaveChangesAsync();

            successMessage = $"Application {app.ApplicationNumber} verified and forwarded to Accountant!";
            CloseModal();
            await LoadApplications();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task RejectApplication()
    {
        if (selectedApplication == null) return;

        isProcessing = true;
        try
        {
            using var db = await DbContextFactory.CreateDbContextAsync();
            var app = await db.AssetApplications.FindAsync(selectedApplication.ApplicationId);
            if (app == null) throw new Exception("Application not found");

            var currentUser = AuthService.CurrentUser;
            app.Status = "REJECTED";
            app.TellerReviewedBy = currentUser ?? "Teller";
            app.TellerReviewedAt = DateTime.Now;
            app.TellerRemarks = string.IsNullOrEmpty(tellerRemarks) ? "Application rejected by teller" : tellerRemarks;

            await db.SaveChangesAsync();

            successMessage = $"Application {app.ApplicationNumber} has been rejected.";
            CloseModal();
            await LoadApplications();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void GenerateContract()
    {
        // Preview contract - in a real app this would open a PDF preview
        if (selectedApplication != null)
        {
            if (string.IsNullOrEmpty(contractNumber))
            {
                contractNumber = AssetApplication.GenerateContractNumber();
            }
            successMessage = $"Contract #{contractNumber} preview generated. Complete the release to finalize.";
        }
    }

    private async Task SearchAccountByNumber()
    {
        foundAccount = null;
        accountSearchError = "";

        if (string.IsNullOrWhiteSpace(searchAccountNumber))
        {
            accountSearchError = "Please enter an account number to search";
            return;
        }

        try
        {
            using var db = await DbContextFactory.CreateDbContextAsync();
            foundAccount = await db.CustomerAccounts
            .Include(a => a.Customer)
            .FirstOrDefaultAsync(a => a.AccountNumber == searchAccountNumber);

            if (foundAccount == null)
            {
                accountSearchError = $"No account found with number: {searchAccountNumber}";
            }
        }
        catch (Exception ex)
        {
            accountSearchError = $"Error searching: {ex.Message}";
        }
    }

    private void UseFoundAccount()
    {
        if (foundAccount != null)
        {
            linkedAccountId = foundAccount.AccountId;
            searchAccountNumber = "";
            foundAccount = null;
            accountSearchError = "";
        }
    }

    private async Task ReleaseAsset()
    {
        if (selectedApplication == null || !CanRelease) return;

        isProcessing = true;
        try
        {
            var currentUser = AuthService.CurrentUser;

            // Generate contract number if not provided
            if (string.IsNullOrEmpty(contractNumber))
            {
                contractNumber = AssetApplication.GenerateContractNumber();
            }

            // IMPORTANT: Update linked account BEFORE calling release service
            // This ensures the loan is created with the correct account ID
            if (selectedApplication.PurchaseType == "Loan" && linkedAccountId.HasValue && linkedAccountId.Value > 0)
            {
                using var db = await DbContextFactory.CreateDbContextAsync();
                var app = await db.AssetApplications.FindAsync(selectedApplication.ApplicationId);
                if (app != null)
                {
                    app.CustomerAccountId = linkedAccountId;
                    await db.SaveChangesAsync();
                }
            }
            else if (selectedApplication.PurchaseType == "Loan" && (!linkedAccountId.HasValue || linkedAccountId.Value == 0))
            {
                errorMessage = "Please enter a valid Customer Account ID to link the loan payments.";
                isProcessing = false;
                return;
            }

            // Use the enhanced method with GL posting
            var (success, message, loanId) = await AssetService.ReleaseAssetWithGLPostingAsync(
            selectedApplication.ApplicationId,
            releaseRemarks,
            currentUser ?? "Teller",
            deedOfSaleNumber: deedOfSaleNumber,
            orNumber: orNumber,
            crNumber: crNumber);

            if (success)
            {
                successMessage = message;
                if (loanId.HasValue)
                {
                    successMessage += $" | Loan ID: {loanId.Value} - Monthly payments integrated with Loan Payment module.";
                }
            }
            else
            {
                errorMessage = message;
            }

            CloseModal();
            await LoadApplications();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private (string bg, string color, string text) GetStatusStyle(string status)
    {
        return status switch
        {
            "SUBMITTED" => ("rgba(196, 154, 58, 0.15)", "#C49A3A", "Pending Review"),
            "VERIFIED" => ("rgba(79, 111, 82, 0.15)", "#4F6F52", "Verified"),
            "ASSESSED" => ("rgba(79, 111, 82, 0.15)", "#4F6F52", "Assessed"),
            "APPROVED" => ("rgba(79, 111, 82, 0.15)", "#4F6F52", "Approved"),
            "RELEASED" => ("rgba(95, 122, 106, 0.15)", "#5F7A6A", "Released"),
            "REJECTED" => ("rgba(155, 58, 58, 0.15)", "#9B3A3A", "Rejected"),
            _ => ("rgba(107, 107, 107, 0.15)", "#6B6B6B", status)
        };
    }
}