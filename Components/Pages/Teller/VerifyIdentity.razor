@page "/teller/verify-identity"
@using Microsoft.AspNetCore.Authorization
@using FinanceBank.Services
@using FinanceBank.Models
@layout TellerLayout
@inject LoanProcessService LoanProcessService
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Teller")]

<div class="card shadow">
        <div class="card-header bg-info text-white">
            <h4 class="mb-0"><i class="bi bi-check-circle"></i> Verify Customer Identity</h4>
        </div>
        <div class="card-body">
            @if (successMessage != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @successMessage
                    <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
                </div>
            }

            @if (errorMessage != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
                </div>
            }

            @if (pendingApplications == null)
            {
                <div class="text-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else if (pendingApplications.Count == 0)
            {
                <div class="alert alert-info">No pending applications for verification.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Application #</th>
                                <th>Customer</th>
                                <th>Loan Type</th>
                                <th>Amount</th>
                                <th>Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var app in pendingApplications)
                            {
                                <tr>
                                    <td><span class="badge bg-primary">@app.ApplicationNumber</span></td>
                                    <td>@app.Account?.Customer?.FullName</td>
                                    <td>@app.LoanType</td>
                                    <td>₱@app.RequestedAmount.ToString("N2")</td>
                                    <td>@app.ApplicationDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <button class="btn btn-sm btn-success" @onclick="() => VerifyAsync(app.ApplicationId)">
                                            <i class="bi bi-check-lg"></i> Verify
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

@code {
    private List<LoanApplication>? pendingApplications;
    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadPendingApplicationsAsync();
    }

    private async Task LoadPendingApplicationsAsync()
    {
        try
        {
            pendingApplications = await LoanProcessService.GetPendingApplicationsAsync("TELLER");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading applications: {ex.Message}";
        }
    }

    private async Task VerifyAsync(int applicationId)
    {
        try
        {
            await LoanProcessService.VerifyIdentityAsync(applicationId, "teller-user");
            successMessage = "Identity verified successfully!";
            await LoadPendingApplicationsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error verifying identity: {ex.Message}";
        }
    }
}
