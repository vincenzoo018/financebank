@code {
    private List<AccountUnlockRequest> unlockRequests = new();
    private string searchQuery = "";
    private string selectedStatus = "";

    // New Request Modal
    private bool showNewRequestModal = false;
    private string accountNumberSearch = "";
    private CustomerAccount? searchedAccount = null;
    private bool isAccountLocked = false; // Track lock status from AuditLogs
    private string accountLockReason = ""; // Lock reason from AuditLogs
    private bool isSearching = false;
    private bool isSubmitting = false;
    private string formMessage = "";
    private bool formSuccess = false;

    // Request form fields
    private bool identificationVerified = false;
    private string identificationType = "";
    private string identificationNumber = "";
    private string requestPriority = "Normal";
    private string lockReason = "";
    private string customerStatement = "";
    private string tellerNotes = "";

    // View Modal
    private bool showViewModal = false;
    private AccountUnlockRequest? viewRequest;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            using var context = await DbContextFactory.CreateDbContextAsync();
            var tellerId = AuthService.CurrentUserId;

            unlockRequests = await context.AccountUnlockRequests
            .Where(r => r.RequestedByTellerId == tellerId)
            .OrderByDescending(r => r.RequestedAt)
            .ToListAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading unlock requests: {ex.Message}");
            unlockRequests = new List<AccountUnlockRequest>();
        }
    }

    private List<AccountUnlockRequest> GetFilteredRequests()
    {
        var filtered = unlockRequests.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var search = searchQuery.ToLower();
            filtered = filtered.Where(r =>
            r.CustomerName.ToLower().Contains(search) ||
            r.CustomerUsername.ToLower().Contains(search) ||
            r.RequestId.ToString().Contains(search));
        }

        if (!string.IsNullOrEmpty(selectedStatus))
        {
            filtered = filtered.Where(r => r.Status == selectedStatus);
        }

        return filtered.ToList();
    }

    private async Task ApplyFilters()
    {
        await Task.CompletedTask;
        StateHasChanged();
    }

    private async Task ResetFilters()
    {
        searchQuery = "";
        selectedStatus = "";
        await Task.CompletedTask;
        StateHasChanged();
    }

    // New Request Modal Methods
    private void OpenNewRequestModal()
    {
        showNewRequestModal = true;
        accountNumberSearch = "";
        searchedAccount = null;
        formMessage = "";
        formSuccess = false;
        ResetFormFields();
    }

    private void CloseNewRequestModal()
    {
        showNewRequestModal = false;
        searchedAccount = null;
        accountNumberSearch = "";
        ResetFormFields();
    }

    private void ResetFormFields()
    {
        identificationVerified = false;
        identificationType = "";
        identificationNumber = "";
        requestPriority = "Normal";
        lockReason = "";
        customerStatement = "";
        tellerNotes = "";
        isAccountLocked = false;
        accountLockReason = "";
        formMessage = "";
        formSuccess = false;
    }

    private async Task SearchByAccountNumber()
    {
        if (string.IsNullOrWhiteSpace(accountNumberSearch))
        {
            formMessage = "Please enter an account number to search.";
            formSuccess = false;
            return;
        }

        isSearching = true;
        formMessage = "";
        searchedAccount = null;
        isAccountLocked = false;
        accountLockReason = "";
        StateHasChanged();

        try
        {
            using var context = await DbContextFactory.CreateDbContextAsync();
            var searchTerm = accountNumberSearch.Trim().ToUpper();

            // Search for the customer account by account number
            searchedAccount = await context.CustomerAccounts
            .Include(ca => ca.Customer)
            .FirstOrDefaultAsync(ca => ca.AccountNumber.ToUpper() == searchTerm);

            if (searchedAccount == null)
            {
                formMessage = $"No customer account found with number: {accountNumberSearch}. Please verify the account number (e.g., ACC-20251213-3043).";
                formSuccess = false;
            }
            else
            {
                // Check if account is locked by looking at AuditLogs
                // Check for fully locked (2 failed PIN attempts in 24 hours)
                var isFullyLocked = await context.AuditLogs
                .Where(a => a.CustomerAccountId == searchedAccount.CustomerId &&
                a.Action == "PIN_VERIFICATION_FAILED" &&
                a.PinAttemptCount >= 2 &&
                a.CreatedAt >= DateTime.Now.AddHours(-24))
                .AnyAsync();

                // Check if locked due to 5 failed password attempts
                var isPasswordLocked = await context.AuditLogs
                .Where(a => a.CustomerAccountId == searchedAccount.CustomerId &&
                a.IsAccountLocked == true &&
                a.Action == "MALICIOUS_ATTEMPT" &&
                a.CreatedAt >= DateTime.Now.AddHours(-24))
                .AnyAsync();

                // Check for admin unlock (which would clear the lock)
                var adminUnlock = await context.AuditLogs
                .Where(a => a.CustomerAccountId == searchedAccount.CustomerId &&
                a.Action == "ADMIN_ACCOUNT_UNLOCK" &&
                a.CreatedAt >= DateTime.Now.AddHours(-24))
                .OrderByDescending(a => a.CreatedAt)
                .FirstOrDefaultAsync();

                // Get latest lock event
                var lastLockEvent = await context.AuditLogs
                .Where(a => a.CustomerAccountId == searchedAccount.CustomerId &&
                (a.Action == "PIN_VERIFICATION_FAILED" || a.Action == "MALICIOUS_ATTEMPT") &&
                a.IsAccountLocked == true &&
                a.CreatedAt >= DateTime.Now.AddHours(-24))
                .OrderByDescending(a => a.CreatedAt)
                .FirstOrDefaultAsync();

                // Account is locked if there's a lock event and no subsequent admin unlock
                if (lastLockEvent != null)
                {
                    if (adminUnlock == null || adminUnlock.CreatedAt < lastLockEvent.CreatedAt)
                    {
                        isAccountLocked = true;
                        accountLockReason = lastLockEvent.LockReason ??
                        (lastLockEvent.Action == "PIN_VERIFICATION_FAILED"
                                                                                ? "Account locked due to 2 failed PIN attempts - requires Admin unlock"
                                                                                : "Account locked due to 5 failed password attempts - requires PIN or Admin unlock");
                    }
                }

                // Also check for explicit lock status
                if (!isAccountLocked && (isFullyLocked || isPasswordLocked))
                {
                    isAccountLocked = true;
                    accountLockReason = isFullyLocked
                    ? "Account fully locked due to failed PIN attempts - requires Admin unlock"
                                                                : "Account locked due to failed password attempts";
                }

                // Pre-fill lock reason
                lockReason = accountLockReason.Length > 0 ? accountLockReason : "Account locked for security purposes";
                formMessage = "";
            }
        }
        catch (Exception ex)
        {
            formMessage = $"Error searching: {ex.Message}";
            formSuccess = false;
        }
        finally
        {
            isSearching = false;
            StateHasChanged();
        }
    }

    // Confirmation popup state
    private bool showConfirmationPopup = false;
    private string confirmationTitle = "";
    private string confirmationMessage = "";
    private bool confirmationSuccess = false;

    private async Task SubmitUnlockRequest()
    {
        try
        {
            // Validation with proper error messages
            if (searchedAccount == null)
            {
                ShowConfirmation("❌ Validation Error", "Please search for an account first.", false);
                return;
            }

            if (!isAccountLocked)
            {
                ShowConfirmation("⚠️ Account Not Locked", "This account is not locked. No unlock request is needed.", false);
                return;
            }

            if (!identificationVerified)
            {
                ShowConfirmation("❌ Verification Required", "Please verify the customer's identity by checking the verification checkbox before submitting.", false);
                return;
            }

            if (string.IsNullOrWhiteSpace(identificationType))
            {
                ShowConfirmation("❌ ID Type Required", "Please select the type of ID presented by the customer.", false);
                return;
            }

            if (string.IsNullOrWhiteSpace(identificationNumber))
            {
                ShowConfirmation("❌ ID Number Required", "Please enter the last 4 digits of the customer's ID.", false);
                return;
            }

            isSubmitting = true;
            formMessage = "";
            StateHasChanged();

            using var context = await DbContextFactory.CreateDbContextAsync();

            // Check if there's already a pending request for this account
            var existingRequest = await context.AccountUnlockRequests
            .AnyAsync(r => r.CustomerUsername == searchedAccount.AccountNumber && r.Status == "Pending");

            if (existingRequest)
            {
                isSubmitting = false;
                ShowConfirmation("⚠️ Duplicate Request", "There is already a pending unlock request for this account. Please wait for admin to process the existing request.", false);
                return;
            }

            // Create the new request
            var request = new AccountUnlockRequest
            {
                CustomerId = searchedAccount.CustomerId,
                CustomerName = searchedAccount.Customer?.FullName ?? searchedAccount.Customer?.Username ?? "Unknown",
                CustomerUsername = searchedAccount.AccountNumber, // Store account number here
                CustomerEmail = searchedAccount.Customer?.Email,
                CustomerPhone = searchedAccount.Customer?.PhoneNumber,
                LockReason = !string.IsNullOrEmpty(accountLockReason) ? accountLockReason : "Account locked for security purposes",
                CustomerStatement = customerStatement,
                IdentificationVerified = identificationVerified,
                IdentificationType = identificationType,
                IdentificationNumber = identificationNumber,
                Status = "Pending",
                Priority = requestPriority,
                RequestedByTellerId = AuthService.CurrentUserId ?? 0,
                RequestedByTellerName = AuthService.FullName ?? AuthService.CurrentUser ?? "Teller",
                RequestedAt = DateTime.Now,
                TellerNotes = tellerNotes,
                CreatedAt = DateTime.Now
            };

            context.AccountUnlockRequests.Add(request);
            await context.SaveChangesAsync();

            // Reload data first
            await LoadData();

            // Close the new request modal
            showNewRequestModal = false;

            // Show success confirmation
            ShowConfirmation("✅ Request Submitted Successfully!",
            $"Unlock request for account {searchedAccount.AccountNumber} has been forwarded to the Admin.\n\n" +
            $"Request ID: REQ-{request.RequestId:D5}\n" +
            $"Customer: {request.CustomerName}\n" +
            $"Priority: {request.Priority}\n\n" +
            "The admin will review and process this request. You can track the status in your request history.",
            true);

            // Reset form fields for next use
            ResetFormFields();
            searchedAccount = null;
            accountNumberSearch = "";
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error submitting unlock request: {ex}");
            ShowConfirmation("❌ Submission Failed",
            $"Failed to submit unlock request. Please try again.\n\nError Details: {ex.Message}",
            false);
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private void ShowConfirmation(string title, string message, bool success)
    {
        confirmationTitle = title;
        confirmationMessage = message;
        confirmationSuccess = success;
        showConfirmationPopup = true;
        StateHasChanged();
    }

    private void CloseConfirmationPopup()
    {
        showConfirmationPopup = false;
        confirmationTitle = "";
        confirmationMessage = "";
        StateHasChanged();
    }

    // View Modal Methods
    private void OpenViewModal(AccountUnlockRequest request)
    {
        viewRequest = request;
        showViewModal = true;
    }

    private void CloseViewModal()
    {
        showViewModal = false;
        viewRequest = null;
    }

    // Helper Methods
    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, 1).ToUpper();
        return (parts[0].Substring(0, 1) + parts[^1].Substring(0, 1)).ToUpper();
    }

    private string TruncateText(string? text, int maxLength)
    {
        if (string.IsNullOrEmpty(text)) return "";
        return text.Length <= maxLength ? text : text.Substring(0, maxLength) + "...";
    }

    private string GetStatusBackground(string status) => status switch
    {
        "Pending" => "rgba(196, 154, 58, 0.15)",
        "Approved" => "rgba(79, 111, 82, 0.15)",
        "Rejected" => "rgba(155, 58, 58, 0.15)",
        _ => "#F7F7F4"
    };

    private string GetStatusColor(string status) => status switch
    {
        "Pending" => "#C49A3A",
        "Approved" => "#4F6F52",
        "Rejected" => "#9B3A3A",
        _ => "#6B6B6B"
    };

    private string GetPriorityBackground(string priority) => priority switch
    {
        "Low" => "rgba(95, 122, 106, 0.15)",
        "Normal" => "rgba(79, 111, 82, 0.15)",
        "High" => "rgba(196, 154, 58, 0.15)",
        "Urgent" => "rgba(155, 58, 58, 0.15)",
        _ => "#F7F7F4"
    };

    private string GetPriorityColor(string priority) => priority switch
    {
        "Low" => "#5F7A6A",
        "Normal" => "#4F6F52",
        "High" => "#C49A3A",
        "Urgent" => "#9B3A3A",
        _ => "#6B6B6B"
    };
}