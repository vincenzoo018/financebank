@page "/teller/funds-disbursement"
@using Microsoft.AspNetCore.Authorization
@using FinanceBank.Services
@using FinanceBank.Models
@layout TellerLayout
@inject LoanProcessService LoanProcessService
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Teller")]

<div class="card shadow">
        <div class="card-header bg-info text-white">
            <h4 class="mb-0"><i class="bi bi-cash-coin"></i> Funds Disbursement</h4>
        </div>
        <div class="card-body">
            @if (successMessage != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @successMessage
                    <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
                </div>
            }

            @if (errorMessage != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
                </div>
            }

            @if (approvedLoans == null)
            {
                <div class="text-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else if (approvedLoans.Count == 0)
            {
                <div class="alert alert-info">No approved loans ready for disbursement.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Approval ID</th>
                                <th>Customer</th>
                                <th>Loan Amount</th>
                                <th>Approved Amount</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var approval in approvedLoans)
                            {
                                <tr>
                                    <td><span class="badge bg-primary">APP-@approval.ApprovalId</span></td>
                                    <td>@approval.Account?.Customer?.FullName</td>
                                    <td>₱@approval.Account?.Balance.ToString("N2")</td>
                                    <td>₱@(approval.ApprovedAmount ?? 0).ToString("N2")</td>
                                    <td><span class="badge bg-success">@approval.ApprovalStatus</span></td>
                                    <td>
                                        <button class="btn btn-sm btn-success" @onclick="() => ShowDisbursementForm(approval)">
                                            <i class="bi bi-check-lg"></i> Disburse
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (selectedApproval != null)
            {
                <div class="card mt-4 border-success">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">Process Disbursement</h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Disbursement Amount (₱)</label>
                                <input type="number" class="form-control" @bind="disbursalAmount" step="0.01" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Disbursement Method</label>
                                <select class="form-select" @bind="disbursalMethod">
                                    <option value="Bank Transfer">Bank Transfer</option>
                                    <option value="Check">Check</option>
                                    <option value="Cash">Cash</option>
                                    <option value="Mobile Wallet">Mobile Wallet</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Reference Number</label>
                            <input type="text" class="form-control" @bind="disbursalReference" placeholder="e.g., TRX-2025-001" />
                        </div>
                        <div class="d-grid gap-2">
                            <button class="btn btn-success" @onclick="DisburseFundsAsync">
                                <i class="bi bi-check-lg"></i> Process Disbursement
                            </button>
                            <button class="btn btn-secondary" @onclick="CancelDisbursement">Cancel</button>
                        </div>
                    </div>
                </div>
            }

            @if (disbursalConfirmation != null)
            {
                <div class="card mt-4 border-success">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">Disbursement Confirmation</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>Amount Disbursed:</strong> ₱@disbursalConfirmation.DisbursalAmount.ToString("N2")</p>
                                <p><strong>Method:</strong> @disbursalConfirmation.DisbursalStatus</p>
                                <p><strong>Date:</strong> @disbursalConfirmation.DisbursalDate.ToString("yyyy-MM-dd HH:mm")</p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Reference:</strong> <span class="badge bg-primary">@disbursalConfirmation.Reference</span></p>
                                <p><strong>Processed By:</strong> @disbursalConfirmation.ProcessedBy</p>
                                <p><strong>Status:</strong> <span class="badge bg-success">RELEASED</span></p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

@code {
    private List<LoanApproval>? approvedLoans;
    private LoanApproval? selectedApproval;
    private decimal disbursalAmount;
    private string? disbursalMethod = "Bank Transfer";
    private string? disbursalReference;
    private LoanDisbursal? disbursalConfirmation;
    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadApprovedLoansAsync();
    }

    private async Task LoadApprovedLoansAsync()
    {
        try
        {
            approvedLoans = await LoanProcessService.GetApprovedLoansAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading approved loans: {ex.Message}";
        }
    }

    private void ShowDisbursementForm(LoanApproval approval)
    {
        selectedApproval = approval;
        disbursalAmount = approval.ApprovedAmount ?? 0;
        disbursalReference = $"REF-{DateTime.Now:yyyyMMddHHmmss}";
    }

    private async Task DisburseFundsAsync()
    {
        try
        {
            if (selectedApproval != null)
            {
                disbursalConfirmation = await LoanProcessService.ReleaseFundsAsync(
                    approvalId: selectedApproval.ApprovalId,
                    amount: disbursalAmount,
                    disbursedTo: disbursalMethod ?? "ACCOUNT",
                    processedBy: "teller-user"
                );

                successMessage = "Funds disbursed successfully!";
                selectedApproval = null;
                await LoadApprovedLoansAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error disbursing funds: {ex.Message}";
        }
    }

    private void CancelDisbursement()
    {
        selectedApproval = null;
    }
}
