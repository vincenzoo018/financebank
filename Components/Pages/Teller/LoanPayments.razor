@page "/teller/loan-payments"
@layout TellerLayout
@using FinanceBank.Models
@using FinanceBank.Services
@using Microsoft.EntityFrameworkCore
@using FinanceBank.Components.Shared
@inject LoanProcessService LoanService
@inject AuthService AuthService
@inject BFASDbContext DbContext
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="sidebar-content">
    <div class="card">
        <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h1 class="modal-title">💳 Process Loan Payment</h1>
                <p class="modal-subtitle">Physical cash/check payment processing with automatic penalty calculation</p>
            </div>
            <button @onclick="TogglePaymentHistory" 
                    style="background: linear-gradient(135deg, #3b82f6, #2563eb); color: white; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                Payment History
            </button>
        </div>

        <div class="card-body" style="padding: 24px;">
            <!-- Important Notice -->
            <div style="background: #dbeafe; border: 2px solid #3b82f6; border-radius: var(--radius-md); padding: 16px; margin-bottom: 20px;">
                <p style="margin: 0; color: #1e40af; font-weight: 600;">
                    💵 <strong>Physical Payment Mode:</strong> This system assumes customer pays in physical cash/check. 
                    Payment amounts are NOT deducted from the customer's bank account balance.
                </p>
            </div>

            <div class="form-group">
                <label class="form-label required">Account Number</label>
                <div style="display: flex; gap: 12px;">
                    <input type="text" class="form-control" @bind="searchAccountNumber" 
                           placeholder="Enter customer account number" style="flex: 1;" />
                    <button class="btn btn-primary" @onclick="SearchAccount">
                        Search
                    </button>
                </div>
            </div>

            @if (selectedAccount != null)
            {
                <div style="background: var(--bg-lighter); border-radius: var(--radius-md); padding: 20px; margin-bottom: 20px;">
                    <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 12px;">Customer Information</h3>
                    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;">
                        <div>
                            <span style="font-size: 13px; color: var(--text-gray); display: block;">Name</span>
                            <span style="font-size: 15px; font-weight: 600;">@selectedAccount.Customer?.FullName</span>
                        </div>
                        <div>
                            <span style="font-size: 13px; color: var(--text-gray); display: block;">Account Number</span>
                            <span style="font-size: 15px; font-weight: 600;">@selectedAccount.AccountNumber</span>
                        </div>
                    </div>
                </div>

                @if (activeLoans.Any())
                {
                    <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 16px;">Active Loans</h3>
                    <div style="display: grid; gap: 12px; margin-bottom: 24px;">
                        @foreach (var loan in activeLoans)
                        {
                            var schedule = GetNextPayment(loan.LoanId);
                            var daysOverdue = schedule != null && schedule.DueDate < DateTime.Today 
                                ? (DateTime.Today - schedule.DueDate).Days : 0;
                            var penalty = CalculatePenalty(schedule?.MinimumPayment ?? 0, daysOverdue);
                            var monthsElapsed = (int)((DateTime.Today - loan.StartDate).TotalDays / 30);
                            var paymentsRemaining = loan.TermMonths - monthsElapsed;

                            <div class="card" style="border: 2px solid @(daysOverdue > 5 ? "#dc2626" : "var(--border)"); cursor: pointer;" 
                                 @onclick="() => SelectLoan(loan, schedule, penalty, daysOverdue)">
                                <div style="display: flex; justify-content: space-between; align-items: start;">
                                    <div style="flex: 1;">
                                        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
                                            <h4 style="font-size: 16px; font-weight: 700; margin: 0;">
                                                @loan.LoanType - Loan #@loan.LoanNumber
                                            </h4>
                                            <span style="background: @(daysOverdue > 0 ? "#fee2e2" : "#d1fae5"); color: @(daysOverdue > 0 ? "#dc2626" : "#059669"); padding: 2px 10px; border-radius: 20px; font-size: 11px; font-weight: 600;">
                                                @(daysOverdue > 0 ? $"⚠️ {daysOverdue} DAYS OVERDUE" : "✓ Current")
                                            </span>
                                        </div>
                                        <div style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px;">
                                            <div>
                                                <span style="font-size: 11px; color: var(--text-gray); text-transform: uppercase;">Outstanding</span>
                                                <div style="font-size: 16px; font-weight: 700; color: var(--primary-green-start);">
                                                    ₱@loan.OutstandingBalance.ToString("N2")
                                                </div>
                                            </div>
                                            <div>
                                                <span style="font-size: 11px; color: var(--text-gray); text-transform: uppercase;">Monthly</span>
                                                <div style="font-size: 15px; font-weight: 600;">
                                                    ₱@loan.MonthlyPayment.ToString("N2")
                                                </div>
                                            </div>
                                            <div>
                                                <span style="font-size: 11px; color: var(--text-gray); text-transform: uppercase;">Due Date</span>
                                                <div style="font-size: 15px; font-weight: 600; color: @(daysOverdue > 0 ? "#dc2626" : "inherit");">
                                                    @(schedule?.DueDate.ToString("MMM dd") ?? "N/A")
                                                </div>
                                            </div>
                                            <div>
                                                <span style="font-size: 11px; color: var(--text-gray); text-transform: uppercase;">Progress</span>
                                                <div style="font-size: 15px; font-weight: 600;">
                                                    @monthsElapsed / @loan.TermMonths mo
                                                </div>
                                            </div>
                                            <div>
                                                <span style="font-size: 11px; color: var(--text-gray); text-transform: uppercase;">Interest Rate</span>
                                                <div style="font-size: 15px; font-weight: 600;">
                                                    @loan.InterestRate% p.a.
                                                </div>
                                            </div>
                                        </div>
                                        @if (daysOverdue > 0)
                                        {
                                            <div style="background: linear-gradient(135deg, #fee2e2, #fecaca); border-radius: 8px; padding: 12px; margin-top: 12px; display: flex; justify-content: space-between; align-items: center;">
                                                <div>
                                                    <span style="color: #991b1b; font-size: 12px; font-weight: 700; text-transform: uppercase;">Overdue Alert</span>
                                                    <p style="color: #dc2626; font-size: 13px; margin: 4px 0 0 0;">
                                                        ⚠️ Late for @daysOverdue day(s). Daily penalty rate: 0.05%
                                                    </p>
                                                </div>
                                                <div style="text-align: right;">
                                                    <span style="font-size: 11px; color: #991b1b;">Penalty Amount</span>
                                                    <div style="font-size: 18px; font-weight: 800; color: #dc2626;">₱@penalty.ToString("N2")</div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    <div style="display: flex; flex-direction: column; gap: 8px; margin-left: 16px;">
                                        <button class="btn btn-primary">
                                            💰 Pay Now
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div style="text-align: center; padding: 40px; background: #f8fafc; border-radius: 12px;">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5" style="margin: 0 auto 12px;">
                            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                            <path d="M12 12h.01"></path>
                        </svg>
                        <p style="color: var(--text-gray); font-weight: 600;">
                            No active loans found for this account.
                        </p>
                    </div>
                }
            }
        </div>
    </div>
</div>

@if (showPaymentModal && selectedLoan != null)
{
    <StepModal Title="Process Loan Payment" 
               Subtitle="@modalSubtitle"
               CurrentStep="currentStep"
               ShowSteps="true"
               IsVisible="showPaymentModal"
               OnClose="CloseModal"
               OnConfirm="ProcessPayment"
               OnStepChanged="HandleStepChanged"
               Step1Label="Payment Details"
               Step2Label="Confirmation"
               ConfirmButtonText="Process Payment"
               Step1Valid="@(paymentAmount > 0)"
               Step2Valid="true">
        
        <Step1Content>
            <div class="step-section">
                <h3 class="step-section-title">Loan Details</h3>
                
                <div style="background: var(--bg-lighter); border-radius: var(--radius-md); padding: 20px; margin-bottom: 20px;">
                    <div class="summary-row">
                        <span class="summary-label">Loan Number</span>
                        <span class="summary-value">@selectedLoan.LoanNumber</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">Loan Type</span>
                        <span class="summary-value">@selectedLoan.LoanType</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">Outstanding Balance</span>
                        <span class="summary-value highlight">₱@selectedLoan.OutstandingBalance.ToString("N2")</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">Monthly Payment</span>
                        <span class="summary-value">₱@selectedLoan.MonthlyPayment.ToString("N2")</span>
                    </div>
                    @if (nextPayment != null)
                    {
                        <div class="summary-row">
                            <span class="summary-label">Due Date</span>
                            <span class="summary-value" style="color: @(daysOverdue > 0 ? "var(--danger)" : "var(--text-dark)");">
                                @nextPayment.DueDate.ToString("MMMM dd, yyyy")
                            </span>
                        </div>
                        <div class="summary-row">
                            <span class="summary-label">Amount Due</span>
                            <span class="summary-value">₱@nextPayment.MinimumPayment.ToString("N2")</span>
                        </div>
                    }
                    @if (daysOverdue > 0)
                    {
                        <div class="summary-row">
                            <span class="summary-label">Days Overdue</span>
                            <span class="summary-value" style="color: var(--danger);">@daysOverdue days</span>
                        </div>
                        <div class="summary-row">
                            <span class="summary-label">Penalty (0.05% daily)</span>
                            <span class="summary-value" style="color: var(--danger);">₱@penaltyAmount.ToString("N2")</span>
                        </div>
                    }
                </div>

                <h3 class="step-section-title">Payment Information</h3>

                <div class="form-group">
                    <label class="form-label required">Payment Amount</label>
                    <input type="number" class="form-control" @bind="paymentAmount" step="0.01" 
                           placeholder="Enter payment amount" />
                    <span class="form-help">
                        Minimum due: ₱@((nextPayment?.MinimumPayment ?? 0) + penaltyAmount).ToString("N2")
                        @if (penaltyAmount > 0)
                        {
                            <span> (includes ₱@penaltyAmount.ToString("N2") penalty)</span>
                        }
                    </span>
                </div>

                <div class="form-group">
                    <label class="form-label required">Payment Method</label>
                    <select class="form-control" @bind="paymentMethod">
                        <option value="">-- Select Method --</option>
                        <option value="Cash">Cash</option>
                        <option value="Check">Check</option>
                        <option value="Bank Transfer">Bank Transfer</option>
                        <option value="Debit Card">Debit Card</option>
                        <option value="Credit Card">Credit Card</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Reference Number</label>
                    <input type="text" class="form-control" @bind="referenceNumber" 
                           placeholder="Check number, transfer ID, etc. (optional)" />
                </div>
            </div>
        </Step1Content>

        <Step2Content>
            <div class="confirmation-summary">
                <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 16px; color: var(--text-dark);">
                    ✓ Payment Confirmation
                </h3>
                
                <div class="summary-row">
                    <span class="summary-label">Customer</span>
                    <span class="summary-value">@selectedAccount?.Customer?.FullName</span>
                </div>
                <div class="summary-row">
                    <span class="summary-label">Loan Number</span>
                    <span class="summary-value">@selectedLoan.LoanNumber</span>
                </div>
                <div class="summary-row">
                    <span class="summary-label">Payment Amount</span>
                    <span class="summary-value highlight">₱@paymentAmount.ToString("N2")</span>
                </div>
                @if (penaltyAmount > 0)
                {
                    <div class="summary-row">
                        <span class="summary-label">Penalty Included</span>
                        <span class="summary-value" style="color: var(--danger);">₱@penaltyAmount.ToString("N2")</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">Principal Payment</span>
                        <span class="summary-value">₱@((paymentAmount - penaltyAmount).ToString("N2"))</span>
                    </div>
                }
                <div class="summary-row">
                    <span class="summary-label">Payment Method</span>
                    <span class="summary-value">@paymentMethod</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(referenceNumber))
                {
                    <div class="summary-row">
                        <span class="summary-label">Reference</span>
                        <span class="summary-value">@referenceNumber</span>
                    </div>
                }
                <div class="summary-row">
                    <span class="summary-label">New Balance</span>
                    <span class="summary-value">₱@((selectedLoan.OutstandingBalance - (paymentAmount - penaltyAmount)).ToString("N2"))</span>
                </div>
            </div>

            <div style="background: #dbeafe; border: 2px solid #3b82f6; border-radius: var(--radius-md); padding: 16px;">
                <p style="margin: 0; color: #1e40af; font-weight: 600;">
                    💵 <strong>Physical Payment:</strong> Payment received in cash/check. No deduction from customer's bank account.
                </p>
                <p style="margin: 8px 0 0 0; color: #1e40af;">
                    ℹ️ Payment receipt and invoice will be generated after confirmation.
                </p>
            </div>
        </Step2Content>
    </StepModal>
}

@if (showInvoice && lastPayment != null)
{
    <PaymentInvoice 
        Payment="@lastPayment"
        Loan="@selectedLoan"
        Account="@selectedAccount"
        OnClose="CloseInvoice" />
}

@* Payment History Modal *@
@if (showPaymentHistory)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.6); display: flex; align-items: center; justify-content: center; z-index: 1000; backdrop-filter: blur(4px);" @onclick="ClosePaymentHistory">
        <div style="background: white; border-radius: 20px; width: 95%; max-width: 1000px; max-height: 90vh; overflow: hidden; box-shadow: 0 25px 60px rgba(0,0,0,0.3); display: flex; flex-direction: column;" @onclick:stopPropagation>
            <div style="background: linear-gradient(135deg, #3b82f6, #2563eb); color: white; padding: 24px 28px; display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h4 style="margin: 0; font-weight: 700; font-size: 20px;">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 10px; vertical-align: middle;">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                        Loan Payment History
                    </h4>
                    <p style="margin: 6px 0 0 0; opacity: 0.9; font-size: 14px;">View all processed loan payments</p>
                </div>
                <button @onclick="ClosePaymentHistory" style="background: rgba(255,255,255,0.2); border: none; color: white; width: 36px; height: 36px; border-radius: 50%; cursor: pointer; font-size: 20px;">×</button>
            </div>

            <div style="padding: 24px; overflow-y: auto; flex: 1;">
                @if (isLoadingHistory)
                {
                    <div style="text-align: center; padding: 60px;">
                        <div style="width: 48px; height: 48px; border: 4px solid #e5e7eb; border-top-color: #3b82f6; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto;"></div>
                        <p style="margin-top: 16px; color: #6b7280;">Loading payment history...</p>
                    </div>
                }
                else if (paymentHistory == null || !paymentHistory.Any())
                {
                    <div style="text-align: center; padding: 60px;">
                        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5" style="margin: 0 auto 16px;">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        </svg>
                        <h5 style="color: #475569; font-weight: 600;">No Payment History</h5>
                        <p style="color: #94a3b8; font-size: 14px;">No loan payments have been processed today.</p>
                    </div>
                }
                else
                {
                    <div style="overflow-x: auto;">
                        <table style="width: 100%; border-collapse: separate; border-spacing: 0; font-size: 14px;">
                            <thead>
                                <tr style="background: linear-gradient(135deg, #f8fafc, #f1f5f9);">
                                    <th style="padding: 14px 12px; text-align: left; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">Payment ID</th>
                                    <th style="padding: 14px 12px; text-align: left; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">Customer</th>
                                    <th style="padding: 14px 12px; text-align: left; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">Loan #</th>
                                    <th style="padding: 14px 12px; text-align: right; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">Amount</th>
                                    <th style="padding: 14px 12px; text-align: center; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">Method</th>
                                    <th style="padding: 14px 12px; text-align: left; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">Processed By</th>
                                    <th style="padding: 14px 12px; text-align: left; font-weight: 600; color: #475569; font-size: 12px; text-transform: uppercase; border-bottom: 2px solid #e2e8f0;">Date/Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var payment in paymentHistory)
                                {
                                    <tr style="border-bottom: 1px solid #f1f5f9;">
                                        <td style="padding: 14px 12px;">
                                            <span style="background: linear-gradient(135deg, #dbeafe, #bfdbfe); color: #1e40af; padding: 4px 10px; border-radius: 6px; font-weight: 600; font-size: 12px;">PAY-@payment.PaymentId</span>
                                        </td>
                                        <td style="padding: 14px 12px; font-weight: 500; color: #1e293b;">@(payment.Loan?.Account?.Customer?.FullName ?? "N/A")</td>
                                        <td style="padding: 14px 12px; color: #64748b; font-family: monospace; font-size: 13px;">@(payment.Loan?.LoanNumber ?? "N/A")</td>
                                        <td style="padding: 14px 12px; text-align: right; font-weight: 700; color: #059669; font-size: 15px;">₱@payment.PaymentAmount.ToString("N2")</td>
                                        <td style="padding: 14px 12px; text-align: center;">
                                            <span style="background: #f3f4f6; color: #4b5563; padding: 4px 10px; border-radius: 4px; font-size: 12px; font-weight: 500;">@payment.PaymentMethod</span>
                                        </td>
                                        <td style="padding: 14px 12px; color: #475569;">@payment.ProcessedBy</td>
                                        <td style="padding: 14px 12px; color: #64748b;">@payment.PaymentDate.ToString("MMM dd, hh:mm tt")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    
                    <div style="background: linear-gradient(135deg, #f0fdf4, #dcfce7); border-radius: 10px; padding: 16px; margin-top: 20px; display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <span style="font-size: 13px; color: #059669; font-weight: 600;">Today's Total Collections</span>
                        </div>
                        <div style="font-size: 24px; font-weight: 800; color: #059669;">₱@paymentHistory.Sum(p => p.PaymentAmount).ToString("N2")</div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private string searchAccountNumber = "";
    private CustomerAccount? selectedAccount;
    private List<Loan> activeLoans = new();
    private Loan? selectedLoan;
    private LoanPaymentSchedule? nextPayment;
    private int daysOverdue;
    private decimal penaltyAmount;

    private bool showPaymentModal = false;
    private bool showInvoice = false;
    private bool showPaymentHistory = false;
    private bool isLoadingHistory = false;
    private int currentStep = 1;

    // Form fields
    private decimal paymentAmount;
    private string paymentMethod = "";
    private string referenceNumber = "";
    private LoanPayment? lastPayment;
    private List<LoanPayment> paymentHistory = new();

    // Preloaded payment schedules to avoid synchronous DB calls during render
    private Dictionary<int, LoanPaymentSchedule?> paymentSchedulesByLoanId = new();

    private string modalSubtitle => currentStep == 1 ? "Step 1: Enter payment details" : "Step 2: Confirm payment";

    private async Task TogglePaymentHistory()
    {
        showPaymentHistory = true;
        isLoadingHistory = true;
        StateHasChanged();
        
        try
        {
            var today = DateTime.Today;
            paymentHistory = await DbContext.LoanPayments
                .Include(p => p.Loan)
                    .ThenInclude(l => l!.Account)
                        .ThenInclude(a => a!.Customer)
                .Where(p => p.PaymentDate.Date == today)
                .OrderByDescending(p => p.PaymentDate)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading payment history: {ex.Message}");
        }
        finally
        {
            isLoadingHistory = false;
            StateHasChanged();
        }
    }

    private void ClosePaymentHistory()
    {
        showPaymentHistory = false;
        paymentHistory = new();
    }

    private async Task SearchAccount()
    {
        if (string.IsNullOrWhiteSpace(searchAccountNumber))
        {
            await JS.InvokeVoidAsync("alert", "Please enter an account number");
            return;
        }

        try
        {
            selectedAccount = await DbContext.CustomerAccounts
                .Include(a => a.Customer)
                .FirstOrDefaultAsync(a => a.AccountNumber == searchAccountNumber);

            if (selectedAccount == null)
            {
                await JS.InvokeVoidAsync("alert", "Account not found");
                return;
            }

            activeLoans = await LoanService.GetAccountLoansAsync(selectedAccount.AccountId);
            activeLoans = activeLoans.Where(l => l.Status == "ACTIVE" && l.OutstandingBalance > 0).ToList();

            // Preload all payment schedules for these loans to avoid sync DB calls during render
            paymentSchedulesByLoanId.Clear();
            if (activeLoans.Any())
            {
                var loanIds = activeLoans.Select(l => l.LoanId).ToList();
                var schedules = await DbContext.LoanPaymentSchedules
                    .Where(s => loanIds.Contains(s.LoanId) && s.PaymentStatus == "PENDING")
                    .OrderBy(s => s.DueDate)
                    .ToListAsync();

                // Group by loan and take the first (next due) for each
                foreach (var loanId in loanIds)
                {
                    paymentSchedulesByLoanId[loanId] = schedules
                        .Where(s => s.LoanId == loanId)
                        .FirstOrDefault();
                }
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
    }

    private LoanPaymentSchedule? GetNextPayment(int loanId)
    {
        // Return from preloaded dictionary instead of querying DB synchronously
        return paymentSchedulesByLoanId.TryGetValue(loanId, out var schedule) ? schedule : null;
    }

    private decimal CalculatePenalty(decimal amountDue, int daysLate)
    {
        if (daysLate <= 0) return 0;
        
        // 0.05% daily penalty on amount due
        decimal dailyRate = 0.0005m;
        return amountDue * dailyRate * daysLate;
    }

    private void SelectLoan(Loan loan, LoanPaymentSchedule? schedule, decimal penalty, int overdue)
    {
        selectedLoan = loan;
        nextPayment = schedule;
        penaltyAmount = penalty;
        daysOverdue = overdue;
        
        // Pre-fill payment amount with minimum due + penalty
        paymentAmount = (nextPayment?.MinimumPayment ?? loan.MonthlyPayment) + penaltyAmount;
        paymentMethod = "";
        referenceNumber = "";
        currentStep = 1;
        showPaymentModal = true;
    }

    private void CloseModal()
    {
        showPaymentModal = false;
        currentStep = 1;
    }

    private void HandleStepChanged(int step)
    {
        currentStep = step;
        StateHasChanged();
    }

    private bool ValidateStep1()
    {
        if (paymentAmount <= 0)
        {
            JS.InvokeVoidAsync("alert", "Please enter a valid payment amount");
            return false;
        }

        decimal minimumDue = (nextPayment?.MinimumPayment ?? 0) + penaltyAmount;
        if (paymentAmount < minimumDue)
        {
            JS.InvokeVoidAsync("alert", $"Payment amount must be at least ₱{minimumDue:N2}");
            return false;
        }

        if (string.IsNullOrWhiteSpace(paymentMethod))
        {
            JS.InvokeVoidAsync("alert", "Please select a payment method");
            return false;
        }

        return true;
    }

    private async Task ProcessPayment()
    {
        if (selectedLoan == null || nextPayment == null) return;

        try
        {
            var processedBy = AuthService.FullName ?? AuthService.CurrentUser ?? "Teller";

            // Process payment through service
            lastPayment = await LoanService.ProcessPaymentAsync(
                selectedLoan.LoanId,
                nextPayment.ScheduleId,
                paymentAmount,
                paymentMethod,
                processedBy,
                referenceNumber
            );

            showPaymentModal = false;
            showInvoice = true;

            // Refresh data
            await SearchAccount();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error processing payment: {ex.Message}");
        }
    }

    private void CloseInvoice()
    {
        showInvoice = false;
        lastPayment = null;
        selectedLoan = null;
    }
}
