@page "/teller/cash-summary"
@layout TellerLayout

<div style="padding: 24px; max-width: 1100px; margin: 0 auto;">
    <div style="background: linear-gradient(135deg, #0f172a, #020617); border-radius: 16px; padding: 24px; margin-bottom: 24px; color: white; display:flex; justify-content:space-between; align-items:center;">
        <div>
            <h1 style="font-size: 24px; font-weight: 700; margin: 0 0 4px 0;">Teller Cash Summary</h1>
            <p style="font-size: 14px; opacity: 0.9; margin: 0;">End-of-day overview of cash in and out.</p>
        </div>
    </div>

    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap:16px; margin-bottom:24px;">
        <div style="background:white; border-radius:16px; padding:20px; border:1px solid #e5e7eb;">
            <div style="font-size:12px; color:#6b7280; margin-bottom:4px;">Total Cash In</div>
            <div style="font-size:28px; font-weight:700; color:#16a34a;">₱0.00</div>
        </div>
        <div style="background:white; border-radius:16px; padding:20px; border:1px solid #e5e7eb;">
            <div style="font-size:12px; color:#6b7280; margin-bottom:4px;">Total Cash Out</div>
            <div style="font-size:28px; font-weight:700; color:#dc2626;">₱0.00</div>
        </div>
        <div style="background:white; border-radius:16px; padding:20px; border:1px solid #e5e7eb;">
            <div style="font-size:12px; color:#6b7280; margin-bottom:4px;">Net Cash</div>
            <div style="font-size:28px; font-weight:700; color:#0ea5e9;">₱0.00</div>
        </div>
    </div>

    <div style="background:white; border-radius:16px; padding:24px; border:1px solid #e5e7eb;">
        <h2 style="font-size:16px; font-weight:600; margin-bottom:12px;">Breakdown</h2>
        <p style="font-size:13px; color:#6b7280;">Placeholder page. You can later wire this to aggregate today's teller transactions.</p>
    </div>
</div>
