@page "/teller/contract-preparation"
@using Microsoft.AspNetCore.Authorization
@using FinanceBank.Services
@using FinanceBank.Models
@layout TellerLayout
@inject LoanProcessService LoanProcessService
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Teller")]

<div class="card shadow">
        <div class="card-header bg-info text-white">
            <h4 class="mb-0"><i class="bi bi-file-text"></i> Contract Preparation</h4>
        </div>
        <div class="card-body">
            @if (successMessage != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @successMessage
                    <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
                </div>
            }

            @if (errorMessage != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
                </div>
            }

            @if (approvedLoans == null)
            {
                <div class="text-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else if (approvedLoans.Count == 0)
            {
                <div class="alert alert-info">No approved loans pending contract preparation.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Approval ID</th>
                                <th>Customer</th>
                                <th>Loan Amount</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var approval in approvedLoans)
                            {
                                <tr>
                                    <td><span class="badge bg-primary">APP-@approval.ApprovalId</span></td>
                                    <td>@approval.Account?.Customer?.FullName</td>
                                    <td>₱@((approval.ApprovedAmount ?? 0).ToString("N2"))</td>
                                    <td><span class="badge bg-success">@approval.ApprovalStatus</span></td>
                                    <td>
                                        <button class="btn btn-sm btn-primary" @onclick="() => PrepareContractAsync(approval.ApprovalId)">
                                            <i class="bi bi-file-earmark-text"></i> Generate Contract
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (contractContent != null)
            {
                <div class="card mt-4 border-primary">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Generated Contract</h5>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-info">
                            <strong>Contract Preview:</strong>
                        </div>
                        <div class="contract-text" style="border: 1px solid #ccc; padding: 15px; max-height: 400px; overflow-y: auto; background-color: #f9f9f9; white-space: pre-wrap;">
                            @contractContent
                        </div>
                        <div class="mt-3">
                            <button class="btn btn-success" @onclick="DownloadContractAsync">
                                <i class="bi bi-download"></i> Download Contract
                            </button>
                            <button class="btn btn-secondary" @onclick="ClearContract">Close</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

@code {
    private List<LoanApproval>? approvedLoans;
    private string? contractContent;
    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadApprovedLoansAsync();
    }

    private async Task LoadApprovedLoansAsync()
    {
        try
        {
            approvedLoans = await LoanProcessService.GetApprovedLoansAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading approved loans: {ex.Message}";
        }
    }

    private async Task PrepareContractAsync(int approvalId)
    {
        try
        {
            contractContent = await LoanProcessService.PrepareContractAsync(approvalId);
            successMessage = "Contract generated successfully!";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error generating contract: {ex.Message}";
        }
    }

    private async Task DownloadContractAsync()
    {
        // Implementation for downloading contract
        // This would typically save the contract as PDF or document
        successMessage = "Contract download initiated!";
    }

    private void ClearContract()
    {
        contractContent = null;
    }
}
