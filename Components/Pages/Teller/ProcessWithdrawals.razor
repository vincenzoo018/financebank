@code {
    private string accountNumber = "";
    private string customerName = "";
    private string customerUsername = "";
    private int currentCustomerId = 0;
    private string availableBalance = "₱0.00";
    private decimal currentAccountBalance = 0;
    private decimal withdrawalAmount = 0;
    private string referenceNumber = "";
    private string withdrawalMethod = "";
    private string notes = "";
    private bool showError = false;
    private bool isLoading = false;
    private string errorMessage = "";
    private string successMessage = "";
    private string lastReceiptNumber = "";

    // Password verification fields
    private string customerPassword = "";
    private string passwordError = "";
    private int passwordAttempts = 0;
    private bool passwordVerified = false;

    // Customer PIN modal fields (for unlocking account after 5 failed attempts)
    private bool showCustomerPinModal = false;
    private string[] customerPinDigits = new string[4] { "", "", "", "" };
    private string customerPinError = "";
    private string customerPinSuccess = "";
    private bool isCustomerPinLoading = false;

    // Teller PIN verification fields
    private string tellerPin = "";
    private string tellerPinError = "";
    private int tellerPinAttempts = 0;
    private bool tellerPinVerified = false;

    // Transaction tracking
    private class TransactionRecord
    {
        public required string AccountNumber { get; set; }
        public required string CustomerName { get; set; }
        public decimal Amount { get; set; }
        public required string Method { get; set; }
        public DateTime Time { get; set; }
        public required string Reference { get; set; }
    }

    private List<TransactionRecord> todayTransactions = new();
    private bool showInvoiceModal = false;
    private bool showConfirmationModal = false;
    private TransactionRecord? selectedTransaction = null;

    protected override async Task OnInitializedAsync()
    {
        GenerateReferenceNumber();
        await LoadTodayTransactions();
    }

    private void GenerateReferenceNumber()
    {
        // Generate auto-filled reference number: WDR-YYYYMMDD-HHMMSS-XXXX
        var timestamp = DateTime.Now;
        var random = new Random().Next(1000, 9999);
        referenceNumber = $"WDR-{timestamp:yyyyMMdd}-{timestamp:HHmmss}-{random}";
    }

    private async Task OnAccountNumberChanged(ChangeEventArgs e)
    {
        accountNumber = e.Value?.ToString() ?? "";
        await LoadAccountDetails();
    }

    private async Task LoadAccountDetails()
    {
        if (string.IsNullOrWhiteSpace(accountNumber))
            return;

        var (success, account, message) = await TellerBankingService.GetAccountByNumberAsync(accountNumber);

        if (success && account != null)
        {
            customerName = account.Customer?.FullName ?? "";
            customerUsername = account.Customer?.Username ?? "";
            currentCustomerId = account.Customer?.UserId ?? 0;
            currentAccountBalance = account.Balance;
            availableBalance = $"₱{account.Balance:N2}";

            // Check if customer account is locked
            if (currentCustomerId > 0)
            {
                var (isLocked, lockType, reason) = await AuthService.IsAccountLockedAsync(customerUsername);
                if (isLocked)
                {
                    passwordError = $"⚠️ Customer account is locked ({lockType}). {reason ?? "Customer must verify their security PIN to unlock."}";
                    showCustomerPinModal = true;
                }
            }

            StateHasChanged();
        }
        else
        {
            customerName = "";
            customerUsername = "";
            currentCustomerId = 0;
            currentAccountBalance = 0;
            availableBalance = "₱0.00";
            StateHasChanged();
        }
    }

    private async Task VerifyPassword()
    {
        if (string.IsNullOrWhiteSpace(customerPassword))
        {
            passwordError = "Password is required";
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (passwordAttempts >= 5)
        {
            passwordError = "Maximum attempts exceeded. Customer must verify their security PIN.";
            showCustomerPinModal = true;
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            var (success, message, customerId) = await TellerBankingService.VerifyCustomerPasswordAsync(accountNumber,
            customerPassword);

            if (success)
            {
                passwordVerified = true;
                passwordError = "";
                customerPassword = "";
                successMessage = "✓ Customer password verified. Now enter your teller PIN.";

                // Reset failed attempts for the customer on successful verification
                if (currentCustomerId > 0)
                {
                    await AuthService.ResetFailedAttemptsAsync(currentCustomerId);
                }

                await InvokeAsync(StateHasChanged);
            }
            else
            {
                passwordAttempts++;

                // Log failed attempt to AuthService for tracking
                if (currentCustomerId > 0)
                {
                    await AuthService.LogTellerTransactionFailedPasswordAsync(
                    currentCustomerId,
                    customerName,
                    AuthService.CurrentUser ?? "Unknown Teller",
                    "Withdrawal"
                                        );

                    // Check if account is now locked (5 attempts)
                    var (isLocked, lockType, reason) = await AuthService.IsAccountLockedAsync(accountNumber.Contains("@") ? accountNumber :
                    customerUsername);
                    if (isLocked)
                    {
                        passwordError = $"Account locked ({lockType}) due to multiple failed attempts. {reason ?? "Customer must verify security PIN."}";
                        showCustomerPinModal = true;
                        await InvokeAsync(StateHasChanged);
                        return;
                    }
                }

                passwordError = $"Invalid password. {5 - passwordAttempts} attempts remaining.";
                customerPassword = "";
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            passwordAttempts++;
            passwordError = $"Error verifying password: {ex.Message}";
            customerPassword = "";
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CancelPasswordVerification()
    {
        customerPassword = "";
        passwordError = "";
        withdrawalAmount = 0;
        passwordVerified = false;
    }

    private async Task HandlePasswordKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await VerifyPassword();
        }
    }

    private async Task VerifyTellerPin()
    {
        if (string.IsNullOrWhiteSpace(tellerPin))
        {
            tellerPinError = "PIN is required";
            await InvokeAsync(StateHasChanged);
            return;
        }

        // Trim the PIN to remove any whitespace
        var pinToVerify = tellerPin.Trim();

        if (pinToVerify.Length != 4)
        {
            tellerPinError = "PIN must be exactly 4 digits";
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (!pinToVerify.All(char.IsDigit))
        {
            tellerPinError = "PIN must contain only numbers";
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (tellerPinAttempts >= 5)
        {
            tellerPinError = "Maximum attempts exceeded. Please contact your supervisor.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            // Get the current teller's user record (case-insensitive)
            using var context = await DbContextFactory.CreateDbContextAsync();
            var currentUsername = AuthService.CurrentUser?.Trim();

            if (string.IsNullOrEmpty(currentUsername))
            {
                tellerPinError = "No user logged in. Please log in again.";
                await InvokeAsync(StateHasChanged);
                return;
            }

            var tellerUser = await context.Users
            .FirstOrDefaultAsync(u => u.Username.ToLower() == currentUsername.ToLower());

            if (tellerUser == null)
            {
                tellerPinError = $"Teller account '{currentUsername}' not found in database";
                await InvokeAsync(StateHasChanged);
                return;
            }

            if (string.IsNullOrEmpty(tellerUser.TransferPinHash))
            {
                tellerPinError = $"No PIN set for teller '{currentUsername}'. Please set up your PIN in settings.";
                await InvokeAsync(StateHasChanged);
                return;
            }

            // Verify the PIN against the teller's stored PIN hash
            var isValidPin = PasswordHasher.VerifyPassword(pinToVerify, tellerUser.TransferPinHash);

            if (isValidPin)
            {
                tellerPinVerified = true;
                tellerPinError = "";
                tellerPin = "";
                successMessage = "✓ Both verifications complete. You can now process the withdrawal.";
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                tellerPinAttempts++;
                tellerPinError = $"Invalid PIN. {5 - tellerPinAttempts} attempts remaining.";
                tellerPin = "";
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            tellerPinAttempts++;
            tellerPinError = $"Error verifying PIN: {ex.Message}";
            tellerPin = "";
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CancelTellerPinVerification()
    {
        tellerPin = "";
        tellerPinError = "";
        tellerPinVerified = false;
        // Also reset password verification to start over
        passwordVerified = false;
        withdrawalAmount = 0;
    }

    private async Task HandleTellerPinKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await VerifyTellerPin();
        }
    }

    private async Task LoadTodayTransactions()
    {
        try
        {
            var transactions = await TellerBankingService.GetTodayTransactionsAsync();
            todayTransactions = transactions
            .Where(t => t.Type == "Withdrawal")
            .Select(t => new TransactionRecord
            {
                AccountNumber = t.AccountNumber,
                CustomerName = t.CustomerName,
                Amount = t.Amount,
                Method = t.Type,
                Time = t.Time,
                Reference = "REF-" + t.Time.Ticks.ToString().Substring(0, 8)
            })
            .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading transactions: {ex.Message}");
        }
    }

    private void ViewInvoice(TransactionRecord transaction)
    {
        selectedTransaction = transaction;
        showInvoiceModal = true;
    }

    private void CloseInvoiceModal()
    {
        showInvoiceModal = false;
        selectedTransaction = null;
    }

    private void PrintInvoice()
    {
        if (selectedTransaction == null)
            return;

        var trans = selectedTransaction;
        var invoiceContent = $@"
========================================================
                  WITHDRAWAL INVOICE                   
                  FinanceBank System                   
========================================================

Date & Time: {trans.Time:yyyy-MM-dd HH:mm:ss}
Reference: {trans.Reference}

========================================================
                  CUSTOMER INFORMATION                
