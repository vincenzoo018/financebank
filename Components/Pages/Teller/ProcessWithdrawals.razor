@page "/teller/withdrawals"
@layout TellerLayout
@inject AuthService AuthService
@inject TellerBankingService TellerBankingService
@using System.Collections.Generic
@using FinanceBank.Data
@using FinanceBank.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<BFASDbContext> DbContextFactory
@inject PasswordHashingService PasswordHasher

<!-- Header Title Card -->
<div style="background: linear-gradient(135deg, rgba(239, 68, 68, 0.1), rgba(220, 38, 38, 0.15)); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 16px; padding: 32px; margin-bottom: 32px; color: #991b1b;">
    <div style="display: flex; align-items: center; gap: 16px;">
        <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        <div>
            <h1 style="font-size: 28px; font-weight: 700; margin: 0;">Process Withdrawals</h1>
            <p style="margin: 4px 0 0; opacity: 0.7; font-size: 14px;">Record customer cash withdrawals</p>
        </div>
    </div>
</div>

<!-- Withdrawal Form -->
<div style="background: white; border-radius: 16px; padding: 32px; border: 1px solid #e5e7eb; margin-bottom: 32px;">
    <h3 style="margin: 0 0 24px; font-size: 18px; font-weight: 700; color: #1f2937;">New Withdrawal Transaction</h3>
    
    <form @onsubmit="ShowConfirmation" @onsubmit:preventDefault>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px;">
            <!-- Account Number -->
            <div>
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Account Number *</label>
                <input type="text" style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;" 
                       @bind="accountNumber" @oninput="OnAccountNumberChanged" placeholder="Enter account number..." />
                @if (showError && string.IsNullOrEmpty(accountNumber)) 
                { 
                    <span style="color: #dc2626; font-size: 12px;">Required</span> 
                }
            </div>

            <!-- Customer Name -->
            <div>
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Customer Name</label>
                <input type="text" style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px; background: #f9fafb;" 
                       @bind="customerName" placeholder="Auto-filled" readonly />
            </div>

            <!-- Available Balance -->
            <div>
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Available Balance</label>
                <input type="text" style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px; background: #f9fafb;" 
                       @bind="availableBalance" placeholder="₱0.00" readonly />
            </div>

            <!-- Withdrawal Amount -->
            <div>
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Withdrawal Amount (₱) *</label>
                <input type="number" style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;" 
                       @bind="withdrawalAmount" @bind:event="oninput" placeholder="0.00" step="0.01" />
                @if (showError && withdrawalAmount <= 0) 
                { 
                    <span style="color: #dc2626; font-size: 12px;">Amount must be greater than 0</span> 
                }
                @if (withdrawalAmount > 0 && currentAccountBalance > 0 && withdrawalAmount > currentAccountBalance)
                {
                    <span style="color: #dc2626; font-size: 12px; display: block; margin-top: 4px;">⚠️ Insufficient balance. Available: ₱@currentAccountBalance.ToString("N2")</span>
                }
            </div>

            <!-- Withdrawal Method -->
            <div>
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Withdrawal Method *</label>
                <select style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px;" @bind="withdrawalMethod">
                    <option value="">Select method...</option>
                    <option value="OTC">Over-the-Counter (OTC)</option>
                    <option value="ATM">ATM Withdrawal</option>
                    <option value="BankTransfer">Bank Transfer</option>
                </select>
                @if (showError && string.IsNullOrEmpty(withdrawalMethod)) 
                { 
                    <span style="color: #dc2626; font-size: 12px;">Required</span> 
                }
            </div>

            <!-- Reference Number -->
            <div>
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Reference Number</label>
                <input type="text" style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px; background: #fef2f2; color: #991b1b; font-weight: 600;" 
                       value="@referenceNumber" readonly placeholder="Auto-generated" />
                <span style="color: #dc2626; font-size: 11px; display: block; margin-top: 4px;">✓ Auto-generated reference number</span>
            </div>

            <!-- Notes -->
            <div style="grid-column: 1 / -1;">
                <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px;">Notes</label>
                <textarea style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px; font-family: inherit; resize: vertical; min-height: 80px;" 
                          @bind="notes" placeholder="Additional notes..."></textarea>
            </div>

            <!-- Password Verification (Inline) - Only show after amount entered -->
            @if (withdrawalAmount > 0 && !string.IsNullOrEmpty(accountNumber) && !passwordVerified)
            {
                <div style="grid-column: 1 / -1; background: #fef3c7; border: 2px solid #f59e0b; border-radius: 12px; padding: 20px; margin-top: 20px;">
                    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
                        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                        </svg>
                        <div>
                            <h4 style="margin: 0; font-size: 16px; font-weight: 700; color: #92400e;">Step 1: Customer Verification Required</h4>
                            <p style="margin: 4px 0 0; font-size: 13px; color: #92400e;">Customer must enter their <strong>LOGIN PASSWORD</strong> (not PIN) to authorize this withdrawal</p>
                        </div>
                    </div>

                    <div style="background: white; border-radius: 8px; padding: 16px;">
                        <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px; color: #1f2937;">Customer Login Password * <span style="font-weight: 400; color: #6b7280;">(The password customer uses to log in)</span></label>
                        <input type="password" 
                               style="width: 100%; padding: 12px; border: 2px solid #f59e0b; border-radius: 8px; font-size: 14px; font-family: monospace;" 
                               @bind="customerPassword" 
                               @onkeyup="HandlePasswordKeyUp"
                               placeholder="Enter customer's login password..."
                               autofocus="autofocus" />
                        
                        @if (!string.IsNullOrEmpty(passwordError))
                        {
                            <div style="color: #dc2626; font-size: 12px; margin-top: 8px;">
                                ❌ @passwordError
                                @if (passwordAttempts > 0)
                                {
                                    <span style="margin-left: 8px;">(@passwordAttempts/5 attempts)</span>
                                }
                            </div>
                        }

                        <div style="display: flex; gap: 12px; margin-top: 12px;">
                            <button type="button" 
                                    style="flex: 1; padding: 10px; background: #f3f4f6; color: #374151; border-radius: 6px; border: none; font-weight: 600; cursor: pointer;" 
                                    @onclick="CancelPasswordVerification">
                                Cancel
                            </button>
                            <button type="button" 
                                    style="flex: 1; padding: 10px; background: #f59e0b; color: white; border-radius: 6px; border: none; font-weight: 600; cursor: pointer; disabled: @(passwordAttempts >= 5)" 
                                    @onclick="VerifyPassword"
                                    disabled="@(passwordAttempts >= 5)">
                                Verify Password
                            </button>
                        </div>

                        @if (passwordAttempts >= 5)
                        {
                            <div style="color: #dc2626; font-size: 13px; margin-top: 12px; font-weight: 600;">
                                ⛔ Maximum password attempts exceeded. Please try again later.
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Teller PIN Verification - Only show after customer password is verified -->
            @if (passwordVerified && !tellerPinVerified)
            {
                <div style="grid-column: 1 / -1; background: #dbeafe; border: 2px solid #3b82f6; border-radius: 12px; padding: 20px; margin-top: 20px;">
                    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
                        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                        </svg>
                        <div>
                            <h4 style="margin: 0; font-size: 16px; font-weight: 700; color: #1e40af;">Step 2: Teller Authorization Required</h4>
                            <p style="margin: 4px 0 0; font-size: 13px; color: #1e40af;">Teller (@AuthService.CurrentUser) - Enter YOUR 4-digit PIN to authorize this withdrawal</p>
                        </div>
                    </div>

                    <div style="background: white; border-radius: 8px; padding: 16px;">
                        <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 8px; color: #1f2937;">Your Teller PIN * <span style="font-weight: 400; color: #6b7280;">(4 digits set during your account creation)</span></label>
                        <input type="password" 
                               style="width: 100%; padding: 12px; border: 2px solid #3b82f6; border-radius: 8px; font-size: 18px; letter-spacing: 8px; text-align: center;" 
                               @bind="tellerPin" 
                               @onkeyup="HandleTellerPinKeyUp"
                               placeholder="●●●●"
                               maxlength="4" />
                        
                        @if (!string.IsNullOrEmpty(tellerPinError))
                        {
                            <div style="color: #dc2626; font-size: 12px; margin-top: 8px;">
                                ❌ @tellerPinError
                                @if (tellerPinAttempts > 0)
                                {
                                    <span style="margin-left: 8px;">(@tellerPinAttempts/5 attempts)</span>
                                }
                            </div>
                        }

                        <div style="display: flex; gap: 12px; margin-top: 12px;">
                            <button type="button" 
                                    style="flex: 1; padding: 10px; background: #f3f4f6; color: #374151; border-radius: 6px; border: none; font-weight: 600; cursor: pointer;" 
                                    @onclick="CancelTellerPinVerification">
                                Cancel
                            </button>
                            <button type="button" 
                                    style="flex: 1; padding: 10px; background: #3b82f6; color: white; border-radius: 6px; border: none; font-weight: 600; cursor: pointer;" 
                                    @onclick="VerifyTellerPin"
                                    disabled="@(tellerPinAttempts >= 5)">
                                Verify PIN
                            </button>
                        </div>

                        @if (tellerPinAttempts >= 5)
                        {
                            <div style="color: #dc2626; font-size: 13px; margin-top: 12px; font-weight: 600;">
                                ⛔ Maximum PIN attempts exceeded. Please contact your supervisor.
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Messages -->
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div style="padding: 16px; background: #fee2e2; border-radius: 8px; color: #991b1b; margin-bottom: 20px; font-size: 14px;">
                <strong>Error:</strong> @errorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div style="padding: 16px; background: #d1fae5; border-radius: 8px; color: #065f46; margin-bottom: 20px; font-size: 14px;">
                <strong>Success:</strong> @successMessage
                @if (!string.IsNullOrEmpty(lastReceiptNumber))
                {
                    <div style="margin-top: 12px; font-size: 13px;">
                        Receipt #: <strong>@lastReceiptNumber</strong>
                        <button type="button" @onclick="PrintReceipt" style="margin-left: 12px; background: #dc2626; color: white; padding: 6px 12px; border-radius: 6px; border: none; cursor: pointer; font-weight: 600;">Print Receipt</button>
                    </div>
                }
            </div>
        }

        <!-- Buttons -->
        <div style="display: flex; gap: 12px; justify-content: flex-end;">
            <button type="button" style="background: #f3f4f6; color: #374151; padding: 12px 24px; border-radius: 8px; border: none; font-weight: 600; cursor: pointer;" @onclick="ResetForm">
                Reset
            </button>
            <button type="submit" 
                    style="background: linear-gradient(135deg, #dc2626, #991b1b); color: white; padding: 12px 32px; border-radius: 8px; border: none; font-weight: 600; cursor: pointer;" 
                    disabled="@(isLoading || !passwordVerified || !tellerPinVerified || passwordAttempts >= 5 || tellerPinAttempts >= 5)">
                @if (isLoading) { <span>Processing...</span> } 
                else if (passwordAttempts >= 5 || tellerPinAttempts >= 5) { <span>❌ Locked - Too Many Attempts</span> }
                else if (!passwordVerified && withdrawalAmount > 0) { <span>⚠️ Verify Customer Password First</span> }
                else if (passwordVerified && !tellerPinVerified) { <span>⚠️ Verify Teller PIN</span> }
                else { <span>Process Withdrawal</span> }
            </button>
        </div>
    </form>
</div>

<!-- Real-Time Transactions Table -->
<div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb;">
    <h3 style="margin: 0 0 20px; font-size: 18px; font-weight: 700; color: #1f2937;">Today's Withdrawals (Real-Time)</h3>
    
    @if (todayTransactions.Any())
    {
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="border-bottom: 2px solid #e5e7eb; background: #f9fafb;">
                        <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">ACCOUNT #</th>
                        <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">CUSTOMER</th>
                        <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">AMOUNT</th>
                        <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">METHOD</th>
                        <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">TIME</th>
                        <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 700; color: #6b7280;">STATUS</th>
                        <th style="padding: 12px; text-align: center; font-size: 12px; font-weight: 700; color: #6b7280;">ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var transaction in todayTransactions)
                    {
                        <tr style="border-bottom: 1px solid #e5e7eb; hover:background: #f9fafb;">
                            <td style="padding: 16px; font-weight: 600;">@transaction.AccountNumber</td>
                            <td style="padding: 16px;">@transaction.CustomerName</td>
                            <td style="padding: 16px; font-weight: 600; color: #dc2626;">₱@transaction.Amount.ToString("N2")</td>
                            <td style="padding: 16px; font-size: 12px;">@transaction.Method</td>
                            <td style="padding: 16px; font-size: 12px; color: #6b7280;">@transaction.Time.ToString("hh:mm tt")</td>
                            <td style="padding: 16px;"><span style="padding: 4px 12px; background: #d1fae5; color: #065f46; border-radius: 8px; font-size: 12px; font-weight: 600;">Completed</span></td>
                            <td style="padding: 16px; text-align: center;">
                                <button type="button" 
                                        @onclick="@(() => ViewInvoice(transaction))"
                                        style="background: #dc2626; color: white; padding: 6px 12px; border-radius: 6px; border: none; cursor: pointer; font-weight: 600; font-size: 12px;">
                                    📄 Invoice
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div style="padding: 32px; text-align: center; color: #6b7280;">
            <p style="margin: 0; font-size: 14px;">No withdrawals recorded today yet.</p>
        </div>
    }
</div>

<!-- Invoice Modal -->
@if (showInvoiceModal && selectedTransaction != null)
{
    var trans = selectedTransaction;
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000;" @onclick="CloseInvoiceModal">
        <div style="background: white; border-radius: 16px; padding: 32px; max-width: 600px; width: 90%; max-height: 90vh; overflow-y: auto; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);" @onclick:stopPropagation>
            <!-- Modal Header -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; border-bottom: 2px solid #e5e7eb; padding-bottom: 16px;">
                <h2 style="margin: 0; font-size: 20px; font-weight: 700; color: #1f2937;">Withdrawal Invoice</h2>
                <button type="button" @onclick="CloseInvoiceModal" style="background: none; border: none; font-size: 24px; cursor: pointer; color: #6b7280;">✕</button>
            </div>

            <!-- Invoice Content -->
            <div style="font-size: 14px; line-height: 1.8;">
                <!-- Header -->
                <div style="text-align: center; margin-bottom: 24px;">
                    <h3 style="margin: 0 0 8px; font-size: 18px; font-weight: 700; color: #dc2626;">WITHDRAWAL INVOICE</h3>
                    <p style="margin: 0; color: #6b7280; font-size: 12px;">FinanceBank System</p>
                </div>

                <!-- Customer Info -->
                <div style="background: #f9fafb; padding: 16px; border-radius: 8px; margin-bottom: 20px;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                        <div>
                            <p style="margin: 0 0 4px; color: #6b7280; font-size: 12px; font-weight: 600;">ACCOUNT NUMBER</p>
                            <p style="margin: 0; font-weight: 600; color: #1f2937;">@trans.AccountNumber</p>
                        </div>
                        <div>
                            <p style="margin: 0 0 4px; color: #6b7280; font-size: 12px; font-weight: 600;">CUSTOMER NAME</p>
                            <p style="margin: 0; font-weight: 600; color: #1f2937;">@trans.CustomerName</p>
                        </div>
                        <div>
                            <p style="margin: 0 0 4px; color: #6b7280; font-size: 12px; font-weight: 600;">DATE & TIME</p>
                            <p style="margin: 0; color: #1f2937;">@trans.Time.ToString("yyyy-MM-dd HH:mm:ss")</p>
                        </div>
                        <div>
                            <p style="margin: 0 0 4px; color: #6b7280; font-size: 12px; font-weight: 600;">WITHDRAWAL METHOD</p>
                            <p style="margin: 0; color: #1f2937;">@trans.Method</p>
                        </div>
                    </div>
                </div>

                <!-- Transaction Details -->
                <div style="background: #fef2f2; padding: 16px; border-radius: 8px; margin-bottom: 20px; border-left: 4px solid #dc2626;">
                    <p style="margin: 0 0 12px; color: #6b7280; font-size: 12px; font-weight: 600;">TRANSACTION DETAILS</p>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                        <div>
                            <p style="margin: 0 0 4px; color: #6b7280; font-size: 12px;">Withdrawal Amount</p>
                            <p style="margin: 0; font-size: 18px; font-weight: 700; color: #dc2626;">₱@trans.Amount.ToString("N2")</p>
                        </div>
                        <div>
                            <p style="margin: 0 0 4px; color: #6b7280; font-size: 12px;">Status</p>
                            <p style="margin: 0; font-weight: 600; color: #065f46;">✓ Completed</p>
                        </div>
                    </div>
                </div>

                <!-- Processing Info -->
                <div style="background: #f3f4f6; padding: 16px; border-radius: 8px;">
                    <p style="margin: 0 0 12px; color: #6b7280; font-size: 12px; font-weight: 600;">PROCESSING INFORMATION</p>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                        <div>
                            <p style="margin: 0 0 4px; color: #6b7280; font-size: 12px;">Processed By</p>
                            <p style="margin: 0; color: #1f2937;">@AuthService.CurrentUser</p>
                        </div>
                        <div>
                            <p style="margin: 0 0 4px; color: #6b7280; font-size: 12px;">Reference</p>
                            <p style="margin: 0; color: #1f2937;">@trans.Reference</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Buttons -->
            <div style="display: flex; gap: 12px; margin-top: 24px; padding-top: 16px; border-top: 1px solid #e5e7eb;">
                <button type="button" 
                        @onclick="PrintInvoice"
                        style="flex: 1; background: #dc2626; color: white; padding: 12px; border-radius: 8px; border: none; font-weight: 600; cursor: pointer;">
                    Print Invoice
                </button>
                <button type="button" 
                        @onclick="CloseInvoiceModal"
                        style="flex: 1; background: #f3f4f6; color: #374151; padding: 12px; border-radius: 8px; border: none; font-weight: 600; cursor: pointer;">
                    Close
                </button>
            </div>
        </div>
    </div>
}

<!-- Confirmation Modal -->
@if (showConfirmationModal)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1001;">
        <div style="background: white; border-radius: 16px; padding: 32px; max-width: 450px; width: 90%; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);">
            <!-- Warning Icon -->
            <div style="text-align: center; margin-bottom: 20px;">
                <div style="width: 64px; height: 64px; background: #fef3c7; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
                    <svg width="32" height="32" fill="none" stroke="#f59e0b" stroke-width="2">
                        <path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                    </svg>
                </div>
            </div>

            <h2 style="margin: 0 0 16px; font-size: 20px; font-weight: 700; color: #1f2937; text-align: center;">Confirm Withdrawal</h2>
            <p style="margin: 0 0 24px; color: #6b7280; text-align: center; font-size: 14px;">Are you sure you want to process this withdrawal?</p>

            <!-- Transaction Summary -->
            <div style="background: #fef2f2; border: 1px solid #fca5a5; border-radius: 12px; padding: 16px; margin-bottom: 24px;">
                <div style="display: grid; gap: 12px;">
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: #6b7280; font-size: 13px;">Account:</span>
                        <span style="font-weight: 600; color: #1f2937;">@accountNumber</span>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: #6b7280; font-size: 13px;">Customer:</span>
                        <span style="font-weight: 600; color: #1f2937;">@customerName</span>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: #6b7280; font-size: 13px;">Available Balance:</span>
                        <span style="font-weight: 600; color: #1f2937;">@availableBalance</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; padding-top: 12px; border-top: 1px dashed #fca5a5;">
                        <span style="color: #6b7280; font-size: 13px;">Withdrawal Amount:</span>
                        <span style="font-weight: 700; color: #dc2626; font-size: 18px;">₱@withdrawalAmount.ToString("N2")</span>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: #6b7280; font-size: 13px;">Method:</span>
                        <span style="font-weight: 600; color: #1f2937;">@withdrawalMethod</span>
                    </div>
                </div>
            </div>

            <!-- Buttons -->
            <div style="display: flex; gap: 12px;">
                <button type="button" 
                        @onclick="CancelConfirmation"
                        style="flex: 1; padding: 12px; background: #f3f4f6; color: #374151; border-radius: 8px; border: none; font-weight: 600; cursor: pointer;">
                    Cancel
                </button>
                <button type="button" 
                        @onclick="HandleWithdrawal"
                        disabled="@isLoading"
                        style="flex: 1; padding: 12px; background: linear-gradient(135deg, #dc2626, #991b1b); color: white; border-radius: 8px; border: none; font-weight: 600; cursor: pointer;">
                    @if (isLoading) { <span>Processing...</span> }
                    else { <span>✓ Yes, Process Withdrawal</span> }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private string accountNumber = "";
    private string customerName = "";
    private string availableBalance = "₱0.00";
    private decimal currentAccountBalance = 0;
    private decimal withdrawalAmount = 0;
    private string referenceNumber = "";
    private string withdrawalMethod = "";
    private string notes = "";
    private bool showError = false;
    private bool isLoading = false;
    private string errorMessage = "";
    private string successMessage = "";
    private string lastReceiptNumber = "";

    // Password verification fields
    private string customerPassword = "";
    private string passwordError = "";
    private int passwordAttempts = 0;
    private bool passwordVerified = false;

    // Teller PIN verification fields
    private string tellerPin = "";
    private string tellerPinError = "";
    private int tellerPinAttempts = 0;
    private bool tellerPinVerified = false;

    // Transaction tracking
    private class TransactionRecord
    {
        public required string AccountNumber { get; set; }
        public required string CustomerName { get; set; }
        public decimal Amount { get; set; }
        public required string Method { get; set; }
        public DateTime Time { get; set; }
        public required string Reference { get; set; }
    }

    private List<TransactionRecord> todayTransactions = new();
    private bool showInvoiceModal = false;
    private bool showConfirmationModal = false;
    private TransactionRecord? selectedTransaction = null;

    protected override async Task OnInitializedAsync()
    {
        GenerateReferenceNumber();
        await LoadTodayTransactions();
    }

    private void GenerateReferenceNumber()
    {
        // Generate auto-filled reference number: WDR-YYYYMMDD-HHMMSS-XXXX
        var timestamp = DateTime.Now;
        var random = new Random().Next(1000, 9999);
        referenceNumber = $"WDR-{timestamp:yyyyMMdd}-{timestamp:HHmmss}-{random}";
    }

    private async Task OnAccountNumberChanged(ChangeEventArgs e)
    {
        accountNumber = e.Value?.ToString() ?? "";
        await LoadAccountDetails();
    }

    private async Task LoadAccountDetails()
    {
        if (string.IsNullOrWhiteSpace(accountNumber))
            return;

        var (success, account, message) = await TellerBankingService.GetAccountByNumberAsync(accountNumber);
        
        if (success && account != null)
        {
            customerName = account.Customer?.FullName ?? "";
            currentAccountBalance = account.Balance;
            availableBalance = $"₱{account.Balance:N2}";
            StateHasChanged();
        }
        else
        {
            customerName = "";
            currentAccountBalance = 0;
            availableBalance = "₱0.00";
            StateHasChanged();
        }
    }

    private async Task VerifyPassword()
    {
        if (string.IsNullOrWhiteSpace(customerPassword))
        {
            passwordError = "Password is required";
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (passwordAttempts >= 5)
        {
            passwordError = "Maximum attempts exceeded. Please try again later.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            var (success, message, _) = await TellerBankingService.VerifyCustomerPasswordAsync(accountNumber, customerPassword);

            if (success)
            {
                passwordVerified = true;
                passwordError = "";
                customerPassword = "";
                successMessage = "✓ Customer password verified. Now enter your teller PIN.";
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                passwordAttempts++;
                passwordError = $"Invalid password. {5 - passwordAttempts} attempts remaining.";
                customerPassword = "";
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            passwordAttempts++;
            passwordError = $"Error verifying password: {ex.Message}";
            customerPassword = "";
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CancelPasswordVerification()
    {
        customerPassword = "";
        passwordError = "";
        withdrawalAmount = 0;
        passwordVerified = false;
    }

    private async Task HandlePasswordKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await VerifyPassword();
        }
    }

    private async Task VerifyTellerPin()
    {
        if (string.IsNullOrWhiteSpace(tellerPin))
        {
            tellerPinError = "PIN is required";
            await InvokeAsync(StateHasChanged);
            return;
        }

        // Trim the PIN to remove any whitespace
        var pinToVerify = tellerPin.Trim();

        if (pinToVerify.Length != 4)
        {
            tellerPinError = "PIN must be exactly 4 digits";
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (!pinToVerify.All(char.IsDigit))
        {
            tellerPinError = "PIN must contain only numbers";
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (tellerPinAttempts >= 5)
        {
            tellerPinError = "Maximum attempts exceeded. Please contact your supervisor.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            // Get the current teller's user record (case-insensitive)
            using var context = await DbContextFactory.CreateDbContextAsync();
            var currentUsername = AuthService.CurrentUser?.Trim();
            
            if (string.IsNullOrEmpty(currentUsername))
            {
                tellerPinError = "No user logged in. Please log in again.";
                await InvokeAsync(StateHasChanged);
                return;
            }

            var tellerUser = await context.Users
                .FirstOrDefaultAsync(u => u.Username.ToLower() == currentUsername.ToLower());

            if (tellerUser == null)
            {
                tellerPinError = $"Teller account '{currentUsername}' not found in database";
                await InvokeAsync(StateHasChanged);
                return;
            }

            if (string.IsNullOrEmpty(tellerUser.TransferPinHash))
            {
                tellerPinError = $"No PIN set for teller '{currentUsername}'. Please set up your PIN in settings.";
                await InvokeAsync(StateHasChanged);
                return;
            }

            // Verify the PIN against the teller's stored PIN hash
            var isValidPin = PasswordHasher.VerifyPassword(pinToVerify, tellerUser.TransferPinHash);

            if (isValidPin)
            {
                tellerPinVerified = true;
                tellerPinError = "";
                tellerPin = "";
                successMessage = "✓ Both verifications complete. You can now process the withdrawal.";
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                tellerPinAttempts++;
                tellerPinError = $"Invalid PIN. {5 - tellerPinAttempts} attempts remaining.";
                tellerPin = "";
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            tellerPinAttempts++;
            tellerPinError = $"Error verifying PIN: {ex.Message}";
            tellerPin = "";
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CancelTellerPinVerification()
    {
        tellerPin = "";
        tellerPinError = "";
        tellerPinVerified = false;
        // Also reset password verification to start over
        passwordVerified = false;
        withdrawalAmount = 0;
    }

    private async Task HandleTellerPinKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await VerifyTellerPin();
        }
    }

    private async Task LoadTodayTransactions()
    {
        try
        {
            var transactions = await TellerBankingService.GetTodayTransactionsAsync();
            todayTransactions = transactions
                .Where(t => t.Type == "Withdrawal")
                .Select(t => new TransactionRecord
                {
                    AccountNumber = t.AccountNumber,
                    CustomerName = t.CustomerName,
                    Amount = t.Amount,
                    Method = t.Type,
                    Time = t.Time,
                    Reference = "REF-" + t.Time.Ticks.ToString().Substring(0, 8)
                })
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading transactions: {ex.Message}");
        }
    }

    private void ViewInvoice(TransactionRecord transaction)
    {
        selectedTransaction = transaction;
        showInvoiceModal = true;
    }

    private void CloseInvoiceModal()
    {
        showInvoiceModal = false;
        selectedTransaction = null;
    }

    private void PrintInvoice()
    {
        if (selectedTransaction == null)
            return;

        var trans = selectedTransaction;
        var invoiceContent = $@"
========================================================
                  WITHDRAWAL INVOICE                   
                  FinanceBank System                   
========================================================

Date & Time:       {trans.Time:yyyy-MM-dd HH:mm:ss}
Reference:         {trans.Reference}

========================================================
                  CUSTOMER INFORMATION                
========================================================

Account Number:    {trans.AccountNumber}
Customer Name:     {trans.CustomerName}

========================================================
                  TRANSACTION DETAILS                 
========================================================

Withdrawal Amount: ₱{trans.Amount:N2}
Withdrawal Method: {trans.Method}
Status:            COMPLETED

========================================================
                PROCESSING INFORMATION               
========================================================

Processed By:      {AuthService.CurrentUser}
Date:              {DateTime.Now:yyyy-MM-dd HH:mm:ss}

========================================================
Thank you for banking with us!
Please keep this invoice for your records.
========================================================
";

        // Copy to clipboard and trigger print
        var printWindow = System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
        {
            FileName = "notepad.exe",
            Arguments = "-",
            UseShellExecute = false,
            RedirectStandardInput = true,
            CreateNoWindow = true
        });

        if (printWindow != null)
        {
            printWindow.StandardInput.WriteLine(invoiceContent);
            printWindow.StandardInput.Close();
        }
    }

    private void ShowConfirmation()
    {
        showError = true;
        errorMessage = "";
        successMessage = "";
        lastReceiptNumber = "";

        // Validation with specific error messages
        if (string.IsNullOrWhiteSpace(accountNumber))
        {
            errorMessage = "⚠️ Account number is required. Please enter a valid account number.";
            return;
        }

        if (string.IsNullOrWhiteSpace(customerName))
        {
            errorMessage = "⚠️ Invalid account number. Customer not found.";
            return;
        }

        if (withdrawalAmount <= 0)
        {
            errorMessage = "⚠️ Withdrawal amount must be greater than ₱0.00";
            return;
        }

        if (withdrawalAmount > currentAccountBalance)
        {
            errorMessage = $"⚠️ Insufficient balance. Available: ₱{currentAccountBalance:N2}";
            return;
        }

        if (string.IsNullOrWhiteSpace(withdrawalMethod))
        {
            errorMessage = "⚠️ Please select a withdrawal method";
            return;
        }

        if (!passwordVerified)
        {
            errorMessage = "⚠️ Customer password verification is required before processing";
            return;
        }

        if (!tellerPinVerified)
        {
            errorMessage = "⚠️ Teller PIN verification is required before processing";
            return;
        }

        // All validations passed, show confirmation modal
        showConfirmationModal = true;
    }

    private void CancelConfirmation()
    {
        showConfirmationModal = false;
    }

    private async Task HandleWithdrawal()
    {
        showConfirmationModal = false;
        isLoading = true;

        try
        {
            var (success, message, transaction, receiptNumber) = await TellerBankingService.ProcessWithdrawalAsync(
                accountNumber,
                withdrawalAmount,
                withdrawalMethod,
                referenceNumber,
                notes
            );

            if (success)
            {
                lastReceiptNumber = receiptNumber;
                successMessage = message;
                
                // Add to real-time transactions list
                todayTransactions.Insert(0, new TransactionRecord
                {
                    AccountNumber = accountNumber,
                    CustomerName = customerName,
                    Amount = withdrawalAmount,
                    Method = withdrawalMethod,
                    Time = DateTime.Now,
                    Reference = referenceNumber
                });
                
                await Task.Delay(2000);
                ResetForm();
            }
            else
            {
                errorMessage = message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void PrintReceipt()
    {
        if (string.IsNullOrEmpty(lastReceiptNumber))
            return;

        var receiptContent = $@"
========================================================
                  WITHDRAWAL RECEIPT                   
                  BFAS Banking System                  
========================================================

Receipt Number:    {lastReceiptNumber}
Date & Time:       {DateTime.Now:yyyy-MM-dd HH:mm:ss}

Account Number:    {accountNumber}
Customer Name:     {customerName}
Available Balance: {availableBalance}

Withdrawal Amount: ₱{withdrawalAmount:N2}
Withdrawal Method: {withdrawalMethod}
Reference:         {referenceNumber}

Notes:             {notes}

Processed By:      {AuthService.CurrentUser}
Status:            COMPLETED

========================================================
Thank you for banking with us!
Please keep this receipt for your records.
========================================================
";

        // Copy to clipboard and trigger print
        var printWindow = System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
        {
            FileName = "notepad.exe",
            Arguments = "-",
            UseShellExecute = false,
            RedirectStandardInput = true,
            CreateNoWindow = true
        });

        if (printWindow != null)
        {
            printWindow.StandardInput.WriteLine(receiptContent);
            printWindow.StandardInput.Close();
        }
    }

    private void ResetForm()
    {
        accountNumber = "";
        customerName = "";
        availableBalance = "₱0.00";
        currentAccountBalance = 0;
        withdrawalAmount = 0;
        withdrawalMethod = "";
        notes = "";
        showError = false;
        errorMessage = "";
        successMessage = "";
        lastReceiptNumber = "";
        
        // Reset password verification
        customerPassword = "";
        passwordError = "";
        passwordAttempts = 0;
        passwordVerified = false;
        
        // Reset teller PIN verification
        tellerPin = "";
        tellerPinError = "";
        tellerPinAttempts = 0;
        tellerPinVerified = false;
        
        // Generate new reference number
        GenerateReferenceNumber();
    }
}
