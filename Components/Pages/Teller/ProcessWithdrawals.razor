        }
    }

    private void ShowConfirmation()
    {
        showError = true;
        errorMessage = "";
        successMessage = "";
        lastReceiptNumber = "";

        // Validation with popup notifications
        if (string.IsNullOrWhiteSpace(accountNumber))
        {
            NotificationService.ShowError("Validation Error", "Account number is required. Please enter a valid account number.");
            return;
        }

        if (string.IsNullOrWhiteSpace(customerName))
        {
            NotificationService.ShowError("Validation Error", "Invalid account number. Customer not found.");
            return;
        }

        if (withdrawalAmount <= 0)
        {
            NotificationService.ShowError("Validation Error", "Withdrawal amount must be greater than ₱0.00");
            return;
        }

        if (withdrawalAmount > currentAccountBalance)
        {
            NotificationService.ShowError("Insufficient Balance", $"Available balance: ₱{currentAccountBalance:N2}. Cannot withdraw ₱{withdrawalAmount:N2}");
            return;
        }

        // Check minimum balance requirement - must leave at least ₱1.00 in account
        if ((currentAccountBalance - withdrawalAmount) <= 0.99m)
        {
            NotificationService.ShowError("Minimum Balance Required", $"Account must maintain a minimum balance of ₱1.00. Maximum withdrawal: ₱{(currentAccountBalance - 1):N2}");
            return;
        }

        if (string.IsNullOrWhiteSpace(withdrawalMethod))
        {
            NotificationService.ShowError("Validation Error", "Please select a withdrawal method before proceeding.");
            return;
        }

        if (!passwordVerified)
        {
            NotificationService.ShowError("Verification Required", "Customer password verification is required before processing.");
            return;
        }

        if (!tellerPinVerified)
        {
            NotificationService.ShowError("Verification Required", "Teller PIN verification is required before processing.");
            return;
        }

        // All validations passed, show confirmation modal
        showConfirmationModal = true;
    }

    private void CancelConfirmation()
    {
        showConfirmationModal = false;
    }

    private async Task HandleWithdrawal()
    {
        showConfirmationModal = false;
        isLoading = true;

        try
        {
            var (success, message, transaction, receiptNumber) = await TellerBankingService.ProcessWithdrawalAsync(
            accountNumber,
            withdrawalAmount,
            withdrawalMethod,
            referenceNumber,
            notes
            );

            if (success)
            {
                lastReceiptNumber = receiptNumber;
                successMessage = message;

                // Add to real-time transactions list
                todayTransactions.Insert(0, new TransactionRecord
                {
                    AccountNumber = accountNumber,
                    CustomerName = customerName,
                    Amount = withdrawalAmount,
                    Method = withdrawalMethod,
                    Time = DateTime.Now,
                    Reference = referenceNumber
                });

                await Task.Delay(2000);
                ResetForm();
            }
            else
            {
                errorMessage = message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void PrintReceipt()
    {
        if (string.IsNullOrEmpty(lastReceiptNumber))
            return;

        var receiptContent = $@"
========================================================
                  WITHDRAWAL RECEIPT                   
                  BFAS Banking System                  
========================================================

Receipt Number: {lastReceiptNumber}
Date & Time: {DateTime.Now:yyyy-MM-dd HH:mm:ss}

Account Number: {accountNumber}
Customer Name: {customerName}
Available Balance: {availableBalance}

Withdrawal Amount: ₱{withdrawalAmount:N2}
Withdrawal Method: {withdrawalMethod}
Reference: {referenceNumber}

Notes: {notes}

Processed By: {AuthService.CurrentUser}
Status: COMPLETED

========================================================
Thank you for banking with us!
Please keep this receipt for your records.
========================================================
";

        // Copy to clipboard and trigger print
        var printWindow = System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
        {
            FileName = "notepad.exe",
            Arguments = "-",
            UseShellExecute = false,
            RedirectStandardInput = true,
            CreateNoWindow = true
        });

        if (printWindow != null)
        {
            printWindow.StandardInput.WriteLine(receiptContent);
            printWindow.StandardInput.Close();
        }
    }

    private void ResetForm()
    {
        accountNumber = "";
        customerName = "";
        customerUsername = "";
        currentCustomerId = 0;
        availableBalance = "₱0.00";
        currentAccountBalance = 0;
        withdrawalAmount = 0;
        withdrawalMethod = "";
        notes = "";
        showError = false;
        errorMessage = "";
        successMessage = "";
        lastReceiptNumber = "";

        // Reset password verification
        customerPassword = "";
        passwordError = "";
        passwordAttempts = 0;
        passwordVerified = false;

        // Reset customer PIN modal
        showCustomerPinModal = false;
        customerPinDigits = new string[4] { "", "", "", "" };
        customerPinError = "";
        customerPinSuccess = "";
        isCustomerPinLoading = false;

        // Reset teller PIN verification
        tellerPin = "";
        tellerPinError = "";
        tellerPinAttempts = 0;
        tellerPinVerified = false;

        // Generate new reference number
        GenerateReferenceNumber();
    }

    // Customer Security PIN Modal Methods
    private void HandleCustomerPinInput(ChangeEventArgs e, int index)
    {
        var value = e.Value?.ToString() ?? "";
        if (value.Length > 0 && char.IsDigit(value[0]))
        {
            customerPinDigits[index] = value[0].ToString();
            StateHasChanged();
        }
        else
        {
            customerPinDigits[index] = "";
        }
    }

    private async Task VerifyCustomerSecurityPin()
    {
        customerPinError = "";
        customerPinSuccess = "";

        // Validate PIN
        var pin = string.Join("", customerPinDigits);
        if (pin.Length != 4)
        {
            customerPinError = "Please enter all 4 digits of the security PIN.";
            return;
        }

        isCustomerPinLoading = true;
        StateHasChanged();

        try
        {
            // First verify the PIN
            var (pinSuccess, pinMessage, attemptsRemaining) = await AuthService.VerifySecurityPinAsync(customerUsername, pin);

            if (pinSuccess)
            {
                // Then unlock the account
                var (unlockSuccess, unlockMessage) = await AuthService.UnlockAccountWithPinAsync(customerUsername);

                if (unlockSuccess)
                {
                    customerPinSuccess = "Account unlocked successfully! Customer can now verify their password.";
                    passwordAttempts = 0;
                    passwordError = "";

                    await Task.Delay(1500);
                    CloseCustomerPinModal();
                }
                else
                {
                    customerPinError = unlockMessage;
                }
            }
            else
            {
                customerPinError = pinMessage;
            }
        }
        catch (Exception ex)
        {
            customerPinError = $"Error: {ex.Message}";
        }
        finally
        {
            isCustomerPinLoading = false;
            StateHasChanged();
        }
    }

    private void CloseCustomerPinModal()
    {
        showCustomerPinModal = false;
        customerPinDigits = new string[4] { "", "", "", "" };
        customerPinError = "";
        customerPinSuccess = "";
        isCustomerPinLoading = false;
        StateHasChanged();
    }
}