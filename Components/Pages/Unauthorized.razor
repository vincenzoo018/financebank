@page "/unauthorized"
@inject NavigationManager Navigation

<div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #fee2e2 0%, #fecaca 50%, #fca5a5 100%); padding: 20px;">
    <div style="max-width: 600px; width: 100%; background: white; border-radius: 24px; padding: 48px; text-align: center; box-shadow: 0 20px 60px rgba(0,0,0,0.2);">
        <!-- Error Icon -->
        <div style="margin-bottom: 24px;">
            <svg width="80" height="80" fill="none" stroke="#dc2626" stroke-width="2" viewBox="0 0 24 24" style="margin: 0 auto;">
                <path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
        </div>

        <!-- Error Message -->
        <h1 style="font-size: 32px; font-weight: 800; color: #dc2626; margin-bottom: 16px;">Access Denied</h1>
        <p style="font-size: 16px; color: #6b7280; margin-bottom: 32px;">
            You don't have permission to access this page. This area is restricted to authorized users only.
        </p>

        <!-- Error Details -->
        <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 12px; padding: 20px; margin-bottom: 32px; text-align: left;">
            <h3 style="font-size: 14px; font-weight: 700; color: #991b1b; margin-bottom: 12px;">Why am I seeing this?</h3>
            <ul style="font-size: 14px; color: #7f1d1d; margin: 0; padding-left: 20px;">
                <li style="margin-bottom: 8px;">Your account role doesn't have access to this module</li>
                <li style="margin-bottom: 8px;">You may need to log in with a different account</li>
                <li>Contact your system administrator for access</li>
            </ul>
        </div>

        <!-- Action Buttons -->
        <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
            <button @onclick="GoBack" style="padding: 14px 28px; background: #dc2626; color: white; border: none; border-radius: 12px; font-size: 15px; font-weight: 600; cursor: pointer; transition: all 0.3s;">
                ← Go Back
            </button>
            <button @onclick="GoToDashboard" style="padding: 14px 28px; background: white; color: #374151; border: 2px solid #e5e7eb; border-radius: 12px; font-size: 15px; font-weight: 600; cursor: pointer; transition: all 0.3s;">
                🏠 Go to Dashboard
            </button>
            <button @onclick="Logout" style="padding: 14px 28px; background: #f3f4f6; color: #374151; border: none; border-radius: 12px; font-size: 15px; font-weight: 600; cursor: pointer; transition: all 0.3s;">
                🚪 Logout
            </button>
        </div>

        <!-- Help Section -->
        <div style="margin-top: 32px; padding-top: 24px; border-top: 1px solid #e5e7eb;">
            <p style="font-size: 13px; color: #6b7280; margin-bottom: 12px;">Need assistance?</p>
            <a href="mailto:support@bfas.com" style="font-size: 14px; color: #dc2626; text-decoration: none; font-weight: 600;">
                📧 Contact Support Team
            </a>
        </div>
    </div>
</div>

@code {
    private void GoBack()
    {
        Navigation.NavigateTo("/", true);
    }

    private void GoToDashboard()
    {
        Navigation.NavigateTo("/", true);
    }

    private void Logout()
    {
        Navigation.NavigateTo("/login", true);
    }
}

