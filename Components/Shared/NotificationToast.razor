@using FinanceBank.Services
@inject NotificationService NotificationService
@implements IDisposable

@if (isVisible)
{
    <div style="position: fixed; top: 20px; right: 20px; z-index: 9999; animation: slideInRight 0.3s ease-out;">
        <div style="background: @GetBackgroundGradient(); color: white; padding: 16px 24px; border-radius: 12px; box-shadow: 0 10px 40px @GetShadowColor(); display: flex; align-items: flex-start; gap: 14px; min-width: 320px; max-width: 450px; border: 1px solid @GetBorderColor();">
            <!-- Icon -->
            <div style="width: 28px; height: 28px; border-radius: 50%; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                @GetIcon()
            </div>
            
            <!-- Content -->
            <div style="flex: 1; min-width: 0;">
                <div style="font-weight: 700; font-size: 15px; margin-bottom: 4px;">@title</div>
                <div style="font-size: 13px; opacity: 0.95; line-height: 1.5; word-wrap: break-word;">@message</div>
            </div>
            
            <!-- Close Button -->
            <button @onclick="Close" style="background: rgba(255,255,255,0.2); border: none; color: white; cursor: pointer; padding: 4px 8px; font-size: 16px; line-height: 1; border-radius: 6px; transition: background 0.2s;">
                ✕
            </button>
        </div>
    </div>
}

@if (showConfirmDialog)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 10000; backdrop-filter: blur(4px); animation: fadeIn 0.2s ease-out;">
        <div style="background: white; border-radius: 16px; padding: 28px; max-width: 420px; width: 90%; box-shadow: 0 25px 60px rgba(0,0,0,0.3); animation: scaleIn 0.2s ease-out;">
            <!-- Header -->
            <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 16px;">
                <div style="width: 48px; height: 48px; border-radius: 12px; background: linear-gradient(135deg, #fef3c7, #fde68a); display: flex; align-items: center; justify-content: center;">
                    <svg width="24" height="24" fill="none" stroke="#d97706" stroke-width="2.5">
                        <path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                    </svg>
                </div>
                <div>
                    <h3 style="margin: 0; font-size: 18px; font-weight: 700; color: #111827;">@confirmTitle</h3>
                </div>
            </div>
            
            <!-- Message -->
            <p style="margin: 0 0 24px; color: #4b5563; font-size: 14px; line-height: 1.6;">@confirmMessage</p>
            
            <!-- Buttons -->
            <div style="display: flex; gap: 12px; justify-content: flex-end;">
                <button @onclick="HandleCancel" 
                        style="padding: 12px 24px; border-radius: 10px; border: 2px solid #e5e7eb; background: white; color: #374151; font-weight: 600; cursor: pointer; transition: all 0.2s;">
                    Cancel
                </button>
                <button @onclick="HandleConfirm" 
                        style="padding: 12px 24px; border-radius: 10px; border: none; background: linear-gradient(135deg, #059669, #047857); color: white; font-weight: 600; cursor: pointer; box-shadow: 0 4px 12px rgba(5,150,105,0.3); transition: all 0.2s;">
                    Confirm
                </button>
            </div>
        </div>
    </div>
}

<style>
    @@keyframes slideInRight {
        from {
            transform: translateX(100%);
            opacity: 0;
        }
        to {
            transform: translateX(0);
            opacity: 1;
        }
    }
    
    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    
    @@keyframes scaleIn {
        from {
            transform: scale(0.9);
            opacity: 0;
        }
        to {
            transform: scale(1);
            opacity: 1;
        }
    }
</style>

@code {
    private bool isVisible = false;
    private string title = "";
    private string message = "";
    private NotificationService.NotificationType notificationType;
    private Timer? dismissTimer;

    private bool showConfirmDialog = false;
    private string confirmTitle = "";
    private string confirmMessage = "";
    private Func<Task>? onConfirmCallback;
    private Func<Task>? onCancelCallback;

    protected override void OnInitialized()
    {
        NotificationService.OnNotify += HandleNotification;
        NotificationService.OnConfirm += HandleConfirmRequest;
    }

    private void HandleNotification(string notifyTitle, string notifyMessage, NotificationService.NotificationType type)
    {
        title = notifyTitle;
        message = notifyMessage;
        notificationType = type;
        isVisible = true;

        dismissTimer?.Dispose();
        dismissTimer = new Timer(_ => InvokeAsync(() =>
        {
            isVisible = false;
            StateHasChanged();
        }), null, type == NotificationService.NotificationType.Error ? 6000 : 4000, Timeout.Infinite);

        InvokeAsync(StateHasChanged);
    }

    private void HandleConfirmRequest(string title, string message, Func<Task> onConfirm, Func<Task>? onCancel)
    {
        confirmTitle = title;
        confirmMessage = message;
        onConfirmCallback = onConfirm;
        onCancelCallback = onCancel;
        showConfirmDialog = true;
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleConfirm()
    {
        showConfirmDialog = false;
        if (onConfirmCallback != null)
        {
            await onConfirmCallback();
        }
        StateHasChanged();
    }

    private async Task HandleCancel()
    {
        showConfirmDialog = false;
        if (onCancelCallback != null)
        {
            await onCancelCallback();
        }
        StateHasChanged();
    }

    private string GetBackgroundGradient() => notificationType switch
    {
        NotificationService.NotificationType.Success => "linear-gradient(135deg, #059669, #047857)",
        NotificationService.NotificationType.Error => "linear-gradient(135deg, #dc2626, #b91c1c)",
        NotificationService.NotificationType.Warning => "linear-gradient(135deg, #d97706, #b45309)",
        NotificationService.NotificationType.Info => "linear-gradient(135deg, #2563eb, #1d4ed8)",
        _ => "linear-gradient(135deg, #059669, #047857)"
    };

    private string GetShadowColor() => notificationType switch
    {
        NotificationService.NotificationType.Success => "rgba(5,150,105,0.4)",
        NotificationService.NotificationType.Error => "rgba(220,38,38,0.4)",
        NotificationService.NotificationType.Warning => "rgba(217,119,6,0.4)",
        NotificationService.NotificationType.Info => "rgba(37,99,235,0.4)",
        _ => "rgba(5,150,105,0.4)"
    };

    private string GetBorderColor() => notificationType switch
    {
        NotificationService.NotificationType.Success => "rgba(16,185,129,0.5)",
        NotificationService.NotificationType.Error => "rgba(248,113,113,0.5)",
        NotificationService.NotificationType.Warning => "rgba(251,191,36,0.5)",
        NotificationService.NotificationType.Info => "rgba(96,165,250,0.5)",
        _ => "rgba(16,185,129,0.5)"
    };

    private RenderFragment GetIcon() => notificationType switch
    {
        NotificationService.NotificationType.Success => @<svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l3 3 7-7"/></svg>,
        NotificationService.NotificationType.Error => @<svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 6l8 8M14 6l-8 8"/></svg>,
        NotificationService.NotificationType.Warning => @<svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M8 4v5m0 3h.01"/></svg>,
        NotificationService.NotificationType.Info => @<svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="8" cy="8" r="6"/><path d="M8 6v3m0 2h.01"/></svg>,
        _ => @<svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l3 3 7-7"/></svg>
    };

    public void Close()
    {
        isVisible = false;
        dismissTimer?.Dispose();
        dismissTimer = null;
        StateHasChanged();
    }

    public void Dispose()
    {
        NotificationService.OnNotify -= HandleNotification;
        NotificationService.OnConfirm -= HandleConfirmRequest;
        dismissTimer?.Dispose();
    }
}
