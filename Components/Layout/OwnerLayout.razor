@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject FinanceBank.Services.SaaS.SaaSOwnerService OwnerService

<div class="saas-layout">
    <!-- Sidebar -->
    <aside class="saas-sidebar @(sidebarCollapsed ? "collapsed" : "")">
        <div class="sidebar-header">
            <div class="logo-container">
                <img src="images/logo.png" alt="ERP Solutions" class="logo" onerror="this.style.display='none'" />
                <span class="logo-text" style="@(sidebarCollapsed ? "display:none" : "")">ERP Solutions</span>
            </div>
            <button class="toggle-btn" @onclick="ToggleSidebar">
                <span class="icon">@(sidebarCollapsed ? "→" : "←")</span>
            </button>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section">
                <span class="section-title" style="@(sidebarCollapsed ? "display:none" : "")">MAIN</span>
                <a href="/owner" class="nav-item @GetActiveClass("/owner")">
                    <span class="nav-icon">📊</span>
                    <span class="nav-text" style="@(sidebarCollapsed ? "display:none" : "")">Dashboard</span>
                </a>
            </div>

            <div class="nav-section">
                <span class="section-title" style="@(sidebarCollapsed ? "display:none" : "")">CLIENT MANAGEMENT</span>
                <a href="/owner/clients" class="nav-item @GetActiveClass("/owner/clients")">
                    <span class="nav-icon">🏢</span>
                    <span class="nav-text" style="@(sidebarCollapsed ? "display:none" : "")">Clients</span>
                </a>
                <a href="/owner/subscription-plans" class="nav-item @GetActiveClass("/owner/subscription-plans")">
                    <span class="nav-icon">📋</span>
                    <span class="nav-text" style="@(sidebarCollapsed ? "display:none" : "")">Subscriptions</span>
                </a>
            </div>

            <div class="nav-section">
                <span class="section-title" style="@(sidebarCollapsed ? "display:none" : "")">PRODUCTS</span>
                <a href="/owner/modules" class="nav-item @GetActiveClass("/owner/modules")">
                    <span class="nav-icon">📦</span>
                    <span class="nav-text" style="@(sidebarCollapsed ? "display:none" : "")">Modules</span>
                </a>
                <a href="/owner/plans" class="nav-item @GetActiveClass("/owner/plans")">
                    <span class="nav-icon">💎</span>
                    <span class="nav-text" style="@(sidebarCollapsed ? "display:none" : "")">Plans & Pricing</span>
                </a>
            </div>

            <div class="nav-section">
                <span class="section-title" style="@(sidebarCollapsed ? "display:none" : "")">BILLING</span>
                <a href="/owner/invoices" class="nav-item @GetActiveClass("/owner/invoices")">
                    <span class="nav-icon">📄</span>
                    <span class="nav-text" style="@(sidebarCollapsed ? "display:none" : "")">Invoices</span>
                </a>
                <a href="/owner/transactions" class="nav-item @GetActiveClass("/owner/transactions")">
                    <span class="nav-icon">💳</span>
                    <span class="nav-text" style="@(sidebarCollapsed ? "display:none" : "")">Transactions</span>
                </a>
                <a href="/owner/settings" class="nav-item @GetActiveClass("/owner/payment-methods")">
                    <span class="nav-icon">🏦</span>
                    <span class="nav-text" style="@(sidebarCollapsed ? "display:none" : "")">Payment Methods</span>
                </a>
            </div>

            <div class="nav-section">
                <span class="section-title" style="@(sidebarCollapsed ? "display:none" : "")">SUPPORT</span>
                <a href="/owner/tickets" class="nav-item @GetActiveClass("/owner/tickets")">
                    <span class="nav-icon">🎫</span>
                    <span class="nav-text" style="@(sidebarCollapsed ? "display:none" : "")">Support Tickets</span>
                </a>
            </div>

            <div class="nav-section">
                <span class="section-title" style="@(sidebarCollapsed ? "display:none" : "")">REPORTS</span>
                <a href="/owner/dashboard" class="nav-item @GetActiveClass("/owner/reports")">
                    <span class="nav-icon">📈</span>
                    <span class="nav-text" style="@(sidebarCollapsed ? "display:none" : "")">Revenue Reports</span>
                </a>
                <a href="/owner/transaction-management" class="nav-item @GetActiveClass("/owner/activity-log")">
                    <span class="nav-icon">📝</span>
                    <span class="nav-text" style="@(sidebarCollapsed ? "display:none" : "")">Activity Log</span>
                </a>
            </div>

            <div class="nav-section">
                <span class="section-title" style="@(sidebarCollapsed ? "display:none" : "")">SETTINGS</span>
                <a href="/owner/settings" class="nav-item @GetActiveClass("/owner/settings")">
                    <span class="nav-icon">⚙️</span>
                    <span class="nav-text" style="@(sidebarCollapsed ? "display:none" : "")">Settings</span>
                </a>
            </div>
        </nav>

        <div class="sidebar-footer">
            <a href="/owner/login" class="nav-item logout-btn" @onclick="Logout">
                <span class="nav-icon">🚪</span>
                <span class="nav-text" style="@(sidebarCollapsed ? "display:none" : "")">Logout</span>
            </a>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="saas-main">
        <!-- Top Header -->
        <header class="saas-header">
            <div class="header-left">
                <h1 class="page-title">@GetPageTitle()</h1>
            </div>
            <div class="header-right">
                <div class="header-search">
                    <input type="text" placeholder="Search clients, invoices..." class="search-input" />
                    <span class="search-icon">🔍</span>
                </div>
                <div class="header-notifications">
                    <button class="notification-btn">
                        <span class="icon">🔔</span>
                        <span class="badge">3</span>
                    </button>
                </div>
                <div class="header-profile">
                    <div class="profile-avatar">
                        <span>A</span>
                    </div>
                    <div class="profile-info">
                        <span class="profile-name">Administrator</span>
                        <span class="profile-role">System Owner</span>
                    </div>
                </div>
            </div>
        </header>

        <!-- Page Content -->
        <div class="saas-content">
            @Body
        </div>
    </main>
</div>

<style>
    :root {
        --saas-primary: #6366f1;
        --saas-primary-dark: #4f46e5;
        --saas-secondary: #8b5cf6;
        --saas-success: #10b981;
        --saas-warning: #f59e0b;
        --saas-danger: #ef4444;
        --saas-sidebar-bg: #1e1b4b;
        --saas-sidebar-text: #e0e7ff;
        --saas-sidebar-hover: #312e81;
        --saas-header-bg: #ffffff;
        --saas-content-bg: #f5f3ff;
        --saas-card-bg: #ffffff;
        --saas-text: #1f2937;
        --saas-text-muted: #6b7280;
        --saas-border: #e5e7eb;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .saas-layout {
        display: flex;
        min-height: 100vh;
        font-family: 'Inter', 'Segoe UI', sans-serif;
    }

    /* Sidebar Styles */
    .saas-sidebar {
        width: 260px;
        background: var(--saas-sidebar-bg);
        color: var(--saas-sidebar-text);
        display: flex;
        flex-direction: column;
        transition: width 0.3s ease;
        position: fixed;
        height: 100vh;
        z-index: 100;
    }

    .saas-sidebar.collapsed {
        width: 70px;
    }

    .sidebar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .logo-container {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .logo {
        width: 36px;
        height: 36px;
        border-radius: 8px;
    }

    .logo-text {
        font-size: 18px;
        font-weight: 700;
        color: white;
    }

    .toggle-btn {
        background: rgba(255, 255, 255, 0.1);
        border: none;
        color: var(--saas-sidebar-text);
        width: 28px;
        height: 28px;
        border-radius: 6px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .toggle-btn:hover {
        background: rgba(255, 255, 255, 0.2);
    }

    .sidebar-nav {
        flex: 1;
        overflow-y: auto;
        padding: 16px 12px;
    }

    .nav-section {
        margin-bottom: 24px;
    }

    .section-title {
        font-size: 10px;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.4);
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 8px 12px;
        display: block;
    }

    .nav-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        color: var(--saas-sidebar-text);
        text-decoration: none;
        border-radius: 8px;
        font-size: 14px;
        transition: all 0.2s ease;
        margin-bottom: 4px;
    }

    .nav-item:hover {
        background: var(--saas-sidebar-hover);
    }

    .nav-item.active {
        background: var(--saas-primary);
        color: white;
    }

    .nav-icon {
        font-size: 18px;
        width: 24px;
        text-align: center;
    }

    .sidebar-footer {
        padding: 16px 12px;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .logout-btn:hover {
        background: rgba(239, 68, 68, 0.2) !important;
    }

    /* Main Content */
    .saas-main {
        flex: 1;
        margin-left: 260px;
        min-height: 100vh;
        background: var(--saas-content-bg);
        transition: margin-left 0.3s ease;
    }

    .saas-sidebar.collapsed+.saas-main {
        margin-left: 70px;
    }

    .saas-header {
        background: var(--saas-header-bg);
        padding: 16px 32px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--saas-border);
        position: sticky;
        top: 0;
        z-index: 50;
    }

    .page-title {
        font-size: 20px;
        font-weight: 600;
        color: var(--saas-text);
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 24px;
    }

    .header-search {
        position: relative;
    }

    .search-input {
        width: 280px;
        padding: 10px 16px 10px 40px;
        border: 1px solid var(--saas-border);
        border-radius: 8px;
        font-size: 14px;
        background: #f9fafb;
    }

    .search-input:focus {
        outline: none;
        border-color: var(--saas-primary);
        background: white;
    }

    .search-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 16px;
    }

    .notification-btn {
        position: relative;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 20px;
        padding: 8px;
        border-radius: 8px;
    }

    .notification-btn:hover {
        background: #f3f4f6;
    }

    .notification-btn .badge {
        position: absolute;
        top: 4px;
        right: 4px;
        background: var(--saas-danger);
        color: white;
        font-size: 10px;
        padding: 2px 6px;
        border-radius: 10px;
    }

    .header-profile {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 8px 16px;
        background: #f9fafb;
        border-radius: 12px;
    }

    .profile-avatar {
        width: 36px;
        height: 36px;
        background: var(--saas-primary);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 600;
    }

    .profile-info {
        display: flex;
        flex-direction: column;
    }

    .profile-name {
        font-size: 14px;
        font-weight: 600;
        color: var(--saas-text);
    }

    .profile-role {
        font-size: 12px;
        color: var(--saas-text-muted);
    }

    .saas-content {
        padding: 32px;
        min-height: calc(100vh - 68px);
    }

    /* Scrollbar */
    .sidebar-nav::-webkit-scrollbar {
        width: 6px;
    }

    .sidebar-nav::-webkit-scrollbar-track {
        background: transparent;
    }

    .sidebar-nav::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.2);
        border-radius: 3px;
    }
</style>

@code {
    private bool sidebarCollapsed = false;

    private void ToggleSidebar()
    {
        sidebarCollapsed = !sidebarCollapsed;
    }

    private string GetActiveClass(string path)
    {
        var currentPath = Navigation.Uri.Replace(Navigation.BaseUri, "/");
        if (path == "/owner" && currentPath == "/owner")
            return "active";
        if (path != "/owner" && currentPath.StartsWith(path))
            return "active";
        return "";
    }

    private string GetPageTitle()
    {
        var path = Navigation.Uri.Replace(Navigation.BaseUri, "/");
        return path switch
        {
            "/owner" => "Dashboard",
            var p when p.StartsWith("/owner/clients") => "Client Management",
            var p when p.StartsWith("/owner/subscriptions") => "Subscriptions",
            var p when p.StartsWith("/owner/modules") => "System Modules",
            var p when p.StartsWith("/owner/plans") => "Plans & Pricing",
            var p when p.StartsWith("/owner/invoices") => "Invoices",
            var p when p.StartsWith("/owner/transactions") => "Transactions",
            var p when p.StartsWith("/owner/payment-methods") => "Payment Methods",
            var p when p.StartsWith("/owner/tickets") => "Support Tickets",
            var p when p.StartsWith("/owner/reports") => "Revenue Reports",
            var p when p.StartsWith("/owner/activity-log") => "Activity Log",
            var p when p.StartsWith("/owner/settings") => "Settings",
            _ => "SaaS Management"
        };
    }

    private void Logout()
    {
        Navigation.NavigateTo("/owner/login");
    }
}