@inherits LayoutComponentBase
@implements IDisposable
@using FinanceBank.Services
@using FinanceBank.Models
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject CustomerBankingService BankingService

@* Import Unified Design System *@
<link rel="stylesheet" href="css/unified-design-system.css" />

<div class="sidebar-container">
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">
            <div style="text-align: center;">
                <img src="images/finsys-logo.png" alt="FINSYS Logo" style="width: 80px; height: 80px; border-radius: 50%; object-fit: cover; margin-bottom: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.15);" />
                <div class="sidebar-logo">@customerName</div>
                <div class="sidebar-subtitle">Banking Portal</div>
            </div>
        </div>

        <div class="sidebar-nav">
            <!-- Main Section -->
            <div class="sidebar-section">
                <div class="sidebar-section-title">OVERVIEW</div>
                <a href="/customer/dashboard" class="sidebar-item @(IsActive("/customer/dashboard"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                    <span>Dashboard</span>
                </a>
            </div>

            <!-- Quick Transactions Section - BPI/BDO Style -->
            <div class="sidebar-section">
                <div class="sidebar-section-title">TRANSACTIONS</div>
                <a href="/customer/transfer-money" class="sidebar-item @(IsActive("/customer/transfer-money"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <polyline points="19 12 12 19 5 12"></polyline>
                    </svg>
                    <span>Send Money</span>
                </a>
                <a href="/customer/deposit" class="sidebar-item @(IsActive("/customer/deposit"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <polyline points="19 12 12 19 5 12"></polyline>
                    </svg>
                    <span>Deposit</span>
                </a>
                <a href="/customer/withdraw" class="sidebar-item @(IsActive("/customer/withdraw"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="3" width="20" height="14" rx="2"></rect>
                        <line x1="2" y1="17" x2="22" y2="17"></line>
                    </svg>
                    <span>Withdraw</span>
                </a>
                <a href="/customer/bills" class="sidebar-item @(IsActive("/customer/bills"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                    </svg>
                    <span>Pay Bills</span>
                </a>
            </div>

            <!-- Accounts & Cards Section -->
            <div class="sidebar-section">
                <div class="sidebar-section-title">ACCOUNTS & CARDS</div>
                <a href="/customer/transactions" class="sidebar-item @(IsActive("/customer/transactions"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="2" x2="12" y2="22"></line>
                        <path d="M17 5H9.5a1.5 1.5 0 0 0 0 3H17"></path>
                        <path d="M15 19H6.5a1.5 1.5 0 0 1 0-3H15"></path>
                    </svg>
                    <span>Transaction History</span>
                </a>
                <a href="/customer/cards" class="sidebar-item @(IsActive("/customer/cards"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="1" y="4" width="22" height="16" rx="2"></rect>
                        <line x1="1" y1="10" x2="23" y2="10"></line>
                    </svg>
                    <span>My Cards</span>
                </a>
                <a href="/customer/savings" class="sidebar-item @(IsActive("/customer/savings"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 21h18M3 10h18M5 6h14M7 3h10"></path>
                    </svg>
                    <span>Savings Account</span>
                </a>
            </div>

            <!-- Loans & Services Section -->
            <div class="sidebar-section">
                <div class="sidebar-section-title">SERVICES</div>
                <a href="/customer/loan-application" class="sidebar-item @(IsActive("/customer/loan-application"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <path d="M12 13v4m-2-2h4"></path>
                    </svg>
                    <span>Apply for Loan</span>
                </a>
                <a href="/customer/loans" class="sidebar-item @(IsActive("/customer/loans"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                    <span>My Loans</span>
                </a>
                <a href="/customer/rewards" class="sidebar-item @(IsActive("/customer/rewards"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                    <span>Rewards</span>
                </a>
            </div>

            <!-- Settings Section -->
            <div class="sidebar-section">
                <div class="sidebar-section-title">ACCOUNT</div>
                <a href="/customer/profile" class="sidebar-item @(IsActive("/customer/profile"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                    <span>My Profile</span>
                </a>
                <a href="/customer/settings" class="sidebar-item @(IsActive("/customer/settings"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="3"></circle>
                        <path d="M12 1v6m0 6v6M4.22 4.22l4.24 4.24m5.08 5.08l4.24 4.24M1 12h6m6 0h6M4.22 19.78l4.24-4.24m5.08-5.08l4.24-4.24"></path>
                    </svg>
                    <span>Settings</span>
                </a>
            </div>
        </div>

    </div>

    <!-- Main Content Area -->
    <div class="sidebar-main">
        <div class="sidebar-topbar">
            <div class="topbar-title">@GetPageTitle()</div>
            <div class="topbar-user-menu">
                <button class="topbar-user-btn" @onclick="() => showUserMenu = !showUserMenu">
                    <div class="topbar-user-avatar">@userInitials</div>
                </button>
                @if (showUserMenu)
                {
                    <div class="topbar-user-dropdown">
                        <a href="/customer/settings" class="topbar-dropdown-item">
                            <svg class="topbar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="3"></circle>
                                <path d="M12 1v6m0 6v6M4.22 4.22l4.24 4.24m5.08 5.08l4.24 4.24M1 12h6m6 0h6M4.22 19.78l4.24-4.24m5.08-5.08l4.24-4.24"></path>
                            </svg>
                            <span>Settings</span>
                        </a>
                        <button class="topbar-dropdown-item logout-btn" @onclick="HandleLogout">
                            <svg class="topbar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                            <span>Logout</span>
                        </button>
                    </div>
                }
            </div>
        </div>
        <div class="sidebar-content">
            @Body
        </div>
    </div>
</div>

@code {
    private string customerName = "";
    private string userInitials = "";
    private decimal sidebarBalance = 0;
    private string maskedAccountNumber = "****";
    private bool showUserMenu = false;

    protected override async Task OnInitializedAsync()
    {
        customerName = AuthService.FullName ?? AuthService.CurrentUser ?? "Customer";
        userInitials = GetInitials(customerName);
        
        // Subscribe to authentication state changes
        AuthService.OnAuthStateChanged += OnAuthStateChanged;
        
        // Check if user is authenticated
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }
        
        // Check if user has customer role
        if (AuthService.CurrentRole != AuthService.Roles.Customer)
        {
            Navigation.NavigateTo("/admin/dashboard", forceLoad: true);
            return;
        }

        await LoadAccountBalanceAsync();
    }

    private async Task LoadAccountBalanceAsync()
    {
        try
        {
            var account = await BankingService.GetPrimaryAccountForCurrentCustomerAsync();
            if (account != null)
            {
                sidebarBalance = account.AvailableBalance;
                maskedAccountNumber = MaskAccountNumber(account.AccountNumber);
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error loading sidebar balance: {ex.Message}");
        }
    }
    
    private void OnAuthStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }
    
    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= OnAuthStateChanged;
    }

    private string IsActive(string path)
    {
        return Navigation.Uri.Contains(path) ? "active" : "";
    }

    private string GetPageTitle()
    {
        var path = Navigation.Uri;
        if (path.Contains("/dashboard")) return "Dashboard";
        // Removed My Accounts
        if (path.Contains("/deposit")) return "Deposit Money";
        if (path.Contains("/withdraw")) return "Withdraw Money";
        if (path.Contains("/transfer")) return "Transfer Money";
        if (path.Contains("/transactions")) return "Transactions";
        if (path.Contains("/bills")) return "Pay Bills";
        if (path.Contains("/cards")) return "Cards";
        if (path.Contains("/loan-application")) return "Apply for Loan";
        if (path.Contains("/loans")) return "Loans";
        if (path.Contains("/savings")) return "Savings";
        if (path.Contains("/rewards")) return "Rewards";
        if (path.Contains("/profile")) return "Profile";
        if (path.Contains("/settings")) return "Settings";
        return "Customer Portal";
    }

    private void HandleLogout()
    {
        AuthService.Logout();
        Navigation.NavigateTo("/login");
    }

    private string GetInitials(string name)
    {
        var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return (AuthService.CurrentUser ?? "U").Substring(0, 1).ToUpperInvariant();
        if (parts.Length == 1) return parts[0].Substring(0, 1).ToUpperInvariant();
        return (parts[0].Substring(0, 1) + parts[^1].Substring(0, 1)).ToUpperInvariant();
    }

    private static string FormatAmount(decimal amount) => $"₱{amount:N2}";

    private static string MaskAccountNumber(string accountNumber)
    {
        if (string.IsNullOrWhiteSpace(accountNumber) || accountNumber.Length < 4)
            return "****";
        return $"****{accountNumber[^4..]}";
    }
}

