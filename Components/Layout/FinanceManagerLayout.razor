@inherits LayoutComponentBase
@inject AuthService AuthService
@inject NavigationManager Navigation
@implements IDisposable

<div class="sidebar-container">
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">
            <div style="text-align: center;">
                <img src="images/finsys-logo.png" alt="FINSYS Logo"
                    style="width: 80px; height: 80px; border-radius: 50%; object-fit: cover; margin-bottom: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.15);" />
                <div class="sidebar-logo">FINSYS Finance Manager</div>
                <div class="sidebar-subtitle">Finance Portal</div>
            </div>
        </div>

        <div class="sidebar-nav">
            <!-- Main Section -->
            <div class="sidebar-section">
                <div class="sidebar-section-title">MAIN</div>
                <a href="/finance-manager/dashboard" class="sidebar-item @(IsActive("/finance-manager/dashboard"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                    <span>Dashboard</span>
                </a>
            </div>

            <!-- Loan Approvals -->
            <div class="sidebar-section">
                <div class="sidebar-section-title">LOAN APPROVAL</div>
                <a href="/finance-manager/loan-approvals"
                    class="sidebar-item @(IsActive("/finance-manager/loan-approvals"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 11l3 3L22 4"></path>
                        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                    </svg>
                    <span>Loan Approval Center</span>
                </a>
            </div>

            <!-- Finance - Finance Manager Specific -->
            <div class="sidebar-section">
                <div class="sidebar-section-title">FINANCE</div>
                <a href="/finance/payables" class="sidebar-item @(IsActive("/finance/payables"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2v20M2 12h20"></path>
                    </svg>
                    <span>Accounts Payable</span>
                </a>
                <a href="/finance/receivables" class="sidebar-item @(IsActive("/finance/receivables"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                    <span>Accounts Receivable</span>
                </a>
                <a href="/finance/expenses" class="sidebar-item @(IsActive("/finance/expenses"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="1"></circle>
                        <path d="M19.07 4.93l-2.58 2.58A8 8 0 1 0 20.5 12z"></path>
                    </svg>
                    <span>Expenses</span>
                </a>
                <a href="/finance/budget-management" class="sidebar-item @(IsActive("/finance/budget-management"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2v20M2 12h20"></path>
                    </svg>
                    <span>Budget Management</span>
                </a>
                <a href="/finance/cashflow-analysis" class="sidebar-item @(IsActive("/finance/cashflow-analysis"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                    <span>Cashflow Analysis</span>
                </a>
                <a href="/finance/financial-forecasting"
                    class="sidebar-item @(IsActive("/finance/financial-forecasting"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="1"></circle>
                        <path d="M19.07 4.93l-2.58 2.58A8 8 0 1 0 20.5 12z"></path>
                    </svg>
                    <span>Financial Forecasting</span>
                </a>
            </div>

            <!-- Finance Reports -->
            <div class="sidebar-section">
                <div class="sidebar-section-title">FINANCE REPORTS</div>
                <a href="/finance/budget-reports" class="sidebar-item @(IsActive("/finance/budget-reports"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="23 6 13.5 15.5 8.5 10.5 1 17"></polyline>
                        <polyline points="17 6 23 6 23 12"></polyline>
                    </svg>
                    <span>Budget Reports</span>
                </a>
                <a href="/finance/cashflow-reports" class="sidebar-item @(IsActive("/finance/cashflow-reports"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="23 6 13.5 15.5 8.5 10.5 1 17"></polyline>
                        <polyline points="17 6 23 6 23 12"></polyline>
                    </svg>
                    <span>Cashflow Reports</span>
                </a>
            </div>



        </div>

        <div class="sidebar-footer"></div>
    </div>

    <!-- Main Content Area -->
    <div class="sidebar-main">
        <div class="sidebar-topbar">
            <div class="topbar-title">@GetPageTitle()</div>
            <div style="display: flex; align-items: center; gap: 16px;">
                <div class="topbar-user-menu">
                    <button class="topbar-user-avatar" @onclick="() => showUserMenu = !showUserMenu"
                        style="background: linear-gradient(135deg, #3b82f6, #2563eb);">
                        @userInitials
                    </button>
                    @if (showUserMenu)
                    {
                        <div class="topbar-user-dropdown">
                            <button class="topbar-dropdown-item" @onclick="() => { showUserMenu = false; }">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                    style="margin-right: 8px;">
                                    <path d="M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16z"></path>
                                    <path d="M12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"></path>
                                </svg>
                                Settings
                            </button>
                            <button class="topbar-dropdown-item logout-btn" @onclick="HandleLogout">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                    style="margin-right: 8px;">
                                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                    <polyline points="16 17 21 12 16 7"></polyline>
                                    <line x1="21" y1="12" x2="9" y2="12"></line>
                                </svg>
                                Logout
                            </button>
                        </div>
                    }
                </div>
                <span
                    style="font-size: 12px; background: #3b82f6; color: white; padding: 4px 12px; border-radius: 20px; font-weight: 600;">Finance
                    Manager</span>
            </div>
        </div>
        <div class="sidebar-content">
            @Body
        </div>
    </div>
</div>

@code {
    private string userInitials = "FM";
    private bool showUserMenu = false;

    protected override void OnInitialized()
    {
        var displayName = AuthService.FullName ?? AuthService.CurrentUser ?? "Finance Manager";
        userInitials = GetInitials(displayName);
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrEmpty(name)) return "FM";
        var parts = name.Split(' ');
        return parts.Length >= 2
        ? $"{parts[0][0]}{parts[1][0]}".ToUpper()
        : $"{parts[0][0]}".ToUpper();
    }

    private string IsActive(string path)
    {
        return Navigation.Uri.Contains(path) ? "active" : "";
    }

    private string GetPageTitle()
    {
        var path = Navigation.Uri;
        if (path.Contains("/finance-manager/dashboard")) return "Finance Manager Dashboard";
        if (path.Contains("/dashboard")) return "Dashboard";
        if (path.Contains("/payables")) return "Accounts Payable";
        if (path.Contains("/receivables")) return "Accounts Receivable";
        if (path.Contains("/expenses")) return "Expenses";
        if (path.Contains("/budget-management")) return "Budget Management";
        if (path.Contains("/cashflow-analysis")) return "Cashflow Analysis";
        if (path.Contains("/financial-forecasting")) return "Financial Forecasting";
        if (path.Contains("/budget-reports")) return "Budget Reports";
        if (path.Contains("/cashflow-reports")) return "Cashflow Reports";
        if (path.Contains("/approval-queue")) return "Approval Queue";
        if (path.Contains("/approval-decision")) return "Approval Decision";
        return "Finance Manager Portal";
    }

    private void HandleLogout()
    {
        AuthService.Logout();
        Navigation.NavigateTo("/login", forceLoad: false);
    }

    public void Dispose()
    {
        // Cleanup if needed
    }
}