@inherits LayoutComponentBase
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject RoleBasedNavigationService RoleService

<div class="sidebar-container">
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">
            <div style="text-align: center;">
                <img src="images/finsys-logo.png" alt="FINSYS Logo" style="width: 80px; height: 80px; border-radius: 50%; object-fit: cover; margin-bottom: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.15);" />
                <div class="sidebar-logo">FINSYS @headerRoleTitle</div>
                <div class="sidebar-subtitle">Finance System</div>
            </div>
        </div>

        <div class="sidebar-nav" style="overflow-y: auto; max-height: calc(100vh - 200px);">
            <!-- Main Section -->
            <div class="sidebar-section">
                <div class="sidebar-section-title">MAIN</div>
                <a href="/admin/dashboard" class="sidebar-item @(IsActive("/admin/dashboard"))">
                    <span>🏠</span>
                    <span>Dashboard</span>
                </a>
            </div>

            @* User Management *@
                <div class="sidebar-section" style="@(!(AuthService.HasRole(AuthService.Roles.SuperAdmin)) ? "display:none" : "")">
                    <div class="sidebar-section-title">USER MANAGEMENT</div>
                    <div class="sidebar-dropdown @(userMgmtOpen ? "open" : "")">
                        <button class="sidebar-dropdown-toggle" @onclick="() => userMgmtOpen = !userMgmtOpen">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <span>👥</span>
                                <span>Users & Roles</span>
                            </div>
                            <span class="dropdown-arrow">▼</span>
                        </button>
                        <div class="sidebar-dropdown-menu">
                            <a href="/admin/system/user-registration" class="sidebar-dropdown-item @(IsActive("/admin/system/user-registration"))">➕ Register New User</a>
                            <a href="/admin/system/users" class="sidebar-dropdown-item @(IsActive("/admin/system/users"))">📋 All Users</a>
                            <a href="/admin/system/roles" class="sidebar-dropdown-item @(IsActive("/admin/system/roles"))">🔐 Roles & Permissions</a>
                            <a href="/admin/system/customers" class="sidebar-dropdown-item @(IsActive("/admin/system/customers"))">👤 Customer Profiles</a>
                        </div>
                    </div>
                </div>

            @* Transaction Approvals *@
                <div class="sidebar-section" style="@(!(AuthService.HasRole(AuthService.Roles.SuperAdmin) || AuthService.HasRole(AuthService.Roles.Accountant)) ? "display:none" : "")">
                    <div class="sidebar-section-title">TRANSACTION APPROVALS</div>
                    <div class="sidebar-dropdown @(transactionsOpen ? "open" : "")">
                        <button class="sidebar-dropdown-toggle" @onclick="() => transactionsOpen = !transactionsOpen">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <span>✅</span>
                                <span>Approve Transactions</span>
                            </div>
                            <span class="dropdown-arrow">▼</span>
                        </button>
                        <div class="sidebar-dropdown-menu">
                            <a href="/admin/approvals/deposit-approvals" class="sidebar-dropdown-item @(IsActive("/admin/approvals/deposit-approvals"))">💰 Deposit Approvals</a>
                            <a href="/admin/approvals/withdrawal-approvals" class="sidebar-dropdown-item @(IsActive("/admin/approvals/withdrawal-approvals"))">💸 Withdrawal Approvals</a>
                            <a href="/admin/approvals/transfer-approvals" class="sidebar-dropdown-item @(IsActive("/admin/approvals/transfer-approvals"))">🔄 Transfer Approvals</a>
                            <a href="/admin/approvals/loan-applications" class="sidebar-dropdown-item @(IsActive("/admin/approvals/loan-applications"))">🏦 Loan Applications</a>
                            <a href="/admin/approvals/card-applications" class="sidebar-dropdown-item @(IsActive("/admin/approvals/card-applications"))">💳 Card Applications</a>
                            <a href="/admin/approvals/bill-approvals" class="sidebar-dropdown-item @(IsActive("/admin/approvals/bill-approvals"))">📄 Bill Payment Approvals</a>
                            <a href="/admin/approvals/all-transactions" class="sidebar-dropdown-item @(IsActive("/admin/approvals/all-transactions"))">📊 All Transactions</a>
                        </div>
                    </div>
                </div>

            @* Banking *@
                <div class="sidebar-section" style="@(!(AuthService.HasRole(AuthService.Roles.SuperAdmin) || AuthService.HasRole(AuthService.Roles.Accountant)) ? "display:none" : "")">
                    <div class="sidebar-section-title">BANKING</div>
                    <div class="sidebar-dropdown @(bankingOpen ? "open" : "")">
                        <button class="sidebar-dropdown-toggle" @onclick="() => bankingOpen = !bankingOpen">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <span>🏦</span>
                                <span>Banking Operations</span>
                            </div>
                            <span class="dropdown-arrow">▼</span>
                        </button>
                        <div class="sidebar-dropdown-menu">
                            <a href="/admin/banking/accounts" class="sidebar-dropdown-item @(IsActive("/admin/banking/accounts"))">💼 Bank Accounts</a>
                            <a href="/admin/banking/fund-transfer" class="sidebar-dropdown-item @(IsActive("/admin/banking/fund-transfer"))">🔄 Fund Transfers</a>
                            <a href="/admin/banking/billers-management" class="sidebar-dropdown-item @(IsActive("/admin/banking/billers-management"))">📝 Billers Management</a>
                            <a href="/admin/banking/loan-management" class="sidebar-dropdown-item @(IsActive("/admin/banking/loan-management"))">🏦 Loan Management</a>
                            <a href="/admin/banking/card-management" class="sidebar-dropdown-item @(IsActive("/admin/banking/card-management"))">💳 Card Management</a>
                            <a href="/admin/banking/reports" class="sidebar-dropdown-item @(IsActive("/admin/banking/reports"))">📊 Banking Reports</a>
                        </div>
                    </div>
                </div>

            @* Accounting *@
                <div class="sidebar-section" style="@(!(AuthService.HasRole(AuthService.Roles.SuperAdmin) || AuthService.HasRole(AuthService.Roles.Accountant)) ? "display:none" : "")">
                    <div class="sidebar-section-title">ACCOUNTING</div>
                    <div class="sidebar-dropdown @(accountingOpen ? "open" : "")">
                        <button class="sidebar-dropdown-toggle" @onclick="() => accountingOpen = !accountingOpen">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <span>📊</span>
                                <span>Accounting Operations</span>
                            </div>
                            <span class="dropdown-arrow">▼</span>
                        </button>
                        <div class="sidebar-dropdown-menu">
                            <a href="/admin/accounting/journal-entries" class="sidebar-dropdown-item @(IsActive("/admin/accounting/journal-entries"))">📖 Journal Entries</a>
                            <a href="/admin/accounting/general-ledger" class="sidebar-dropdown-item @(IsActive("/admin/accounting/general-ledger"))">📗 General Ledger</a>
                            <a href="/admin/accounting/trial-balance" class="sidebar-dropdown-item @(IsActive("/admin/accounting/trial-balance"))">⚖️ Trial Balance</a>
                            <a href="/admin/accounting/financial-statements" class="sidebar-dropdown-item @(IsActive("/admin/accounting/financial-statements"))">📄 Financial Statements</a>
                            <a href="/admin/accounting/chart-of-accounts" class="sidebar-dropdown-item @(IsActive("/admin/accounting/chart-of-accounts"))">📑 Chart of Accounts</a>
                            <a href="/admin/accounting/reports" class="sidebar-dropdown-item @(IsActive("/admin/accounting/reports"))">📊 Accounting Reports</a>
                        </div>
                    </div>
                </div>

            @* Finance *@
                <div class="sidebar-section" style="@(!(AuthService.HasRole(AuthService.Roles.SuperAdmin) || AuthService.HasRole(AuthService.Roles.FinanceManager)) ? "display:none" : "")">
                    <div class="sidebar-section-title">FINANCE</div>
                    <div class="sidebar-dropdown @(financeOpen ? "open" : "")">
                        <button class="sidebar-dropdown-toggle" @onclick="() => financeOpen = !financeOpen">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <span>💵</span>
                                <span>Finance Operations</span>
                            </div>
                            <span class="dropdown-arrow">▼</span>
                        </button>
                        <div class="sidebar-dropdown-menu">
                            <a href="/admin/finance/accounts-payable" class="sidebar-dropdown-item @(IsActive("/admin/finance/accounts-payable"))">💰 Accounts Payable</a>
                            <a href="/admin/finance/accounts-receivable" class="sidebar-dropdown-item @(IsActive("/admin/finance/accounts-receivable"))">💳 Accounts Receivable</a>
                            <a href="/admin/finance/budget-management" class="sidebar-dropdown-item @(IsActive("/admin/finance/budget-management"))">📊 Budget Management</a>
                            <a href="/admin/finance/financial-forecasting" class="sidebar-dropdown-item @(IsActive("/admin/finance/financial-forecasting"))">📈 Financial Forecasting</a>
                            <a href="/admin/finance/cashflow-analysis" class="sidebar-dropdown-item @(IsActive("/admin/finance/cashflow-analysis"))">💸 Cash Flow Analysis</a>
                            <a href="/admin/finance/reports" class="sidebar-dropdown-item @(IsActive("/admin/finance/reports"))">📊 Finance Reports</a>
                        </div>
                    </div>
                </div>

            @* Security *@
                <div class="sidebar-section" style="@(!(AuthService.HasRole(AuthService.Roles.SuperAdmin)) ? "display:none" : "")">
                    <div class="sidebar-section-title">SECURITY</div>
                    <div class="sidebar-dropdown @(securityOpen ? "open" : "")">
                        <button class="sidebar-dropdown-toggle" @onclick="() => securityOpen = !securityOpen">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <span>🔒</span>
                                <span>Security & Audit</span>
                            </div>
                            <span class="dropdown-arrow">▼</span>
                        </button>
                        <div class="sidebar-dropdown-menu">
                            <a href="/admin/system/security-center" class="sidebar-dropdown-item @(IsActive("/admin/system/security-center"))">🔐 Security Center</a>
                            <a href="/admin/system/login-history" class="sidebar-dropdown-item @(IsActive("/admin/system/login-history"))">📜 Login History</a>
                            <a href="/admin/system/session-management" class="sidebar-dropdown-item @(IsActive("/admin/system/session-management"))">📱 Session Management</a>
                            <a href="/admin/system/audit-logs" class="sidebar-dropdown-item @(IsActive("/admin/system/audit-logs"))">📋 Audit Trail</a>
                            <a href="/admin/system/monitoring" class="sidebar-dropdown-item @(IsActive("/admin/system/monitoring"))">🔍 System Monitoring</a>
                        </div>
                    </div>
                </div>

            @* Reports *@
                <div class="sidebar-section" style="@(!(AuthService.HasRole(AuthService.Roles.SuperAdmin) || AuthService.HasRole(AuthService.Roles.Accountant) || AuthService.HasRole(AuthService.Roles.FinanceManager)) ? "display:none" : "")">
                    <div class="sidebar-section-title">REPORTS</div>
                    <div class="sidebar-dropdown @(reportsOpen ? "open" : "")">
                        <button class="sidebar-dropdown-toggle" @onclick="() => reportsOpen = !reportsOpen">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <span>📊</span>
                                <span>System Reports</span>
                            </div>
                            <span class="dropdown-arrow">▼</span>
                        </button>
                        <div class="sidebar-dropdown-menu">
                            <a href="/admin/system/accountant-reports" class="sidebar-dropdown-item @(IsActive("/admin/system/accountant-reports"))" style="@(!(AuthService.HasRole(AuthService.Roles.SuperAdmin) || AuthService.HasRole(AuthService.Roles.Accountant)) ? "display:none" : "")">📈 Accountant Reports</a>
                            <a href="/admin/system/finance-manager-reports" class="sidebar-dropdown-item @(IsActive("/admin/system/finance-manager-reports"))" style="@(!(AuthService.HasRole(AuthService.Roles.SuperAdmin) || AuthService.HasRole(AuthService.Roles.FinanceManager)) ? "display:none" : "")">💰 Finance Manager Reports</a>
                            <a href="/admin/reports/banking" class="sidebar-dropdown-item @(IsActive("/admin/reports/banking"))" style="@(!(AuthService.HasRole(AuthService.Roles.SuperAdmin) || AuthService.HasRole(AuthService.Roles.Accountant)) ? "display:none" : "")">🏦 Banking Reports</a>
                            <a href="/admin/reports/financial" class="sidebar-dropdown-item @(IsActive("/admin/reports/financial"))" style="@(!(AuthService.HasRole(AuthService.Roles.SuperAdmin)) ? "display:none" : "")">📊 Financial Reports</a>
                            <a href="/admin/reports/user-activity" class="sidebar-dropdown-item @(IsActive("/admin/reports/user-activity"))" style="@(!(AuthService.HasRole(AuthService.Roles.SuperAdmin)) ? "display:none" : "")">👥 User Activity Reports</a>
                            <a href="/admin/reports/transactions" class="sidebar-dropdown-item @(IsActive("/admin/reports/transactions"))" style="@(!(AuthService.HasRole(AuthService.Roles.SuperAdmin) || AuthService.HasRole(AuthService.Roles.Accountant)) ? "display:none" : "")">💰 Transaction Reports</a>
                            <a href="/admin/reports/budget" class="sidebar-dropdown-item @(IsActive("/admin/reports/budget"))" style="@(!(AuthService.HasRole(AuthService.Roles.SuperAdmin) || AuthService.HasRole(AuthService.Roles.FinanceManager)) ? "display:none" : "")">📊 Budget Reports</a>
                            <a href="/admin/reports/cashflow" class="sidebar-dropdown-item @(IsActive("/admin/reports/cashflow"))" style="@(!(AuthService.HasRole(AuthService.Roles.SuperAdmin) || AuthService.HasRole(AuthService.Roles.FinanceManager)) ? "display:none" : "")">💸 Cash Flow Reports</a>
                        </div>
                    </div>
                </div>

            @* System Settings *@
                <div class="sidebar-section">
                    <div class="sidebar-section-title">SYSTEM SETTINGS</div>
                    <div class="sidebar-dropdown @(settingsOpen ? "open" : "")">
                        <button class="sidebar-dropdown-toggle" @onclick="() => settingsOpen = !settingsOpen">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <span>⚙️</span>
                                <span>System Configuration</span>
                            </div>
                            <span class="dropdown-arrow">▼</span>
                        </button>
                        <div class="sidebar-dropdown-menu">
                            <a href="/admin/system/settings" class="sidebar-dropdown-item @(IsActive("/admin/system/settings"))">🔧 System Settings</a>
                            <a href="/admin/system/configuration" class="sidebar-dropdown-item @(IsActive("/admin/system/configuration"))">🌐 Global Configuration</a>
                            <a href="/admin/system/email-settings" class="sidebar-dropdown-item @(IsActive("/admin/system/email-settings"))">📧 Email Settings</a>
                            <a href="/admin/system/notifications" class="sidebar-dropdown-item @(IsActive("/admin/system/notifications"))">🔔 Notification Settings</a>
                            <a href="/admin/system/database" class="sidebar-dropdown-item @(IsActive("/admin/system/database"))">💾 Database Management</a>
                        </div>
                    </div>
                </div>

            @* System - All Roles *@
            <div class="sidebar-section">
                <div class="sidebar-section-title">SYSTEM</div>
                <a href="/admin/reports" class="sidebar-item @(IsActive("/admin/reports"))">
                    <span>📈</span>
                    <span>Reports</span>
                </a>
                <a href="/admin/settings" class="sidebar-item @(IsActive("/admin/settings"))" style="@(!(AuthService.HasRole(AuthService.Roles.SuperAdmin)) ? "display:none" : "")">
                    <span>⚙️</span>
                    <span>Settings</span>
                </a>
            </div>
        </div>

        <div class="sidebar-footer">
            <div class="sidebar-user" @onclick="HandleLogout">
                <div class="sidebar-user-avatar">@userInitials</div>
                <div class="sidebar-user-info">
                    <h4>@displayName (@roleDisplay)</h4>
                    <p>Logout</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="sidebar-main">
        <div class="sidebar-topbar">
            <div class="topbar-title">@GetPageTitle()</div>
        </div>
        <div class="sidebar-content">
            @Body
        </div>
    </div>
</div>

@code {
    private bool userMgmtOpen = false;
    private bool transactionsOpen = false;
    private bool bankingOpen = false;
    private bool securityOpen = false;
    private bool financeOpen = false;
    private bool accountingOpen = false;
    private bool reportsOpen = false;
    private bool settingsOpen = false;
    
    private string currentRole = "";
    private string displayName = "";
    private string roleDisplay = "";
    private string userInitials = "";
    private string headerRoleTitle = "Admin";

    protected override void OnInitialized()
    {
        currentRole = AuthService.CurrentRole ?? string.Empty;
        displayName = AuthService.FullName ?? AuthService.CurrentUser ?? "User";
        roleDisplay = AuthService.GetRoleDisplayName(AuthService.CurrentRole);
        userInitials = GetInitials(displayName);
        headerRoleTitle = GetHeaderRoleTitle(AuthService.CurrentRole);
    }

    protected override void OnParametersSet()
    {
        currentRole = AuthService.CurrentRole ?? currentRole;
        displayName = AuthService.FullName ?? AuthService.CurrentUser ?? displayName;
        roleDisplay = AuthService.GetRoleDisplayName(AuthService.CurrentRole);
        userInitials = GetInitials(displayName);
        headerRoleTitle = GetHeaderRoleTitle(AuthService.CurrentRole);
    }

    private string IsActive(string path)
    {
        return Navigation.Uri.Contains(path) ? "active" : "";
    }

    private string GetPageTitle()
    {
        var path = Navigation.Uri;
        if (path.Contains("/dashboard")) return "Dashboard";
        if (path.Contains("/users")) return "User Management";
        if (path.Contains("/accounts") || path.Contains("/banking")) return "Banking";
        if (path.Contains("/accounting")) return "Accounting";
        if (path.Contains("/finance")) return "Finance";
        if (path.Contains("/transactions") || path.Contains("/approvals")) return "Transactions";
        if (path.Contains("/reports")) return "Reports";
        if (path.Contains("/settings")) return "Settings";
        return "Admin Panel";
    }

    private void HandleLogout()
    {
        AuthService.Logout();
        Navigation.NavigateTo("/login");
    }

    private string GetInitials(string name)
    {
        var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return (AuthService.CurrentUser ?? "U").Substring(0, 1).ToUpperInvariant();
        if (parts.Length == 1) return parts[0].Substring(0, 1).ToUpperInvariant();
        return (parts[0].Substring(0, 1) + parts[^1].Substring(0, 1)).ToUpperInvariant();
    }

    private string GetHeaderRoleTitle(string? role)
    {
        return role switch
        {
            AuthService.Roles.SuperAdmin => "Admin",
            AuthService.Roles.Accountant => "Accountant",
            AuthService.Roles.FinanceManager => "Finance",
            _ => "Admin"
        };
    }
}


