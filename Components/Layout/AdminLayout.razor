                        <a href="/admin/finance-mgr/financial-reports" class="sidebar-dropdown-item @(IsActive("/admin/finance-mgr/financial-reports"))">
                            <svg class="sidebar-icon-small" style="color: #f59e0b;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
