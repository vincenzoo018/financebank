                        <a href="/admin/finance-mgr/cashflow-reports" class="sidebar-dropdown-item @(IsActive("/admin/finance-mgr/cashflow-reports"))">
                            <svg class="sidebar-icon-small" style="color: #f59e0b;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                            </svg>
