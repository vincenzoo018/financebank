@code {
    // Dropdown states
    private bool showUserMenu = false;

    // Role-specific operations dropdowns
    private bool tellerOpsOpen = false;
    private bool tellerLoansOpen = false;
    private bool tellerAccountsOpen = false;
    private bool tellerReportsOpen = false;
    private bool accountantOpsOpen = false;
    private bool accountantReportsOpen = false;
    private bool financeMgrOpsOpen = false;

    // Finance Manager Operations dropdowns
    private bool fmApprovalsOpen = false;
    private bool fmFinancialOpen = false;
    private bool fmRiskOpen = false;

    // Asset Marketplace dropdown
    private bool assetMarketplaceOpen = false;

    private string currentRole = "";
    private string displayName = "";
    private string roleDisplay = "";
    private string userInitials = "";
    private string headerRoleTitle = "Admin";

    protected override void OnInitialized()
    {
        currentRole = AuthService.CurrentRole ?? string.Empty;
        displayName = AuthService.FullName ?? AuthService.CurrentUser ?? "User";
        roleDisplay = AuthService.GetRoleDisplayName(AuthService.CurrentRole);
        userInitials = GetInitials(displayName);
        headerRoleTitle = GetHeaderRoleTitle(AuthService.CurrentRole);

        // Subscribe to authentication state changes
        AuthService.OnAuthStateChanged += OnAuthStateChanged;

        // Check if user is authenticated
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        // Check if user has proper role (not customer)
        if (AuthService.CurrentRole == AuthService.Roles.Customer)
        {
            Navigation.NavigateTo("/customer/dashboard", forceLoad: true);
            return;
        }
    }

    protected override void OnParametersSet()
    {
        currentRole = AuthService.CurrentRole ?? currentRole;
        displayName = AuthService.FullName ?? AuthService.CurrentUser ?? displayName;
        roleDisplay = AuthService.GetRoleDisplayName(AuthService.CurrentRole);
        userInitials = GetInitials(displayName);
        headerRoleTitle = GetHeaderRoleTitle(AuthService.CurrentRole);
    }

    private void OnAuthStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= OnAuthStateChanged;
    }

    private string IsActive(string path)
    {
        return Navigation.Uri.Contains(path) ? "active" : "";
    }

    private string GetPageTitle()
    {
        var path = Navigation.Uri;
        if (path.Contains("/dashboard")) return "Dashboard";
        if (path.Contains("/user-registration") || path.Contains("/customer-registration")) return "Registration";
        if (path.Contains("/teller-ops")) return "Teller Operations";
        if (path.Contains("/teller")) return "Teller Operations";
        if (path.Contains("/accountant")) return "Accountant Operations";
        if (path.Contains("/finance-mgr")) return "Finance Manager Operations";
        if (path.Contains("/asset-management")) return "Asset Management";
        if (path.Contains("/asset-applications")) return "Asset Applications";
        if (path.Contains("/analytics")) return "Reports & Analytics";
        if (path.Contains("/settings")) return "Settings";
        return "Admin Panel";
    }

    private void HandleLogout()
    {
        AuthService.Logout();
        Navigation.NavigateTo("/login");
    }

    private string GetInitials(string name)
    {
        var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return (AuthService.CurrentUser ?? "U").Substring(0, 1).ToUpperInvariant();
        if (parts.Length == 1) return parts[0].Substring(0, 1).ToUpperInvariant();
        return (parts[0].Substring(0, 1) + parts[^1].Substring(0, 1)).ToUpperInvariant();
    }

    private string GetHeaderRoleTitle(string? role)
    {
        return role switch
        {
            AuthService.Roles.SuperAdmin => "Admin",
            AuthService.Roles.Accountant => "Accountant",
            AuthService.Roles.FinanceManager => "Finance",
            _ => "Admin"
        };
    }
}