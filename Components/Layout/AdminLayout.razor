@inherits LayoutComponentBase
@implements IDisposable
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject RoleBasedNavigationService RoleService

<FinanceBank.Components.Shared.NotificationToast />

<div class="sidebar-container">
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">
            <div style="text-align: center;">
                <img src="images/finebank-logo.png" alt="FINEBANK Logo"
                    style="width: 80px; height: 80px; border-radius: 50%; object-fit: cover; margin-bottom: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.15);" />
                <div class="sidebar-logo">FINEBANK @headerRoleTitle</div>
                <div class="sidebar-subtitle">Finance System</div>
            </div>
        </div>

        <div class="sidebar-nav" style="overflow-y: auto; max-height: calc(100vh - 200px);">
            <!-- Dashboard -->
            <div class="sidebar-section">
                <a href="/admin/dashboard" class="sidebar-item @(IsActive("/admin/dashboard"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                    <span>Dashboard</span>
                </a>
            </div>

            @* Registration - SuperAdmin Only *@
            @if (AuthService.HasRole(AuthService.Roles.SuperAdmin))
            {
                <div class="sidebar-section">
                    <div class="sidebar-section-title">REGISTRATION</div>
                    <a href="/admin/user-registration" class="sidebar-item @(IsActive("/admin/user-registration"))">
                        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="8.5" cy="7" r="4"></circle>
                            <line x1="20" y1="8" x2="20" y2="14"></line>
                            <line x1="23" y1="11" x2="17" y2="11"></line>
                        </svg>
                        <span>Register New User</span>
                    </a>
                    <a href="/admin/all-users" class="sidebar-item @(IsActive("/admin/all-users"))">
                        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                        <span>All Users</span>
                    </a>
                    <a href="/admin/account-unlock-requests"
                        class="sidebar-item @(IsActive("/admin/account-unlock-requests"))">
                        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
                        </svg>
                        <span>Account Unlock Requests</span>
                    </a>
                </div>
            }

            @* Banking Operations - SuperAdmin Only *@
            @if (AuthService.HasRole(AuthService.Roles.SuperAdmin))
            {
                <div class="sidebar-section">
                    <div class="sidebar-section-title">BANKING OPERATIONS</div>

                    <!-- Transactions Dropdown -->
                    <div class="sidebar-dropdown @(tellerOpsOpen ? "open" : "")">
                        <button class="sidebar-dropdown-toggle" @onclick="() => tellerOpsOpen = !tellerOpsOpen">
                            <div style="display: flex; align-items: center; gap: 14px;">
                                <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <line x1="12" y1="1" x2="12" y2="23"></line>
                                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                                </svg>
                                <span>Transactions</span>
                            </div>
                            <span class="dropdown-arrow">▼</span>
                        </button>
                        <div class="sidebar-dropdown-menu">
                            <a href="/admin/teller-ops/deposits"
                                class="sidebar-dropdown-item @(IsActive("/admin/teller-ops/deposits"))">
                                <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path d="M12 5v14m-7-7l7 7 7-7" />
                                </svg>
                                <span>Process Deposits</span>
                            </a>
                            <a href="/admin/teller-ops/withdrawals"
                                class="sidebar-dropdown-item @(IsActive("/admin/teller-ops/withdrawals"))">
                                <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path d="M12 19V5m-7 7l7-7 7 7" />
                                </svg>
                                <span>Process Withdrawals</span>
                            </a>
                            <a href="/admin/teller-ops/transactions"
                                class="sidebar-dropdown-item @(IsActive("/admin/teller-ops/transactions"))">
                                <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" />
                                    <rect x="9" y="3" width="6" height="4" rx="2" />
                                </svg>
                                <span>Transaction History</span>
                            </a>
                            <a href="/admin/teller-ops/verify-identity"
                                class="sidebar-dropdown-item @(IsActive("/admin/teller-ops/verify-identity"))">
                                <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <span>Verify Identity</span>
                            </a>
                        </div>
                    </div>

                    <!-- Accounts Dropdown -->
                    <div class="sidebar-dropdown @(tellerAccountsOpen ? "open" : "")">
                        <button class="sidebar-dropdown-toggle" @onclick="() => tellerAccountsOpen = !tellerAccountsOpen">
                            <div style="display: flex; align-items: center; gap: 14px;">
                                <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="9" cy="7" r="4"></circle>
                                </svg>
                                <span>Accounts</span>
                            </div>
                            <span class="dropdown-arrow">▼</span>
                        </button>
                        <div class="sidebar-dropdown-menu">
                            <a href="/admin/teller-ops/accounts"
                                class="sidebar-dropdown-item @(IsActive("/admin/teller-ops/accounts"))">
                                <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                                    <circle cx="9" cy="7" r="4" />
                                </svg>
                                <span>Customer Accounts</span>
                            </a>
                            <a href="/admin/teller-ops/verification"
                                class="sidebar-dropdown-item @(IsActive("/admin/teller-ops/verification"))">
                                <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path d="M9 12l2 2 4-4" />
                                    <rect x="3" y="3" width="18" height="18" rx="2" />
                                </svg>
                                <span>Account Verification</span>
                            </a>
                            <a href="/admin/teller-ops/savings/open"
                                class="sidebar-dropdown-item @(IsActive("/admin/teller-ops/savings/open"))">
                                <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <rect x="3" y="3" width="18" height="18" rx="2" />
                                    <path d="M12 8v8m-4-4h8" />
                                </svg>
                                <span>Open Savings Account</span>
                            </a>
                            <a href="/admin/teller-ops/savings/history"
                                class="sidebar-dropdown-item @(IsActive("/admin/teller-ops/savings/history"))">
                                <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <circle cx="12" cy="12" r="10" />
                                    <path d="M12 6v6l4 2" />
                                </svg>
                                <span>Savings History</span>
                            </a>
                        </div>
                    </div>

                    <!-- Loans Dropdown -->
                    <div class="sidebar-dropdown @(tellerLoansOpen ? "open" : "")">
                        <button class="sidebar-dropdown-toggle" @onclick="() => tellerLoansOpen = !tellerLoansOpen">
                            <div style="display: flex; align-items: center; gap: 14px;">
                                <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <rect x="2" y="6" width="20" height="12" rx="2"></rect>
                                    <path d="M2 10h20"></path>
                                </svg>
                                <span>Loan Services</span>
                            </div>
                            <span class="dropdown-arrow">▼</span>
                        </button>
                        <div class="sidebar-dropdown-menu">
                            <a href="/admin/teller-ops/loan-review"
                                class="sidebar-dropdown-item @(IsActive("/admin/teller-ops/loan-review"))">
                                <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path
                                        d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                </svg>
                                <span>Review Applications</span>
                            </a>
                            <a href="/admin/teller-ops/loan-release"
                                class="sidebar-dropdown-item @(IsActive("/admin/teller-ops/loan-release"))">
                                <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <polyline points="20 6 9 17 4 12" />
                                </svg>
                                <span>Release Approved</span>
                            </a>
                            <a href="/admin/teller-ops/loan-payments"
                                class="sidebar-dropdown-item @(IsActive("/admin/teller-ops/loan-payments"))">
                                <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <rect x="2" y="6" width="20" height="12" rx="2" />
                                    <path d="M2 10h20" />
                                </svg>
                                <span>Process Payments</span>
                            </a>

                            <a href="/admin/teller-ops/payment-processing"
                                class="sidebar-dropdown-item @(IsActive("/admin/teller-ops/payment-processing"))">
                                <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <rect x="1" y="4" width="22" height="16" rx="2" ry="2" />
                                    <line x1="1" y1="10" x2="23" y2="10" />
                                </svg>
                                <span>Payment Processing</span>
                            </a>
                        </div>
                    </div>

                    <!-- Reports Dropdown -->
                    <div class="sidebar-dropdown @(tellerReportsOpen ? "open" : "")">
                        <button class="sidebar-dropdown-toggle" @onclick="() => tellerReportsOpen = !tellerReportsOpen">
                            <div style="display: flex; align-items: center; gap: 14px;">
                                <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                </svg>
                                <span>Reports</span>
                            </div>
                            <span class="dropdown-arrow">▼</span>
                        </button>
                        <div class="sidebar-dropdown-menu">
                            <a href="/admin/teller-ops/daily-report"
                                class="sidebar-dropdown-item @(IsActive("/admin/teller-ops/daily-report"))">
                                <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                                    <line x1="16" y1="2" x2="16" y2="6" />
                                    <line x1="8" y1="2" x2="8" y2="6" />
                                    <line x1="3" y1="10" x2="21" y2="10" />
                                </svg>
                                <span>Daily Report</span>
                            </a>
                            <a href="/admin/teller-ops/cash-summary"
                                class="sidebar-dropdown-item @(IsActive("/admin/teller-ops/cash-summary"))">
                                <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2" />
                                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
                                </svg>
                                <span>Cash Summary</span>
                            </a>
                        </div>
                    </div>
                </div>
            }

            @* Accountant Operations - SuperAdmin Only *@
            @if (AuthService.HasRole(AuthService.Roles.SuperAdmin))
            {
                <div class="sidebar-section">
                    <div class="sidebar-section-title">ACCOUNTANT OPERATIONS</div>

                    <!-- Accounting Dropdown -->
                    <div class="sidebar-dropdown @(accountantOpsOpen ? "open" : "")">
                        <button class="sidebar-dropdown-toggle" @onclick="() => accountantOpsOpen = !accountantOpsOpen">
                            <div style="display: flex; align-items: center; gap: 14px;">
                                <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
                                    <line x1="8" y1="21" x2="16" y2="21" />
                                    <line x1="12" y1="17" x2="12" y2="21" />
                                </svg>
                                <span>Accounting</span>
                            </div>
                            <span class="dropdown-arrow">▼</span>
                        </button>
                        <div class="sidebar-dropdown-menu">
                            <a href="/admin/accountant/journal-entries"
                                class="sidebar-dropdown-item @(IsActive("/admin/accountant/journal-entries"))">
                                <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                    <polyline points="14 2 14 8 20 8" />
                                    <line x1="16" y1="13" x2="8" y2="13" />
                                    <line x1="16" y1="17" x2="8" y2="17" />
                                </svg>
                                <span>Journal Entries</span>
                            </a>
                            <a href="/admin/accountant/chart-of-accounts"
                                class="sidebar-dropdown-item @(IsActive("/admin/accountant/chart-of-accounts"))">
                                <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path d="M3 3h18v18H3zM3 9h18M9 21V9" />
                                </svg>
                                <span>Chart of Accounts</span>
                            </a>
                            <a href="/admin/accountant/general-ledger"
                                class="sidebar-dropdown-item @(IsActive("/admin/accountant/general-ledger"))">
                                <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path d="M3 12h18M3 6h18M3 18h18" />
                                </svg>
                                <span>General Ledger</span>
                            </a>
                            <a href="/admin/accountant/trial-balance"
                                class="sidebar-dropdown-item @(IsActive("/admin/accountant/trial-balance"))">
                                <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path d="M12 3v18M3 12h18" />
                                    <circle cx="12" cy="12" r="9" />
                                </svg>
                                <span>Trial Balance</span>
                            </a>
                        </div>
                    </div>

                    <!-- Financial Reports Dropdown -->
                    <div class="sidebar-dropdown @(accountantReportsOpen ? "open" : "")">
                        <button class="sidebar-dropdown-toggle"
                            @onclick="() => accountantReportsOpen = !accountantReportsOpen">
                            <div style="display: flex; align-items: center; gap: 14px;">
                                <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                    <polyline points="14 2 14 8 20 8" />
                                </svg>
                                <span>Financial Reports</span>
                            </div>
                            <span class="dropdown-arrow">▼</span>
                        </button>
                        <div class="sidebar-dropdown-menu">
                            <a href="/admin/accountant/financial-statements"
                                class="sidebar-dropdown-item @(IsActive("/admin/accountant/financial-statements"))">
                                <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                    <polyline points="14 2 14 8 20 8" />
                                    <line x1="16" y1="13" x2="8" y2="13" />
                                    <line x1="16" y1="17" x2="8" y2="17" />
                                </svg>
                                <span>Financial Statements</span>
                            </a>
                            <a href="/admin/accountant/interest-payouts"
                                class="sidebar-dropdown-item @(IsActive("/admin/accountant/interest-payouts"))">
                                <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <line x1="12" y1="1" x2="12" y2="23" />
                                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                                </svg>
                                <span>Interest Payouts</span>
                            </a>
                            <a href="/admin/accountant/savings-interest-posting"
                                class="sidebar-dropdown-item @(IsActive("/admin/accountant/savings-interest-posting"))">
                                <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <rect x="3" y="3" width="18" height="18" rx="2" />
                                    <path d="M8 12h8M12 8v8" />
                                </svg>
                                <span>Savings Interest Posting</span>
                            </a>
                        </div>
                    </div>

                    <!-- Approvals -->
                    <a href="/admin/accountant/all-approvals"
                        class="sidebar-item @(IsActive("/admin/accountant/all-approvals"))">
                        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="9 11 12 14 22 4" />
                            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
                        </svg>
                        <span>All Approvals</span>
                    </a>
                </div>
            }

            @* Finance Manager Operations - SuperAdmin Only *@
            @if (AuthService.HasRole(AuthService.Roles.SuperAdmin))
            {
                <div class="sidebar-section">
                    <div class="sidebar-section-title">FINANCE MANAGER OPERATIONS</div>

                    <!-- FM Approvals Dropdown -->
                    <div class="sidebar-dropdown @(fmApprovalsOpen ? "open" : "")">
                        <button class="sidebar-dropdown-toggle" @onclick="() => fmApprovalsOpen = !fmApprovalsOpen">
                            <div style="display: flex; align-items: center; gap: 14px;">
                                <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <polyline points="9 11 12 14 22 4" />
                                    <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
                                </svg>
                                <span>Approvals</span>
                            </div>
                            <span class="dropdown-arrow">▼</span>
                        </button>
                        <div class="sidebar-dropdown-menu">
                            <a href="/admin/finance-manager/loan-approvals"
                                class="sidebar-dropdown-item @(IsActive("/admin/finance-manager/loan-approvals"))">
                                <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <rect x="2" y="6" width="20" height="12" rx="2" />
                                    <path d="M2 10h20" />
                                </svg>
                                <span>Loan Approvals</span>
                            </a>
                            <a href="/admin/finance-manager/savings-approvals"
                                class="sidebar-dropdown-item @(IsActive("/admin/finance-manager/savings-approvals"))">
                                <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <line x1="12" y1="1" x2="12" y2="23" />
                                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                                </svg>
                                <span>Savings Approvals</span>
                            </a>
                        </div>
                    </div>

                    <!-- FM Financial Dropdown -->
                    <div class="sidebar-dropdown @(fmFinancialOpen ? "open" : "")">
                        <button class="sidebar-dropdown-toggle" @onclick="() => fmFinancialOpen = !fmFinancialOpen">
                            <div style="display: flex; align-items: center; gap: 14px;">
                                <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <line x1="12" y1="1" x2="12" y2="23" />
                                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                                </svg>
                                <span>Financial</span>
                            </div>
                            <span class="dropdown-arrow">▼</span>
                        </button>
                        <div class="sidebar-dropdown-menu">
                            <a href="/admin/finance-manager/payables"
                                class="sidebar-dropdown-item @(IsActive("/admin/finance-manager/payables"))">
                                <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path
                                        d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z" />
                                </svg>
                                <span>Accounts Payable</span>
                            </a>
                            <a href="/admin/finance-manager/receivables"
                                class="sidebar-dropdown-item @(IsActive("/admin/finance-manager/receivables"))">
                                <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path
                                        d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z" />
                                </svg>
                                <span>Accounts Receivable</span>
                            </a>
                            <a href="/admin/finance-manager/budget-management"
                                class="sidebar-dropdown-item @(IsActive("/admin/finance-manager/budget-management"))">
                                <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path
