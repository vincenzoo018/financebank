@inherits LayoutComponentBase
@implements IDisposable
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject RoleBasedNavigationService RoleService

<div class="sidebar-container">
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">
            <div style="text-align: center;">
                <img src="images/finsys-logo.png" alt="FINSYS Logo" style="width: 80px; height: 80px; border-radius: 50%; object-fit: cover; margin-bottom: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.15);" />
                <div class="sidebar-logo">FINSYS @headerRoleTitle</div>
                <div class="sidebar-subtitle">Finance System</div>
            </div>
        </div>

        <div class="sidebar-nav" style="overflow-y: auto; max-height: calc(100vh - 200px);">
            <!-- Main Section -->
            <div class="sidebar-section">
                <a href="/admin/dashboard" class="sidebar-item @(IsActive("/admin/dashboard"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                    <span>Dashboard</span>
                </a>
            </div>

            @* User Management *@
            <div class="sidebar-section" style="@(!(AuthService.HasRole(AuthService.Roles.SuperAdmin)) ? "display:none" : "")">
                <div class="sidebar-section-title">USER MANAGEMENT</div>
                <div class="sidebar-dropdown @(userMgmtOpen ? "open" : "")">
                    <button class="sidebar-dropdown-toggle" @onclick="() => userMgmtOpen = !userMgmtOpen">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                            <span>Users & Roles</span>
                        </div>
                        <span class="dropdown-arrow">▼</span>
                    </button>
                    <div class="sidebar-dropdown-menu">
                        <a href="/admin/user-registration" class="sidebar-dropdown-item @(IsActive("/admin/user-registration"))">
                            <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            Register New User
                        </a>
                        <a href="/admin/system/users" class="sidebar-dropdown-item @(IsActive("/admin/system/users"))">
                            <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                            </svg>
                            All Users
                        </a>
                        <a href="/admin/system/roles" class="sidebar-dropdown-item @(IsActive("/admin/system/roles"))">
                            <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                                <line x1="9" y1="9" x2="15" y2="9"></line>
                                <line x1="9" y1="15" x2="15" y2="15"></line>
                            </svg>
                            Roles & Permissions
                        </a>
                        <a href="/admin/system/customers" class="sidebar-dropdown-item @(IsActive("/admin/system/customers"))">
                            <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="8" r="4"></circle>
                                <path d="M6 20c0-2.21 2.69-4 6-4s6 1.79 6 4"></path>
                            </svg>
                            Customer Profiles
                        </a>
                    </div>
                </div>
            </div>

            @* Transaction Approvals *@
            <div class="sidebar-section" style="@(!(AuthService.HasRole(AuthService.Roles.SuperAdmin) || AuthService.HasRole(AuthService.Roles.Accountant)) ? "display:none" : "")">
                <div class="sidebar-section-title">APPROVALS</div>
                <div class="sidebar-dropdown @(transactionsOpen ? "open" : "")">
                    <button class="sidebar-dropdown-toggle" @onclick="() => transactionsOpen = !transactionsOpen">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <span>Approve Transactions</span>
                        </div>
                        <span class="dropdown-arrow">▼</span>
                    </button>
                    <div class="sidebar-dropdown-menu">
                        <a href="/admin/approvals/deposit-approvals" class="sidebar-dropdown-item @(IsActive("/admin/approvals/deposit-approvals"))">
                            <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <polyline points="19 12 12 19 5 12"></polyline>
                            </svg>
                            Deposit Approvals
                        </a>
                        <a href="/admin/approvals/withdrawal-approvals" class="sidebar-dropdown-item @(IsActive("/admin/approvals/withdrawal-approvals"))">
                            <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <polyline points="5 12 12 5 19 12"></polyline>
                            </svg>
                            Withdrawal Approvals
                        </a>
                        <a href="/admin/approvals/transfer-approvals" class="sidebar-dropdown-item @(IsActive("/admin/approvals/transfer-approvals"))">
                            <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="1" y1="4" x2="23" y2="4"></line>
                                <line x1="1" y1="10" x2="23" y2="10"></line>
                                <line x1="1" y1="16" x2="23" y2="16"></line>
                                <line x1="1" y1="20" x2="23" y2="20"></line>
                            </svg>
                            Transfer Approvals
                        </a>
                        <a href="/admin/approvals/loans" class="sidebar-dropdown-item @(IsActive("/admin/approvals/loans"))">
                            <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="7" width="20" height="14" rx="2"></rect>
                                <path d="M16 4V2M8 4V2"></path>
                            </svg>
                            Loan Applications
                        </a>
                        <a href="/admin/approvals/cards" class="sidebar-dropdown-item @(IsActive("/admin/approvals/cards"))">
                            <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="1" y="4" width="22" height="16" rx="2"></rect>
                                <line x1="1" y1="10" x2="23" y2="10"></line>
                            </svg>
                            Card Applications
                        </a>
                        <a href="/admin/approvals/bill-approvals" class="sidebar-dropdown-item @(IsActive("/admin/approvals/bill-approvals"))">
                            <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                            </svg>
                            Bill Payment Approvals
                        </a>
                        <a href="/admin/approvals/all-transactions" class="sidebar-dropdown-item @(IsActive("/admin/approvals/all-transactions"))">
                            <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="2" x2="12" y2="22"></line>
                                <path d="M17 5H9.5a1.5 1.5 0 0 0 0 3H17"></path>
                                <path d="M15 19H6.5a1.5 1.5 0 0 1 0-3H15"></path>
                            </svg>
                            All Transactions
                        </a>
                    </div>
                </div>
            </div>

            @* Banking *@
            <div class="sidebar-section" style="@(!(AuthService.HasRole(AuthService.Roles.SuperAdmin) || AuthService.HasRole(AuthService.Roles.Accountant)) ? "display:none" : "")">
                <div class="sidebar-section-title">BANKING</div>
                <div class="sidebar-dropdown @(bankingOpen ? "open" : "")">
                    <button class="sidebar-dropdown-toggle" @onclick="() => bankingOpen = !bankingOpen">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 21h18M3 10h18M5 6h14M7 3h10"></path>
                            </svg>
                            <span>Banking Operations</span>
                        </div>
                        <span class="dropdown-arrow">▼</span>
                    </button>
                    <div class="sidebar-dropdown-menu">
                        <a href="/admin/banking/accounts" class="sidebar-dropdown-item @(IsActive("/admin/banking/accounts"))">
                            <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="7" width="20" height="14" rx="2"></rect>
                                <path d="M16 4V2M8 4V2"></path>
                            </svg>
                            Bank Accounts
                        </a>
                        <a href="/admin/banking/fund-transfer" class="sidebar-dropdown-item @(IsActive("/admin/banking/fund-transfer"))">
                            <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <polyline points="19 12 12 19 5 12"></polyline>
                            </svg>
                            Fund Transfers
                        </a>
                        <a href="/admin/banking/billers-management" class="sidebar-dropdown-item @(IsActive("/admin/banking/billers-management"))">
                            <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"></circle>
                                <path d="m21 21-4.35-4.35"></path>
                            </svg>
                            Billers Management
                        </a>
                        <a href="/admin/banking/loan-management" class="sidebar-dropdown-item @(IsActive("/admin/banking/loan-management"))">
                            <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="7" width="20" height="14" rx="2"></rect>
                                <path d="M16 4V2M8 4V2"></path>
                            </svg>
                            Loan Management
                        </a>
                        <a href="/admin/banking/card-management" class="sidebar-dropdown-item @(IsActive("/admin/banking/card-management"))">
                            <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="1" y="4" width="22" height="16" rx="2"></rect>
                                <line x1="1" y1="10" x2="23" y2="10"></line>
                            </svg>
                            Card Management
                        </a>
                        <a href="/admin/banking/reports" class="sidebar-dropdown-item @(IsActive("/admin/banking/reports"))">
                            <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="2" x2="12" y2="22"></line>
                                <path d="M17 5H9.5a1.5 1.5 0 0 0 0 3H17"></path>
                                <path d="M15 19H6.5a1.5 1.5 0 0 1 0-3H15"></path>
                            </svg>
                            Banking Reports
                        </a>
                    </div>
                </div>
            </div>

            @* Accounting *@
            <div class="sidebar-section" style="@(!(AuthService.HasRole(AuthService.Roles.SuperAdmin) || AuthService.HasRole(AuthService.Roles.Accountant)) ? "display:none" : "")">
                <div class="sidebar-section-title">ACCOUNTING</div>
                <div class="sidebar-dropdown @(accountingOpen ? "open" : "")">
                    <button class="sidebar-dropdown-toggle" @onclick="() => accountingOpen = !accountingOpen">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="2" x2="12" y2="22"></line>
                                <path d="M17 5H9.5a1.5 1.5 0 0 0 0 3H17"></path>
                                <path d="M15 19H6.5a1.5 1.5 0 0 1 0-3H15"></path>
                            </svg>
                            <span>Accounting Operations</span>
                        </div>
                        <span class="dropdown-arrow">▼</span>
                    </button>
                    <div class="sidebar-dropdown-menu">
                        <a href="/admin/accounting/journal-entries" class="sidebar-dropdown-item @(IsActive("/admin/accounting/journal-entries"))">
                            <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                            </svg>
                            Journal Entries
                        </a>
                        <a href="/admin/accounting/general-ledger" class="sidebar-dropdown-item @(IsActive("/admin/accounting/general-ledger"))">
                            <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="8" y1="6" x2="21" y2="6"></line>
                                <line x1="8" y1="12" x2="21" y2="12"></line>
                                <line x1="8" y1="18" x2="21" y2="18"></line>
                                <line x1="3" y1="6" x2="3.01" y2="6"></line>
                                <line x1="3" y1="12" x2="3.01" y2="12"></line>
                                <line x1="3" y1="18" x2="3.01" y2="18"></line>
                            </svg>
                            General Ledger
                        </a>
                        <a href="/admin/accounting/trial-balance" class="sidebar-dropdown-item @(IsActive("/admin/accounting/trial-balance"))">
                            <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 12a9 9 0 1 0 18 0A9 9 0 0 0 3 12z"></path>
                                <path d="M12 7v5l3 2"></path>
                            </svg>
                            Trial Balance
                        </a>
                        <a href="/admin/accounting/financial-statements" class="sidebar-dropdown-item @(IsActive("/admin/accounting/financial-statements"))">
                            <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                            </svg>
                            Financial Statements
                        </a>
                        <a href="/admin/accounting/chart-of-accounts" class="sidebar-dropdown-item @(IsActive("/admin/accounting/chart-of-accounts"))">
                            <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            Chart of Accounts
                        </a>
                        <a href="/admin/accounting/reports" class="sidebar-dropdown-item @(IsActive("/admin/accounting/reports"))">
                            <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="2" x2="12" y2="22"></line>
                                <path d="M17 5H9.5a1.5 1.5 0 0 0 0 3H17"></path>
                            </svg>
                            Accounting Reports
                        </a>
                    </div>
                </div>
            </div>

            @* Finance *@
            <div class="sidebar-section" style="@(!(AuthService.HasRole(AuthService.Roles.SuperAdmin) || AuthService.HasRole(AuthService.Roles.FinanceManager)) ? "display:none" : "")">
                <div class="sidebar-section-title">FINANCE</div>
                <div class="sidebar-dropdown @(financeOpen ? "open" : "")">
                    <button class="sidebar-dropdown-toggle" @onclick="() => financeOpen = !financeOpen">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="1" x2="12" y2="23"></line>
                                <path d="M17 5H9.5a1.5 1.5 0 0 0 0 3H17"></path>
                                <path d="M15 19H6.5a1.5 1.5 0 0 1 0-3H15"></path>
                            </svg>
                            <span>Finance Operations</span>
                        </div>
                        <span class="dropdown-arrow">▼</span>
                    </button>
                    <div class="sidebar-dropdown-menu">
                        <a href="/admin/finance/payables" class="sidebar-dropdown-item @(IsActive("/admin/finance/payables"))">
                            <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 1v22M17 5H9.5a1.5 1.5 0 0 0 0 3H17"></path>
                            </svg>
                            Accounts Payable
                        </a>
                        <a href="/admin/finance/receivables" class="sidebar-dropdown-item @(IsActive("/admin/finance/receivables"))">
                            <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 1v22M17 5H9.5a1.5 1.5 0 0 0 0 3H17"></path>
                            </svg>
                            Accounts Receivable
                        </a>
                        <a href="/admin/finance/budget-management" class="sidebar-dropdown-item @(IsActive("/admin/finance/budget-management"))">
                            <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                                <line x1="9" y1="9" x2="15" y2="9"></line>
                                <line x1="9" y1="15" x2="15" y2="15"></line>
                            </svg>
                            Budget Management
                        </a>
                        <a href="/admin/finance/financial-forecasting" class="sidebar-dropdown-item @(IsActive("/admin/finance/financial-forecasting"))">
                            <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="23 6 13.5 15.5 8.5 10.5 1 17"></polyline>
                                <polyline points="17 6 23 6 23 12"></polyline>
                            </svg>
                            Financial Forecasting
                        </a>
                        <a href="/admin/finance/cashflow-analysis" class="sidebar-dropdown-item @(IsActive("/admin/finance/cashflow-analysis"))">
                            <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="12 3 20 7.5 20 16.5 12 21 4 16.5 4 7.5 12 3"></polyline>
                                <line x1="12" y1="12" x2="20" y2="7.5"></line>
                                <line x1="12" y1="12" x2="12" y2="21"></line>
                                <line x1="12" y1="12" x2="4" y2="7.5"></line>
                            </svg>
                            Cash Flow Analysis
                        </a>
                        <button class="sidebar-dropdown-toggle" @onclick="() => financeReportsOpen = !financeReportsOpen" style="width: 100%; border: none; background: none; padding: 0; display: flex; align-items: center; justify-content: space-between; margin-top: 8px;">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="2" x2="12" y2="22"></line>
                                    <path d="M17 5H9.5a1.5 1.5 0 0 0 0 3H17"></path>
                                </svg>
                                <span>Finance Reports</span>
                            </div>
                            <span class="dropdown-arrow">▼</span>
                        </button>
                        @if (financeReportsOpen)
                        {
                            <div class="sidebar-dropdown-menu" style="display: block;">
                                <a href="/admin/system/reports" class="sidebar-dropdown-item @(IsActive("/admin/system/reports"))">
                                    <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path>
                                        <polyline points="13 2 13 9 20 9"></polyline>
                                    </svg>
                                    System Reports
                                </a>
                                <a href="/admin/system/finance-manager-reports" class="sidebar-dropdown-item @(IsActive("/admin/system/finance-manager-reports"))">
                                    <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="12" y1="2" x2="12" y2="22"></line>
                                        <path d="M17 5H9.5a1.5 1.5 0 0 0 0 3H17"></path>
                                    </svg>
                                    Finance Manager Reports
                                </a>
                                <a href="/admin/finance/budget-reports" class="sidebar-dropdown-item @(IsActive("/admin/finance/budget-reports"))">
                                    <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                                    </svg>
                                    Budget Reports
                                </a>
                                <a href="/admin/finance/cashflow-reports" class="sidebar-dropdown-item @(IsActive("/admin/finance/cashflow-reports"))">
                                    <svg class="sidebar-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M3 12a9 9 0 1 0 18 0A9 9 0 1 0 3 12Z"></path>
                                        <path d="M9 9h6v6H9z"></path>
                                    </svg>
                                    Cash Flow Reports
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* Security *@
