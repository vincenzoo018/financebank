@inherits LayoutComponentBase
@inject AuthService AuthService
@inject NavigationManager Navigation
@implements IDisposable

<div class="sidebar-container">
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">
            <div style="text-align: center;">
                <img src="images/finsys-logo.png" alt="FINSYS Logo" style="width: 80px; height: 80px; border-radius: 50%; object-fit: cover; margin-bottom: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.15);" />
                <div class="sidebar-logo">FINSYS Accountant</div>
                <div class="sidebar-subtitle">Finance Portal</div>
            </div>
        </div>

        <div class="sidebar-nav">
            <!-- Main Section -->
            <div class="sidebar-section">
                <div class="sidebar-section-title">MAIN</div>
                <a href="/accountant/dashboard" class="sidebar-item @(IsActive("/accountant/dashboard"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                    <span>Dashboard</span>
                </a>
            </div>

            <!-- Accounting Operations -->
            <div class="sidebar-section">
                <div class="sidebar-section-title">ACCOUNTING OPERATIONS</div>
                <a href="/admin/accounting/journal-entries" class="sidebar-item @(IsActive("/admin/accounting/journal-entries"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="13" x2="12" y2="17"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>
                    <span>Journal Entries</span>
                </a>
                <a href="/admin/accounting/general-ledger" class="sidebar-item @(IsActive("/admin/accounting/general-ledger"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h18M3 6h18M3 18h18"></path></svg>
                    <span>General Ledger</span>
                </a>
                <a href="/admin/accounting/trial-balance" class="sidebar-item @(IsActive("/admin/accounting/trial-balance"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    <span>Trial Balance</span>
                </a>
                <a href="/admin/accounting/financial-statements" class="sidebar-item @(IsActive("/admin/accounting/financial-statements"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h18v18H3z"></path><path d="M9 9h6v6H9z"></path></svg>
                    <span>Financial Statements</span>
                </a>
                <a href="/admin/accounting/chart-of-accounts" class="sidebar-item @(IsActive("/admin/accounting/chart-of-accounts"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7v10c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5z"></path></svg>
                    <span>Chart of Accounts</span>
                </a>
            </div>

            <!-- Loan Processing - Accountant Only -->
            <div class="sidebar-section">
                <div class="sidebar-section-title">LOAN PROCESSING</div>
                <a href="/accountant/review-assessment" class="sidebar-item @(IsActive("/accountant/review-assessment"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                    <span>Review Assessment</span>
                </a>
                <a href="/accountant/loan-recording" class="sidebar-item @(IsActive("/accountant/loan-recording"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><path d="M9 9h6"></path><path d="M9 13h6"></path><path d="M9 17h2"></path></svg>
                    <span>Loan Recording</span>
                </a>
                <a href="/accountant/clearance-certificate" class="sidebar-item @(IsActive("/accountant/clearance-certificate"))">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                    <span>Clearance Certificate</span>
                </a>
            </div>
        </div>

        <div class="sidebar-footer"></div>
    </div>

    <!-- Main Content Area -->
    <div class="sidebar-main">
        <div class="sidebar-topbar">
            <div class="topbar-title">@GetPageTitle()</div>
            <div style="display: flex; align-items: center; gap: 16px;">
                <div class="topbar-user-menu">
                    <button class="topbar-user-avatar" @onclick="() => showUserMenu = !showUserMenu" style="background: linear-gradient(135deg, #f59e0b, #d97706);">
                        @userInitials
                    </button>
                    @if (showUserMenu)
                    {
                        <div class="topbar-user-dropdown">
                            <button class="topbar-dropdown-item" @onclick="() => { showUserMenu = false; }">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;">
                                    <path d="M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16z"></path>
                                    <path d="M12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"></path>
                                </svg>
                                Settings
                            </button>
                            <button class="topbar-dropdown-item logout-btn" @onclick="HandleLogout">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;">
                                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                    <polyline points="16 17 21 12 16 7"></polyline>
                                    <line x1="21" y1="12" x2="9" y2="12"></line>
                                </svg>
                                Logout
                            </button>
                        </div>
                    }
                </div>
                <span style="font-size: 12px; background: #f59e0b; color: white; padding: 4px 12px; border-radius: 20px; font-weight: 600;">Accountant</span>
            </div>
        </div>
        <div class="sidebar-content">
            @Body
        </div>
    </div>
</div>

@code {
    private string userInitials = "AC";
    private bool showUserMenu = false;

    protected override void OnInitialized()
    {
        var displayName = AuthService.FullName ?? AuthService.CurrentUser ?? "Accountant";
        userInitials = GetInitials(displayName);
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrEmpty(name)) return "AC";
        var parts = name.Split(' ');
        return parts.Length >= 2 
            ? $"{parts[0][0]}{parts[1][0]}".ToUpper()
            : $"{parts[0][0]}".ToUpper();
    }

    private string IsActive(string path)
    {
        return Navigation.Uri.Contains(path) ? "active" : "";
    }

    private string GetPageTitle()
    {
        var path = Navigation.Uri;
        if (path.Contains("/accountant/dashboard")) return "Accountant Dashboard";
        if (path.Contains("/dashboard")) return "Dashboard";
        if (path.Contains("/journal-entries")) return "Journal Entries";
        if (path.Contains("/general-ledger")) return "General Ledger";
        if (path.Contains("/trial-balance")) return "Trial Balance";
        if (path.Contains("/financial-statements")) return "Financial Statements";
        if (path.Contains("/chart-of-accounts")) return "Chart of Accounts";
        if (path.Contains("/review-assessment")) return "Review Loan Assessment";
        if (path.Contains("/loan-recording")) return "Loan Recording";
        if (path.Contains("/clearance-certificate")) return "Clearance Certificate";
        return "Accountant Portal";
    }

    private void HandleLogout()
    {
        AuthService.Logout();
        Navigation.NavigateTo("/login", forceLoad: false);
    }

    public void Dispose()
    {
        // Cleanup if needed
    }
}
